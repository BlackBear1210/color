@tool
extends Node2D
## ============================================================================
## [2026-08-23 신규] 총 받침 — 부모의 비균등 스케일을 되돌린다
## ----------------------------------------------------------------------------
## ▣ 무슨 문제를 푸나
##   Player 노드에 스케일 (0.795, 0.368) 이 걸려 있다. 가로세로 배율이 다른데
##   Gun 이 그 **아래에서** 회전한다. 자식의 월드 변환은 `부모스케일 × 회전` 으로
##   합성되므로 회전이 스케일에 끼여 찌그러진다 — 총구(Muzzle)가 원이 아니라
##   **타원**을 그린다:
##       옆으로 조준 → 24 × 0.795 = 19.1px
##       위로 조준   → 24 × 0.368 =  8.8px
##
##   예전에는 총알 방향을 마우스 좌표로 따로 계산해서 발사만은 멀쩡했다.
##   그런데 이제 **총구가 박힌 부위의 색이 총알 색을 정한다**(색경계.gd 참고).
##   총구가 조준 각도에 따라 세로로 10px 씩 오르내리면, 경계선이 그 높이를 지날 때
##   "위를 겨누느냐 옆을 겨누느냐" 로 총알 색이 바뀐다. 원인을 짐작할 수 없는 버그다.
##
## ▣ 어떻게 푸나
##   회전하는 노드 **위에** 배율을 되돌리는 노드를 한 겹 끼운다.
##       Player   scale (0.795, 0.368)
##       └ GunRig scale (1/0.795, 1/0.368)   ← 이 스크립트
##         └ Gun  여기서 회전 → 합성 배율 (1, 1)
##   ⚠ Gun 에 직접 역스케일을 걸면 안 된다. 합성이 `부모스케일 × 회전 × 자기스케일`
##     이라 회전이 여전히 부모 스케일에 끼여 있다. 되돌리는 배율이 회전보다 **앞에**
##     와야 상쇄되고, 그러려면 별도의 부모 노드가 필요하다.
##
## ▣ 덤 — 이 안의 좌표는 곧 월드 픽셀이다
##   합성 배율이 1 이므로 Gun 을 (0, -70) 에 두면 발바닥에서 정확히 70px 위다.
##   원본 스프라이트의 입 좌표를 실제 표시 비율로 환산한 값이다. 예전처럼 -70 이
##   실제로는 -25.7 이 되는 환산을 안 해도 된다.
##
## ▣ 왜 값을 씬에 박지 않고 코드로 재나
##   플레이어 스케일이 바뀌면 박아둔 값이 조용히 틀린다. 부모에서 실측해 맞추면
##   스케일을 어떻게 바꾸든 총구는 항상 제자리다.
## ============================================================================

func _ready() -> void:
	_배율_맞추기()


func _process(_delta: float) -> void:
	# 에디터에서 부모 스케일을 드래그하는 즉시 따라오게 한다.
	# 게임 중에는 플레이어 스케일이 안 바뀌므로 한 번만 맞추고 쉰다.
	if Engine.is_editor_hint():
		_배율_맞추기()
	else:
		set_process(false)


func _배율_맞추기() -> void:
	var 부모 := get_parent() as Node2D
	if 부모 == null:
		return
	var s := 부모.global_scale
	# 0 으로 나누지 않는다. 스케일이 0 인 축은 되돌릴 방법이 없으니 1 로 둔다.
	scale = Vector2(
		1.0 / s.x if absf(s.x) > 0.0001 else 1.0,
		1.0 / s.y if absf(s.y) > 0.0001 else 1.0
	)
