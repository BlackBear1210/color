@tool
extends Node2D
## ============================================================================
## [2026-10-09 Claude 신규 · 같은 날 고침] 튀어나오는 판 — 압력 발판을 누르면 벽에서 미끄러져 나오는 **목재 데크 계단** (쳅터1 · 15 집 밖)
## ----------------------------------------------------------------------------
## ▣ 도형님: "쳅터2에 사용된 발판을 누르면 나오는 지형도 사용하면 좋을 것 같은데 … 다른 스테이지에 적절하게"
##   → 하수도 2-5 의 '발판_1 홀드 → 검은지형_1~5 가 왼벽에서 하나씩 튀어나와 계단' 을 쳅터1 에 가져왔다.
##   움직이는 것은 공용 `압력버튼.gd`(대상들 · 대상_이동량들 · 대상_지연들)가 그대로 한다 — 이 노드는 '움직여지는 그릇' 뿐.
## ▣ [고침] 처음엔 코드로 회색 벽돌을 그렸다 → 도형님: "기존의 지형 이미지와 안 어울려 · 기존 타일셋과 어울리게".
##   → 2-5 와 같은 방식으로 **진짜 지형 조각**을 담는다: 쳅터1 바닥과 같은 목재 데크 템플릿(구조 = 중립색 · 칠하기 금지)을
##   실행 때 이 그릇 아래에 하나 만들고 사각형 네 점을 준다. 그림·2.5D 윗면·충돌이 바닥 지형과 똑같다.
##   (씬 파일에는 그릇만 저장된다 — 점 sub_resource 를 씬에 쓰지 않아 생성기 글이 단순하다)
## ▣ 숨어 있을 때는 담장 지형 뒤(z −1)라 안 보인다 · 다 나오면 담장 앞 계단.
## ▣ 원점 = 판의 왼쪽 위(숨은 자리). 도안 {"종류": "누름계단", …} → 생성기가 놓고 압력 발판에 잇는다.
## ============================================================================

const 템플릿 := "res://scenes/지형/목재/목재_데크_검정.tscn"

@export var 크기: Vector2 = Vector2(256, 64):
	set(v): 크기 = v; _재구성()

var _땅: Node2D = null


func _ready() -> void:
	z_index = -1
	_재구성()
	if Engine.is_editor_hint():
		return
	add_to_group("누름계단판")


func _재구성() -> void:
	if not is_inside_tree():
		return
	if _땅 == null:
		var 장면 := load(템플릿) as PackedScene
		if 장면 == null:
			return
		_땅 = 장면.instantiate() as Node2D
		_땅.name = "목재"
		# 바닥 구조와 같은 속성 — 중립색(두 색 다 선다) · 칠하기 금지 · 위치별 판정(만들기.py 구조_속성)
		_땅.set("칠하기_허용", false)
		_땅.set("칠하기_방식", 2)
		_땅.set("위치별_판정", true)
		_땅.set("collision_size", 0.0)
		_땅.set_meta("role", "구조")
		_땅.set_meta("design_kind", "구조")
		add_child(_땅)
	# 네 점(시계방향 — 생성기 다각형과 같은 순서) · 지형 노드 원점 = 판 가운데
	_땅.position = 크기 * 0.5
	var h := 크기 * 0.5
	# 템플릿의 점 배열은 같은 장면의 인스턴스끼리 **공유**될 수 있다 → 판마다 새 점 배열을 만들어 끼운다(두 판이 같은 모양이 되지 않게)
	if _땅.has_method("set_point_array"):
		var pa := SS2D_Point_Array.new()
		pa.add_points(PackedVector2Array([Vector2(-h.x, -h.y), Vector2(h.x, -h.y), Vector2(h.x, h.y), Vector2(-h.x, h.y)]))
		pa.close_shape()
		_땅.call("set_point_array", pa)


## 시험(경로 재생)용 — 다 나온 자리로 바로 옮긴다(압력 발판이 정한 이동량을 받아서)
func 나온채로(이동량: Vector2) -> void:
	position += 이동량
