extends RefCounted
## ============================================================================
## [2026-10-06 Claude 신규] 게임 진행 — 챕터 선택 · 스테이지 클리어 저장 · 지도 모드
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 10-06)
##   "로비 화면에 쳅터 1 과 2 로 나뉘어, 1 을 선택하면 내가 만든 스테이지가 나오고
##    2 를 누르면 하수도 스테이지가 물·불 게임(Fireboy & Watergirl)처럼 거미줄처럼 쳐진 스테이지를
##    단계별로 클리어하고, 전부 클리어하면 다음 쳅터로 이어지게."
##
## ▣ 구조
##   · 쳅터 1(집)  = 이야기 순서(챕터.gd 의 스테이지표) — 연결구로 걸어서 이어진다. 지도 없음.
##   · 쳅터 2(하수도) = **지도**(scenes/lobby/쳅터2_지도.tscn)에서 스테이지를 골라 들어간다.
##       스테이지 출구(연결통로)에 닿으면 원래는 다음 씬으로 가지만, 지도 모드에서는
##       장면전환.통로로_이동() 이 여기 `통로_가로채기()` 를 불러 **클리어를 기록하고 지도로 돌아간다.**
##       (하수도 씬 파일은 다른 작업자 것이라 손대지 않는다 — 가로채기만 한다.)
##   · 저장 = user://진행.cfg  [클리어] 스테이지경로 = true · [쳅터] 번호 = true(쳅터 클리어)
##
## ▣ 지도 모양(거미줄) — 아래 `하수도_지도` 표가 **유일한 출처**다.
##   한 스테이지는 「열림」 조건 = 시작 칸이거나, 들어오는 선의 앞 스테이지 중 **하나라도** 클리어.
##   (FBWG 처럼 갈림길이 있어 막히면 다른 길로 돌아갈 수 있다.)
##   전부 클리어하면 쳅터 2 클리어 → 다음 쳅터(3)로. 쳅터 3 이 아직 없으면 "준비 중" 을 보여 준다.
## ============================================================================
class_name 게임진행

const 저장경로 := "user://진행.cfg"
const 지도_씬 := "res://scenes/lobby/쳅터2_지도.tscn"
const 로비_씬 := "res://scenes/lobby/lobby.tscn"
const 하수도_폴더 := "res://scenes/world_2_클로드/"

## 하수도(쳅터 2) 지도 — 칸 = [이름표, 씬, 지도 위치(0~1, 왼위 기준), 들어오는 선(앞 칸 이름표들)]
##   위치는 화면 비율이라 해상도가 바뀌어도 모양이 같다. 왼쪽 → 오른쪽으로 깊어진다.
##   ★순서·연결을 바꾸려면 이 표만 고친다(지도 화면은 이 표를 그대로 그린다).
const 하수도_지도: Array = [
	["2-1", "stage_2-1.tscn", Vector2(0.08, 0.50), []],
	["2-2", "stage_2-2.tscn", Vector2(0.20, 0.30), ["2-1"]],
	["2-3", "stage_2-3.tscn", Vector2(0.20, 0.70), ["2-1"]],
	["2-4", "stage_2-4.tscn", Vector2(0.34, 0.42), ["2-2", "2-3"]],
	["2-5", "stage_2-5.tscn", Vector2(0.34, 0.80), ["2-3"]],
	["2-6", "stage_2-6.tscn", Vector2(0.48, 0.28), ["2-4"]],
	["2-7", "stage_2-7.tscn", Vector2(0.48, 0.64), ["2-4", "2-5"]],
	["2-8", "stage_2-8.tscn", Vector2(0.63, 0.42), ["2-6", "2-7"]],
	["2-9", "stage_2-9.tscn", Vector2(0.63, 0.80), ["2-7"]],
	["2-10", "stage_2-10.tscn", Vector2(0.78, 0.56), ["2-8", "2-9"]],
	["2-11", "stage_2-11.tscn", Vector2(0.92, 0.40), ["2-10"]],
]

## 스테이지 표시 이름(씬 루트의 스테이지_이름 과 같은 글). 씬을 열지 않고 지도에 쓰려고 적어 둔다.
const 하수도_이름: Dictionary = {
	"2-1": "물이 흐르는 곳", "2-2": "구멍 난 바닥", "2-3": "관을 따라서", "2-4": "색이 흐른다",
	"2-5": "잠그거나 돌리거나", "2-6": "무거운 것", "2-7": "눌러 두어라", "2-8": "갈래",
	"2-9": "엇갈린 배수실", "2-10": "갈라진 수직 수로", "2-11": "잠긴 폭포의 계단",
}

## 지금 지도에서 들어간 스테이지인가 — 0 = 아님(이야기 진행 · 에디터 F6), 2 = 쳅터 2 지도
static var 지도_모드: int = 0
## 지도 화면이 돌아오면 이 칸에 커서를 둔다(방금 깬 곳이 보이게)
static var 마지막_칸: String = ""

static var _cfg: ConfigFile = null


static func _설정() -> ConfigFile:
	if _cfg == null:
		_cfg = ConfigFile.new()
		_cfg.load(저장경로)              # 파일이 없으면 빈 설정 — 처음 하는 사람
	return _cfg


static func _저장() -> void:
	_설정().save(저장경로)


static func 씬경로(칸: Array) -> String:
	return 하수도_폴더 + String(칸[1])


static func 칸_찾기(이름표: String) -> Array:
	for 칸 in 하수도_지도:
		if 칸[0] == 이름표:
			return 칸
	return []


static func 경로로_칸(경로: String) -> Array:
	for 칸 in 하수도_지도:
		if 씬경로(칸) == 경로:
			return 칸
	return []


static func 클리어함(이름표: String) -> bool:
	return bool(_설정().get_value("클리어", 이름표, false))


static func 클리어_기록(이름표: String) -> void:
	_설정().set_value("클리어", 이름표, true)
	if 쳅터2_전부_클리어():
		_설정().set_value("쳅터", "2", true)
	_저장()


static func 열림(이름표: String) -> bool:
	var 칸 := 칸_찾기(이름표)
	if 칸.is_empty():
		return false
	var 앞들: Array = 칸[3]
	if 앞들.is_empty():
		return true
	for 앞 in 앞들:
		if 클리어함(String(앞)):
			return true
	return false


static func 클리어_수() -> int:
	var n := 0
	for 칸 in 하수도_지도:
		if 클리어함(칸[0]):
			n += 1
	return n


static func 쳅터2_전부_클리어() -> bool:
	return 클리어_수() == 하수도_지도.size()


## 쳅터 1(집)의 끝에서 부른다 — 지붕·마당 도안이 생기면 마지막 출구가 이걸 부르게 한다(10-06 기준 미연결).
static func 쳅터_클리어(번호: int) -> void:
	_설정().set_value("쳅터", str(번호), true)
	_저장()


static func 쳅터_클리어함(번호: int) -> bool:
	return bool(_설정().get_value("쳅터", str(번호), false))


## 처음부터 다시(로비 설정 등에서 쓸 수 있게). 지금은 검사 도구만 쓴다.
static func 진행_지우기() -> void:
	_cfg = ConfigFile.new()
	_저장()


## ★장면전환.통로로_이동() 이 맨 앞에서 부른다.
##   지도 모드에서 하수도 스테이지의 출구에 닿으면 → 클리어 기록 + 목적지를 **지도**로 바꾼다.
##   돌려주는 값 = 실제로 갈 씬 경로(가로채지 않으면 받은 그대로).
static func 통로_가로채기(왔던_씬: String, 가려는_씬: String) -> String:
	if 지도_모드 != 2:
		return 가려는_씬
	var 칸 := 경로로_칸(왔던_씬)
	if 칸.is_empty():
		return 가려는_씬                 # 지도 밖 씬(테스트 등) — 손대지 않는다
	클리어_기록(칸[0])
	마지막_칸 = 칸[0]
	return 지도_씬
