## 스테이지 표시 이름(씬 루트의 스테이지_이름 과 같은 글). 씬을 열지 않고 지도에 쓰려고 적어 둔다.
const 하수도_이름: Dictionary = {
	"2-1": "물이 흐르는 곳", "2-2": "구멍 난 바닥", "2-3": "관을 따라서", "2-4": "색이 흐른다",
	"2-5": "계단을 꺼내라", "2-6": "무거운 것", "2-7": "눌러 두어라", "2-8": "갈래",
	"2-9": "엇갈린 배수실", "2-10": "갈라진 수직 수로", "2-11": "잠긴 폭포의 계단",
}

## 지금 지도에서 들어간 스테이지인가 — 0 = 아님(이야기 진행 · 에디터 F6), 2 = 쳅터 2 지도
static var 지도_모드: int = 0
## 사진 지도는 두 챕터가 같은 UI를 쓴다. 플레이 도중 자동으로 지도를 열지는 않는다.
static var 선택_쳅터: int = 1
## 지도 화면이 돌아오면 이 칸에 커서를 둔다(방금 깬 곳이 보이게)
static var 마지막_칸: String = ""

static var _cfg: ConfigFile = null


static func _설정() -> ConfigFile:
	if _cfg == null:
		_cfg = ConfigFile.new()
		_cfg.load(저장경로)              # 파일이 없으면 빈 설정 — 처음 하는 사람
	return _cfg


static func _저장() -> void:
	# [2026-10-09] 시험 실행이면 파일에 쓰지 않는다(메모리의 _cfg 에는 남아 그 시험 안에서는 그대로 쓰인다).
	#   시험이 스테이지를 띄우기만 해도 열쇠 줍기·쳅터 클리어가 도형님 저장 파일에 쌓였다 — 모든 저장이 여기를 지난다.
	if not 기록해도_되나():
		return
	_설정().save(저장경로)


static func 씬경로(칸: Array) -> String:
	return 하수도_폴더 + String(칸[1])


static func 칸_찾기(이름표: String) -> Array:
	for 칸 in 하수도_지도:
		if 칸[0] == 이름표:
			return 칸
	return []


static func 경로로_칸(경로: String) -> Array:
	for 칸 in 하수도_지도:
		if 씬경로(칸) == 경로:
			return 칸
	return []


static func 클리어함(이름표: String) -> bool:
	return bool(_설정().get_value("클리어", 이름표, false))


static func 클리어_기록(이름표: String) -> void:
	_설정().set_value("클리어", 이름표, true)
	if 쳅터2_전부_클리어():
		_설정().set_value("쳅터", "2", true)
	_저장()


static func 열림(이름표: String) -> bool:
	var 칸 := 칸_찾기(이름표)
	if 칸.is_empty():
		return false
	var 앞들: Array = 칸[3]
	if 앞들.is_empty():
		return true
	for 앞 in 앞들:
		if 클리어함(String(앞)):
			return true
	return false


static func 클리어_수() -> int:
	var n := 0
	for 칸 in 하수도_지도:
		if 클리어함(칸[0]):
			n += 1
	return n


static func 쳅터2_전부_클리어() -> bool:
	return 클리어_수() == 하수도_지도.size()


## 쳅터 1(집)의 끝에서 부른다 — 지붕·마당 도안이 생기면 마지막 출구가 이걸 부르게 한다(10-06 기준 미연결).
static func 쳅터_클리어(번호: int) -> void:
	_설정().set_value("쳅터", str(번호), true)
	_저장()


static func 쳅터_클리어함(번호: int) -> bool:
	return bool(_설정().get_value("쳅터", str(번호), false))


## ── [2026-10-08 Claude] 반반 열쇠 진행 (기획 §4-A 규칙 7 · §7-7 "죽어도 주운 조각 유지") ───────────
##   [열쇠] "<씬경로>#왼쪽" / "#오른쪽" = 그 조각을 주웠다 · "#문" = 그 스테이지 잠긴 문을 열었다.
##   씬 경로를 열쇠로 쓰는 이유: 쳅터1(연결구)과 하수도(지도 칸) 둘 다 같은 방식으로 기록되게 — 칸 이름표는 하수도에만 있다.
static func 열쇠_조각_기록(씬: String, 쪽: String) -> void:
	_설정().set_value("열쇠", 씬 + "#" + 쪽, true)
	_저장()


static func 열쇠_조각_있나(씬: String, 쪽: String) -> bool:
	return bool(_설정().get_value("열쇠", 씬 + "#" + 쪽, false))


static func 열쇠_문_열기_기록(씬: String) -> void:
	_설정().set_value("열쇠", 씬 + "#문", true)
	_저장()


static func 열쇠_문_열림(씬: String) -> bool:
	return bool(_설정().get_value("열쇠", 씬 + "#문", false))


## 쳅터2 지도 칸 표식용 — 그 스테이지의 열쇠를 다 모아 문을 열었나.
static func 열쇠_얻음(씬: String) -> bool:
	return 열쇠_문_열림(씬) or (열쇠_조각_있나(씬, "왼쪽") and 열쇠_조각_있나(씬, "오른쪽"))


## ── [2026-10-09 Claude] 쳅터1 퍼즐 보드 진행 ─────────────────────────────────────────────
##   도형님: "스테이지 선택 창을 퍼즐처럼 — 한 스테이지를 클리어하면 퍼즐이 채워지고, 빈 곳을 클릭해 하나씩 채우는 느낌.
##   실로 이어져 앞 스테이지를 깨야 뒤 스테이지 · 숨겨진 스테이지는 입구를 찾으면 점선 · 클리어하면 도장."
##   [쳅터1클리어] <씬경로> = true   · 출구(앞으로 나가는 길목)로 나가면 기록 — 전경전환.연결로_이동 이 부른다.
##   [방문] <씬경로> = true          · 그 스테이지에 한 번이라도 들어왔나(숨은 스테이지의 '입구를 찾았다').
##   [보드] 본_<씬경로> = true        · 보드가 '채워지는 연출'을 이미 보여 줬나(한 번만 반짝).
##          길_<이름> = true          · 그 길(2층 · 1층 …) 완료 창을 이미 띄웠나.
##   기록(시간·사망)은 따로 user://completed_runs.cfg(실행_기록.gd) — 보드가 같이 읽는다.
## [2026-10-09 Codex] 선택창에서 시작했는지의 정보만 보존한다. 출구에서는 항상 세계 안의 다음 길로 이어진다.
static var 보드_모드: bool = false
## 보드가 돌아오면 이 조각에 커서를 둔다
static var 마지막_조각: String = ""
const 보드_씬 := "res://scenes/lobby/퍼즐보드.tscn"
const 타이틀_씬 := "res://scenes/lobby/타이틀.tscn"


## 진행을 파일에 적어도 되나 — 진짜 게임이면 예. **시험 실행**(`-s 시험.gd` 로 띄운 SceneTree 스크립트)은 아니오:
##   스테이지를 띄우기만 해도 '방문'·'클리어' 가 도형님 저장 파일에 쌓이면 안 된다(숨은 서재가 저절로 발견된다 등).
##   진행을 일부러 시험하는 도구는 `기록_허용 = 1` 로 켠다(그 도구는 저장 파일을 떠 두고 되돌린다).
static var 기록_허용: int = -1          ## −1 자동 · 0 끔 · 1 켬


static func 기록해도_되나() -> bool:
	if 기록_허용 >= 0:
		return 기록_허용 == 1
	var 루프 := Engine.get_main_loop()
	return 루프 == null or 루프.get_script() == null


static func 쳅터1_클리어_기록(씬: String) -> void:
	if not 기록해도_되나():
		return
	_설정().set_value("쳅터1클리어", 씬, true)
	_저장()


static func 쳅터1_클리어함(씬: String) -> bool:
	return bool(_설정().get_value("쳅터1클리어", 씬, false))


static func 방문_기록(씬: String) -> void:
	if not 기록해도_되나():
		return
	# 갈림길에서는 표의 첫 미완료 방보다 실제 마지막으로 들어간 스테이지가 이어하기 위치다.
	var 달라짐 := String(_설정().get_value("이어하기", "씬", "")) != 씬
	_설정().set_value("이어하기", "씬", 씬)
	if not 달라짐 and bool(_설정().get_value("방문", 씬, false)):
		return                          # 이미 적혀 있으면 파일을 다시 쓰지 않는다(스테이지마다 들어올 때 불린다)
	_설정().set_value("방문", 씬, true)
	_저장()

static func 이어할_씬() -> String:
	return String(_설정().get_value("이어하기", "씬", ""))


static func 방문함(씬: String) -> bool:
	return bool(_설정().get_value("방문", 씬, false))


static func 보드_본(키: String) -> bool:
	return bool(_설정().get_value("보드", 키, false))


static func 보드_봄_기록(키: String) -> void:
	if not 기록해도_되나():
		return
	_설정().set_value("보드", 키, true)
	_저장()


## 이어하기 — 진행이 하나라도 있나(타이틀의 '이어하기' 버튼을 보일지)
static func 진행_있나() -> bool:
	return _설정().has_section("쳅터1클리어") or _설정().has_section("방문") or _설정().has_section("클리어")


## 처음부터 다시(로비 설정 등에서 쓸 수 있게). 지금은 검사 도구만 쓴다.
static func 진행_지우기() -> void:
	_cfg = ConfigFile.new()
	_저장()


## ★장면전환.통로로_이동() 이 맨 앞에서 부른다.
##   지도 모드에서 하수도 스테이지의 출구에 닿으면 → 클리어를 기록하고 실제 목적지는 그대로 둔다.
##   돌려주는 값 = 실제로 갈 씬 경로(가로채지 않으면 받은 그대로).
static func 통로_가로채기(왔던_씬: String, 가려는_씬: String) -> String:
	var 칸 := 경로로_칸(왔던_씬)
	if 칸.is_empty():
		return 가려는_씬                 # 지도 밖 씬(테스트 등) — 손대지 않는다
	클리어_기록(칸[0])
	마지막_칸 = 칸[0]
	# [2026-10-09 Codex] 기록/해금은 저장하되 지도는 사용자가 직접 열 때 보여 준다. 도장 때문에 플레이를 끊지 않는다.
	return 가려는_씬
