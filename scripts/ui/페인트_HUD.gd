extends CanvasLayer
## ============================================================================
## [2026-08-17 신규] 페인트 HUD — 글씨 대신 점(pip)으로 보여주는 페인트 이코노미
## ----------------------------------------------------------------------------
## ▣ 무엇을 고치려고 만들었나
##   예전 HUD 는 한 줄짜리 글씨였다:
##       "페인트 8 / 12   (회수대기 3)   [회색으로 잠김 2발]"
##   문제가 세 가지 있었다.
##     ① 퍼즐의 핵심 자원을 **문장으로 읽게** 만든다. 한눈에 안 들어온다.
##     ② "회수대기 3" 의 3 은 **발 수가 아니라 대상 개수**다. 옆의 숫자들은 발 단위라
##        플레이어는 같은 단위로 읽는다 → "3발 대기" 로 오해한다.
##        (대상 하나가 3발을 먹고 있어도 화면엔 1 로 뜬다)
##     ③ 규칙 4(FIFO)가 **눈에 안 보인다.** 다음에 무엇이 돌아올지 모르는 채로 E 를 누른다.
##        칠한 발판을 되돌리면 그 발판이 실제로 사라지므로, 밟고 선 것을 회수해 추락하는
##        사고가 난다. 순서가 안 보이면 FIFO 는 규칙이 아니라 함정이다.
##
## ▣ 그래서 이렇게 바꿨다
##   · 탄약 총량을 **칸 수로 고정**해서 그린다. 칸이 사라지지 않고 상태만 바뀌므로
##     "내 페인트가 지금 어디에 가 있나"가 한 줄로 읽힌다.
##   · 회수 대기 칸을 **대상별로 묶는다.** 묶음 사이만 넓게 띄우면 글씨 없이
##     "대상 3개, 각각 2·3·1발" 이 읽힌다. 라벨을 붙이면 대상이 몇 개만 돼도 줄이 무너진다.
##   · 다음 회수 대상 위에 **E 마커**와 돌아올 발수를 띄운다.
##   · 대상에 마우스를 얹으면 그 대상에 **몇 발 들어갔는지** 그 자리에 띄운다.
##     ("몇 발 썼지?" 는 화면 구석이 아니라 그 대상 옆에 있어야 하는 정보다)
##
## ▣ 색을 어떻게 정했나 — 흑백 게임이라 여기가 제일 까다롭다
##   탄약 점을 흰색으로 그리면 "흰 페인트 잔량"으로 오해한다. **회색은 더 나쁘다** —
##   이 게임에서 회색은 "죽은 색 · 복구 불가"라 정반대 의미가 된다.
##   → 찬 점은 **지금 내 색으로 채우고 링은 반대색**으로 두른다.
##     쏘면 정말 그 색이 나가므로 오해가 아니라 사실이고, Shift 로 색을 바꾸면
##     칸이 한꺼번에 뒤집혀 **색 전환 자체에 피드백이 생긴다**(지금은 그게 없다).
##   → 어느 배경에서도 살아남도록 점마다 **어두운 받침 원**을 깔았다.
##     (조준 궤적이 2026-07-22 에 "어두운 링 + 밝은 코어" 로 푼 것과 같은 문제·같은 해법)
##
## ▣ 시스템이 둘이라 어댑터를 통해서만 읽는다
##   스마트월드(페인트 코어)와 stage_1-1, 1-2(타일맵)는 API 가 다르다.
##   이 파일은 대상의 정체를 모른 채 `페인트HUD어댑터` 로만 대화한다.
##   탄약이 없는 시스템은 `탄약()` 이 빈 사전을 주고, 그러면 탄약 줄을 건너뛴다.
## ============================================================================
## ★★[2026-09-04 도형님] 좌상단 탄약 표시를 점(pip) → **D/OLD 스타일 캡슐 바 + 얼굴 배지**로
##   바꿨다. 위 설명의 "점/받침/링" 은 옛 방식이고, 지금은 캡슐 세그먼트로 같은 정보를 그린다.
##   ★플레이어 색에 따라 껍데기/채움이 흑↔백으로 통째로 뒤집혀, Shift 색전환이 HUD 로도 보인다.
##   회수 마커·호버(월드 좌표 표식)는 그대로 유지했다.
class_name 페인트HUD

## ⚠ 타입 참조를 class_name 이 아니라 **경로 preload** 로 잡는다.
##   새 스크립트의 전역 클래스 이름은 에디터가 한 번 훑어야 등록된다. 그 전에
##   헤드리스로 검사를 돌리면 "Identifier 페인트HUD어댑터 not declared" 로 통째로 죽는다
##   (2026-08-17 실제로 검사 3개가 이 이유로 깨졌다).
##   경로 preload 는 캐시와 무관하게 항상 해결된다 — 이 프로젝트가 원래 쓰던 방식이다.
const 어댑터_기반 := preload("res://scripts/ui/페인트_HUD_어댑터.gd")

# ── 배치 ────────────────────────────────────────────────────────────────────
## 점 줄이 시작하는 화면 좌표. 씬마다 다른 HUD 가 이미 있을 수 있어 밖에서 옮길 수 있게 둔다.
var 여백: Vector2 = Vector2(26, 22)
const 묶음_틈: float = 10.0        ## 대상이 바뀔 때 추가로 벌리는 거리
const 잠김_틈: float = 18.0        ## 회색 구간 앞에서 벌리는 거리

# ── 색 ──────────────────────────────────────────────────────────────────────
const 검정: Color = Color(0.07, 0.07, 0.07)
const 흰색: Color = Color(0.95, 0.95, 0.93)
## 회수 대기·잠김은 플레이어 색과 무관하게 **밝은 저알파**로 그린다.
## 반대색으로 그리면 흰 플레이어일 때 검은 링이 어두운 받침에 묻혀 사라진다.
const 대기_링: Color = Color(0.88, 0.88, 0.85, 0.50)

# ── ★[2026-09-03] D/OLD 스타일 캡슐 바 (도형님 요청) ─────────────────────
## 껍데기 톤 두 가지. 플레이어 색과 반대 톤을 써서 채움(내 색)이 그 위에서 읽히게 한다.
const 껍데기_어둠: Color = Color(0.10, 0.10, 0.13, 0.92)   ## 흰색 플레이어일 때
const 껍데기_밝음: Color = Color(0.90, 0.90, 0.87, 0.92)   ## 검정 플레이어일 때
const 배지_반경: float = 17.0        ## 얼굴 배지 반지름
const 캡슐_틈: float = 8.0           ## 배지와 캡슐 사이
const 캡슐_반높이: float = 15.0      ## 캡슐 껍데기 반높이
const 캡슐_속여백: float = 5.0       ## 캡슐 안쪽 좌우 여백
const 칸_폭: float = 15.0            ## 세그먼트 한 칸 폭(틈 포함)
const 칸_틈: float = 3.0             ## 세그먼트 사이 틈
const 세그_반높이: float = 9.0       ## 세그먼트 반높이

## 탄약이 0 일 때 줄이 맥동하는 주기(초)
const 맥동_주기: float = 0.9

var _어댑터: 어댑터_기반 = null
var _플레이어: Node = null
var _캔버스: Control = null
var _시간: float = 0.0
## 마우스가 안 움직이면 호버 판정(물리 조회)을 다시 하지 않는다.
var _마지막_마우스: Vector2 = Vector2(-9999, -9999)
var _호버대상: Variant = null


## 스테이지가 부른다. 어댑터가 없으면 아무것도 그리지 않는다.
func 연결(플레이어: Node, 어댑터: 어댑터_기반) -> void:
	_플레이어 = 플레이어
	_어댑터 = 어댑터


func _ready() -> void:
	# 핵심 자원 정보는 비네트(50)에 가려지면 안 되므로 일반 화면 효과보다 위에 고정한다.
	layer = 100
	_캔버스 = Control.new()
	_캔버스.name = "그리기"
	_캔버스.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_캔버스.set_anchors_preset(Control.PRESET_FULL_RECT)
	_캔버스.draw.connect(_그리기)
	add_child(_캔버스)
	set_process(true)


func _process(delta: float) -> void:
	_시간 += delta
	if _캔버스 == null:
		return
	# 호버는 물리 조회라 싸지 않다 → 마우스가 실제로 움직였을 때만 다시 판정한다.
	var m := _캔버스.get_global_mouse_position()
	if m.distance_to(_마지막_마우스) > 2.0:
		_마지막_마우스 = m
		_호버대상 = _어댑터.대상_아래(m) if _어댑터 != null else null
	_캔버스.queue_redraw()


# ── 그리기 ──────────────────────────────────────────────────────────────────

func _그리기() -> void:
	if _어댑터 == null or not _어댑터.살아있나():
		return
	_탄약줄_그리기()
	_회수_마커_그리기()
	_호버_그리기()


## 좌상단 한 줄. 탄약이 없는 시스템에서는 회수 묶음만 나온다.
func _탄약줄_그리기() -> void:
	var 탄약: Dictionary = _어댑터.탄약()
	var 줄: Array = _어댑터.회수줄()
	var 잠김: int = _어댑터.잠긴_발수()

	var 칸들 := _칸_배치(탄약, _어댑터.진행줄(), 줄, 잠김)
	if 칸들.is_empty():
		return

	# 탄약이 바닥나면 캡슐 전체가 천천히 맥동한다 — "지금 못 쏜다"를 몸으로 알린다.
	var 맥동 := 1.0
	if not 탄약.is_empty() and int(탄약.get("남은", 1)) <= 0:
		맥동 = 0.6 + 0.4 * absf(sin(_시간 * TAU / 맥동_주기))

	# ── ★[2026-09-03 도형님] D/OLD 스타일 캡슐 바 + 얼굴 배지 ──────────────
	#   예전엔 점(pip)을 흩어 놓았다. 이제 소인국 게임의 HUD 처럼 **캡슐 게이지**로 묶고
	#   왼쪽에 후드 캐릭터 얼굴 배지를 단다.
	#   ★핵심: 껍데기(shell)와 채움(ink)이 **플레이어 색에 따라 통째로 뒤집힌다.**
	#     흰색이면 어두운 껍데기 + 흰 채움, 검정이면 밝은 껍데기 + 검정 채움.
	#     → 색을 스위치하면 HUD 가 흑↔백으로 뒤집혀 "지금 무슨 색을 쏘나"가 한눈에 보인다.
	var 흰색차례 := _내_색() == 흰색
	var 잉크 := 흰색 if 흰색차례 else 검정                 # 채움·후드 = 내 색
	var 껍데기 := 껍데기_어둠 if 흰색차례 else 껍데기_밝음   # 프레임·배지 바탕 = 반대 톤

	var 배지중심 := Vector2(여백.x + 배지_반경, 여백.y + 배지_반경)
	_얼굴배지(배지중심, 배지_반경, 잉크, 껍데기, 맥동)

	# 캡슐 본체 — 배지 오른쪽에 붙는다.
	var 캡왼 := 배지중심.x + 배지_반경 + 캡슐_틈
	var 칸수 := 칸들.size()
	var 캡폭 := 칸수 * 칸_폭 + 캡슐_속여백 * 2.0
	var 위 := 여백.y + 배지_반경 - 캡슐_반높이
	_스타디움(Vector2(캡왼 + 캡슐_반높이, 배지중심.y),
		Vector2(캡왼 + 캡폭 - 캡슐_반높이, 배지중심.y), 캡슐_반높이,
		Color(껍데기.r, 껍데기.g, 껍데기.b, 껍데기.a * 맥동))

	# 세그먼트 — 칸 종류대로 채움/윤곽/빗금.
	var sx := 캡왼 + 캡슐_속여백
	for 칸 in 칸들:
		_세그먼트(Vector2(sx, 위 + 캡슐_반높이), String(칸["종류"]), 잉크, 껍데기, 맥동)
		sx += 칸_폭


## 칸 목록을 만든다. 원소 = { "종류": String, "앞틈": float }
##   찬   = 지금 쏠 수 있는 발
##   진행 = 칠하는 중 (아직 E 로 못 돌려받음). 점선으로 그린다
##   빈   = 회수 대기 (E 로 돌아옴). 대상이 바뀌는 첫 칸에 앞틈을 준다
##   잠김 = 회색이 되어 스테이지 이동 전까지 못 쓰는 발
##   빈칸 = 어디에도 없는 발 (아래 ⚠ 참고)
func _칸_배치(탄약: Dictionary, 진행: Array, 줄: Array, 잠김: int) -> Array:
	var 칸들: Array = []
	var 첫칸 := true

	if not 탄약.is_empty():
		for _i in maxi(int(탄약.get("남은", 0)), 0):
			칸들.append({ "종류": "찬", "앞틈": 0.0 })
			첫칸 = false

	# ★탄약이 없는 시스템에서는 발수가 자원이 아니라 "플랫폼 크기"라 값이 크다.
	#   그대로 그리면 줄이 화면을 가로지른다 → 대상 하나에 점 하나로 접는다.
	var 발수대로 := _어댑터.발수를_센다()

	# ── 진행 중 ── 회수 대기보다 **앞**에 둔다.
	#   아직 확정이 아니라서 왼쪽(= 곧 될 것) → 오른쪽(= 이미 된 것) 순서가 자연스럽다.
	for 항목 in 진행:
		# 탄약을 쓰면 진행 중인 발도 **묶여 있는 자원**이라 칸으로 세야 합계가 맞는다
		# (남은 + 진행 + 회수대기 + 잠김 = 최대).
		var 진행발수 := maxi(int(항목.get("발수", 0)), 1) if 발수대로 else 1
		for i in 진행발수:
			칸들.append({ "종류": "진행", "앞틈": (묶음_틈 if (i == 0 and not 첫칸) else 0.0) })
			첫칸 = false

	for 항목 in 줄:
		var 발수 := maxi(int(항목.get("발수", 0)), 0) if 발수대로 else 1
		for i in 발수:
			# 묶음의 첫 칸만 벌린다 → 글씨 없이 "여기서 대상이 바뀐다"가 읽힌다
			var 틈 := (묶음_틈 if (i == 0 and not 첫칸) else 0.0)
			칸들.append({ "종류": "빈", "앞틈": 틈 })
			첫칸 = false

	for i in maxi(잠김, 0):
		칸들.append({ "종류": "잠김", "앞틈": (잠김_틈 if (i == 0 and not 첫칸) else 0.0) })
		첫칸 = false

	# ── ⚠ 남는 칸 채우기 ──
	# 정상 상태에서는 남은 + 회수대기 + 잠김 = 최대 가 성립한다.
	# 그런데 `수동_회수()` 는 이미 사라진 대상을 줄에서 꺼내 **환급 없이 버린다**.
	# 그러면 합이 최대보다 작아진다. 그 차이를 숨기지 않고 흐린 빈칸으로 드러내
	# "페인트가 어디론가 없어졌다"가 화면에 보이게 한다.
	if not 탄약.is_empty():
		var 모자람 := maxi(int(탄약.get("최대", 0)) - 칸들.size(), 0)
		for i in 모자람:
			칸들.append({ "종류": "빈칸", "앞틈": (잠김_틈 if (i == 0 and not 첫칸) else 0.0) })
			첫칸 = false
	return 칸들


## 후드를 쓴 캐릭터 얼굴 배지. 스크린샷의 플레이어(뾰족 후드 + 둥근 얼굴)를 단순화했다.
##   바탕(껍데기색) 위에 잉크색으로 후드·얼굴을 얹고, 잉크색 링으로 두른다.
func _얼굴배지(중심: Vector2, r: float, 잉크: Color, 껍데기: Color, 맥동: float) -> void:
	var c := _캔버스
	# 바깥 그림자 링 → 어느 배경에서도 배지가 뜬다
	c.draw_circle(중심, r + 2.0, Color(0.03, 0.03, 0.04, 0.55 * 맥동))
	# 바탕
	var 바탕 := Color(껍데기.r, 껍데기.g, 껍데기.b, 껍데기.a * 맥동)
	c.draw_circle(중심, r, 바탕)
	# 잉크 링
	var 링 := Color(잉크.r, 잉크.g, 잉크.b, 0.9 * 맥동)
	c.draw_arc(중심, r - 0.6, 0.0, TAU, 32, 링, 2.0, true)

	# ── 후드 실루엣 (잉크색) ──
	var 잉크색 := Color(잉크.r, 잉크.g, 잉크.b, 맥동)
	# 뾰족 후드: 위 꼭지 → 좌우 어깨로 내려오는 삼각형에 가까운 망토
	var 후드 := PackedVector2Array([
		중심 + Vector2(0.0, -r * 0.82),
		중심 + Vector2(r * 0.62, r * 0.25),
		중심 + Vector2(r * 0.44, r * 0.72),
		중심 + Vector2(-r * 0.44, r * 0.72),
		중심 + Vector2(-r * 0.62, r * 0.25),
	])
	c.draw_colored_polygon(후드, 잉크색)
	# 얼굴 구멍 — 후드 안의 반대 톤 타원(껍데기색). 여기서 "안을 들여다보는 얼굴"이 읽힌다.
	var 얼굴중심 := 중심 + Vector2(0.0, -r * 0.04)
	var 얼굴 := PackedVector2Array()
	for i in 14:
		var a := TAU * float(i) / 14.0
		얼굴.append(얼굴중심 + Vector2(cos(a) * r * 0.30, sin(a) * r * 0.40))
	c.draw_colored_polygon(얼굴, 바탕)
	# 눈 한 점(잉크색) — 스크린샷 캐릭터의 한쪽 눈 느낌
	c.draw_circle(얼굴중심 + Vector2(-r * 0.08, -r * 0.02), maxf(r * 0.07, 1.2), 잉크색)


## 스타디움(양끝이 둥근 캡슐) 채움. a·b 는 중심선의 양 끝, h 는 반높이.
func _스타디움(a: Vector2, b: Vector2, h: float, 색: Color) -> void:
	var c := _캔버스
	# 가운데 사각 + 양끝 반원. 겹쳐 그려도 같은 색이라 이음매가 안 보인다.
	var 사각 := Rect2(a.x, a.y - h, b.x - a.x, h * 2.0)
	c.draw_rect(사각, 색)
	c.draw_circle(a, h, 색)
	c.draw_circle(b, h, 색)


## 세그먼트 한 칸. 왼쪽 위 모서리 기준(가운데선 y).
func _세그먼트(중심선왼: Vector2, 종류: String, 잉크: Color, 껍데기: Color, 맥동: float) -> void:
	var c := _캔버스
	var w := 칸_폭 - 칸_틈
	var h := 세그_반높이
	var 틀 := Rect2(중심선왼.x, 중심선왼.y - h, w, h * 2.0)
	match 종류:
		"찬":
			# 지금 쏠 수 있는 발 = 잉크색으로 꽉 채운다. 이게 색 스위치의 주인공.
			var 채움 := Color(잉크.r, 잉크.g, 잉크.b, 맥동)
			c.draw_rect(틀, 채움)
			# 살짝 밝은 윗줄 — 캡슐이 볼록해 보이게(도트 게이지 느낌)
			c.draw_rect(Rect2(틀.position, Vector2(w, h * 0.5)),
				Color(잉크.r, 잉크.g, 잉크.b, 0.22 * 맥동))
		"진행":
			# 칠하는 중(아직 회수 못 함) = 잉크 윤곽 + 점 하나. "곧 돌아올 자리".
			c.draw_rect(틀, Color(잉크.r, 잉크.g, 잉크.b, 0.16 * 맥동))
			c.draw_circle(틀.get_center(), maxf(h * 0.3, 1.5), Color(잉크.r, 잉크.g, 잉크.b, 0.6 * 맥동))
		"빈":
			# 회수 대기(E 로 돌아옴) = 빈 윤곽.
			c.draw_rect(틀, Color(잉크.r, 잉크.g, 잉크.b, 0.10 * 맥동))
			_사각테(틀, Color(잉크.r, 잉크.g, 잉크.b, 0.4 * 맥동), 1.4)
		"잠김":
			# 회색으로 잠김 = 빗금. 형태로 구분해야 흑백에서도 읽힌다.
			c.draw_rect(틀, Color(잉크.r, 잉크.g, 잉크.b, 0.06 * 맥동))
			c.draw_line(틀.position + Vector2(2, h * 2.0 - 2),
				틀.position + Vector2(w - 2, 2), Color(잉크.r, 잉크.g, 잉크.b, 0.34 * 맥동), 1.4, true)
		"빈칸":
			# 어디에도 없는 발(환급 없이 사라진 것) = 아주 흐린 윤곽.
			_사각테(틀, Color(잉크.r, 잉크.g, 잉크.b, 0.14 * 맥동), 1.0)


## 사각형 테두리 네 변.
func _사각테(틀: Rect2, 색: Color, 두께: float) -> void:
	var c := _캔버스
	var p := 틀.position
	var s := 틀.size
	c.draw_line(p, p + Vector2(s.x, 0), 색, 두께, true)
	c.draw_line(p + Vector2(s.x, 0), p + s, 색, 두께, true)
	c.draw_line(p + s, p + Vector2(0, s.y), 색, 두께, true)
	c.draw_line(p + Vector2(0, s.y), p, 색, 두께, true)

## 다음에 E 로 회수될 대상 위에 마커 + 돌아올 발수.
## ★이게 없으면 E 는 "무엇이 풀릴지 모르고 누르는 키"가 된다.
func _회수_마커_그리기() -> void:
	var 대상: Variant = _어댑터.다음_회수대상()
	if 대상 == null or not _어댑터.유효한가(대상):
		return
	var 화면 := _화면좌표(_어댑터.대상_좌표(대상))
	if not _화면안(화면):
		return

	var 발수 := _어댑터.대상_발수(대상)
	var 중심 := 화면 + Vector2(0, -34)
	# 마커는 항상 같은 밝기다 — 플레이어 색을 따라가면 배경에 묻히는 조합이 생긴다.
	_캔버스.draw_circle(중심, 13.0, Color(0.04, 0.04, 0.04, 0.62))
	_캔버스.draw_circle(중심, 11.0, 흰색)
	var 폰트 := ThemeDB.fallback_font
	var 글크기 := 15
	var 폭 := 폰트.get_string_size("E", HORIZONTAL_ALIGNMENT_LEFT, -1, 글크기).x
	_캔버스.draw_string(폰트, 중심 + Vector2(-폭 * 0.5, 5), "E",
		HORIZONTAL_ALIGNMENT_LEFT, -1, 글크기, 검정)
	# 돌아올 발수를 마커 아래에 점으로 — "E 를 누르면 이만큼 돌아온다"
	_작은점들(중심 + Vector2(0, 17), 발수, 대기_링)


## 마우스를 얹은 대상 위에 지금 몇 발 들어갔는지.
## 안 들어간 대상(0발)에는 아무것도 안 띄운다 — 화면이 지저분해진다.
func _호버_그리기() -> void:
	if _호버대상 == null or not _어댑터.유효한가(_호버대상):
		return
	var 발수 := _어댑터.대상_발수(_호버대상)
	if 발수 <= 0:
		return
	var 화면 := _화면좌표(_어댑터.대상_좌표(_호버대상))
	if not _화면안(화면):
		return
	_작은점들(화면 + Vector2(0, -20), 발수, 흰색)


## 작은 점을 가로로 나열한다 (마커·호버 공용). 가운데 정렬.
func _작은점들(중심: Vector2, 개수: int, 색: Color) -> void:
	if 개수 <= 0:
		return
	var r := 3.4
	var 간격 := 10.0
	var 시작 := 중심.x - (개수 - 1) * 간격 * 0.5
	for i in 개수:
		var p := Vector2(시작 + i * 간격, 중심.y)
		_캔버스.draw_circle(p, r + 1.8, Color(0.04, 0.04, 0.04, 0.62))
		_캔버스.draw_circle(p, r, 색)


# ── 잡일 ────────────────────────────────────────────────────────────────────

func _내_색() -> Color:
	if _플레이어 == null or not is_instance_valid(_플레이어):
		return 검정
	return 검정 if int(_플레이어.get("player_color")) == ColorDefs.BLACK else 흰색


## 월드 → 화면. 카메라가 움직여도 마커가 대상에 붙어 있어야 한다.
func _화면좌표(월드: Vector2) -> Vector2:
	return _캔버스.get_viewport().get_canvas_transform() * 월드


## 화면 밖 마커는 그리지 않는다 (가장자리에 눌어붙어 보이는 걸 막는다).
func _화면안(화면: Vector2) -> bool:
	var 크기 := _캔버스.get_viewport_rect().size
	return 화면.x > -40.0 and 화면.y > -40.0 and 화면.x < 크기.x + 40.0 and 화면.y < 크기.y + 40.0
