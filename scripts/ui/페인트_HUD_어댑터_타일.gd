extends "res://scripts/ui/페인트_HUD_어댑터.gd"
## ============================================================================
## [2026-08-17 신규] 어댑터 — 타일맵 페인트(stage_1-1, 1-2)용
## ----------------------------------------------------------------------------
## 대상 = `tile_paint_map.gd` 안의 내부 클래스 `플랫폼` (Node 가 아니다).
##
## ▣ 이 시스템에는 탄약이 없다
##   `탄약()` 이 빈 사전을 돌려주므로 HUD 가 **12칸 줄을 아예 안 그린다.**
##   대신 회수 대기 묶음 · 회색 잠김 · E 마커 · 호버 발수는 똑같이 나온다.
##   (나중에 이쪽에도 탄약을 넣기로 하면 `탄약()` 한 함수만 채우면 된다)
##
## ▣ "잠긴 발수" 를 회색 대상 수로 대신하는 이유
##   발 단위 자원이 없으니 잠긴 발수를 셀 수가 없다. 그래도 **회색이 몇 개 생겼는지**는
##   플레이어가 알아야 하는 정보라(되돌릴 수 없는 실수의 누적) 개수로 바꿔 보여준다.
## ============================================================================
class_name 페인트HUD타일어댑터

var _타일: TilePaintMap = null


func _init(타일: TilePaintMap) -> void:
	_타일 = 타일


func 살아있나() -> bool:
	return _타일 != null and is_instance_valid(_타일)


## [2026-08-17] 탄약이 생겼다. `최대_탄약 <= 0`(무제한)이면 예전처럼 빈 사전을 줘서
## HUD 가 탄약 줄을 건너뛴다 — 그 설정을 쓰는 스테이지가 안 깨지게.
func 탄약() -> Dictionary:
	if not 살아있나() or not _타일.탄약을_쓰나():
		return {}
	# ★날아가는 중인 발은 아직 내 것으로 센다 → 비행 중엔 화면이 안 흔들리고
	#   **착탄하는 순간 한 번만** 바뀐다. (어댑터_코어와 같은 이유·같은 처리)
	return { "남은": _타일.남은_탄약 + _타일.비행중(), "최대": _타일.최대_탄약 }


## ★탄약을 쓰면 발수가 자원이 되고 총량이 묶이므로 칸으로 세도 줄이 안 길어진다.
##   무제한이면 `맞은` 은 그냥 플랫폼 크기라 값이 커서 접어야 한다(대상당 점 하나).
func 발수를_센다() -> bool:
	return 살아있나() and _타일.탄약을_쓰나()


func 회수줄() -> Array:
	return _타일.회수줄_요약() if 살아있나() else []


## 칠하는 중이지만 아직 완성이 안 된 플랫폼들.
## 이게 없으면 `stage_1-1` 처럼 완성에 11발 걸리는 스테이지에서 HUD 가 한참 빈 화면이다.
func 진행줄() -> Array:
	return _타일.진행줄_요약() if 살아있나() else []


## 탄약을 쓰면 **잠긴 발 수**, 아니면 회색이 된 **플랫폼 개수**를 보여준다.
## 후자는 발 단위 자원이 없을 때의 대용품이다 — 그래도 "되돌릴 수 없는 실수가
## 몇 번 쌓였는지"는 플레이어가 알아야 한다.
func 잠긴_발수() -> int:
	if not 살아있나():
		return 0
	return _타일.잠긴_발수() if _타일.탄약을_쓰나() else _타일.회색_수()


func 다음_회수대상() -> Variant:
	if not 살아있나():
		return null
	var 줄 := _타일.회수줄_요약()
	return 줄[0]["대상"] if not 줄.is_empty() else null


func 대상_발수(대상: Variant) -> int:
	if not 살아있나() or 대상 == null:
		return 0
	return _타일.대상_발수(대상)


func 유효한가(대상: Variant) -> bool:
	return 대상 != null and is_instance_valid(대상)


func 대상_좌표(대상: Variant) -> Vector2:
	if not 살아있나() or not 유효한가(대상):
		return Vector2.ZERO
	return _타일.대상_좌표(대상)


func 대상_아래(월드: Vector2) -> Variant:
	return _타일.대상_아래(월드) if 살아있나() else null
