extends PointLight2D
## ============================================================================
## [2026-09-05 신규 · 테스트 전용] 노멀맵 확인용 왕복 광원
## ----------------------------------------------------------------------------
## ▣ 무엇을 하나
##   시작 위치를 중심으로 좌우를 천천히 왕복한다. 지형을 **비스듬히** 비추면서
##   벽돌 표면의 하이라이트가 빛을 따라 반대편으로 옮겨가는지 눈으로 보게 하는 것이 전부다.
##
## ▣ 왜 테스트 전용인가
##   실제 스테이지에는 이 노드를 넣지 않는다. `scenes/집/테스트_2층방_노멀맵.tscn`
##   에서만 쓴다. 게임 조명 설계는 이후 단계에서 따로 한다.
##
## ▣ ★height 가 이 테스트의 핵심 변수다
##   Godot 2D 라이트는 `height` 가 0 이면 광원이 표면과 **같은 평면**에 있다고 계산해서,
##   화면 밖(+Z)을 향하는 노멀이 빛을 거의 못 받는다 — 노멀맵을 넣어도 어두워지기만 한다.
##   실측(`tools/진단_노멀맵_최소테스트.gd`)에서 같은 장면의 평균 밝기가
##     height 0 → 0.033 / 32 → 0.047 / 128 → 0.079 / 400 → 0.105
##   로 올라갔다. 그래서 기본값을 0 이 아니라 128 로 둔다.
## ============================================================================

## 좌우로 이만큼(px)씩 왕복한다.
@export var 왕복_거리: float = 900.0
## 한 번 왕복하는 데 걸리는 시간(초). 느려야 명암 변화를 눈으로 쫓을 수 있다.
@export var 왕복_주기: float = 6.0
## 켜면 스스로 움직인다. 끄면 인스펙터에서 손으로 옮겨 볼 수 있다.
@export var 자동_왕복: bool = true

var _시작: Vector2 = Vector2.ZERO
var _시간: float = 0.0


func _ready() -> void:
	_시작 = position
	# height 0 이면 노멀맵이 사실상 안 보인다 → 씬에서 안 정해 줬으면 여기서 세운다.
	if is_zero_approx(height):
		height = 128.0


func _process(delta: float) -> void:
	if not 자동_왕복:
		return
	_시간 += delta
	position = _시작 + Vector2(sin(_시간 * TAU / maxf(왕복_주기, 0.1)) * 왕복_거리, 0.0)


## 검사 도구가 빛을 원하는 자리에 딱 세울 때 쓴다(자동 왕복을 끄고 옮긴다).
func 세우기(가로_비율: float) -> void:
	자동_왕복 = false
	position = _시작 + Vector2(가로_비율 * 왕복_거리, 0.0)
