@tool
extends PaintPlatform
## ============================================================================
## ↔ 움직이는 발판 (Moving Platform)  —  [2026-07-24 도형 · 신규]
## ----------------------------------------------------------------------------
## PaintPlatform 을 그대로 상속한다 → **움직이면서 색칠도 되는 발판.**
## (그래서 "달리는 발판을 조준해서 맞히기"라는 이 게임만의 상황이 만들어진다)
##
## ▣ 쓰는 법
##   scenes/장애물/움직이는발판.tscn 드래그 → `재질`·`크기_칸` 은 일반 발판과 동일,
##   추가로 `이동거리`·`이동방향`·`왕복시간`·`시작지연` 만 조절.
##
## ▣ 구현 메모
##   AnimatableBody2D 의 `sync_to_physics = true` 를 켠다 → 발판이 움직일 때
##   위에 선 플레이어가 **같이 실려 간다**(안 켜면 발판만 빠져나가고 플레이어는 미끄러진다).
##   이동은 반드시 `_physics_process` 에서 해야 물리와 어긋나지 않는다.
##
## ▣ 레벨 디자인 규칙
##   · 왕복시간 3초 이상 권장. 움직이는 발판 위에서 조준까지 시키면 2초 이하는 가혹하다.
##   · 세로 이동 발판은 낙사 구간 위에 두지 않는다(내려갈 때 강제 낙사 = 불공정).
## ============================================================================

@export_range(0.0, 1200.0) var 이동거리: float = 160.0
## 0=가로 1=세로
@export_enum("가로", "세로") var 이동방향: int = 0
@export_range(0.6, 20.0) var 왕복시간: float = 4.0
## 여러 발판을 엇갈리게 움직이고 싶을 때 쓰는 위상 지연(초)
@export_range(0.0, 20.0) var 시작지연: float = 0.0

var _시작위치: Vector2
var _t: float = 0.0

func _ready() -> void:
	super._ready()
	sync_to_physics = true          # ★플레이어를 태우고 가려면 반드시 필요
	_시작위치 = position
	_t = -시작지연

func _physics_process(delta: float) -> void:
	if Engine.is_editor_hint() or 이동거리 <= 0.0:
		return
	_t += delta
	var s := sin(_t / maxf(왕복시간, 0.1) * TAU) * 이동거리 * 0.5
	position = _시작위치 + (Vector2(s, 0) if 이동방향 == 0 else Vector2(0, s))
