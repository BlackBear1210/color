@tool
extends "res://scripts/장애물/순찰몬스터.gd"
## ============================================================================
## [2026-10-10 Claude · 2-8 신규] 사격 몬스터 — 순찰몬스터가 **자기 색 물감을 플레이어 쪽으로 쏜다.**
## ----------------------------------------------------------------------------
## 왜 만들었나
##   도형님 2-8 도면 왼쪽 위 흰 발판: "몬스터 2마리가 좌우로 배회.(검정몬스터임.) 검정색 물감을 발사함."
##   순찰몬스터(2-7)는 걷기만 한다 → 걷기·색 규칙은 그대로 물려받고 **발사만 더한다**(순찰몬스터.gd 는 손대지 않는다 —
##   Codex 가 발소리를 넣고 있는 파일이라 덮어쓰지 않으려고 따로 뺐다).
##
## 규칙 — 새 규칙을 만들지 않고 **페인트분사기와 같은 총알**을 쓴다
##   · 총알.gd 를 `장치발 = true` 로 쏜다 → 플레이어를 통과하고(직접 죽이지 않는다) **맞은 땅을 그 색으로 칠한다.**
##     흰 발판 위의 흰 몸 밑이 검게 칠해지면 색 규칙으로 죽는다 — "땅을 바꾸는 총알"(페인트분사기.gd 머리 주석).
##   · 내 탄약이 아니라 E 로 회수할 수 없다 · 죽어 부활하면 칠한 것도 원래대로(페인트_코어 장치 명중 규칙).
##   · 탄도는 플레이어 총알과 같다(중력 900 × 탄낙차) — 플레이어가 눈으로 읽는 포물선이 같아야 한다.
##
## 조준
##   사거리 안 · 높이차_최대 안에 플레이어가 있으면 `발사간격` 마다 한 발. 같은 탄속으로 플레이어 발밑에 떨어지는 **낮은 포물선**을 푼다
##   (닿을 수 없으면 45°). 매 발 조준하므로 가만히 서 있으면 발밑이 칠해진다 → 움직이게 만든다.
##
## 성능: 발사 순간에만 플레이어를 찾는다(그룹 조회 1 회) · 그림은 부모와 같다(_draw 없음).
## ============================================================================

const 총알_스크립트 := preload("res://scripts/스마트월드/총알.gd")
const 총알_중력 := 900.0                  # 총알.gd `중력` 과 같아야 조준이 맞는다

@export_group("발사")
@export var 발사_켜짐: bool = true
## 두 발 사이 시간(초). 첫 발은 짧은 준비 뒤 쏜다 — 스테이지 시작과 동시에 쏘면 상황을 못 읽는다.
@export_range(0.3, 10.0, 0.05) var 발사간격: float = 1.0
## 처음 발사 시각을 어긋나게 한다(같은 판의 두 마리가 한꺼번에 쏘지 않게).
@export var 위상: float = 0.0
@export_range(100.0, 2000.0, 10.0) var 사거리: float = 700.0
## 위아래로 이만큼 넘게 떨어진 플레이어는 노리지 않는다(px).
##   2-8: 몬스터 발판 위 부서지는 발판 6 장(높이 차 416~512)이 몬스터와 플레이어 사이를 가려, 플레이어를 노린 물감이
##   1 초 남짓마다 **앞 발판을 통째로 검게** 덮었다(주행검사 10-10) — 탄약 7 발로는 못 따라간다. 그래서 발판 위는 쏘지 않고,
##   같은 높이대(점프대 발판 · 몬스터 발판으로 떨어진 몸)만 노린다.
@export_range(40.0, 2000.0, 10.0) var 높이차_최대: float = 320.0
@export_range(200.0, 1600.0, 10.0) var 탄속: float = 760.0
## 총구 = 원점(발)에서 이만큼 위.
@export var 총구_높이: float = 70.0
@export_group("")

var _쿨: float = 0.0
var _코어: Node = null


func _ready() -> void:
	super._ready()
	# 첫 발견 때 몇 초씩 침묵하지 않되 두 마리의 첫 발은 어긋나게 한다.
	_쿨 = 0.35 + clampf(위상, 0.0, 발사간격 * 0.5)


func _physics_process(delta: float) -> void:
	super._physics_process(delta)
	if not 발사_켜짐:
		return
	_쿨 -= delta
	if _쿨 > 0.0:
		return
	# 사거리 밖에서 실패한 시도는 한 발로 세지 않는다. 들어오면 0.1초 안에 재시도한다.
	_쿨 = maxf(발사간격, 0.3) if _발사() else 0.1


func _발사() -> bool:
	var p := get_tree().get_first_node_in_group("player") as Node2D
	if p == null:
		return false
	var 총구 := global_position + Vector2(0.0, -총구_높이)
	var 표적 := p.global_position
	if 총구.distance_to(표적) > 사거리 or absf(표적.y - global_position.y) > 높이차_최대:
		return false
	if _코어 == null or not is_instance_valid(_코어):
		_코어 = get_tree().get_first_node_in_group("페인트코어")
	if _코어 == null:
		return false
	var 방향 := _조준(표적 - 총구)
	var 총알 := Area2D.new()
	총알.set_script(총알_스크립트)
	_투사체_부모().add_child(총알)
	# 조준을 푼 원점에서 출발해야 가까운 바닥을 넘겨 쏘는 오차가 없다.
	총알.시작(총구, 방향, 탄속, 색, _코어, null, true, 1.0)
	# 쏘는 쪽을 바라본다(걷는 방향과 다를 수 있다 — 다음 걸음에 다시 걷는 쪽을 본다).
	if _그림:
		_그림.flip_h = 방향.x < 0.0
	preload("res://scripts/페인트_효과음.gd").재생(self, "몬스터_페인트발사", 총구, -13.0)
	return true


## 같은 탄속으로 d(총구 → 표적) 에 떨어지는 발사 방향. 낮은 포물선을 고른다 · 해가 없으면 표적 쪽 45°.
##   화면 좌표(y 아래로) — 위로 쏘려면 방향.y 가 음수.
func _조준(d: Vector2) -> Vector2:
	var g := 총알_중력
	var v2 := 탄속 * 탄속
	var x := absf(d.x)
	var y := -d.y                                   # 위쪽이 + 가 되게 뒤집는다
	var s := 1.0 if d.x >= 0.0 else -1.0
	if x < 1.0:
		return Vector2(0.0, -1.0 if y > 0.0 else 1.0)
	var 판별 := v2 * v2 - g * (g * x * x + 2.0 * y * v2)
	if 판별 < 0.0:
		return Vector2(s, -1.0).normalized()
	var 각 := atan((v2 - sqrt(판별)) / (g * x))
	return Vector2(cos(각) * s, -sin(각))


## 총알은 변환이 없는 스테이지 루트에 단다(몬스터가 움직여도 끌려다니지 않게 · 페인트분사기와 같다).
func _투사체_부모() -> Node:
	if owner is Node2D:
		return owner
	var sc := get_tree().current_scene
	return sc if sc != null else get_parent()
