@tool
extends Node2D
## ============================================================================
## [2026-08-07 도형] 카메라 구역 — "여기서는 화면이 이렇게 잡힌다"
## ----------------------------------------------------------------------------
## ▣ 무엇인가
##   맵을 몇 개의 **구역**으로 나누고, 구역마다 카메라가 잡는 범위·줌·시선 높이를
##   따로 지정하는 마커 노드다. 판정도 로직도 없다 — **값만 들고 있는 표지판**이다.
##   실제로 카메라를 움직이는 건 [카메라_연출.gd](카메라_연출.gd) 다.
##
## ▣ 왜 필요한가 (도형님 요청: "stage_1-1에서 1-2로 넘어갈 때 카메라 넣어주셈")
##   한 씬 안에 1-1(좌) 과 1-2(우) 가 이어 붙어 있는데, 두 구역은 성격이 다르다.
##   1-1 은 좁고 아기자기하고, 1-2 는 크고 높다. 같은 줌으로 보면
##   1-1 은 답답하고 1-2 는 플레이어가 개미처럼 작아진다.
##   → 구역마다 줌·범위를 따로 주고, 그 사이를 **걸어가면서 서서히 바뀌게** 한다.
##
## ▣ 조사한 것 (도형님 요청으로 리서치 후 반영)
##   · Vane(2019) — 위치에 따라 카메라가 자동으로 줌 인/아웃 되며 컷 없이 이어진다.
##     다만 리뷰에서 **"카메라가 플레이를 방해한다"** 는 혹평을 받았다. 원인은
##     연출이 **플레이어 입력과 무관하게 제멋대로 움직였기** 때문이다.
##     → 우리는 그 실수를 피한다. 아래 '전환폭' 참고.
##   · Hollow Knight — 구역마다 카메라 오프셋이 다르고, 이동은 부드럽게 보간된다.
##     "구역별로 보여줄 것을 디자이너가 정한다" 는 발상만 가져왔다.
##   · Itay Keren, GDC 2015 "Scroll Back" — 이 프로젝트 카메라의 원래 설계 근거.
##
## ▣ ★핵심 규칙 — 전환은 시간이 아니라 **플레이어 위치**로 굴러간다
##   기존 `ProtoCamera.set_limit_rect(rect, true)` 는 1.1초짜리 **시간 트윈**이었다.
##   그러면 플레이어가 경계에서 멈추거나 되돌아가도 카메라는 혼자 계속 흘러간다
##   = 화면과 조작이 따로 논다 (Vane 이 욕먹은 바로 그것).
##   → 여기서는 `전환폭` 안에서 **플레이어 x 가 얼마나 왔는지**로 보간한다.
##     · 앞으로 걸으면 화면이 앞으로 열리고
##     · 멈추면 화면도 멈추고
##     · 되돌아가면 화면도 되돌아간다
##   도형님 요청 "카메라가 움직임과 플레이어의 움직임이 같이 가야해" 가 이 한 줄이다.
##
## ▣ 배치법
##   씬에 `카메라연출` 노드를 하나 두고, 그 **자식**으로 이 노드를 구역 수만큼 둔다.
##   구역은 x 오름차순이면 되고 서로 겹치지 않게 잡는다(경계에서 자동으로 섞인다).
## ============================================================================
class_name 카메라구역

## 카메라가 이 구역에서 벗어나지 않을 범위(월드 좌표).
## ⚠ 화면(1920×1080 / 줌)보다 작으면 카메라가 가운데 고정된다 — 반드시 화면보다 크게.
@export var 범위: Rect2 = Rect2(0, 0, 3000, 1400):
	set(v): 범위 = v; queue_redraw()

## 이 구역의 줌. **작을수록 넓게 보인다.** (0.70 = 스테이지 기본, 0.85 = 조금 당김)
@export_range(0.2, 2.0) var 줌: float = 0.70:
	set(v): 줌 = v; queue_redraw()

## 이 구역에서 카메라 시선을 위/아래로 얼마나 옮길지(px).
## 음수 = 위를 더 보여준다(높은 지형), 양수 = 아래를 더 보여준다(구멍 구간).
@export var 시선_오프셋: Vector2 = Vector2.ZERO

## ★다음 구역으로 넘어갈 때 **몇 px 를 걸어가는 동안** 화면이 바뀔지.
## 넓을수록 전환이 느긋하다. 화면 폭의 절반(약 1300px) 정도가 자연스럽다.
## 0 이면 경계에서 툭 끊긴다(권장하지 않음).
@export_range(0, 4000) var 전환폭: float = 1200.0

## 전환 한가운데에서 살짝 줌아웃해 "새 지역이 눈앞에 펼쳐지는" 호흡을 만든다.
## 0 이면 안 쓴다. 0.06 = 6% 정도 물러난다.
@export_range(0.0, 0.4) var 전환_숨: float = 0.06

@export_group("에디터")
## 에디터 2D 뷰에 구역 사각형을 그려서 눈으로 확인할 수 있게 한다.
@export var 가이드_표시: bool = true:
	set(v): 가이드_표시 = v; queue_redraw()
@export var 가이드_색: Color = Color(0.4, 0.9, 1.0, 0.9):
	set(v): 가이드_색 = v; queue_redraw()


func _ready() -> void:
	add_to_group("카메라구역")
	# 런타임에는 가이드가 보이면 안 된다 (에디터 전용 기즈모)
	if not Engine.is_editor_hint():
		가이드_표시 = false
	queue_redraw()


## 이 구역의 왼쪽/오른쪽 경계 x (정렬·경계 계산용)
func 좌() -> float:
	return 범위.position.x


func 우() -> float:
	return 범위.end.x


# ── 에디터 가이드 ───────────────────────────────────────────────────────────
## 구역을 눈으로 보면서 잡을 수 있어야 한다. 숫자만 보고 Rect2 를 맞추는 건 고문이다.
func _draw() -> void:
	if not 가이드_표시:
		return
	# 이 노드는 보통 원점에 두므로, 범위를 로컬로 환산해 그린다
	var r := Rect2(범위.position - global_position, 범위.size)
	draw_rect(r, Color(가이드_색.r, 가이드_색.g, 가이드_색.b, 0.06), true)
	draw_rect(r, 가이드_색, false, 4.0)
	# 전환 밴드 — 오른쪽 경계 기준 ±전환폭/2
	if 전환폭 > 0.0:
		var bx := r.end.x
		var band := Rect2(bx - 전환폭 * 0.5, r.position.y, 전환폭, r.size.y)
		draw_rect(band, Color(1.0, 0.85, 0.3, 0.10), true)
		draw_rect(band, Color(1.0, 0.85, 0.3, 0.7), false, 2.0)
