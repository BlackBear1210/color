extends Node2D
## ============================================================================
## [2026-08-07 도형] 카메라 연출가 — 구역과 구역을 "걸어서" 넘어간다
## ----------------------------------------------------------------------------
## ▣ 하는 일
##   자식으로 달린 [카메라구역](카메라_구역.gd) 들을 x 순으로 줄 세우고,
##   플레이어가 지금 어디쯤 있는지에 따라 **카메라의 범위·줌·시선**을 매 프레임 섞는다.
##
## ▣ ★왜 시간 트윈이 아니라 위치 보간인가 (이 파일의 존재 이유)
##   기존 방식: `카메라.set_limit_rect(새범위, animate=true)` → 1.1초 동안 시간 트윈.
##     문제 ① 경계에서 멈춰도 카메라는 혼자 1.1초를 마저 흘러간다
##     문제 ② 되돌아가면 카메라는 앞으로 가는 중이라 화면과 조작이 반대로 논다
##     문제 ③ 빠르게 지나가면 전환이 끝나기 전에 다음 구역에 도착해 툭 끊긴다
##   Vane(2019) 이 "카메라가 플레이를 방해한다" 는 혹평을 받은 게 정확히 이 지점이다.
##   위치가 아니라 **연출 타이머**가 화면을 몰고 갔기 때문이다.
##
##   여기서는 전환 진행도 t 를 **플레이어의 x 좌표에서 직접 계산**한다.
##       t = (플레이어x − 밴드시작) / 전환폭
##   그래서
##     · 앞으로 걸으면 화면이 앞으로 열린다
##     · 멈추면 화면도 그 상태로 멈춘다
##     · 되돌아가면 화면도 정확히 되돌아간다
##     · 뛰든 걷든 **화면이 벌어지는 속도 = 내가 걷는 속도**
##   도형님 요청 "카메라가 움직임과 플레이어의 움직임이 같이 가야해" 가 이것이다.
##
## ▣ 전환 '숨' (Vane 에서 가져온 좋은 부분)
##   전환 한가운데(t=0.5)에서만 살짝 줌아웃했다가 돌아온다. sin 곡선이라
##   시작·끝에서는 0 이라 이음매가 안 보이고, 가운데서만 "새 지역이 펼쳐지는" 느낌이 난다.
##   이것도 시간이 아니라 t 로 계산하므로 멈추면 그 상태로 멈춘다.
##
## ▣ 쓰는 법
##   씬 트리:
##     카메라연출  (이 스크립트)
##     ├─ 구역_1-1  (카메라구역)  범위=Rect2(...)  줌=0.70  전환폭=1200
##     └─ 구역_1-2  (카메라구역)  범위=Rect2(...)  줌=0.62
##   코드에서 붙일 때:
##     var 연출 := preload("res://scripts/proto/카메라_연출.gd").new()
##     add_child(연출)
##     연출.구역_추가(Rect2(...), 0.70, Vector2.ZERO, 1200.0)
##     연출.연결(카메라, 플레이어)
##
## ▣ 안전장치
##   구역이 하나도 없으면 아무것도 하지 않는다 → 기존 씬에 붙여도 회귀가 없다.
## ============================================================================
class_name 카메라연출

const 구역_스크립트 := preload("res://scripts/proto/카메라_구역.gd")

## 켜고 끄기. 끄면 카메라를 전혀 건드리지 않는다(디버그용).
@export var 사용: bool = true

var _카메라: ProtoCamera = null
var _플레이어: Node2D = null
var _구역들: Array[카메라구역] = []
## 마지막으로 적용한 값 — 디버그·테스트에서 조회한다
var _적용_범위: Rect2 = Rect2()
var _적용_줌: float = 0.0
var _적용_t: float = 0.0
var _적용_구역: int = -1


func _ready() -> void:
	_구역_모으기()
	set_physics_process(true)


## 카메라와 플레이어를 물려준다. 둘 중 하나라도 없으면 동작하지 않는다.
func 연결(카메라: ProtoCamera, 플레이어: Node2D) -> void:
	_카메라 = 카메라
	_플레이어 = 플레이어
	_구역_모으기()
	# 첫 프레임부터 올바른 화면이어야 한다 — 즉시 한 번 적용
	if _카메라 and _플레이어:
		_갱신()


## 코드로 구역을 추가한다 (생성기에서 쓰는 경로).
func 구역_추가(범위: Rect2, 줌: float, 시선_오프셋: Vector2 = Vector2.ZERO,
		전환폭: float = 1200.0, 이름: String = "") -> 카메라구역:
	var z: 카메라구역 = 구역_스크립트.new()
	z.name = 이름 if not 이름.is_empty() else "구역_%d" % (get_child_count() + 1)
	z.범위 = 범위
	z.줌 = 줌
	z.시선_오프셋 = 시선_오프셋
	z.전환폭 = 전환폭
	add_child(z)
	_구역_모으기()
	return z


## 자식 중 카메라구역을 모아 x 오름차순으로 정렬한다.
func _구역_모으기() -> void:
	_구역들.clear()
	for c in get_children():
		if c is 카메라구역:
			_구역들.append(c)
	_구역들.sort_custom(func(a: 카메라구역, b: 카메라구역) -> bool:
		return a.좌() < b.좌())


func _physics_process(_delta: float) -> void:
	if not 사용 or _카메라 == null or _플레이어 == null or _구역들.is_empty():
		return
	_갱신()


# ============================================================================
# 본체 — 플레이어 x 로 구역을 섞는다
# ============================================================================
func _갱신() -> void:
	var px: float = _플레이어.global_position.x

	# ── 1) 지금 어느 구역인가 ──
	# 구역 사이에 틈이 있어도 가장 가까운 구역을 고른다(플레이어가 붕 뜨는 일 방지).
	var i := _구역_찾기(px)
	if i < 0:
		return
	var 현재: 카메라구역 = _구역들[i]

	# ── 2) 이웃과 얼마나 섞을 것인가 ──
	# 오른쪽 이웃과의 경계는 "현재 구역의 오른쪽 끝".
	# 그 경계를 중심으로 ±전환폭/2 구간에서 0→1 로 섞는다.
	var 다음: 카메라구역 = null
	var t := 0.0
	if i + 1 < _구역들.size():
		var 경계: float = (현재.우() + _구역들[i + 1].좌()) * 0.5
		var 폭: float = maxf(현재.전환폭, 1.0)
		var 시작 := 경계 - 폭 * 0.5
		var 비율: float = (px - 시작) / 폭
		if 비율 > 0.0:
			다음 = _구역들[i + 1]
			t = clampf(비율, 0.0, 1.0)

	# 왼쪽으로 되돌아가는 경우도 같은 식으로 섞어야 **완전히 대칭**이 된다.
	# (한쪽만 처리하면 되돌아갈 때 화면이 툭 끊긴다 — 실제로 겪는 흔한 버그)
	if 다음 == null and i - 1 >= 0:
		var 이전: 카메라구역 = _구역들[i - 1]
		var 경계2: float = (이전.우() + 현재.좌()) * 0.5
		var 폭2: float = maxf(이전.전환폭, 1.0)
		var 끝2 := 경계2 + 폭2 * 0.5
		if px < 끝2:
			# 이전 → 현재 로 섞는다. 기준을 이전 구역으로 바꿔 t 를 다시 계산.
			다음 = 현재
			현재 = 이전
			t = clampf((px - (경계2 - 폭2 * 0.5)) / 폭2, 0.0, 1.0)

	# ── 3) 값 섞기 ──
	var 범위 := 현재.범위
	var 줌 := 현재.줌
	var 시선 := 현재.시선_오프셋
	if 다음 != null:
		# smoothstep — 시작·끝의 기울기가 0 이라 이음매가 안 보인다.
		# 선형으로 섞으면 전환이 시작/끝나는 순간 화면 속도가 툭 바뀌어 티가 난다.
		var s := smoothstep(0.0, 1.0, t)
		범위 = Rect2(현재.범위.position.lerp(다음.범위.position, s),
			현재.범위.size.lerp(다음.범위.size, s))
		줌 = lerpf(현재.줌, 다음.줌, s)
		시선 = 현재.시선_오프셋.lerp(다음.시선_오프셋, s)
		# 전환 '숨' — 가운데서만 살짝 물러난다. sin(πt) 는 양 끝이 0 이라 이음매가 없다.
		var 숨: float = maxf(현재.전환_숨, 다음.전환_숨)
		if 숨 > 0.0:
			줌 *= 1.0 - 숨 * sin(PI * t)

	# ── 4) 카메라에 적용 ──
	# ★animate=false 로 **즉시** 넣는다. 시간 트윈을 쓰면 우리가 위치로 만든 t 와
	#   트윈이 서로 싸워서 화면이 미끄러진다. 부드러움은 이미 smoothstep 이 만든다.
	_카메라.set_limit_rect(범위, false)
	_카메라.set_region_zoom(줌, false)
	_카메라.구역_오프셋 = 시선

	_적용_범위 = 범위
	_적용_줌 = 줌
	_적용_t = t
	_적용_구역 = i


## 이 x 를 품는 구역의 index. 없으면 가장 가까운 구역.
func _구역_찾기(px: float) -> int:
	if _구역들.is_empty():
		return -1
	for i in _구역들.size():
		if px >= _구역들[i].좌() and px <= _구역들[i].우():
			return i
	# 틈에 있거나 맵 밖 — 가장 가까운 구역으로 붙인다
	var 최적 := 0
	var 최소 := 1e20
	for i in _구역들.size():
		var d: float = minf(absf(px - _구역들[i].좌()), absf(px - _구역들[i].우()))
		if d < 최소:
			최소 = d
			최적 = i
	return 최적


# ── 조회 (자동 테스트·디버그용) ──────────────────────────────────────────────
func 적용_범위() -> Rect2:
	return _적용_범위

func 적용_줌() -> float:
	return _적용_줌

## 현재 전환 진행도 0~1. 전환 밴드 밖이면 0.
func 진행도() -> float:
	return _적용_t

func 구역수() -> int:
	return _구역들.size()
