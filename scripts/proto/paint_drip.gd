extends Node2D
## ============================================================================
## [2026-07-24 도형 · 신규] 물감 흐름 연출 (Paint Drip)
## ----------------------------------------------------------------------------
## ▣ 요구사항 (오픈AI 상담 → 도형님 지시)
##   "벽에 색칠하면 물감이 아래로 흐르는 연출"
##   · 벽에 닿은 위치에서 일정 확률로 물감 방울 생성
##   · 중력 방향으로 흘러내리며 길이가 늘어남
##   · 일정 시간이 지나면 사라지거나 굳는 연출
##
## ▣ 구현 방식과 그 이유
##   파티클(GPUParticles2D)이 아니라 **_draw() 로 직접 그리는 폴리곤**을 골랐다.
##   · 파티클은 "점이 떨어지는" 것은 잘하지만, 물감 특유의 "가늘고 길게 이어진 자국"
##     (윗부분은 얇고 방울 머리만 두꺼운 형태)을 못 만든다.
##   · 자국이 남아야 하므로 수명이 길다 → 파티클로 하면 수백 개가 계속 살아있게 된다.
##   · _draw() 폴리곤 하나면 노드 1개 · 드로우콜 1회로 끝난다.
##   에셋 의존 0 (코드로만 생성) — 아트가 들어와도 텍스처만 얹으면 된다.
##
## ▣ 수명 3단계
##   1) 흐름(FLOW)  : 중력으로 길이가 늘어난다. 점성 때문에 등가속이 아니라 감속한다.
##   2) 굳음(DRY)   : 더 이상 안 흐르고 그대로 멈춘다. 젖은 광택이 서서히 사라진다.
##   3) 소멸(FADE)  : 알파가 빠지며 사라진다. (화면에 자국이 무한 누적되는 것을 방지)
## ============================================================================
class_name PaintDrip

# ── 튜닝 상수 (여기만 만지면 느낌이 바뀐다) ────────────────────────────────
const 최대길이_기본: float = 46.0     ## 흘러내릴 수 있는 최대 길이(px)
const 흐름_초기속도: float = 26.0     ## 처음 흘러내리는 속도(px/s)
const 흐름_가속: float = 120.0        ## 중력 가속(px/s²)
const 흐름_감쇠: float = 2.6          ## 점성 — 클수록 금방 멈춘다
const 굳는시간: float = 1.1           ## 멈춘 뒤 굳어 있는 시간(초)
const 페이드시간: float = 1.4         ## 사라지는 데 걸리는 시간(초)
const 흔들림_진폭: float = 1.6        ## 흘러내리는 줄기가 좌우로 미세하게 휘는 정도(px)

var _색: Color = Color(0.08, 0.08, 0.08, 1.0)
var _폭: float = 4.0
var _최대길이: float = 최대길이_기본
var _길이: float = 0.0
var _속도: float = 흐름_초기속도
var _위상: float = 0.0                ## 줄기 휘어짐 시드(같은 벽에서도 다 달라 보이게)
var _단계: int = 0                    ## 0=흐름 1=굳음 2=소멸
var _타이머: float = 0.0
var _젖음: float = 1.0

## 스포너가 호출: 색, 굵기, 최대 길이를 지정하고 시작한다.
func 시작(색: Color, 폭: float, 최대길이: float) -> void:
	_색 = 색
	_폭 = 폭
	_최대길이 = 최대길이
	_위상 = randf() * TAU
	_속도 = 흐름_초기속도 * randf_range(0.7, 1.4)
	z_index = 1                       # 플랫폼 그림 바로 위
	queue_redraw()

func _process(delta: float) -> void:
	match _단계:
		0:  # ── 흐름 ──
			# 점성 감쇠가 있는 낙하: v += g·dt, v -= v·감쇠·dt
			_속도 += 흐름_가속 * delta
			_속도 = maxf(_속도 - _속도 * 흐름_감쇠 * delta, 0.0)
			_길이 += _속도 * delta
			if _길이 >= _최대길이 or _속도 < 2.0:
				_길이 = minf(_길이, _최대길이)
				_단계 = 1
				_타이머 = 굳는시간
		1:  # ── 굳음 ── (광택만 서서히 빠진다)
			_젖음 = maxf(_젖음 - delta * 1.2, 0.0)
			_타이머 -= delta
			if _타이머 <= 0.0:
				_단계 = 2
				_타이머 = 페이드시간
		2:  # ── 소멸 ──
			_타이머 -= delta
			modulate.a = clampf(_타이머 / 페이드시간, 0.0, 1.0)
			if _타이머 <= 0.0:
				queue_free()
				return
	queue_redraw()

func _draw() -> void:
	if _길이 <= 0.5:
		return
	# 줄기: 위(시작점)는 얇고, 방울 머리(끝)로 갈수록 살짝 두꺼워지는 물방울 형태.
	# 좌우 윤곽선을 각각 만들어 하나의 볼록 폴리곤으로 그린다.
	var 단계수 := 10
	var 좌 := PackedVector2Array()
	var 우 := PackedVector2Array()
	for i in 단계수 + 1:
		var t := float(i) / float(단계수)
		var y := _길이 * t
		# 굵기 곡선: 시작 0.55 → 중간 0.35 → 끝 0.95 (표면장력으로 끝에 뭉치는 모양)
		var 굵기 := _폭 * (0.55 - 0.20 * t + 0.60 * pow(t, 3.0))
		# 미세한 휘어짐 — 완전 직선이면 CG 티가 난다
		var 휨 := sin(_위상 + t * 3.1) * 흔들림_진폭 * t
		좌.append(Vector2(휨 - 굵기 * 0.5, y))
		우.append(Vector2(휨 + 굵기 * 0.5, y))
	var 폴리 := PackedVector2Array()
	폴리.append_array(좌)
	for i in range(우.size() - 1, -1, -1):
		폴리.append(우[i])
	draw_colored_polygon(폴리, _색)

	# 방울 머리 — 끝에 맺힌 동그란 물방울
	var 끝휨 := sin(_위상 + 3.1) * 흔들림_진폭
	var 머리 := Vector2(끝휨, _길이)
	draw_circle(머리, _폭 * 0.58, _색)

	# 젖은 광택: 방울 머리 쪽에 작은 하이라이트 점 (마르면 사라진다)
	if _젖음 > 0.01:
		var 광택 := Color(0.85, 0.86, 0.92, 0.45 * _젖음)
		if _색.get_luminance() > 0.5:
			광택 = Color(0.25, 0.25, 0.30, 0.35 * _젖음)   # 흰 물감은 어두운 광택
		draw_circle(머리 + Vector2(-_폭 * 0.18, -_폭 * 0.18), _폭 * 0.20, 광택)
