extends Node2D
## ============================================================================
## [2026-10-03 신규] 번갈이 물 — 같은 자리의 두 물줄기를 일정 시간마다 바꿔 켠다
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나
##   도형님 2-2 도면(map_153x83.uvtt): "흰색물_4 / 검정물_1 — 이 두 개의 물이 일정 시간을 가지고 번갈아 나옴".
##   주기는 도형님이 3 초로 정했다(2026-10-03).
##   물 하나의 `색` 을 실행 중에 바꾸는 대신 **물 두 개를 겹쳐 두고 `켜짐` 만 바꾼다** —
##   꺼진 물은 그림·위험·총알 막기·호퍼 감지가 전부 사라지는 길(맵제작_공통규칙 §6 ·
##   test_유체_끄면_총알통과)이 이미 검증돼 있고, 밸브·저장고가 쓰는 길과 같다.
##
## ▣ 성능 (작업기록 2026-09-30 프레임드랍 §8)
##   매 프레임 아무것도 하지 않는다. Timer 한 개가 `주기` 마다 한 번 깨워 켜짐 두 개를 뒤집을 뿐이다.
##
## ▣ 에디터
##   @tool 이 아니다 — 에디터에서는 씬에 저장된 `켜짐` 그대로 보인다(빌더가 A 켜짐 · B 꺼짐으로 저장).
## ============================================================================

## 처음에 켜져 있는 물.
@export var 물_A: NodePath
## 처음에 꺼져 있는 물. `주기` 초 뒤에 A 와 자리를 바꾼다.
@export var 물_B: NodePath
## 한 물이 켜져 있는 시간(초).
@export_range(0.5, 30.0, 0.1) var 주기: float = 3.0

var _a: Node = null
var _b: Node = null
var _a_켜짐 := true


func _ready() -> void:
	_a = get_node_or_null(물_A)
	_b = get_node_or_null(물_B)
	if _a == null or _b == null:
		push_warning("번갈이_물 %s: 물_A/물_B 를 못 찾았다 — 아무것도 안 한다" % name)
		return
	# 저장된 값과 상관없이 시작 상태를 확정한다(둘 다 켜져 있으면 두 색이 겹쳐 누구든 죽는다).
	_반영()
	var t := Timer.new()
	t.name = "주기_타이머"
	t.wait_time = 주기
	t.one_shot = false
	t.autostart = true
	t.timeout.connect(_바꾸기)
	add_child(t)


func _바꾸기() -> void:
	_a_켜짐 = not _a_켜짐
	_반영()


## 끄는 쪽을 먼저 끈다 — 같은 프레임에 둘 다 켜진 순간이 없게.
func _반영() -> void:
	if _a_켜짐:
		_b.set("켜짐", false)
		_a.set("켜짐", true)
	else:
		_a.set("켜짐", false)
		_b.set("켜짐", true)


## 검사 도구용 — 지금 켜진 물.
func 켜진_물() -> Node:
	return _a if _a_켜짐 else _b
