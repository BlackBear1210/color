@tool
extends StaticBody2D
## ============================================================================
## [2026-08-22 신규] 투명 블럭 — 칠해야 생기는 발판
## ----------------------------------------------------------------------------
## ▣ 기획 (도형님 지시)
##   · 색을 입히지 않으면 **밟거나 부딪칠 수 없다.**
##   · 색을 입히면 단단한 블럭이 된다.
##   · 너무 투명하면 플레이어가 인지를 못 한다 →
##     **살짝 모션블러가 걸린 것처럼** 좌우로 번지게 그려서 눈에 띄게 한다.
##
## ▣ 왜 새로 만들었나 — 이미 있는 것과 무엇이 다른가
##   같은 "무색이면 유령" 규칙이 `지형.gd` 의 `무색일때_통과` 에 이미 있다.
##   그런데 그건 **SS2D 지형 전용**이라 world_2(타일맵 + stage_lab) 에서는 못 쓴다.
##   `TilePaintMap` 에는 콜리전을 껐다 켜는 개념이 아예 없다.
##   → 다른 하수도 장애물들처럼 **독립 노드**로 따로 판다.
##
## ▣ 통과플랫폼과 헷갈리지 말 것 — 정반대의 물건이다
##   통과플랫폼 : 안 칠해도 **항상 밟힌다**. 물이 페인트를 **못 지운다**.
##   투명블럭   : 칠해야 **비로소 밟힌다**. 물이 반대색 페인트를 **지운다**(=발판이 사라진다).
##   → 흰 물 아래의 투명블럭은 **흰색으로 칠해야만 남는다.** 검정으로 칠하면
##     발판이 생겼다가 물에 지워져 도로 사라진다. 이 대비가 하수도 챕터의 퍼즐 문법이다.
##
## ▣ 물리 레이어 약속 (`총알.gd` 헤더와 같은 표)
##   1 : 밟을 수 있는 지형        → 칠해진 상태
##   8 : 무색 유령 지형           → 무색 상태. 플레이어는 통과, **총알은 맞는다**
##   `총알.gd` 의 `단단한_레이어 = 1 | 8` 이라 유령이어도 조준해서 칠할 수 있다.
##   `월드.gd` 의 사망 판정은 레이어 1 만 훑으므로 무색일 때는 자동으로 안전하다.
## ============================================================================
class_name 투명블럭

## `지형.gd` 와 같은 값을 쓴다. 여기만 바꾸면 총알·사망판정과 어긋난다.
const 유령_레이어비트: int = 8

@export var 크기: Vector2 = Vector2(160, 160):
	set(v):
		크기 = Vector2(maxf(v.x, 24.0), maxf(v.y, 24.0))
		_다시_만들기()

## 전체가 칠해지기까지 필요한 발수. 크게 만든 블럭일수록 올려 잡는다.
@export_range(1, 8) var 필요횟수: int = 2

@export_group("모션블러")
## 잔상이 좌우로 번지는 최대 폭(px). 블럭 폭의 10% 안팎이 자연스럽다.
@export var 번짐폭: float = 34.0
## 잔상이 좌우로 흔들리는 한 주기(초). 0 이면 안 흔들린다(정지 화면).
## ★흔들림이 "여기 뭔가 있다"를 알려주는 핵심이다 — 정지해 있으면 배경에 묻힌다.
@export var 흔들림_주기: float = 2.6
## 중심 몸통의 불투명도. 도형님 지시 "너무 투명이면 인지하기 어려워" 때문에
## 유령치고는 꽤 진하게 잡았다. 배경이 밝은 스테이지에서는 조금 올려도 된다.
@export_range(0.05, 0.8) var 몸통_알파: float = 0.24

# ── 상태 ────────────────────────────────────────────────────────────────────
var _상태색: int = -1          ## -1 = 무색(유령). 그 외 ColorDefs 값
var _맞은횟수: int = 0
var _진행색: int = ColorDefs.BLACK
var _시간: float = 0.0         ## 흔들림 위상


func _ready() -> void:
	collision_mask = 0
	_다시_만들기()
	_충돌레이어_갱신()
	if Engine.is_editor_hint():
		queue_redraw()
		return
	add_to_group("칠할수있음")
	add_to_group("투명블럭")
	# 흔들림을 그리려면 매 프레임 다시 그려야 한다. 에디터에서는 끈다(불필요한 갱신 방지).
	set_process(흔들림_주기 > 0.0)
	queue_redraw()


func _다시_만들기() -> void:
	if not is_inside_tree():
		return
	var c := get_node_or_null("충돌") as CollisionShape2D
	if c == null:
		c = CollisionShape2D.new()
		c.name = "충돌"
		add_child(c)
	var r := c.shape as RectangleShape2D
	if r == null:
		r = RectangleShape2D.new()
		c.shape = r
	r.size = 크기
	queue_redraw()


## 무색이면 유령(8), 칠해졌으면 단단한 지형(1).
## ⚠ `set_deferred` 를 쓰는 이유: 물리 질의 도중(유체의 _physics_process 등)에
##   레이어를 바꾸면 Godot 이 "flushing queries" 오류를 낸다. `지형.gd` 도 같은 방식.
func _충돌레이어_갱신() -> void:
	var 새레이어 := 유령_레이어비트 if _상태색 < 0 else 1
	if collision_layer != 새레이어:
		set_deferred("collision_layer", 새레이어)


# ── 페인트코어와의 약속 ─────────────────────────────────────────────────────
# 반환 문자열의 뜻은 `페인트_코어.gd` 가 정한다. 통과플랫폼과 완전히 같은 규약.
func 현재색() -> int:
	return _상태색


## 무색일 때는 절대 죽이지 않는다 — 애초에 몸이 통과하지만, 사망 판정이
## 다른 경로로 들어와도 안전하도록 여기서도 한 번 더 막는다.
func 반대색인가(플레이어색: int) -> bool:
	if _상태색 < 0 or _상태색 == ColorDefs.GRAY:
		return false
	return 플레이어색 != _상태색


func 명중(색: int, _월드좌표: Vector2) -> String:
	if _상태색 == ColorDefs.GRAY:
		return "blocked"                      # 규칙 3: 회색은 끝난 상태
	if _상태색 >= 0:
		if 색 == _상태색:
			return "wasted"
		_상태색 = ColorDefs.GRAY              # 규칙 2: 반대색을 덮으면 회색
		_충돌레이어_갱신()
		queue_redraw()
		return "mixed_gray"
	# 아직 무색 — 같은 색으로 연달아 맞혀야 진행된다(색을 바꾸면 처음부터).
	if _맞은횟수 > 0 and _진행색 != 색:
		_맞은횟수 = 0
	_진행색 = 색
	_맞은횟수 += 1
	queue_redraw()
	if _맞은횟수 >= 필요횟수:
		_상태색 = 색
		_충돌레이어_갱신()
		return "painted"
	return "progress"


## E 수동 회수 / 물에 지워질 때 불린다. 회색은 되돌릴 수 없다(규칙 3).
## ★되돌려지면 발판이 **사라진다** — 물 아래에 둔 투명블럭의 핵심 동작.
func 되돌리기() -> bool:
	if _상태색 == ColorDefs.GRAY:
		return false
	_상태색 = -1
	_맞은횟수 = 0
	_충돌레이어_갱신()
	queue_redraw()
	return true


## 사망/스테이지 리셋 전용 — 되돌리기() 와 달리 회색이어도 강제로 무색화한다.
func 강제_초기화() -> void:
	_상태색 = -1
	_맞은횟수 = 0
	_충돌레이어_갱신()
	queue_redraw()


# ── 그림 ───────────────────────────────────────────────────────────────────
func _process(delta: float) -> void:
	# 칠해진 뒤에는 흔들 이유가 없다(단단한 블럭이다) → 그리기 비용을 아낀다.
	if _상태색 >= 0:
		return
	_시간 += delta
	queue_redraw()


func _draw() -> void:
	# 디자이너 그림이 꽂혀 있으면 코드 그리기는 쉰다 (`아트슬롯.gd` 규약).
	# 다만 유령일 때는 그림도 흐리게 해야 "아직 실체가 아니다"가 읽힌다.
	if 아트슬롯.그림_있나(self):
		modulate.a = 1.0 if _상태색 >= 0 else 0.55
		return
	modulate.a = 1.0

	var 반 := 크기 * 0.5
	var 본체틀 := Rect2(-반, 크기)

	# ── 칠해진 상태 = 그냥 단단한 블럭 ──────────────────────────────────
	if _상태색 >= 0:
		var 본체 := Color(0.50, 0.50, 0.50)
		match _상태색:
			ColorDefs.BLACK: 본체 = Color(0.09, 0.09, 0.11)
			ColorDefs.WHITE: 본체 = Color(0.90, 0.91, 0.89)
		draw_rect(본체틀, 본체)
		draw_rect(본체틀, Color(0.55, 0.56, 0.58, 0.75), false, 2.0)
		return

	# ── 무색 상태 = 모션블러 유령 ───────────────────────────────────────
	# 한 주기 동안 −1 → +1 → −1 로 오가는 값. 잔상을 좌우로 쓸어 준다.
	var 흔들 := 0.0
	if 흔들림_주기 > 0.0:
		흔들 = sin(_시간 * TAU / 흔들림_주기)

	# ⚠ 잔상을 **몸통과 겹쳐서** 그리면 알파가 누적돼 불투명한 덩어리가 된다
	#   (2026-08-22 첫 시도에서 실제로 그렇게 나왔다 — 투명이 아니라 회색 블럭으로 보였다).
	#   → 꼬리는 **몸통 바깥에만** 그린다. 겹침이 없으니 몸통은 설정한 알파 그대로 남는다.
	var 유령색 := Color(0.78, 0.82, 0.88)

	# 중심 몸통 — "여기가 진짜 자리". 뒤가 비쳐야 "아직 없는 것"으로 읽힌다.
	draw_rect(본체틀, Color(유령색.r, 유령색.g, 유령색.b, 몸통_알파))

	# 좌우 꼬리 — 몸통 가장자리에서 바깥으로 뻗으며 사라지는 잔상.
	# 흔들림이 꼬리 **길이**를 바꾼다 → 멈춰 있어도 "떨고 있는" 느낌이 난다.
	#
	# ⚠ 얇은 사각형을 여러 장 이어 붙여 그리면 **이음매마다 알파가 겹쳐 줄무늬**가 생긴다
	#   (2026-08-22 두 번째 시도에서 실제로 그렇게 나왔다 — 블러가 아니라 빗살처럼 보였다).
	#   → `draw_polygon` 의 **정점 색 보간**으로 한 번에 그린다. 이음매 자체가 없어진다.
	var 꼬리 := 번짐폭 * (0.35 + 0.65 * (흔들 * 0.5 + 0.5))
	var 안쪽 := Color(유령색.r, 유령색.g, 유령색.b, 몸통_알파 * 0.85)
	var 바깥 := Color(유령색.r, 유령색.g, 유령색.b, 0.0)
	# 오른쪽 꼬리
	draw_polygon(
		PackedVector2Array([
			Vector2(반.x, -반.y), Vector2(반.x + 꼬리, -반.y),
			Vector2(반.x + 꼬리, 반.y), Vector2(반.x, 반.y)]),
		PackedColorArray([안쪽, 바깥, 바깥, 안쪽]))
	# 왼쪽 꼬리
	draw_polygon(
		PackedVector2Array([
			Vector2(-반.x - 꼬리, -반.y), Vector2(-반.x, -반.y),
			Vector2(-반.x, 반.y), Vector2(-반.x - 꼬리, 반.y)]),
		PackedColorArray([바깥, 안쪽, 안쪽, 바깥]))

	# 진행 중인 부분 색칠은 왼쪽부터 차오르게 (몇 발 남았는지 눈으로 보이게).
	# 통과플랫폼과 같은 문법이라 플레이어가 따로 배울 게 없다.
	if _맞은횟수 > 0:
		var 진행 := clampf(float(_맞은횟수) / float(maxi(필요횟수, 1)), 0.0, 1.0)
		var c := Color(0.09, 0.09, 0.11) if _진행색 == ColorDefs.BLACK else Color(0.90, 0.91, 0.89)
		draw_rect(Rect2(-반, Vector2(크기.x * 진행, 크기.y)), Color(c.r, c.g, c.b, 0.55))

	# 테두리 — 칠했을 때 어디가 발판이 될지 **정확히** 읽혀야 착지 판단이 선다.
	# 잔상이 흐릿한 만큼 경계선만은 또렷하게 둔다.
	draw_rect(본체틀, Color(0.88, 0.91, 0.95, 0.60), false, 1.5)

	# 네 귀퉁이 갈고리 — 흐린 배경에서도 윤곽이 잡히게 하는 보조 표식.
	var 갈고리 := minf(minf(반.x, 반.y) * 0.5, 16.0)
	var 진한 := Color(0.94, 0.96, 1.0, 0.85)
	for sx in [-1.0, 1.0]:
		for sy in [-1.0, 1.0]:
			var 모서리 := Vector2(반.x * sx, 반.y * sy)
			draw_line(모서리, 모서리 - Vector2(갈고리 * sx, 0.0), 진한, 2.0)
			draw_line(모서리, 모서리 - Vector2(0.0, 갈고리 * sy), 진한, 2.0)
