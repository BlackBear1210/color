@tool
extends 스마트지형
## ============================================================================
## [2026-08-31 신규 · STEP 1-4.2] 부서지는 지형 — 총에 맞으면 무너지는 마룻바닥
## ----------------------------------------------------------------------------
## ▣ 왜 `스마트지형` 을 상속하나 (총·총알·페인트코어를 **한 줄도 안 고치려고**)
##   `총알.gd::_칠할대상_찾기()` 는 맞은 콜리전 바디에서 부모를 거슬러 올라가며
##   **`명중()` 을 가진 첫 노드**를 찾는다. SS2D 지형은 이미
##   `[스마트지형] → StaticBody2D → CollisionPolygon2D` 구조라 그 계약을 만족한다.
##   → 상속해서 `명중()` 만 덧대면 아트·콜리전·재질·물감 얼룩이 **전부 그대로** 따라오고
##     `총.gd` · `총알.gd` · `페인트_코어.gd` 는 이게 부서지는 바닥인지 알 필요조차 없다.
##
## ▣ 명중 횟수를 왜 따로 세나
##   부모 `명중()` 은 "칠하기 진행도"를 센다("progress" → "painted" → 그 뒤엔 "wasted").
##   그 흐름에 파괴를 얹으면 색을 바꿔 칠할 때 횟수가 초기화돼 버린다
##   (`지형.gd::_무색_명중()` 이 다른 색이 오면 진행을 다시 잡는다).
##   → 파괴는 **색과 무관한 누적 타격수**로 센다. 물감이 아니라 총알이 나무를 부수는 것이다.
##
## ▣ 파괴 = 콜리전 제거 + 그림 숨김. 되살리지 않는다(`되살아남 = 0`).
##   ⚠ `_충돌레이어_갱신()` 을 막아 둔 이유: 부모는 색 상태가 바뀔 때마다 이걸 불러
##     `collision_layer` 를 1 로 되돌린다. 사망 후 `페인트_코어.리셋()` 경로에서도 불린다.
##     막지 않으면 **부순 바닥이 리스폰 뒤에 되살아난다.**
## ============================================================================
class_name 부서지는지형

## 이만큼 맞으면 부서진다. 색은 상관없다.
@export_range(1, 10) var 필요_명중: int = 3
## 마지막 명중 뒤 무너지기까지 (연출 여유). 0 이면 즉시.
@export_range(0.0, 1.0) var 부서짐_지연: float = 0.0
## 0 보다 크면 그 초 뒤에 되살아난다. 0 = 영구 파괴.
@export_range(0.0, 30.0) var 되살아남: float = 0.0

## 1층 낙하 연출·씬 전환을 나중에 붙일 자리. STEP 1-4.2 에서는 아무도 안 듣는다.
signal 부서짐

var _맞은수: int = 0
var _부서졌나: bool = false


func 부서졌나() -> bool:
	return _부서졌나


## 남은 타격수 — 런타임 시험이 상태를 들여다보는 창.
func 남은_명중() -> int:
	return maxi(필요_명중 - _맞은수, 0)


# ── 총알과의 접점 ───────────────────────────────────────────────────────────
func 명중(색: int, 월드좌표: Vector2) -> String:
	if _부서졌나:
		return "blocked"                     # 이미 없는 것은 못 맞힌다 → 코어가 탄약을 환급한다
	var 결과: String = super(색, 월드좌표)
	if 결과 == "blocked":
		return 결과                          # 칠하기_허용 = false 면 파괴도 안 된다
	_맞은수 += 1
	if _맞은수 >= 필요_명중:
		if 부서짐_지연 > 0.0:
			get_tree().create_timer(부서짐_지연).timeout.connect(_부수기)
		else:
			_부수기.call_deferred()
	return 결과                              # "progress"/"painted" — 코어의 회수 규칙을 그대로 지킨다


func _부수기() -> void:
	if _부서졌나:
		return
	_부서졌나 = true
	_콜리전_끄기(true)
	visible = false
	부서짐.emit()
	if 되살아남 > 0.0:
		get_tree().create_timer(되살아남).timeout.connect(_되살리기)


func _되살리기() -> void:
	_부서졌나 = false
	_맞은수 = 0
	visible = true
	_콜리전_끄기(false)


func _콜리전_끄기(끌까: bool) -> void:
	var 폴리 := get_collision_polygon_node()
	if 폴리 == null:
		return
	폴리.set_deferred("disabled", 끌까)
	var 바디 := 폴리.get_parent() as CollisionObject2D
	if 바디:
		바디.set_deferred("collision_layer", 0 if 끌까 else 1)


## ★부모가 색 상태를 바꿀 때마다 부르는 함수. 부서진 뒤에는 무시해야
##   리스폰·페인트 리셋에 바닥이 되살아나지 않는다.
func _충돌레이어_갱신() -> void:
	if _부서졌나:
		return
	super()
