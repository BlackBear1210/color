extends RefCounted
## ============================================================================
## [2026-08-07 신규] 스마트 지형 물리 제어 규칙
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 제보)
##   "지형 포인트들이 너무 밀집되어 뭉치거나, 경사가 지나치게 가팔라 캐릭터가
##    물리적으로 위로 올라가지 못한다."
##   지금까지 지형 점은 `지형공통.gd` 가 **사인 곡선 그대로** 찍었다. 사인은 예쁘지만
##   플레이어가 오를 수 있는지 없는지는 전혀 신경 쓰지 않는다. 그래서
##     · 점 간격이 40px 이라 진폭이 조금만 커져도 45° 를 넘는 절벽이 생기고
##     · 그 절벽 하나가 스테이지 뒤쪽 전부를 막아버렸다 (2026-08-07 에 실제로 겪음:
##       "밟는 지형 26개 중 도달 6개")
##   → **점을 찍은 뒤 물리 규칙으로 한 번 걸러내는 층**을 따로 둔다.
##     모양을 만드는 쪽(예술)과 오를 수 있게 만드는 쪽(물리)을 분리하는 것이 핵심이다.
##
## ▣ 숫자는 전부 이 프로젝트 플레이어에서 **역산**했다 (tools/_치수.gd 실측)
##     콜리전 폭 44px · 키 97px
##     이동속도 390px/s · 중력 5147.9 · 점프초속 −1283.5
##     ⇒ 점프 높이 160px · 체공 0.410s · 점프 수평거리 160px
##     floor_max_angle 45° (이보다 가파르면 '바닥'이 아니라 '벽'이 된다)
##   상수를 손으로 박지 않고 `플레이어에서_재기()` 로 다시 잴 수도 있다.
##   캐릭터가 또 바뀌어도(2026-08-07 에 키가 47→97px 로 바뀐 적이 있다) 따라온다.
##
## ▣ 규칙 4가지 (도형님 지시 그대로 · 근거를 숫자로 붙였다)
##   1. 최소 수평 간격 64px
##        플레이어 폭 44px + 여유 20px. 지형 타일도 32px 폭이라 정확히 2칸이다.
##        이보다 촘촘하면 점이 뭉쳐 콜리전 볼록분해가 깨진다.
##   2. 최대 단차 48px  (= 점프 높이 160px 의 30%)
##        간격 64px 과 짝지으면 경사 atan(48/64) = 36.9° → 45° 아래.
##        즉 **이 두 값을 함께 지키면 경사각 규칙은 저절로 지켜진다.**
##   3. 평탄 구간 강제 (3~5점 연속으로 Y 변화 ≈ 0)
##        전 구간이 계속 오르내리면 착지할 곳이 없어 "밟을 데가 없는 지형"이 된다.
##        상태 머신으로 평지 ↔ 오름/내림을 번갈아 만든다.
##   4. 자기교차 방지
##        x 오름차순 정렬 → 윗면만 만들고 → 바닥 두 점으로 닫는다.
##        윗면이 x 에 대해 단조롭기만 하면 닫힌 다각형은 절대 꼬이지 않는다.
##        (그래도 `자기교차_있나()` 로 마지막에 한 번 검증한다)
## ============================================================================
class_name 지형규칙

# ── 플레이어 실측값 (tools/_치수.gd 2026-08-07) ──────────────────────────────
## ⚠ 이 두 값은 **Player.tscn 의 콜리전을 실제로 잰 결과를 적어 두는 곳**이다.
##   콜리전을 바꾸면 `test_지형규칙` 의 [0] 항목이 바로 빨개진다 — 그때 여기를 맞춘다.
##   (실측은 `플레이어몸.재기()` 가 한다. 모양이 뭐든 바운딩 박스를 돌려준다)
## ★[2026-08-25] 콜리전이 사각형 → **CollisionPolygon2D** 로 바뀌었다.
##   폭은 44.0 그대로(폴리곤에서 가장 넓은 곳이 우연히 같다), 키만 97.0 → 95.6.
##   ⚠ 폴리곤을 더 다듬으면 이 값도 다시 맞춰야 한다.
const 플레이어_폭: float = 44.0
const 플레이어_키: float = 95.6
const 점프_높이: float = 160.0
const 점프_거리: float = 160.0
const 최대_바닥각: float = 45.0

# ── 규칙 상수 ───────────────────────────────────────────────────────────────
## 규칙 1 — 이웃한 두 점의 x 차이는 반드시 이 값 이상.
const 최소_수평간격: float = 64.0
## 규칙 2 — 이웃한 두 점의 y 차이 한계(px). 점프 높이의 30%.
const 최대_단차: float = 48.0
## 규칙 2 — 경사각 한계(도). floor_max_angle(45°)보다 확실히 아래로 잡는다.
## 40° 로 두면 착지 순간 미끄러지는 애매한 구간이 안 생긴다.
const 최대_경사각: float = 40.0
## 규칙 3 — 평탄 구간 하나의 길이(점 개수) 범위.
const 평탄_최소점: int = 3
const 평탄_최대점: int = 5
## 규칙 3 — 오르내리는 구간 하나의 길이(점 개수) 범위.
const 경사_최소점: int = 1
const 경사_최대점: int = 3
## 평탄 구간에 남겨두는 미세 요철(px). 완전한 직선은 죽은 그림이다.
const 평탄_요철: float = 2.0

# ── 레벨 디자인 안전 수치 (검사기·배치기가 같이 쓴다) ────────────────────────
## 점프 한 번으로 확실히 올라갈 수 있는 단차. 점프 높이의 80%.
const 안전_오름단차: float = 128.0
## 점프 한 번으로 확실히 건널 수 있는 수평 간격. 점프 거리의 80%.
const 안전_건널간격: float = 128.0
## 플레이어가 지나갈 수 있는 최소 통로 높이. 키 97 + 여유.
const 최소_통로높이: float = 128.0
## 착지해서 설 수 있는 최소 발판 폭. 폭 44 + 여유.
const 최소_발판폭: float = 64.0


# ============================================================================
# 0. 실측 (캐릭터가 또 바뀌었을 때)
# ============================================================================
## Player.tscn 을 열어 실제 치수를 다시 잰다. 위 상수와 다르면 경고를 띄운다.
## 도구(`tools/*.gd`)가 시작할 때 한 번 부르면 "상수가 낡았다"를 바로 알 수 있다.
## 반환: { "폭": float, "키": float, "점프높이": float, "점프거리": float }
static func 플레이어에서_재기(플레이어: Node) -> Dictionary:
	var 결과 := {
		"폭": 플레이어_폭, "키": 플레이어_키,
		"점프높이": 점프_높이, "점프거리": 점프_거리,
	}
	if 플레이어 == null:
		return 결과

	# ★[2026-08-25] 재는 일을 `플레이어몸.재기()` 로 옮겼다.
	#   예전에는 `RectangleShape2D` 만 읽고, 아니면 **위에서 채운 기본값(= 상수)을 그대로
	#   반환**했다. 그러면 `상수_점검()` 이 상수를 상수와 비교하게 되어 **언제나 통과**한다.
	#   실제로 콜리전을 캡슐로 바꿨을 때 폭이 31px 인데 44px 이라고 보고하며 통과했다.
	#   자를 못 대면 통과시키지 말고 **기본값을 그대로 두되 그게 실측이 아님을 알린다.**
	var 잰것 := 플레이어몸.재기(플레이어)
	if 잰것["찾음"]:
		결과["폭"] = (잰것["크기"] as Vector2).x
		결과["키"] = (잰것["크기"] as Vector2).y
	else:
		push_warning("지형규칙: 플레이어 콜리전을 못 찾음 → 폭·키는 실측이 아니라 상수다")

	# 점프 성능은 player.gd 가 `_점프_재계산()` 으로 채워둔 값에서 역산한다.
	var g: float = float(플레이어.get("gravity"))
	var jv: float = absf(float(플레이어.get("jump_velocity")))
	var 상승배수: float = float(플레이어.get("상승_배수"))
	var 속도: float = float(플레이어.get("move_speed"))
	if g > 0.0 and jv > 0.0 and 상승배수 > 0.0:
		var 높이 := jv * jv / (2.0 * g * 상승배수)
		var 상승시간 := jv / (g * 상승배수)
		var 낙하시간 := sqrt(2.0 * 높이 / (g * 2.4))   # 2.4 = FALL_GRAVITY_MULTIPLIER
		결과["점프높이"] = 높이
		결과["점프거리"] = 속도 * (상승시간 + 낙하시간)
	return 결과


## 실측값이 위 상수와 크게 어긋나면 경고한다(10% 이상 차이).
static func 상수_점검(플레이어: Node) -> void:
	var 잰것 := 플레이어에서_재기(플레이어)
	var 항목 := {
		"폭": 플레이어_폭, "키": 플레이어_키,
		"점프높이": 점프_높이, "점프거리": 점프_거리,
	}
	for k in 항목:
		var 기준: float = 항목[k]
		var 실제: float = 잰것[k]
		if absf(실제 - 기준) > 기준 * 0.10:
			push_warning("지형규칙: %s 상수(%.1f)와 실측(%.1f)이 다르다 — 상수를 갱신할 것"
				% [k, 기준, 실제])


# ============================================================================
# 1. 정리 — 아무렇게나 찍은 윗면 점들을 물리 규칙에 맞게 걸러낸다
# ============================================================================
## ▣ 이 함수 하나가 규칙 1·2·4 를 전부 책임진다.
##   어떤 방식으로 만든 점이든(사인 곡선 / 손으로 찍기 / 타일맵에서 추출)
##   여기를 통과시키면 "플레이어가 걸어 다닐 수 있는 윗면"이 보장된다.
##
##   1) x 오름차순 정렬        → 되돌아가는 점이 없어진다 (규칙 4의 전제)
##   2) 너무 가까운 점 버리기  → 규칙 1 (뭉침 방지)
##   3) 단차·경사 clamp        → 규칙 2 (못 오르는 절벽 제거)
##
## ⚠ clamp 는 **앞에서부터 누적**된다. 즉 3번에서 y 를 깎으면 그 다음 점은
##   깎인 y 를 기준으로 다시 clamp 된다. 그래야 "완만한 계단"이 되지,
##   원본 y 를 기준으로 각각 깎으면 계단이 다시 절벽으로 붙어버린다.
static func 정리(원본: PackedVector2Array,
		p_최소간격: float = 최소_수평간격,
		p_최대단차: float = 최대_단차,
		p_최대각: float = 최대_경사각) -> PackedVector2Array:
	if 원본.size() < 2:
		return 원본

	# 1) x 오름차순 정렬 — Array 로 옮겨야 custom sort 를 쓸 수 있다
	var 목록: Array[Vector2] = []
	for v in 원본:
		목록.append(v)
	목록.sort_custom(func(a: Vector2, b: Vector2) -> bool: return a.x < b.x)

	var 결과 := PackedVector2Array()
	결과.append(목록[0])

	var 탄젠트 := tan(deg_to_rad(clampf(p_최대각, 1.0, 89.0)))

	for i in range(1, 목록.size()):
		var 후보: Vector2 = 목록[i]
		var 이전: Vector2 = 결과[결과.size() - 1]
		var dx := 후보.x - 이전.x

		# 2) 규칙 1 — 너무 가까우면 **버린다**.
		#    억지로 밀어내면 마지막 점이 지형 범위(x1)를 넘어 다음 지형과 겹친다.
		#    버리는 쪽이 안전하다(모양은 조금 뭉툭해지지만 물리는 절대 안 깨진다).
		if dx < p_최소간격:
			# 다만 **마지막 점만은 못 버린다** — 지형의 오른쪽 끝이 사라지기 때문이다.
			# 이 경우 직전 점을 지우고 마지막 점을 살린다.
			if i == 목록.size() - 1 and 결과.size() >= 2:
				결과.remove_at(결과.size() - 1)
				이전 = 결과[결과.size() - 1]
				dx = 후보.x - 이전.x
				if dx < p_최소간격:
					continue
			else:
				continue

		# 3) 규칙 2 — 단차 한계와 경사 한계 중 **더 엄한 쪽**으로 자른다.
		#    단차 한계 : 간격이 아무리 넓어도 한 번에 48px 이상 올리지 않는다
		#                (한 번에 크게 오르면 그 지점만 "벽"처럼 읽힌다)
		#    경사 한계 : 간격이 좁을 때 45° 를 넘지 않게 한다
		var 한계 := minf(p_최대단차, dx * 탄젠트)
		var dy := clampf(후보.y - 이전.y, -한계, 한계)
		결과.append(Vector2(후보.x, 이전.y + dy))

	return 결과


# ============================================================================
# 2. 생성 — 상태 머신으로 "밟을 수 있는" 지면을 만든다 (규칙 3)
# ============================================================================
enum 걸음 { 평지, 오름, 내림 }

## ▣ 왜 상태 머신인가
##   매 점마다 무작위로 y 를 흔들면 **평평한 곳이 한 군데도 없는 지형**이 나온다.
##   플레이어 눈에는 "계속 울퉁불퉁한 바닥"으로 보이고, 착지·조준·기다림 같은
##   플레이의 리듬이 통째로 사라진다.
##   → 평지(3~5점) → 경사(1~3점) → 평지 … 를 번갈아 만든다.
##     레인월드/리틀 나이트메어의 방이 읽히는 이유가 정확히 이것이다:
##     **넓은 평면이 있고, 그 사이를 이어주는 짧은 경사가 있다.**
##
##   x0, x1   : 지형이 차지할 x 범위
##   기준y    : 시작 높이
##   진폭     : 전체 기복의 세기. 이 값이 커도 **한 걸음의 단차는 규칙 2 로 묶인다**.
##   시드     : 같은 시드 = 같은 지형. 씬을 다시 구울 때 지형이 안 바뀌게 하려면 고정할 것.
static func 지면_윗면(x0: float, x1: float, 기준y: float,
		진폭: float = 120.0, 시드: int = 20260807,
		간격: float = 최소_수평간격) -> PackedVector2Array:
	var rng := RandomNumberGenerator.new()
	rng.seed = 시드

	var 점들 := PackedVector2Array()
	var x := x0
	var y := 기준y
	var 상태: 걸음 = 걸음.평지
	var 남은: int = rng.randi_range(평탄_최소점, 평탄_최대점)
	# 규칙 1 을 확실히 지키기 위해 간격은 절대 최소값 아래로 못 내려간다.
	var 걸음폭 := maxf(간격, 최소_수평간격)

	while x <= x1:
		점들.append(Vector2(x, y))
		x += 걸음폭
		남은 -= 1

		if 남은 > 0:
			# ── 구간이 이어지는 중 ──
			match 상태:
				걸음.평지:
					# 완전한 직선은 죽은 그림이라 ±2px 만 흔든다.
					# 이 정도는 물리에 영향이 없고(경사 1.8°) 타일 테두리만 살아난다.
					y += rng.randf_range(-평탄_요철, 평탄_요철)
				걸음.오름:
					y -= _한걸음(rng, 걸음폭)
				걸음.내림:
					y += _한걸음(rng, 걸음폭)
			continue

		# ── 구간이 끝났다 → 다음 구간을 정한다 ──
		if 상태 == 걸음.평지:
			# 기준선에서 너무 멀어지면 되돌아오는 쪽을 고른다.
			# (안 그러면 지형이 한 방향으로 계속 흘러가 화면 밖으로 나간다)
			var 치우침 := (y - 기준y) / maxf(진폭, 1.0)
			var 오를확률 := clampf(0.5 - 치우침 * 0.5, 0.08, 0.92)
			상태 = 걸음.오름 if rng.randf() < 오를확률 else 걸음.내림
			남은 = rng.randi_range(경사_최소점, 경사_최대점)
		else:
			상태 = 걸음.평지
			남은 = rng.randi_range(평탄_최소점, 평탄_최대점)

	# 오른쪽 끝을 정확히 맞춘다. 규칙 1 을 어길 만큼 가까우면 마지막 점을 옮긴다.
	if 점들.size() > 0:
		var 끝 := 점들[점들.size() - 1]
		if x1 - 끝.x < 최소_수평간격:
			점들[점들.size() - 1] = Vector2(x1, 끝.y)
		else:
			점들.append(Vector2(x1, y))
	return 정리(점들)


## 한 걸음의 세로 이동량. 규칙 2(단차·경사) 안에서만 고른다.
static func _한걸음(rng: RandomNumberGenerator, 걸음폭: float) -> float:
	var 한계 := minf(최대_단차, 걸음폭 * tan(deg_to_rad(최대_경사각)))
	# 최소값을 0 이 아니라 한계의 35% 로 두는 이유:
	# 0 에 가까운 값이 나오면 "경사 구간인데 안 움직였다"가 되어 구간 구분이 흐려진다.
	return rng.randf_range(한계 * 0.35, 한계)


# ============================================================================
# 3. 닫기 — 윗면을 닫힌 다각형으로 (규칙 4)
# ============================================================================
## 윗면 점들 뒤에 바닥 두 점을 붙여 닫는다.
##
## ▣ 감김 방향을 왜 신경 쓰나
##   `지형공통.gd` 의 다른 지형 함수(평바닥·천장·덩어리·벽)가 전부 **시계 방향**이다.
##   SS2D 는 감김 방향으로 "어느 쪽이 바깥인지"를 정하고, 콜리전은
##   `Geometry2D.offset_polygon()` 으로 부풀린 뒤 볼록 분해된다.
##   방향이 섞이면 `Convex decomposing failed!` 가 뜨면서 **조용히 못 밟는 지형**이 된다.
##   (2026-08-06 에 벽 지형에서 실제로 겪었다)
##   윗면을 왼→오로 훑고 바닥을 오→왼으로 닫으면 화면 좌표계(y 아래 방향)에서
##   시계 방향이 된다. 이 순서를 바꾸지 말 것.
static func 닫기(윗면: PackedVector2Array, 바닥y: float) -> PackedVector2Array:
	if 윗면.size() < 2:
		return 윗면
	var 점들 := PackedVector2Array(윗면)
	var 왼x := 윗면[0].x
	var 오른x := 윗면[윗면.size() - 1].x
	# 바닥이 윗면보다 위에 있으면 다각형이 뒤집힌다 — 반드시 아래로 내려 준다.
	var 가장아래 := 윗면[0].y
	for p in 윗면:
		가장아래 = maxf(가장아래, p.y)
	var y := maxf(바닥y, 가장아래 + 최소_수평간격)
	점들.append(Vector2(오른x, y))
	점들.append(Vector2(왼x, y))
	return 점들


## 윗면 + 바닥을 한 번에. 대부분의 호출부는 이것만 쓰면 된다.
static func 지면(x0: float, x1: float, 기준y: float, 바닥y: float,
		진폭: float = 120.0, 시드: int = 20260807) -> PackedVector2Array:
	return 닫기(지면_윗면(x0, x1, 기준y, 진폭, 시드), 바닥y)


# ============================================================================
# 4. 검증
# ============================================================================
## 다각형이 스스로 교차하는가. 인접한 변끼리는 꼭짓점을 공유하므로 건너뛴다.
## 점이 많은 지형에서 O(n²) 이지만, 지형 하나가 보통 100점 이하라 부담이 없다.
static func 자기교차_있나(폴리곤: PackedVector2Array) -> bool:
	var n := 폴리곤.size()
	if n < 4:
		return false
	for i in n:
		var a1 := 폴리곤[i]
		var a2 := 폴리곤[(i + 1) % n]
		for j in range(i + 2, n):
			# 마지막 변과 첫 변은 꼭짓점을 공유한다 — 건너뛴다
			if i == 0 and j == n - 1:
				continue
			var b1 := 폴리곤[j]
			var b2 := 폴리곤[(j + 1) % n]
			if Geometry2D.segment_intersects_segment(a1, a2, b1, b2) != null:
				return true
	return false


## 규칙 위반을 전부 찾아 사람이 읽을 수 있는 목록으로 돌려준다.
## 비어 있으면 합격. 도구·테스트가 이걸로 판정한다.
##
## ▣ `평탄도_검사` 를 왜 끌 수 있게 했나
##   규칙 1·2·4 는 **점과 점 사이의 관계**라서 `정리()` 가 사후에 고칠 수 있다.
##   그런데 규칙 3(평탄 구간)은 **없는 평지를 만들어내야** 지킬 수 있는 규칙이라
##   사후 정리로는 절대 못 고친다 — 그건 레벨 디자인을 바꾸는 일이다.
##   → 생성기(`지면_윗면`)의 결과를 볼 때는 켜고,
##     `정리()` 로 남의 점을 걸러낸 결과를 볼 때는 꺼야 한다.
static func 위반_찾기(윗면: PackedVector2Array,
		평탄도_검사: bool = true) -> Array[String]:
	var 문제: Array[String] = []
	var 탄젠트 := tan(deg_to_rad(최대_경사각))
	for i in range(1, 윗면.size()):
		var a := 윗면[i - 1]
		var b := 윗면[i]
		var dx := b.x - a.x
		var dy := b.y - a.y
		if dx < 최소_수평간격 - 0.01:
			문제.append("규칙1 위반 [%d→%d] 수평 간격 %.1fpx < %.0f" % [i - 1, i, dx, 최소_수평간격])
		if absf(dy) > 최대_단차 + 0.01:
			문제.append("규칙2 위반 [%d→%d] 단차 %.1fpx > %.0f" % [i - 1, i, absf(dy), 최대_단차])
		if dx > 0.01 and absf(dy) > dx * 탄젠트 + 0.01:
			문제.append("규칙2 위반 [%d→%d] 경사 %.1f도 > %.0f도"
				% [i - 1, i, rad_to_deg(atan2(absf(dy), dx)), 최대_경사각])
	# 규칙 3 — 평탄 구간이 하나도 없으면 밟고 설 데가 없다
	if 평탄도_검사 and 윗면.size() >= 평탄_최소점 + 1 and 최장_평탄구간(윗면) < 평탄_최소점:
		문제.append("규칙3 위반: 연속 %d점 이상 평탄한 구간이 없다" % 평탄_최소점)
	return 문제


## 가장 긴 평탄 구간의 점 개수. (Y 변화가 요철 한계 이내인 연속 구간)
static func 최장_평탄구간(윗면: PackedVector2Array) -> int:
	if 윗면.is_empty():
		return 0
	var 최장 := 1
	var 지금 := 1
	for i in range(1, 윗면.size()):
		if absf(윗면[i].y - 윗면[i - 1].y) <= 평탄_요철 * 1.5:
			지금 += 1
			최장 = maxi(최장, 지금)
		else:
			지금 = 1
	return 최장


# ============================================================================
# 5. 조회 — 만들어진 윗면 위에 물건을 놓을 때
# ============================================================================
## 윗면 위 임의의 x 에서의 지면 높이(선형 보간).
## 장식 배치기가 "오브젝트를 지면에 정확히 붙이는" 데 쓴다.
## 범위 밖이면 가장 가까운 끝점의 y.
static func 높이(윗면: PackedVector2Array, x: float) -> float:
	if 윗면.is_empty():
		return 0.0
	if x <= 윗면[0].x:
		return 윗면[0].y
	for i in range(1, 윗면.size()):
		if x <= 윗면[i].x:
			var a := 윗면[i - 1]
			var b := 윗면[i]
			var t := 0.0 if is_equal_approx(b.x, a.x) else (x - a.x) / (b.x - a.x)
			return lerpf(a.y, b.y, t)
	return 윗면[윗면.size() - 1].y


## 그 지점의 지면 기울기(라디안). 경사면에 놓는 물건을 지형에 맞춰 기울일 때 쓴다.
static func 기울기(윗면: PackedVector2Array, x: float) -> float:
	if 윗면.size() < 2:
		return 0.0
	for i in range(1, 윗면.size()):
		if x <= 윗면[i].x:
			var a := 윗면[i - 1]
			var b := 윗면[i]
			return atan2(b.y - a.y, maxf(b.x - a.x, 0.001))
	var p := 윗면[윗면.size() - 2]
	var q := 윗면[윗면.size() - 1]
	return atan2(q.y - p.y, maxf(q.x - p.x, 0.001))
