@tool
extends Sprite2D
## ============================================================================
## [2026-08-07 도형] 아트 슬롯 — 디자이너 그림을 꽂는 자리
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 요청)
##   "장애물들이 현재 gd 로만 구현되어 있는데, 나중에 이미지 넣고 관리하기 쉽게
##    하기 위해서 씬으로 만들어 놓는게 좋을 듯. 이미지는 디자이너가 그리고 있으니까
##    바로 넣을 수 있게."
##
##   지금까지 장애물은 전부 `_draw()` 로 코드가 직접 그렸다. 흑백 게임이라
##   그게 가장 안전했지만(어느 지형 위에서도 보인다), **디자이너 그림이 나오면
##   코드를 고쳐야 그림을 넣을 수 있는** 구조였다.
##
## ▣ 해결 — "슬롯"만 파 두고 코드는 그대로 둔다
##   장애물 씬마다 이 스크립트를 붙인 **`그림` 이라는 이름의 Sprite2D 자식**을 하나 둔다.
##     · 슬롯이 **비어 있으면**  → 지금처럼 `_draw()` 가 코드로 그린다 (아무것도 안 바뀜)
##     · 슬롯에 **텍스처를 넣으면** → `_draw()` 는 스스로 멈추고 그림만 보인다
##   디자이너는 **인스펙터에서 Texture 칸에 PNG 를 끌어다 놓기만** 하면 된다.
##   코드 수정도, 재생성도 필요 없다.
##
## ▣ 장애물 스크립트가 할 일은 딱 한 줄
##   ```gdscript
##   func _draw() -> void:
##       if 아트슬롯.그림_있나(self):
##           return          # 디자이너 그림이 꽂혀 있으면 코드 그리기는 쉰다
##       ...기존 코드...
##   ```
##
## ▣ 자동 크기 맞춤
##   `기준_크기` 를 넣어 두면 그림이 그 크기에 맞게 자동으로 scale 된다.
##   디자이너가 몇 px 로 그리든 게임 안에서는 항상 같은 크기로 보인다
##   → **"이 장애물은 몇 px 로 그려야 하나요?" 라는 질문 자체가 없어진다.**
## ============================================================================
class_name 아트슬롯

## 이 그림이 차지해야 할 게임 안 크기(px). (0,0) 이면 원본 크기 그대로 쓴다.
## 장애물 씬 생성기가 각 장애물의 실제 판정 크기를 여기 적어 둔다.
@export var 기준_크기: Vector2 = Vector2.ZERO:
	set(v):
		기준_크기 = v
		_크기_맞추기()

## 그림 원본이 판정 상자보다 여백을 얼마나 더 갖는지(px).
## 예: 가시 그림이 위아래로 8px 씩 삐져나오게 그려졌다면 (0, 16).
@export var 여백: Vector2 = Vector2.ZERO:
	set(v):
		여백 = v
		_크기_맞추기()


## 이 노드에 디자이너 그림이 꽂혀 있는가.
## 장애물 스크립트가 `_draw()` 맨 위에서 이걸 물어보고, true 면 코드 그리기를 건너뛴다.
static func 그림_있나(주인: Node) -> bool:
	if 주인 == null:
		return false
	var s := 주인.get_node_or_null("그림") as Sprite2D
	return s != null and s.visible and s.texture != null


## 슬롯 노드 자체를 돌려준다 (색에 따라 다른 그림을 쓰고 싶을 때 등).
static func 슬롯(주인: Node) -> 아트슬롯:
	if 주인 == null:
		return null
	return 주인.get_node_or_null("그림") as 아트슬롯


func _ready() -> void:
	# 픽셀아트 원칙 — 흐릿하게 늘어나면 흑백 실루엣이 뭉개진다
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	# 디자이너가 인스펙터에서 Texture 를 꽂거나 바꾸면 그때마다 크기를 다시 맞춘다.
	# Sprite2D 가 제공하는 신호라 우리가 프레임마다 감시할 필요가 없다.
	if not texture_changed.is_connected(_크기_맞추기):
		texture_changed.connect(_크기_맞추기)
	_크기_맞추기()


func _크기_맞추기() -> void:
	if texture == null or 기준_크기 == Vector2.ZERO:
		return
	var 원본 := texture.get_size()
	if 원본.x <= 0.0 or 원본.y <= 0.0:
		return
	var 목표 := 기준_크기 + 여백
	scale = Vector2(목표.x / 원본.x, 목표.y / 원본.y)


# ⚠⚠[2026-08-07 · 엔진이 죽는 버그였다. 절대 되살리지 말 것]
#
#   원래 여기에 이런 코드가 있었다:
#       func _set(속성, 값) -> bool:
#           if 속성 == &"texture":
#               texture = 값          # ← ★무한 재귀
#               _크기_맞추기()
#               return true
#           return false
#
#   GDScript 의 `_set()` 은 **네이티브 프로퍼티보다 먼저** 불린다.
#   그래서 `texture = 값` 이 또 `_set()` 을 부르고, 또 부르고… 스택이 터져
#   **Godot 이 signal 11(세그폴트)로 죽는다.**
#
#   증상이 고약했던 이유: 크래시가 아트슬롯이 아니라 **씬을 교체하는 순간**에 났다.
#   (통로를 지나 스마트월드1 이 해제될 때 texture 가 정리되면서 재귀가 터졌다)
#   그래서 처음엔 통로·장면전환 쪽을 한참 뒤졌다.
#   `tools/repro_통로크래시.gd` 로 씬을 하나씩 바꿔 넣어 이분해서야 찾았다.
#
#   → 지금은 Sprite2D 가 원래 제공하는 `texture_changed` 신호를 쓴다(_ready 참고).
#     프로퍼티 훅을 직접 가로채지 말 것.
