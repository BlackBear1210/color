@tool
extends Node2D
## ============================================================================
## [2026-09-07 신규] 페인트 분사기 — 지형을 스스로 칠하는 장애물
## ----------------------------------------------------------------------------
## ▣ 무엇인가
##   벽·천장에 박혀서 **페인트 투사체를 스스로 쏘는** 장치.
##   그 페인트가 지형에 맞으면 **플레이어가 칠한 것과 똑같이** 색이 입혀진다.
##   → 내가 흰색으로 만들어 둔 발판을 분사기가 검정으로 덮어 버린다.
##      그 위에 서 있으면 색 규칙(`색규칙.gd`)에 따라 그 자리에서 죽는다.
##
## ▣ 왜 필요한가 (2026-09-07 맵분석 §4-1·§4-3)
##   하수도 후반 다섯 판에서 총알을 한 발도 안 쏜다. 물줄기는 위협처럼 생겼는데
##   바닥에 안 닿아서 아무 일도 안 일어난다. 이 챕터가 잃은 건 난이도가 아니라
##   **"화면이 계속 변한다"** 는 감각이다.
##   분사기는 그걸 되돌린다 — 가만히 있어도 맵의 색이 바뀌므로,
##   플레이어는 지나가는 내내 발밑과 벽 색을 다시 읽어야 한다.
##
## ▣ 규칙 (페인트_코어.gd 와 맞물리는 부분 — 여기가 핵심이다)
##   1. 분사기 페인트는 **플레이어 탄약을 쓰지도, 주지도 않는다.**
##   2. 그래서 **E 로 회수할 수 없다.** 내 물감이 아니기 때문이다.
##      → 분사기가 칠한 색을 지우려면 **내 물감을 써서 덮어쓰는 수밖에 없다.**
##        이게 이 장애물이 만드는 압박이고, 총을 후반까지 끌고 가는 장치다.
##   3. 죽거나 스테이지가 다시 시작되면 분사기가 칠한 것도 전부 원래 색으로 돌아간다.
##   4. 투사체 물리는 플레이어 총알(`총알.gd`)과 **완전히 같다.**
##      탄낙차도 있고, 송풍기 바람도 받고, 반대색 물에 막힌다.
##      ★같은 물리를 쓰는 게 중요하다. 조금이라도 다르면 플레이어가 눈으로 익힌
##        "저건 저기 떨어진다" 가 어긋나서 화면을 읽는 재미가 죽는다.
##
## ▣ 플레이어를 직접 죽이지 않는다
##   투사체는 플레이어를 그냥 통과한다(총알은 물리 레이어 0 이다).
##   죽음은 **칠해진 지형을 밟았을 때** 색 규칙으로 일어난다.
##   → "맞으면 죽는 총알" 이 아니라 "땅을 바꾸는 총알" 이다. 성격이 다르다.
##
## ▣ 인스펙터
##   각도 / 탄속 / 발사간격 / 한번에_발사수 / 퍼짐각 / 발사색 / 색_번갈아 …
##   자세한 뜻은 각 항목 주석에 있다.
## ============================================================================
class_name 페인트분사기

const 총알_스크립트 := preload("res://scripts/스마트월드/총알.gd")

# ── 조준 ────────────────────────────────────────────────────────────────────
@export_group("조준")
## 쏘는 방향(도). 0 = 오른쪽 · 90 = 아래 · 180 = 왼쪽 · 270 = 위.
@export_range(0.0, 360.0, 1.0) var 각도: float = 90.0:
	set(v): 각도 = v; queue_redraw()
## 총구가 노드 원점에서 얼마나 앞에 있나(px). 벽에 박아 두고 벽을 안 맞히려고 쓴다.
@export_range(0.0, 200.0, 1.0) var 총구거리: float = 34.0:
	set(v): 총구거리 = v; queue_redraw()
## 장치 몸통 크기(px). 그림(아트슬롯)이 없을 때 코드가 그리는 크기이기도 하다.
@export_range(12.0, 200.0, 1.0) var 몸통크기: float = 44.0:
	set(v): 몸통크기 = v; queue_redraw()

# ── 발사 ────────────────────────────────────────────────────────────────────
@export_group("발사")
## 끄면 아무것도 안 쏜다. 제어레버·버튼으로 켜고 끄는 퍼즐을 만들 때 쓴다.
@export var 작동: bool = true
## **투사체가 총구를 떠나는 속력(px/s).** 낮출수록 포물선이 크게 휜다.
## 플레이어 총 기본값은 1150 이다. 그보다 느리게 두면 "피해서 지나갈 수 있는" 속도가 된다.
@export_range(60.0, 2000.0, 10.0) var 탄속: float = 700.0:
	set(v): 탄속 = v; queue_redraw()
## **얼마나 자주 쏘나(초).** 작을수록 연사가 빨라진다.
@export_range(0.05, 20.0, 0.05) var 발사간격: float = 1.2:
	set(v):
		발사간격 = maxf(v, 0.05)
		# 간격을 줄였는데 예전의 긴 쿨이 남아 있으면 "값을 바꿨는데 안 먹네"가 된다.
		# (레버로 연사를 빠르게 바꾸는 퍼즐에서 실제로 어긋난다)
		# ⚠ `is_node_ready()` 로 막는 이유: 씬 로드 중에는 `_쿨` 이 아직 제 값이 아니다.
		if is_node_ready():
			_쿨 = minf(_쿨, 발사간격)
## **한 번에 몇 발을 쏘나.** 2 이상이면 `퍼짐각` 만큼 부채꼴로 흩어진다.
@export_range(1, 12, 1) var 한번에_발사수: int = 1:
	set(v): 한번에_발사수 = v; queue_redraw()
## 한 번에 여러 발을 쏠 때 부채꼴 전체가 벌어지는 각도(도). 0 이면 전부 같은 방향.
@export_range(0.0, 180.0, 1.0) var 퍼짐각: float = 0.0:
	set(v): 퍼짐각 = v; queue_redraw()
## 탄낙차 배수. 1.0 = 플레이어 총알과 같은 포물선 · 0 = 직선(레이저형).
@export_range(0.0, 3.0, 0.05) var 탄낙차: float = 1.0:
	set(v): 탄낙차 = v; queue_redraw()
## 시작 위상(초). 분사기를 여러 개 놓을 때 엇갈리게 쏘도록 서로 다르게 준다.
@export var 위상: float = 0.0

# ── 색 ──────────────────────────────────────────────────────────────────────
@export_group("색")
## **쏘는 페인트 색.** 0 = 검정 · 1 = 흰색.
@export_enum("검정:0", "흰색:1") var 발사색: int = ColorDefs.BLACK:
	set(v): 발사색 = v; queue_redraw()
## 켜면 `색_전환주기` 마다 흑↔백을 번갈아 쏜다.
@export var 색_번갈아: bool = false
## 색이 바뀌는 주기(초). `색_번갈아` 가 켜져 있을 때만 쓴다.
@export_range(0.2, 30.0, 0.1) var 색_전환주기: float = 4.0

# ── 내부 ────────────────────────────────────────────────────────────────────
var _t: float = 0.0            ## 켜진 뒤 흐른 시간(위상 포함)
var _쿨: float = 0.0           ## 다음 발사까지 남은 시간
var _색: int = ColorDefs.BLACK ## 지금 쏘는 색
var _코어: 페인트코어 = null
var _번쩍: float = 0.0         ## 총구 섬광(발사 직후 잠깐)


func _ready() -> void:
	_색 = 발사색
	_t = 위상
	if Engine.is_editor_hint():
		set_physics_process(false)
		queue_redraw()
		return
	add_to_group("페인트분사기")
	# 첫 발이 스테이지 시작과 동시에 나가면 플레이어가 상황을 못 읽는다 → 한 박자 준다.
	_쿨 = 발사간격
	set_physics_process(true)


func _physics_process(delta: float) -> void:
	_t += delta
	if _번쩍 > 0.0:
		_번쩍 = maxf(_번쩍 - delta * 6.0, 0.0)
		queue_redraw()

	# 색 전환 — 누적이 아니라 시각에서 다시 계산한다.
	# (누적하면 프레임 드랍이 난 뒤 여러 분사기의 위상이 서로 어긋난다)
	var 새색 := 발사색
	if 색_번갈아 and 색_전환주기 > 0.0:
		if int(floor(_t / 색_전환주기)) % 2 == 1:
			새색 = _반대(발사색)
	if 새색 != _색:
		_색 = 새색
		queue_redraw()

	if not 작동:
		return
	_쿨 -= delta
	if _쿨 > 0.0:
		return
	_쿨 += maxf(발사간격, 0.05)
	_발사()


func _발사() -> void:
	if _코어 == null or not is_instance_valid(_코어):
		_코어 = get_tree().get_first_node_in_group("페인트코어") as 페인트코어
	if _코어 == null:
		return                                  # 페인트 규칙 엔진이 없는 씬 — 조용히 쉰다

	var 담을곳 := _투사체_부모()
	var 수 := maxi(한번에_발사수, 1)
	var 기준 := deg_to_rad(각도)
	# 부채꼴은 **기준 방향을 가운데** 두고 벌어져야 한다.
	# (한쪽으로만 벌어지면 발사수를 늘릴 때마다 조준이 스스로 틀어진다)
	var 시작각 := 기준 - deg_to_rad(퍼짐각) * 0.5
	var 간격각 := deg_to_rad(퍼짐각) / float(수 - 1) if 수 > 1 else 0.0

	for i in 수:
		var 방향 := Vector2.RIGHT.rotated(시작각 + 간격각 * float(i)) if 수 > 1 \
			else Vector2.RIGHT.rotated(기준)
		var 총알 := Area2D.new()
		총알.set_script(총알_스크립트)
		담을곳.add_child(총알)
		총알.시작(global_position + 방향 * 총구거리, 방향, 탄속, _색, _코어, null, true, 탄낙차)

	_번쩍 = 1.0
	queue_redraw()


## 투사체를 어디에 매달 것인가.
## 분사기가 회전·이동하는 노드 밑에 있어도 투사체가 끌려다니면 안 되므로
## 변환이 없는 스테이지 루트에 매단다. (owner = 이 노드가 속한 씬의 루트)
func _투사체_부모() -> Node:
	if owner is Node2D:
		return owner
	var s := get_tree().current_scene
	return s if s != null else get_parent()


static func _반대(색: int) -> int:
	return ColorDefs.WHITE if 색 == ColorDefs.BLACK else ColorDefs.BLACK


## 제어레버·버튼이 한 줄로 켜고 끌 수 있게 열어 둔다.
func 켜기() -> void:
	작동 = true

func 끄기() -> void:
	작동 = false

func 지금색() -> int:
	return _색


# ============================================================================
# 그리기 — 흑백 게임이라 "어느 배경에서도 보이는" 2겹 문법을 쓴다 (색레이저.gd 와 동일)
# ============================================================================
func _draw() -> void:
	# 디자이너 그림이 꽂혀 있으면 코드 그리기는 쉰다 (아트슬롯.gd)
	if 아트슬롯.그림_있나(self):
		return

	var 페인트색 := Color(0.95, 0.95, 0.93) if _색 == ColorDefs.WHITE else Color(0.06, 0.06, 0.07)
	var 방향 := Vector2.RIGHT.rotated(deg_to_rad(각도))
	var r := 몸통크기 * 0.5

	# ── 총열 ──
	var 총구 := 방향 * 총구거리
	draw_line(Vector2.ZERO, 총구, Color(0.13, 0.13, 0.14), 몸통크기 * 0.42)
	draw_line(Vector2.ZERO, 총구, Color(0.62, 0.62, 0.66, 0.9), 2.0)

	# ── 몸통 ── (어두운 원 + 밝은 테두리 = 검정 배경에서도 흰 배경에서도 보인다)
	draw_circle(Vector2.ZERO, r, Color(0.14, 0.14, 0.15))
	draw_arc(Vector2.ZERO, r, 0.0, TAU, 28, Color(0.70, 0.70, 0.74, 0.9), 2.5)
	# ── 지금 무슨 색을 쏘는지 = 장치 한가운데 ──
	# ★플레이어가 **들어서기 전에** 알아야 한다. 이게 이 장애물이 공정해지는 조건이다.
	draw_circle(Vector2.ZERO, r * 0.42, 페인트색)
	draw_arc(Vector2.ZERO, r * 0.42, 0.0, TAU, 20,
		Color(0.85, 0.85, 0.88) if _색 == ColorDefs.BLACK else Color(0.08, 0.08, 0.09), 1.5)

	# ── 총구 섬광 ──
	if _번쩍 > 0.0:
		draw_circle(총구, r * 0.5 * _번쩍, Color(페인트색.r, 페인트색.g, 페인트색.b, 0.55 * _번쩍))

	_궤적_그리기(페인트색)


## 에디터에서만 보이는 예상 궤적. 레벨 디자이너가 "이게 어디에 떨어지나"를
## 실행하지 않고 알 수 있어야 배치가 빨라진다. (게임 중에는 안 그린다 — 정답 노출)
func _궤적_그리기(페인트색: Color) -> void:
	if not Engine.is_editor_hint():
		return
	var 기준 := deg_to_rad(각도)
	var 수 := maxi(한번에_발사수, 1)
	var 시작각 := 기준 - deg_to_rad(퍼짐각) * 0.5
	var 간격각 := deg_to_rad(퍼짐각) / float(수 - 1) if 수 > 1 else 0.0
	for i in 수:
		var 방향 := Vector2.RIGHT.rotated(시작각 + 간격각 * float(i)) if 수 > 1 \
			else Vector2.RIGHT.rotated(기준)
		# 총알.gd 와 같은 적분 순서(중력을 속도에 먼저 더한 뒤 위치 이동).
		# 순서가 다르면 미리보기가 실제 탄착과 어긋나 없느니만 못하다.
		var 속도 := 방향 * 탄속
		var 위치 := 방향 * 총구거리
		var 간격 := 1.0 / 60.0
		for step in int(총알_스크립트.최대_수명 / 간격):
			속도.y += 총알_스크립트.중력 * 탄낙차 * 간격
			var 다음 := 위치 + 속도 * 간격
			if step % 4 == 0:
				draw_circle(다음, 3.4, Color(0.05, 0.05, 0.06, 0.5))
				draw_circle(다음, 2.2, Color(페인트색.r, 페인트색.g, 페인트색.b, 0.75))
			위치 = 다음


func _process(_delta: float) -> void:
	if Engine.is_editor_hint():
		queue_redraw()
