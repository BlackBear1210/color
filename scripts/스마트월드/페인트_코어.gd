extends Node
## ============================================================================
## [2026-08-01 신규] 페인트 시스템 v4 — 규칙 엔진
## ----------------------------------------------------------------------------
## ▣ 이 파일이 규칙의 유일한 출처다
##   지형·식물·발판이 각자 "내가 무슨 색인지"만 알고, **몇 발 썼는지 / 무엇부터
##   회수되는지 / 언제 회색이 되는지**는 전부 여기서 판단한다.
##   → 규칙이 바뀌면 이 파일 하나만 고치면 된다.
##
## ▣ 규칙 (2026-08-01 확정본)
##   1. 지형에 페인트를 쏘면 그 색으로 칠해진다.
##   2. 이미 칠해진 색 위에 **반대색**을 쏘면 → **회색**.
##   3. 회색은 **수동 회수 불가**. 스테이지를 넘어갈 때만 자동 회수된다.
##   4. 회수 순서는 **FIFO(먼저 칠한 것부터)**. 회색은 이 줄에서 빠진다.
##   5. 총알은 쏠 때마다 1발 소모. **회색은 2발 판정**
##      (원래 색 1발 + 덮은 1발 = 둘 다 스테이지 이동 전까지 잠긴다).
##   6. 빗나감 / 이미 같은 색 / 칠할 수 없는 대상 → 페인트는 그 자리에서 회수(환급).
##
## ▣ 회색이 왜 자동으로 2발이 되는가 (코드로 따로 세지 않는다)
##   검정으로 칠할 때 1발 잠김 → 회수줄에 등록.
##   흰색을 덮어 회색이 되면 또 1발 잠기고, **회수줄에서 그 항목이 빠진다**.
##   그래서 두 발 모두 스테이지가 넘어갈 때까지 안 돌아온다 = 규칙 5 와 동일.
##
## ▣ 칠할 수 있는 대상이 지켜야 할 약속 (덕 타이핑)
##   대상은 아래 메서드를 가지고 "칠할수있음" 그룹에 들어 있어야 한다.
##     명중(색: int, 월드좌표: Vector2) -> String
##         반환값: "progress"(부분) / "painted"(전체 완성) / "mixed_gray"(회색화)
##                 "wasted"(같은 색 덧칠) / "blocked"(칠할 수 없음)
##     되돌리기() -> bool          무색으로 복귀. 회색이면 false.
##     현재색() -> int             ColorDefs.BLACK/WHITE/GRAY, 무색이면 -1
## ============================================================================
class_name 페인트코어

signal 탄약_변경(남은: int, 최대: int)
signal 상태_변경(대상: Node, 결과: String, 색: int)

## 스테이지 하나에서 쓸 수 있는 페인트 총량.
## ★[2026-08-01 수정] 값을 바꾸면 잔량도 같이 맞춘다.
##   예전에는 _ready() 의 리셋()에서만 잔량을 채웠는데, 생성기나 테스트처럼
##   _ready() 전에 값을 넣고 바로 쓰는 경우 잔량이 기본값(12)인 채로 남아
##   "최대 10인데 잔량 11" 같은 상태가 만들어졌다. (test_페인트v4 에서 잡힘)
@export var 최대_탄약: int = 12:
	set(v):
		최대_탄약 = maxi(v, 0)
		남은_탄약 = 최대_탄약

var 남은_탄약: int = 12

## 회수 대기줄 — 먼저 칠하기 시작한 것이 앞. 원소 = { "대상": Node, "발수": int }
## ★[2026-08-06 수정] 완성("painted")된 것뿐 아니라 부분 색칠("progress") 중인 대상도
## 여기 등록해서 E 로 바로 회수할 수 있게 했다 — "1회 발사로 다 안 덮이는 크기는 부분
## 색칠만 되고, 그것도 회수가 돼야 한다"는 요청 반영. 회색이 된 대상은 여기서 빠진다(규칙 3·4).
var _회수줄: Array[Dictionary] = []

## 회색이 되어 잠긴 총 발수. 스테이지 이동 시 한꺼번에 돌아온다.
var _잠긴_발수: int = 0

## ★[2026-08-06 신규] 회색이 된 대상 목록 — 사망/스테이지 리셋 시 강제로 무색화하려고 따로 든다.
## (회색은 _회수줄 에서 빠지기 때문에 리셋() 이 이 목록 없이는 회색을 찾을 방법이 없었다 →
##  "죽으면 회색으로 칠해진 것도 초기화돼야 하는데 안 된다" 버그의 원인이었다.)
var _회색_목록: Array[Node] = []

## ★[2026-08-17] 지금 날아가는 중인 발 수.
##
## ▣ 왜 세나 — 규칙이 아니라 **화면 때문**이다
##   탄약은 쏘는 순간 깎이고(선입금), 결과가 나오면 환급되거나 잠긴다.
##   그래서 HUD 가 `남은_탄약` 을 그대로 그리면 한 발에 **두 번** 바뀐다.
##     쏨 → 칸이 꺼짐 → (총알 비행) → 착탄 → 칸이 다시 켜지거나 빈 칸이 됨
##   빗나가면 꺼졌다 켜지기만 해서 **깜빡임만 남는다**(도형님 제보: "정신사납다").
##
##   → HUD 는 `남은_탄약 + 비행중` 을 그린다. 날아가는 동안에는 아무것도 안 변하고,
##     **착탄하는 순간 딱 한 번** 바뀐다.
##
## ⚠ 규칙은 하나도 안 바뀐다. `남은_탄약` 은 예전 그대로라 `쏠_수_있나()` 도 그대로다
##   (비행 중인 발로 또 쏠 수는 없다). 이 값은 **표시 전용**이다.
var _비행중: int = 0


func _ready() -> void:
	리셋()


## 스테이지 시작 / 스테이지 이동 시 호출.
## 규칙 3: 이때 회색을 포함한 **모든** 페인트가 자동 회수된다.
func 리셋() -> void:
	for 항목 in _회수줄:
		var 대상: Node = 항목["대상"]
		if is_instance_valid(대상) and 대상.has_method("되돌리기"):
			대상.되돌리기()
	_회수줄.clear()
	# 회색은 되돌리기() 가 거부하므로 강제_초기화() 로 따로 처리한다.
	for 대상 in _회색_목록:
		if is_instance_valid(대상) and 대상.has_method("강제_초기화"):
			대상.강제_초기화()
	_회색_목록.clear()
	_잠긴_발수 = 0
	# 씬을 갈아끼우면 날아가던 총알이 결과를 못 알리고 사라진다 → 여기서 털어야
	# 다음 스테이지에서 HUD 가 있지도 않은 발을 계속 보여주지 않는다.
	_비행중 = 0
	남은_탄약 = 최대_탄약
	탄약_변경.emit(남은_탄약, 최대_탄약)


## 발사 가능 여부. 총(총.gd)이 방아쇠를 당기기 전에 물어본다.
func 쏠_수_있나() -> bool:
	return 남은_탄약 > 0


## 발사 순간 1발 차감. 명중 결과에 따라 나중에 환급될 수 있다.
func 발사_소모() -> bool:
	if 남은_탄약 <= 0:
		return false
	남은_탄약 -= 1
	_비행중 += 1                      # 착탄할 때까지 HUD 는 이 발을 계속 보여준다
	탄약_변경.emit(남은_탄약, 최대_탄약)
	return true


## 총알이 뭔가에 맞았거나(대상 != null) 허공에서 사라졌을 때(대상 == null) 호출.
## 규칙 6 의 "회수"와 규칙 1·2 의 상태 전이를 여기서 한 번에 처리한다.
func 명중_처리(대상: Node, 색: int, 월드좌표: Vector2) -> String:
	# 이 발은 결판이 났다 → 비행 목록에서 뺀다. **결과 판정보다 먼저** 빼야
	# 아래에서 무엇이 일어나든 HUD 합계가 어긋나지 않는다.
	# (0 아래로 안 내려가게 막는다 — 도구·테스트가 발사_소모 없이 부를 수 있다)
	_비행중 = maxi(_비행중 - 1, 0)

	# ── 빗나감: 아무것도 못 맞혔으면 페인트는 그대로 돌아온다 ──
	if 대상 == null or not is_instance_valid(대상) or not 대상.has_method("명중"):
		_환급(1)
		return "miss"

	var 결과: String = 대상.명중(색, 월드좌표)

	match 결과:
		"painted", "progress":
			# 완성이든 부분 색칠이든 발수는 그 대상 앞으로 회수줄에 쌓인다.
			# (부분 상태도 E 로 바로 회수할 수 있어야 한다 — 완성 전에 흐려져 사라지면
			#  대상이 부분_자동회수() 를 불러 줄에서 빼고 그만큼 돌려준다.)
			# ★[2026-08-17] 명중 지점도 같이 기억한다 — HUD 의 E 마커가 뜰 자리다.
			#   노드 좌표를 쓰면 안 된다: SS2D 지형은 원점이 도형 한쪽 끝이라
			#   마커가 지형 저 멀리에 뜬다. "칠한 자리"에 떠야 플레이어가 알아본다.
			_회수줄_기록(대상, 월드좌표)
		"mixed_gray":
			# 규칙 3: 회색은 수동 회수 불가 → 줄에서 빼고 발수를 잠근다.
			var 발수 := _회수줄_제거(대상)
			_잠긴_발수 += 발수 + 1      # 원래 색 발수 + 방금 덮은 1발
			if not _회색_목록.has(대상):
				_회색_목록.append(대상)
		"wasted", "blocked":
			# 이미 같은 색이거나 칠할 수 없는 대상 → 페인트 회수
			_환급(1)

	상태_변경.emit(대상, 결과, 색)
	return 결과


## E 수동 회수 — 규칙 4(FIFO). 회색은 애초에 줄에 없으므로 자동으로 제외된다.
## 되돌릴 게 없으면 false.
func 수동_회수() -> bool:
	while not _회수줄.is_empty():
		var 항목: Dictionary = _회수줄.pop_front()
		var 대상: Node = 항목["대상"]
		if not is_instance_valid(대상):
			continue                      # 이미 사라진 대상은 건너뛴다
		if 대상.되돌리기():
			_환급(항목["발수"])
			상태_변경.emit(대상, "회수", -1)
			return true
	return false


## 부분 색칠이 스스로 흐려져 사라졌을 때 대상이 직접 부른다.
func 부분_자동회수(대상: Node, 발수: int) -> void:
	# 대상은 이미 스스로 되돌려진 뒤라, 회수줄에 남아있으면 안 되므로 여기서 지운다.
	_회수줄_제거(대상)
	_환급(발수)
	상태_변경.emit(대상, "자동회수", -1)


# ── 내부 ────────────────────────────────────────────────────────────────────

func _회수줄_찾기(대상: Node) -> int:
	for i in _회수줄.size():
		if _회수줄[i]["대상"] == 대상:
			return i
	return -1

## "progress"/"painted" 명중 한 번을 대상 앞으로 1발 쌓는다. 이미 줄에 있으면 발수만 늘린다.
## 좌표는 **가장 최근 명중 지점**으로 계속 갱신한다 — 마커가 마지막으로 칠한 자리에 뜬다.
func _회수줄_기록(대상: Node, 좌표: Vector2) -> void:
	var i := _회수줄_찾기(대상)
	if i >= 0:
		_회수줄[i]["발수"] += 1
		_회수줄[i]["좌표"] = 좌표
	else:
		_회수줄.push_back({ "대상": 대상, "발수": 1, "좌표": 좌표 })

## 줄에서 대상을 빼고 그 대상이 먹었던 발수를 돌려준다(환급이 아니라 조회).
func _회수줄_제거(대상: Node) -> int:
	var i := _회수줄_찾기(대상)
	if i < 0:
		return 0
	var 발수: int = _회수줄[i]["발수"]
	_회수줄.remove_at(i)
	return 발수

func _환급(수량: int) -> void:
	if 수량 <= 0:
		return
	남은_탄약 = mini(남은_탄약 + 수량, 최대_탄약)
	탄약_변경.emit(남은_탄약, 최대_탄약)


# ── 조회 (HUD·자동테스트용) ─────────────────────────────────────────────────
func 회수_대기수() -> int:
	return _회수줄.size()

func 잠긴_발수() -> int:
	return _잠긴_발수

## 지금 날아가는 중인 발 수. **HUD 표시 전용** — 규칙 판정에 쓰면 안 된다.
func 비행중() -> int:
	return _비행중

## 다음에 회수될 대상 (HUD 하이라이트용). 없으면 null.
func 다음_회수대상() -> Node:
	for 항목 in _회수줄:
		if is_instance_valid(항목["대상"]):
			return 항목["대상"]
	return null


# ── [2026-08-17 추가] HUD 전용 조회 ─────────────────────────────────────────
# 전부 **읽기만** 한다. 규칙에 관여하지 않으므로 기존 검사에 영향이 없다.
# HUD 가 회수줄을 직접 만지면 규칙이 두 군데로 갈라지므로 사본만 넘긴다.

## 회수 대기줄 사본. 앞이 먼저 칠한 것(FIFO).
## 원소 = { "대상": Node, "발수": int, "좌표": Vector2 }
func 회수줄_요약() -> Array:
	var 결과: Array = []
	for 항목 in _회수줄:
		var 대상: Node = 항목["대상"]
		if not is_instance_valid(대상):
			continue
		결과.append({
			"대상": 대상,
			"발수": int(항목["발수"]),
			"좌표": 항목.get("좌표", Vector2.ZERO),
		})
	return 결과


## 그 대상에 지금까지 들어간 발 수. 줄에 없으면 0.
## (회색이 된 대상은 줄에서 빠지므로 0 이 나온다 — 의도한 값이다.
##  회색은 더 이상 "내가 회수할 수 있는 발"이 아니기 때문이다)
func 대상_발수(대상: Node) -> int:
	var i := _회수줄_찾기(대상)
	return int(_회수줄[i]["발수"]) if i >= 0 else 0


## 그 대상을 마지막으로 칠한 월드 좌표. 줄에 없으면 null.
func 대상_좌표(대상: Node) -> Variant:
	var i := _회수줄_찾기(대상)
	if i < 0:
		return null
	return _회수줄[i].get("좌표", null)
