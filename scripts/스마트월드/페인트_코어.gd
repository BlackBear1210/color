extends Node
## ============================================================================
## [2026-08-01 신규] 페인트 시스템 v4 — 규칙 엔진
## ----------------------------------------------------------------------------
## ▣ 이 파일이 규칙의 유일한 출처다
##   지형·식물·발판이 각자 "내가 무슨 색인지"만 알고, **몇 발 썼는지 / 무엇부터
##   회수되는지 / 언제 회색이 되는지**는 전부 여기서 판단한다.
##   → 규칙이 바뀌면 이 파일 하나만 고치면 된다.
##
## ▣ 규칙 (2026-08-01 확정본)
##   1. 지형에 페인트를 쏘면 그 색으로 칠해진다.
##   2. 이미 칠해진 색 위에 **반대색**을 쏘면 → **회색**.
##   3. 회색은 **수동 회수 불가**. 스테이지를 넘어갈 때만 자동 회수된다.
##   4. 회수 순서는 **FIFO(먼저 칠한 것부터)**. 회색은 이 줄에서 빠진다.
##   5. 총알은 쏠 때마다 1발 소모. **회색은 2발 판정**
##      (원래 색 1발 + 덮은 1발 = 둘 다 스테이지 이동 전까지 잠긴다).
##   6. 빗나감 / 이미 같은 색 / 칠할 수 없는 대상 → 페인트는 그 자리에서 회수(환급).
##
## ▣ 회색이 왜 자동으로 2발이 되는가 (코드로 따로 세지 않는다)
##   검정으로 칠할 때 1발 잠김 → 회수줄에 등록.
##   흰색을 덮어 회색이 되면 또 1발 잠기고, **회수줄에서 그 항목이 빠진다**.
##   그래서 두 발 모두 스테이지가 넘어갈 때까지 안 돌아온다 = 규칙 5 와 동일.
##
## ▣ 칠할 수 있는 대상이 지켜야 할 약속 (덕 타이핑)
##   대상은 아래 메서드를 가지고 "칠할수있음" 그룹에 들어 있어야 한다.
##     명중(색: int, 월드좌표: Vector2) -> String
##         반환값: "progress"(부분) / "painted"(전체 완성) / "mixed_gray"(회색화)
##                 "wasted"(같은 색 덧칠) / "blocked"(칠할 수 없음)
##     되돌리기() -> bool          무색으로 복귀. 회색이면 false.
##     현재색() -> int             ColorDefs.BLACK/WHITE/GRAY, 무색이면 -1
## ============================================================================
class_name 페인트코어

signal 탄약_변경(남은: int, 최대: int)
signal 상태_변경(대상: Node, 결과: String, 색: int)

## 스테이지 하나에서 쓸 수 있는 페인트 총량.
## ★[2026-08-01 수정] 값을 바꾸면 잔량도 같이 맞춘다.
##   예전에는 _ready() 의 리셋()에서만 잔량을 채웠는데, 생성기나 테스트처럼
##   _ready() 전에 값을 넣고 바로 쓰는 경우 잔량이 기본값(12)인 채로 남아
##   "최대 10인데 잔량 11" 같은 상태가 만들어졌다. (test_페인트v4 에서 잡힘)
@export var 최대_탄약: int = 12:
	set(v):
		최대_탄약 = maxi(v, 0)
		남은_탄약 = 최대_탄약

var 남은_탄약: int = 12

## 회수 대기줄 — 먼저 칠한 것이 앞. 원소 = { "대상": Node, "발수": int }
## 회색이 된 대상은 여기서 빠진다(규칙 3·4).
var _회수줄: Array[Dictionary] = []

## 회색이 되어 잠긴 총 발수. 스테이지 이동 시 한꺼번에 돌아온다.
var _잠긴_발수: int = 0


func _ready() -> void:
	리셋()


## 스테이지 시작 / 스테이지 이동 시 호출.
## 규칙 3: 이때 회색을 포함한 **모든** 페인트가 자동 회수된다.
func 리셋() -> void:
	for 항목 in _회수줄:
		var 대상: Node = 항목["대상"]
		if is_instance_valid(대상) and 대상.has_method("되돌리기"):
			대상.되돌리기()
	_회수줄.clear()
	_잠긴_발수 = 0
	남은_탄약 = 최대_탄약
	탄약_변경.emit(남은_탄약, 최대_탄약)


## 발사 가능 여부. 총(총.gd)이 방아쇠를 당기기 전에 물어본다.
func 쏠_수_있나() -> bool:
	return 남은_탄약 > 0


## 발사 순간 1발 차감. 명중 결과에 따라 나중에 환급될 수 있다.
func 발사_소모() -> bool:
	if 남은_탄약 <= 0:
		return false
	남은_탄약 -= 1
	탄약_변경.emit(남은_탄약, 최대_탄약)
	return true


## 총알이 뭔가에 맞았거나(대상 != null) 허공에서 사라졌을 때(대상 == null) 호출.
## 규칙 6 의 "회수"와 규칙 1·2 의 상태 전이를 여기서 한 번에 처리한다.
func 명중_처리(대상: Node, 색: int, 월드좌표: Vector2) -> String:
	# ── 빗나감: 아무것도 못 맞혔으면 페인트는 그대로 돌아온다 ──
	if 대상 == null or not is_instance_valid(대상) or not 대상.has_method("명중"):
		_환급(1)
		return "miss"

	var 결과: String = 대상.명중(색, 월드좌표)

	match 결과:
		"painted":
			# 전체 색칠 완성 → 회수줄 맨 뒤에 선다.
			_회수줄_등록(대상)
		"progress":
			# 부분 색칠도 발수는 그 대상에 누적된다. 완성 전에 흐려져 사라지면
			# 대상이 부분회수됨() 을 불러 그만큼 돌려준다.
			_부분_누적(대상)
		"mixed_gray":
			# 규칙 3: 회색은 수동 회수 불가 → 줄에서 빼고 발수를 잠근다.
			var 발수 := _회수줄_제거(대상)
			_잠긴_발수 += 발수 + 1      # 원래 색 발수 + 방금 덮은 1발
		"wasted", "blocked":
			# 이미 같은 색이거나 칠할 수 없는 대상 → 페인트 회수
			_환급(1)

	상태_변경.emit(대상, 결과, 색)
	return 결과


## E 수동 회수 — 규칙 4(FIFO). 회색은 애초에 줄에 없으므로 자동으로 제외된다.
## 되돌릴 게 없으면 false.
func 수동_회수() -> bool:
	while not _회수줄.is_empty():
		var 항목: Dictionary = _회수줄.pop_front()
		var 대상: Node = 항목["대상"]
		if not is_instance_valid(대상):
			continue                      # 이미 사라진 대상은 건너뛴다
		if 대상.되돌리기():
			_환급(항목["발수"])
			상태_변경.emit(대상, "회수", -1)
			return true
	return false


## 부분 색칠이 스스로 흐려져 사라졌을 때 대상이 직접 부른다.
func 부분_자동회수(대상: Node, 발수: int) -> void:
	# 부분 색칠은 회수줄에 등록되지 않았으므로(완성 전) 줄에서 뺄 것도 없다.
	_부분_지우기(대상)
	_환급(발수)
	상태_변경.emit(대상, "자동회수", -1)


# ── 내부 ────────────────────────────────────────────────────────────────────

## 완성 전까지 대상별로 몇 발 먹었는지 임시로 센다.
var _부분_발수: Dictionary = {}

func _부분_누적(대상: Node) -> void:
	_부분_발수[대상] = int(_부분_발수.get(대상, 0)) + 1

func _부분_지우기(대상: Node) -> void:
	_부분_발수.erase(대상)

func _회수줄_등록(대상: Node) -> void:
	# 완성 직전까지 쌓인 부분 발수 + 완성타 1발 = 이 대상이 먹은 총 발수
	var 발수 := int(_부분_발수.get(대상, 0)) + 1
	_부분_지우기(대상)
	_회수줄.push_back({ "대상": 대상, "발수": 발수 })

## 줄에서 대상을 빼고 그 대상이 먹었던 발수를 돌려준다(환급이 아니라 조회).
func _회수줄_제거(대상: Node) -> int:
	for i in _회수줄.size():
		if _회수줄[i]["대상"] == 대상:
			var 발수: int = _회수줄[i]["발수"]
			_회수줄.remove_at(i)
			return 발수
	# 줄에 없다 = 부분 색칠 상태에서 반대색을 맞은 경우
	var 부분 := int(_부분_발수.get(대상, 0))
	_부분_지우기(대상)
	return 부분

func _환급(수량: int) -> void:
	if 수량 <= 0:
		return
	남은_탄약 = mini(남은_탄약 + 수량, 최대_탄약)
	탄약_변경.emit(남은_탄약, 최대_탄약)


# ── 조회 (HUD·자동테스트용) ─────────────────────────────────────────────────
func 회수_대기수() -> int:
	return _회수줄.size()

func 잠긴_발수() -> int:
	return _잠긴_발수

## 다음에 회수될 대상 (HUD 하이라이트용). 없으면 null.
func 다음_회수대상() -> Node:
	for 항목 in _회수줄:
		if is_instance_valid(항목["대상"]):
			return 항목["대상"]
	return null
