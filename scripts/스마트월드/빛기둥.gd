@tool
extends Node2D
## ============================================================================
## [2026-08-18 도형 · 신규] 빛기둥 — 지붕 구멍 / 창문에서 새어 드는 빛
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 요청 그대로)
##   "창문 밖으로 빛이 새어나오는 걸 만들어서 빛이 빛추는 부분은 경계선으로 작용되고
##    딱 빛 새어나오는 효과를 이펙트를 잘 부여해줘."
##   "빨간 색으로 색칠한 부분은 집의 지붕이 구멍이 나서 빛이 새어나오는 걸 표현."
##
##   지금까지 이 게임에서 "색을 가진 것"은 전부 **만질 수 있는 물체**였다(지형·물·덤불).
##   빛은 아니다. 그런데 이 게임의 핵심 규칙은 "내 색과 다른 것에 닿으면 죽는다" 이고,
##   빛은 **닿을 수 있는 것 중 유일하게 지형이 아닌 것**이다.
##   → 빛을 색 규칙 안으로 끌어들이면, 지형을 하나도 안 놓고도 길을 막거나 열 수 있다.
##     이게 "집 안" 챕터의 정체성이 된다(숲은 지형, 집은 빛).
##
## ▣ ★★[2026-08-20 전면 수정] "경계" 의 뜻을 바로잡았다
##   2026-08-18 에 이 스크립트를 만들면서 경계를 **즉사 판정**으로 구현했다. **틀렸다.**
##   도형님 정의: *"우리 게임에서 경계란 플레이어 색이 강제로 변하고
##   쉬프트로 색을 바꿀 수 없는 곳이야."*
##
##   실제로 이 프로젝트의 경계는 처음부터 그렇게 만들어져 있었다 —
##     · `scenes/경계/color_zone.gd` : 다각형 안에 들어오면 그 색으로 **강제**.
##       `process_physics_priority = 10` 으로 **플레이어 입력 뒤에** 돌아서,
##       Shift 를 눌러도 같은 프레임에 되돌린다 = 사실상 잠금.
##     · `월드.gd _지대_적용()` : 식물 B 지대도 같은 방식으로 색을 강제한다.
##   **즉사는 `색레이저.gd` 의 역할이지 경계가 아니다.** 둘을 섞으면 규칙이 무너진다.
##   → 이 스크립트의 `경계` 모드를 **색 강제 구역**으로 다시 만들었다. 죽이지 않는다.
##
##   ▣ 경계가 죽이지 않아도 위험한 이유 (퍼즐이 되는 지점)
##     빛에 물들면 내 색이 바뀐다. 그 색으로 **다음 지형을 밟으면** 지형 규칙에 걸려 죽는다.
##     즉 경계는 "여기서 죽는다" 가 아니라 **"여기를 지나면 네 색이 바뀐다 — 그다음을 생각해라"** 다.
##     플레이어가 손해를 스스로 계산하게 만드는 장치라 훨씬 좋은 장애물이다.
##
## ▣ 세 가지 모드 — 하나의 스크립트로 세 역할을 한다
##   연출 : 그림만. 판정 없음. 배경 분위기용(굴뚝 벽 틈새 등).
##   경계 : **플레이어 색을 빛 색으로 강제한다. Shift 로 못 바꾼다. 죽지 않는다.**
##          가까이 갈수록 **몸이 서서히 그 색으로 차오른다**(도형님 요청 연출).
##          → 커튼(물감으로 바꾸는 것)과 역할이 확실히 갈린다: 경계는 **나를** 바꾸고,
##            커튼은 **빛을** 바꾼다. 이펙트도 그래서 반대다 (차오름 vs 물듦).
##   발판 : 빛이 **굳어서 딛고 설 수 있다**(StaticBody2D · 레이어 1).
##          지형과 완전히 같은 계약(`현재색`/`반대색인가`)을 쓰므로
##          `월드.gd` 의 사망 판정이 **한 줄도 안 바뀐 채로** 그대로 적용된다.
##          → "커튼을 쳐서 빛을 굳혀 발판을 만든다" 가 이 챕터의 퍼즐이 된다.
##
## ▣ 색의 뜻 (ColorDefs 와 같은 값 + −1)
##   −1 무색 : 아직 아무 색도 안 든 순수한 햇빛. **누구에게도 안전**하고 안 굳는다.
##    0 검정 / 1 흰색 : 위 규칙대로 작동한다.
##    2 회색 : 섞여 버린 빛. 안전하지만 **영원히 되돌릴 수 없다**(게임 규칙 3과 같다).
##
## ▣ 누가 언제 부르나
##   발판 모드 = 레이어 1 이라 `월드.gd` 의 지형 겹침 판정이 자동으로 잡는다(변경 0).
##   경계 모드 = 그룹 `빛경계` 로 등록하고 `월드.gd _지대_적용()` 이 색을 강제한다.
##              ⚠ `_사망_판정()` 이 아니다 — 경계는 죽이지 않는다.
##
## ▣ 그림 (셰이더를 안 쓴 이유)
##   §5-5 지뢰 — .gdshader 안에는 한글을 못 쓴다. 그리고 이 빛은 **모양이 매번 다르다**
##   (지붕 구멍마다 폭·각도·길이가 다르다). 셰이더로 하면 파라미터가 10개가 넘어간다.
##   → `_draw()` 로 사다리꼴을 여러 겹 포개서 그린다. 겹수가 곧 부드러움이다.
##     먼지 티끌은 빛 안에서만 떠다니게 해서 "빛에 부피가 있다"를 만든다.
## ============================================================================
class_name 빛기둥

enum 모드_ { 연출, 경계, 발판 }

## 무색(아직 색이 안 든 순수한 빛). ColorDefs 에 없는 값이라 여기서 정의한다.
const 무색: int = -1

@export var 모드: 모드_ = 모드_.경계:
	set(v): 모드 = v; _재구성(); queue_redraw()

## 빛이 나오는 구멍의 폭(px). 원점이 곧 구멍이다.
@export_range(8.0, 800.0) var 시작폭: float = 90.0:
	set(v): 시작폭 = v; _재구성(); queue_redraw()

## 빛이 퍼져서 바닥에 닿을 때의 폭(px). 시작폭보다 커야 "퍼진다"로 읽힌다.
@export_range(8.0, 1600.0) var 끝폭: float = 230.0:
	set(v): 끝폭 = v; _재구성(); queue_redraw()

## 빛이 뻗는 길이(px).
@export_range(40.0, 3000.0) var 길이: float = 620.0:
	set(v): 길이 = v; _재구성(); queue_redraw()

## 빛이 뻗는 방향(도). 90 = 아래(지붕 구멍에서 바닥으로), 0 = 오른쪽(창문에서 방 안으로).
@export_range(0.0, 360.0) var 각도: float = 90.0:
	set(v): 각도 = v; _재구성(); queue_redraw()

@export_group("색")
## 지금 이 빛의 색. −1 무색 / 0 검정 / 1 흰색 / 2 회색.
## 창문커튼이 붙어 있으면 커튼이 이 값을 밀어 넣는다.
@export_enum("무색:-1", "검정:0", "흰색:1", "회색:2") var 색: int = 무색:
	set(v): 색 = v; _색_반영()

## 색이 바뀔 때 부드럽게 물드는 시간(초). 도형님 요청 "은은하게 바뀌고".
## 0 이면 즉시 바뀐다(테스트가 쓴다).
@export_range(0.0, 3.0) var 물드는시간: float = 0.9

@export_group("경계")
## ★빛 바깥 이 거리부터 몸이 물들기 시작한다(px). 도형님 요청:
##   *"플레이어가 경계 근처에 가까이 가면 서서히 플레이어의 색이 채워지는 느낌"*
##
## ▣ 왜 "안에 들어가면 딸깍" 이 아니라 미리 물드나
##   경계는 **되돌릴 수 없는 결정**이다(내 색이 바뀌면 다음 지형에서 죽을 수도 있다).
##   그런데 빛 안에 발을 들이는 순간 끝나면, 플레이어는 **결정한 적이 없는데** 결과를 받는다.
##   미리 차오르면 "지금 물러나면 되돌릴 수 있다" 는 구간이 생긴다 — 그게 이 연출의 목적이다.
##   ⚠ 너무 넓으면(300 이상) 지나가기만 해도 늘 물들어서 경고의 뜻이 사라진다.
@export_range(0.0, 400.0) var 물듦_반경: float = 150.0

## 빛 안에 완전히 들어갔을 때 색이 실제로 바뀌기까지 걸리는 시간(초).
## 0 이면 즉시. 물듦 연출이 끝나는 순간과 색이 바뀌는 순간을 맞추려면 이 값을 쓴다.
@export_range(0.0, 2.0) var 물듦_시간: float = 0.35

@export_group("연출")
## 빛의 밝기(0~1). 지붕 구멍은 밝게(0.9), 굴뚝 벽 틈은 약하게(0.35).
@export_range(0.0, 1.0) var 세기: float = 0.85:
	set(v): 세기 = v; queue_redraw()
## 빛 안을 떠다니는 먼지 티끌 수. 0 이면 안 그린다.
@export_range(0, 80) var 먼지: int = 26
## 빛이 아주 느리게 흔들리는 폭(px). 0 이면 고정.
@export_range(0.0, 40.0) var 흔들림: float = 7.0
## 구멍 테두리(지붕이 뚫린 자리)를 그릴지. 창문에 붙일 때는 창틀이 있으니 끈다.
@export var 구멍_그리기: bool = true
## ★[2026-08-19] 은은한 안개빛 모드 (도형님 요청 "구름/안개에 가려져 은은하게 들어오는 빛").
##   끄면(기본) 예전처럼 광원 입구에 또렷한 심지·밝은 원반이 생겨 **가까운 전등**처럼 보인다.
##   켜면: ① 광원 쪽(시작)은 거의 안 보이게 죽이고 ② 중간에서 가장 밝았다가
##         ③ 바닥에 닿을수록 다시 옅어지는 **세로 그라데이션**으로 그린다.
##   → "먼 하늘에서 구름을 통과해 스며 내려오는 빛" 의 인상이 난다. 연출 모드에서만 쓴다.
@export var 부드러운연출: bool = false:
	set(v): 부드러운연출 = v; queue_redraw()

# ── 내부 상태 ───────────────────────────────────────────────────────────────
var _바디: StaticBody2D = null        ## 발판 모드에서만 켜지는 단단한 몸
var _영역: Area2D = null              ## 경계 모드의 통과되는 판정
var _t: float = 0.0
var _표시색: Color = Color(0.93, 0.94, 0.98)   ## 지금 화면에 보이는 색(물드는 중일 수 있다)
var _목표색: Color = Color(0.93, 0.94, 0.98)
var _물듦: float = 1.0                ## 0 → 1 로 흐르며 _표시색 이 _목표색 으로 간다

# ── 경계 전용 상태 ──────────────────────────────────────────────────────────
var _플레이어: Node2D = null
var _물듦_진행: float = 0.0           ## 플레이어 몸이 이 색으로 얼마나 찼나 (0~1)
var _차오름: Node2D = null            ## 플레이어 위에 그리는 오버레이 (아래 내부 클래스)


## 플레이어 몸에 색이 차오르는 것을 그리는 오버레이.
##
## ▣ 왜 플레이어가 아니라 별도 노드가 그리나
##   이 프로젝트에는 **`player.gd` 무수정 원칙**이 있다(여러 시스템이 같은 파일을 공유한다).
##   그래서 플레이어를 건드리지 않고, 플레이어 **위에 겹쳐 그리는** 노드를 따로 둔다.
##   z_index 를 높게 잡아 플레이어보다 앞에 나온다.
class 차오름오버레이 extends Node2D:
	var 대상: Node2D = null
	var 진행: float = 0.0
	var 색: Color = Color.WHITE
	var 크기: Vector2 = Vector2(44, 97)

	func _process(_d: float) -> void:
		if 대상 == null or not is_instance_valid(대상):
			visible = false
			return
		visible = 진행 > 0.01
		global_position = 대상.global_position
		queue_redraw()

	func _draw() -> void:
		if 진행 <= 0.01:
			return
		# 아래에서 위로 차오른다. 물이 차오르는 그림 — "채워진다" 가 한눈에 읽힌다.
		var 반 := 크기 * 0.5
		var 높이 := 크기.y * clampf(진행, 0.0, 1.0)
		draw_rect(Rect2(-반.x, 반.y - 높이, 크기.x, 높이), Color(색.r, 색.g, 색.b, 0.72), true)
		# 수면 — 차오르는 경계선이 있어야 "차는 중" 으로 보인다(가만히 있는 색면은 안 그렇다)
		var 수면y := 반.y - 높이
		draw_line(Vector2(-반.x, 수면y), Vector2(반.x, 수면y),
			Color(색.r, 색.g, 색.b, 0.95), 3.0)


# ============================================================================
# 준비
# ============================================================================
func _ready() -> void:
	_목표색 = _색을_화면색으로(색)
	_표시색 = _목표색
	_재구성()
	set_process(true)
	if Engine.is_editor_hint():
		return
	add_to_group("빛기둥")
	_그룹_맞추기()
	set_physics_process(true)


## 경계 모드일 때만 그룹 `빛경계` 에 들어 있게 맞춘다. **모드가 바뀔 때마다** 부른다.
##
## ⚠[2026-08-18 · 실제로 터진 버그] `_ready()` 에서 한 번만 등록하면 안 된다.
##   `창문커튼.gd` 는 자식 빛을 `빛기둥_S.new()` → `add_child()` → **그 다음에** 모드를 준다.
##   `_ready()` 는 `add_child()` 순간에 이미 돌기 때문에, 그때의 모드는 기본값(경계)이다.
##   → 발판으로 쓰려던 창문 빛이 `빛경계` 에 남아, 스테이지의 경계 빛이 3 개가 아니라
##     4 개로 잡혔다(test_빛창문 [H] 가 잡아낸 것이 이것이다).
##   눈으로는 절대 안 보인다 — 발판 모드 빛은 `위험한가()` 가 항상 false 라 조용하다.
##   그래도 잘못된 상태이므로, 모드가 바뀌면 그룹도 따라오게 한다.
func _그룹_맞추기() -> void:
	if Engine.is_editor_hint() or not is_inside_tree():
		return
	var 경계 := 모드 == 모드_.경계
	if 경계 and not is_in_group("빛경계"):
		add_to_group("빛경계")
	elif not 경계 and is_in_group("빛경계"):
		remove_from_group("빛경계")


## 빛줄기의 사다리꼴 점들(로컬 좌표, 회전 전).
## 시계 방향으로 만든다 — `지형공통.벽_점들` 주석의 감김 방향 규약과 같다.
## (콜리전 폴리곤이 볼록 분해될 때 감김이 뒤집혀 있으면 실패하는 함정이 있다)
func 점들() -> PackedVector2Array:
	var 방향 := Vector2.RIGHT.rotated(deg_to_rad(각도))
	var 수직 := 방향.orthogonal()
	var 끝 := 방향 * 길이
	return PackedVector2Array([
		수직 * 시작폭 * 0.5,
		끝 + 수직 * 끝폭 * 0.5,
		끝 - 수직 * 끝폭 * 0.5,
		-수직 * 시작폭 * 0.5,
	])


## 판정 노드를 모드에 맞게 다시 만든다. **여러 번 불러도 결과가 같다**(멱등).
## ⚠ 여기서 만드는 자식에게는 owner 를 주지 않는다 — 주면 씬 파일에 한 벌 더 저장되고
##   다음 로드 때 두 벌이 되어 씬 교체 시 세그폴트가 난다(§5-1 지뢰).
func _재구성() -> void:
	if not is_inside_tree():
		return
	var poly := 점들()

	# ── 단단한 몸 (발판 모드) ──
	if _바디 == null:
		_바디 = get_node_or_null("굳은빛") as StaticBody2D
	if _바디 == null:
		_바디 = StaticBody2D.new()
		_바디.name = "굳은빛"
		add_child(_바디)
	var cp := _바디.get_node_or_null("모양") as CollisionPolygon2D
	if cp == null:
		cp = CollisionPolygon2D.new()
		cp.name = "모양"
		cp.visible = false          # 오목 기즈모가 에디터 뷰를 무지개로 만든다
		_바디.add_child(cp)
	cp.polygon = poly
	# 색이 안 든 빛은 굳지 않는다 → 통과된다. 이게 퍼즐의 핵심이다.
	_바디.collision_layer = 1 if (모드 == 모드_.발판 and _굳나()) else 0
	_바디.collision_mask = 0

	# ── 통과되는 판정 (경계 모드) ──
	if _영역 == null:
		_영역 = get_node_or_null("빛판정") as Area2D
	if _영역 == null:
		_영역 = Area2D.new()
		_영역.name = "빛판정"
		add_child(_영역)
	var ap := _영역.get_node_or_null("모양") as CollisionPolygon2D
	if ap == null:
		ap = CollisionPolygon2D.new()
		ap.name = "모양"
		ap.visible = false
		_영역.add_child(ap)
	ap.polygon = poly
	_영역.collision_layer = 0        # 아무도 이걸 감지할 필요가 없다
	_영역.collision_mask = 1         # 플레이어(레이어 1)만 본다
	_영역.monitoring = 모드 == 모드_.경계 and not Engine.is_editor_hint()

	# 모드가 바뀌면 그룹도 따라와야 한다 (위 `_그룹_맞추기` 의 ⚠ 주석 참고).
	_그룹_맞추기()


## 이 색이면 빛이 굳는가. 무색·회색은 안 굳는다(= 통과 · 안전).
func _굳나() -> bool:
	return 색 == ColorDefs.BLACK or 색 == ColorDefs.WHITE


# ============================================================================
# 색
# ============================================================================
## 색 코드 → 화면에 그릴 색.
## ★검정 빛을 진짜 검정으로 그리면 **어두운 실내에서 아예 안 보인다**(빛인지 그림자인지
##   구분이 안 된다). 그래서 검정 빛은 "짙은 남회색 + 밝은 테두리" 로 그린다.
##   흰 빛은 그냥 밝게. 회색은 채도를 완전히 죽여 "죽은 빛"으로 읽히게 한다.
static func _색을_화면색으로(코드: int) -> Color:
	match 코드:
		ColorDefs.BLACK: return Color(0.16, 0.16, 0.20)
		ColorDefs.WHITE: return Color(0.97, 0.97, 0.94)
		ColorDefs.GRAY:  return Color(0.48, 0.48, 0.49)
		_:               return Color(0.93, 0.94, 0.98)   # 무색 = 순수한 햇빛


func _색_반영() -> void:
	_목표색 = _색을_화면색으로(색)
	if not is_inside_tree():
		_표시색 = _목표색
		return
	# 즉시 바꾸지 않고 `_물듦` 을 0 으로 되돌린다 → `_process` 가 천천히 물들인다.
	_물듦 = 0.0 if 물드는시간 > 0.0 else 1.0
	if _물듦 >= 1.0:
		_표시색 = _목표색
	_재구성()            # 굳음/풀림이 이 순간 바뀐다
	queue_redraw()


## 창문커튼 등 바깥에서 색을 밀어 넣을 때 쓴다.
func 색_지정(새색: int) -> void:
	색 = 새색


# ============================================================================
# 판정
# ============================================================================
## ★`월드.gd _지대_적용()` 이 그룹 `빛경계` 를 훑으며 물어본다.
## 반환: 이 경계가 강제하는 색. **강제하지 않으면 −1.**
##
## ⚠ 예전 이름은 `위험한가()` 였고 즉사를 뜻했다. 경계는 죽이지 않는다(§머리말).
##   이름을 바꾼 이유: 남은 호출부가 있으면 **파싱 단계에서 바로 터지게** 하려고.
##   조용히 false 를 돌려주는 함수로 두면 "경계가 아무 일도 안 한다" 를 아무도 못 찾는다.
func 강제색(플레이어: Node) -> int:
	if 모드 != 모드_.경계 or _영역 == null:
		return -1
	if not _굳나():                      # 무색·회색 빛은 아무 색도 강제하지 않는다
		return -1
	if not _영역.get_overlapping_bodies().has(플레이어):
		return -1
	# 물듦이 끝나야 실제로 바뀐다 — 발을 들이자마자 딸깍 바뀌면 되돌릴 틈이 없다.
	# ⚠ `_물듦`(빛 자체의 색이 물드는 연출) 이 아니라 `_물듦_진행`(플레이어 몸이 차오르는 정도) 이다.
	#   이름이 비슷해서 한 번 헷갈렸다 — 둘은 완전히 다른 값이다.
	if _물듦_진행 < 1.0:
		return -1
	return 색


## 지금 이 경계가 플레이어를 얼마나 물들였나 (0~1). HUD·연출·검사가 읽는다.
func 물듦_진행도() -> float:
	return _물듦_진행


## 발판 모드에서 `월드.gd` 의 지형 겹침 판정이 부른다(지형과 같은 계약).
func 현재색() -> int:
	return 색


func 반대색인가(플레이어색: int) -> bool:
	if not _굳나():
		return false
	return 플레이어색 != 색


# ============================================================================
# 매 프레임
# ============================================================================
func _process(delta: float) -> void:
	_t += delta
	_경계_물듦_갱신(delta)
	if _물듦 < 1.0:
		_물듦 = minf(_물듦 + delta / maxf(물드는시간, 0.001), 1.0)
		# ease-out — 처음에 확 물들고 끝에서 잦아든다. "스며든다" 의 곡선.
		_표시색 = _표시색.lerp(_목표색, 1.0 - pow(1.0 - _물듦, 3.0))
		queue_redraw()
	elif 먼지 > 0 or 흔들림 > 0.0:
		queue_redraw()


## ★경계 물듦 — 가까울수록 몸이 그 색으로 차오른다.
##
## ▣ 진행도를 어떻게 정하나
##   빛 도형까지의 **최단 거리** d 를 재서
##       d ≥ 물듦_반경 → 0     (아직 아무 일 없음)
##       d = 0        → 1     (빛 안. 여기서 색이 실제로 바뀐다)
##   가운데는 부드럽게 잇는다. 거리로 재는 이유: 위/아래/옆 어느 쪽으로 다가가든
##   똑같이 반응해야 "빛에 닿으면 물든다" 는 규칙이 하나로 읽힌다.
##
## ▣ 이미 그 색이면 아무것도 안 한다
##   흰 경계에 흰 플레이어가 들어가는 건 아무 일도 아니다. 그때도 차오름을 그리면
##   **경고가 늘 켜져 있는 꼴**이 되어 신호가 죽는다.
func _경계_물듦_갱신(delta: float) -> void:
	if Engine.is_editor_hint() or 모드 != 모드_.경계 or not _굳나():
		_물듦_진행 = 0.0
		_오버레이_끄기()
		return
	if _플레이어 == null or not is_instance_valid(_플레이어):
		_플레이어 = _내_스테이지의_플레이어()
	if _플레이어 == null:
		return

	# 이미 같은 색이면 물들 것이 없다
	if int(_플레이어.get("player_color")) == 색:
		_물듦_진행 = maxf(_물듦_진행 - delta * 4.0, 0.0)
		_오버레이_갱신()
		return

	var d := _빛까지_거리(_플레이어.global_position)
	var 목표 := 0.0
	if d <= 0.0:
		목표 = 1.0
	elif 물듦_반경 > 0.0:
		목표 = clampf(1.0 - d / 물듦_반경, 0.0, 1.0)
		목표 = 목표 * 목표 * 0.85          # 바깥에서는 천천히, 빛에 붙으면 급하게 (제곱 곡선)
	# 들어갈 때는 `물듦_시간` 에 맞춰, 나올 때는 그보다 빠르게 빠진다.
	# (되돌리는 건 쉬워야 한다 — 물러났는데 계속 차오르면 억울하다)
	var 속도 := (1.0 / maxf(물듦_시간, 0.001)) if 목표 > _물듦_진행 else 3.5
	_물듦_진행 = move_toward(_물듦_진행, 목표, delta * 속도)
	_오버레이_갱신()


## ★**내가 속한 스테이지의** 플레이어를 찾는다.
##
## ⚠[2026-08-20] 예전에는 그룹 `player` 의 **첫 번째**를 그냥 집었다.
##   씬을 갈아 끼우는 순간(전환 연출 중·검사 중)에는 **낡은 씬과 새 씬이 잠깐 공존**하고,
##   그때 첫 번째가 **이미 버려진 씬의 플레이어**일 수 있다.
##   그러면 경계는 엉뚱한 대상을 붙잡고 물듦을 계산해 **진짜 플레이어는 영원히 안 물든다** —
##   게임에서는 "가끔 경계가 안 먹는다" 로 나타나고, 원인을 찾기가 매우 어렵다.
##   → 내 조상 중 스테이지 루트(`_사망_판정` 을 가진 노드)를 찾아 **그 아래의** 플레이어만 쓴다.
func _내_스테이지의_플레이어() -> Node2D:
	var 뿌리: Node = self
	while 뿌리 != null and not 뿌리.has_method("_사망_판정"):
		뿌리 = 뿌리.get_parent()
	for n in get_tree().get_nodes_in_group("player"):
		var p := n as Node2D
		if p == null or not is_instance_valid(p):
			continue
		if 뿌리 == null or 뿌리.is_ancestor_of(p):
			return p
	return null


## 빛 도형 안이면 0, 밖이면 가장 가까운 변까지의 거리(px).
func _빛까지_거리(월드점: Vector2) -> float:
	var p := to_local(월드점)
	var poly := 점들()
	if Geometry2D.is_point_in_polygon(p, poly):
		return 0.0
	var 최소 := INF
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		최소 = minf(최소, p.distance_to(Geometry2D.get_closest_point_to_segment(p, a, b)))
	return 최소


func _오버레이_갱신() -> void:
	if _물듦_진행 <= 0.01:
		_오버레이_끄기()
		return
	if _차오름 == null or not is_instance_valid(_차오름):
		_차오름 = 차오름오버레이.new()
		_차오름.name = "차오름"
		_차오름.z_index = 40                 # 플레이어보다 앞
		_차오름.z_as_relative = false
		_차오름.top_level = true             # 부모(빛기둥) 변형을 안 따른다 — 월드 좌표로 그린다
		add_child(_차오름)                   # ⚠ owner 를 주지 않는다 (씬에 저장되면 두 벌이 된다)
	_차오름.대상 = _플레이어
	_차오름.진행 = _물듦_진행
	_차오름.색 = _색을_화면색으로(색)


func _오버레이_끄기() -> void:
	if _차오름 and is_instance_valid(_차오름):
		_차오름.진행 = 0.0
		_차오름.visible = false


# ============================================================================
# 그림
# ============================================================================
func _draw() -> void:
	# 디자이너 그림 슬롯이 채워져 있으면 코드 그리기는 쉰다(프로젝트 규약).
	if 아트슬롯.그림_있나(self):
		return

	var 방향 := Vector2.RIGHT.rotated(deg_to_rad(각도))
	var 수직 := 방향.orthogonal()
	# 아주 느린 흔들림 — 구름이 지나가는 느낌. 주파수를 둘 겹쳐 규칙성을 없앤다.
	var 흔 := (sin(_t * 0.37) * 0.7 + sin(_t * 0.19 + 1.7) * 0.3) * 흔들림
	var 끝중심 := 방향 * 길이 + 수직 * 흔

	var 굳음 := _굳나()

	# ── ★은은한 안개빛 (도형님 요청) ──
	#   굳지 않은 연출 빛에서만 켠다. 광원 입구의 또렷한 심지·밝은 원반을 통째로 빼고,
	#   세로로 옅게 번지는 사다리꼴 그라데이션만 남긴다:
	#     시작(하늘) ≈ 0  →  중간이 정점  →  바닥은 다시 옅게.
	#   → "먼 하늘에서 구름을 통과해 스며 내려오는 빛" 이 된다("가까운 전등" 느낌 제거).
	if 부드러운연출 and not 굳음:
		var 조각 := 14                          # 세로로 몇 겹 쌓아 그라데이션을 만드는가
		var 최대알파 := 0.14 * 세기
		for i in 조각:
			var t0 := float(i) / float(조각)
			var t1 := float(i + 1) / float(조각)
			var w0 := lerpf(시작폭, 끝폭, t0)
			var w1 := lerpf(시작폭, 끝폭, t1)
			var c0 := 방향 * (길이 * t0) + 수직 * (흔 * t0)   # 흔들림도 아래로 갈수록 커진다
			var c1 := 방향 * (길이 * t1) + 수직 * (흔 * t1)
			# 밝기 곡선: 0~0.30 에서 서서히 차오르고, 0.35 이후 완만히(최대 65%) 잦아든다
			var 밝기 := smoothstep(0.0, 0.30, t0) * (1.0 - 0.65 * smoothstep(0.35, 1.0, t0))
			draw_colored_polygon(PackedVector2Array([
				c0 + 수직 * w0 * 0.5,
				c1 + 수직 * w1 * 0.5,
				c1 - 수직 * w1 * 0.5,
				c0 - 수직 * w0 * 0.5,
			]), Color(_표시색.r, _표시색.g, _표시색.b, 최대알파 * 밝기))
		_먼지_그리기(방향, 수직, 흔)          # 안개 속 티끌은 살린다 — 빛에 "부피"를 준다
		return

	# 굳은 빛은 또렷하게(딛고 설 수 있다는 신호), 안 굳은 빛은 흐릿하게.
	var 겹수 := 5 if not 굳음 else 4
	var 기본알파 := 0.085 * 세기

	# ── ① 바깥 번짐 → 안쪽 심지 순으로 사다리꼴을 포갠다 ──
	for i in range(겹수, 0, -1):
		var t := float(i) / float(겹수)         # 1 = 가장 바깥
		var s0 := 시작폭 * (0.55 + t * 0.75)
		var s1 := 끝폭 * (0.55 + t * 0.85)
		var a := 기본알파 * (1.05 - t * 0.55)
		draw_colored_polygon(PackedVector2Array([
			수직 * s0 * 0.5,
			끝중심 + 수직 * s1 * 0.5,
			끝중심 - 수직 * s1 * 0.5,
			-수직 * s0 * 0.5,
		]), Color(_표시색.r, _표시색.g, _표시색.b, a))

	# ── ② 심지 ── 굳었을 때만 진하게. 이 진하기가 "밟을 수 있다"의 유일한 신호다.
	var 심지알파 := (0.46 if 굳음 else 0.20) * 세기
	draw_colored_polygon(PackedVector2Array([
		수직 * 시작폭 * 0.5,
		끝중심 + 수직 * 끝폭 * 0.5,
		끝중심 - 수직 * 끝폭 * 0.5,
		-수직 * 시작폭 * 0.5,
	]), Color(_표시색.r, _표시색.g, _표시색.b, 심지알파))

	# ── ③ 테두리 ── 검정 빛이 어두운 실내에 묻히지 않게 **반드시** 필요하다.
	#   (색레이저.gd 가 같은 이유로 대비색 테두리를 그린다 — 같은 규칙을 지킨다)
	if 굳음:
		var 테 := Color(0.90, 0.92, 0.97) if 색 == ColorDefs.BLACK else Color(0.10, 0.10, 0.12)
		draw_line(수직 * 시작폭 * 0.5, 끝중심 + 수직 * 끝폭 * 0.5,
			Color(테.r, 테.g, 테.b, 0.55 * 세기), 2.0)
		draw_line(-수직 * 시작폭 * 0.5, 끝중심 - 수직 * 끝폭 * 0.5,
			Color(테.r, 테.g, 테.b, 0.55 * 세기), 2.0)

	# ── ④ 먼지 티끌 ──
	_먼지_그리기(방향, 수직, 흔)

	# ── ⑤ 구멍 ── 빛이 나오는 자리. 지붕이 뚫렸다는 것 자체가 배경 서사다.
	if 구멍_그리기:
		_구멍(방향, 수직)


## 빛 "안"에서만 떠다니는 먼지 티끌. 기본 그리기와 은은한 안개빛이 **같이** 쓴다.
##   난수를 안 쓰고 i 로 결정한다 — 매 프레임 같은 티끌이 같은 궤적으로 흐른다.
func _먼지_그리기(방향: Vector2, 수직: Vector2, 흔: float) -> void:
	for i in 먼지:
		var f := float(i)
		var 진행 := fmod(_t * (0.05 + fmod(f * 0.0137, 0.05)) + f * 0.0771, 1.0)
		var 가로 := sin(f * 2.399 + _t * 0.31) * 0.42
		var 폭 := lerpf(시작폭, 끝폭, 진행)
		var p := 방향 * (길이 * 진행) + 수직 * (가로 * 폭 + 흔 * 진행)
		# 가운데가 밝고 끝에서 사라진다
		var a := 세기 * 0.5 * sin(진행 * PI) * (0.5 + 0.5 * sin(f * 5.1 + _t * 1.7))
		draw_circle(p, 1.4 + fmod(f * 0.31, 1.1), Color(_표시색.r, _표시색.g, _표시색.b, a))


## 지붕에 뚫린 구멍 — 부서진 판자 실루엣.
func _구멍(방향: Vector2, 수직: Vector2) -> void:
	var 반 := 시작폭 * 0.5
	# 구멍 자체는 바깥(하늘)이 보이는 자리라 밝게 뚫려 있다
	draw_colored_polygon(PackedVector2Array([
		수직 * 반 - 방향 * 6.0,
		수직 * 반 * 0.82 + 방향 * 10.0,
		-수직 * 반 * 0.9 + 방향 * 8.0,
		-수직 * 반 - 방향 * 6.0,
	]), Color(_표시색.r, _표시색.g, _표시색.b, minf(0.55 + 0.4 * 세기, 0.95)))
	# 깨진 판자 — 구멍 양쪽에서 안쪽으로 삐죽 튀어나온 조각들
	var 조각 := Color(0.05, 0.05, 0.06, 0.92)
	for s in [1.0, -1.0]:
		draw_colored_polygon(PackedVector2Array([
			수직 * 반 * s,
			수직 * 반 * s * 0.42 + 방향 * 15.0,
			수직 * 반 * s * 0.86 + 방향 * 3.0,
			수직 * 반 * s * 1.16 - 방향 * 4.0,
		]), 조각)
