extends RefCounted
## ============================================================================
## [2026-10-15 Claude] 화면 준비 — 스테이지를 갈아 끼우고 **아직 화면이 까만** 동안 할 일을 한 곳에서 (프레임 방어)
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님: "60 프레임 밑으로는 떨어지지 않게")
##   ① 새 스테이지에 처음 들어가면 약 1 초 동안 그림 준비(처음 그릴 때 드는 비용)로 프레임이 튄다.
##      2-3 첫 3 초 180 프레임 중 16.7 ms 초과: 대기 없음 29·30 → 일반 대기 120 프레임 5·3 → **일시정지 대기 120 프레임 1·0**.
##      같은 실행에서 다시 들어가면 처음부터 0 (준비가 한 번이면 된다). → 처음 들어갈 때만, 게임을 멈춘 채 암전 뒤에서 그린다.
##      (도형님 선택: "첫 방문만 암전 연장 · 최대 1 초")
##   ③ 일시정지를 풀고(또는 재방문이면 씬을 넣은 직후) 처음 2~3 프레임은 각자 첫 처리·물리로 75~110 ms 무겁다.
##      재방문 2-3 은 그중 한 프레임(73 ms)이 밝아지는 첫 프레임에 걸렸다(10-15 측정 · tools/측정_전환_첫방문.gd).
##      → 까만 채로 **연속 3 프레임이 16.7 ms 안에 들 때까지**(최대 0.5 초) 게임을 돌리고 나서 돌아간다.
##   ② 퍼즐보드 사진(스테이지_스냅)은 화면을 그래픽 칩에서 읽어 와야 해서 한 번에 약 17 ms 멈춘다(이 PC · OpenGL).
##      플레이 중에 찍으면 그 프레임이 24 ms → 60 아래. → 출구에서 그려 두고 **까만 동안 읽는다**.
##      (도형님 선택: "출구 암전 중에 찍기" — 사진이 '플레이 중 무작위 장면' 에서 '출구에 도착한 장면' 으로 바뀌었다)
##
## ▣ 쓰는 곳 — 장면전환.gd · 전경전환.gd 의 "새 씬을 넣었고 아직 까만" 자리에서 한 줄:
##   await 화면준비.암전_중(get_tree(), 씬경로)
##
## ▣ 시험(헤드리스)에서는 아무것도 안 한다 — 그리기가 없어 기다릴 이유도, 찍을 화면도 없다.
##   전후비교 화면 촬영·프레임 측정 도구는 전환을 거치지 않으므로 영향이 없다.
## ============================================================================
class_name 화면준비

const 스테이지_스냅 := preload("res://scripts/진행/스테이지_스냅.gd")

## 처음 들어가는 스테이지를 암전 뒤에서 그리는 최대 프레임 수와 최대 시간(둘 중 먼저 닿는 쪽에서 멈춘다).
##   측정: 2-1 은 60 프레임, 2-3 은 120 프레임을 그리면 그 뒤 튐이 0 이었다.
const 목표_프레임 := 120
const 최대_초 := 1.0
## ③ 가라앉기 — 연속 몇 프레임이 60 FPS 안에 들면 "가라앉았다" 로 보나 · 최대 몇 초까지 기다리나
const 가라앉음_연속 := 3
const 가라앉음_최대_초 := 0.5

## 이번 실행에서 이미 준비를 마친 스테이지(씬 경로) — 다시 들어가면 기다리지 않는다.
static var _준비된_씬: Dictionary = {}
## 지금 암전 대기 중인가 — ESC 메뉴가 이때는 열리지 않는다(대기가 끝나며 일시정지를 풀 때 메뉴와 엉키지 않게).
static var 대기중 := false


## 새 씬을 넣고 아직 화면이 까만 동안 부른다. 끝나면 돌아온다(그 뒤에 밝아지게 하면 된다).
static func 암전_중(트리: SceneTree, 씬경로: String) -> void:
	if DisplayServer.get_name() == "headless":
		return
	대기중 = true
	# ② 출구에서 그려 둔 퍼즐보드 사진을 지금 읽어 저장한다(읽는 동안의 멈춤이 까만 화면 뒤로 숨는다)
	await 스테이지_스냅.미뤄둔_사진_저장(트리)
	# ① 이번 실행에서 처음 들어가는 스테이지면 멈춘 채 그려 준비를 끝낸다
	if not 씬경로.is_empty() and not _준비된_씬.has(씬경로):
		_준비된_씬[씬경로] = true
		await _멈춘_채_그리기(트리)
	# ③ 무거운 첫 처리 프레임들이 까만 동안 지나가게 한다(재방문도)
	await _가라앉을_때까지(트리)
	대기중 = false


static func _멈춘_채_그리기(트리: SceneTree) -> void:
	var 원래 := 트리.paused
	트리.paused = true           # 몹·장치·기록 타이머는 멈추고(게임 시간 0) 그리기만 계속된다
	var 끝 := Time.get_ticks_msec() + int(최대_초 * 1000.0)
	var n := 0
	while n < 목표_프레임 and Time.get_ticks_msec() < 끝:
		await 트리.process_frame
		n += 1
	트리.paused = 원래


static func _가라앉을_때까지(트리: SceneTree) -> void:
	var 끝 := Time.get_ticks_msec() + int(가라앉음_최대_초 * 1000.0)
	var 연속 := 0
	var 전 := Time.get_ticks_usec()
	while 연속 < 가라앉음_연속 and Time.get_ticks_msec() < 끝:
		await 트리.process_frame
		var 지금 := Time.get_ticks_usec()
		연속 = 연속 + 1 if 지금 - 전 < 16667 else 0
		전 = 지금
