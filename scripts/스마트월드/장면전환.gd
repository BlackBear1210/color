extends CanvasLayer
## ============================================================================
## [2026-08-06 신규 · 2026-08-08 챕터 전환 확장] 장면 전환
## ----------------------------------------------------------------------------
## ▣ 왜 새로 만들었나 (기존 stage_transition.gd 를 안 쓴 이유)
##   기존 전환은 **잉크 와이프**다. 화면을 물감이 왼쪽에서 덮고 오른쪽으로 빠진다.
##   그건 "장면이 바뀌었다"는 게임적 신호라서, 도형님이 싫다고 한 **포탈 감각**과 같다.
##   우리가 원하는 건 **공간이 그냥 이어져 있는** 느낌이다.
##     → 플레이어는 어두운 통로 안으로 걸어 들어간다
##     → 통로 안이라 자연스럽게 화면이 **까매진다**  (전환이 아니라 '조명')
##     → 다음 스테이지의 같은 통로 안에서 시작해 **서서히 밝아지며** 밖이 보인다
##   화면 효과는 똑같이 검정 페이드지만, **통로 안에서만 일어나기 때문에**
##   플레이어에게는 전환이 아니라 "터널을 통과했다"로 읽힌다. 이게 핵심이다.
##
## ▣ [2026-08-08 추가] 스테이지 전환 vs **챕터 전환**은 달라야 한다
##   도형님 기획:
##     "화면이 암전된 후 다음 스테이지가 짜잔 하고 밝아지면, BGM 의 톤이 바뀌며
##      새로운 물리 환경이나 위험한 함정이 눈앞에 나타납니다.
##      '이제 겨우 하나 깼는데, 다음엔 또 얼마나 매운 퍼즐이 기다리고 있을까?' 하는
##      설레는 압박감과 도전 욕구가 동시에 찾아오는 전환 느낌이 특징입니다."
##
##   같은 챕터 안(1→2)에서 매번 거창하게 연출하면 그 감각이 닳는다.
##   → **챕터가 바뀔 때만** 다르게 한다:
##
##   | 구간        | 스테이지 전환 | 챕터 전환 | 왜 |
##   |---|---|---|---|
##   | 페이드 색   | 검정          | **흰색**  | 물감 게임이다. 흰색은 "다 지워졌다"로 읽힌다 |
##   | 암전        | 0.85초        | 1.30초    | 천천히 지워져야 "구간이 끝났다"가 된다 |
##   | 정적(무음)  | 0.22초        | **0.80초** | ★이 침묵이 압박감의 정체다. 소리가 사라진 뒤 |
##   |             |               |           |   새 톤이 들어오면 "다른 세계"로 읽힌다 |
##   | 점등        | 1.35초        | 2.10초    | 새 지역을 눈으로 훑을 시간을 준다 |
##   | BGM         | 유지          | **톤 전환** | 챕터 앰비언스가 서서히 갈린다(음향.gd) |
##
## ▣ 카메라 (도형님 요청: "카메라는 고정되거나 주인공을 따라 움직이다가
##                        자연스럽게 화면이 블랙으로 페이드 아웃")
##   전환 중에도 카메라는 **플레이어를 계속 따라간다**(고정하지 않는다).
##   대신 두 가지를 건다:
##     · 들어갈 때 : 아주 살짝 **줌 인** → 통로로 빨려 들어가는 감각
##     · 나올 때   : 살짝 **줌 아웃 된 상태로 시작해 제자리로** → "짜잔" 하고 펼쳐진다
##   카메라를 멈추면 플레이어만 혼자 걸어가 화면 밖으로 나가버린다(실제로 그랬다).
##
## ▣ 다음 씬에게 넘기는 정보 (이월)
##   씬이 바뀌면 변수는 다 사라지므로 **static var** 에 담아 넘긴다.
##     · 진입점    : 다음 씬의 어느 통로(입구)에서 걸어 나올지
##     · 왔던_씬   : 되돌아갈 때 쓸 경로
##     · 챕터전환  : 새 씬이 "짜잔" 연출을 크게 할지 판단하는 값
##
## ▣ 쓰는 법 (통로가 부른다)
##   장면전환.통로로_이동(self, 챕터.씬경로(4), "입구통로")
## ============================================================================
class_name 장면전환

# ── 스테이지 전환 (같은 챕터 안) ────────────────────────────────────────────
const 암전시간: float = 0.85
const 점등시간: float = 1.35
const 암흑유지: float = 0.22

# ── 챕터 전환 ───────────────────────────────────────────────────────────────
## 왜 더 긴가 — 위 표의 "왜" 열 참고.
const 챕터_암전시간: float = 1.30
const 챕터_점등시간: float = 2.10
## ★압박감의 정체. 여기서 소리도 같이 죽인다.
const 챕터_암흑유지: float = 0.80

## 챕터 전환에 쓰는 색. 검정이 아니라 흰색인 이유:
## 이 게임의 규칙이 "물감으로 칠하고 지운다" 라서, 흰색으로 덮이는 그림은
## **"이 구역이 통째로 지워졌다"** 로 읽힌다. 챕터 2 의 주제(색이 지워지는 물)와도 맞는다.
const 챕터_페이드색 := Color(0.94, 0.94, 0.92)

## ★★[2026-08-17 버그 수정] Godot 4 의 `Camera2D.zoom` 은 **클수록 확대(줌 인)** 다.
##   (Godot 3 과 반대다. 이 프로젝트도 `카메라_구역.gd` 에 "작을수록 넓게 보인다" 고 적혀 있다)
##
##   그런데 이 두 상수는 **주석과 정반대로 동작하고 있었다.**
##     · 들어갈때_줌 = 0.94  → 통로에 들어갈 때 화면이 **넓어졌다**(줌 아웃).
##       주석에는 "줌 인 → 통로로 빨려 들어가는 감각" 이라고 적혀 있었다.
##     · `test_챕터전환.gd` 도 "들어갈 때는 줌 인(<1)" 이라고 **틀린 기준으로** 통과시켰다.
##       테스트가 있어도 못 잡은 이유가 이것이다 — 테스트가 같은 오해를 공유했다.
##   도형님 요구사항이 "굴뚝(통로) 진입 시 부드럽게 줌인되며 시선을 집중" 이므로
##   1 보다 큰 값이 맞다.
##
## 통로로 걸어 들어갈 때 이만큼 조여든다(확대). 1 = 그대로.
## 1.07 은 화면 폭 2341px → 2188px. 눈에 띄지만 "화면이 튀었다" 고는 안 느껴지는 폭이다.
const 들어갈때_줌: float = 1.07
## 다음 스테이지를 이만큼 조인 상태로 시작해 **제자리로 풀리면서** 전경이 펼쳐진다.
## (조여 있다 풀리는 것이 "짜잔" 이다. 처음부터 넓으면 보여줄 변화가 없다)
const 나올때_줌: float = 1.14

## 다음 씬으로 넘기는 정보. 씬 교체를 살아남아야 하므로 static.
static var _이월: Dictionary = {}
## 전환이 이미 진행 중인지 — 통로를 두 번 밟아 씬이 두 번 바뀌는 사고를 막는다.
static var _진행중: bool = false

var _판: ColorRect
var _챕터전환: bool = false


# ── 바깥에서 쓰는 API ───────────────────────────────────────────────────────

## 통로를 지나 다음 씬으로. 이미 전환 중이면 무시한다.
##   from        : 아무 노드나 (트리 접근용)
##   씬경로      : 다음 스테이지 .tscn
##   진입점_이름 : 다음 씬에서 걸어 나올 통로(입구) 노드 이름. 비우면 씬 기본 시작 위치.
##   왔던_씬     : 되돌아가기용 경로. **챕터가 바뀌는지 판단하는 데도 쓴다.**
static func 통로로_이동(from: Node, 씬경로: String, 진입점_이름: String = "",
		왔던_씬: String = "") -> void:
	if _진행중:
		return
	if not ResourceLoader.exists(씬경로):
		push_error("장면전환: 다음 씬이 없다 → %s" % 씬경로)
		return
	_진행중 = true

	# ★챕터가 바뀌는지는 **씬 파일 이름**에서 알아낸다.
	#   씬이 자기 챕터를 들고 있지 않아도 되므로, 새 스테이지를 추가할 때
	#   `챕터.gd` 의 표에 한 줄만 넣으면 연출이 저절로 맞는다.
	var 이전번호 := 챕터.경로에서_번호(왔던_씬)
	var 다음번호 := 챕터.경로에서_번호(씬경로)
	var 챕터바뀜 := 챕터.챕터_바뀌나(이전번호, 다음번호)

	_이월 = {
		"진입점": 진입점_이름,
		"왔던_씬": 왔던_씬,
		"챕터전환": 챕터바뀜,
		"다음번호": 다음번호,
	}

	var tr := 장면전환.new()
	tr._챕터전환 = 챕터바뀜
	# ★current_scene 이 아니라 root 에 붙여야 씬이 바뀌어도 살아남는다
	from.get_tree().root.add_child(tr)
	tr._진행(씬경로, 다음번호)


## 새 씬의 월드.gd 가 시작할 때 읽는다. 통로로 들어온 게 아니면 빈 사전.
static func 진입_정보() -> Dictionary:
	return _이월.duplicate()


## 읽고 나서 비운다. (다음에 F5 로 그냥 실행했을 때 옛 정보가 남아 있으면 안 된다)
static func 진입_소비() -> void:
	_이월 = {}


## 전환이 진행 중인가 — 월드.gd 가 "지금은 사망 판정을 멈춰야 한다" 를 알 때 쓴다.
static func 진행중인가() -> bool:
	return _진행중


# ── 내부 ────────────────────────────────────────────────────────────────────

func _init() -> void:
	# 일시정지 메뉴(100)보다 위. 전환 중에는 무엇도 이 위에 그려지면 안 된다.
	layer = 200
	# ★전환 도중 트리가 멈춰도 페이드는 계속돼야 한다 (ESC 메뉴와 겹쳤을 때 대비)
	process_mode = Node.PROCESS_MODE_ALWAYS
	_판 = ColorRect.new()
	_판.name = "암전판"
	_판.color = Color(0, 0, 0, 0)
	_판.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_판.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(_판)


func _진행(씬경로: String, 다음번호: int) -> void:
	var 바탕 := 챕터_페이드색 if _챕터전환 else Color(0, 0, 0)
	_판.color = Color(바탕.r, 바탕.g, 바탕.b, 0.0)

	var 암전 := 챕터_암전시간 if _챕터전환 else 암전시간
	var 정적 := 챕터_암흑유지 if _챕터전환 else 암흑유지
	var 점등 := 챕터_점등시간 if _챕터전환 else 점등시간

	var 음향 := 챕터음향.준비(self)

	# ── 1) 통로 안으로 — 어두워진다(챕터 전환이면 하얗게 지워진다) ──
	# EASE_IN 이라 처음엔 천천히, 안쪽으로 들어갈수록 빠르게 덮인다.
	# (터널 입구에서는 아직 밝고 깊이 들어갈수록 급격히 어두워지는 실제 감각)
	_카메라_줌(들어갈때_줌, 암전)
	var tw := create_tween()
	tw.tween_property(_판, "color:a", 1.0, 암전) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	# 챕터 전환일 때만 소리를 같이 죽인다 — 그래야 다음의 침묵이 의미를 갖는다.
	if _챕터전환 and 음향:
		var tw음 := create_tween()
		tw음.tween_method(func(v: float) -> void: 음향.음량비(v), 1.0, 0.0, 암전)
	await tw.finished

	# ── 2) 완전한 암흑(또는 백지) — 이 사이에 씬을 갈아끼운다 ──
	get_tree().change_scene_to_file(씬경로)
	# 새 씬의 _ready 와 첫 물리 프레임이 끝날 때까지 기다린다.
	# (덜 기다리면 아직 배치 안 된 플레이어가 한 프레임 보인다 — 실제로 겪음)
	await get_tree().process_frame
	await get_tree().physics_frame
	await get_tree().process_frame

	# ★새 챕터의 톤으로 갈아탄다. **침묵이 끝나기 전에** 시작해 두면
	#   화면이 밝아질 때 이미 새 톤이 깔려 있다 = "다른 세계에 도착했다".
	if 음향 and 다음번호 > 0:
		음향.챕터로(챕터.챕터번호(다음번호), not _챕터전환)

	if 정적 > 0.0:
		await get_tree().create_timer(정적, true, false, true).timeout

	# ── 3) 통로 밖으로 — 눈이 적응하듯 서서히 밝아진다 ──
	# EASE_OUT: 처음에 확 밝아졌다가 마지막이 느리다 = 동공이 열리는 느낌
	if 음향:
		var tw음2 := create_tween()
		tw음2.tween_method(func(v: float) -> void: 음향.음량비(v), 0.0, 1.0, 점등 * 0.7)
	var tw2 := create_tween()
	tw2.tween_property(_판, "color:a", 0.0, 점등) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	await tw2.finished

	_진행중 = false
	queue_free()


## 지금 씬의 ProtoCamera 를 찾아 줌을 건다. 없으면 조용히 넘어간다.
## ⚠ 카메라를 **멈추지 않는다**. 멈추면 플레이어만 걸어가 화면 밖으로 나간다.
##
## ★★[2026-08-17 수정] `zoom` 을 직접 트윈하지 않고 `연출_줌배수` 를 트윈한다.
##   왜 바꿨나 — 이게 **조용히 안 보이던 버그**였다.
##   ProtoCamera 의 zoom 은 카메라연출가(`카메라_연출.gd`)가 매 물리 프레임 다시 쓴다.
##   그래서 구역 연출이 붙은 씬에서는 여기서 걸어 둔 줌 트윈이 **다음 프레임에 지워졌다**
##   (화면상 아무 일도 안 일어나니 "연출이 약한가?" 로만 보였다).
##   지금은 zoom = 기준줌 × 공간혼합 × **연출배수** 이므로 세 주인이 서로를 안 지운다.
func _카메라_줌(배수: float, 시간: float) -> void:
	var 씬 := get_tree().current_scene
	if 씬 == null:
		return
	var 캠 := _카메라_찾기(씬)
	if 캠 == null:
		return
	var tw := create_tween()
	tw.tween_property(캠, "연출_줌배수", 배수, 시간).set_trans(Tween.TRANS_SINE)


func _카메라_찾기(노드: Node) -> Camera2D:
	if 노드 is ProtoCamera:
		return 노드 as Camera2D
	for c in 노드.get_children():
		var r := _카메라_찾기(c)
		if r:
			return r
	return null
