extends CanvasLayer
## ============================================================================
## [2026-08-06 신규] 장면 전환 — 통로를 지나며 어두워졌다 밝아진다
## ----------------------------------------------------------------------------
## ▣ 왜 새로 만들었나 (기존 stage_transition.gd 를 안 쓴 이유)
##   기존 전환은 **잉크 와이프**다. 화면을 물감이 왼쪽에서 덮고 오른쪽으로 빠진다.
##   그건 "장면이 바뀌었다"는 게임적 신호라서, 도형님이 싫다고 한 **포탈 감각**과 같다.
##   우리가 원하는 건 게임 VINE 처럼 **공간이 그냥 이어져 있는** 느낌이다.
##     → 플레이어는 어두운 통로 안으로 걸어 들어간다
##     → 통로 안이라 자연스럽게 화면이 **까매진다**  (전환이 아니라 '조명')
##     → 다음 스테이지의 같은 통로 안에서 시작해 **서서히 밝아지며** 밖이 보인다
##   화면 효과는 똑같이 검정 페이드지만, **통로 안에서만 일어나기 때문에**
##   플레이어에게는 전환이 아니라 "터널을 통과했다"로 읽힌다. 이게 핵심이다.
##
## ▣ 왜 한 노드가 양쪽(암전+점등)을 다 하나
##   씬을 바꾸면 트리가 통째로 갈아엎어진다. 그래서 페이드 판을
##   `get_tree().root` 에 붙여 **씬 교체를 살아남게** 하고, 이 노드 하나가
##   암전 → 씬 교체 → 점등까지 끝까지 책임진다.
##   (새 씬이 자기 페이드를 따로 하면 두 페이드가 겹쳐 한 번 깜빡인다 — 실제로 겪음)
##
## ▣ 다음 씬에게 넘기는 정보 (이월)
##   씬이 바뀌면 변수는 다 사라지므로 **static var** 에 담아 넘긴다.
##   GDScript 의 static var 는 프로세스가 살아 있는 동안 유지된다.
##     · 진입점  : 다음 씬의 어느 통로(입구)에서 걸어 나올지
##     · 왔던_씬 : 되돌아갈 때 쓸 경로
##   새 씬의 월드.gd 가 `진입_정보()` 로 읽고 `진입_소비()` 로 비운다.
##
## ▣ 쓰는 법 (통로가 부른다)
##   장면전환.통로로_이동(self, "res://scenes/스마트월드/스마트월드_1-2.tscn", "입구통로")
## ============================================================================
class_name 장면전환

## 통로 안으로 들어가 어두워지는 시간(초). 걸어 들어가는 속도와 맞춰야 자연스럽다.
const 암전시간: float = 0.85
## 다음 스테이지에서 눈이 밝기에 적응하듯 서서히 보이는 시간(초).
## 암전보다 **길게** 잡는다 — 들어갈 때보다 나올 때가 느려야 "적응"으로 읽힌다.
const 점등시간: float = 1.35
## 완전히 까만 상태로 머무는 시간(초). 0 이면 툭 끊긴 느낌이 난다.
const 암흑유지: float = 0.22

## 다음 씬으로 넘기는 정보. 씬 교체를 살아남아야 하므로 static.
static var _이월: Dictionary = {}
## 전환이 이미 진행 중인지 — 통로를 두 번 밟아 씬이 두 번 바뀌는 사고를 막는다.
static var _진행중: bool = false

var _판: ColorRect


# ── 바깥에서 쓰는 API ───────────────────────────────────────────────────────

## 통로를 지나 다음 씬으로. 이미 전환 중이면 무시한다.
##   from        : 아무 노드나 (트리 접근용)
##   씬경로      : 다음 스테이지 .tscn
##   진입점_이름 : 다음 씬에서 걸어 나올 통로(입구) 노드 이름. 비우면 씬 기본 시작 위치.
##   왔던_씬     : 되돌아가기용 경로 (지금은 기록만)
static func 통로로_이동(from: Node, 씬경로: String, 진입점_이름: String = "",
		왔던_씬: String = "") -> void:
	if _진행중:
		return
	if not ResourceLoader.exists(씬경로):
		push_error("장면전환: 다음 씬이 없다 → %s" % 씬경로)
		return
	_진행중 = true
	_이월 = { "진입점": 진입점_이름, "왔던_씬": 왔던_씬 }

	var tr := 장면전환.new()
	# ★current_scene 이 아니라 root 에 붙여야 씬이 바뀌어도 살아남는다
	from.get_tree().root.add_child(tr)
	tr._진행(씬경로)


## 새 씬의 월드.gd 가 시작할 때 읽는다. 통로로 들어온 게 아니면 빈 사전.
static func 진입_정보() -> Dictionary:
	return _이월.duplicate()


## 읽고 나서 비운다. (다음에 F5 로 그냥 실행했을 때 옛 정보가 남아 있으면 안 된다)
static func 진입_소비() -> void:
	_이월 = {}


## 전환이 진행 중인가 — 월드.gd 가 "지금은 사망 판정을 멈춰야 한다" 를 알 때 쓴다.
static func 진행중인가() -> bool:
	return _진행중


# ── 내부 ────────────────────────────────────────────────────────────────────

func _init() -> void:
	# 일시정지 메뉴(100)보다 위. 전환 중에는 무엇도 이 위에 그려지면 안 된다.
	layer = 200
	# ★전환 도중 트리가 멈춰도 페이드는 계속돼야 한다 (ESC 메뉴와 겹쳤을 때 대비)
	process_mode = Node.PROCESS_MODE_ALWAYS
	_판 = ColorRect.new()
	_판.name = "암전판"
	_판.color = Color(0, 0, 0, 0)
	_판.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_판.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(_판)


func _진행(씬경로: String) -> void:
	# ── 1) 통로 안으로 — 어두워진다 ──
	# EASE_IN 이라 처음엔 천천히, 안쪽으로 들어갈수록 빠르게 어두워진다.
	# (터널 입구에서는 아직 밝고 깊이 들어갈수록 급격히 어두워지는 실제 감각)
	var tw := create_tween()
	tw.tween_property(_판, "color:a", 1.0, 암전시간) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	await tw.finished

	# ── 2) 완전한 암흑 — 이 사이에 씬을 갈아끼운다 ──
	get_tree().change_scene_to_file(씬경로)
	# 새 씬의 _ready 와 첫 물리 프레임이 끝날 때까지 기다린다.
	# (덜 기다리면 아직 배치 안 된 플레이어가 한 프레임 보인다 — 실제로 겪음)
	await get_tree().process_frame
	await get_tree().physics_frame
	await get_tree().process_frame
	if 암흑유지 > 0.0:
		await get_tree().create_timer(암흑유지, true, false, true).timeout

	# ── 3) 통로 밖으로 — 눈이 적응하듯 서서히 밝아진다 ──
	# EASE_OUT: 처음에 확 밝아졌다가 마지막이 느리다 = 동공이 열리는 느낌
	var tw2 := create_tween()
	tw2.tween_property(_판, "color:a", 0.0, 점등시간) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	await tw2.finished

	_진행중 = false
	queue_free()
