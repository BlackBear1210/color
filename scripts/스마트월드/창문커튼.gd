@tool
extends Area2D
## ============================================================================
## [2026-08-18 도형 · 신규] 창문 + 커튼 — 쏜 색으로 빛을 물들이는 장치
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 요청 그대로)
##   "파란색 박스로 표현한 부분은 창문인데 옆에 커튼을 달아서 플레이어가 클릭으로
##    각각의 색에 맞게 맞추면 창문에 맞은 부분에 커튼이 쳐지면서 그 부분은
##    플레이어가 쏜 색에 맞게 빛이 은은하게 바뀌고 플랫폼과 경계의 시스템이 작용하게."
##
## ▣ 이 장치가 이 게임에서 새로운 이유
##   지금까지 물감은 **닿을 대상을 직접** 칠했다(발판을 칠하면 그 발판이 그 색이 된다).
##   창문은 **자기가 아니라 남을 바꾼다** — 창을 쏘면 창이 아니라 *빛*이 물든다.
##   그래서 처음으로 "여기를 쏴서 저기를 연다" 는 원격 인과가 생긴다.
##   퍼즐의 층이 하나 올라가고, 집 안이라는 공간이 기계 장치처럼 읽힌다.
##
## ▣ 규칙 (게임 전체 페인트 규칙 1~4 를 그대로 따른다 — 예외를 만들지 않는다)
##   · 무색 창을 쏘면            → 그 색으로 커튼이 쳐지고 빛이 물든다      "painted"
##   · 같은 색을 또 쏘면          → 낭비. 물감은 돌아온다                    "wasted"
##   · 다른 색을 덮어 쏘면        → **회색**. 빛이 죽고 영원히 못 되돌린다   "mixed_gray"
##   · 회색이 된 뒤에는           → 아무것도 못 한다                          "blocked"
##   · E 로 회수하면              → 커튼이 열리고 빛이 무색으로 돌아온다      되돌리기()
##   회색 규칙을 그대로 둔 이유: 이 게임에서 회색은 "되돌릴 수 없는 실수" 라는
##   유일한 영구 페널티다. 창문만 예외로 두면 그 무게가 옅어진다.
##
## ▣ 붙는 방식
##   창틀 자신은 **레이어 16**(총알이 맞지만 플레이어는 통과하는 오브젝트) 이다.
##   식물 B 와 같은 층위다 — 창을 밟거나 창에 부딪혀 죽는 일은 없어야 한다.
##   실제로 길을 막고 딛게 하는 것은 **자식 `빛`(빛기둥.gd)** 이다.
##     빛_모드 = 발판 → 굳은 빛이 레이어 1 이 되어 `월드.gd` 지형 판정이 그대로 잡는다
##                      (딛고 설 수 있고, 반대색이면 닿는 순간 죽는다 = 플랫폼 + 경계)
##     빛_모드 = 경계 → 통과되지만 반대색이면 죽는다 (그룹 `빛경계`)
##
## ▣ owner 주의 (§5-1)
##   자식 `빛` 이 씬에 이미 있으면 그것을 쓰고, 없으면 코드로 만든다.
##   코드로 만든 자식에는 owner 를 주지 않는다 — 주면 씬 파일에 한 벌 더 저장되어
##   다음 로드 때 두 벌이 되고 씬 교체 시 세그폴트가 난다.
## ============================================================================
class_name 창문커튼

## ⚠ `class_name 빛기둥` 을 직접 쓰지 않고 **경로 preload** 로 잡는다.
##   새 스크립트의 전역 클래스 이름은 **에디터가 프로젝트를 한 번 훑기 전까지 등록되지
##   않는다.** 그래서 `--headless -s tools/…` 로 도는 검사 13개가 통째로
##   "Could not find type" 파싱 에러로 죽는다. (2026-08-17 페인트 HUD 때 똑같이 터졌다 —
##   `월드.gd` 머리말의 같은 주석 참고.) 이 프로젝트의 규약이다.
const 빛기둥_S := preload("res://scripts/스마트월드/빛기둥.gd")

## 창틀 안쪽 크기(px). 커튼과 빛의 폭이 여기서 나온다.
@export var 크기: Vector2 = Vector2(180.0, 250.0):
	set(v):
		크기 = Vector2(maxf(v.x, 40.0), maxf(v.y, 40.0))
		_재구성(); queue_redraw()

## 창을 몇 발 맞혀야 커튼이 쳐지나. 1 이 기본 — 원격 인과라 이미 한 단계 복잡하다.
@export_range(1, 6) var 필요횟수: int = 1

## 다른 색을 덮어 쏘면 **회색**이 되는가(게임 규칙 3).
##
## ★★레벨 진행을 막는 창(= 이 창을 안 칠하면 못 지나가는 창)에는 반드시 **false** 를 준다.
##   왜: 회색은 이 게임에서 유일하게 **되돌릴 수 없는** 상태다. 그런데 그 창이 유일한
##   길이면 회색이 되는 순간 스테이지가 **영구히 막힌다**(죽어도 안 풀린다 — 리스폰은
##   플레이어만 되돌리지 지형 상태는 안 되돌린다). 진행 불가는 어떤 페널티보다 나쁘다.
##   false 면 덮어 쏘기가 그냥 "다시 칠하기"가 된다.
##
##   ▣ 규칙을 깨는 게 아닌 이유
##     회색 규칙은 "**물감끼리 섞이면** 탁해진다"는 물리에서 나왔다. 창문이 바꾸는 것은
##     물감이 아니라 **빛**이고, 빛은 섞이지 않고 **덮인다**(뒤에 친 커튼이 이긴다).
##     그래서 이 창들은 규칙의 예외가 아니라 **다른 물질**이다.
##   ▣ 장식용 창(길이 여러 개일 때)은 true 로 두어 회색 페널티의 무게를 유지한다.
@export var 색섞임_회색: bool = true

## 처음부터 커튼이 쳐져 있는 색. −1 무색(기본) / 0 검정 / 1 흰색 / 2 회색.
## ★레벨 디자인용이다. "이미 흰 빛이 길을 막고 있다 → Shift 로 흰색이 되어 지나간다"
##   같은 구간을 만들려면 물감을 안 쓰고도 색이 들어 있어야 한다.
##   무색이 아니면 **회수(E)로 열 수 있다** — 그것도 퍼즐의 답이 될 수 있게 남겨 둔다.
@export_enum("무색:-1", "검정:0", "흰색:1", "회색:2") var 시작색: int = -1

@export_group("빛")
## 빛이 방 안으로 뻗는 방향(도). 0 = 오른쪽. 창이 왼쪽 벽에 있으면 0, 오른쪽 벽이면 180.
@export_range(0.0, 360.0) var 빛_각도: float = 0.0:
	set(v): 빛_각도 = v; _재구성()
## 빛이 뻗는 길이(px).
@export_range(60.0, 2000.0) var 빛_길이: float = 520.0:
	set(v): 빛_길이 = v; _재구성()
## 빛이 바닥에 닿을 때의 폭(px).
@export_range(20.0, 1200.0) var 빛_끝폭: float = 300.0:
	set(v): 빛_끝폭 = v; _재구성()
## 발판 = 굳어서 딛고 설 수 있다 / 경계 = 통과되지만 반대색이면 죽는다 / 연출 = 그림만.
@export_enum("연출:0", "경계:1", "발판:2") var 빛_모드: int = 2:
	set(v): 빛_모드 = v; _재구성()
## 커튼이 안 쳐졌을 때(무색)의 빛 세기. 0 이면 창이 닫혀 있는 것처럼 보인다.
@export_range(0.0, 1.0) var 빛_기본세기: float = 0.55
## 커튼이 쳐졌을 때의 빛 세기. 물든 빛은 조금 더 진해야 "바뀌었다"가 읽힌다.
@export_range(0.0, 1.0) var 빛_물든세기: float = 0.9

@export_group("커튼")
## 커튼이 좌우에서 닫히는 데 걸리는 시간(초).
@export_range(0.05, 3.0) var 커튼_시간: float = 0.65
## 커튼 천의 주름 개수. 많을수록 부드럽지만 그리기가 비싸진다.
@export_range(3, 24) var 주름: int = 9

# ── 내부 상태 ───────────────────────────────────────────────────────────────
var _커튼색: int = 빛기둥_S.무색     ## −1 무색 / 0 검정 / 1 흰색 / 2 회색
var _맞은횟수: int = 0
var _진행색: int = ColorDefs.BLACK
var _닫힘: float = 0.0             ## 0 = 활짝 / 1 = 완전히 쳐짐
var _목표닫힘: float = 0.0
var _빛: Node2D = null            ## 실제 타입은 빛기둥. 위 preload 주석 참고.
var _t: float = 0.0


func _ready() -> void:
	# ★`시작색` 은 씬에서 읽어온 값이라 `_재구성()` 보다 **먼저** 상태에 반영해야 한다.
	#   나중에 넣으면 빛이 한 프레임 동안 무색으로 번쩍인다.
	if 시작색 != 빛기둥_S.무색 and _커튼색 == 빛기둥_S.무색:
		_커튼색 = 시작색
		_닫힘 = 1.0            # 이미 쳐져 있는 상태로 시작 — 닫히는 연출을 재생하지 않는다
		_목표닫힘 = 1.0
	_재구성()
	queue_redraw()
	set_process(true)
	if Engine.is_editor_hint():
		return
	# 총알(마스크 16)만 맞는다. 플레이어는 통과한다 — 창에 부딪혀 죽으면 안 된다.
	collision_layer = 16
	collision_mask = 0
	monitoring = false            # 아무도 감지할 필요 없다. 총알이 우리를 찾는다.
	add_to_group("칠할수있음")
	add_to_group("창문커튼")


## 판정 모양과 자식 빛을 다시 맞춘다. **여러 번 불러도 결과가 같다**(멱등).
func _재구성() -> void:
	if not is_inside_tree():
		return
	var cs := get_node_or_null("모양") as CollisionShape2D
	if cs == null:
		cs = CollisionShape2D.new()
		cs.name = "모양"
		cs.visible = false
		add_child(cs)
	var r := cs.shape as RectangleShape2D
	if r == null:
		r = RectangleShape2D.new()
		cs.shape = r
	r.size = 크기

	# ── 자식 빛 ── 씬에 있으면 그것을 쓰고, 없으면 만든다(owner 는 주지 않는다).
	if _빛 == null:
		_빛 = get_node_or_null("빛") as Node2D
	if _빛 == null:
		_빛 = 빛기둥_S.new()
		_빛.name = "빛"
		add_child(_빛)
	_빛.모드 = 빛_모드            # 열거형은 int 라 그대로 대입된다
	_빛.시작폭 = 크기.y * 0.92          # 창 높이가 곧 빛줄기의 시작 폭이다
	_빛.끝폭 = 빛_끝폭
	_빛.길이 = 빛_길이
	_빛.각도 = 빛_각도
	_빛.구멍_그리기 = false             # 창틀을 우리가 그리므로 구멍은 안 그린다
	_빛.세기 = 빛_물든세기 if _물들었나() else 빛_기본세기
	# 빛은 창 **안쪽 면** 에서 나온다. 창 중심에서 방향으로 반 칸 옮긴다.
	_빛.position = Vector2.RIGHT.rotated(deg_to_rad(빛_각도)) * (크기.x * 0.5)
	_빛.색_지정(_커튼색)


func _물들었나() -> bool:
	return _커튼색 == ColorDefs.BLACK or _커튼색 == ColorDefs.WHITE


# ============================================================================
# 페인트코어와의 약속 (지형·식물과 똑같은 계약)
# ============================================================================
func 현재색() -> int:
	return _커튼색


## 창틀 자체는 아무도 죽이지 않는다. 죽이는 것은 자식 `빛` 이다.
## (창은 레이어 16 이라 애초에 지형 질의에 안 걸리지만, 계약을 지켜 명시해 둔다)
func 반대색인가(_플레이어색: int) -> bool:
	return false


func 명중(색: int, _월드좌표: Vector2) -> String:
	if _커튼색 == ColorDefs.GRAY:
		return "blocked"                       # 규칙 3 — 회색은 끝이다
	if _물들었나():
		if 색 == _커튼색:
			return "wasted"                    # 같은 색 = 낭비, 물감은 돌아온다
		if not 색섞임_회색:
			# 길을 막는 창 — 덮어 쓰기만 한다(§색섞임_회색 주석의 영구 소프트락 방지).
			# "painted" 를 돌려주므로 회수줄에도 정상으로 쌓인다.
			_색_바꾸기(색)
			return "painted"
		_색_바꾸기(ColorDefs.GRAY)
		return "mixed_gray"
	# ── 아직 무색 ──
	if _맞은횟수 > 0 and _진행색 != 색:
		_맞은횟수 = 0                          # 색을 바꿔 쏘면 진행도가 초기화된다
	_진행색 = 색
	_맞은횟수 += 1
	if _맞은횟수 >= 필요횟수:
		_맞은횟수 = 0
		_색_바꾸기(색)
		return "painted"
	queue_redraw()
	return "progress"


## E 수동 회수 — 커튼을 열고 빛을 무색으로 되돌린다.
## 회색은 애초에 회수줄에 없으므로 여기 오지 않는다(페인트_코어.gd 가 걸러 준다).
func 되돌리기() -> bool:
	if not _물들었나():
		return false
	_색_바꾸기(빛기둥_S.무색)
	return true


## 부분 진행이 스스로 흐려질 일은 없다(창은 시간이 지나도 안 바랜다).
## 계약을 맞추려고 남겨 둔다 — 페인트_코어가 부를 수 있다.
func 부분_취소() -> void:
	_맞은횟수 = 0
	queue_redraw()


func _색_바꾸기(새색: int) -> void:
	_커튼색 = 새색
	# ★커튼이 쳐지는 것과 빛이 물드는 것이 **같은 순간**이어야 인과가 읽힌다.
	#   커튼을 먼저 치고 빛을 나중에 바꾸면 "커튼과 빛이 상관없는 것"처럼 보인다.
	_목표닫힘 = 1.0 if 새색 != 빛기둥_S.무색 else 0.0
	if _빛:
		_빛.세기 = 빛_물든세기 if _물들었나() else 빛_기본세기
		_빛.색_지정(새색)
	_재구성()
	queue_redraw()


# ============================================================================
# 매 프레임 — 커튼 여닫이
# ============================================================================
func _process(delta: float) -> void:
	_t += delta
	if not is_equal_approx(_닫힘, _목표닫힘):
		var 속도 := delta / maxf(커튼_시간, 0.001)
		_닫힘 = move_toward(_닫힘, _목표닫힘, 속도)
		queue_redraw()
	elif _닫힘 > 0.01:
		queue_redraw()          # 쳐진 커튼이 아주 약하게 흔들린다


# ============================================================================
# 그림
# ============================================================================
func _draw() -> void:
	if 아트슬롯.그림_있나(self):
		return

	var 반 := 크기 * 0.5
	var 화면색 := 빛기둥_S._색을_화면색으로(_커튼색)

	# ── ① 창 너머(바깥) ── 커튼이 닫힐수록 가려진다
	var 바깥 := 1.0 - _닫힘
	draw_rect(Rect2(-반, 크기), Color(화면색.r, 화면색.g, 화면색.b,
		0.20 + 0.55 * 바깥 * (빛_물든세기 if _물들었나() else 빛_기본세기)), true)

	# ── ② 유리 격자 ── 창이라는 걸 알아보게 하는 최소한의 기호
	var 격자 := Color(0.06, 0.06, 0.07, 0.75)
	draw_line(Vector2(0, -반.y), Vector2(0, 반.y), 격자, 4.0)
	draw_line(Vector2(-반.x, 0), Vector2(반.x, 0), 격자, 4.0)

	# ── ③ 커튼 ── 좌우에서 안쪽으로 닫힌다.
	#   ★부분 진행(필요횟수 2 이상)일 때는 진행색으로 **살짝만** 물든 커튼을 보여 준다.
	#     "지금 이 색으로 칠하는 중" 이 안 보이면 두 발째를 쏠 이유를 모른다.
	if _닫힘 > 0.001:
		_커튼_한쪽(-1.0, 반, 화면색)
		_커튼_한쪽(1.0, 반, 화면색)
	elif _맞은횟수 > 0:
		var 진행 := float(_맞은횟수) / float(필요횟수)
		var pc := 빛기둥_S._색을_화면색으로(_진행색)
		draw_rect(Rect2(-반, 크기), Color(pc.r, pc.g, pc.b, 0.22 * 진행), true)

	# ── ④ 창틀 ── 항상 맨 위. 회색이 되면 틀도 죽은 색으로 바뀐다(영구 표시).
	var 틀 := Color(0.09, 0.09, 0.10) if _커튼색 != ColorDefs.GRAY else Color(0.34, 0.34, 0.35)
	draw_rect(Rect2(-반 - Vector2(9, 9), 크기 + Vector2(18, 18)), 틀, false, 9.0)

	# ── ⑤ 커튼봉 ── 창 위에 가로로. 커튼이 어디서 나오는지 알려 준다.
	draw_line(Vector2(-반.x - 22, -반.y - 20), Vector2(반.x + 22, -반.y - 20),
		Color(0.13, 0.13, 0.14), 6.0)
	draw_circle(Vector2(-반.x - 22, -반.y - 20), 5.0, Color(0.20, 0.20, 0.22))
	draw_circle(Vector2(반.x + 22, -반.y - 20), 5.0, Color(0.20, 0.20, 0.22))

	# ── ⑥ 아직 무색이면 "여기를 쏴라" 를 아주 약하게 깜빡인다 ──
	#   튜토리얼 문구를 안 쓰는 게임이라, 신호는 전부 그림 안에 있어야 한다.
	if _커튼색 == 빛기둥_S.무색:
		var 맥 := 0.18 + 0.14 * sin(_t * 2.1)
		draw_rect(Rect2(-반 - Vector2(4, 4), 크기 + Vector2(8, 8)),
			Color(0.95, 0.95, 0.92, 맥), false, 3.0)


## 커튼 한 쪽(왼쪽 −1 / 오른쪽 +1). 주름을 사인으로 접는다.
func _커튼_한쪽(쪽: float, 반: Vector2, 화면색: Color) -> void:
	# 닫힘 0 → 폭 0, 닫힘 1 → 각 커튼이 창 절반을 덮는다
	var 폭 := 반.x * _닫힘
	if 폭 <= 0.5:
		return
	var 천 := Color(화면색.r * 0.78, 화면색.g * 0.78, 화면색.b * 0.80, 0.93)
	var 점들 := PackedVector2Array()
	var 끝x := 쪽 * (반.x - 폭)
	var 시작x := 쪽 * 반.x
	# 위쪽 가로변
	점들.append(Vector2(시작x, -반.y))
	점들.append(Vector2(끝x, -반.y))
	# 안쪽 세로변 — 여기에 주름이 진다(커튼이 흔들리는 곳은 항상 안쪽 끝이다)
	for i in range(주름 + 1):
		var t := float(i) / float(주름)
		var y := lerpf(-반.y, 반.y, t)
		var 접힘 := sin(t * PI * 2.6 + _t * 1.1 + 쪽) * (반.x * 0.055) * _닫힘
		점들.append(Vector2(끝x - 쪽 * 접힘, y))
	점들.append(Vector2(시작x, 반.y))
	draw_colored_polygon(점들, 천)

	# 세로 주름 그림자 — 천에 두께를 준다
	for i in range(1, 주름):
		var t2 := float(i) / float(주름)
		var x := lerpf(시작x, 끝x, t2)
		draw_line(Vector2(x, -반.y), Vector2(x, 반.y),
			Color(0.0, 0.0, 0.0, 0.10 + 0.08 * sin(t2 * PI * 3.0)), 2.0)
