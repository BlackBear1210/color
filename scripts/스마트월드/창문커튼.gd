@tool
extends Area2D
## ============================================================================
## [2026-08-18 신규 · 2026-08-20 전면 개편] 창문 + 커튼
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 요청 그대로)
##   "파란색 박스로 표현한 부분은 창문인데 옆에 커튼을 달아서 플레이어가 클릭으로
##    각각의 색에 맞게 맞추면 창문에 맞은 부분에 커튼이 쳐지면서 그 부분은
##    플레이어가 쏜 색에 맞게 빛이 은은하게 바뀌고 플랫폼과 경계의 시스템이 작용하게."
##
## ▣ ★[2026-08-20] 개편 5 가지 (도형님 지시)
##   ① **커튼을 더 크게** — 기본 크기 (180,250) → (260,360).
##   ② **빛이 위에서 아래로 사다리꼴** — 창에서 아래로 퍼진다.
##   ③ **한쪽씩 닫힌다** — 쏜 자리가 창 중심보다 왼쪽이면 왼쪽 커튼, 오른쪽이면 오른쪽.
##      양쪽을 다 쳐야 완전히 닫힌다. 두 발이 필요하고, 어디를 쏠지 겨냥해야 한다.
##   ④ **쳐져도 은은하게 샌다** — 천 사이로 가는 빛줄기가 몇 가닥 남는다.
##   ⑤ **구멍 난 커튼** — 다 쳐도 구멍으로 빛이 새고, **그 빛은 경계로 작용**한다
##      (가까이 가면 플레이어 색이 바뀐다).
##
## ▣ ★왜 "빛 방향" 을 모드마다 다르게 두나 (②를 그대로 하면 발판이 깨진다)
##   빛을 **세로**로 세우면 윗면이 없어져 **딛고 설 수 없다.** 사다리꼴의 넓은 쪽이
##   아래로 가므로 밟을 면이 아예 안 생긴다.
##   → `발판` 모드는 가로(각도 0)를 유지하고, **`경계`·`연출` 모드만 세로**로 간다.
##     `빛_각도_자동` 이 이 판단을 대신한다. 끄면 예전처럼 손으로 각도를 준다.
##   이 게임에서 "빛을 밟는다" 와 "빛에 물든다" 는 다른 장치이고,
##   **모양이 그 차이를 말해 줘야 한다** — 가로로 누운 빛은 길, 세로로 선 빛은 벽.
##
## ▣ 규칙 (게임 전체 페인트 규칙 1~4 를 그대로 따른다 — 예외를 만들지 않는다)
##   · 무색 창을 쏘면            → 맞은 쪽 커튼이 그 색으로 쳐진다               "painted"
##   · 이미 쳐진 쪽을 또 쏘면     → 낭비. 물감은 돌아온다                        "wasted"
##   · 다른 색을 덮어 쏘면        → **회색**. 빛이 죽고 영원히 못 되돌린다        "mixed_gray"
##     (단 `색섞임_회색 = false` 인 창은 그냥 다시 칠해진다 — 아래 주석 참고)
##   · E 로 회수하면              → 커튼이 열리고 빛이 무색으로 돌아온다          되돌리기()
##
## ▣ 붙는 방식
##   창틀 자신은 **레이어 16**(총알이 맞지만 플레이어는 통과하는 오브젝트) 이다.
##   실제로 길을 막고 딛게 하는 것은 **자식 `빛`(빛기둥.gd)** 이다.
##
## ▣ owner 주의 (§5-1)
##   코드로 만든 자식에는 owner 를 주지 않는다 — 주면 씬 파일에 한 벌 더 저장되어
##   다음 로드 때 두 벌이 되고 씬 교체 시 세그폴트가 난다.
## ============================================================================
class_name 창문커튼

## ⚠ `class_name 빛기둥` 을 직접 쓰지 않고 **경로 preload** 로 잡는다.
##   전역 클래스 이름은 에디터가 프로젝트를 한 번 훑기 전까지 등록되지 않아서,
##   `--headless -s tools/…` 로 도는 검사가 통째로 파싱 에러로 죽는다.
const 빛기둥_S := preload("res://scripts/스마트월드/빛기둥.gd")

## 창틀 안쪽 크기(px). 커튼과 빛의 폭이 여기서 나온다.
## ★[2026-08-20] (180,250) → (260,360) 으로 키웠다(도형님 요청 ①).
##   창이 작으면 커튼이 "천" 이 아니라 "띠" 로 보이고, 한쪽씩 치는 게 눈에 안 들어온다.
@export var 크기: Vector2 = Vector2(260.0, 360.0):
	set(v):
		크기 = Vector2(maxf(v.x, 40.0), maxf(v.y, 40.0))
		_재구성(); queue_redraw()

## 한쪽 커튼을 치는 데 필요한 발수. 1 이 기본 — 양쪽이라 이미 두 발이다.
@export_range(1, 6) var 필요횟수: int = 1

## 다른 색을 덮어 쏘면 **회색**이 되는가(게임 규칙 3).
##
## ★★레벨 진행을 막는 창(= 이 창을 안 칠하면 못 지나가는 창)에는 반드시 **false** 를 준다.
##   회색은 유일하게 **되돌릴 수 없는** 상태다. 그 창이 유일한 길이면 회색이 되는 순간
##   스테이지가 **영구히 막힌다**(죽어도 안 풀린다 — 리스폰은 플레이어만 되돌린다).
##   ▣ 규칙을 깨는 게 아닌 이유
##     회색 규칙은 "**물감끼리 섞이면** 탁해진다" 는 물리에서 나왔다. 창문이 바꾸는 것은
##     물감이 아니라 **빛**이고, 빛은 섞이지 않고 **덮인다**(뒤에 친 커튼이 이긴다).
@export var 색섞임_회색: bool = true

## 처음부터 커튼이 쳐져 있는 색. −1 무색(기본) / 0 검정 / 1 흰색 / 2 회색.
@export_enum("무색:-1", "검정:0", "흰색:1", "회색:2") var 시작색: int = -1

@export_group("빛")
## 켜면 모드에 맞춰 각도를 자동으로 정한다 — **발판은 가로, 경계·연출은 세로**(§머리말).
## 끄면 아래 `빛_각도` 를 그대로 쓴다.
@export var 빛_각도_자동: bool = true:
	set(v): 빛_각도_자동 = v; _재구성()
## 자동을 껐을 때 쓰는 각도(도). 0 = 오른쪽 · 90 = 아래.
@export_range(0.0, 360.0) var 빛_각도: float = 90.0:
	set(v): 빛_각도 = v; _재구성()
## 빛이 뻗는 길이(px).
@export_range(60.0, 2000.0) var 빛_길이: float = 620.0:
	set(v): 빛_길이 = v; _재구성()
## 빛이 끝에서 퍼지는 폭(px). **시작폭보다 커야 사다리꼴**로 보인다(도형님 요청 ②).
@export_range(20.0, 1200.0) var 빛_끝폭: float = 460.0:
	set(v): 빛_끝폭 = v; _재구성()
## 연출 = 그림만 / 경계 = 색을 강제한다(죽이지 않는다) / 발판 = 굳어서 딛고 설 수 있다.
@export_enum("연출:0", "경계:1", "발판:2") var 빛_모드: int = 2:
	set(v): 빛_모드 = v; _재구성()
## 커튼이 하나도 안 쳐졌을 때의 빛 세기.
@export_range(0.0, 1.0) var 빛_기본세기: float = 0.55
## 커튼이 다 쳐졌을 때의 빛 세기. 물든 빛은 조금 더 진해야 "바뀌었다" 가 읽힌다.
@export_range(0.0, 1.0) var 빛_물든세기: float = 0.9

@export_group("커튼")
## 커튼 한쪽이 닫히는 데 걸리는 시간(초).
@export_range(0.05, 3.0) var 커튼_시간: float = 0.65
## 커튼 천의 주름 개수.
@export_range(3, 24) var 주름: int = 9

@export_group("구멍 난 커튼")
## ★커튼에 구멍이 뚫려 있는가(도형님 요청 ⑤).
## 켜면 **커튼을 다 쳐도** 그 구멍으로 빛이 새고, 그 빛은 **경계로 작용**한다
## (가까이 가면 플레이어 색이 바뀌고 Shift 로 못 바꾼다).
##
## ▣ 이게 왜 좋은 장치인가
##   보통 창은 "쏘면 해결" 이다. 구멍 난 창은 **해결해도 대가가 남는다** —
##   빛다리는 생겼는데 그 옆을 지날 때 색을 빼앗긴다. 플레이어가
##   "다리를 만들까, 그냥 돌아갈까" 를 저울질하게 된다.
@export var 구멍_있음: bool = false:
	set(v): 구멍_있음 = v; _재구성(); queue_redraw()
## 구멍의 세로 위치(0 = 창 맨 위 · 1 = 맨 아래).
@export_range(0.0, 1.0) var 구멍_위치: float = 0.34:
	set(v): 구멍_위치 = v; _재구성(); queue_redraw()
## 구멍 지름(px). 창 높이의 1/4 을 넘기지 말 것 — 넘으면 커튼이 아니라 창살로 보인다.
@export_range(10.0, 200.0) var 구멍_크기: float = 62.0:
	set(v): 구멍_크기 = v; _재구성(); queue_redraw()
## 구멍에서 새는 빛이 뻗는 길이(px).
@export_range(60.0, 1600.0) var 구멍빛_길이: float = 520.0:
	set(v): 구멍_있음 = 구멍_있음; _재구성()

# ── 내부 상태 ───────────────────────────────────────────────────────────────
var _커튼색: int = 빛기둥_S.무색     ## −1 무색 / 0 검정 / 1 흰색 / 2 회색
var _맞은횟수: int = 0
var _진행색: int = ColorDefs.BLACK
## ★[2026-08-20] 닫힘을 **좌·우 따로** 둔다(도형님 요청 ③).
##   하나로 두면 "어디를 쏘든 똑같이 닫힌다" 가 되어 겨냥할 이유가 없어진다.
var _닫힘_좌: float = 0.0
var _닫힘_우: float = 0.0
var _목표_좌: float = 0.0
var _목표_우: float = 0.0
var _빛: Node2D = null              ## 창 전체의 빛 (실제 타입은 빛기둥)
var _구멍빛: Node2D = null          ## 구멍에서 새는 경계 빛
var _t: float = 0.0


func _ready() -> void:
	# ★`시작색` 은 씬에서 읽어온 값이라 `_재구성()` 보다 먼저 상태에 반영해야 한다.
	#   나중에 넣으면 빛이 한 프레임 동안 무색으로 번쩍인다.
	if 시작색 != 빛기둥_S.무색 and _커튼색 == 빛기둥_S.무색:
		_커튼색 = 시작색
		_닫힘_좌 = 1.0
		_닫힘_우 = 1.0
		_목표_좌 = 1.0
		_목표_우 = 1.0
	_재구성()
	queue_redraw()
	set_process(true)
	if Engine.is_editor_hint():
		return
	# 총알(마스크 16)만 맞는다. 플레이어는 통과한다 — 창에 부딪혀 죽으면 안 된다.
	collision_layer = 16
	collision_mask = 0
	monitoring = false
	add_to_group("칠할수있음")
	add_to_group("창문커튼")


## 모드에 맞는 빛 각도. **발판은 가로(0°), 경계·연출은 세로(90°)** — §머리말.
func _각도() -> float:
	if not 빛_각도_자동:
		return 빛_각도
	return 0.0 if 빛_모드 == 2 else 90.0


## 판정 모양과 자식 빛을 다시 맞춘다. **여러 번 불러도 결과가 같다**(멱등).
func _재구성() -> void:
	if not is_inside_tree():
		return
	var cs := get_node_or_null("모양") as CollisionShape2D
	if cs == null:
		cs = CollisionShape2D.new()
		cs.name = "모양"
		cs.visible = false
		add_child(cs)
	var r := cs.shape as RectangleShape2D
	if r == null:
		r = RectangleShape2D.new()
		cs.shape = r
	r.size = 크기

	# ── 창 전체의 빛 ──
	if _빛 == null:
		_빛 = get_node_or_null("빛") as Node2D
	if _빛 == null:
		_빛 = 빛기둥_S.new()
		_빛.name = "빛"
		add_child(_빛)          # ⚠ owner 를 주지 않는다
	var 각 := _각도()
	var 세로 := absf(sin(deg_to_rad(각))) > 0.5
	_빛.모드 = 빛_모드
	# 세로로 내려꽂는 빛은 **창 폭**이 시작폭, 가로로 뻗는 빛은 **창 높이**가 시작폭이다.
	_빛.시작폭 = (크기.x * 0.92) if 세로 else (크기.y * 0.92)
	_빛.끝폭 = 빛_끝폭
	_빛.길이 = 빛_길이
	_빛.각도 = 각
	_빛.구멍_그리기 = false             # 창틀을 우리가 그린다
	_빛.세기 = _빛세기()
	# 빛은 창 **안쪽 면**에서 나온다.
	var 앞 := Vector2.RIGHT.rotated(deg_to_rad(각))
	_빛.position = 앞 * ((크기.y if 세로 else 크기.x) * 0.5)
	_빛.색_지정(_커튼색)

	_구멍빛_맞추기(각, 앞)


## ★구멍에서 새는 빛(도형님 요청 ⑤). **항상 경계 모드**다 —
##   커튼을 쳐서 만든 발판과 구분되어야 하므로 절대 발판이 되면 안 된다.
func _구멍빛_맞추기(각: float, 앞: Vector2) -> void:
	if not 구멍_있음:
		if _구멍빛 and is_instance_valid(_구멍빛):
			_구멍빛.모드 = 0                     # 연출로 낮춰 판정을 끈다
			_구멍빛.세기 = 0.0
		return
	if _구멍빛 == null:
		_구멍빛 = get_node_or_null("구멍빛") as Node2D
	if _구멍빛 == null:
		_구멍빛 = 빛기둥_S.new()
		_구멍빛.name = "구멍빛"
		add_child(_구멍빛)                       # ⚠ owner 없음
	_구멍빛.모드 = 1                             # 경계 (색 강제 · 죽이지 않는다)
	_구멍빛.각도 = 각
	_구멍빛.시작폭 = 구멍_크기
	_구멍빛.끝폭 = 구멍_크기 * 2.6
	_구멍빛.길이 = 구멍빛_길이
	_구멍빛.구멍_그리기 = false
	_구멍빛.물듦_반경 = 130.0
	# 커튼이 닫힐수록 구멍빛이 **또렷해진다** — 천이 나머지를 가리기 때문이다.
	_구멍빛.세기 = lerpf(0.25, 0.95, _닫힘())
	# 구멍 위치를 창 면 위에서 잡는다. 세로 빛이면 x 로, 가로 빛이면 y 로 옮긴다.
	var 옆 := 앞.orthogonal()
	var 치우침 := (구멍_위치 - 0.5) * (크기.x if absf(앞.y) > 0.5 else 크기.y)
	_구멍빛.position = 앞 * ((크기.y if absf(앞.y) > 0.5 else 크기.x) * 0.5) + 옆 * 치우침
	# ★구멍빛의 색은 **커튼 색이 아니라 바깥 빛**이다. 커튼을 쳐도 구멍은 커튼이 아니므로
	#   천 색이 아니라 창밖에서 들어오는 색 그대로다. 무색이면 아무도 안 물들인다.
	_구멍빛.색_지정(구멍빛_색())


## 구멍으로 새는 빛의 색. 커튼이 쳐지면 그 색으로 물들되, **회색이면 죽은 빛**이라 무색.
func 구멍빛_색() -> int:
	if _커튼색 == ColorDefs.GRAY:
		return 빛기둥_S.무색
	return _커튼색


func _닫힘() -> float:
	return (_닫힘_좌 + _닫힘_우) * 0.5


func _물들었나() -> bool:
	return _커튼색 == ColorDefs.BLACK or _커튼색 == ColorDefs.WHITE


func _빛세기() -> float:
	return 빛_물든세기 if _물들었나() else 빛_기본세기


# ============================================================================
# 페인트코어와의 약속 (지형·식물과 똑같은 계약)
# ============================================================================
func 현재색() -> int:
	return _커튼색


## 창틀 자체는 아무도 죽이지 않는다. 죽이는 것은 자식 `빛` 이다.
func 반대색인가(_플레이어색: int) -> bool:
	return false


## ★맞은 **월드 좌표**로 어느 쪽 커튼인지 정한다(도형님 요청 ③).
## 창 중심보다 왼쪽에 맞으면 왼쪽 커튼, 오른쪽이면 오른쪽 커튼.
## 반환: −1 왼쪽 / +1 오른쪽
func _맞은쪽(월드좌표: Vector2) -> float:
	var 로컬 := to_local(월드좌표)
	# 세로 빛(창이 천장에 붙은 경우)이든 가로든, 커튼은 늘 좌우로 갈리므로 x 로 판단한다.
	return -1.0 if 로컬.x < 0.0 else 1.0


func 명중(색: int, 월드좌표: Vector2) -> String:
	if _커튼색 == ColorDefs.GRAY:
		return "blocked"                       # 규칙 3 — 회색은 끝이다
	var 쪽 := _맞은쪽(월드좌표)
	# ⚠[2026-08-20] **목표값**을 봐야 한다. `_닫힘_*`(애니메이션 중인 값)을 보면
	#   커튼이 닫히는 0.65 초 동안 같은 쪽에 몇 발을 쏴도 계속 "painted" 가 나온다
	#   → 물감이 무한정 소모되고 회수줄도 어긋난다. 의도(목표)와 표시(현재)를 구분할 것.
	var 이미 := _목표_좌 if 쪽 < 0.0 else _목표_우

	if _물들었나():
		if 색 == _커튼색:
			# ★같은 색이라도 **아직 안 닫힌 쪽**이면 그쪽을 닫는다 — 낭비가 아니다.
			#   이게 없으면 "왼쪽만 닫힌 창에 같은 색을 또 쏘면 낭비" 가 되어
			#   양쪽을 닫는 것 자체가 불가능해진다.
			if 이미 < 0.99:
				_쪽_닫기(쪽)
				return "painted"
			return "wasted"
		if not 색섞임_회색:
			_색_바꾸기(색)
			_쪽_닫기(쪽)
			return "painted"
		_색_바꾸기(ColorDefs.GRAY)
		return "mixed_gray"

	# ── 아직 무색 ──
	if _맞은횟수 > 0 and _진행색 != 색:
		_맞은횟수 = 0                          # 색을 바꿔 쏘면 진행도가 초기화된다
	_진행색 = 색
	_맞은횟수 += 1
	if _맞은횟수 >= 필요횟수:
		_맞은횟수 = 0
		_색_바꾸기(색)
		_쪽_닫기(쪽)
		return "painted"
	queue_redraw()
	return "progress"


func _쪽_닫기(쪽: float) -> void:
	if 쪽 < 0.0:
		_목표_좌 = 1.0
	else:
		_목표_우 = 1.0
	queue_redraw()


## E 수동 회수 — 커튼을 **양쪽 다** 열고 빛을 무색으로 되돌린다.
func 되돌리기() -> bool:
	if not _물들었나():
		return false
	_색_바꾸기(빛기둥_S.무색)
	return true


func 부분_취소() -> void:
	_맞은횟수 = 0
	queue_redraw()


func _색_바꾸기(새색: int) -> void:
	_커튼색 = 새색
	if 새색 == 빛기둥_S.무색:
		_목표_좌 = 0.0
		_목표_우 = 0.0
	if _빛:
		_빛.세기 = _빛세기()
		_빛.색_지정(새색)
	_재구성()
	queue_redraw()


# ============================================================================
# 매 프레임 — 커튼 여닫이
# ============================================================================
func _process(delta: float) -> void:
	_t += delta
	var 속도 := delta / maxf(커튼_시간, 0.001)
	var 이전 := _닫힘()
	_닫힘_좌 = move_toward(_닫힘_좌, _목표_좌, 속도)
	_닫힘_우 = move_toward(_닫힘_우, _목표_우, 속도)
	if not is_equal_approx(이전, _닫힘()):
		# 커튼이 움직이면 구멍빛의 또렷함도 같이 바뀐다
		if 구멍_있음 and _구멍빛 and is_instance_valid(_구멍빛):
			_구멍빛.세기 = lerpf(0.25, 0.95, _닫힘())
		# ④ 은은하게 새는 빛 — 다 쳐도 완전히 어두워지지 않는다
		if _빛 and is_instance_valid(_빛):
			_빛.세기 = _빛세기() * lerpf(1.0, 샘_비율, _닫힘())
		queue_redraw()
	elif _닫힘() > 0.01:
		queue_redraw()          # 쳐진 커튼이 아주 약하게 흔들린다


## ★커튼을 다 쳐도 남는 빛의 비율(도형님 요청 ④).
## 0 이면 완전히 막혀 "빛이 꺼졌다" 가 되는데, 그러면 물든 빛을 **밟을 수 없는 것처럼**
## 보인다(발판 모드인데 안 보이면 아무도 안 밟는다). 천은 원래 조금 비친다.
const 샘_비율 := 0.62


# ============================================================================
# 그림
# ============================================================================
func _draw() -> void:
	if 아트슬롯.그림_있나(self):
		return

	var 반 := 크기 * 0.5
	var 화면색 := 빛기둥_S._색을_화면색으로(_커튼색)

	# ── ① 창 너머(바깥) ── 커튼이 닫힐수록 가려진다
	var 바깥 := 1.0 - _닫힘()
	draw_rect(Rect2(-반, 크기), Color(화면색.r, 화면색.g, 화면색.b,
		0.20 + 0.55 * 바깥 * _빛세기()), true)

	# ── ② 유리 격자 ── 창이라는 걸 알아보게 하는 최소한의 기호
	var 격자 := Color(0.06, 0.06, 0.07, 0.75)
	draw_line(Vector2(0, -반.y), Vector2(0, 반.y), 격자, 4.0)
	draw_line(Vector2(-반.x, 0), Vector2(반.x, 0), 격자, 4.0)

	# ── ③ 커튼 ── **좌우가 따로** 닫힌다
	if _닫힘_좌 > 0.001:
		_커튼_한쪽(-1.0, 반, 화면색, _닫힘_좌)
	if _닫힘_우 > 0.001:
		_커튼_한쪽(1.0, 반, 화면색, _닫힘_우)
	if _닫힘_좌 <= 0.001 and _닫힘_우 <= 0.001 and _맞은횟수 > 0:
		var 진행 := float(_맞은횟수) / float(필요횟수)
		var pc := 빛기둥_S._색을_화면색으로(_진행색)
		draw_rect(Rect2(-반, 크기), Color(pc.r, pc.g, pc.b, 0.22 * 진행), true)

	# ── ④ 은은하게 새는 빛 ── 천 사이로 남는 가는 줄기 몇 가닥
	if _닫힘() > 0.05:
		_샘빛(반, 화면색)

	# ── ⑤ 구멍 ── 커튼을 쳐도 여기는 안 막힌다
	if 구멍_있음:
		_구멍(반)

	# ── ⑥ 창틀 ── 항상 맨 위. 회색이 되면 틀도 죽은 색으로 바뀐다(영구 표시).
	var 틀 := Color(0.09, 0.09, 0.10) if _커튼색 != ColorDefs.GRAY else Color(0.34, 0.34, 0.35)
	draw_rect(Rect2(-반 - Vector2(9, 9), 크기 + Vector2(18, 18)), 틀, false, 9.0)

	# ── ⑦ 커튼봉 ──
	draw_line(Vector2(-반.x - 22, -반.y - 20), Vector2(반.x + 22, -반.y - 20),
		Color(0.13, 0.13, 0.14), 6.0)
	draw_circle(Vector2(-반.x - 22, -반.y - 20), 5.0, Color(0.20, 0.20, 0.22))
	draw_circle(Vector2(반.x + 22, -반.y - 20), 5.0, Color(0.20, 0.20, 0.22))

	# ── ⑧ 아직 안 닫힌 쪽을 아주 약하게 깜빡인다 ──
	#   튜토리얼 문구를 안 쓰는 게임이라 신호는 전부 그림 안에 있어야 한다.
	#   ★한쪽만 닫혔을 때 **남은 쪽만** 깜빡이는 것이 이 개편의 핵심 안내다.
	var 맥 := 0.16 + 0.13 * sin(_t * 2.1)
	if _커튼색 != ColorDefs.GRAY:
		if _닫힘_좌 < 0.5:
			draw_rect(Rect2(-반.x - 4, -반.y - 4, 반.x + 4, 크기.y + 8),
				Color(0.95, 0.95, 0.92, 맥), false, 3.0)
		if _닫힘_우 < 0.5:
			draw_rect(Rect2(0, -반.y - 4, 반.x + 4, 크기.y + 8),
				Color(0.95, 0.95, 0.92, 맥), false, 3.0)


## 커튼 한 쪽(왼쪽 −1 / 오른쪽 +1). 주름을 사인으로 접는다.
func _커튼_한쪽(쪽: float, 반: Vector2, 화면색: Color, 닫힘: float) -> void:
	var 폭 := 반.x * 닫힘
	if 폭 <= 0.5:
		return
	var 천 := Color(화면색.r * 0.78, 화면색.g * 0.78, 화면색.b * 0.80, 0.93)
	var 점들 := PackedVector2Array()
	var 끝x := 쪽 * (반.x - 폭)
	var 시작x := 쪽 * 반.x
	점들.append(Vector2(시작x, -반.y))
	점들.append(Vector2(끝x, -반.y))
	for i in range(주름 + 1):
		var t := float(i) / float(주름)
		var y := lerpf(-반.y, 반.y, t)
		var 접힘 := sin(t * PI * 2.6 + _t * 1.1 + 쪽) * (반.x * 0.055) * 닫힘
		점들.append(Vector2(끝x - 쪽 * 접힘, y))
	점들.append(Vector2(시작x, 반.y))
	draw_colored_polygon(점들, 천)

	for i in range(1, 주름):
		var t2 := float(i) / float(주름)
		var x := lerpf(시작x, 끝x, t2)
		draw_line(Vector2(x, -반.y), Vector2(x, 반.y),
			Color(0.0, 0.0, 0.0, 0.10 + 0.08 * sin(t2 * PI * 3.0)), 2.0)


## ★천 사이로 새는 가는 빛줄기(도형님 요청 ④).
## 커튼이 닫힐수록 줄기가 **가늘어지고 개수가 준다** — 완전히 사라지지는 않는다.
func _샘빛(반: Vector2, 화면색: Color) -> void:
	var 세기 := _빛세기() * (0.30 + 0.25 * (1.0 - _닫힘()))
	var 가닥 := 5
	for i in 가닥:
		var t := (float(i) + 0.5) / float(가닥)
		var x := lerpf(-반.x, 반.x, t)
		# 아주 느리게 흔들린다 — 고정된 줄기는 "그림" 이고 흔들리면 "빛" 이다
		var 흔 := sin(_t * 0.6 + float(i) * 1.7) * 3.0
		var w := lerpf(5.0, 1.6, _닫힘())
		draw_line(Vector2(x + 흔, -반.y), Vector2(x + 흔 * 1.6, 반.y),
			Color(화면색.r, 화면색.g, 화면색.b, 세기), w)


## 커튼에 뚫린 구멍. 천이 찢어진 자리라 테두리가 너덜하다.
func _구멍(반: Vector2) -> void:
	var cy := lerpf(-반.y, 반.y, 구멍_위치)
	var 색 := 빛기둥_S._색을_화면색으로(구멍빛_색())
	var r := 구멍_크기 * 0.5
	# 뚫린 자리 = 바깥 빛이 그대로 보이는 자리
	draw_circle(Vector2(0, cy), r, Color(색.r, 색.g, 색.b, 0.55 + 0.35 * _닫힘()))
	# 찢어진 테두리 — 정원이 아니라 들쭉날쭉해야 "구멍" 으로 읽힌다
	var 테 := PackedVector2Array()
	for i in 14:
		var a := TAU * float(i) / 14.0
		var 들쭉 := r * (1.0 + 0.16 * sin(a * 3.0 + 1.1) + 0.09 * sin(a * 5.0))
		테.append(Vector2(cos(a) * 들쭉, cy + sin(a) * 들쭉))
	테.append(테[0])
	draw_polyline(테, Color(0.05, 0.05, 0.06, 0.85), 3.0)
