extends Node
## ============================================================================
## [2026-08-08 신규] 챕터 앰비언스 — "BGM 의 톤이 바뀐다"
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 기획)
##   "화면이 암전된 후 다음 스테이지가 짜잔 하고 밝아지면, **배경음악(BGM)의 톤이 바뀌며**
##    새로운 물리 환경이나 위험한 함정이 눈앞에 나타납니다."
##   전환 연출에서 **소리가 안 바뀌면 절반은 안 바뀐 것**이다. 눈은 새 지역을 보는데
##   귀가 같은 곳에 있으면 "장소가 바뀌었다"가 아니라 "배경이 바뀌었다"로 읽힌다.
##
## ▣ 왜 음원 파일이 아니라 **직접 만드는 소리**인가
##   지금 프로젝트에 음원이 한 개도 없다(작업기록의 "사운드 4종" 은 계속 밀려 있는 공백).
##   음원을 기다리면 전환 연출이 통째로 미완성으로 남는다.
##   → `AudioStreamGenerator` 로 **낮은 드론(지속음)** 을 직접 합성한다.
##     · 챕터마다 기음·밝기·떨림이 다르다 → 톤이 확실히 바뀐다
##     · 파일이 0 바이트다 → 저장소도 안 무겁고 라이선스 문제도 없다
##     · 나중에 진짜 음원이 나오면 `음원_꽂기()` 로 갈아끼우면 된다(§교체)
##
## ▣ 왜 드론(지속음)인가 — 게임 톤과의 관계
##   림보·리틀 나이트메어·레인월드는 **선율이 거의 없다.** 공간의 웅웅거림과
##   가끔의 소음이 전부다. 선율이 붙는 순간 "게임 음악"이 되어 긴장이 풀린다.
##   그래서 여기서도 배음 몇 개를 아주 낮게 겹친 소리만 쓴다.
##
## ▣ 교체 — 진짜 음원이 생겼을 때
##   `음향.음원_꽂기(챕터번호, preload("res://assets/audio/ch2.ogg"))` 한 줄이면
##   그 챕터부터는 합성 대신 그 파일이 재생된다. 이 파일을 고칠 필요가 없다.
## ============================================================================
class_name 챕터음향

## 합성 품질. 드론은 저주파뿐이라 22kHz 로도 충분하고 CPU 를 크게 아낀다.
const 샘플레이트: float = 22050.0
## 한 번에 채워 넣는 버퍼 길이(초). 짧으면 끊기고, 길면 톤 전환이 늦게 들린다.
const 버퍼길이: float = 0.4
## 전체 음량(데시벨). 앰비언스라 아주 작게 깔린다.
const 기본_음량db: float = -22.0
## 챕터가 바뀔 때 톤이 옮겨가는 시간(초). 장면전환의 암흑 구간보다 길게 잡아
## **화면이 밝아질 때 이미 새 톤이 들리고 있게** 한다.
const 톤_전환시간: float = 2.2

## 진짜 음원이 꽂힌 챕터 목록 { 챕터번호: AudioStream }
static var _음원: Dictionary = {}

var _플레이어: AudioStreamPlayer = null
var _재생: AudioStreamGeneratorPlayback = null
var _음원플레이어: AudioStreamPlayer = null      ## 진짜 음원용 (합성과 따로 둔다)

# ── 합성 파라미터 (현재값 → 목표값으로 서서히 옮겨간다) ──────────────────────
var _기음: float = 55.0
var _밝기: float = 0.34
var _떨림: float = 0.06
var _목표기음: float = 55.0
var _목표밝기: float = 0.34
var _목표떨림: float = 0.06
var _전환속도: float = 0.0      ## 0 이면 즉시

var _위상: float = 0.0          ## 기음 위상 (0~1 로 감아 두면 float 정밀도가 안 무너진다)
var _위상2: float = 0.0
var _위상3: float = 0.0
var _lfo: float = 0.0
var _현재챕터: int = -1


# ── 바깥에서 쓰는 API ───────────────────────────────────────────────────────

## 진짜 음원을 꽂는다. 꽂힌 챕터는 합성 대신 이 스트림이 재생된다.
static func 음원_꽂기(챕터번호: int, 스트림: AudioStream) -> void:
	_음원[챕터번호] = 스트림


## 스테이지 트리 어디서든 하나만 존재하게 가져온다.
## ⚠ `get_tree().root` 에 붙인다 — 씬을 갈아끼워도 **소리가 안 끊겨야** 하기 때문이다.
##   스테이지 밑에 붙이면 씬 교체 때 소리가 툭 끊겨 전환이 통째로 어색해진다.
static func 준비(어디서든: Node) -> Node:
	var 루트 := 어디서든.get_tree().root
	var 이미 := 루트.get_node_or_null("챕터음향")
	if 이미:
		return 이미
	var n := 챕터음향.new()
	n.name = "챕터음향"
	# 일시정지 중에도 앰비언스는 계속 흐른다 (멈추면 "게임이 죽은" 느낌이 난다)
	n.process_mode = Node.PROCESS_MODE_ALWAYS
	루트.add_child(n)
	return n


## 챕터 톤으로 옮겨간다. 같은 챕터면 아무것도 하지 않는다(재시작 때 톤이 튀지 않게).
##   즉시 = true 면 페이드 없이 바로 바꾼다 (게임 처음 시작할 때)
func 챕터로(챕터번호: int, 즉시: bool = false) -> void:
	if 챕터번호 == _현재챕터:
		return
	_현재챕터 = 챕터번호
	var 팔 := 챕터.팔레트(챕터번호)
	_목표기음 = float(팔.get("기음", 55.0))
	_목표밝기 = float(팔.get("밝기", 0.34))
	_목표떨림 = float(팔.get("떨림", 0.06))
	_전환속도 = 0.0 if 즉시 else 1.0 / 톤_전환시간
	if 즉시:
		_기음 = _목표기음
		_밝기 = _목표밝기
		_떨림 = _목표떨림
	_음원_전환(챕터번호)


## 전환 도중 잠깐 소리를 죽인다 (암흑 구간). 0 = 무음, 1 = 평소.
## 화면이 까맣게 죽을 때 소리만 그대로면 "화면만 꺼진" 느낌이 난다.
func 음량비(비율: float) -> void:
	var v := clampf(비율, 0.0, 1.0)
	var db := 기본_음량db if v > 0.001 else -80.0
	if v > 0.001:
		db = 기본_음량db + linear_to_db(v)
	if _플레이어:
		_플레이어.volume_db = db
	if _음원플레이어:
		_음원플레이어.volume_db = db


func 현재_챕터() -> int:
	return _현재챕터


# ── 내부 ────────────────────────────────────────────────────────────────────

func _ready() -> void:
	var 생성 := AudioStreamGenerator.new()
	생성.mix_rate = 샘플레이트
	생성.buffer_length = 버퍼길이

	_플레이어 = AudioStreamPlayer.new()
	_플레이어.name = "드론"
	_플레이어.stream = 생성
	_플레이어.volume_db = 기본_음량db
	_플레이어.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_플레이어)
	_플레이어.play()
	_재생 = _플레이어.get_stream_playback() as AudioStreamGeneratorPlayback

	_음원플레이어 = AudioStreamPlayer.new()
	_음원플레이어.name = "음원"
	_음원플레이어.volume_db = 기본_음량db
	_음원플레이어.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_음원플레이어)

	set_process(true)


func _process(delta: float) -> void:
	# ── 톤을 목표값으로 옮긴다 ──
	if _전환속도 > 0.0:
		var t := minf(delta * _전환속도, 1.0)
		# 기음은 **비율로** 옮겨야 자연스럽다. 선형으로 옮기면 낮은 음에서
		# 음정이 뚝 떨어지는 것처럼 들린다(사람 귀는 주파수를 로그로 듣는다).
		_기음 = _기음 * pow(_목표기음 / maxf(_기음, 0.01), t)
		_밝기 = lerpf(_밝기, _목표밝기, t)
		_떨림 = lerpf(_떨림, _목표떨림, t)

	_버퍼_채우기()


## 남은 공간만큼 파형을 만들어 밀어 넣는다.
## ⚠ 헤드리스(더미 오디오 드라이버)에서는 `_재생` 이 null 일 수 있다.
##   여기서 막지 않으면 자동 테스트가 전부 죽는다.
func _버퍼_채우기() -> void:
	if _재생 == null or not _음원_비었나():
		return
	var 남음 := _재생.get_frames_available()
	if 남음 <= 0:
		return
	var 증분 := 1.0 / 샘플레이트

	for _i in 남음:
		_lfo = fmod(_lfo + 증분 * 0.11, 1.0)          # 아주 느린 흔들림 (약 9 초 주기)
		var 흔들 := 1.0 + sin(_lfo * TAU) * _떨림

		# 기음 + 완전5도 + 옥타브. 배음을 조금만 얹어 "웅웅"만 남긴다.
		_위상 = fmod(_위상 + 증분 * _기음 * 흔들, 1.0)
		_위상2 = fmod(_위상2 + 증분 * _기음 * 1.4983 * 흔들, 1.0)   # 5도(살짝 어긋나게)
		_위상3 = fmod(_위상3 + 증분 * _기음 * 2.0 * 흔들, 1.0)

		var v := sin(_위상 * TAU)
		v += sin(_위상2 * TAU) * 0.34 * _밝기
		v += sin(_위상3 * TAU) * 0.22 * _밝기
		# 부드럽게 눌러서 클리핑을 막는다 (tanh 대신 싸게)
		v = v / (1.0 + absf(v) * 0.6)
		v *= 0.55

		var f := Vector2(v, v)
		_재생.push_frame(f)


## 진짜 음원이 재생 중이면 합성은 쉬어야 한다 (둘이 겹치면 지저분해진다).
func _음원_비었나() -> bool:
	return _음원플레이어 == null or not _음원플레이어.playing


func _음원_전환(챕터번호: int) -> void:
	var 스트림: AudioStream = _음원.get(챕터번호, null)
	if _음원플레이어 == null:
		return
	if 스트림 == null:
		_음원플레이어.stop()
		return
	_음원플레이어.stream = 스트림
	_음원플레이어.play()
