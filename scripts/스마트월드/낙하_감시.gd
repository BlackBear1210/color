extends Node
## ============================================================================
## [2026-08-06 신규] 낙하 감시 — "일정 높이 이상 떨어지면 즉사"
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나
##   기존 월드.gd 는 `낙사_y` 라는 **절대 좌표 한 줄**로만 낙사를 판정했다.
##   그래서 "바닥이 뚫려 있는" 레인월드식 지형을 만들면 문제가 두 개 생긴다.
##     1. 구멍으로 떨어져도 낙사선(y=1500) 까지 한참을 낙하해야 죽는다 → 지루함
##     2. 반대로 낙사선을 위로 올리면 **깊은 방을 아예 만들 수 없다**
##   → 좌표가 아니라 **"얼마나 떨어졌나(낙하 거리)"** 로 판정하면 둘 다 해결된다.
##     깊은 수직 갱도도 만들 수 있고(계단식으로 내려가면 안전), 한 번에 쭉 떨어지면 죽는다.
##
## ▣ 규칙 (도형님 요청: "바닥이 뚫린건 좋은데 일정 높이 이상 떨어지면 바로 사망")
##   · 바닥에 닿아 있는 동안 **기준 높이**를 계속 갱신한다.
##   · 공중에 뜨면 그때부터 **가장 높이 올라갔던 지점(_최고점)** 을 기억한다.
##       (점프해서 올라갔다 떨어지면 "점프 꼭대기"부터 세는 게 맞다)
##   · 낙하거리 = 현재 y − _최고점 y.  이 값이 `치명_낙하거리` 를 넘는 **즉시** 사망.
##       착지할 때까지 기다리지 않는다 — 도형님 요청이 "바로 사망 판정" 이었다.
##   · 죽는 게 억울하지 않게, 위험 구간에 들어가면 화면 가장자리가 어두워진다(경고 비네트).
##
## ▣ 기본값을 왜 이 숫자로 잡았나 (플레이어 점프 성능에서 역산)
##   점프 높이 = 10칸 × 16px = 160px.  즉 "내 점프 높이의 3.25 배" = 520px.
##   · 130px 단차(레벨디자인 안전 수치)는 물론 안전
##   · 발판 3~4단(약 400px)을 실수로 놓쳐도 살아남는다
##   · 그보다 깊은 구멍은 "여긴 내려가면 안 되는 곳" 으로 읽힌다 = 레벨 언어가 생긴다
##   숫자 하나로 스테이지 전체의 긴장도가 바뀌므로 스테이지마다 조절할 수 있게 export 로 뺐다.
##
## ▣ 쓰는 법 (월드.gd 에서 두 줄)
##   var 감시 := preload("res://scripts/스마트월드/낙하_감시.gd").new()
##   add_child(감시); 감시.연결(플레이어)
##   ...  if 감시.치명적인가(): 리스폰()
## ============================================================================
class_name 낙하감시

## 이 거리(px)를 넘게 **한 번에** 떨어지면 즉사.
## 0 이하면 낙하 사망 자체를 끈다(디버그/제작 중 편의).
@export var 치명_낙하거리: float = 520.0

## 경고 비네트가 보이기 시작하는 지점(치명 거리에 대한 비율).
## 0.55 = 절반 조금 넘게 떨어졌을 때부터 화면이 조여든다.
@export_range(0.0, 1.0) var 경고_시작비율: float = 0.55

## 경고 비네트를 그릴지. 헤드리스 테스트나 컷신에서는 끌 수 있다.
@export var 경고_표시: bool = true

## 착지 직후·리스폰 직후 잠깐은 판정하지 않는다(순간이동·발사대 대응).
const 유예시간: float = 0.12

# ── 내부 상태 ──────────────────────────────────────────────────────────────
var _플레이어: CharacterBody2D = null
var _최고점: float = 0.0          ## 공중에 뜬 뒤 도달한 가장 높은 지점의 y (작을수록 높다)
var _공중: bool = false
var _유예: float = 0.0
var _낙하거리: float = 0.0

var _비네트: CanvasLayer = null
var _비네트_판: ColorRect = null
var _비네트_재질: ShaderMaterial = null

## 화면 가장자리만 어두워지는 비네트.
## ⚠ 전체를 어둡게 하면 "밝기 설정이 고장난 줄" 안다. 가장자리만 조여야
##   "떨어지고 있다 / 위험하다" 는 신호로 읽힌다(리틀 나이트메어의 낙하 연출 문법).
##
## ⚠⚠[2026-08-06 함정] **셰이더 코드에는 한글 식별자를 쓸 수 없다.**
##   GDScript 는 한글 변수명을 허용하지만 GDShader 의 토크나이저는 거부한다:
##       SHADER ERROR: Tokenizer: Unknown character #49464: '세'
##   그러면 셰이더가 통째로 컴파일 실패하고 **비네트가 조용히 안 나온다**
##   (게임은 안 죽어서 더 찾기 어렵다 — 실제로 레벨검사기가 잡아냈다).
##   → 셰이더 안은 전부 ASCII 로 쓰고, 설명만 한글 주석으로 단다.
const 비네트_셰이더 := "
shader_type canvas_item;
// strength : 0 = 평소(안 보임)  ~  1 = 죽기 직전
uniform float strength : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	// 화면 중심에서의 거리 — 가로세로 비율을 대충 보정해 원형에 가깝게 만든다
	vec2 d = (UV - vec2(0.5)) * vec2(1.15, 1.0);
	float r = length(d) * 1.45;
	// strength 가 커질수록 어두워지는 고리가 안쪽으로 파고든다
	float inner = mix(1.05, 0.16, strength);
	float a = smoothstep(inner, inner + 0.55, r) * strength;
	COLOR = vec4(0.0, 0.0, 0.0, clamp(a, 0.0, 0.94));
}
"


## 감시할 플레이어를 물려준다. 리스폰 때도 다시 부르면 상태가 초기화된다.
func 연결(플레이어: CharacterBody2D) -> void:
	_플레이어 = 플레이어
	초기화()


## 리스폰·씬 진입처럼 "낙하가 없었던 것으로 쳐야 하는" 순간에 부른다.
func 초기화() -> void:
	_공중 = false
	_낙하거리 = 0.0
	_유예 = 유예시간
	if _플레이어:
		_최고점 = _플레이어.global_position.y
	_비네트_갱신(0.0)


func _physics_process(delta: float) -> void:
	if _플레이어 == null or not is_instance_valid(_플레이어):
		return
	_유예 = maxf(_유예 - delta, 0.0)

	var y := _플레이어.global_position.y
	var 바닥 := bool(_플레이어.call("is_on_floor"))

	if 바닥:
		# 땅에 붙어 있는 동안은 계속 기준을 새로 잡는다.
		# (완만한 내리막을 걸어 내려가는 것은 낙하가 아니다)
		_최고점 = y
		_공중 = false
		_낙하거리 = 0.0
	else:
		if not _공중:
			_공중 = true
			_최고점 = y
		# y 는 아래로 갈수록 커진다 → 더 작은 값이 더 높은 지점
		_최고점 = minf(_최고점, y)
		_낙하거리 = maxf(y - _최고점, 0.0)

	_비네트_갱신(위험도())


## 지금 낙하로 죽어야 하는가.
func 치명적인가() -> bool:
	if 치명_낙하거리 <= 0.0 or _유예 > 0.0:
		return false
	return _낙하거리 > 치명_낙하거리


## 0(안전) ~ 1(죽기 직전). HUD·비네트·카메라 연출에 쓴다.
func 위험도() -> float:
	if 치명_낙하거리 <= 0.0:
		return 0.0
	var t := _낙하거리 / 치명_낙하거리
	if t <= 경고_시작비율:
		return 0.0
	return clampf((t - 경고_시작비율) / maxf(1.0 - 경고_시작비율, 0.01), 0.0, 1.0)


## 자동 테스트·디버그용 조회
func 낙하거리() -> float:
	return _낙하거리


# ── 경고 비네트 ────────────────────────────────────────────────────────────
func _비네트_갱신(세기: float) -> void:
	if not 경고_표시:
		return
	if _비네트 == null:
		_비네트_만들기()
	if _비네트_재질:
		_비네트_재질.set_shader_parameter("strength", 세기)   # ← 셰이더 유니폼은 ASCII
	if _비네트:
		# 세기가 0 이면 아예 안 그린다 (평소 프레임 낭비 방지)
		_비네트.visible = 세기 > 0.001


func _비네트_만들기() -> void:
	_비네트 = CanvasLayer.new()
	_비네트.name = "낙하경고"
	# HUD(기본 0)보다 위, 일시정지 메뉴(100)·씬전환(200)보다는 아래
	_비네트.layer = 50
	add_child(_비네트)

	var sh := Shader.new()
	sh.code = 비네트_셰이더
	_비네트_재질 = ShaderMaterial.new()
	_비네트_재질.shader = sh

	_비네트_판 = ColorRect.new()
	_비네트_판.name = "비네트"
	_비네트_판.material = _비네트_재질
	_비네트_판.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_비네트_판.set_anchors_preset(Control.PRESET_FULL_RECT)
	_비네트.add_child(_비네트_판)
	_비네트.visible = false
