@tool
extends StaticBody2D
## ============================================================================
## [2026-08-01 신규] 호퍼 — 물을 받아 배관으로 흘려보내는 깔때기
## ----------------------------------------------------------------------------
## ▣ 기획
##   · 색칠할 수 없다.
##   · **플랫폼처럼 밟을 수 있다.**
##   · 위에서 흐르는 물을 모아서 배관으로 연결한다.
##
## ▣ 동작
##   입구(위쪽 Area2D)에 물이 닿으면 `출구_유체` 를 켜고, 그 물의 색을 물려준다.
##   물이 끊기면 출구도 꺼진다. → "위에서 물이 오면 아래로 흘러나간다"가 눈에 보인다.
##   ⚠ 단, **끊겼다고 바로 끄지 않는다.** 아래 `끊김_유예` 주석을 반드시 읽을 것 —
##     이걸 0 으로 되돌리면 2026-09-07 에 잡은 "물이 계속 점멸한다" 버그가 그대로 돌아온다.
##
## ▣ 물줄기 굵기·길이는 **호퍼 인스펙터 네 칸**에서 전부 조절한다 (2026-09-07)
##   입구 물줄기 모양 : `입구_물줄기_폭` · `입구_물줄기_길이`   (들어오는 물)
##   출구 물줄기 모양 : `출구_물줄기_폭` · `출구_물줄기_길이`   (나가는 물)
##   -1 = "그 물이 가진 값을 그대로 둔다". 입구는 둘 다 -1 이 기본이라 아무것도 안 건드린다.
##   ⚠ 들어오는 물을 너무 짧게 줄이면 입구 감지에 안 닿아 **호퍼가 조용히 멈춘다.**
##     그 경우 씬 독에 노란 경고가 뜬다(`_get_configuration_warnings`).
## ============================================================================
class_name 호퍼

@export var 폭: float = 120.0:
	set(v): 폭 = maxf(v, 32.0); _다시_만들기()
@export var 높이: float = 56.0:
	set(v): 높이 = maxf(v, 16.0); _다시_만들기()

## 이 호퍼가 채우는 유체(보통 아래로 내려가는 물줄기). 비우면 출구 포트로 자동 탐색한다.
@export var 출구_유체: NodePath

## 호퍼 아래 물은 유체의 `크기`로 그려진다. 원본 물 그림의 투명 가장자리 때문에
## 64px 폭은 실제로 더 가늘어 보이므로, 맵 제작자가 호퍼만 골라 바로 보정할 수 있게 둔다.
## 길이 -1은 출구 유체 인스턴스에 설정한 기존 길이를 그대로 쓴다는 뜻이다.
##
## ★[2026-09-07] 폭에도 **-1**(= 손대지 않음)을 넣을 수 있게 했다.
##   예전에는 폭에 -1 이 없어서 **항상** 출구 유체의 `크기.x` 를 덮어썼다.
##   그래서 유체 노드에서 폭을 아무리 바꿔도 게임을 켜면 호퍼가 64 로 되돌려 놨다.
##   기본값은 64 그대로라 지금까지 놓은 호퍼의 동작은 하나도 안 바뀐다.
@export_group("출구 물줄기 모양")
@export_range(-1.0, 512.0, 1.0) var 출구_물줄기_폭: float = 64.0:
	set(v):
		출구_물줄기_폭 = clampf(v, -1.0, 512.0)
		_출구_물줄기_크기_갱신()
@export_range(-1.0, 2400.0, 1.0) var 출구_물줄기_길이: float = -1.0:
	set(v):
		출구_물줄기_길이 = clampf(v, -1.0, 2400.0)
		_출구_물줄기_크기_갱신()
@export_group("")

## ★[2026-09-07 신규 — 도형님 지시] "호퍼로 **들어오는** 물의 길이와 양,
##   호퍼에서 **나오는** 물의 길이와 양을 따로 조절할 거야."
##
## ▣ 왜 필요했나
##   나가는 물은 위 `출구 물줄기 모양` 으로 호퍼에서 바로 조절할 수 있었는데,
##   **들어오는 물은 손잡이가 아예 없었다.** 씬 트리에서 그 물 노드를 직접 찾아
##   `크기` 를 고쳐야 했고, 호퍼가 어느 물을 먹고 있는지도 인스펙터만 봐서는 알 수 없었다.
##   → 들어오는 쪽에도 같은 손잡이를 달아 **네 값을 한 자리에서** 만지게 한다.
##
## ▣ 기본값이 왜 둘 다 -1 인가 (출구의 폭 64 와 다르다)
##   -1 = **손대지 않는다.** 지금까지 놓아둔 호퍼 여덟 개는 들어오는 물을 건드린 적이
##   없으므로, 기본이 -1 이어야 이 항목이 생겨도 기존 맵이 한 픽셀도 안 바뀐다.
##
## ⚠⚠ 들어오는 물을 **너무 짧게 줄이면 호퍼가 멈춘다.**
##   호퍼는 윗면 위 감지 영역(`입구`)에 물이 닿아야 출구를 켠다. 물이 그 위에서 끊기면
##   화면에는 물이 멀쩡히 보이는데 아래로는 한 방울도 안 나간다.
##   → 얼마나 있어야 닿는지는 `입구까지_필요한_길이()` 가 계산해 주고,
##     모자라면 씬 독에 노란 경고가 뜬다(`_get_configuration_warnings`).
@export_group("입구 물줄기 모양")
## 호퍼로 들어오는 물. 비워두면 입구 감지 영역에 실제로 겹친 물을 자동으로 찾는다.
@export var 입구_유체: NodePath:
	set(v):
		입구_유체 = v
		_입구_물줄기_크기_갱신()
		update_configuration_warnings()
## -1 이면 그 물이 가진 폭을 그대로 둔다.
@export_range(-1.0, 512.0, 1.0) var 입구_물줄기_폭: float = -1.0:
	set(v):
		입구_물줄기_폭 = clampf(v, -1.0, 512.0)
		_입구_물줄기_크기_갱신()
## -1 이면 그 물이 가진 길이를 그대로 둔다. ⚠ 줄일 때는 위 경고를 반드시 읽을 것.
@export_range(-1.0, 2400.0, 1.0) var 입구_물줄기_길이: float = -1.0:
	set(v):
		입구_물줄기_길이 = clampf(v, -1.0, 2400.0)
		_입구_물줄기_크기_갱신()
		update_configuration_warnings()
@export_group("")

## 2D 작업 화면에서 물줄기 시작점이 출구_포트에 닿으면 NodePath를 고르지 않아도 자동 연결한다.
@export_group("출구 포트 자동 연결")
@export var 자동_출구_연결: bool = true
@export_range(8.0, 128.0, 1.0) var 포트_연결거리: float = 36.0
@export_group("")

## ★★[2026-09-07 버그 수정 — 도형님 제보 "호퍼에서 나오는 물이 계속 점멸해"]
##
## ▣ 무엇이 깜빡였나
##   stage_2-3 의 호퍼 **네 개가 동시에** 초당 여러 번 켜졌다 꺼졌다 했다.
##   끄는 순간의 로그가 전부 `받은색=-1, 겹치는 영역 0개` 였다 —
##   위에서 물이 멀쩡히 쏟아지고 있는데 **겹침 목록이 통째로 비는** 프레임이 있다는 뜻이다.
##
## ▣ 왜 비나 (원인은 호퍼가 아니라 물 쪽이다)
##   물 판정은 **그림 실루엣 폴리곤**이라 애니메이션 프레임마다 모양이 다르다
##   (`유체.gd::_물_판정_갱신()` · 8fps). 그래서 8 분의 1 초마다
##   `CollisionPolygon2D.polygon` 을 다시 넣는데, Godot 은 그때
##   **`shape_owner_clear_shapes()` 로 도형을 싹 지우고 새로 단다.**
##   도형이 지워지는 순간 Area2D 끼리 맺어둔 **겹침 쌍이 끊어지고**, 다시 맺히는 데
##   물리 프레임이 한두 번 걸린다. 그 사이에 호퍼가 "물이 끊겼다"고 읽은 것이다.
##   → 물 넷이 같은 8fps 시계를 쓰니 **호퍼 넷이 동시에** 깜빡였다.
##
## ▣ 그래서 여기서 고친다 — 유예를 둔다
##   물 쪽에서 고치려면 실루엣 판정을 포기해야 하는데, 그건 "보이는 것과 닿는 것이 같다"는
##   2026-09-02 의 결정을 되돌리는 일이다(`유체.gd` 머리말). 물은 그대로 두고,
##   **호퍼가 한두 프레임 끊긴 것을 물이 끊긴 것으로 안 세게** 한다.
##   0.30 초는 8fps 한 칸(0.125 초)의 두 배가 넘어 어떤 재생성 틈보다도 길고,
##   레버로 물을 잠갔을 때 "관에 남은 물이 빠지는" 정도로만 늦다.
@export_range(0.0, 2.0, 0.05) var 끊김_유예: float = 0.30

## 켜면 겹침 상태를 콘솔에 계속 찍는다. 이번 같은 점멸을 다시 만났을 때만 켠다.
## ⚠ 기본을 꺼짐으로 둔 이유 — 호퍼가 여섯 개인 스테이지에서 **초당 여섯 줄**이 쏟아져
##   정작 봐야 할 로그가 묻힌다.
@export var 디버그_로그: bool = false

var _입구: Area2D
var _출구: 유체 = null
var _수동_출구: bool = false

## 마지막으로 실제로 받은 색. 유예 동안에는 이 색을 유지한다(-1 = 아직 못 받음).
var _마지막_받은색: int = -1
## 물이 안 잡힌 채로 흐른 시간(초). `끊김_유예` 를 넘어야 진짜로 끊긴 것으로 친다.
var _끊긴시간: float = 0.0


func _ready() -> void:
	collision_layer = 1               # 밟을 수 있다
	collision_mask = 0
	_다시_만들기()
	if Engine.is_editor_hint():
		queue_redraw()
		return
	add_to_group("호퍼")
	if not 출구_유체.is_empty():
		_출구 = get_node_or_null(출구_유체) as 유체
		_수동_출구 = _출구 != null
		if _출구 == null:
			push_warning("[호퍼:%s] 출구_유체 경로(%s)에서 유체 노드를 못 찾음" % [name, 출구_유체])
	if _출구 == null and 자동_출구_연결:
		_출구 = _포트에_닿은_유체_찾기()
	if _출구:
		_출구.켜짐 = false             # 물이 들어오기 전엔 꺼둔다
		_출구_물줄기_크기_갱신()
	# ★[2026-09-07] 들어오는 물의 모양도 여기서 한 번 반영한다.
	#   ⚠ 출구보다 **먼저 하면 안 된다** — 자동 연결일 때 입구 물과 출구 물이 같은 노드로
	#     잡히는 배치가 있을 수 있는데, 그때는 출구 설정이 이기는 게 맞다(호퍼의 본업이 출구다).
	_입구_물줄기_크기_갱신()
	# 자동 포트는 다른 노드의 _ready 순서보다 늦게 발견될 수 있어, 출구가 아직 없어도 검사한다.
	set_physics_process(_출구 != null or 자동_출구_연결)
	queue_redraw()


## 수동 NodePath를 쓰는 호퍼는 에디터에서도 바로 출구 유체를 찾을 수 있다.
## 그래서 게임을 실행하지 않아도 인스펙터의 폭·길이 값을 바꾸는 즉시 물 그림이 갱신된다.
func _출구_물줄기_크기_갱신() -> void:
	var 대상 := _출구
	if 대상 == null and not 출구_유체.is_empty() and is_inside_tree():
		대상 = get_node_or_null(출구_유체) as 유체
	if 대상 == null:
		return
	var 새크기 := 대상.크기
	if 출구_물줄기_폭 >= 0.0:          # -1 = 유체가 가진 폭을 그대로 둔다
		새크기.x = 출구_물줄기_폭
	if 출구_물줄기_길이 >= 0.0:
		새크기.y = 출구_물줄기_길이
	if 대상.크기 != 새크기:
		대상.크기 = 새크기


# ── 입구 물줄기 ─────────────────────────────────────────────────────────────
## 들어오는 물을 찾는다. `입구_유체` 를 지정했으면 그것, 아니면 감지 영역에 겹친 물.
## ⚠ 자동 탐색은 **감지 영역과 실제로 겹쳐 있어야** 찾는다. 그래서 물이 짧아서 안 닿으면
##   여기서도 null 이 나온다 — 그게 곧 "호퍼가 못 먹는다"는 뜻이라 경고로 이어진다.
func 입구_유체_찾기() -> 유체:
	if not is_inside_tree():
		return null
	if not 입구_유체.is_empty():
		return get_node_or_null(입구_유체) as 유체
	if _입구 != null and _입구.monitoring:
		for a in _입구.get_overlapping_areas():
			var f := a as 유체
			if f != null and f.종류 == 유체.종류_.물:
				return f
	# 에디터에서는 겹침 목록이 안 채워진다(물리를 안 돌린다).
	# → 감지 영역 사각형과 물의 사각형이 겹치는지 좌표로 직접 본다.
	var 영역 := 입구_감지범위_월드()
	for f2: 유체 in _모든_물():
		var 위: Vector2 = f2.global_position
		var 물 := Rect2(위.x - f2.크기.x * 0.5, 위.y, f2.크기.x, f2.크기.y)
		if 영역.intersects(물):
			return f2
	return null


## 씬 안의 물 전부.
## ⚠ 에디터에서는 **그룹을 쓸 수 없다** — `유체.gd::_ready()` 가 에디터면 `add_to_group`
##   앞에서 되돌아가기 때문이다. 그룹만 믿으면 에디터에서 물을 하나도 못 찾아
##   멀쩡한 호퍼마다 가짜 경고가 뜬다. 그래서 에디터에서는 씬을 직접 훑는다.
func _모든_물() -> Array:
	if not Engine.is_editor_hint():
		return get_tree().get_nodes_in_group("유체")
	var 뿌리: Node = self
	while 뿌리.get_parent() != null:
		뿌리 = 뿌리.get_parent()
	var 결과: Array = []
	_물_모으기(뿌리, 결과)
	return 결과


func _물_모으기(n: Node, 결과: Array) -> void:
	for c in n.get_children():
		if c is 유체 and (c as 유체).종류 == 유체.종류_.물:
			결과.append(c)
		_물_모으기(c, 결과)


## 입구 감지 영역(`_다시_만들기` 가 만드는 Area2D)의 월드 사각형.
## ⚠ 여기 숫자는 `_다시_만들기()` 의 것과 **반드시 같아야 한다.**
##   한쪽만 고치면 "경고는 없는데 물이 안 들어온다"가 되어 찾기가 아주 어려워진다.
func 입구_감지범위_월드() -> Rect2:
	var 감지폭 := 폭 * 0.9
	var 중심y := global_position.y - 높이 - 39.0
	return Rect2(global_position.x - 감지폭 * 0.5, 중심y - 45.0, 감지폭, 90.0)


## 들어오는 물이 감지 영역에 닿으려면 최소 몇 px 이어야 하는가.
## 물의 원점은 **윗끝**이고 아래로 `크기.y` 만큼 뻗는다 → 아랫끝이 영역 윗변을 넘어야 한다.
## 대상이 없으면 -1.
func 입구까지_필요한_길이() -> float:
	var 물 := 입구_유체_찾기()
	if 물 == null:
		return -1.0
	return maxf(입구_감지범위_월드().position.y - 물.global_position.y, 0.0)


func _입구_물줄기_크기_갱신() -> void:
	if 입구_물줄기_폭 < 0.0 and 입구_물줄기_길이 < 0.0:
		return                          # 둘 다 -1 = 아무것도 안 건드린다 (기본값)
	var 대상 := 입구_유체_찾기()
	if 대상 == null:
		return
	var 새크기 := 대상.크기
	if 입구_물줄기_폭 >= 0.0:
		새크기.x = 입구_물줄기_폭
	if 입구_물줄기_길이 >= 0.0:
		새크기.y = 입구_물줄기_길이
	if 대상.크기 != 새크기:
		대상.크기 = 새크기


## 씬 독에 노란 경고로 뜬다. **이 부품에서 조용히 망가지는 유일한 길**이 여기다 —
## 들어오는 물이 감지 영역에 안 닿으면, 화면에는 물이 멀쩡히 보이는데 아래로는 안 나간다.
func _get_configuration_warnings() -> PackedStringArray:
	var 경고 := PackedStringArray()
	if not is_inside_tree():
		return 경고
	# ⚠ "물을 못 찾았다"는 **경고하지 않는다.** 호퍼는 물 없이 발판으로만 쓰는 자리가 있다
	#   (2-3 의 `H7_대기좌` · `H8_대기우`). 거기까지 노랗게 칠하면 경고가 잡음이 되어
	#   정작 진짜 경고를 안 보게 된다. 길이가 모자란 경우만 — 즉 **물이 있는데 안 닿는**
	#   경우만 짚는다. 그게 조용히 망가지는 유일한 길이다.
	var 물 := 입구_유체_찾기()
	if 물 != null:
		var 필요 := 입구까지_필요한_길이()
		if 물.크기.y < 필요:
			경고.append(
				"들어오는 물(%s)이 짧아서 입구에 안 닿는다 — 지금 %.0fpx · 최소 %.0fpx 필요. "
				% [물.name, 물.크기.y, 필요]
				+ "이대로면 화면에는 물이 보이는데 출구로는 한 방울도 안 나간다.")
	elif not 입구_유체.is_empty():
		경고.append("`입구_유체` 경로(%s)에서 유체 노드를 못 찾았다." % 입구_유체)
	if 출구_유체.is_empty() and not 자동_출구_연결:
		경고.append("`출구_유체` 가 비었는데 `자동_출구_연결` 도 꺼져 있다 — 나갈 물이 없다.")
	return 경고


## [디버그전용] 1초마다 입구가 실제로 뭘 감지하고 있는지 찍는다.
## "물이 안 들어오는 것 같다"는 제보 원인 확인용 — 겹치는 유체가 0개인지,
## 겹치는데도 종류/색이 안 맞는지 구분할 수 있다.
var _디버그_누적: float = 0.0


func _다시_만들기() -> void:
	if not is_inside_tree():
		return
	# 밟는 면 — 깔때기 윗면만 단단하다 (안쪽은 뚫려 있어야 물이 통과하는 느낌)
	var c := get_node_or_null("윗면") as CollisionShape2D
	if c == null:
		c = CollisionShape2D.new()
		c.name = "윗면"
		add_child(c)
	var r := c.shape as RectangleShape2D
	if r == null:
		r = RectangleShape2D.new()
		c.shape = r
	r.size = Vector2(폭, 12.0)
	c.position = Vector2(0, -높이 + 6.0)

	# 입구 감지 영역 — 윗면 바로 위
	_입구 = get_node_or_null("입구") as Area2D
	if _입구 == null:
		_입구 = Area2D.new()
		_입구.name = "입구"
		var ic := CollisionShape2D.new()
		ic.name = "모양"
		ic.shape = RectangleShape2D.new()
		_입구.add_child(ic)
		add_child(_입구)
	_입구.collision_layer = 0
	_입구.collision_mask = 32          # 유체만 본다
	var ish := (_입구.get_node("모양") as CollisionShape2D).shape as RectangleShape2D
	# ★[2026-08-06 수정] 원래 세로 40px 짜리라, 위에서 내려오는 물줄기를 몇 px 만 헐겁게
	# 배치해도 아예 안 겹쳐서 영원히 감지가 안 되는 문제가 있었다(제보: "확인불가",
	# 실측 로그로 "입구 겹침 0개" 확인). 깔때기 윗면 높이는 그대로 두고, 감지 영역만
	# 위로 넉넉히(90px) 뻗게 해서 물줄기 배치가 어느 정도 어긋나도 겹치게 만든다.
	ish.size = Vector2(폭 * 0.9, 90.0)
	(_입구.get_node("모양") as CollisionShape2D).position = Vector2(0, -높이 - 39.0)
	var 출구포트 := get_node_or_null("출구_포트") as Marker2D
	if 출구포트 != null:
		# 호퍼의 원점 자체가 좁아진 아래 출구다. 물줄기의 시작점을 여기에 스냅해 둔다.
		출구포트.position = Vector2.ZERO
	queue_redraw()
	# 폭·높이가 바뀌면 입구 감지 영역도 같이 움직인다 → 경고를 다시 계산한다.
	update_configuration_warnings()


func _physics_process(delta: float) -> void:
	if Engine.is_editor_hint() or _입구 == null:
		return
	if 자동_출구_연결 and not _수동_출구:
		var 자동출구 := _포트에_닿은_유체_찾기()
		if 자동출구 != _출구:
			if _출구 != null:
				_출구.켜짐 = false
			_출구 = 자동출구
	if _출구 == null:
		return
	var 받은색 := -1
	var 겹치는_영역 := _입구.get_overlapping_areas()
	for a in 겹치는_영역:
		var f := a as 유체
		if f and f.켜짐 and f.종류 == 유체.종류_.물:
			받은색 = f.색 if 받은색 < 0 else 유체.섞기(받은색, f.색)

	# ★[2026-09-07] 한두 프레임 안 잡힌 것을 "물이 끊겼다"로 세지 않는다.
	#   왜 필요한지는 위 `끊김_유예` 의 주석 참고 — 물 판정이 8fps 로 다시 구워지면서
	#   겹침 쌍이 잠깐 끊어지는 것을, 예전에는 그대로 믿어서 물이 점멸했다.
	if 받은색 >= 0:
		_마지막_받은색 = 받은색
		_끊긴시간 = 0.0
	else:
		_끊긴시간 += delta

	var 켤까 := _마지막_받은색 >= 0 and _끊긴시간 < 끊김_유예
	if not 켤까:
		_마지막_받은색 = -1          # 진짜로 끊겼다 → 다음에 다시 받을 때까지 색도 잊는다

	if _출구.켜짐 != 켤까:
		if 디버그_로그:
			print("[호퍼:%s] 출구 %s (받은색=%d · 유지색=%d · 끊긴 %.2f초 · 겹침 %d개)" % [
				name, ("켬" if 켤까 else "끔"), 받은색, _마지막_받은색, _끊긴시간, 겹치는_영역.size()])
		_출구.켜짐 = 켤까
	# ⚠ 유예 중에는 `받은색` 이 -1 이다. 그걸 그대로 쓰면 물빛이 검정(0)으로 튄다.
	#   반드시 **마지막으로 실제로 받은 색**을 쓴다.
	if 켤까 and _마지막_받은색 >= 0 and _출구.색 != _마지막_받은색:
		_출구.색 = _마지막_받은색

	if 디버그_로그:
		_디버그_누적 += delta
		if _디버그_누적 >= 1.0:
			_디버그_누적 = 0.0
			var 목록 := []
			for a in 겹치는_영역:
				목록.append("%s(유체=%s)" % [a.name, a is 유체])
			print("[호퍼:%s] 입구 겹침 %d개: %s" % [name, 겹치는_영역.size(), 목록])


## 유체의 원점은 물이 시작되는 출구다. 포트 중심에서 허용 거리 안인 물만 고른다.
## 이렇게 해야 호퍼 옆을 지나가는 물줄기가 우연히 가까워도 출구로 잘못 잡히지 않는다.
func _포트에_닿은_유체_찾기() -> 유체:
	if not 자동_출구_연결 or not is_inside_tree():
		return null
	var 포트 := get_node_or_null("출구_포트") as Marker2D
	if 포트 == null:
		return null
	var 가장가까운: 유체 = null
	var 최소거리제곱 := 포트_연결거리 * 포트_연결거리
	for 노드 in get_tree().get_nodes_in_group("유체"):
		var 후보 := 노드 as 유체
		if 후보 == null or 후보.종류 != 유체.종류_.물:
			continue
		var 거리제곱 := 포트.global_position.distance_squared_to(후보.시작점_월드좌표())
		if 거리제곱 <= 최소거리제곱:
			가장가까운 = 후보
			최소거리제곱 = 거리제곱
	return 가장가까운


