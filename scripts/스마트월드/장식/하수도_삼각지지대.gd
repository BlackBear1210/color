@tool
extends Node2D
## ============================================================================
## [2026-09-14 신규] 하수도 삼각 지지대(까치발) — 고정 발판 밑에 붙는 벽 고정 철재 장식
## ----------------------------------------------------------------------------
## ▣ 무엇인가
##   "이 발판은 뒤쪽 벽에 볼트로 고정돼 있다" 를 보여 주는 그림. 벽판(세로) + 가로대 + 대각대 + 볼트.
##   충돌·색 규칙·게임 그룹이 없다. 발판을 흰색으로 칠해도 지지대는 금속 그대로다(정상).
##
## ▣ 원점 = 발판 **밑면이 벽에 닿는 모서리** (프롬프트 §7-3)
##   왼쪽 벽이면 발판 왼쪽 아래 모서리에, 오른쪽 벽이면 오른쪽 아래 모서리에 원점을 맞춘다.
##   가로대가 벽돌 밑면 뒤로 `부착_오프셋.y`(기본 −4) 만큼 들어가 접합부가 가려진다.
##   발판의 **자식**으로 넣으면 발판을 옮겨도 따라온다.
##
## ▣ 방향
##   그림은 왼쪽 벽용 한 장이고, 오른쪽은 자식 Sprite 의 flip_h 로 만든다(프롬프트 §7-2).
##   게임 지형의 Scale.x 를 −1 로 뒤집는 방식은 쓰지 않는다 — 지형 충돌·색 판정이 같이 뒤집힌다.
##   명암은 좌우 대칭에 가깝게 그려 두어 뒤집어도 어색하지 않다.
##
## ▣ 크기
##   `배율` 은 **균일 확대만** 0.75~1.5. 폭만·높이만 늘리면 볼트가 타원이 되므로 막아 두었다.
##   넓은 발판은 같은 지지대를 두 개 놓는다(시험 씬 3 번). 경사 발판 밑 자동 각도 보정은 **미지원** —
##   수평 밑면에만 붙인다.
##
## ▣ 어디에 쓰면 안 되나
##   승강기(움직이는 발판)에는 붙이지 않는다 — "벽에 박혀 있는데 움직이는" 모순. 승강기엔 쇠사슬.
## ============================================================================

const 기본_텍스처 := "res://assets/decorations/sewer_support_v01/bracket.png"

enum 방향_ { 왼쪽벽, 오른쪽벽 }

## 벽이 어느 쪽에 있나. 오른쪽벽이면 그림을 좌우로 뒤집고 원점도 발판 오른쪽 아래 모서리가 된다.
@export var 방향: 방향_ = 방향_.왼쪽벽:
	set(v):
		방향 = v
		_배치()
## 균일 배율. 0.75~1.5 밖은 잘라낸다(철재 두께·볼트 크기를 지키기 위해).
@export_range(0.75, 1.5, 0.05) var 배율: float = 1.0:
	set(v):
		배율 = clampf(v, 0.75, 1.5)
		_배치()
## 발판 밑면에 맞추는 미세 이동(원점 기준). y 음수 = 가로대가 벽돌 밑면 뒤로 들어간다.
@export var 부착_오프셋: Vector2 = Vector2(0, -4):
	set(v):
		부착_오프셋 = v
		_배치()
@export var 텍스처: Texture2D:
	set(v):
		텍스처 = v
		_배치()
## 인스턴스마다 다르게 줄 수 있는 색조(공유 텍스처는 안 바뀐다).
@export var 색조: Color = Color(1, 1, 1, 1):
	set(v):
		색조 = v
		_배치()

var _그림: Sprite2D = null


func _ready() -> void:
	if 텍스처 == null:
		텍스처 = load(기본_텍스처)
	_배치()


## 자식 Sprite 를 찾거나(씬에 있음) 없으면 만든다. 에디터에서 만든 것은 씬 루트에 저장되게 owner 를 준다.
## ⚠ 이미 있는 노드에는 owner 를 다시 박지 않는다(CLAUDE.md §6).
func _그림_준비() -> Sprite2D:
	if _그림 != null and is_instance_valid(_그림):
		return _그림
	_그림 = get_node_or_null("그림") as Sprite2D
	if _그림 == null:
		_그림 = Sprite2D.new()
		_그림.name = "그림"
		add_child(_그림)
		if Engine.is_editor_hint() and owner != null:
			_그림.owner = owner
	return _그림


func _배치() -> void:
	if not is_inside_tree():
		return
	var s := _그림_준비()
	s.texture = 텍스처
	s.modulate = 색조
	s.flip_h = 방향 == 방향_.오른쪽벽
	if 텍스처 == null:
		return
	# 고해상도 아트로 교체해도 기존 96px 부착 범위와 볼트 배치를 유지한다.
	s.scale = Vector2(96, 96) / 텍스처.get_size() * 배율
	var 크기 := Vector2(96, 96) * 배율
	# 그림의 왼쪽 위(벽 쪽 모서리)가 원점에 오게. 오른쪽벽이면 오른쪽 위가 원점.
	var 중심 := Vector2(크기.x * 0.5 * (-1.0 if 방향 == 방향_.오른쪽벽 else 1.0), 크기.y * 0.5)
	s.position = 중심 + 부착_오프셋
	# 발판(z 0)보다 뒤에 그린다 — 착지면을 가리지 않는다(프롬프트 §8).
	s.z_index = -1
	s.z_as_relative = true


## 지금 그림이 차지하는 사각형(월드). 검사기가 두 지지대가 겹치는지 볼 때 쓴다.
func 그림_사각_월드() -> Rect2:
	var s := _그림_준비()
	if s.texture == null:
		return Rect2(global_position, Vector2.ZERO)
	var 크기 := s.texture.get_size() * s.scale.abs()
	var 왼위 := s.global_position - 크기 * 0.5
	return Rect2(왼위, 크기)
