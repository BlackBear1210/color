# ============================================================================
# 조회
# ============================================================================
static func 스테이지_수() -> int:
	return 스테이지표.size()


## 번호로 스테이지 정보를 찾는다. 없으면 빈 사전.
static func 정보(번호: int) -> Dictionary:
	for s in 스테이지표:
		if int(s["번호"]) == 번호:
			return s
	return {}


## 표에서 몇 번째 줄인지. 없으면 −1.
static func 자리(번호: int) -> int:
	for i in 스테이지표.size():
		if int(스테이지표[i]["번호"]) == 번호:
			return i
	return -1


## ★[2026-08-30] 씬 경로를 이름 규칙으로 조립하지 않고 **표에서 읽는다.**
##   집 4 스테이지는 `스마트월드_<번호>` 규칙을 안 따르기 때문이다.
##   표에 없는 번호면 빈 문자열 — 부르는 쪽이 `is_empty()` 로 걸러야 한다.
static func 씬경로(번호: int) -> String:
	var s := 정보(번호)
	return String(s.get("씬", "")) if not s.is_empty() else ""


## 다음 스테이지 번호. 마지막이면 −1.
static func 다음_번호(번호: int) -> int:
	var i := 자리(번호)
	if i < 0 or i + 1 >= 스테이지표.size():
		return -1
	return int(스테이지표[i + 1]["번호"])


## 이전 스테이지 번호. 처음이면 −1.
static func 이전_번호(번호: int) -> int:
	var i := 자리(번호)
	if i <= 0:
		return -1
	return int(스테이지표[i - 1]["번호"])


static func 챕터번호(번호: int) -> int:
	var s := 정보(번호)
	return int(s.get("챕터", 1)) if not s.is_empty() else 1


## 챕터 팔레트. 없는 챕터면 1 번 것을 쓴다.
static func 팔레트(챕터_: int) -> Dictionary:
	return 챕터표.get(챕터_, 챕터표[1])


## 이 스테이지의 팔레트 (챕터를 거쳐 조회).
static func 스테이지_팔레트(번호: int) -> Dictionary:
	return 팔레트(챕터번호(번호))


## 두 스테이지 사이에서 **챕터가 바뀌는가**.
## 전환 연출(암전 vs 섬광·정적 길이·BGM 톤 전환)이 이 한 줄로 갈린다.
static func 챕터_바뀌나(현재: int, 다음: int) -> bool:
	if 현재 < 0 or 다음 < 0:
		return false
	return 챕터번호(현재) != 챕터번호(다음)


## 씬 경로에서 스테이지 번호를 되찾는다 (`.../스테이지_2_복도계단.tscn` → 2).
## 씬이 자기 번호를 몰라도 되게 하려고 만들었다 — 파일 경로가 곧 신분증이다.
##
## ★[2026-08-30] 파일 이름을 쪼개 숫자를 뽑던 방식을 버리고 **표에서 역조회**한다.
##   집 스테이지 이름은 `스테이지_2_복도계단` 이라 예전 방식(맨 뒤 조각이 숫자)으로는
##   "복도계단" 이 나와 −1 이 됐다. 표가 유일한 출처라는 원칙에도 이쪽이 맞다.
static func 경로에서_번호(경로: String) -> int:
	var 파일 := 경로.get_file()
	for s in 스테이지표:
		if String(s.get("씬", "")).get_file() == 파일:
			return int(s["번호"])
	return -1


## 사람이 읽는 한 줄 — HUD·로그·일시정지 메뉴에 쓴다.
static func 표시이름(번호: int) -> String:
	var s := 정보(번호)
	if s.is_empty():
		return "스마트월드 %d" % 번호
	var c := 팔레트(int(s["챕터"]))
	return "챕터 %d %s · %s" % [int(s["챕터"]), c["이름"], s["이름"]]
