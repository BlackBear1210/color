## 유령별 칠할 색 — 1층 유령만 흰색(흰색 강제 구역 한가운데다).
const 유령색 := {
	"C_GHOST_SS_WOOD": 흰색,
	"STAIR_B2_GHOST_SS_WOOD": 흰색,
	"STAIR_D2_GHOST_SS_WOOD": 흰색,
}

var _루트: Node = null
var _p: CharacterBody2D = null
var _결과: Array = []


func _init() -> void:
	Engine.max_fps = 0
	call_deferred("_실행")


func _실행() -> void:
	_루트 = (load(씬경로) as PackedScene).instantiate()
	root.add_child(_루트)
	for i in 8:
		await physics_frame
	_p = _루트.get_node_or_null("Player")
	if _p == null:
		print("  ✗ Player 없음"); quit(1); return

	print("\n════════ STAGE 2 런타임 시험 ════════")
	for c in _루트.get_node("지형").get_children():
		var t := c as Node2D
		if t == null or not t.has_method("밟을_수_있나") or not bool(t.get("무색일때_통과")):
			continue
		var 색: int = int(유령색.get(t.name, 검정))
		for i in int(t.call("필요횟수")):
			t.call("명중", 색, t.global_position)
		print("  유령 %-26s → %s 로 칠함 · 밟을수있나=%s"
			% [t.name, "흰색" if 색 == 흰색 else "검정", t.call("밟을_수_있나")])
	for i in 4:
		await physics_frame
	print("")

	for c in 구간:
		await _한구간(c)

	var 통과 := 0
	print("\n──────────── 결과 ────────────")
	for r in _결과:
		if bool(r[1]):
			통과 += 1
		print("  %-30s %s   %s" % [r[0], "PASS  " if r[1] else "✗ FAIL", r[2]])
	print("  ─────────────────────────────")
	print("  %d / %d PASS" % [통과, _결과.size()])
	_거리_보고()
	print("════════════════════════════════\n")
	quit(0)


func _한구간(c: Array) -> void:
	var 이름: String = c[0]
	var 출발x: float = float(c[1])
	var 출발y: float = float(c[2])
	var 출발색: int = int(c[3])
	var 목표x: float = float(c[4])
	var 목표y: float = float(c[5])
	var 도착색: int = int(c[6])
	var 왼쪽으로 := 목표x < 출발x

	# ★출발 발판 색으로 선다. (도착색으로 미리 바꾸면 그 자리에서 즉사한다)
	_p.set("player_color", 출발색)
	_p.velocity = Vector2.ZERO
	_p.global_position = Vector2(출발x, 출발y - 40.0)
	await physics_frame
	var 섰나 := false
	for i in 120:
		await physics_frame
		if _p.is_on_floor():
			섰나 = true
			break
	if not 섰나:
		_결과.append([이름, false, "출발 발판에 서지 못했다 (%.0f, %.0f)"
			% [_p.global_position.x, _p.global_position.y]])
		return

	var 방향 := "move_left" if 왼쪽으로 else "move_right"
	Input.action_press(방향)
	var 올라가나 := 목표y < 출발y - 20.0
	var 뛰었나 := false
	var 공중 := 0
	var 색바꿈 := (출발색 == 도착색)
	var 닿았나 := false
	for i in 360:
		await physics_frame
		# ★올라가는 구간은 **단 앞에 다다랐을 때** 한 번 뛴다.
		#   출발점에서 미리 뛰면(첫 판) 그 점프가 헛되이 소모돼 다음 벽 앞에 서서 끝나고,
		#   바닥에 닿을 때마다 계속 뛰면(둘째 판) 과도하게 튀어 죽는다 — 둘 다 실측했다.
		var 단_앞인가 := absf(_p.global_position.x - 목표x) <= 170.0
		if 올라가나 and not 뛰었나 and _p.is_on_floor() and 단_앞인가:
			Input.action_press("jump")
			뛰었나 = true
		# ★공중에서 색을 바꾼다 — 이 스테이지의 핵심 조작
		if not _p.is_on_floor():
			공중 += 1
		else:
			공중 = 0
		# ★★색은 **정점을 지난 뒤**에 바꾼다.
		#   발판을 막 떠난 프레임에 바꾸면 `월드.gd::_사망_판정` 이 쓰는 접촉 여유 안에
		#   아직 출발 발판이 걸려 있어서 **그 자리에서 죽는다**(실측: 7 구간이 이걸로 FAIL).
		#   사람이 할 때도 "뛰고 나서 바꾼다" 가 정답이다.
		# ★★타이밍 정정 2 — "정점" 만으로는 부족했다(실측: 5 구간이 계속 죽었다).
		#   붙어 있는 두 블록 사이를 뛸 때는 정점에서도 **아직 출발 발판 바로 위**다.
		#   → 가로로 도착 발판에 들어섰거나(x 조건), 곧장 떨어지는 구간이면
		#     출발 높이에서 250 아래로 내려간 뒤에 바꾼다.
		var 지금x := _p.global_position.x
		var 가로_넘었나 := (지금x <= 목표x) if 왼쪽으로 else (지금x >= 목표x)
		var 충분히_떨어졌나 := _p.global_position.y > 출발y + 250.0
		if not 색바꿈 and 공중 >= 6 and (가로_넘었나 or 충분히_떨어졌나):
			_p.set("player_color", 도착색)
			색바꿈 = true
		if _p.is_on_floor() and absf(_p.global_position.y - 목표y) < 14.0:
			var x := _p.global_position.x
			if (왼쪽으로 and x <= 목표x + 80.0) or (not 왼쪽으로 and x >= 목표x - 80.0):
				닿았나 = true
				break
	Input.action_release(방향)
	Input.action_release("jump")
	await _프레임(8)
	_결과.append([이름, 닿았나, "(%.0f, %.0f) 기대 y %.0f"
		% [_p.global_position.x, _p.global_position.y, 목표y]])


func _프레임(n: int) -> void:
	for i in n:
		await physics_frame


## ★[STEP 12 §P] 실제 플레이어가 지나가는 **중심 경로의 누적 거리**를 잰다.
##   Bounding Box 가 아니라 "발이 실제로 지나간 길이" 다.
##   구간표의 출발→도착을 이어 붙여 수평·수직을 따로 합산한다.
func _거리_보고() -> void:
	var 수평 := 0.0
	var 수직 := 0.0
	var 이전 := Vector2(float(구간[0][1]), float(구간[0][2]))
	for c in 구간:
		var 시작 := Vector2(float(c[1]), float(c[2]))
		var 끝 := Vector2(float(c[4]), float(c[5]))
		# 앞 구간의 끝 → 이 구간의 시작 (같은 발판 위를 걸어간 거리)
		수평 += absf(시작.x - 이전.x)
		수직 += absf(시작.y - 이전.y)
		# 이 구간의 이동
		수평 += absf(끝.x - 시작.x)
		수직 += absf(끝.y - 시작.y)
		이전 = 끝
	print("\n──────────── 실제 플레이 경로 ────────────")
	print("  수평 누적 : %8.0f px" % 수평)
	print("  수직 누적 : %8.0f px" % 수직)
	print("  총 경로   : %8.0f px" % (수평 + 수직))
	print("  (STEP 10 = 10,620 · STEP 12 목표 ≥ 23,000)")
	print("══════════════════════════════════════════\n")
