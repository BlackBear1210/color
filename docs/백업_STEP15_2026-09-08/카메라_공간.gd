@tool
extends Area2D
## ============================================================================
## [2026-08-17 도형 · 신규] 카메라 공간 — "굴뚝에 들어가면 화면이 굴뚝이 된다"
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 요청 그대로)
##   "순간 이동(포탈) 방식처럼 화면이 툭 끊기며 전환되는 것은 원하지 않음."
##   "거실에서는 넓은 영역을 비추던 카메라가, 굴뚝 안으로 진입하는 순간
##    카메라의 이동 제한(Limit) 경계가 굴뚝의 좌우 벽에 딱 맞춰서 좁혀져야 함."
##   "플레이어가 굴뚝 내부에서 좌우로 움직여도 카메라가 굴뚝 벽 바깥(배경)을
##    절대 비추지 않도록 강제하는 구조."
##
##   기존 시스템으로는 이게 안 됐다. `카메라_구역.gd` 는 **x 축만** 나눈다
##   (구역을 x 오름차순으로 줄 세워 플레이어 x 로 섞는다). 굴뚝은 같은 x 에서
##   위아래로 900px 을 오르는 공간이라, x 로는 표현할 방법이 아예 없다.
##   → **면적으로 정의되는 공간**이 필요하다. 그게 이 노드다.
##
## ▣ 하는 일 (전부 카메라 값만 건드린다 — 게임 규칙은 아무것도 안 바꾼다)
##   1. 리밋 조이기 : 굴뚝 좌우 벽에 딱 맞는 사각형을 카메라 리밋으로 넘긴다.
##      리밋이 화면보다 좁으면 `ProtoCamera._clamp_to_limits` 가 카메라를
##      **가운데 못박는다** → 좌우로 뛰어도 화면이 1px 도 흐르지 않는다.
##   2. 줌 인      : 기준 줌 × `줌_배수`. Tween 으로 흘러가므로 컷이 없다.
##   3. 수직 추적  : 룩어헤드를 접고 플랫폼 스냅 대신 몸을 바로 따라간다.
##   4. 시선 유도  : 올라갈수록 위(=출구)를 더 보여준다 → "저기로 나가야 해".
##   5. 틈새빛     : 위로 갈수록 벽 틈에서 새는 빛이 강해진다(출구가 위라는 신호).
##
## ▣ ★심리스인 이유 — 씬을 갈지 않는다
##   이 노드는 스테이지 안의 한 지점이다. 화면이 검어지지도, 씬이 바뀌지도 않는다.
##   플레이어는 그냥 걸어 들어가고 화면이 그 공간의 모양대로 조여든다.
##   (스테이지↔스테이지 전환은 여전히 `연결통로.gd` + `장면전환.gd` 담당이다.
##    이 노드는 **한 스테이지 안의 공간 전환**을 맡는다 — 둘은 층이 다르다.)
##
## ▣ 배치법 (에디터)
##   굴뚝 안쪽 **한가운데**에 놓고 `크기` 를 굴뚝 안쪽 폭 × 높이로 맞춘다.
##   에디터에 사각형 가이드가 그려지므로 눈으로 맞출 수 있다.
##   코드로 놓을 때는 `tools/카메라공간_배치.gd` 가 벽 지형을 실측해서 자동으로 놓는다.
##
## ▣ 안전장치
##   · 카메라를 못 찾으면 아무 일도 하지 않는다 (기존 씬에 붙여도 회귀 없음)
##   · 플레이어가 죽어서 순간이동해도 Area2D 가 exited 를 발동해 원래 화면으로 돌아온다
## ============================================================================
class_name 카메라공간

## 이 공간의 크기(로컬, 노드 중심 기준). 판정 영역과 카메라 리밋에 같이 쓰인다.
## ⚠ 굴뚝 **안쪽 폭**으로 잡을 것. 벽까지 포함하면 카메라가 벽 바깥을 조금 비춘다.
@export var 크기: Vector2 = Vector2(320, 1100):
	set(v): 크기 = v; _재구성(); queue_redraw()

## 카메라 리밋을 판정 영역보다 얼마나 넓힐지(px). 세로만 주는 것이 기본이다.
## 세로 여유가 없으면 굴뚝 위·아래 끝에서 화면이 벽에 딱 막혀
## 플레이어가 화면 가장자리에 붙는다(출구가 안 보인다).
@export var 리밋_여유: Vector2 = Vector2(0, 260):
	set(v): 리밋_여유 = v; queue_redraw()

@export_group("카메라")
## 기준 줌에 곱할 배수. **1보다 크면 조여든다(확대).**
## 1.34 = 스테이지 기본 줌 0.82 → 1.10. 화면 폭 2341px → 1745px.
## ★이 이상 조이면 굴뚝 안에서 위아래로 보이는 범위가 점프 한 번(160px)보다 좁아져
##   다음 선반이 화면 밖에 있게 된다 — 그러면 조작이 도박이 된다.
@export_range(0.6, 3.0) var 줌_배수: float = 1.34

## 이 공간에서 화면 중심을 옮길 양(px). 등반 공간은 위를 더 보여준다.
## 아래 `오를수록_위로` 가 켜져 있으면 여기에 등반 진행도만큼 더 얹힌다.
@export var 시선_오프셋: Vector2 = Vector2(0, -60)

## 수직 모드 — 룩어헤드를 끄고 몸을 바로 따라간다. 가로로 긴 공간이면 끌 것.
@export var 수직모드: bool = true

## 위로 올라갈수록 시선을 더 위로 올린다(px). 출구를 미리 보여주는 장치.
## 0 이면 안 쓴다.
@export_range(0.0, 400.0) var 오를수록_위로: float = 150.0

@export_group("전환 시간")
## 들어갈 때 화면이 조여드는 시간(초). 짧으면 컷처럼 느껴지고, 길면 굴뚝 절반까지
## 올라간 뒤에야 화면이 완성돼 연출이 늦는다. 0.65 = 굴뚝 첫 선반에 닿을 무렵 완성.
@export_range(0.0, 3.0) var 들어갈때: float = 0.65
## 나올 때 다시 펼쳐지는 시간(초). **들어갈 때보다 길게** 둔다.
## 굴뚝을 빠져나오는 순간이 이 스테이지의 "짜잔" 이라, 천천히 열려야 전경이 읽힌다.
@export_range(0.0, 4.0) var 나올때: float = 1.15

@export_group("연출")
## 벽 틈으로 새어 드는 빛. 위로 갈수록 강해진다 = "출구는 위" 라는 시각 신호.
@export var 틈새빛_사용: bool = true
@export var 틈새빛_색: Color = Color(0.86, 0.90, 0.98)
## 빛줄기 개수. 굴뚝 높이 1100px 에 5~7 개가 적당하다(많으면 벽이 안 보인다).
@export_range(0, 16) var 틈새빛_개수: int = 6

@export_group("에디터")
@export var 가이드_표시: bool = true:
	set(v): 가이드_표시 = v; queue_redraw()

# ── 내부 상태 ───────────────────────────────────────────────────────────────
var _캠: ProtoCamera = null
var _대상: Node2D = null            ## 안에 들어와 있는 플레이어 (없으면 null)
var _진행: float = 0.0              ## 등반 진행도 0(바닥)~1(천장)
var _t: float = 0.0                 ## 빛 흔들림용 시간


func _ready() -> void:
	_재구성()
	if Engine.is_editor_hint():
		return
	add_to_group("카메라공간")
	# 판정만 하는 노드다 — 아무도 이걸 감지할 필요가 없다(layer 0).
	# 플레이어(레이어 1)만 본다.
	collision_layer = 0
	collision_mask = 1
	monitoring = true
	if not body_entered.is_connected(_몸_들어옴):
		body_entered.connect(_몸_들어옴)
	if not body_exited.is_connected(_몸_나감):
		body_exited.connect(_몸_나감)
	# 빛 연출은 z 를 지형(0)보다 살짝 위로 둔다 — 벽 앞을 스치는 빛이라야 공기가 보인다.
	z_index = 3
	set_process(틈새빛_사용)
	queue_redraw()


## 판정 사각형을 만들거나 갱신한다. 에디터에서 `크기` 를 바꿔도 노드가 늘어나지 않게
## "있으면 재사용, 없으면 생성" 구조로 짰다(연결통로.gd 와 같은 문법).
func _재구성() -> void:
	if not is_inside_tree():
		return
	var cs := get_node_or_null("판정") as CollisionShape2D
	if cs == null:
		cs = CollisionShape2D.new()
		cs.name = "판정"
		# ★오목/거대 폴리곤 기즈모가 에디터 2D 뷰를 뒤덮는 문제(2026-08-02)와 같은 이유로 숨긴다.
		#   물리 판정에는 영향이 없다. 대신 아래 _draw 가 가이드를 그린다.
		cs.visible = false
		add_child(cs)
		if Engine.is_editor_hint() and owner:
			cs.owner = owner
	var r := cs.shape as RectangleShape2D
	if r == null:
		r = RectangleShape2D.new()
		cs.shape = r
	r.size = 크기


# ── 조회 ────────────────────────────────────────────────────────────────────
## 카메라에 넘길 리밋(월드 좌표).
func 리밋() -> Rect2:
	var 반 := 크기 * 0.5 + 리밋_여유
	return Rect2(global_position - 반, 반 * 2.0)


## 지금 이 공간이 카메라를 잡고 있나.
func 활성인가() -> bool:
	return _대상 != null


## 등반 진행도 0(바닥)~1(천장). 테스트·연출이 읽는다.
func 진행도() -> float:
	return _진행


# ── 판정 ────────────────────────────────────────────────────────────────────
func _몸_들어옴(몸: Node2D) -> void:
	if Engine.is_editor_hint() or not (몸 is CharacterBody2D):
		return
	_대상 = 몸
	_캠 = _카메라_찾기()
	if _캠 == null:
		return
	# 기준 줌에 배수를 곱해 **절대 줌**을 만들어 넘긴다.
	# 배수로 넘기지 않는 이유: 카메라의 기준 줌은 구역 연출이 매 프레임 바꿀 수 있어서,
	# 배수를 카메라 쪽에 두면 구역이 바뀔 때 공간 줌까지 같이 흔들린다.
	_캠.공간_들어감(리밋(), _캠.기준_줌() * 줌_배수, 시선_오프셋,
		수직모드, 들어갈때, name)


func _몸_나감(몸: Node2D) -> void:
	if Engine.is_editor_hint() or 몸 != _대상:
		return
	_대상 = null
	if _캠:
		_캠.공간_나감(나올때, name)


## 이 씬의 ProtoCamera 를 찾는다.
## get_viewport().get_camera_2d() 가 1 순위 — 실제로 화면을 그리는 카메라다.
## 그게 ProtoCamera 가 아니면(테스트 하네스·다른 씬) 그룹에서 찾는다.
func _카메라_찾기() -> ProtoCamera:
	var vp := get_viewport()
	if vp:
		var c := vp.get_camera_2d()
		if c is ProtoCamera:
			return c as ProtoCamera
	for n in get_tree().get_nodes_in_group("주카메라"):
		if n is ProtoCamera:
			return n as ProtoCamera
	return null


# ── 연출 ────────────────────────────────────────────────────────────────────
func _process(delta: float) -> void:
	_t += delta
	if _대상 and is_instance_valid(_대상):
		# 진행도 = 공간 아래쪽(1) → 위쪽(0) 을 0→1 로 뒤집은 값.
		var 위 := global_position.y - 크기.y * 0.5
		var 아래 := global_position.y + 크기.y * 0.5
		_진행 = clampf((아래 - _대상.global_position.y) / maxf(아래 - 위, 1.0), 0.0, 1.0)
		# ★올라갈수록 위를 더 보여준다. 굴뚝 출구를 도착하기 전에 눈에 넣어주는 장치.
		#   (가시성 원칙: "저기 가야 해!" 를 먼저 보여줄 것)
		if _캠 and 오를수록_위로 > 0.0:
			_캠.공간_시선_갱신(시선_오프셋 + Vector2(0, -오를수록_위로 * _진행))
	if 틈새빛_사용:
		queue_redraw()


func _draw() -> void:
	# ── 에디터 가이드 ── 숫자만 보고 Rect2 를 맞추는 건 고문이다(카메라_구역.gd 와 같은 이유).
	if Engine.is_editor_hint() and 가이드_표시:
		var r := Rect2(-크기 * 0.5, 크기)
		draw_rect(r, Color(0.45, 1.0, 0.7, 0.06), true)
		draw_rect(r, Color(0.45, 1.0, 0.7, 0.9), false, 4.0)
		# 리밋(여유 포함) — 카메라가 실제로 갇히는 범위
		var lr := Rect2(-(크기 * 0.5 + 리밋_여유), 크기 + 리밋_여유 * 2.0)
		draw_rect(lr, Color(1.0, 0.8, 0.35, 0.7), false, 2.0)

	if not 틈새빛_사용 or 틈새빛_개수 <= 0:
		return

	# ── 틈새빛 ──────────────────────────────────────────────────────────────
	# 벽 틈에서 비스듬히 들어오는 빛줄기. 위로 갈수록 밝다.
	# ★왜 빛을 "위로 갈수록" 밝게 하나: 흑백 게임에서 플레이어가 방향을 아는 유일한
	#   단서가 명암이다. 위가 밝으면 아무 UI 없이도 "출구는 위" 가 읽힌다
	#   (리틀 나이트메어가 문 하나 없이 진행 방향을 알려주는 방식).
	var 반폭 := 크기.x * 0.5
	var 반높 := 크기.y * 0.5
	for i in 틈새빛_개수:
		# 0(맨 아래) → 1(맨 위)
		var u := float(i) / float(maxi(틈새빛_개수 - 1, 1))
		var y := lerpf(반높, -반높, u)
		# 좌우 번갈아 — 한쪽에서만 들어오면 벽 하나가 통째로 죽는다
		var 왼쪽 := i % 2 == 0
		var x0 := -반폭 if 왼쪽 else 반폭
		var 방향 := 1.0 if 왼쪽 else -1.0
		# 아주 느린 맥동. 정지된 빛은 "벽에 그린 그림" 으로 보인다.
		var 맥동 := 0.82 + 0.18 * sin(_t * 0.7 + float(i) * 1.7)
		# 위쪽 빛이 강하다. u² 라서 아래쪽은 거의 안 보이고 위에서만 확 살아난다.
		var 세기 := (0.06 + 0.30 * u * u) * 맥동
		# 빛줄기 = 벽에서 비스듬히 뻗어 나가는 삼각형 3 겹(가장자리가 흐려진다)
		for k in 3:
			var 길이 := 크기.x * (0.55 + 0.18 * float(k))
			var 두께 := 26.0 + 22.0 * float(k)
			draw_colored_polygon(PackedVector2Array([
				Vector2(x0, y - 8.0),
				Vector2(x0, y + 8.0),
				Vector2(x0 + 방향 * 길이, y + 두께 + 90.0),
				Vector2(x0 + 방향 * 길이, y + 두께),
			]), Color(틈새빛_색.r, 틈새빛_색.g, 틈새빛_색.b, 세기 / (2.0 + float(k) * 2.0)))
		# 벽면에 닿는 밝은 점 — 빛이 "틈에서" 나온다는 근거를 만든다
		draw_circle(Vector2(x0, y), 9.0 + 5.0 * u,
			Color(틈새빛_색.r, 틈새빛_색.g, 틈새빛_색.b, 세기 * 0.9))
