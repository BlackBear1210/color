func _init() -> void:
	call_deferred("_go")


func _go() -> void:
	var 조사만 := OS.get_cmdline_user_args().has("--조사")
	var 실패 := 0
	for 경로: String in 배치표:
		var 절대 := ProjectSettings.globalize_path(경로)
		if not FileAccess.file_exists(절대):
			print("  ✗ 씬 없음: %s" % 경로)
			실패 += 1
			continue
		var 원문 := FileAccess.get_file_as_string(절대)
		var 설정: Dictionary = 배치표[경로]
		var 결과 := _고치기(원문, 설정)
		print("· %s" % 경로.get_file())
		for 줄 in 결과["기록"]:
			print("    %s" % 줄)
		if 조사만:
			continue
		var f := FileAccess.open(절대, FileAccess.WRITE)
		if f == null:
			print("    ✗ 쓰기 실패")
			실패 += 1
			continue
		f.store_string(결과["글"])
		f.close()
	print("조명 배치 %s (실패 %d)" % ["조사만" if 조사만 else "적용", 실패])
	quit(1 if 실패 > 0 else 0)


## 씬 텍스트 한 벌을 받아 고친 텍스트를 돌려준다. 파일 입출력은 여기서 안 한다
## (그래야 `--조사` 가 진짜로 아무것도 안 건드린다).
func _고치기(원문: String, 설정: Dictionary) -> Dictionary:
	var 기록: Array = []
	var 줄들 := 원문.split("\n")

	# ── ① 기존 `조명` 노드 블록 지우기 (멱등) ──
	var 남길: Array = []
	var 버리는중 := false
	for L: String in 줄들:
		if L.begins_with("["):
			# 새 블록이 시작될 때마다 "이 블록을 버릴까"를 다시 판단한다.
			버리는중 = L.begins_with("[node ") and (
				L.contains('name="%s"' % 담을_이름) and L.contains('parent="."')
				or L.contains('parent="%s"' % 담을_이름))
		if not 버리는중:
			남길.append(L)
	var 지운줄 := 줄들.size() - 남길.size()
	if 지운줄 > 0:
		기록.append("기존 조명 블록 %d줄 제거" % 지운줄)

	# ── ② CanvasModulate 색 ──
	if 설정.has("어둠"):
		var 안에 := false
		for i in 남길.size():
			var L: String = 남길[i]
			if L.begins_with("["):
				안에 = L.begins_with("[node ") and L.contains('type="CanvasModulate"')
				continue
			if 안에 and L.begins_with("color = Color("):
				var 새 := _색글(설정["어둠"])
				if L != 새:
					기록.append("어둠 %s → %s" % [L, 새])
					남길[i] = 새
				안에 = false

	# ── ②-2 이미 있는 노드의 자리·값 손보기 ──
	if 설정.has("기존노드"):
		남길 = _기존노드_고치기(남길, 설정["기존노드"], 기록)

	# ── ③ 발광체 / 빛기둥 스크립트 ext_resource 확보 ──
	var 광원들: Array = 설정.get("광원", [])
	var 기둥들: Array = 설정.get("빛기둥", [])
	var 발광체_id := ""
	var 빛기둥_id := ""
	if not 광원들.is_empty():
		발광체_id = _스크립트_확보(남길, 발광체_경로, "조명_발광체", 기록)
	if not 기둥들.is_empty():
		빛기둥_id = _스크립트_확보(남길, 빛기둥_경로, "조명_빛기둥", 기록)

	# ── ④ 조명 노드 블록 붙이기 ──
	var 덩어리: Array = []
	if not 광원들.is_empty() or not 기둥들.is_empty():
		덩어리.append("")
		덩어리.append('[node name="%s" type="Node2D" parent="."]' % 담을_이름)
		for 줄: Dictionary in 광원들:
			덩어리.append("")
			덩어리.append('[node name="%s" type="Node2D" parent="%s"]'
				% [String(줄["이름"]), 담을_이름])
			덩어리.append("position = " + _벡터글(줄["자리"]))
			덩어리.append('script = ExtResource("%s")' % 발광체_id)
			# 종류 1 = 구슬(빛만) · 2 = 반사(세로로 눌린 납작한 빛 웅덩이)
			덩어리.append('"종류" = %d' % int(줄.get("종류", 1)))
			덩어리.append('"빛색" = ' + _색값(줄["색"]))
			덩어리.append('"반경" = %s' % _수(줄["반경"]))
			덩어리.append('"밝기" = %s' % _수(줄["밝기"]))
			덩어리.append('"깜빡임" = %s' % _수(float(줄.get("깜빡임", 0.0))))
			덩어리.append('"크기_흔들림" = %s' % _수(float(줄.get("흔들림", 0.0))))
			덩어리.append('"알갱이_보이기" = false')   # 허공에 흰 알갱이가 뜨면 반딧불이가 된다
			if bool(줄.get("그림자", false)):
				덩어리.append('"그림자" = true')
		for 줄2: Dictionary in 기둥들:
			덩어리.append("")
			덩어리.append('[node name="%s" type="Node2D" parent="%s"]'
				% [String(줄2["이름"]), 담을_이름])
			덩어리.append("position = " + _벡터글(줄2["자리"]))
			덩어리.append('script = ExtResource("%s")' % 빛기둥_id)
			# ★모드 0 = 연출. 1(경계)·2(발판)은 **색 판정에 관여**한다 —
			#   조명 작업이 게임 규칙을 바꾸면 안 되므로 여기서는 절대 쓰지 않는다.
			덩어리.append('"모드" = 0')
			덩어리.append('"시작폭" = %s' % _수(float(줄2["시작폭"])))
			덩어리.append('"끝폭" = %s' % _수(float(줄2["끝폭"])))
			덩어리.append('"길이" = %s' % _수(float(줄2["길이"])))
			덩어리.append('"각도" = %s' % _수(float(줄2["각도"])))
			덩어리.append('"세기" = %s' % _수(float(줄2["세기"])))
			덩어리.append('"먼지" = %d' % int(줄2.get("먼지", 20)))
			덩어리.append('"구멍_그리기" = false')
	# 파일 끝의 빈 줄을 정리하고 붙인다.
	while not 남길.is_empty() and String(남길[-1]).strip_edges() == "":
		남길.remove_at(남길.size() - 1)
	남길.append_array(덩어리)
	남길.append("")
	기록.append("광원 %d개 · 빛기둥 %d개 배치" % [광원들.size(), 기둥들.size()])
	return {"글": "\n".join(남길), "기록": 기록}


## ext_resource 줄을 찾거나 새로 끼워 넣고 id 를 돌려준다.
func _스크립트_확보(남길: Array, 경로: String, 새id: String, 기록: Array) -> String:
	for L: String in 남길:
		if L.begins_with("[ext_resource") and L.contains(경로):
			# ⚠ "id=" 로 찾으면 같은 줄의 "uid=" 가 먼저 걸린다. 앞 공백까지 포함해 찾는다.
			var 있는 := _속성(L, " id")
			기록.append("%s ext_resource 재사용 (id=%s)" % [경로.get_file(), 있는])
			return 있는
	# 마지막 ext_resource 줄 뒤에 끼워 넣는다 (sub_resource 보다 앞이어야 한다)
	var 끝 := -1
	for i in 남길.size():
		if String(남길[i]).begins_with("[ext_resource"):
			끝 = i
	남길.insert(끝 + 1, '[ext_resource type="Script" path="%s" id="%s"]' % [경로, 새id])
	기록.append("%s ext_resource 추가 (id=%s)" % [경로.get_file(), 새id])
	return 새id


## 이미 씬에 있는 노드의 `position` 과 인스펙터 값을 표대로 맞춘다.
##
## ★[2026-09-08 STEP 13] 예전 판(`기존광원`)은 **이미 있는 줄만 갈아 끼웠다.**
##   그래서 `"밝기"` 줄이 없는 노드(= 기본값을 쓰던 등)는 표에 값을 적어도 조용히
##   무시됐다 — `등_복도_A` 가 정확히 그랬다(밝기 1.15 를 적었는데 씬에는 줄이 없었다).
##   → 없으면 **끼워 넣는다.** 값은 전부 절대값이라 몇 번을 돌려도 결과가 같다.
func _기존노드_고치기(줄들: Array, 표: Dictionary, 기록: Array) -> Array:
	var 결과: Array = []
	var 이번_대상 := ""          # 지금 읽고 있는 블록이 표의 어느 항목인가
	var 본_키: Dictionary = {}   # 이 블록에서 이미 만난 키
	var 자리_봄 := false

	for i in 줄들.size():
		var L: String = 줄들[i]
		if L.begins_with("["):
			# 블록이 끝났다 → 아직 안 쓴 값을 여기서 끼워 넣는다.
			_모자란_값_넣기(결과, 이번_대상, 표, 본_키, 자리_봄, 기록)
			이번_대상 = ""
			본_키 = {}
			자리_봄 = false
			if L.begins_with("[node "):
				var 이름 := _속성(L, "name")
				var 부모 := _속성(L, "parent")
				var 길 := 이름 if 부모 == "." else "%s/%s" % [부모, 이름]
				if 표.has(길):
					이번_대상 = 길
			결과.append(L)
			continue

		if 이번_대상 == "":
			결과.append(L)
			continue

		var 항목: Dictionary = 표[이번_대상]
		# position
		if L.begins_with("position = ") and 항목.has("자리"):
			자리_봄 = true
			var 새자리 := "position = " + _벡터글(항목["자리"])
			if L != 새자리:
				기록.append("%s %s → %s" % [이번_대상.get_file(), L, 새자리])
			결과.append(새자리)
			continue
		# 인스펙터 값
		var 바꿈 := false
		for 키: String in 항목.get("값", {}):
			if L.begins_with('"%s" = ' % 키):
				본_키[키] = true
				var 새 := '"%s" = %s' % [키, _값글(항목["값"][키])]
				if L != 새:
					기록.append("%s %s → %s" % [이번_대상.get_file(), L, 새])
				결과.append(새)
				바꿈 = true
				break
		if not 바꿈:
			결과.append(L)

	# 파일 끝에서 블록이 끝나는 경우
	_모자란_값_넣기(결과, 이번_대상, 표, 본_키, 자리_봄, 기록)
	return 결과


## 블록이 끝나는 자리에서, 표에 있는데 씬에 없던 줄을 끼워 넣는다.
func _모자란_값_넣기(결과: Array, 대상: String, 표: Dictionary, 본_키: Dictionary,
		자리_봄: bool, 기록: Array) -> void:
	if 대상 == "":
		return
	var 항목: Dictionary = 표[대상]
	# 블록 끝의 빈 줄들은 잠깐 떼어 두었다가 다시 붙인다(파일 모양을 안 흐트러뜨린다).
	var 빈줄: Array = []
	while not 결과.is_empty() and String(결과[-1]).strip_edges() == "":
		빈줄.append(결과.pop_back())
	if 항목.has("자리") and not 자리_봄:
		결과.append("position = " + _벡터글(항목["자리"]))
		기록.append("%s position 줄 신규 삽입" % 대상.get_file())
	for 키: String in 항목.get("값", {}):
		if 본_키.has(키):
			continue
		결과.append('"%s" = %s' % [키, _값글(항목["값"][키])])
		기록.append("%s \"%s\" 줄 신규 삽입 (= %s)" % [대상.get_file(), 키, _값글(항목["값"][키])])
	결과.append_array(빈줄)


func _색글(c: Color) -> String:
	return "color = " + _색값(c)


func _색값(c: Color) -> String:
	return "Color(%s, %s, %s, %s)" % [_수(c.r), _수(c.g), _수(c.b), _수(c.a)]


func _벡터글(v: Vector2) -> String:
	return "Vector2(%s, %s)" % [_수(v.x), _수(v.y)]


## 표에 적은 값을 tscn 표기로. int/bool 을 float 로 뭉개면
## `"먼지" = 20.0` 처럼 되어 에디터가 다시 저장할 때마다 diff 가 생긴다.
func _값글(v: Variant) -> String:
	if v is bool:
		return "true" if v else "false"
	if v is int:
		return str(v)
	if v is Vector2:
		return _벡터글(v)
	if v is Color:
		return _색값(v)
	return _수(float(v))


## tscn 은 실수를 "0.62" 처럼 짧게 쓴다. %f 를 그대로 쓰면 0.620000 이 되어
## 매번 diff 가 생겨 멱등이 아닌 것처럼 보인다.
func _수(v: float) -> String:
	var s := String.num(v, 6)
	if s.contains(".") :
		while s.ends_with("0"):
			s = s.substr(0, s.length() - 1)
		if s.ends_with("."):
			s += "0"
	return s


func _속성(줄: String, 키: String) -> String:
	var 찾 := '%s="' % 키
	var i := 줄.find(찾)
	if i < 0:
		return ""
	var j := 줄.find('"', i + 찾.length())
	return 줄.substr(i + 찾.length(), j - i - 찾.length())
