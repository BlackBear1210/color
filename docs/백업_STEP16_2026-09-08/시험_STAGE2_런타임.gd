extends SceneTree
## ============================================================================
## [2026-09-06 STEP 10 신규] STAGE 2 런타임 시험 — 실제 물리 위에서 한 구간씩 건넌다
## ----------------------------------------------------------------------------
## 실행: godot --headless --path . -s res://tools/시험_STAGE2_런타임.gd
##
## ▣ 왜 필요한가
##   `레벨검사.gd` 는 레이캐스트 **모델**이라 "이론상 갈 수 있다" 까지다.
##   `측정_스테이지_플레이타임.gd` 의 직진봇은 **Shift 색전환도 사격도 못 한다** —
##   흑백 발판이 섞인 이 스테이지에서는 첫 흰 발판에서 죽는다(실측 3.0 초).
##
## ▣ ★★이 스테이지의 핵심 조작 = **공중 색전환**
##   흑백이 한 단씩 번갈아 나오므로, 출발 발판에서는 그 발판 색으로 서 있다가
##   **점프한 뒤 공중에서 Shift** 를 눌러 도착 발판 색으로 바꿔야 한다.
##   `player.gd::_toggle_color()` 에 바닥 조건이 없어(경계에 걸친 경우만 막는다)
##   공중 전환이 성립한다 — 그래서 이 설계가 가능하다.
##   이 시험은 사람이 하는 그 순서를 그대로 흉내 낸다.
##
## ▣ 유령 3 장은 미리 칠하고 시작한다 (사격 자체는 `진단_유령발판.gd` 가 검증한다)
##   ⚠ 1층 유령은 `경계_반딧불이`(흰색 강제) 한가운데라 **흰색으로** 칠해야 한다.
##     검정으로 칠하면 밟는 순간 흰 몸과 색이 달라 죽는다 — 원래 설계된 함정이다.
##
## ⚠ 이 도구는 아무것도 고치지 않는다. PASS/FAIL 만 보고한다.
## ============================================================================

const 씬경로 := "res://scenes/집/스테이지_2_복도계단.tscn"

const 검정 := 0
const 흰색 := 1

## # STEP15:
## # 문제: 이 표는 STEP 12 레이아웃의 좌표가 그대로 박혀 있었다. STAGE 2 를 전면
## #       재설계(STEP 15)하면서 발판이 48 → 26 개로 줄고 좌표가 전부 바뀌어,
## #       예전 표로는 첫 구간부터 허공에서 시작한다.
## # 목적: 새 공간(대복도 → 홀 → 거대 계단실 → 1층 거실)을 사람이 하는 순서 그대로 흉내 낸다.
## # 해결: 새 레이아웃의 **윗면 y 실측값**으로 다시 적는다. 값은 patch_STAGE2_STEP15.gd
## #       의 지형표와 한 글자도 어긋나면 안 된다(어긋나면 여기가 먼저 FAIL 한다).
##
## ▣ 이번 설계의 이동 문법 (STEP 15 §실측)
##   · 바닥(구조W)은 칠 불가 = **중립** → 어느 색으로도 안전하다. 색 전환은 여기서 한다.
##   · 색 블록은 바닥에 뿌리내린 단차 110 · 틈 200 (점프 거리 240 안).
##   · 하강은 700~800 낙하(치명 900 미만) + 아주 긴 tread 의 지그재그.
## [이름, 출발x, 출발윗면y, 출발색, 도착x(가장자리), 도착윗면y, 도착색, (선택)넘을x]
const 구간 := [
	# ══ AREA A — 2F 대복도 (L0 = 0 · 맞붙은 색 통로 8300px 를 그냥 걷는다) ══
	# 바닥(구조W)은 중립이라 어느 색으로도 안전하다 → 통로에 오르기 전에 색을 맞춘다.
	["A① 바닥→A_W0 (W)", -5100.0, 0.0, 흰색, -4850.0, -110.0, 흰색],
	# 아래부터는 전부 **같은 높이의 맞붙은 블록**이다. 걷기만 하면 되고,
	# 색은 중립(BRICK) 구간을 밟는 동안 바꾼다(규칙 ⑤).
	["A② A_W0→A_N0 중립", -4300.0, -110.0, 흰색, -3700.0, -110.0, 흰색],
	["A③ A_N0→A_W1 (W)", -3700.0, -110.0, 흰색, -3000.0, -110.0, 흰색],
	["A④ A_W1→A_N1 중립", -3000.0, -110.0, 흰색, -2300.0, -110.0, 흰색],
	["A⑤ A_N1 위에서 흰→검 → A_B1", -2300.0, -110.0, 검정, -1500.0, -110.0, 검정],
	["A⑥ A_B1→A_N2 중립", -1500.0, -110.0, 검정, -700.0, -110.0, 검정],
	["A⑦ A_N2 위에서 검→흰 → A_W2", -700.0, -110.0, 흰색, 0.0, -110.0, 흰색],
	["A⑧ A_W2→A_N3 중립", 0.0, -110.0, 흰색, 700.0, -110.0, 흰색],
	["A⑨ A_N3 위에서 흰→검 → A_B2", 700.0, -110.0, 검정, 1500.0, -110.0, 검정],
	["A⑩ A_B2→A_N4 중립", 1500.0, -110.0, 검정, 2200.0, -110.0, 검정],
	["A⑪ A_N4 위에서 검→흰 → A_W3", 2200.0, -110.0, 흰색, 3000.0, -110.0, 흰색],
	# ══ AREA B — 2F 홀 (도약대로 한 단 위 L1 = −480) ═══════════════════
	["B⓪ 도약대 → 바닥_홀", 3450.0, 0.0, 검정, 3760.0, -480.0, 검정],
	# ★칠하기 ① — 600px 구덩이(점프 거리 240 으로는 못 건넌다)를 유령이 메운다.
	# ⚠ 유령 다리 양옆은 100px 틈이다 — 같은 높이라 러너가 스스로는 안 뛴다.
	#    8 번째 칸(넘을x)으로 "여기서 뛴다"를 명시한다. 사람이 하는 조작과 같다.
	["B① 바닥_홀→HALL_GHOST ★PAINT1", 5300.0, -480.0, 흰색, 5550.0, -480.0, 흰색, 5380.0],
	["B② HALL_GHOST→바닥_홀2", 5800.0, -480.0, 흰색, 6050.0, -480.0, 흰색, 5880.0],
	# ══ AREA C — 거대 계단실 (tread 2950~3200 · 700~800 낙하) ══════════
	["C① 홀2→낙하700→FL1 중립", 6350.0, -480.0, 흰색, 6600.0, 220.0, 흰색],
	# tread 한복판의 가시(8000)를 뛰어넘어 오른쪽 끝까지 걷는다.
	["C② FL1 가시 넘어 오른끝", 7400.0, 220.0, 흰색, 9400.0, 220.0, 흰색, 8000.0],
	# ★낙하 700 중에 흰→검 (FL2 가 검정이다).
	["C③ FL1→낙하700→FL2b (B)", 9400.0, 220.0, 검정, 9700.0, 920.0, 검정],
	# ★칠하기 ② — 계단 한복판 유령. 양옆(FL2a·FL2b)이 검정이라 검정으로 칠했다.
	["C④ FL2b→FL2_GHOST ★PAINT2", 8950.0, 920.0, 검정, 8750.0, 920.0, 검정, 8920.0],
	["C⑤ FL2_GHOST→FL2a (B)", 8450.0, 920.0, 검정, 8250.0, 920.0, 검정, 8420.0],
	# ★낙하 800 중에 검→흰 (FL2a 는 검정 · FL3 는 흰색이다).
	#   ⚠ 출발색을 흰색으로 적었다가 **출발 발판(검정) 위에서 즉사**했다(실측 1 구간 FAIL).
	#     출발색은 반드시 **출발 발판의 색**이어야 한다 — 바꾸는 것은 공중에서다.
	["C⑥ FL2a→낙하800→FL3 (검→흰)", 6750.0, 920.0, 검정, 6500.0, 1720.0, 흰색],
	["C⑦ FL3 가시 넘어 오른끝", 7400.0, 1720.0, 흰색, 9400.0, 1720.0, 흰색, 8000.0],
	# ══ AREA D — 1F 거실 (L5 = 2520 · 7800px) ═════════════════════════
	["D① FL3→낙하800→1층 바닥", 9400.0, 1720.0, 흰색, 9700.0, 2520.0, 흰색],
	["D② 도약대 → 선반(선택 경로)", 9850.0, 2520.0, 흰색, 10100.0, 2040.0, 흰색],
	["D③ 1층 바닥 가시 넘어 출구 쪽", 10800.0, 2520.0, 흰색, 12350.0, 2520.0, 흰색, 11400.0],
	# ★칠하기 ③ — 출구 앞 유령. `경계_반딧불이`(흰색 강제) 한가운데라 **흰색**이어야 산다.
	["D④ 1층a→EXIT_GHOST ★PAINT3", 12350.0, 2520.0, 흰색, 12550.0, 2520.0, 흰색, 12380.0],
	["D⑤ EXIT_GHOST→1층b→출구", 12780.0, 2520.0, 흰색, 13100.0, 2520.0, 흰색, 12810.0],
]

## 유령별 칠할 색 — 1층 유령만 흰색(흰색 강제 구역 한가운데다).
# STEP15: 유령 이름과 "어떤 색이어야 사는가"가 전부 바뀌었다.
#   HALL_GHOST : 양옆이 중립 바닥이라 아무 색이나 되지만, 이어지는 구간을 흰색으로 간다.
#   FL2_GHOST  : 양옆(FL2a·FL2b)이 **검정**이라 검정이어야 한다.
#   EXIT_GHOST : `경계_반딧불이`(흰색 강제) 한가운데다 → **흰색**이어야 한다.
const 유령색 := {
	"HALL_GHOST_SS_WOOD": 흰색,
	"FL2_GHOST_SS_WOOD": 검정,
	"EXIT_GHOST_SS_WOOD": 흰색,
}

var _루트: Node = null
var _p: CharacterBody2D = null
var _결과: Array = []


func _init() -> void:
	Engine.max_fps = 0
	call_deferred("_실행")


func _실행() -> void:
	_루트 = (load(씬경로) as PackedScene).instantiate()
	root.add_child(_루트)
	for i in 8:
		await physics_frame
	_p = _루트.get_node_or_null("Player")
	if _p == null:
		print("  ✗ Player 없음"); quit(1); return

	print("\n════════ STAGE 2 런타임 시험 ════════")
	for c in _루트.get_node("지형").get_children():
		var t := c as Node2D
		if t == null or not t.has_method("밟을_수_있나") or not bool(t.get("무색일때_통과")):
			continue
		var 색: int = int(유령색.get(t.name, 검정))
		for i in int(t.call("필요횟수")):
			t.call("명중", 색, t.global_position)
		print("  유령 %-26s → %s 로 칠함 · 밟을수있나=%s"
			% [t.name, "흰색" if 색 == 흰색 else "검정", t.call("밟을_수_있나")])
	for i in 4:
		await physics_frame
	print("")

	for c in 구간:
		await _한구간(c)

	var 통과 := 0
	print("\n──────────── 결과 ────────────")
	for r in _결과:
		if bool(r[1]):
			통과 += 1
		print("  %-30s %s   %s" % [r[0], "PASS  " if r[1] else "✗ FAIL", r[2]])
	print("  ─────────────────────────────")
	print("  %d / %d PASS" % [통과, _결과.size()])
	_거리_보고()
	print("════════════════════════════════\n")
	quit(0)


func _한구간(c: Array) -> void:
	var 이름: String = c[0]
	var 출발x: float = float(c[1])
	var 출발y: float = float(c[2])
	var 출발색: int = int(c[3])
	var 목표x: float = float(c[4])
	var 목표y: float = float(c[5])
	var 도착색: int = int(c[6])
	## STEP15: 8 번째 칸(선택) = 뛰어넘어야 할 장애물의 x. 없으면 INF.
	var 넘을x: float = float(c[7]) if c.size() > 7 else INF
	var 왼쪽으로 := 목표x < 출발x

	# ★출발 발판 색으로 선다. (도착색으로 미리 바꾸면 그 자리에서 즉사한다)
	_p.set("player_color", 출발색)
	_p.velocity = Vector2.ZERO
	_p.global_position = Vector2(출발x, 출발y - 40.0)
	await physics_frame
	var 섰나 := false
	for i in 120:
		await physics_frame
		if _p.is_on_floor():
			섰나 = true
			break
	if not 섰나:
		_결과.append([이름, false, "출발 발판에 서지 못했다 (%.0f, %.0f)"
			% [_p.global_position.x, _p.global_position.y]])
		return

	var 방향 := "move_left" if 왼쪽으로 else "move_right"
	Input.action_press(방향)
	var 올라가나 := 목표y < 출발y - 20.0
	var 뛰었나 := false
	var 공중 := 0
	var 색바꿈 := (출발색 == 도착색)
	var 닿았나 := false
	for i in 360:
		await physics_frame
		# ★올라가는 구간은 **단 앞에 다다랐을 때** 한 번 뛴다.
		#   출발점에서 미리 뛰면(첫 판) 그 점프가 헛되이 소모돼 다음 벽 앞에 서서 끝나고,
		#   바닥에 닿을 때마다 계속 뛰면(둘째 판) 과도하게 튀어 죽는다 — 둘 다 실측했다.
		var 단_앞인가 := absf(_p.global_position.x - 목표x) <= 170.0
		# # STEP15:
		# # 문제: 러너는 **목표가 더 높을 때만**(올라가나) 점프했다. 그래서 평지 한복판의
		# #       가시를 절대 못 넘고, 가시가 있는 구간은 전부 FAIL 로 나왔다(실측).
		# #       사람은 당연히 뛰어넘는 자리인데 시험이 그 조작을 표현하지 못한 것이다.
		# # 목적: "평지를 걷다가 장애물 하나를 뛰어넘는다" 를 시험이 재현할 수 있게 한다.
		# # 해결: 구간 표의 8 번째 칸에 **넘을 x** 를 적으면, 그 x 앞 170px 에서 한 번 뛴다.
		#   (올라가는 점프와 같은 손잡이를 쓰므로 한 구간에 점프는 여전히 한 번뿐이다)
		var 넘을_앞인가 := 넘을x != INF and absf(_p.global_position.x - 넘을x) <= 170.0
		if not 뛰었나 and _p.is_on_floor() and ((올라가나 and 단_앞인가) or 넘을_앞인가):
			Input.action_press("jump")
			뛰었나 = true
		# ★공중에서 색을 바꾼다 — 이 스테이지의 핵심 조작
		if not _p.is_on_floor():
			공중 += 1
		else:
			공중 = 0
		# ★★색은 **정점을 지난 뒤**에 바꾼다.
		#   발판을 막 떠난 프레임에 바꾸면 `월드.gd::_사망_판정` 이 쓰는 접촉 여유 안에
		#   아직 출발 발판이 걸려 있어서 **그 자리에서 죽는다**(실측: 7 구간이 이걸로 FAIL).
		#   사람이 할 때도 "뛰고 나서 바꾼다" 가 정답이다.
		# ★★타이밍 정정 2 — "정점" 만으로는 부족했다(실측: 5 구간이 계속 죽었다).
		#   붙어 있는 두 블록 사이를 뛸 때는 정점에서도 **아직 출발 발판 바로 위**다.
		#   → 가로로 도착 발판에 들어섰거나(x 조건), 곧장 떨어지는 구간이면
		#     출발 높이에서 250 아래로 내려간 뒤에 바꾼다.
		var 지금x := _p.global_position.x
		var 가로_넘었나 := (지금x <= 목표x) if 왼쪽으로 else (지금x >= 목표x)
		var 충분히_떨어졌나 := _p.global_position.y > 출발y + 250.0
		if not 색바꿈 and 공중 >= 6 and (가로_넘었나 or 충분히_떨어졌나):
			_p.set("player_color", 도착색)
			색바꿈 = true
		if _p.is_on_floor() and absf(_p.global_position.y - 목표y) < 14.0:
			var x := _p.global_position.x
			if (왼쪽으로 and x <= 목표x + 80.0) or (not 왼쪽으로 and x >= 목표x - 80.0):
				닿았나 = true
				break
	Input.action_release(방향)
	Input.action_release("jump")
	await _프레임(8)
	_결과.append([이름, 닿았나, "(%.0f, %.0f) 기대 y %.0f"
		% [_p.global_position.x, _p.global_position.y, 목표y]])


func _프레임(n: int) -> void:
	for i in n:
		await physics_frame


## ★[STEP 12 §P] 실제 플레이어가 지나가는 **중심 경로의 누적 거리**를 잰다.
##   Bounding Box 가 아니라 "발이 실제로 지나간 길이" 다.
##   구간표의 출발→도착을 이어 붙여 수평·수직을 따로 합산한다.
func _거리_보고() -> void:
	var 수평 := 0.0
	var 수직 := 0.0
	var 이전 := Vector2(float(구간[0][1]), float(구간[0][2]))
	for c in 구간:
		var 시작 := Vector2(float(c[1]), float(c[2]))
		var 끝 := Vector2(float(c[4]), float(c[5]))
		# 앞 구간의 끝 → 이 구간의 시작 (같은 발판 위를 걸어간 거리)
		수평 += absf(시작.x - 이전.x)
		수직 += absf(시작.y - 이전.y)
		# 이 구간의 이동
		수평 += absf(끝.x - 시작.x)
		수직 += absf(끝.y - 시작.y)
		이전 = 끝
	print("\n──────────── 실제 플레이 경로 ────────────")
	print("  수평 누적 : %8.0f px" % 수평)
	print("  수직 누적 : %8.0f px" % 수직)
	print("  총 경로   : %8.0f px" % (수평 + 수직))
	print("  (STEP 10 = 10,620 · STEP 12 목표 ≥ 23,000)")
	print("══════════════════════════════════════════\n")
