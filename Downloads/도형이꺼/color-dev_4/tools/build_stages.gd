			[30, 11, 12, 2, "나무", "무색", false, true, 0],
			# 재질별 번짐 비교
			[10, 8, 4, 2, "벽돌", "무색", false, true, 0],
			[16, 8, 4, 2, "나무", "무색", false, true, 0],
			[22, 8, 4, 2, "바위", "무색", false, true, 0],
			[28, 8, 4, 2, "흙", "무색", false, true, 0],
