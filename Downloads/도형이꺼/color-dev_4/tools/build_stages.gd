## 상태 문자열 → PaintPlatform.상태 enum
const 상태표 := { "무색": 0, "검정": 1, "흰색": 2, "회색": 3 }

func _init() -> void:
	var 실패 := 0
	for 자료 in _스테이지_자료():
		실패 += _짓기(자료)
	print("\n[build_stages] 완료 — 실패 %d 건" % 실패)
	quit(실패)

