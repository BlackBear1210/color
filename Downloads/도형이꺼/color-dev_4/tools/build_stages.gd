# 씬 조립
# ============================================================================
func _짓기(자료: Dictionary) -> int:
	var root := Node2D.new()
	root.name = String(자료["파일"]).get_file().get_basename()
	root.set_script(load(STAGE_LAB))
	root.set("스테이지이름", 자료["이름"])
	root.set("다음스테이지", 자료["다음"])
	root.set("표현모드", 자료["표현모드"])
	root.set("시작색", 자료["시작색"])
	root.set("안내문", 자료["안내문"])

	var rng := RandomNumberGenerator.new()
	rng.seed = hash(자료["파일"])

	var 범위 := _지형_범위(자료)
	var 시작바이옴: String = 자료.get("바이옴시작", "자연")
	var 끝바이옴: String = 자료.get("바이옴끝", 시작바이옴)

	# ── 1) 배경 (하늘·뒷벽·실루엣 4겹·안개) ──
	var 배경 := Node2D.new()
	배경.name = "배경"
	root.add_child(배경)
	배경.owner = root
	BACKDROP.구성(배경, root, 범위, 시작바이옴, 끝바이옴, int(rng.randi()))

	# ── 2) 지형 (칠하는 발판) ──
	var 지형 := Node2D.new()
	지형.name = "지형"
	root.add_child(지형)
	지형.owner = root

	var 장식 := Node2D.new()
	장식.name = "지형장식"
	root.add_child(장식)
	장식.owner = root

	var i := 0
	for 줄 in 자료["지형"]:
		var p := AnimatableBody2D.new()
		p.set_script(load(발판씬))
		p.name = "발판_%02d" % i
		i += 1
		p.set("재질", 줄[4])
		p.set("크기_칸", Vector2i(줄[2], 줄[3]))
		p.set("시작상태", 상태표[줄[5]])
		p.set("무색일때_통과", 줄[6])
		p.set("칠하기_허용", 줄[7])
		p.set("필요횟수_수동", 줄[8])
		var 중심 := _칸_중심(줄[0], 줄[1], 줄[2], 줄[3])
		p.position = 중심
		지형.add_child(p)
		p.owner = root

		# ★발판 장식 — 윗면 풀/파이프 + 아랫면 늘어진 이끼.
		# 지형이 x 방향 어디쯤인가에 따라 시작/끝 바이옴 장식을 섞는다.
		var t := clampf((중심.x - 범위.position.x) / maxf(범위.size.x, 1.0), 0.0, 1.0)
		var 장식바이옴 := 끝바이옴 if rng.randf() < t else 시작바이옴
		BACKDROP.발판_장식(장식, root, 중심, Vector2(줄[2], 줄[3]) * 타일,
			장식바이옴, rng)

	# ── 3) 광원 (가로등 · 발광 구슬) ──
	var 조명 := Node2D.new()
	조명.name = "조명"
	root.add_child(조명)
	조명.owner = root
	var li := 0
	for g in 자료.get("가로등", []):
		BACKDROP.가로등(조명, root, "가로등_%d" % li, g[0], g[1], g[2])
		li += 1
	var oi := 0
	for o in 자료.get("구슬", []):
		BACKDROP.구슬(조명, root, "구슬_%d" % oi, Vector2(o[0], o[1]))
		oi += 1
	var wi := 0
	for w in 자료.get("수면", []):
		BACKDROP.수면(조명, root, "수면_%d" % wi, w[0], w[1], w[2], w[3], w[4])
		wi += 1

	# ── 4) 장애물 ──
	var 장애물 := Node2D.new()
	장애물.name = "장애물"
	root.add_child(장애물)
	장애물.owner = root
	var j := 0
	for o in 자료["장애물"]:
		var n := _장애물_만들기(o, 자료)
		if n == null:
			continue
		n.name = "%s_%02d" % [o["종류"], j]
		j += 1
		장애물.add_child(n)
		n.owner = root

	# ── 5) 스폰 마커 ──
	var 스폰 := Marker2D.new()
	스폰.name = "스폰"
	스폰.add_to_group("spawn_point")
	스폰.position = Vector2(자료["스폰"][0] * 타일 + 타일 * 0.5, 자료["스폰"][1] * 타일)
	root.add_child(스폰)
	스폰.owner = root

	# ── 6) 플레이어 ──
	var player: Node2D = (load(PLAYER_SCENE) as PackedScene).instantiate()
	player.name = "Player"
	player.position = 스폰.position
	root.add_child(player)
	player.owner = root

	# ── 7) UI 레이어 (StageHUD 는 stage_lab 이 런타임에 붙인다) ──
	var ui := CanvasLayer.new()
	ui.name = "UI"
	ui.layer = 10
	root.add_child(ui)
	ui.owner = root

	return _저장(root, 자료["파일"])

## 왼쪽 위 타일 좌표 + 칸 크기 → 노드 중심 좌표(px)
func _칸_중심(x: int, y: int, w: int, h: int) -> Vector2:
	return Vector2((x + w * 0.5) * 타일, (y + h * 0.5) * 타일)

## 지형이 차지하는 전체 범위(px) — 배경·카메라 계산용
func _지형_범위(자료: Dictionary) -> Rect2:
	var 최소 := Vector2(INF, INF)
	var 최대 := Vector2(-INF, -INF)
	for 줄 in 자료["지형"]:
		최소.x = minf(최소.x, 줄[0] * 타일)
		최소.y = minf(최소.y, 줄[1] * 타일)
		최대.x = maxf(최대.x, (줄[0] + 줄[2]) * 타일)
		최대.y = maxf(최대.y, (줄[1] + 줄[3]) * 타일)
	return Rect2(최소, 최대 - 최소)

## 통로의 "속빛" = 이어지는 지역의 하늘색. 출구는 끝 바이옴, 입구는 시작 바이옴.
func _속빛(자료: Dictionary, 출구: bool) -> Color:
	var 이름: String = 자료.get("바이옴끝" if 출구 else "바이옴시작", "자연")
	var b: Dictionary = BACKDROP.바이옴.get(이름, BACKDROP.바이옴["자연"])
	return b["하늘_위"]

func _장애물_만들기(o: Dictionary, 자료: Dictionary) -> Node2D:
	var 칸: Array = o["칸"]
	match String(o["종류"]):
		"가시":
			var n: Node2D = (load(씬_가시) as PackedScene).instantiate()
			n.set("칸수", o.get("칸수", 3))
			n.set("방향", o.get("방향", 0))
			n.position = Vector2((칸[0] + o.get("칸수", 3) * 0.5) * 타일, 칸[1] * 타일 - 11.0)
			return n
		"회전톱":
			var n2: Node2D = (load(씬_회전톱) as PackedScene).instantiate()
			n2.set("반지름", o.get("반지름", 26.0))
			n2.set("이동거리", o.get("이동거리", 0.0))
			n2.set("이동방향", o.get("이동방향", 0))
			n2.set("왕복시간", o.get("왕복시간", 3.0))
			n2.position = Vector2((칸[0] + 0.5) * 타일, (칸[1] + 0.5) * 타일)
			return n2
		"움직이는발판", "무너지는발판":
			var 경로 := 씬_움직이는발판 if String(o["종류"]) == "움직이는발판" else 씬_무너지는발판
			var n3: Node2D = (load(경로) as PackedScene).instantiate()
			var 크기: Array = o.get("크기칸", [4, 2])
			n3.set("재질", o.get("재질", "나무"))
			n3.set("크기_칸", Vector2i(크기[0], 크기[1]))
			n3.set("시작상태", 상태표[o.get("상태", "무색")])
			if String(o["종류"]) == "움직이는발판":
				n3.set("무색일때_통과", o.get("통과", true))
				n3.set("이동거리", o.get("이동거리", 128.0))
				n3.set("이동방향", o.get("이동방향", 0))
				n3.set("왕복시간", o.get("왕복시간", 5.0))
			else:
				# 무너지는 발판은 "밟아야" 무너지므로 유령(통과) 상태면 안 된다
				n3.set("무색일때_통과", false)
				n3.set("버티는시간", o.get("버티는시간", 0.7))
				n3.set("되살아나는시간", o.get("되살아나는시간", 2.4))
			n3.position = _칸_중심(칸[0], 칸[1], 크기[0], 크기[1])
			return n3
		"색문":
			var n4: Node2D = (load(씬_색문) as PackedScene).instantiate()
			var 크기2: Array = o.get("크기칸", [1, 4])
			n4.set("통과색", o.get("통과색", 0))
			n4.set("크기_칸", Vector2i(크기2[0], 크기2[1]))
			n4.position = Vector2((칸[0] + 크기2[0] * 0.5) * 타일,
				칸[1] * 타일 - 크기2[1] * 타일 * 0.5)
			return n4
		"떨어지는블록":
			var n5: Node2D = (load(씬_떨어지는블록) as PackedScene).instantiate()
			var 크기3: Array = o.get("크기칸", [2, 2])
			n5.set("크기_칸", Vector2i(크기3[0], 크기3[1]))
			n5.set("감지높이", o.get("감지높이", 320.0))
			n5.position = _칸_중심(칸[0], 칸[1], 크기3[0], 크기3[1])
			return n5
		"체크포인트":
			var n6: Node2D = (load(씬_체크포인트) as PackedScene).instantiate()
			n6.position = Vector2((칸[0] + 0.5) * 타일, 칸[1] * 타일)
			return n6
		"통로":
			var n7: Node2D = (load(씬_통로) as PackedScene).instantiate()
			var 출구 := int(o.get("역할", 0)) == 0
			n7.set("역할", 0 if 출구 else 1)
			n7.set("폭", o.get("폭", 128))
			n7.set("높이", o.get("높이", 156))
			# ★출구의 속빛 = 이 스테이지 끝 바이옴 / 입구 = 시작 바이옴
			#   → 통로를 지나면 방금 본 빛깔의 하늘이 실제로 펼쳐진다
			n7.set("속빛", _속빛(자료, 출구))
			n7.position = Vector2((칸[0] + 0.5) * 타일, 칸[1] * 타일)
			return n7
		"낙하지대":
			var n8: Node2D = (load(씬_낙하지대) as PackedScene).instantiate()
			n8.set("폭", o.get("폭", 3000))
			n8.set("높이", o.get("높이", 200))
			n8.position = Vector2(칸[0] * 타일, 칸[1] * 타일)
			return n8
	push_warning("[build_stages] 알 수 없는 장애물 종류: %s" % o["종류"])
	return null

func _저장(root: Node, 경로: String) -> int:
	DirAccess.make_dir_recursive_absolute(경로.get_base_dir())
	var packed := PackedScene.new()
	var err := packed.pack(root)
	if err == OK:
		err = ResourceSaver.save(packed, 경로)
	if err == OK:
		print("  ✔ %s  (지형 %d · 배경 %d · 조명 %d)" % [경로,
			root.get_node("지형").get_child_count(),
			root.get_node("배경").get_child_count(),
			root.get_node("조명").get_child_count()])
	else:
		printerr("  ✘ %s  err=%d" % [경로, err])
	root.free()
	return 0 if err == OK else 1
