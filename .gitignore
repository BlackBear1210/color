# Godot 4+ specific ignores
.godot/
/android/

# 도형 스크린샷 검증 산출물 (screenshot_scene.gd 출력 — 커밋 불필요)
tools/_shots/

# ────────────────────────────────────────────────────────────────────────────
# [2026-08-06] 프로젝트 사본이 저장소 안으로 다시 들어오는 것을 막는다.
#   과거에 Downloads/도형이꺼/color-dev_4 와 OneDrive/Desktop/새 폴더 (2)/color
#   두 벌(추적 파일 1,005개 = 전체의 61%)이 통째로 커밋돼 있었다.
#   실수로 프로젝트 폴더 안에 압축을 풀거나 백업을 떨구면 또 같은 일이 생기므로
#   Windows 사용자 폴더 이름을 아예 무시 목록에 넣어 둔다.
# ────────────────────────────────────────────────────────────────────────────
/Downloads/
/OneDrive/
/Desktop/
/Documents/

# 프로젝트 사본·백업 압축 파일
*.zip
*.7z
*.rar
/_backup/
/_백업/

# Godot 에디터가 남기는 임시 산출물
*.tmp
*.translation
export_presets.cfg

# STEP 2.5~2.6 스크래치 굽기 결과 (검증용 · 커밋하지 않는다)
/_미리보기/

# Gemini API 키 (개인 키, 절대 커밋 금지)
tools/gemini_pipeline/.env

# graphify 생성물 (그래프는 로컬에서 다시 만들 수 있다)
graphify-out/

# [2026-10-04] 파이썬 도구 캐시(tools/**/__pycache__) — 다시 생기는 파일
__pycache__/
*.pyc

# [2026-10-04] 로컬 생성물 — 커밋하지 않는다(다시 만들 수 있다)
#   tools/_진단/                    엔진 촬영·진단 결과(tools/촬영_*.gd · 진단_*.gd · 시험_연결전환.gd)
#   scenes/쳅터1/도안/미리보기/      도안 합성 미리보기(python tools/쳅터1/만들기.py 가 다시 만든다)
tools/_진단/
scenes/쳅터1/도안/미리보기/

# 작업 백업·검증 도구는 로컬에만 둔다. Godot 중복 클래스 재발을 막는 검색 제외 표식은 공유한다.
/tmp/*
!/tmp/.gdignore
