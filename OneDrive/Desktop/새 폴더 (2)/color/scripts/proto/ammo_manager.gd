extends Node
## ============================================================================
## [2026-07-31 도형 · 신규] 탄약(페인트) 잔량 — 오토로드(전역 싱글턴)
## ----------------------------------------------------------------------------
## ▣ 규칙 (동현 페인트 시스템 정리 문서 기준)
##   · 플랫폼을 다 칠하면(완성) 탄약 1발 소모
##   · 완성된 플랫폼에 반대색을 쏴 회색으로 만드는 것도 "완성 이벤트" → 또 1발 소모
##     (그래서 회색 하나 = 총 2발: 처음 칠할 때 1발 + 회색으로 덮을 때 1발)
##   · E 로 수동 회수(FIFO)하면 그 플랫폼 몫만큼 즉시 환급
##   · 회색은 수동 회수가 안 되므로 스테이지를 넘어가야만 돌아온다 —
##     이건 여기서 따로 처리하지 않는다. 스테이지 전환 = 씬 전체가 새로 로드되며
##     이전 TilePaintMap(회색 포함)이 통째로 사라지고, stage_lab.gd 가 다음 스테이지
##     _ready() 에서 리셋() 을 불러 잔량을 최대치로 채운다.
## ▣ 전역 접근
##   project.godot [autoload] 에 "탄약" 이름으로 등록되어 있어 어느 스크립트에서든
##   `탄약.소모(1)` 처럼 바로 쓸 수 있다(자동주입 싱글턴).
## ============================================================================
class_name AmmoManager

signal 변경(남은: int, 최대: int)

var 최대: int = 10
var 남은: int = 10

## 스테이지 시작 시 stage_lab 이 호출 — 잔량을 최대치로 채운다.
func 리셋(최대치: int) -> void:
	최대 = maxi(최대치, 0)
	남은 = 최대
	변경.emit(남은, 최대)

## 성공하면 잔량을 깎고 true, 부족하면 아무것도 안 하고 false.
func 소모(수량: int = 1) -> bool:
	if 남은 < 수량:
		return false
	남은 -= 수량
	변경.emit(남은, 최대)
	return true

## E 수동 회수 등으로 되돌릴 때 호출 — 최대치를 넘지 않는다.
func 환급(수량: int = 1) -> void:
	남은 = mini(남은 + 수량, 최대)
	변경.emit(남은, 최대)
