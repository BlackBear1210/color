extends SceneTree
## ============================================================================
## [2026-08-06 신규] 통로 연결 · 장면 전환 자동 검사
## ----------------------------------------------------------------------------
## 실행:
##   Godot --headless --path . -s res://tools/test_통로전환.gd
##
## ▣ 무엇을 보나 (전부 "눈으로 보면 당연한데 코드로는 자주 깨지는" 것들)
##   1. 두 스테이지가 서로를 제대로 가리키는가 (출구의 다음_씬 / 다음_진입점)
##   2. 통로가 물리적으로 통로인가 — 바닥·천장·뒷벽 콜리전이 실제로 있는가
##      (천장이 없으면 뛰어넘어 갈 수 있어서 "반드시 통로를 지난다"가 깨진다)
##   3. 출구 통로에 몸이 닿으면 실제로 씬이 바뀌는가
##   4. 바뀐 씬에서 플레이어가 **입구 통로 안**에서 시작하는가
##      (여기가 어긋나면 "순간이동해서 나타난" 그림이 되어 통로를 만든 의미가 없다)
##   5. 전환 중에는 사망 판정이 멈추는가 (암전 중에 죽으면 다음 씬에서 이상해진다)
##
## ▣ 왜 헤드리스에서 되나
##   장면전환은 Tween + change_scene_to_file 이라 렌더가 필요 없다.
##   다만 `Engine.max_fps = 60` 을 안 걸면 헤드리스가 수천 fps 로 돌아
##   "몇 프레임 기다리기" 가 실제 시간과 어긋난다 → 반드시 고정한다.
## ============================================================================

const 씬_1 := "res://scenes/스마트월드/스마트월드_1.tscn"
const 씬_2 := "res://scenes/스마트월드/스마트월드_2.tscn"

var _통과 := 0
var _실패 := 0
var _n := 0
var _단계 := 0
var _루트: Node = null
var _출구위치 := Vector2.ZERO


func _init() -> void:
	Engine.max_fps = 60
	process_frame.connect(_tick)


func _확인(조건: bool, 설명: String) -> void:
	if 조건:
		_통과 += 1
		print("  ✔ %s" % 설명)
	else:
		_실패 += 1
		print("  ✖ %s" % 설명)


func _tick() -> void:
	_n += 1
	match _단계:
		0:
			if _n == 1:
				_정적_검사()
				_단계 = 1
				_n = 0
		1:
			# ── 1-1 을 띄우고 플레이어를 출구 통로 앞에 세운다 ──
			if _n == 1:
				_루트 = (load(씬_1) as PackedScene).instantiate()
				root.add_child(_루트)
				# ★current_scene 으로 등록해야 change_scene_to_file 이 이 씬을 **해제**한다.
				#   등록 안 하면 1-1 이 트리에 그대로 남아 1-2 와 겹치고,
				#   두 스테이지의 "입구통로"가 동시에 존재해 스폰 위치가 엉킨다.
				current_scene = _루트
			elif _n == 6:
				var 출구 := _통로_찾기(_루트, 0)
				if 출구 == null:
					_확인(false, "스마트월드1 에 출구 통로가 있다")
					_끝내기()
					return
				_출구위치 = (출구 as Node2D).global_position
				var p := _루트.get_node_or_null("Player") as CharacterBody2D
				# 통로 판정은 안쪽 66% 지점이다. 넉넉히 안쪽에 놓는다.
				p.global_position = _출구위치 + Vector2(float(출구.get("깊이")) * 0.70, -20.0)
				p.velocity = Vector2.ZERO
			elif _n == 14:
				_확인(장면전환.진행중인가(), "출구 통로에 닿으면 장면 전환이 시작된다")
				_단계 = 2
				_n = 0
		2:
			# ── 전환이 끝나 스마트월드2 로 바뀔 때까지 기다린다 ──
			# 암전 0.85 + 암흑 0.22 + 점등 1.35 ≈ 2.4 초 = 약 145 프레임. 넉넉히 260.
			var 현재 := current_scene
			if 현재 and 현재.scene_file_path == 씬_2:
				_도착_검사(현재)
				_단계 = 3
				_n = 0
				return
			if _n > 260:
				_확인(false, "2.4 초 안에 스마트월드2 로 바뀐다 (현재: %s)"
					% [현재.scene_file_path if 현재 else "없음"])
				_끝내기()
				return
		3:
			# ── 점등(1.35초)까지 다 끝나야 전환 플래그가 풀린다 ──
			# 여기를 안 기다리고 바로 확인하면 "아직 진행 중" 이라 헛실패가 난다.
			if not 장면전환.진행중인가():
				_확인(true, "점등이 끝나면 전환 플래그가 해제된다 (%d 프레임)" % _n)
				_끝내기()
				return
			if _n > 200:
				_확인(false, "점등 후 전환 플래그가 해제된다")
				_끝내기()
				return


# ============================================================================
# 정적 검사 — 씬을 띄우지 않고 파일만 보고 확인
# ============================================================================
func _정적_검사() -> void:
	print("")
	print("── 정적 검사 ──────────────────────────────────")
	for 경로 in [씬_1, 씬_2]:
		_확인(ResourceLoader.exists(경로), "씬이 있다: %s" % 경로.get_file())

	# ⚠ 연결통로의 바닥·천장·뒷벽은 **런타임에** `_ready()` 안에서 만들어진다
	#   (씬 파일에는 저장되지 않는다 — 생성기가 만든 트리는 SceneTree 밖이라
	#    _ready 가 안 돌기 때문). 그래서 그냥 instantiate 만 하면 셋 다 없다.
	#   → 검사하려면 반드시 **트리에 붙여서** _ready 를 돌려야 한다.
	#
	# ⚠⚠[2026-08-07] 두 스테이지를 **동시에** 트리에 올리면 안 된다.
	#   스마트월드 씬은 페인트코어·유체·송풍기·호퍼를 전부 **그룹**으로 찾는다.
	#   두 벌이 같이 있으면 서로의 노드를 잡고, 그 상태에서 씬을 교체하면
	#   이미 해제된 노드를 참조해 **엔진이 세그폴트(signal 11)로 죽는다.**
	#   → 한 번에 하나씩 올리고, 검사가 끝나면 즉시 트리에서 떼어 낸다.
	var s1 := (load(씬_1) as PackedScene).instantiate()
	root.add_child(s1)
	var s2 := (load(씬_2) as PackedScene).instantiate()

	var 출구1 := _통로_찾기(s1, 0)
	var 입구2: Node = _통로_찾기(s2, 1)
	_확인(출구1 != null, "스마트월드1 에 출구 통로가 있다")
	_확인(입구2 != null, "스마트월드2 에 입구 통로가 있다")

	if 출구1 and 입구2:
		_확인(String(출구1.get("다음_씬")) == 씬_2, "스마트월드1 출구가 1-2 를 가리킨다")
		_확인(String(출구1.get("다음_진입점")) == 입구2.name,
			"스마트월드1 출구의 진입점 이름('%s')이 1-2 입구 이름('%s')과 같다"
			% [출구1.get("다음_진입점"), 입구2.name])

	# 통로가 물리적으로 통로인가 — 셋 다 있어야 "뛰어넘어 갈 수 없는 굴" 이 된다.
	# s1 은 이미 트리에 있으므로 지금 검사하고, s2 는 s1 을 뗀 뒤에 검사한다.
	_통로_부품_검사(출구1)
	# 바이옴 연결 — 출구의 속빛이 다음 지역 하늘색이어야 "이어진다"가 성립한다.
	# ⚠ 반드시 s1 을 해제하기 **전에** 봐야 한다. free() 뒤에 출구1 을 만지면
	#   이미 사라진 노드를 읽는 것이라 값이 쓰레기이거나 크래시가 난다.
	if 출구1:
		var 속빛: Color = 출구1.get("속빛")
		_확인(속빛.v < 0.6,
			"스마트월드1 출구 속빛이 하늘색 대역(어두움)이다 — v=%.2f" % 속빛.v)

	root.remove_child(s1)
	s1.free()                     # queue_free 가 아니라 즉시 해제 — 겹침을 확실히 없앤다
	root.add_child(s2)
	입구2 = _통로_찾기(s2, 1)      # 트리에 붙은 뒤 _ready 가 돌아 부품이 생긴다
	_통로_부품_검사(입구2)

	# 다음 단계에서 스마트월드1 을 다시 띄우므로 여기서 반드시 치운다.
	root.remove_child(s2)
	s2.free()


# ============================================================================
# 도착 검사 — 스마트월드2 로 넘어온 뒤
# ============================================================================
func _도착_검사(씬: Node) -> void:
	print("")
	print("── 도착 검사 (스마트월드2) ────────────────────────────")
	var 입구 := _통로_찾기(씬, 1)
	var p := 씬.get_node_or_null("Player") as CharacterBody2D
	_확인(입구 != null and p != null, "스마트월드2 에 입구 통로와 Player 가 있다")
	if 입구 == null or p == null:
		return

	# 통로 스스로가 "여기서 걸어 나온다" 고 답하는 자리와 실제 위치를 비교한다.
	var 기대: Vector2 = 입구.call("걸어나올_위치")
	var 거리 := p.global_position.distance_to(기대)
	# 몇 프레임 지나며 중력으로 조금 내려왔을 수 있으므로 넉넉히 본다
	_확인(거리 < 140.0,
		"플레이어가 입구 통로 안에서 시작한다 (기대 %s / 실제 %s · 오차 %.0fpx)"
		% [str(기대.round()), str(p.global_position.round()), 거리])

	# 통로 안 = 시작 위치(160, 860)가 아니어야 한다.
	# 이게 같으면 "이월 정보"가 안 넘어온 것이다 = 통로가 포탈처럼 동작한 셈.
	var 기본시작: Vector2 = 씬.get("시작_위치")
	_확인(p.global_position.distance_to(기본시작) > 200.0,
		"기본 시작 위치가 아니라 통로 위치에서 시작했다")

	# 이월 정보는 한 번 쓰고 비워져야 한다 (다음에 F5 로 그냥 실행할 때 남으면 안 됨)
	_확인(장면전환.진입_정보().is_empty(), "진입 정보가 소비되어 비워졌다")


# ============================================================================
## 통로가 바닥·천장·뒷벽을 실제로 지었는지 확인한다.
func _통로_부품_검사(통로: Node) -> void:
	if 통로 == null:
		return
	for 부분 in ["바닥", "천장", "뒷벽"]:
		var 바디 := 통로.get_node_or_null(NodePath(부분)) as StaticBody2D
		_확인(바디 != null and 바디.collision_layer == 1,
			"%s 의 %s 콜리전이 있다" % [통로.name, 부분])


func _통로_찾기(씬: Node, 역할: int) -> Node:
	for n in _모든자식(씬):
		if n is 연결통로 and int(n.get("역할")) == 역할:
			return n
	return null


func _모든자식(n: Node) -> Array:
	var out: Array = []
	for c in n.get_children():
		out.append(c)
		out.append_array(_모든자식(c))
	return out


func _끝내기() -> void:
	print("")
	print("[test_통로전환] 통과 %d / 실패 %d" % [_통과, _실패])
	quit(_실패)
