extends SceneTree
## ============================================================================
## [2026-09-20 신규] 스테이지 생성기 진입점 — 씨앗 하나로 스테이지 하나를 굽는다
## ----------------------------------------------------------------------------
## 실행:
##   Godot --headless --path . -s res://tools/생성_스테이지.gd -- [옵션]
##
##   --설정=집|하수도       어느 챕터 설정으로 만들 것인가 (기본 집)
##   --씨앗=1001            같은 씨앗 = 같은 맵. 여러 개면 쉼표로 (--씨앗=1001,1002,1003)
##   --길이=10000           목표 진행 길이(px). 상한이지 할당량이 아니다
##   --출력=res://...tscn   저장 경로 (기본 <설정.출력_폴더>/스테이지_1_2층방_s<씨앗>.tscn)
##   --굽지마               검증만 하고 씬은 안 만든다 (씨앗 고르기용 · 빠르다)
##   --적용                 ★기존 씬의 `지형` 노드만 갈아 끼운다 (배경·조명은 그대로)
##   --대상=res://...tscn   --적용 이 고칠 씬 (기본 res://scenes/집/스테이지_1_2층방.tscn)
##
## ▣ 권장 절차
##   1. `--씨앗=1001,1002,...,1010 --굽지마` 로 **통과하는 씨앗만 고른다** (1 초면 끝난다)
##   2. 마음에 드는 씨앗 하나로 씬을 굽는다
##   3. `tools/레벨검사.gd` 로 **엔진 물리 실측**을 한다 (해석적 검증의 최종 확인)
##   4. 그 다음에야 `--적용` 으로 실제 스테이지에 넣는다
##
## ⚠ `--적용` 은 되돌릴 수 없다. 자동으로 `.bak.tscn` 을 만들지만, 그 전에 커밋해 둘 것.
## ============================================================================

const 설정_S := preload("res://tools/생성기/설정.gd")
const 생성기_S := preload("res://tools/생성기/생성기.gd")
const 검증_S := preload("res://tools/생성기/검증.gd")
const 조립_S := preload("res://tools/생성기/조립.gd")

var _설정이름 := "집"
var _씨앗들: Array[int] = []
var _길이 := 0.0
var _출력 := ""
var _굽지마 := false
var _적용 := false
var _대상 := "res://scenes/집/스테이지_1_2층방.tscn"


func _init() -> void:
	call_deferred("_go")


func _go() -> void:
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with("--설정="):
			_설정이름 = a.substr("--설정=".length())
		elif a.begins_with("--씨앗="):
			for s in a.substr("--씨앗=".length()).split(","):
				_씨앗들.append(int(s))
		elif a.begins_with("--길이="):
			_길이 = float(a.substr("--길이=".length()))
		elif a.begins_with("--출력="):
			_출력 = a.substr("--출력=".length())
		elif a.begins_with("--대상="):
			_대상 = a.substr("--대상=".length())
		elif a == "--굽지마":
			_굽지마 = true
		elif a == "--적용":
			_적용 = true
	if _씨앗들.is_empty():
		_씨앗들 = [1001]

	var 설정 = 설정_S.이름으로(_설정이름)
	if 설정 == null:
		print("✗ 모르는 설정: %s  (집 · 하수도)" % _설정이름)
		quit(1)
		return
	if _길이 > 0.0:
		설정.목표_길이 = _길이

	var 통과 := 0
	var 합격_씨앗: Array = []
	for 씨앗 in _씨앗들:
		if await _한판(설정, 씨앗):
			통과 += 1
			합격_씨앗.append(씨앗)

	print("")
	print("════════ 씨앗 %d 개 중 %d 개 통과 ════════" % [_씨앗들.size(), 통과])
	if 합격_씨앗.size() > 0:
		print("  통과한 씨앗: %s" % str(합격_씨앗))
	quit(0 if 통과 > 0 else 1)


func _한판(설정: RefCounted, 씨앗: int) -> bool:
	var t0 := Time.get_ticks_msec()
	var 결과 := 생성기_S.생성(설정, 씨앗)
	var 생성_ms := Time.get_ticks_msec() - t0

	var 검 := 검증_S.전부(결과["플랫폼"], 결과["사격"], 결과["시작"], 결과["끝"])

	# ── 보고 ────────────────────────────────────────────────────────────────
	var 범위: Rect2 = 결과["범위"]
	var 유령수 := 0
	var 구조수 := 0
	for p in 결과["플랫폼"]:
		if String(p["종류"]) == "유령":
			유령수 += 1
		elif String(p["종류"]) == "구조":
			구조수 += 1
	var 종류별 := {}
	var 난이도합 := 0
	for c in 결과["청크들"]:
		종류별[c["종류"]] = int(종류별.get(c["종류"], 0)) + 1
		난이도합 += int(c["난이도"])

	print("")
	print("════════════════════════════════════════════════════════════════")
	print(" 스테이지 생성 — 설정 %s · 씨앗 %d" % [설정.이름, 씨앗])
	print("════════════════════════════════════════════════════════════════")
	print("  진행 길이 : %.0f px   (맵 %.0f × %.0f · 화면 %.1f 장)"
		% [결과["진행길이"], 범위.size.x, 범위.size.y, 범위.size.x * 범위.size.y / (1920.0 * 1080.0)])
	print("  청크      : %d 개 · 평균 난이도 %.1f · %s"
		% [결과["청크들"].size(), float(난이도합) / maxf(결과["청크들"].size(), 1), str(종류별)])
	print("  지형      : %d 개 (유령 %d · 구조 %d) · 위험물 %d · 사격 지점 %d"
		% [결과["플랫폼"].size(), 유령수, 구조수, 결과["위험물"].size(), 결과["사격"].size()])
	print("  공략      : %d 단계 · 생성 %d ms" % [결과["공략"].size(), 생성_ms])
	# ★청크가 "조용히 대체" 되는 것을 반드시 보여 준다 — 안 그러면 F·I 가 한 번도 안 나오는데
	#   보고서는 멀쩡해 보인다(처음 돌렸을 때 실제로 그랬다).
	var 기록: Dictionary = 결과.get("기록", {})
	if int(기록.get("재시도", 0)) > 0 or not (기록.get("대체", {}) as Dictionary).is_empty():
		print("  생성 재시도: %d 회" % int(기록.get("재시도", 0)))
		for k in (기록.get("대체", {}) as Dictionary):
			print("    ⚠ %s 청크를 못 만들어 기본이동으로 대체 — %s" % [k, 기록["대체"][k]])
	print("")
	print("  [검증]")
	print("    도달률  : %.0f%% (발판 %d 개)"
		% [float(검["숫자"].get("도달률", 0.0)) * 100.0, int(검["숫자"].get("발판수", 0))])
	for m in 검["문제"]:
		print("    ✖ %s" % m)
	for m in (검["경고"] as Array).slice(0, 6):
		print("    ⚠ %s" % m)
	if (검["문제"] as Array).is_empty():
		print("    ✔ 도달성 · 보행성 · 사격 시야 전부 통과")

	if not 검["통과"]:
		print("  → 이 씨앗은 버린다(굽지 않는다). 다른 씨앗을 쓸 것.")
		return false
	if _굽지마:
		print("  → 검증만 했다(--굽지마).")
		return true

	# ── 굽기 ────────────────────────────────────────────────────────────────
	var 조립 = 조립_S.new()
	if _적용:
		print("  [적용] 기존 씬의 `지형` 만 교체 — %s" % _대상)
		if not 조립.지형만_교체(_대상, 결과, 설정):
			print("    ✖ 적용 실패")
			return false
		print("    ✔ 적용 완료")
		_곁들임_저장(_대상, 결과, 설정)
		return true

	var 경로 := _출력
	if 경로 == "":
		경로 = "%s%s_s%d.tscn" % [설정.출력_폴더, _씬이름(설정), 씨앗]
	var 루트 := 조립.굽기(결과, 설정, _씬이름(설정))
	if not 조립.저장(루트, 경로):
		print("    ✖ 저장 실패: %s" % 경로)
		return false
	print("  [저장] %s" % 경로)
	_곁들임_저장(경로, 결과, 설정)
	return true


func _씬이름(설정: RefCounted) -> String:
	return "스테이지_1_2층방" if 설정.이름 == "집" else "스테이지_생성"


## 씨앗·청크 목록·공략을 씬 옆에 `.json` 으로 남긴다.
## ▣ 왜 남기나
##   · **재현**: 같은 씨앗으로 같은 맵을 다시 뽑을 수 있다
##   · **추적**: 나중에 "이 방이 왜 여기 있지" 를 청크 목록으로 읽을 수 있다
##   · **주행검사**: `공략` 을 `tools/하수도_주행검사.gd` 의 §공략표에 붙여 넣으면
##     사람이 푸는 순서를 엔진이 그대로 태워 볼 수 있다
func _곁들임_저장(씬경로: String, 결과: Dictionary, 설정: RefCounted) -> void:
	var 청크표: Array = []
	for c in 결과["청크들"]:
		청크표.append({
			"이름": c["이름"], "종류": c["종류"], "난이도": c["난이도"],
			"시작": [c["시작"].x, c["시작"].y], "출구": [c["출구"].x, c["출구"].y],
			"메모": c["메모"],
		})
	var 자료 := {
		"씨앗": 결과["씨앗"],
		"설정": 설정.이름,
		"생성날짜": "2026-09-20",
		"진행길이": 결과["진행길이"],
		"맵범위": [결과["범위"].position.x, 결과["범위"].position.y,
			결과["범위"].size.x, 결과["범위"].size.y],
		"시작": [결과["시작"].x, 결과["시작"].y],
		"끝": [결과["끝"].x, 결과["끝"].y],
		"청크": 청크표,
		"공략": 결과["공략"],
	}
	var 경로 := 씬경로.get_basename() + "_생성정보.json"
	var f := FileAccess.open(경로, FileAccess.WRITE)
	if f == null:
		push_error("생성정보를 못 썼다: %s" % 경로)
		return
	f.store_string(JSON.stringify(자료, "\t"))
	f.close()
	print("  [기록] %s" % 경로.get_file())
