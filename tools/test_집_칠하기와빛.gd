extends SceneTree
## ============================================================================
## [2026-08-25 신규] 집 챕터 4 방 — **칠하기 · 유령 발판 · 빛 경계** 통합 검사
## ----------------------------------------------------------------------------
## 실행:  godot --headless --path . -s res://tools/test_집_칠하기와빛.gd
##
## ▣ 왜 만들었나 (도형님 지적)
##   *"플레이어가 색을 쏘면 지형이 바뀌어야하고 창문으로 나오는 빛이 경계로 작용되어야
##     하는데 하나도 제대로 작용되는게 없어."*
##
##   `레벨검사.gd` 는 **지형의 모양**만 본다. 색·빛은 안 본다. 그래서 v1 은
##   "검사 전부 통과"인데 정작 게임의 핵심 규칙이 하나도 안 돌고 있었다.
##   → 모양이 아니라 **규칙**을 재는 검사가 따로 있어야 한다. 그게 이 파일이다.
##
## ▣ 무엇을 재나 (방마다 7 항목)
##   1. 유령 발판이 무색일 때 **통과**되는가 (콜리전 레이어 8 · 반투명)
##   2. 총알을 맞으면 **색이 실제로 바뀌는가** (`명중()` → 현재상태)
##   3. 칠해진 뒤 **밟을 수 있게** 되는가 (콜리전 레이어 1)
##   4. 페인트 **셰이더가 붙었는가** — 안 붙으면 색이 바뀌어도 화면은 그대로다
##      (흑↔백 짝 텍스처를 못 찾으면 조용히 안 붙는다. v2 재질에서 실제로 터졌던 자리)
##   5. 빛기둥이 **경계 그룹**에 들어갔는가 (`색경계` · `빛경계`)
##   6. 유령 발판이 **빛 안**에 있는가 — `색경계.강제색_at()` 이 흰색을 돌려주는가
##      ★이게 퍼즐의 전부다. 빛 안이라서 "흰색으로 칠해라"가 성립한다.
##   7. 검정으로 칠하면 **흰색 몸에게 치명적**이 되는가 (`반대색인가()`)
##
## ▣ 게이트 높이는 여기서 안 잰다
##   "점프로 못 넘는가" 는 좌표 산수라 빌더 주석에 근거를 적어 뒀고,
##   `레벨검사.gd` 가 도달 가능성으로 따로 검증한다. 여기서는 색 규칙만 본다.
## ============================================================================
const 색경계_S := preload("res://scripts/스마트월드/색경계.gd")
const 색상 := preload("res://scripts/color_defs.gd")

## 방마다 [씬경로, 유령발판이름, 빛이름]
const 대상 := [
	["res://scenes/집/집_2층방.tscn", "SS_WOOD_GHOST_01", "창문빛"],
	["res://scenes/집/집_거실.tscn", "SS_WOOD_TABLE_01", "창문빛"],
	["res://scenes/집/집_부엌.tscn", "SS_WOOD_GHOST_01", "전등빛"],
	["res://scenes/집/집_굴뚝.tscn", "SS_WOOD_GHOST_01", "굴뚝빛"],
]

var _통과 := 0
var _실패 := 0
var _칸 := 0
var _씬: Node = null
var _현재 := -1


func _init() -> void:
	Engine.max_fps = 60
	process_frame.connect(_틱)


func _틱() -> void:
	_칸 += 1
	# 한 방당 12 프레임: 0~3 로드·물리 안정, 4 에서 검사, 8 에서 해제.
	var 단계 := _칸 % 12
	var 번호 := int(_칸 / 12)
	if 번호 >= 대상.size():
		_끝내기()
		return
	if 단계 == 1:
		_현재 = 번호
		_씬 = (load(대상[번호][0]) as PackedScene).instantiate()
		root.add_child(_씬)
	elif 단계 == 5:
		_검사(대상[번호][0], 대상[번호][1], 대상[번호][2])
	elif 단계 == 9:
		if _씬 != null:
			_씬.queue_free()
			_씬 = null


func _확인(조건: bool, 설명: String) -> void:
	if 조건:
		_통과 += 1
		print("      ✔ %s" % 설명)
	else:
		_실패 += 1
		print("      ✖ %s" % 설명)


func _검사(경로: String, 유령이름: String, 빛이름: String) -> void:
	print("\n── %s ─────────────────────" % 경로.get_file())

	var 지형층 := _씬.get_node_or_null("지형")
	var 유령: Node2D = 지형층.get_node_or_null(유령이름) if 지형층 else null
	var 빛: Node2D = null
	var 오브 := _씬.get_node_or_null("오브젝트")
	if 오브:
		빛 = 오브.get_node_or_null(빛이름)

	if 유령 == null or 빛 == null:
		_확인(false, "유령 발판(%s) · 빛(%s) 노드를 찾았다" % [유령이름, 빛이름])
		return

	# ── 1. 무색일 때는 통과되는 유령이어야 한다 ──────────────────────────────
	var 바디 := 유령.get_node_or_null("StaticBody2D") as StaticBody2D
	_확인(유령.get("무색일때_통과") == true and 유령.get("칠하기_허용") == true,
		"유령 발판이 '칠해야 실체가 되는' 설정이다")
	_확인(바디 != null and 바디.collision_layer == 8,
		"무색 상태에서 콜리전 레이어 8(통과) — 현재 %d" % (바디.collision_layer if 바디 else -1))
	_확인(absf(유령.modulate.a - 0.42) < 0.05,
		"무색 상태에서 반투명하게 보인다 (alpha %.2f)" % 유령.modulate.a)

	# ── 4. 페인트 셰이더가 붙었는가 (색이 바뀌어도 화면이 안 바뀌면 무의미) ──
	var 셰이더들: Array = 유령.get("_셰이더들")
	_확인(셰이더들 != null and 셰이더들.size() > 0,
		"페인트 셰이더가 붙었다 (흑↔백 짝 텍스처 %d 벌)" % (셰이더들.size() if 셰이더들 else 0))

	# ── 5·6. 경계가 있는가 + 유령 발판이 그 경계 안에 있는가 ─────────────────
	# ★[2026-08-26 일반화] 예전에는 "**빛기둥**이 색경계 그룹에 있는가" 를 봤다.
	#   그건 규칙이 아니라 **구현 하나**를 검사한 것이다. `색경계.gd` 는 덕 타이핑이라
	#   경계 구현체가 셋(ColorZone · 빛기둥 · 식물B)이고, 2층 방은 도형님 지시로
	#   **김동현 작업자의 ColorZone** 을 쓰도록 바뀌었다(빛기둥은 모드=연출로 내려갔다).
	#   → 검사도 규칙 쪽으로 올린다: "누가 됐든 **흰색을 강제하는 경계**가 이 자리에 있는가".
	var 경계들 := _씬.get_tree().get_nodes_in_group("색경계")
	_확인(not 경계들.is_empty(),
		"이 방에 색 경계가 있다 (%d 개)" % 경계들.size())

	# 유령 발판 윗면 한가운데 = 플레이어가 실제로 서는 자리
	var 폴리 := 유령.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	var 윗면 := _윗면_중앙(유령, 폴리)

	# (6-a) **레벨 디자인 사실** — 발판이 경계 안에 들어와 있는가.
	#   이게 참이어야 "경계와 같은 색으로 칠해라" 라는 퍼즐 자체가 성립한다.
	#   ⚠ 빛기둥은 `강제색()` 이 `_강제_걸림` 을 켜야 답하므로(물듦 연출), 여기서는
	#     색이 아니라 **기하**(경계 폴리곤 안인가)로 본다 — 두 구현 모두에 통한다.
	var 안에있나 := false
	for n in 경계들:
		if not n.has_method("경계_폴리곤들"):
			continue
		for poly in n.경계_폴리곤들():
			if Geometry2D.is_point_in_polygon(윗면, poly):
				안에있나 = true
				break
		if 안에있나:
			break
	_확인(안에있나, "유령 발판 윗면 %s 이 색 경계 안이다" % 윗면)

	# (6-b) **런타임 규칙** — 그 자리에서 실제로 흰색이 강제되는가.
	#   ⚠ `강제색()` 은 `_강제_걸림` 이 켜져야 답한다. 그건 "경계에 다가가면 몸이 서서히
	#     물들고, 다 물든 뒤에 색이 바뀐다"는 연출 때문이다(빛기둥.gd §경계).
	#     헤드리스 검사에는 플레이어가 서 있질 않으니 물듦이 안 돈다 → 다 물든 상태를
	#     직접 만들어 주고 규칙만 확인한다.
	빛.set("_강제_걸림", true)
	var 강제 := 색경계_S.강제색_at(self, 윗면)   # ★이 스크립트 자신이 SceneTree 다
	_확인(강제 == 색상.WHITE,
		"다 물든 뒤 그 자리의 강제색이 흰색이다 — %d" % 강제)

	# ── 2·3. 총알을 맞히면 실제로 색이 바뀌고 밟을 수 있게 되는가 ────────────
	# 한 발로 안 되는 크기면 `필요횟수()` 만큼 반복해야 전체 색칠로 승격된다.
	var 필요: int = 유령.필요횟수()
	var 결과 := ""
	for i in maxi(필요, 1) + 1:
		결과 = 유령.명중(색상.WHITE, 윗면)
		if 결과 == "painted":
			break
	_확인(결과 == "painted", "흰색 총알 %d 발로 전체 색칠됐다 (결과 '%s')" % [필요, 결과])
	_확인(유령.현재색() == 색상.WHITE, "지형 색이 흰색으로 바뀌었다")
	# 콜리전 레이어는 set_deferred 라 다음 프레임에 반영된다 → 즉시 반영본을 직접 확인
	_확인(유령.밟을_수_있나(), "칠한 뒤에는 밟을 수 있다 (유령 해제)")

	# ── 7. 검정으로 칠하면 흰 빛 안에서 치명적이 되는가 ─────────────────────
	유령.강제_초기화()
	for i in maxi(필요, 1) + 1:
		결과 = 유령.명중(색상.BLACK, 윗면)
		if 결과 == "painted":
			break
	_확인(유령.현재색() == 색상.BLACK, "같은 발판을 검정으로도 칠할 수 있다")
	_확인(유령.반대색인가(색상.WHITE),
		"검정으로 칠하면 흰 빛 안의 몸에게 치명적이다 = 퍼즐이 성립한다")


## 지형의 콜리전 다각형에서 **윗면 한가운데**(플레이어가 서는 자리) 월드 좌표를 구한다.
## 몸이 발판 위에 서 있다고 보고 살짝 위(4px)로 띄운다.
func _윗면_중앙(지형: Node2D, 폴리: CollisionPolygon2D) -> Vector2:
	if 폴리 == null or 폴리.polygon.size() == 0:
		return 지형.global_position
	var 최소 := 폴리.polygon[0]
	var 최대 := 폴리.polygon[0]
	for p in 폴리.polygon:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	var 로컬 := Vector2((최소.x + 최대.x) * 0.5, 최소.y + 4.0)
	return 폴리.global_transform * 로컬


func _끝내기() -> void:
	print("\n════════════════════════════════════════")
	print("  통과 %d · 실패 %d" % [_통과, _실패])
	print("════════════════════════════════════════\n")
	quit(0 if _실패 == 0 else 1)
