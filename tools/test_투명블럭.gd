extends SceneTree
## ============================================================================
## [2026-08-22 신규] 투명블럭 검사
## ----------------------------------------------------------------------------
## 실행: Godot --headless --path . -s res://tools/test_투명블럭.gd
##
## ▣ 무엇을 확인하나 — 기획 문장 그대로 검사한다
##   1. 색을 입히지 않으면 밟거나 부딪칠 수 없다  → 무색이면 collision_layer == 8
##   2. 색을 입히면 단단해진다                    → 칠하면 collision_layer == 1
##   3. 무색은 절대 죽이지 않는다                 → 반대색인가() 가 항상 false
##   4. 물에 지워지면 발판이 도로 사라진다        → 되돌리기() 후 다시 8
##
## ⚠ collision_layer 는 `set_deferred` 로 바뀐다(물리 질의 중 변경 오류 방지).
##   그래서 검사할 때마다 프레임을 한 번 돌려서 반영을 기다려야 한다.
## ============================================================================

const 씬경로 := "res://scenes/집/스마트월드_장애물/투명블럭.tscn"

var 통과 := 0
var 실패 := 0


func _확인(조건: bool, 이름: String) -> void:
	if 조건:
		통과 += 1
		print("PASS  ", 이름)
	else:
		실패 += 1
		print("FAIL  ", 이름)


func _init() -> void:
	var 씬: PackedScene = load(씬경로)
	if 씬 == null:
		print("FAIL  씬을 못 읽었다: ", 씬경로)
		quit(1)
		return

	var 뿌리 := Node2D.new()
	root.add_child(뿌리)
	var 블럭 := 씬.instantiate()
	뿌리.add_child(블럭)

	await process_frame
	await physics_frame

	# ── 1) 처음엔 무색 = 유령 ────────────────────────────────────────────
	_확인(블럭.현재색() == -1, "처음엔 무색이다")
	_확인(블럭.collision_layer == 8, "무색이면 유령 레이어(8) — 밟을 수 없다")
	_확인(not 블럭.반대색인가(ColorDefs.BLACK), "안 칠한 블럭(검은 아트)은 검정 플레이어에게 안전하다")
	# ★[2026-08-30 규칙 변경] 안 칠한 것은 무색이 아니라 **검정**이다 — 화면이 검정이니까.
	#   (성진님: "플레이어와 지형의 색이 다르면 죽어")
	#   ⚠ 이 블럭은 무색일 때 유령 레이어(8)라 죽음 질의에 안 잡힌다. 그래서 규칙이 바뀌어도
	#     실제 플레이에서 갑자기 죽지는 않는다 — 위 49 줄이 그것을 같이 지키고 있다.
	_확인(블럭.반대색인가(ColorDefs.WHITE), "안 칠한 블럭(검은 아트)은 흰색 플레이어에게 위험하다")

	# ── 2) 필요횟수만큼 맞히면 단단해진다 ────────────────────────────────
	var 필요: int = 블럭.get("필요횟수")
	var 결과 := ""
	for i in 필요:
		결과 = 블럭.명중(ColorDefs.WHITE, Vector2.ZERO)
	_확인(결과 == "painted", "필요횟수(%d)를 채우면 painted 를 돌려준다" % 필요)
	await process_frame
	_확인(블럭.collision_layer == 1, "칠하면 단단한 지형 레이어(1) — 밟을 수 있다")
	_확인(블럭.현재색() == ColorDefs.WHITE, "흰색으로 칠해졌다")

	# ── 3) 칠해진 뒤에는 반대색 플레이어를 죽인다 ────────────────────────
	_확인(블럭.반대색인가(ColorDefs.BLACK), "흰 블럭은 검정 플레이어에게 반대색이다")
	_확인(not 블럭.반대색인가(ColorDefs.WHITE), "흰 블럭은 흰색 플레이어에게 안전하다")

	# ── 4) 물에 지워지면 발판이 사라진다 ─────────────────────────────────
	# 유체.gd 는 `물에_안지워짐()` 이 없으면 되돌리기() 를 부른다.
	_확인(not 블럭.has_method("물에_안지워짐"), "물에 안 지워지는 예외가 아니다(통과플랫폼과 반대)")
	_확인(블럭.되돌리기(), "되돌리기가 먹는다")
	await process_frame
	_확인(블럭.collision_layer == 8, "지워지면 다시 유령 — 발판이 사라진다")

	# ── 5) 반대색을 덮으면 회색이 되고 되돌릴 수 없다 ────────────────────
	for i in 필요:
		블럭.명중(ColorDefs.BLACK, Vector2.ZERO)
	_확인(블럭.명중(ColorDefs.WHITE, Vector2.ZERO) == "mixed_gray", "반대색을 덮으면 회색이 된다")
	_확인(not 블럭.되돌리기(), "회색은 되돌릴 수 없다(규칙 3)")
	await process_frame
	_확인(블럭.collision_layer == 1, "회색도 단단하다 — 밟을 수 있다")
	_확인(not 블럭.반대색인가(ColorDefs.BLACK), "회색은 누구도 안 죽인다")

	# ── 6) 강제 초기화는 회색도 푼다 ─────────────────────────────────────
	블럭.강제_초기화()
	await process_frame
	_확인(블럭.현재색() == -1, "강제_초기화는 회색도 무색으로 되돌린다")
	_확인(블럭.collision_layer == 8, "강제_초기화 뒤 다시 유령")

	print("---")
	print("결과: %d / %d 통과" % [통과, 통과 + 실패])
	quit(0 if 실패 == 0 else 1)
