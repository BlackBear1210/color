extends SceneTree
## ============================================================================
## [2026-08-27 신규] 창문 오브젝트 3 종을 **작업자가 끌어다 쓰는 씬**으로 굽는다
## ----------------------------------------------------------------------------
## 실행:  godot --headless --path . -s res://tools/build_창문_오브젝트.gd
## 결과:  scenes/집/스마트월드_장애물/창문_커튼.tscn
##        scenes/집/스마트월드_장애물/창문_구멍커튼.tscn
##        scenes/집/스마트월드_장애물/창문_배경.tscn
##
## ▣ 왜 (도형님 요청)
##   *"이런 장애물 오브젝트들도 모아서 scenes/집/스마트월드_장애물 여기에 넣어줘."*
##   `창문커튼.gd` 는 2026-08-18 부터 있었지만 **씬으로 포장된 적이 없어서**
##   작업자가 쓰려면 노드를 만들고 스크립트를 붙이고 export 를 하나하나 맞춰야 했다.
##   → 세 가지 대표 설정을 씬으로 구워 둔다. 끌어다 놓고 위치만 잡으면 끝이다.
##
## ▣ 세 가지가 왜 필요한가 — **레벨 문법이 서로 다르다**
##
##   ① 창문_커튼 (기본 · 발판)
##      쏜 쪽 커튼이 그 색으로 쳐지고, 커튼 사이로 새는 빛이 **굳어 발판**이 된다.
##      한쪽씩 닫히므로 **어디를 쏠지 겨냥**해야 한다. "길을 만드는" 창.
##
##   ② 창문_구멍커튼 (경계)
##      커튼을 다 쳐도 구멍으로 빛이 샌다. 그 빛은 **경계**라 지나가면 색을 빼앗긴다.
##      게다가 `구멍빛_각도_자동` 을 끄면 **작업자가 새는 방향을 정한다**.
##      "해결해도 대가가 남는" 창 — 다리를 놓을지 돌아갈지 저울질하게 만든다.
##
##   ③ 창문_배경 (연출 · 원근)
##      멀리 있는 창. 창 자체는 작고 흐리지만 **빛줄기는 방을 가로지른다.**
##      판정이 없어서(연출) 길을 막지 않는다. 공간을 넓어 보이게 하는 장치다.
##
## ▣ 기본값을 고른 근거
##   빛 길이·끝폭은 `tools/측정_플레이어_능력.gd` 실측을 기준으로 잡았다.
##   발판이 되는 빛(①)의 끝폭 460 은 **건널 한계 204px 의 두 배 이상**이라
##   빛 위에서 좌우로 움직일 여유가 있다. 그보다 좁으면 착지 자체가 도박이 된다.
## ============================================================================

const 창문_S := preload("res://scripts/스마트월드/창문커튼.gd")
const 폴더 := "res://scenes/집/스마트월드_장애물/"


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== 창문 오브젝트 씬 굽기 ===")
	var 실패 := 0

	# ── ① 창문_커튼 — **위에서 아래로** 내려오는 빛 (도형님이 요청한 바로 그것) ──
	#   *"위에서 아래로 빛이 내려오는 창문도 만들어서, 플레이어가 흰색이나 검은색으로
	#     칠했을 때 창문 양 옆에 커튼이 달려 있어서 칠해진 방향에 맞춰 커튼이 쳐지고,
	#     쳐진 커튼 사이로는 빛이 조금 새어 나오는데 그 빛은 플레이어가 칠한 색으로 나온다."*
	#
	#   · 각도 90°(아래)  → `빛_각도_자동` 이 **경계 모드일 때 세로**를 골라 준다.
	#   · 모드 = 경계     → 지나가면 색을 빼앗기지만 **죽지는 않는다**. 길을 막지도 않는다.
	#   · 커튼을 치면 `빛.색_지정(_커튼색)` 이 돌아 **샌 빛이 칠한 색**이 된다.
	실패 += 0 if _굽기("창문_커튼", {
		"크기": Vector2(260, 360),
		"빛_모드": 1,              # 경계 — 색을 강제한다(죽이지 않는다)
		"빛_각도_자동": true,      # 경계·연출은 자동으로 세로(90°) = 위에서 아래로
		"빛_길이": 720.0,
		"빛_끝폭": 520.0,          # 아래로 갈수록 넓게 = 원근
		"빛_기본세기": 0.5,
		"빛_물든세기": 0.85,
		"색섞임_회색": false,       # 길을 막는 창은 회색으로 굳으면 영구 소프트락이 된다
		"구멍_있음": false,
	}) else 1

	# ── ② 창문_빛다리 — 가로로 뻗어 **굳는** 빛. 커튼을 치면 다리가 놓인다 ──
	#   ⚠ 발판은 반드시 **가로**여야 한다. 세로로 세우면 사다리꼴의 넓은 쪽이 아래로 가서
	#     딛고 설 윗면이 아예 안 생긴다(창문커튼.gd §머리말).
	실패 += 0 if _굽기("창문_빛다리", {
		"크기": Vector2(260, 360),
		"빛_모드": 2,              # 발판 — 굳어서 딛고 설 수 있다
		"빛_각도_자동": true,      # 발판이므로 가로(0°)
		"빛_길이": 620.0,
		"빛_끝폭": 460.0,          # 건널 한계 204px 의 두 배 이상 — 착지가 도박이 안 되게
		"빛_기본세기": 0.55,
		"빛_물든세기": 0.9,
		"색섞임_회색": false,
		"구멍_있음": false,
	}) else 1

	# ── ③ 구멍 난 커튼 — 다 쳐도 구멍으로 새고, 그 빛은 **경계** ──
	실패 += 0 if _굽기("창문_구멍커튼", {
		"크기": Vector2(260, 360),
		"빛_모드": 2,
		"빛_각도_자동": true,
		"빛_길이": 620.0,
		"빛_끝폭": 460.0,
		"색섞임_회색": false,
		"구멍_있음": true,
		"구멍_위치": 0.34,
		"구멍_크기": 62.0,
		"구멍빛_길이": 520.0,
		# ★작업자가 방향을 정할 수 있게 **수동**으로 두고 기본은 아래(90°).
		#   인스펙터에서 각도만 돌리면 경계가 흘러가는 방향이 바뀐다.
		"구멍빛_각도_자동": false,
		"구멍빛_각도": 90.0,
	}) else 1

	# ── ④ 배경 창문 — 멀리 있는 창 + 원근이 사는 빛 (판정 없음) ──
	실패 += 0 if _굽기("창문_배경", {
		"크기": Vector2(300, 420),
		"빛_모드": 0,              # 연출 — 길을 막지도, 색을 빼앗지도 않는다
		"빛_각도_자동": true,      # 연출은 세로(90°)
		"빛_길이": 900.0,          # 멀리서 오는 빛이라 길게 뻗는다
		"빛_끝폭": 720.0,          # 가까이 올수록 크게 퍼진다 = 원근
		"빛_기본세기": 0.5,
		"배경_깊이": 0.75,          # 창은 45%+ 로 작아지고 흐려지며 지형 뒤로 물러난다
		"시작색": -1,
	}) else 1

	print("=== 끝 (실패 %d) ===\n" % 실패)
	quit(0 if 실패 == 0 else 1)


## 창문 노드 하나를 만들어 씬으로 저장한다.
## ⚠ 트리에 넣지 않는다 — 넣으면 `_ready()` 가 자식 `빛`·`구멍빛` 을 만들고,
##   그 자식들이 씬 파일에 같이 저장되어 다음 로드 때 **두 벌**이 된다(§owner 지뢰).
##   자식은 런타임에 `_재구성()` 이 알아서 만든다.
func _굽기(이름: String, 값들: Dictionary) -> bool:
	var n := Area2D.new()
	n.name = 이름
	n.set_script(창문_S)
	for k in 값들:
		n.set(k, 값들[k])

	var 팩 := PackedScene.new()
	var e := 팩.pack(n)
	if e != OK:
		push_error("pack 실패 %s: %s" % [이름, error_string(e)])
		return false
	var 경로 := 폴더 + 이름 + ".tscn"
	e = ResourceSaver.save(팩, 경로)
	print("   %-22s %s" % [이름 + ".tscn", error_string(e)])
	return e == OK
