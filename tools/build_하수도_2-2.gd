func _땅(이름: String, 점들: PackedVector2Array, 색: int, 역할: String = "플랫폼") -> Node2D:
	var n: Node2D = b.지형(지형부모, 이름, 점들, 색, 역할)
	if n != null:
		n.set("시안_명도조율", true)
		n.set("앞지형_깊이", true)
	return n


## 떨어지는 물. ★스크립트를 먼저 바꾼다 — set_script 는 그 전에 넣은 값을 지운다.
func _물(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int, 켜짐: bool = true) -> Node2D:
	var f := (load(공.S_유체) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	f.name = 이름
	f.set_script(load(G_물))
	f.position = Vector2(x, 윗끝)
	f.set("종류", 0)
	f.set("색", 색)
	f.set("크기", Vector2(폭, 높이))
	f.set("켜짐", 켜짐)
	부모.add_child(f)
	return f


## 천장(지형) 속에서 내려오는 짧은 급수관 + 물.
func _물_관(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int) -> Node2D:
	var f := _물(부모, 이름, x, 윗끝, 폭, 높이, 색)
	_관(부모, "관_" + 이름, [[x, 윗끝 - 128], [x, 윗끝]], null, f)
	return f


func _관(부모: Node, 이름: String, 점들: Array, 시작: Node, 끝: Node) -> Node2D:
	var p := Node2D.new()
	p.name = 이름
	p.z_index = -1
	p.set_script(load(G_배관))
	var 경로 := PackedVector2Array()
	for v in 점들:
		경로.append(Vector2(float(v[0]), float(v[1])))
	p.set("점들", 경로)
	부모.add_child(p)
	if 시작 != null:
		p.set("시작_장치", p.get_path_to(시작))
	if 끝 != null:
		p.set("끝_장치", p.get_path_to(끝))
	return p


func _격자(부모: Node, 이름: String, x: float, 윗면: float, 폭: float, 색: int) -> Node2D:
	var g: Node2D = b.통과플랫폼(부모, 이름, x, 윗면, 폭, 1)
	g.set("고정색", 색)
	return g


## 도약대(무색 — 누구나 튕긴다). 원점 = 바닥 가운데.
func _도약대(부모: Node, 이름: String, x: float, 바닥: float, 폭: float) -> Node2D:
	var d := (load(S_도약대) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	d.name = 이름
	d.position = Vector2(x, 바닥)
	d.set("폭", 폭)
	부모.add_child(d)
	return d


## 같은 자리 두 물을 `번갈이_주기` 초마다 바꿔 켠다(scripts/스마트월드/번갈이_물.gd).
func _번갈이(부모: Node, 이름: String, a: Node, bb: Node) -> Node2D:
	var n := Node2D.new()
	n.name = 이름
	n.set_script(load(G_번갈이))
	n.position = (a as Node2D).position
	부모.add_child(n)
	n.set("물_A", n.get_path_to(a))
	n.set("물_B", n.get_path_to(bb))
	n.set("주기", 번갈이_주기)
	return n


