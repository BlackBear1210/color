const 공 := preload("res://tools/하수도_빌더_공통.gd")
const 내씬 := "res://scenes/world_2_클로드/stage_2-2.tscn"
const 다음씬 := "res://scenes/world_2_클로드/stage_2-3.tscn"

const 검 := 공.검정
const 흰 := 공.흰색

const 프레임 := Rect2(0, 0, 4608, 4352)

## 층 바닥 y
const L0 := 3584.0
const L1 := 2944.0
const L2 := 2304.0
const L3 := 1664.0

## 갱도(1856~2560 · 704 폭) 격자 — 왼열 중심 2144([2032,2256]) · 오른열 중심 2448([2336,2560]) · 사이 80
## S01 물 기둥 x 2296([2264,2328]) = 두 열 **사이 틈**. 지그재그가 반드시 기둥을 지나므로 흰 물이면 검정 몸은 못 오른다.
## S12·S23 물 기둥 x 1904([1872,1936]) = 허브 호퍼의 **왼끝**. 틈에 두면 아래층에서 허브로 뛰어오르는 몸의
##   머리가 위층 물에 닿는다(주행검사에서 실제로 죽었다). 왼끝에 두면 허브에 내려앉는 자리(≈2,480)와 멀다.
## ★허브 호퍼(1856~2560)는 갱도 전체 폭. 왼열에서 뛰어오른 몸이 +250 근처에 내려앉고 오른쪽에서 색을 바꾼 뒤,
##   왼쪽 기둥을 자기 색으로 지나 2200 에서 다음 층 첫 격자(오른열)로 뛴다.
const 격자_L := 2144.0
const 격자_R := 2448.0
const 물_x := 2296.0
const 허브물_x := 1904.0
const 갱도_오른 := 2560.0

var b: RefCounted


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 2-2 · 구멍 난 바닥 v2 (수직 갱도 · 허브 · 탑 · 발코니) ===")
	b = 공.new()
	var 루트 := _짓기()
	var ok: bool = b.검산(프레임, _빈공간들())
	b.색비율_보고()
	if not ok or b.오류 > 0:
		push_error("2-2: 검산 실패 %d — 저장하지 않는다" % b.오류)
		quit(1)
		return
	if not b.저장(루트, 내씬):
		quit(1)
		return
	print("=== 끝 ===\n")
	quit(0)


func _빈공간들() -> Array:
	return [
		Rect2(768, 1856, 640, L0 - 1856),          # 흰 탑
		Rect2(1408, 3136, 448, L0 - 3136),         # L0 열림 (탑 ↔ 홀)
		Rect2(1408, 2624, 448, L1 - 2624),         # L1 열림 (탑 ↔ 허브)
		Rect2(1408, 1984, 448, L2 - 1984),         # L2 열림
		Rect2(1856, 1216, 704, L0 - 1216),         # 갱도 (바닥 = 홀)
		Rect2(1664, L0, 128, 3904 - L0),           # L0 슬롯 (색 전환 · 가시)
		Rect2(2560, 3344, 192, L0 - 3344),         # 오른쪽 통로 (발코니 밑)
		Rect2(2752, 2752, 3840 - 2752, L0 - 2752), # 오른쪽 방 (F1 발코니)
		Rect2(2560, 1216, 3840 - 2560, L3 - 1216), # L3 복도
		Rect2(2880, L3, 480, 1792 - L3),           # L3 웅덩이 구덩이
		Rect2(3840, 1360, 544, 1760 - 1360),       # 출구 통로
	]


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("stage_2-2", "2-2 · 구멍 난 바닥",
		프레임, Vector2(2560, L0), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 큰 덩어리 (플레이어가 못 닿는 채움)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "천장띠", 공.사각(0, 0, 4608, 1216), 검, "채움")
	# 왼쪽 위 = 탑 천장 + 갱도 왼벽 윗부분 (한 폴리곤)
	b.지형(지, "좌상_덩어리", 공.다각([
		[0, 1216], [1856, 1216], [1856, 1984], [1408, 1984], [1408, 1856], [0, 1856],
	]), 검, "채움")
	b.지형(지, "좌하_채움", 공.사각(0, L0, 768, 4352), 검, "채움")
	b.지형(지, "슬롯_바닥", 공.사각(1664, 3904, 1792, 4352), 검, "채움")
	# 오른쪽 프레임 — 출구 통로 자리(3840~4384 × 1360~1760)만 판다
	b.지형(지, "우측_프레임", 공.다각([
		[3840, 1216], [4608, 1216], [4608, 4352], [3840, 4352], [3840, 1760], [4384, 1760],
		[4384, 1360], [3840, 1360],
	]), 검, "채움")

	# ══════════════════════════════════════════════════════════════════════
	# 흰 탑 (x 768~1408) — 마른 갱도. 공중 발판 10 장이 좌우로 번갈아 128 씩 오른다
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "탑_왼벽", 공.사각(0, 1856, 768, L0), 흰)
	# 탑 바닥 + l1 턱 + L0 열림의 흰 바닥(~1664) — 한 폴리곤
	b.지형(지, "탑_바닥", 공.다각([
		[768, 3456], [1040, 3456], [1040, L0], [1664, L0], [1664, 4352], [768, 4352],
	]), 흰)
	# l2~l10 : 왼쪽 [768,1040] · 오른쪽 [1136,1408] (벽에 붙은 선반 · 사이 96 · 두께 96 · **일방통행**)
	# 두 칸 위 선반이 도약 자리 위에 걸치므로 일방통행이 아니면 머리가 박힌다.
	var 탑발판 := [
		["탑_l2", 1136, 3328], ["탑_l3", 768, 3200], ["탑_l4", 1136, 3072], ["탑_l5", 768, 2944],
		["탑_l6", 1136, 2816], ["탑_l7", 768, 2688], ["탑_l8", 1136, 2560], ["탑_l9", 768, 2432],
		["탑_l10", 1136, L2],
	]
	for t in 탑발판:
		var x0: float = float(t[1])
		b.공중발판(지, String(t[0]), 공.사각(x0, float(t[2]), x0 + 272.0, float(t[2]) + 96.0), 흰)
	b.지형(지, "L2_흰바닥", 공.사각(1408, L2, 1856, 2624), 흰)
	b.지형(지, "L1_흰바닥", 공.사각(1408, L1, 1856, 3136), 흰)

	# ══════════════════════════════════════════════════════════════════════
	# 홀 + 오른쪽
	# ══════════════════════════════════════════════════════════════════════
	# 홀 바닥 + r1 턱(발코니 사다리 첫 칸) — 한 폴리곤
	b.지형(지, "홀_바닥", 공.다각([
		[1792, L0], [3328, L0], [3328, 3456], [3520, 3456], [3520, L0], [3840, L0],
		[3840, 4352], [1792, 4352],
	]), 검)
	# 갱도 오른벽 + 오른쪽 방 천장 + L3 복도 바닥(웅덩이 구덩이 포함) — 한 폴리곤
	b.지형(지, "우측_덩어리", 공.다각([
		[2560, L3], [2880, L3], [2880, 1792], [3360, 1792], [3360, L3], [3840, L3],
		[3840, 2752], [2752, 2752], [2752, 3344], [2560, 3344],
	]), 검)
	# F1 발코니 = 갱도 오른벽에 매달린 선반(2752~3264). 사다리 r1(턱)·r2·r3 는 발코니 **오른쪽**에 둔다 —
	# 발코니 밑에서 위로 뛰면 머리(−96)+점프(160)가 발코니 밑면에 박힌다(주행검사에서 실제로 났다).
	# 레버는 발코니 왼끝(2816)이라 물 기둥(2160)이 656px 앞, 같은 화면에서 멈추는 게 보인다.
	# r2·r3 는 격자(일방통행) — r3 가 r1 턱 바로 위(112)에 걸쳐서, 단단한 발판이면 r1 에서 뛸 때 머리가 박힌다.
	b.지형(지, "F1_발코니", 공.사각(2752, 3072, 3264, 3216), 검)

	# L3 복도 끝 — 유령 발판(흰 웅덩이가 페인트를 지운다) vs 격자(안 지워진다)
	b.유령(지, "L3_유령발판", 공.사각(2976, L3, 3072, 1760), 검, 1)

	# ══════════════════════════════════════════════════════════════════════
	# 장치
	# ══════════════════════════════════════════════════════════════════════
	# 갱도 격자 — 층마다 4 장 (R·L·R·L) + 허브 호퍼가 5 번째 칸. L3 만 호퍼 대신 격자 p15 로 바닥과 이가 맞는다.
	# ★허브 높이의 5 번째 칸을 격자가 아니라 호퍼(1856~2400)로 넓힌 이유: 물 기둥(2128~2192) 오른쪽에
	#   검정 몸이 서서 색을 바꿀 자리가 160px 필요하다. 격자 p5 를 두면 그 자리가 12px 뿐이라
	#   주행검사에서 흰 물에 닿아 죽었다.
	# ★열 순서가 층마다 다르다(S01 R부터 · S12 L부터 · S23 R부터). 허브에 내려앉는 점프의 정점(도약 +195)에서
	#   머리(−96)가 딱 **다음 층 첫 격자 높이**에 닿는다. 첫 격자가 그 정점 위에 있으면 흰 몸이 검정 격자에
	#   닿아 죽는다(주행검사에서 실제로 났다) → 첫 격자는 늘 정점 **반대편** 열에 둔다.
	var 격자표 := [
		["S01_p1", 격자_R, 3456], ["S01_p2", 격자_L, 3328], ["S01_p3", 격자_R, 3200], ["S01_p4", 격자_L, 3072],
		["S12_p6", 격자_L, 2816], ["S12_p7", 격자_R, 2688], ["S12_p8", 격자_L, 2560], ["S12_p9", 격자_R, 2432],
		["S23_p11", 격자_R, 2176], ["S23_p12", 격자_L, 2048], ["S23_p13", 격자_R, 1920], ["S23_p14", 격자_L, 1792], ["S23_p15", 격자_R, L3],
	]
	for g in 격자표:
		b.통과플랫폼(장, String(g[0]), float(g[1]), float(g[2]), 224.0, 1)
	b.통과플랫폼(장, "L3_격자", 3200.0, L3, 128.0, 1)
	b.통과플랫폼(장, "우_r2_격자", 3712.0, 3328.0, 192.0, 1)
	b.통과플랫폼(장, "우_r3_격자", 3424.0, 3200.0, 192.0, 1)

	# 허브 호퍼 — 갱도 왼벽(1856)에서 2400 까지(544). 왼쪽 격자(p4·p9)에서 뛰면 +250 근처(≈2,330)에 내려앉는다.
	# 높이 32 라 밑 격자에 선 몸의 머리를 안 건드리고, 밟는 면은 일방통행이라 밑에서 뛰어올라도 통과한다.
	b.호퍼(장, "호퍼_L1", (1856.0 + 갱도_오른) * 0.5, L1, 갱도_오른 - 1856.0, 32)
	b.호퍼(장, "호퍼_L2", (1856.0 + 갱도_오른) * 0.5, L2, 갱도_오른 - 1856.0, 32)

	# 물 — 층마다 따로. 배관은 허브 바로 밑에서 갱도 가운데로.
	# S01 의 윗끝은 3104 — p4(3072)에 선 몸은 물 위에 있고, p3(3200)→p4 로 건너는 몸은 물 안이다.
	#   (3008 로 올렸더니 p4 에서 허브로 뛰는 몸의 발이 물에 잠겨 죽었다)
	b.배관(장, "관_S01", 공.다각([[2816, 3072], [2816, 3104], [물_x, 3104]]))
	var s01: Node2D = b.유체(장, "S01_흰물", 물_x, 3104, 64, L0 - 3104, 공.물_흰, true)
	b.배관(장, "관_S12", 공.다각([[1600, 2368], [허브물_x, 2368]]))
	b.유체(장, "S12_흰물", 허브물_x, 2368, 64, L1 - 2368, 공.물_흰)
	b.배관(장, "관_S23", 공.다각([[1600, 1728], [허브물_x, 1728]]))
	b.유체(장, "S23_검정물", 허브물_x, 1728, 64, L2 - 1728, 공.물_검)
	# 원형 밸브 — S01 을 잠근다. 발코니 왼끝.
	b.레버(장, "레버_수문", Vector2(2816, 3072), 0, s01)

	# L3 웅덩이 — 흰 물이 발판 밑동을 스친다(페인트_지움). 검정 몸에겐 죽는 물.
	b.웅덩이(장, "L3_흰웅덩이", 3120, 1792, 480, 112, 공.물_흰, true)

	# ── 위험물 ──
	b.가시(위, "가시_슬롯L0", 1728, 3904, 4)

	# ── 체크포인트 ──
	b.체크포인트(체, "CP_시작", Vector2(2600, L0))
	b.체크포인트(체, "CP_발코니", Vector2(3100, 3072))       # F1 ⓐ
	b.체크포인트(체, "CP_허브L1", Vector2(2450, L1))
	b.체크포인트(체, "CP_허브L2", Vector2(2450, L2))
	b.체크포인트(체, "CP_탑L1", Vector2(1632, L1))
	b.체크포인트(체, "CP_탑L2", Vector2(1632, L2))
	b.체크포인트(체, "CP_L3", Vector2(2640, L3))

	b.출구(루트, Vector2(3840, L3), 다음씬)
	b.끝점(루트, Vector2(3856, L3))
	b.플레이어(루트, Vector2(2560, L0))
	return 루트
