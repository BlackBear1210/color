# ★[2026-10-03] 흑백 벽돌 맞물림 — 흰 웅덩이 바닥 (도형님: "벽돌 사이즈를 기준으로 서로 맞물리게 · 불규칙성")
# ----------------------------------------------------------------------------
# 줄눈 표 = `하수도_빌더_공통.gd` 의 줄눈_ROWS / 줄눈_JOINTS (masonry_v02 fill.png 실측 · Codex 2-2 맞물림과 같은 값).
#   월드 줄 y = 원점y(1792.1) + (타일×1024 + ROWS[i]) × 0.18 · 이음새 x = (타일×1536 + JOINTS[i][j]) × 0.18
#   (재질 `땅_2-3_*` 이 월드 기준 UV · offset (0,1792.1) 이라 이 식이 그림의 줄눈과 같다)
# ★홀수 줄(첫 이음새 < 60px)은 타일 끝(0/1536)이 이음새가 **아니다** — 벽돌이 타일 경계를 넘어 이어진다
#   (예: 1 줄 1440→1536 96px + 0→43 43px = 한 장 139px). 그래서 그 줄에서는 0/1536 을 고르지 않는다.
# 줄별 목표 (왼, 오른) 을 가장 가까운 이음새에 붙인다. 목표는 손으로 고른 불규칙 값 — 같은 깊이가 반복되지 않게,
#   아래로 갈수록 좁아지되 오른쪽이 한 번 더 튀어나오고 맨 아래에 반 장짜리 이빨이 하나 달린다.
#   첫 줄은 홈 테두리 안쪽 이음새(3622.68 · 3870.72)에서 시작한다 — 바깥으로 나가면 흰 벽돌이 검정 윗면 바로 밑(6px)에 깔려
#   흰 바닥처럼 보인다. 밖으로 퍼지는 것은 둘째 줄(검정 한 줄 아래)부터.
# 미리보기(엔진 없이 fill.png 를 같은 식으로 깐 그림): docs/도안/2-2_맞물림_시안.png
# ============================================================================
const 맞물림_목표 := [
	[3622, 3871], [3602, 3915], [3553, 3896], [3601, 3949], [3594, 3870],
	[3637, 3913], [3620, 3830], [3672, 3777], [3723, 3794],
]
## 맞물림 둘레(검정) 사각형 — 아래_덩어리 가 파 낸 자리와 같아야 한다.
const 맞물림_틀 := Rect2(3520, 864, 512, 224)
## 홈 테두리 (웅덩이 윗변 · 바닥)
const 홈_왼 := 3616.0
const 홈_오른 := 3872.0
const 홈_바닥 := 896.0
const 홈_경사 := 32.0


func _줄_목록(lo: float, hi: float) -> Array:
	var out := []
	for t in range(-20, 30):
		for i in 9:
			var y0: float = b.줄눈_원점y + (t * 1024 + 공.줄눈_ROWS[i]) * 공.줄눈_배율
			var y1: float = b.줄눈_원점y + (t * 1024 + 공.줄눈_ROWS[i + 1]) * 공.줄눈_배율
			if y1 > lo and y0 < hi:
				out.append([y0, y1, i])
	out.sort_custom(func(a, c): return a[0] < c[0])
	return out


func _이음새(줄: int, x: float) -> float:
	var 표: Array = 공.줄눈_JOINTS[줄]
	var 타일끝_이음새: bool = int(표[1]) >= 60
	var 폭: float = 1536.0 * 공.줄눈_배율
	var 최고 := x
	var 최소 := 1e20
	for t in range(int(floor(x / 폭)) - 1, int(floor(x / 폭)) + 2):
		for j in 표:
			if not 타일끝_이음새 and (int(j) == 0 or int(j) == 1536):
				continue
			var jx: float = (t * 1536 + int(j)) * 공.줄눈_배율
			if absf(jx - x) < 최소:
				최소 = absf(jx - x)
				최고 = jx
	return 최고


## 흰 바닥 외곽(시계 방향): 홈 윗선(대각 · 바닥 · 대각) → 오른쪽 계단 아래로 → 맨 아랫줄 → 왼쪽 계단 위로.
func _맞물림_흰바닥() -> PackedVector2Array:
	# 지표(864) 바로 밑 줄은 홈 테두리 사이(864~870)라 건너뛰고, 그 다음 줄부터 목표 수만큼
	var 줄들 := _줄_목록(864.0 + 1.0, 1200.0)
	if 줄들[0][0] < 864.0 + 1.0:
		줄들.pop_front()
	var 칸 := []
	for k in 맞물림_목표.size():
		var r: Array = 줄들[k]
		칸.append([r[0], r[1], _이음새(r[2], 맞물림_목표[k][0]), _이음새(r[2], 맞물림_목표[k][1])])
	# 첫 줄 양끝은 홈 대각선 위의 점(대각선이 그 줄 이음새를 지나는 높이)
	var 왼0: float = 칸[0][2]
	var 오른0: float = 칸[0][3]
	var 왼위 := Vector2(왼0, 864.0 + (왼0 - 홈_왼) * (홈_경사 / 홈_경사))
	var 오른위 := Vector2(오른0, 864.0 + (홈_오른 - 오른0) * (홈_경사 / 홈_경사))
	var 점 := PackedVector2Array([왼위, Vector2(홈_왼 + 홈_경사, 홈_바닥), Vector2(홈_오른 - 홈_경사, 홈_바닥), 오른위])
	점.append(Vector2(오른0, 칸[0][1]))
	for k in range(1, 칸.size()):
		점.append(Vector2(칸[k][3], 칸[k][0]))
		점.append(Vector2(칸[k][3], 칸[k][1]))
	for k in range(칸.size() - 1, 0, -1):
		점.append(Vector2(칸[k][2], 칸[k][1]))
		점.append(Vector2(칸[k][2], 칸[k][0]))
	점.append(Vector2(왼0, 칸[0][1]))
	return _정리(점)


## 둘레(검정) = 틀 − (흰 바닥 ∪ 홈 위 빈 곳). 홈이 틀 윗변에 닿아 있어 결과는 U 자 다각형 하나다.
func _맞물림_둘레(흰바닥: PackedVector2Array) -> PackedVector2Array:
	var 홈 := PackedVector2Array([Vector2(홈_왼, 864), Vector2(홈_오른, 864), Vector2(홈_오른 - 홈_경사, 홈_바닥), Vector2(홈_왼 + 홈_경사, 홈_바닥)])
	var 합 := Geometry2D.merge_polygons(흰바닥, 홈)
	if 합.size() != 1:
		push_error("2-2 맞물림: 흰 바닥 + 홈 합집합이 %d 조각" % 합.size()); b.오류 += 1
		return PackedVector2Array()
	var 틀 := 공.사각(맞물림_틀.position.x, 맞물림_틀.position.y, 맞물림_틀.end.x, 맞물림_틀.end.y)
	var 결과 := Geometry2D.clip_polygons(틀, 합[0])
	if 결과.size() != 1:
		push_error("2-2 맞물림: 둘레가 %d 조각(구멍이 생겼다)" % 결과.size()); b.오류 += 1
		return PackedVector2Array()
	return _정리(결과[0])


## 0.01 로 반올림 · 연속 중복 제거 · 검산 기준 시계 방향(신발끈 합 양수)으로.
func _정리(점: PackedVector2Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for p in 점:
		var q := Vector2(snappedf(p.x, 0.01), snappedf(p.y, 0.01))
		if out.is_empty() or out[out.size() - 1].distance_to(q) > 0.05:
			out.append(q)
	if out.size() > 1 and out[0].distance_to(out[out.size() - 1]) <= 0.05:
		out.remove_at(out.size() - 1)
	# 합집합·차집합이 겹친 변에 남기는 0 면적 가시를 지운다 — 세 점이 한 직선 위이고 가운데 점에서 되돌아가면 뺀다.
	#   (처음 굽기에서 둘레가 홈 대각선을 따라 (3616,864)→(3648,896)→(3622.68,870.68) 로 갔다 돌아와 겹침 2 칸이 났다)
	var 바뀜 := true
	while 바뀜 and out.size() > 3:
		바뀜 = false
		for i in out.size():
			var a := out[(i - 1 + out.size()) % out.size()]
			var m := out[i]
			var c := out[(i + 1) % out.size()]
			var u := m - a
			var v := c - m
			if absf(u.cross(v)) < 0.5 * maxf(u.length(), 0.001) and u.dot(v) <= 0.0:
				out.remove_at(i)
				바뀜 = true
				break
	var 합 := 0.0
	for i in out.size():
		var a := out[i]
		var c := out[(i + 1) % out.size()]
		합 += a.x * c.y - c.x * a.y
	if 합 < 0.0:
		out.reverse()
	return out

