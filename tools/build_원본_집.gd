	#
	#   ▣ 점프 거리는 최대치에 맞추지 않는다 (도형님 지시 그대로)
	#     세로는 96~120px 사이에서 흔들고(한계 128), 가로는 0~150px(한계 204).
	#     매번 최대로 뛰게 하면 **모든 점프가 시험**이 되어 피곤하다.
	#     여유가 있어야 "쉬운 칸 / 어려운 칸" 의 리듬이 생긴다.
	var rng := RandomNumberGenerator.new()
	rng.seed = 20260820                      # 고정 씨앗 — 다시 구워도 같은 맵이 나온다
	var 묶음 := [3, 2, 4, 2, 3, 3, 2, 4, 3, 2]   # 좌 3칸 → 우 2칸 → 좌 4칸 … 불규칙
	var 색순환 := [발판색_.검정, 발판색_.흰색, 발판색_.검정, 발판색_.무색, 발판색_.흰색]
	# ⚠[2026-08-20] 길이 420 + 어긋 60~150 으로 깔았더니 **같은 쪽 연속 선반이
	#   아래 선반의 머리를 덮어** 사다리가 끊겼다(도달 36 중 5).
	#   같은 쪽을 연속으로 오르려면 **어긋남 > 선반 길이** 여야 겹치지 않는다.
	#   → 길이 220 · 칸 간격 240 (가로 20px 만 건너면 된다).
	var 선반길이 := 220.0
	var 칸간격 := 240.0
	var 윗면 := 580.0
	var n := 0
	var 꼭대기_한계 := -3900.0               # 벽 top(−3700) 보다 위로는 안 올린다
	# ★[2026-08-20] x 를 **이어받으며** 오른다.
	#   ⚠ 묶음마다 벽 끝(안좌/안우)에서 새로 시작했더니, 오른쪽 묶음이 안쪽으로 들어온 뒤
	#     다음 왼쪽 묶음이 다시 벽 끝으로 되돌아가 **가로 260px** 이 벌어졌다(한계 204).
	#     사다리가 거기서 끊겼다(도달 35 중 8).
	#   → 지금 서 있는 x 에서 한 칸(240px)씩 옮긴다. 벽에 닿으면 방향만 뒤집는다.
	#     가로 건너기는 **항상 240 − 220 = 20px** 로 일정하고 절대 안 끊긴다.
	var 왼끝 := 안좌
	var 오른끝 := 안우 - 선반길이
	var 현재x := 왼끝
	var 이동 := 1.0                          # +1 = 오른쪽으로 옮겨 간다
	for 칸수 in 묶음:
		if 윗면 <= 꼭대기_한계:
			break
		for k in int(칸수):
			if 윗면 <= 꼭대기_한계:
				break
			_선반색(루트, "굴뚝선반_%02d" % (n + 1), 현재x, 윗면, 선반길이,
				색순환[n % 색순환.size()], 1.0, "거친암반")
			윗면 -= rng.randf_range(96.0, 120.0)
			n += 1
			# 다음 칸 자리로 옮긴다. 벽에 부딪히면 방향을 뒤집는다.
			var 다음 := 현재x + 이동 * 칸간격
			if 다음 > 오른끝 or 다음 < 왼끝:
				이동 = -이동
				다음 = clampf(현재x + 이동 * 칸간격, 왼끝, 오른끝)
			현재x = 다음
		# 묶음이 끝나면 방향을 한 번 더 뒤집는다 → "좌 3번, 우 2번" 의 불규칙한 리듬이 나온다
		이동 = -이동

	# ── ★벽 구멍 + 경계 빛 ── 도형님 지시 ②
	#   `stage_1-1, 1-2.tscn` 의 굴뚝처럼 **한쪽 벽이 뚫린** 모양을 낸다.
	#   구멍은 사다리를 오르는 내내 **일정 간격으로** 나오고 흰·검정이 번갈아서,
	#   건너갈 때마다 "지금 무슨 색으로 도착하는가" 를 다시 계산하게 만든다.
	var 구멍수 := 7
	for i in 구멍수:
		var t := float(i + 1) / float(구멍수 + 1)
		var y := lerpf(480.0, -3600.0, t)
		var 왼쪽구멍 := i % 2 == 0
		var 빛: Node2D = 빛기둥_S.new()
		빛.name = "굴뚝벽구멍_%d" % (i + 1)
		빛.position = Vector2(안좌 if 왼쪽구멍 else 안우, y)
		빛.set("모드", 1)                                   # 경계 — 색을 빼앗는다
		빛.set("색", ColorDefs.WHITE if i % 2 == 0 else ColorDefs.BLACK)
		빛.set("각도", 0.0 if 왼쪽구멍 else 180.0)
		빛.set("길이", 940.0)                                # 반대쪽 벽까지 가로지른다
		빛.set("시작폭", 100.0)
		빛.set("끝폭", 240.0)
		빛.set("세기", 0.9)
		빛.set("먼지", 24)
		빛.set("물듦_반경", 150.0)
		루트.get_node("오브젝트").add_child(빛)

	# ── ★마무리 선반 ── 사다리 마지막 칸이 어디서 끝날지는 불규칙이라 알 수 없다.
	#   그대로 두면 마지막 선반이 왼쪽 끝(x 20)일 때 지붕(x 960)까지 720px 이 벌어져
	#   출구에 못 간다. → **항상 오른쪽 끝에 마무리 칸을 하나 놓아** 지붕과 이어 준다.
	_선반색(루트, "굴뚝선반_마무리", 오른끝, 윗면, 선반길이,
		발판색_.무색, 1.0, "거친암반")          # 무색 = 무슨 색이든 딛고 나갈 수 있다
	윗면 -= 110.0

	# ── 굴뚝 위 지붕(출구 쪽 바닥) ──
	#   ⚠ 벽 top 은 이 바닥보다 **아래**여야 한다(지뢰밭 §5-1 — 세 번 틀린 자리).
	var 꼭대기 := 윗면
	_지형(루트, "굴뚝위지붕", Vector2.ZERO,
		공통.평바닥_점들(안우, 3600, 꼭대기, 꼭대기 + 340.0, 2.0), "거친암반")

	# ── ★굴뚝 꼭대기에서 떨어지는 빛 ── [2026-08-19] 도형님 지적 그대로 수정
	#   "굴뚝 위에서 떨어지는 빛은 구름/안개에 가려져 **은은하게** 들어와야 하는데
	#    지금 너무 **가까이 전등**에서 빛이 나오는 느낌."
	#   원인: 세기 0.9 + 좁고 밝은 광원 입구(구멍 원반) → 바로 위에 전구가 있는 그림.
	#   고침: `부드러운연출`(위는 거의 안 보이고 아래로 스며드는 세로 그라데이션)
	#         + `구멍_그리기=false`(밝은 원반 제거) + 세기 낮춤 + 아래로 갈수록 넓게 퍼지게.
	#   모드는 그대로 연출(0) — 등반 중에 색을 뺏으면 억울하므로 경계로 만들지 않는다.
	var 꼭 : Node2D = 빛기둥_S.new()
	꼭.name = "굴뚝꼭대기_빛"
	꼭.position = Vector2(490, 꼭대기 - 240.0)
	꼭.set("모드", 0)                                        # 연출 — 등반 중 색을 뺏으면 억울하다
	꼭.set("각도", 92.0)
	꼭.set("길이", 2400.0)                                   # 더 멀리서 내려오는 인상
	꼭.set("시작폭", 300.0)
	꼭.set("끝폭", 940.0)                                    # 아래로 넓게 퍼져 은은히 고인다
	꼭.set("세기", 0.6)                                      # 0.9 → 0.6 (전등 밝기 제거)
	꼭.set("먼지", 72)                                       # 안개 속 티끌을 늘려 "부피"를 준다
	꼭.set("부드러운연출", true)                             # ★핵심 — 구름 통과한 은은한 빛
	꼭.set("구멍_그리기", false)                             # ★밝은 광원 원반 제거
	루트.get_node("오브젝트").add_child(꼭)

	_플레이어(루트, Vector2(-700, 650))
	_저장(루트, "원본_집_굴뚝.tscn")

func _지붕() -> void:
	print("\n── 원본_집_지붕")
	var 리밋 := Rect2(-1600, -1800, 9500, 4200)
	var 루트 := _뼈대("원본_집_지붕", 리밋, Vector2(-300, 640), 2400.0,
		실내배경_S.방_.하수도, 실내배경_S.방_.지붕, 1300.0, 600.0)

	_지형(루트, "다락바닥", Vector2.ZERO, 공통.평바닥_점들(-800, 5000, 700, 1250, 2.5), "거친암반")
	_지형(루트, "다락왼벽", Vector2(-900, 100), 공통.벽_점들(200, 1600), "거친암반")
	_지형(루트, "지붕면_앞", Vector2.ZERO, 공통.천장_점들(-800, 2600, -250, -820, 30.0), "거친암반")
	_지형(루트, "지붕면_뒤", Vector2.ZERO, 공통.천장_점들(2600, 5200, -620, -1180, 30.0, 72.0, 1.7), "거친암반")

	# ── ★지붕 구멍 빛 ── 흰 → 검정 → 흰 → 검정. 색이 계속 뒤집힌다.
	var 구멍들 := [
		{"x": 900.0, "천장": -250.0, "색": ColorDefs.WHITE},
		{"x": 2200.0, "천장": -250.0, "색": ColorDefs.BLACK},
		{"x": 3600.0, "천장": -620.0, "색": ColorDefs.WHITE},
		{"x": 4700.0, "천장": -620.0, "색": ColorDefs.BLACK},
	]
	for i in 구멍들.size():
		var g: Dictionary = 구멍들[i]
		var 빛: Node2D = 빛기둥_S.new()
		빛.name = "지붕구멍_빛_%d" % (i + 1)
		빛.position = Vector2(g["x"], g["천장"])
		빛.set("모드", 1)
		빛.set("색", g["색"])
		빛.set("각도", 90.0)
		빛.set("길이", 780.0 - float(g["천장"]))
		빛.set("시작폭", 120.0)
		빛.set("끝폭", 320.0)
		빛.set("세기", 0.95)
		빛.set("먼지", 34)
		빛.set("물듦_반경", 170.0)
		루트.get_node("오브젝트").add_child(빛)

	# ── ★구멍 빛 사이의 안전 발판 ── 혼합안 ②.
	#   빛을 지나 색이 바뀌면 **바로 다음 발판이 그 색이어야** 한다.
	#   구멍1(흰) 다음은 흰 발판, 구멍2(검정) 다음은 검정 발판. 그래야 인과가 읽힌다.
	_선반색(루트, "다락발판_1", 1200, 560, 300, 발판색_.흰색, 1.0, "거친암반")
	_선반색(루트, "다락발판_2", 1700, 560, 300, 발판색_.무색, 1.0, "거친암반")
	_선반색(루트, "다락발판_3", 2500, 560, 300, 발판색_.검정, 1.0, "거친암반")

	_지형(루트, "지붕가로막이", Vector2(4300, 430), 공통.벽_점들(150, 540), "거친암반")

	# 가구 계단 — 단차 120px. 색은 검정 → 무색 → 흰색 → 검정.
	_선반색(루트, "지붕선반_1", 3000, 580, 300, 발판색_.검정, 1.0, "거친암반")
	_선반색(루트, "지붕선반_2", 3350, 460, 300, 발판색_.무색, 1.0, "거친암반")
	_선반색(루트, "지붕선반_3", 3700, 340, 280, 발판색_.흰색, 1.0, "거친암반")
	_선반색(루트, "지붕선반_4", 3950, 220, 250, 발판색_.검정, 1.0, "거친암반")

	var 창C: Node2D = 창문_S.new()
	창C.name = "창문_지붕"
	창C.position = Vector2(4200, 225)
	창C.set("크기", Vector2(56, 250))
	창C.set("빛_각도", 0.0)
	창C.set("빛_길이", 700.0)
	창C.set("빛_끝폭", 320.0)
	창C.set("빛_모드", 2)
	창C.set("색섞임_회색", false)
	루트.get_node("오브젝트").add_child(창C)

	_선반색(루트, "지붕착지선반", 4850, 320, 300, 발판색_.무색, 1.0, "거친암반")

	var 하강 := [820.0, 940.0, 1060.0, 1180.0, 1300.0]
	for i in 하강.size():
		_선반(루트, "하강_%d" % (i + 1), 5060.0 + float(i) * 240.0,
			float(하강[i]), 300.0, 1.0, "거친암반")
	_지형(루트, "하수도바닥", Vector2.ZERO,
		공통.평바닥_점들(6100, 7500, 1420, 1900, 2.5), "거친암반")
	_지형(루트, "하수도천장", Vector2.ZERO,
		공통.천장_점들(6100, 7500, 900, 500, 24.0), "거친암반")

	_플레이어(루트, Vector2(-300, 640))
	_저장(루트, "원본_집_지붕.tscn")