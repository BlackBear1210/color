const 공통 := preload("res://tools/지형공통.gd")
const 규칙 := preload("res://scripts/스마트월드/지형규칙.gd")
const 월드_S := preload("res://scripts/스마트월드/월드.gd")
const 코어_S := preload("res://scripts/스마트월드/페인트_코어.gd")
const 실내배경_S := preload("res://scripts/스마트월드/실내배경.gd")
const 빛기둥_S := preload("res://scripts/스마트월드/빛기둥.gd")
const 창문_S := preload("res://scripts/스마트월드/창문커튼.gd")
const 챕터_S := preload("res://scripts/스마트월드/챕터.gd")
const PLAYER := "res://scenes/player/Player.tscn"
const 원본폴더 := "res://scenes/스마트월드/_원본/"

## 선반(발판) 두께. 윗면 y = 중심 y − 두께/2 이므로 단차 계산에 꼭 필요하다.
##
## ★★[2026-08-19] 32 → 16 으로 줄였다. 도형님이 말한
##   **"플랫폼이 땅 지형에 충분히 떠 있지 않아서 플레이어가 지나가지 못한다"** 의 정체가 이것이다.
##
##   선반을 바닥 위 `단차`(120px) 에 놓으면, 그 아래로 남는 높이는
##       머리 여유 = 단차 − 선반두께
##   두께가 32 면 **88px** 이다. 플레이어 키는 **97px** — 9px 이 모자라 못 지나간다.
##   그런데 위에서 보면 멀쩡한 계단이라 **눈으로는 절대 안 보인다.**
##   `레벨검사.gd` 도 못 잡는다 — 그 도구는 머리가 안 들어가는 자리를 아예
##   "발판이 아니다" 로 빼 버리기 때문에, 다른 길만 있으면 조용히 통과시킨다.
##   (그래서 `tools/지형_진단.gd` 를 새로 만들었다 — 빠진 자리만 보는 도구다)
##
##   두께 16 → 머리 여유 **104px** ≥ 키 97px ✓ · 단차는 그대로 120px ≤ 안전 128px ✓
##   ⚠ 두께를 21px 보다 크게 하면 이 부등식이 다시 깨진다. 늘리려면 단차도 같이 봐야 한다.
const 선반두께: float = 16.0

## 이 스테이지들의 플레이어 튜닝. `Player.tscn` 기본값과 같다.
##   점프 높이 10칸 = 160px · 점프 거리 10칸 = 160px … 이 아니라 아래 값을 쓴다.
## ★거리를 15칸(240px)으로 올린다: 굴뚝의 좌우 선반 사이를 건너야 하는데
##   기본 160px 이면 벽에서 벽으로 못 건넌다(선반 겹침 구간이 100px 뿐이라 여유가 없다).
const 튜닝 := {"move_speed": 390.0, "타일_크기": 16.0, "점프_높이_칸": 10.0, "점프_거리_칸": 15.0}

var _재질 := {}
var _성공 := 0


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== 집 3분할 원본 빌더 ===")
	for 종류 in ["기본", "거친암반", "덩어리"]:
		_재질[종류] = 공통.재질_준비(종류)
		if String(_재질[종류]).is_empty():
			push_error("재질 준비 실패: %s" % 종류)
			quit(1)
			return

	_거실()
	_굴뚝()
	_지붕()

	print("---")
	print("[집] %d / 3 저장 성공" % _성공)
	print("이어서: godot --headless --path . -s res://tools/스마트월드_체인.gd -- --만 5,6,7")
	quit(0 if _성공 == 3 else 1)


# ============================================================================
# 공통 뼈대
# ============================================================================
## 스테이지 루트 한 벌(월드 + 페인트코어 + 실내배경 + 어둠 + 지형층 + 오브젝트층).
## 챕터 팔레트를 그대로 쓴다 — 집도 챕터 1 이라 숲과 같은 명도 대역에 있어야
## 통로를 지나 숲으로 나왔을 때 눈이 안 놀란다.
func _뼈대(이름: String, 리밋: Rect2, 시작: Vector2, 낙사y: float,
		아래방: int, 위방: int, 전환시작y: float, 전환끝y: float) -> Node2D:
	var 루트: Node2D = 월드_S.new()
	루트.name = 이름
	루트.set("스테이지_이름", 이름)
	루트.set("카메라_줌", 0.82)
	루트.set("시작_위치", 시작)
	루트.set("낙사_y", 낙사y)
	루트.set("카메라_리밋", 리밋)

	# 페인트 규칙 엔진 — 지형보다 먼저 트리에 들어가야 한다(지형이 _ready 에서 찾는다).
	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)      # true = 씬 파일에 그룹이 저장된다
	루트.add_child(코어)

	# 실내 배경 — 세로로 섞이는 배경. 바깥 풍경(stage_backdrop)은 쓰지 않는다(집 안이다).
	var 배경: Node2D = 실내배경_S.new()
	배경.name = "실내배경"
	배경.set("영역", Rect2(리밋.position - Vector2(600, 500), 리밋.size + Vector2(1200, 1000)))
	배경.set("아래_방", 아래방)
	배경.set("위_방", 위방)
	배경.set("전환_시작y", 전환시작y)
	배경.set("전환_끝y", 전환끝y)
	루트.add_child(배경)

	# 전체 톤 — ESC 메뉴 밝기 슬라이더의 100% 기준값이 이 색이다.
	var 팔: Dictionary = 챕터_S.팔레트(1)
	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	어둠.color = 팔["어둠"]
	루트.add_child(어둠)

	var 지형층 := Node2D.new()
	지형층.name = "지형"
	루트.add_child(지형층)

	var 오브젝트층 := Node2D.new()
	오브젝트층.name = "오브젝트"
	루트.add_child(오브젝트층)
	return 루트


## 지형 하나 붙이기. 전부 "칠할 수 있고 / 유령이 아닌" 단단한 지형이다.
func _지형(루트: Node2D, 이름: String, 위치: Vector2, 점들: PackedVector2Array,
		재질: String = "기본") -> void:
	var 층 := 루트.get_node("지형")
	층.add_child(공통.지형_노드(이름, 위치, 점들, _재질[재질], true, false, 0, 16.0))


## 선반(발판) 하나. **`윗면` 은 밟는 면의 y 다** (노드 중심이 아니다).
##
## ★[2026-08-19] 예전에는 노드 **중심 y** 를 받았다. 그래서 두께를 32 → 16 으로 바꾸는
##   순간 모든 선반의 윗면이 8px 씩 내려가 단차 계산이 통째로 어긋났다.
##   레벨 수치는 전부 "밟는 면" 기준으로 이야기하는데 함수만 중심을 받으니
##   부르는 쪽에서 매번 `+ 두께/2` 를 하다가 한 군데를 빠뜨렸다.
##   → **함수가 윗면을 받게 바꿨다.** 이러면 두께를 바꿔도 레벨이 안 흔들린다.
func _선반(루트: Node2D, 이름: String, x: float, 윗면: float, 길이: float, 방향: float,
		재질: String = "기본") -> void:
	_지형(루트, 이름, Vector2(x, 윗면 + 선반두께 * 0.5),
		공통.선반_점들(길이, 선반두께, 방향), 재질)


## 플레이어를 붙이고 레벨이 전제하는 점프 튜닝을 박는다.
## ⚠ 인스턴스 안쪽으로 owner 를 내리지 않는다(§주인_지정 주석의 2026-08-02 치명 버그).
func _플레이어(루트: Node2D, 위치: Vector2) -> void:
	var p := (load(PLAYER) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 위치
	for k in 튜닝:
		p.set(k, 튜닝[k])
	루트.add_child(p)


func _저장(루트: Node2D, 파일: String) -> void:
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var err := 팩.pack(루트)
	if err != OK:
		push_error("  pack 실패: %s" % error_string(err))
		return
	var 경로 := 원본폴더 + 파일
	err = ResourceSaver.save(팩, 경로)
	if err == OK:
		_성공 += 1
	print("   저장 %s → %s" % [error_string(err), 경로])
	루트.queue_free()



# ============================================================================
# ★레벨 안전 수치 — 여기 숫자를 왜 이렇게 잡았는지 (2026-08-18 에 한 번 틀렸다)
# ----------------------------------------------------------------------------
#   플레이어 점프 성능은 높이 160px · 거리 240px 이다(위 `튜닝`).
#   그런데 `tools/레벨검사.gd` 는 **여유를 빼고** 본다:
#       올라갈 수 있는 단차 = 점프 높이 × 0.80 = 128px
#       건널 수 있는 가로  = 점프 거리 × 0.85 = 204px
#   처음에 155px 단차로 깔았더니 "이론상 닿지만 실제로는 턱을 못 넘는" 자리가 되어
#   레벨검사가 굴뚝을 통째로 [불가] 로 잡았다. 실제로도 그런 단차는 아슬아슬해서
#   플레이 감각이 나쁘다(매번 최고점에서 딱 걸린다).
#   → 이 파일의 모든 세로 단차는 **120px**, 가로 건너기는 **200px 이하**로 깐다.
const 단차: float = 120.0        ## 안전 세로 단차 (검사 한계 128 보다 8px 여유)
const 최대가로: float = 200.0    ## 안전 가로 건너기 (검사 한계 204 보다 4px 여유)


# ============================================================================
# ① 거실 — 가로. 구덩이를 창문 빛다리로 건넌다.
# ============================================================================
## ▣ 이 방이 가르치는 것
##   "창을 쏘면 **창이 아니라 빛이** 물들고, 물든 빛은 **딛고 설 수 있다**."
##   구덩이(폭 680px · 점프 거리 240px 로는 절대 못 건넌다)를 건너는 길이 빛다리다.
##   ★쏘는 색을 틀리면(내 색과 반대색으로 물들이면) 그 빛에 닿는 순간 죽는다.
##     새 규칙을 하나도 안 배우고 새 장치를 이해하게 된다 — 게임 규칙 그대로다.
##
## ▣ 구덩이를 **즉사**로 안 만든 이유
##   빛다리를 안 만들고 뛰어들면 죽는 구조로 짜면, 아직 장치를 이해 못 한 플레이어가
##   같은 자리에서 반복해 죽는다. 대신 420px 아래에 지하 바닥을 두었다
##   (치명 낙하 520px 미만이라 안 죽는다). 떨어지면 **계단으로 돌아 올라오면 된다** —
##   느려질 뿐 막히지 않는다. 그래서 `레벨검사` 도 "갇히는 곳 0" 으로 통과한다.
##   ★빛다리는 "빠르고 우아한 길", 지하는 "느린 길" 이다. 퍼즐은 강제가 아니라 유혹이다.
func _거실() -> void:
	print("\n── 원본_집_거실")
	var 리밋 := Rect2(-1400, -1100, 7000, 2900)
	var 루트 := _뼈대("원본_집_거실", 리밋, Vector2(0, 640), 1900.0,
		실내배경_S.방_.거실, 실내배경_S.방_.굴뚝, 200.0, -600.0)

	# ── 방 ── 바닥 윗면 700 / 천장 아랫면 −340. 방 높이 1040px = 플레이어 키의 10 배.
	_지형(루트, "거실바닥_앞", Vector2.ZERO, 공통.평바닥_점들(-700, 2920, 700, 1150, 2.0))
	_지형(루트, "거실바닥_뒤", Vector2.ZERO, 공통.평바닥_점들(3600, 4900, 700, 1150, 2.0))
	_지형(루트, "거실천장", Vector2.ZERO, 공통.천장_점들(-700, 4900, -340, -820, 26.0))
	_지형(루트, "거실왼벽", Vector2(-800, 180), 공통.벽_점들(200, 1500))
	# ★오른쪽 벽은 안 세운다 — 출구 통로가 지형 속으로 460px 파고들며 스스로 뒷벽을 만든다.
	#   여기에 벽을 세우면 통로와 겹쳐 "벽 속에 박힌 상자" 로 보인다(2026-08-06 에 겪은 그림).

	# ── 지하(구덩이 바닥) ── 700 → 1120 = 420px 낙하. 치명(520) 미만이라 안 죽는다.
	_지형(루트, "거실지하", Vector2.ZERO, 공통.평바닥_점들(2860, 3660, 1120, 1560, 2.0))
	# 지하에서 오른쪽 바닥으로 돌아 올라오는 계단 (단차 120px 씩)
	_선반(루트, "지하계단_1", 3220, 1000, 260, 1.0)     # 윗면 1000
	_선반(루트, "지하계단_2", 3340, 880, 260, 1.0)      # 윗면  880
	_선반(루트, "지하계단_3", 3460, 760, 260, 1.0)      # 윗면  760 → 거실바닥_뒤(700) 로 60px

	# ── ★창문 A ── 구덩이 왼쪽 턱에 박힌 창. 이 방의 자물쇠이자 열쇠.
	#   빛 윗면 = 창중심y − 시작폭/2 = 810 − 110.4 ≈ 700 = **앞 바닥과 같은 높이**.
	#   그래서 굳는 순간 바닥이 그대로 이어진 것처럼 보인다(다리를 "놓았다"가 아니라
	#   "빛이 바닥이 되었다"로 읽힌다 — 이게 이 장치의 그림이다).
	#   빛 끝 윗면 = 810 − 300/2 = 660 → 뒤 바닥(700)에 30px 내려서며 착지한다.
	var 창A: Node2D = 창문_S.new()
	창A.name = "창문_거실"
	창A.position = Vector2(2890, 810)
	창A.set("크기", Vector2(56, 240))
	창A.set("빛_각도", 0.0)                 # 오른쪽으로 뻗는다 = 구덩이를 가로지른다
	창A.set("빛_길이", 780.0)               # x 2918 → 3698. 뒤 바닥(3600~) 위까지 닿는다
	창A.set("빛_끝폭", 300.0)
	창A.set("빛_모드", 2)                   # 2 = 발판 (굳어서 딛고 설 수 있다)
	창A.set("색섞임_회색", false)           # 길을 막는 창 → 회색 소프트락 금지 (§주석)
	루트.get_node("오브젝트").add_child(창A)

	# ── 천장 틈새 빛(경계) ── 도형님이 빨간색으로 칠한 "새어 드는 빛" 의 첫 등장.
	#   흰 빛이라 **검정인 채로 들어가면 죽는다.** Shift 로 흰색이 되어 지나간다
	#   (물감을 한 발도 안 쓰고 넘는 구간 — 물감이 떨어져도 진행이 막히지 않는다).
	#   ★구덩이보다 **앞**에 둔다. 색 규칙을 먼저 복습시키고 나서 새 장치를 준다.
	var 틈빛: Node2D = 빛기둥_S.new()
	틈빛.name = "천장틈_빛"
	틈빛.position = Vector2(1800, -330)
	틈빛.set("모드", 1)                     # 1 = 경계 (통과되지만 반대색이면 즉사)
	틈빛.set("색", ColorDefs.WHITE)
	틈빛.set("각도", 90.0)                  # 아래로
	틈빛.set("길이", 1090.0)                # −330 → 760. 바닥(700)을 확실히 지난다
	틈빛.set("시작폭", 110.0)
	틈빛.set("끝폭", 300.0)
	틈빛.set("세기", 0.95)
	루트.get_node("오브젝트").add_child(틈빛)

	# ── 가구 ── 밟을 수 있지만 진행에는 필요 없다. 방이 비어 보이지 않게 하는 값싼 장치.
	#   단차는 그래도 120px 로 맞춘다 — 밟을 수 있는데 못 올라가면 그게 더 헷갈린다.
	_선반(루트, "가구_찬장", 760, 580, 300, 1.0)        # 윗면 580 (바닥 700 에서 120)
	_선반(루트, "가구_책장", 1140, 460, 280, 1.0)       # 윗면 460
	_선반(루트, "가구_탁자", 2260, 580, 260, 1.0)       # 윗면 580

	# ── 분위기용 빛 ── 판정 없음.
	for i in 2:
		var 연출: Node2D = 빛기둥_S.new()
		연출.name = "거실_연출빛_%d" % (i + 1)
		연출.position = Vector2(300.0 + float(i) * 820.0, -330.0)
		연출.set("모드", 0)                 # 0 = 연출
		연출.set("각도", 96.0)
		연출.set("길이", 1060.0)
		연출.set("시작폭", 70.0)
		연출.set("끝폭", 210.0)
		연출.set("세기", 0.42)
		연출.set("먼지", 18)
		루트.get_node("오브젝트").add_child(연출)

	_플레이어(루트, Vector2(0, 640))
	_저장(루트, "원본_집_거실.tscn")


# ============================================================================
# ② 굴뚝 — 세로. 카메라가 굴뚝 벽 밖을 절대 안 비춘다.
# ============================================================================
## ▣ 카메라가 벽을 안 넘는 방법 (도형님 요청의 핵심)
##   좌우 벽 이름을 **`굴뚝벽_좌` / `굴뚝벽_우`** 로 짓는다. 그게 전부다.
##   `카메라공간배치.gd` 가 이 이름 규약을 찾아 두 벽의 **콜리전 실측값** 사이에
##   `카메라_공간` 노드를 자동으로 놓고, `카메라_공간.gd` 가 카메라 리밋을 그 폭으로
##   조인다. 리밋이 화면보다 좁으면 `ProtoCamera._clamp_to_limits` 가 카메라를
##   가운데 못박으므로 **좌우로 뛰어도 화면이 1px 도 안 흐른다** = 벽 밖이 안 보인다.
##   ★좌표를 손으로 안 적는 이유: 벽을 1px 만 옮겨도 손으로 적은 값은 어긋나는데,
##     어긋난 걸 눈으로는 알 수 없다("왜 좀 이상하지?" 로만 느껴진다).
##
## ▣ ⚠ 왼쪽 벽 아래를 **띄워 둔다** (2026-08-18 에 여기서 한 번 막혔다)
##   처음엔 좌우 벽을 바닥까지 내렸다. 그랬더니 왼쪽 벽이 **입구와 굴뚝을 갈라놓아**
##   플레이어가 굴뚝 안으로 아예 못 들어갔다(레벨검사: "여기 들어가면 출구까지 못 간다").
##   벽이 2500px 이라 넘을 수도 없다. 그림으로는 전혀 안 보이는 종류의 사고다.
##   → 왼쪽 벽 **아랫단을 바닥 위 220px 에서 끊는다** = 아궁이 입구가 된다.
func _굴뚝() -> void:
	print("\n── 원본_집_굴뚝")
	var 리밋 := Rect2(-1800, -2400, 4600, 4000)
	var 루트 := _뼈대("원본_집_굴뚝", 리밋, Vector2(-600, 650), 1900.0,
		실내배경_S.방_.굴뚝, 실내배경_S.방_.지붕, -400.0, -1400.0)

	# ── 굴뚝 바닥(아궁이) ── 입구부터 굴뚝 안까지 끊김 없이 이어진다.
	_지형(루트, "아궁이바닥", Vector2.ZERO, 공통.평바닥_점들(-1000, 560, 700, 1150, 2.0), "거친암반")

	# ── ★좌우 벽 ── 이름 규약을 지켜야 카메라 연출이 저절로 따라온다.
	#   안쪽 폭 = 520 − 20 = 500px (최소 안쪽폭 120 ✓ · 플레이어 폭 44 의 11 배).
	#   좌: y −1700 ~ 480  (아래 220px 이 아궁이 입구 — 위 ⚠ 주석 참고)
	#   우: y −1500 ~ 800  (바닥까지 막는다. 이쪽으로는 나갈 일이 없다)
	#
	# ★★벽 두께가 1400px 인 이유 (2026-08-18 · 스크린샷을 보고 고쳤다)
	#   처음엔 200px 이었다. 그랬더니 굴뚝 안에서 **벽 바깥 빈 공간이 그대로 보였다** —
	#   도형님이 "맵의 벽을 넘어가지 않으면 좋겠다" 고 한 바로 그 그림이다.
	#   카메라 리밋만으로는 못 막는다: 리밋이 화면보다 좁으면 카메라가 가운데 못박히지만
	#   **화면 크기는 그대로다.** 줌 0.82 × 카메라공간 배수 1.34 = 1.10 → 화면 폭 1745px 인데
	#   굴뚝 안쪽은 500px 이니, 나머지 1245px 은 무조건 벽 자리다.
	#   → 벽을 **화면 반폭보다 두껍게**(1400px ≥ 1745/2) 만들면 어느 위치에서도
	#     화면이 암반으로 꽉 찬다. 림보·레인월드가 쓰는 방식 그대로 —
	#     "공간은 덩어리에서 파낸 것" 이라야 벽 너머가 없다.
	#   ⚠ 안쪽 면(x 20 / x 520)은 그대로 둔다. 거기가 카메라 공간의 기준이다.
	_지형(루트, "굴뚝벽_좌", Vector2(-680, -610), 공통.벽_점들(1400, 2180), "거친암반")
	_지형(루트, "굴뚝벽_우", Vector2(1220, -350), 공통.벽_점들(1400, 2300), "거친암반")

	# ── 지그재그 선반 ── 좌(x 20 에서 오른쪽) ↔ 우(x 520 에서 왼쪽) 를 번갈아.
	#   길이 300 이라 좌 [20,320] · 우 [220,520] 로 **100px 겹친다** → 가로 건너기 0px.
	#   세로 단차는 전부 120px (검사 한계 128 ✓).
	#   윗면 = 중심 y − 16 이므로 아래 값은 전부 **윗면** 이다.
	#
	# ★[2026-08-18] 굴뚝에는 창문을 **안 넣는다.** 왜인지 남겨 둔다.
	#   처음엔 사다리 한 칸을 비우고 그 자리를 창문 빛다리로 메웠다. 그런데
	#     ① `레벨검사.gd` 는 **지형만** 본다. 물감을 쏴야 굳는 빛은 지형이 아니라서
	#        "출구까지 못 간다(소프트락)" 로 잡힌다 — 팀의 품질 게이트가 빨개진다.
	#     ② 120px 간격 사다리 사이에 빛기둥(세로 두께 190px)을 끼우면 선반과 겹친다.
	#   → 굴뚝의 주인공은 **카메라**다(도형님이 굴뚝에서 강조한 것도 그것이다).
	#     창문 장치는 거실·지붕에서 충분히 보여 준다. 나중에 레벨검사가 빛기둥을
	#     이해하게 되면(다음 작업 후보) 여기에도 넣으면 된다 — 줄 몇 개면 된다.
	var 사다리 := [580.0, 460.0, 340.0, 220.0, 100.0, -20.0, -140.0, -260.0, -380.0, -500.0,
		-620.0, -740.0, -860.0, -980.0, -1100.0, -1220.0, -1340.0, -1460.0]
	for i in 사다리.size():
		var 왼쪽 := i % 2 == 0
		_선반(루트, "굴뚝선반_%d" % (i + 1), 20.0 if 왼쪽 else 520.0,
			float(사다리[i]), 300.0, 1.0 if 왼쪽 else -1.0, "거친암반")

	# ── 굴뚝 위 지붕(출구 쪽 바닥) ──
	#   마지막 선반(윗면 −1460 · 홀수 index 17 = 오른쪽 x 220~520)
	#     → 이 바닥 윗면(−1520) = 60px 오름 · 가로 0px ✓
	_지형(루트, "굴뚝위지붕", Vector2.ZERO,
		공통.평바닥_점들(520, 2200, -1520, -1200, 2.0), "거친암반")

	# ── ★굴뚝 꼭대기 빛 ── "출구는 위" 라는 시각 신호이자, 배경이 굴뚝 → 지붕으로
	#   바뀌는 지점의 신호탄. **판정은 안 건다(연출).**
	#   여기에 경계를 걸면 등반 도중 색을 못 바꿔 억울하게 죽는다 — 손이 점프에 묶여 있다.
	var 꼭대기: Node2D = 빛기둥_S.new()
	꼭대기.name = "굴뚝꼭대기_빛"
	꼭대기.position = Vector2(270, -1690)
	꼭대기.set("모드", 0)
	꼭대기.set("각도", 92.0)
	꼭대기.set("길이", 1500.0)
	꼭대기.set("시작폭", 180.0)
	꼭대기.set("끝폭", 460.0)
	꼭대기.set("세기", 0.9)
	꼭대기.set("먼지", 44)
	루트.get_node("오브젝트").add_child(꼭대기)

	_플레이어(루트, Vector2(-600, 650))
	_저장(루트, "원본_집_굴뚝.tscn")


# ============================================================================
# ③ 지붕 — 가로. 지붕 구멍 빛(경계) 3 개 + 창문 빛다리 + 하수도로 내려가는 계단.
# ============================================================================
## ▣ 이 방이 가르치는 것
##   빛이 **길을 막는 벽**도 된다는 것. 구멍 빛 3 개가 흰-검-흰 으로 놓여 있어
##   지나가려면 색을 두 번 바꿔야 한다. 물감을 한 발도 안 쓰는 구간이라
##   앞 스테이지에서 물감을 다 써도 여기서 막히지 않는다(리듬 설계).
##
## ▣ 하수도로 "점차" 이어지는 방법
##   씬을 갈지 않고 **바닥을 계단으로 700 → 1420 까지 내린다.** 배경(`실내배경`)이
##   카메라 y 로 섞이므로, 내려갈수록 서까래가 사라지고 아치형 하수도 벽이 드러난다.
##   출구 통로는 그 아래 끝에 있어서, 통로에 들어갈 때 이미 하수도 안이다.
##   ★계단 단차를 전부 120px 로 맞춰 **다시 올라올 수도 있게** 했다.
##     한 번 내려가면 못 올라오는 구조는 실수로 떨어졌을 때 되돌릴 방법이 없다.
func _지붕() -> void:
	print("\n── 원본_집_지붕")
	var 리밋 := Rect2(-1600, -1800, 9500, 4200)
	var 루트 := _뼈대("원본_집_지붕", 리밋, Vector2(-300, 640), 2400.0,
		실내배경_S.방_.하수도, 실내배경_S.방_.지붕, 1300.0, 600.0)

	# ── 다락 바닥 ── 끊김 없이 이어진다. 구멍(즉사 함정)을 안 파는 이유:
	#   이 스테이지의 난이도는 **색 전환**이 맡는다. 낙사까지 겹치면 두 가지를
	#   동시에 요구하게 되어 "무엇 때문에 죽었는지" 를 못 배운다.
	_지형(루트, "다락바닥", Vector2.ZERO, 공통.평바닥_점들(-800, 5000, 700, 1250, 2.5), "거친암반")
	_지형(루트, "다락왼벽", Vector2(-900, 100), 공통.벽_점들(200, 1600), "거친암반")

	# ── 지붕면(천장) ── 두 단으로 꺾어 "지붕" 실루엣을 만든다(평천장이면 방으로 읽힌다).
	_지형(루트, "지붕면_앞", Vector2.ZERO, 공통.천장_점들(-800, 2600, -250, -820, 30.0), "거친암반")
	_지형(루트, "지붕면_뒤", Vector2.ZERO, 공통.천장_점들(2600, 5200, -620, -1180, 30.0, 72.0, 1.7), "거친암반")

	# ── ★지붕 구멍 빛 3 개 ── 도형님이 빨간색으로 칠한 자리.
	#   흰 → 검정 → 흰. 색을 두 번 바꾸며 지난다. 전부 경계 모드(통과되지만 반대색은 즉사).
	#   ★지형을 하나도 안 놓고 길을 나누는 장애물이라, 다락처럼 텅 빈 공간에 딱 맞는다.
	var 구멍들 := [
		{"x": 900.0, "천장": -250.0, "색": ColorDefs.WHITE},
		{"x": 2200.0, "천장": -250.0, "색": ColorDefs.BLACK},
		{"x": 3600.0, "천장": -620.0, "색": ColorDefs.WHITE},
	]
	for i in 구멍들.size():
		var g: Dictionary = 구멍들[i]
		var 빛: Node2D = 빛기둥_S.new()
		빛.name = "지붕구멍_빛_%d" % (i + 1)
		빛.position = Vector2(g["x"], g["천장"])
		빛.set("모드", 1)                              # 경계
		빛.set("색", g["색"])
		빛.set("각도", 90.0)
		빛.set("길이", 780.0 - float(g["천장"]))       # 바닥(700)보다 80px 더 내려간다
		빛.set("시작폭", 120.0)
		빛.set("끝폭", 320.0)
		빛.set("세기", 0.95)
		빛.set("먼지", 34)
		루트.get_node("오브젝트").add_child(빛)

	# ── 가로막이 ── 윗면 160. 바닥(700)에서 540px → 점프(160)로 절대 못 넘는다.
	#   이 스테이지의 출구는 이것 **너머**에 있다 → 빛다리가 유일하게 우아한 길이다.
	_지형(루트, "지붕가로막이", Vector2(4300, 430), 공통.벽_점들(150, 540), "거친암반")

	# ── 가구 계단 ── 단차 120px. 700 → 580 → 460 → 340 → 220
	_선반(루트, "지붕선반_1", 3000, 580, 300, 1.0, "거친암반")   # 윗면 580
	_선반(루트, "지붕선반_2", 3350, 460, 300, 1.0, "거친암반")   # 윗면 460
	_선반(루트, "지붕선반_3", 3700, 340, 280, 1.0, "거친암반")   # 윗면 340
	_선반(루트, "지붕선반_4", 3950, 220, 250, 1.0, "거친암반")   # 윗면 220

	# ── ★창문 C ── 가로막이에 박힌 지붕창(dormer).
	#   빛 윗면 = 225 − 115 = 110.
	#     지붕선반_4 윗면(220) → 110 = 110px 오름 ✓ (한계 128)
	#     가로막이 윗면(160) 보다 50px 높으므로 그 위를 걸어 넘는다.
	#   빛 끝 윗면 = 225 − 320/2 = 65.
	var 창C: Node2D = 창문_S.new()
	창C.name = "창문_지붕"
	창C.position = Vector2(4200, 225)
	창C.set("크기", Vector2(56, 250))
	창C.set("빛_각도", 0.0)
	창C.set("빛_길이", 700.0)            # x 4228 → 4928. 가로막이(4225~4375)를 넘는다
	창C.set("빛_끝폭", 320.0)
	창C.set("빛_모드", 2)                # 발판
	창C.set("색섞임_회색", false)        # 길을 막는 창 → 회색 소프트락 금지
	루트.get_node("오브젝트").add_child(창C)

	# ── 착지 ── 빛 끝 윗면(65) → 이 선반 윗면(320) = 255px 낙하 ✓ (치명 520 미만)
	#   → 다시 바닥(700) 으로 380px ✓
	_선반(루트, "지붕착지선반", 4850, 320, 300, 1.0, "거친암반")

	# ── ★가로막이를 못 넘었을 때의 되돌아갈 길 ──
	#   빛다리를 못 만들면 여기서 막힌다. 그건 "죽는" 게 아니라 "돌아가는" 것이다 —
	#   가로막이 앞 바닥이 그대로 이어져 있어 언제든 되돌아가 물감을 다시 모을 수 있다.

	# ── 하수도로 내려가는 계단 ── 단차 120px 씩. 700 → 820 → 940 → 1060 → 1180 → 1300 → 1420
	var 하강 := [820.0, 940.0, 1060.0, 1180.0, 1300.0]
	for i in 하강.size():
		_선반(루트, "하강_%d" % (i + 1), 5060.0 + float(i) * 240.0,
			float(하강[i]), 300.0, 1.0, "거친암반")
	_지형(루트, "하수도바닥", Vector2.ZERO,
		공통.평바닥_점들(6100, 7500, 1420, 1900, 2.5), "거친암반")
	_지형(루트, "하수도천장", Vector2.ZERO,
		공통.천장_점들(6100, 7500, 900, 500, 24.0), "거친암반")

	_플레이어(루트, Vector2(-300, 640))
	_저장(루트, "원본_집_지붕.tscn")
