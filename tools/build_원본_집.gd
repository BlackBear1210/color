const 공통 := preload("res://tools/지형공통.gd")
const 규칙 := preload("res://scripts/스마트월드/지형규칙.gd")
const 월드_S := preload("res://scripts/스마트월드/월드.gd")
const 코어_S := preload("res://scripts/스마트월드/페인트_코어.gd")
const 실내배경_S := preload("res://scripts/스마트월드/실내배경.gd")
const 빛기둥_S := preload("res://scripts/스마트월드/빛기둥.gd")
const 창문_S := preload("res://scripts/스마트월드/창문커튼.gd")
const 챕터_S := preload("res://scripts/스마트월드/챕터.gd")
const PLAYER := "res://scenes/player/Player.tscn"
const 원본폴더 := "res://scenes/스마트월드/_원본/"

## 선반(발판) 두께. 윗면 y = 중심 y − 두께/2 이므로 단차 계산에 꼭 필요하다.
##
## ★★[2026-08-19] 32 → 16 으로 줄였다. 도형님이 말한
##   **"플랫폼이 땅 지형에 충분히 떠 있지 않아서 플레이어가 지나가지 못한다"** 의 정체가 이것이다.
##
##   선반을 바닥 위 `단차`(120px) 에 놓으면, 그 아래로 남는 높이는
##       머리 여유 = 단차 − 선반두께
##   두께가 32 면 **88px** 이다. 플레이어 키는 **97px** — 9px 이 모자라 못 지나간다.
##   그런데 위에서 보면 멀쩡한 계단이라 **눈으로는 절대 안 보인다.**
##   `레벨검사.gd` 도 못 잡는다 — 그 도구는 머리가 안 들어가는 자리를 아예
##   "발판이 아니다" 로 빼 버리기 때문에, 다른 길만 있으면 조용히 통과시킨다.
##   (그래서 `tools/지형_진단.gd` 를 새로 만들었다 — 빠진 자리만 보는 도구다)
##
##   ★[2026-08-19] 16 → **20** (도형님 요청 "두께감"). 28 까지 키웠다가 되돌린 기록:
##     바닥 바로 위 첫 선반 아래를 지나갈 때 머리 여유 = 단차 − 두께 여야 하는데
##     120 − 28 = 92px 이라 키(97px)가 안 들어갔다. 부등식이 이렇게 묶여 있다:
##         단차 − 두께 ≥ 103   (지나갈 수 있어야 한다)
##         단차        ≤ 128   (올라갈 수 있어야 한다 · 검사 한계)
##       ⟹ 두께 ≤ 25.  → 두께 20 · 단차 124 → 여유 104px ✓ · 오름 124px ✓
##     ⚠ 그리고 124 로 올렸더니 실측 단차가 **129px** 로 나왔다(한계 128 · 1px 초과).
##       `평바닥_점들` 의 물결(±2.5px)과 `선반_점들` 끝의 기울기 때문에 **실측은 늘 설정값보다 크다.**
##       설정값만 보고 한계에 붙이면 안 된다 — 5px 쯤은 여유를 둬야 한다.
##       → 검증된 조합인 **두께 16 · 단차 120**(여유 104 · 실측 오름 125)으로 되돌렸다.
##     ★두께감을 진짜로 주려면 두께를 키우는 게 아니라, 선반이 **걸어 다니는 바닥 위를
##       덮지 않게** 배치해야 한다(굴뚝처럼 좌우를 안 겹치게). 그러면 두께 제한이 사라진다.
##       남은 작업으로 인수인계 문서에 적어 두었다.
##   키울 수 있게 된 이유는 굴뚝 **안쪽 폭을 넓혀 좌우 선반이 가로로 안 겹치게** 했기 때문이다.
##   겹치지 않으면 머리 위에 있는 것은 **같은 쪽 선반(240px 위)** 이라
##   머리 여유가 240 − 28 = 212px 로 넉넉하다. **폭을 넓힌 것이 두께를 허락했다.**
##   ⚠ 좌우가 겹치는 배치로 되돌리면 단차 120 − 두께 28 = 92px < 키 97px 이라 다시 막힌다.
const 선반두께: float = 16.0

## 이 스테이지들의 플레이어 튜닝. `Player.tscn` 기본값과 같다.
##   점프 높이 10칸 = 160px · 점프 거리 10칸 = 160px … 이 아니라 아래 값을 쓴다.
## ★거리를 15칸(240px)으로 올린다: 굴뚝의 좌우 선반 사이를 건너야 하는데
##   기본 160px 이면 벽에서 벽으로 못 건넌다(선반 겹침 구간이 100px 뿐이라 여유가 없다).
const 튜닝 := {"move_speed": 390.0, "타일_크기": 16.0, "점프_높이_칸": 10.0, "점프_거리_칸": 15.0}

var _재질 := {}
var _성공 := 0


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== 집 3분할 원본 빌더 ===")
	for 종류 in ["기본", "거친암반", "덩어리", "기본_흰색", "거친암반_흰색", "덩어리_흰색"]:
		_재질[종류] = 공통.재질_준비(종류)
		if String(_재질[종류]).is_empty():
			push_error("재질 준비 실패: %s" % 종류)
			quit(1)
			return

	_거실()
	_굴뚝()
	_지붕()

	print("---")
	print("[집] %d / 3 저장 성공" % _성공)
	print("이어서: godot --headless --path . -s res://tools/스마트월드_체인.gd -- --만 5,6,7")
	quit(0 if _성공 == 3 else 1)


# ============================================================================
# 공통 뼈대
# ============================================================================
## 스테이지 루트 한 벌(월드 + 페인트코어 + 실내배경 + 어둠 + 지형층 + 오브젝트층).
## 챕터 팔레트를 그대로 쓴다 — 집도 챕터 1 이라 숲과 같은 명도 대역에 있어야
## 통로를 지나 숲으로 나왔을 때 눈이 안 놀란다.
func _뼈대(이름: String, 리밋: Rect2, 시작: Vector2, 낙사y: float,
		아래방: int, 위방: int, 전환시작y: float, 전환끝y: float) -> Node2D:
	var 루트: Node2D = 월드_S.new()
	루트.name = 이름
	루트.set("스테이지_이름", 이름)
	루트.set("카메라_줌", 0.82)
	루트.set("시작_위치", 시작)
	루트.set("낙사_y", 낙사y)
	루트.set("카메라_리밋", 리밋)

	# 페인트 규칙 엔진 — 지형보다 먼저 트리에 들어가야 한다(지형이 _ready 에서 찾는다).
	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)      # true = 씬 파일에 그룹이 저장된다
	루트.add_child(코어)

	# 실내 배경 — 세로로 섞이는 배경. 바깥 풍경(stage_backdrop)은 쓰지 않는다(집 안이다).
	var 배경: Node2D = 실내배경_S.new()
	배경.name = "실내배경"
	배경.set("영역", Rect2(리밋.position - Vector2(600, 500), 리밋.size + Vector2(1200, 1000)))
	배경.set("아래_방", 아래방)
	배경.set("위_방", 위방)
	배경.set("전환_시작y", 전환시작y)
	배경.set("전환_끝y", 전환끝y)
	루트.add_child(배경)

	# 전체 톤 — ESC 메뉴 밝기 슬라이더의 100% 기준값이 이 색이다.
	var 팔: Dictionary = 챕터_S.팔레트(1)
	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	어둠.color = 팔["어둠"]
	루트.add_child(어둠)

	var 지형층 := Node2D.new()
	지형층.name = "지형"
	루트.add_child(지형층)

	var 오브젝트층 := Node2D.new()
	오브젝트층.name = "오브젝트"
	루트.add_child(오브젝트층)
	return 루트


## 지형 하나 붙이기. 전부 "칠할 수 있고 / 유령이 아닌" 단단한 지형이다.
func _지형(루트: Node2D, 이름: String, 위치: Vector2, 점들: PackedVector2Array,
		재질: String = "기본") -> void:
	var 층 := 루트.get_node("지형")
	층.add_child(공통.지형_노드(이름, 위치, 점들, _재질[재질], true, false, 0, 16.0))


## 선반(발판) 하나. **`윗면` 은 밟는 면의 y 다** (노드 중심이 아니다).
##
## ★[2026-08-19] 예전에는 노드 **중심 y** 를 받았다. 그래서 두께를 32 → 16 으로 바꾸는
##   순간 모든 선반의 윗면이 8px 씩 내려가 단차 계산이 통째로 어긋났다.
##   레벨 수치는 전부 "밟는 면" 기준으로 이야기하는데 함수만 중심을 받으니
##   부르는 쪽에서 매번 `+ 두께/2` 를 하다가 한 군데를 빠뜨렸다.
##   → **함수가 윗면을 받게 바꿨다.** 이러면 두께를 바꿔도 레벨이 안 흔들린다.
func _선반(루트: Node2D, 이름: String, x: float, 윗면: float, 길이: float, 방향: float,
		재질: String = "기본") -> void:
	_지형(루트, 이름, Vector2(x, 윗면 + 선반두께 * 0.5),
		공통.선반_점들(길이, 선반두께, 방향), 재질)


## 플레이어를 붙이고 레벨이 전제하는 점프 튜닝을 박는다.
## ⚠ 인스턴스 안쪽으로 owner 를 내리지 않는다(§주인_지정 주석의 2026-08-02 치명 버그).
func _플레이어(루트: Node2D, 위치: Vector2) -> void:
	var p := (load(PLAYER) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 위치
	for k in 튜닝:
		p.set(k, 튜닝[k])
	루트.add_child(p)


func _저장(루트: Node2D, 파일: String) -> void:
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var err := 팩.pack(루트)
	if err != OK:
		push_error("  pack 실패: %s" % error_string(err))
		return
	var 경로 := 원본폴더 + 파일
	err = ResourceSaver.save(팩, 경로)
	if err == OK:
		_성공 += 1
	print("   저장 %s → %s" % [error_string(err), 경로])
	루트.queue_free()




# ============================================================================
# ★레벨 안전 수치 — `tools/레벨검사.gd` 는 여유를 빼고 본다
#   올라갈 수 있는 단차 = 점프 높이 160 × 0.80 = 128px
#   건널 수 있는 가로  = 점프 거리 240 × 0.85 = 204px
#   처음에 155px 로 깔았다가 "이론상 닿지만 실제로는 턱을 못 넘는" 자리가 되어
#   레벨검사가 굴뚝을 통째로 [불가] 로 잡았다. 아래 값으로 여유를 둔다.
# ============================================================================
const 단차: float = 120.0        ## 안전 세로 단차 (검사 한계 128 보다 8px 여유)
const 최대가로: float = 200.0    ## 안전 가로 건너기 (검사 한계 204 보다 4px 여유)


## ★[2026-08-19] 색을 지정하는 선반. 혼합안의 핵심 도구다.
##   검정 / 흰색 / 무색(칠해야 밟힘) 중 하나를 골라 놓는다.
##   ⚠ **무색은 레이어 8(유령)** 이라 물감으로 칠하기 전에는 몸이 통과한다.
##     즉 놓는 순간 "물감이 있어야 지나갈 수 있는 자리" 가 된다 — 레벨검사를 꼭 다시 돌릴 것.
func _선반색(루트: Node2D, 이름: String, x: float, 윗면: float, 길이: float,
		색: int, 방향: float = 1.0, 바탕: String = "기본") -> void:
	var 정보 := _재질과유령(색, 바탕)
	var 층 := 루트.get_node("지형")
	층.add_child(공통.지형_노드(이름, Vector2(x, 윗면 + 선반두께 * 0.5),
		공통.선반_점들(길이, 선반두께, 방향), _재질[String(정보[0])],
