	루트.set("카메라_줌", 1.00)
	루트.set("시작_위치", 시작)
	## 가장 낮은 바닥 아랫면보다 아래. 구덩이에 빠지면 여기서 잡는다.
	루트.set("낙사_y", _바닥_아랫 + 520.0)
	루트.set("치명_낙하거리", 520.0)

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)
	루트.add_child(코어)

	var 지 := Node2D.new()
	지.name = "지형"
	루트.add_child(지)

	var 관 := Node2D.new()
	관.name = "SS2D 배관"      # 2-3~2-7 과 같은 이름
	루트.add_child(관)

	var 장 := Node2D.new()
	장.name = "장치"
	루트.add_child(장)

	var 위 := Node2D.new()
	위.name = "위험물"
	루트.add_child(위)

	_뼈대(지)
	_유령들(지)
	var 물들 := _물줄기들(장)
	_배관들(관, 물들)
	_가시들(위)

	# 관문 5 출구 선반 위. `tools/하수도_주행검사.gd` 가 "끝까지 갔는가" 를 이걸로 본다.
	var 끝점 := Marker2D.new()
	끝점.name = "끝도달_검사점"
	끝점.position = Vector2(8300.0, _바닥y(8000.0) - 단 * 3.0)
	루트.add_child(끝점)

	var p := (load(S_플레이어) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 시작
	루트.add_child(p)
	return 루트


# ============================================================================
# 뼈대 — 바닥 · 천장 · 끝벽
# ============================================================================
## ★색이 바뀌거나 **높이가 바뀌는 자리마다** 지형을 끊는다.
##   색을 끊는 이유는 `시작상태` 가 노드당 하나뿐이라서이고(회색 전환 띠를 못 만든다),
##   높이를 끊는 이유는 축 정렬 사각형만 쓰기 때문이다(README §20 — 사선 금지).
func _뼈대(지: Node2D) -> void:
	# ── 바닥 ──────────────────────────────────────────────────────────────
	## [x0, x1, 색, 윗면, 이름] — 겹침을 계산해야 하므로 목록을 먼저 만든다.
	var 바닥들 := []
	for i in 구간표.size():
		var c: Array = 구간표[i]
		바닥들.append([c[0], c[1], c[2], _높이[i], "SS_CEM_FLOOR_%02d" % (i + 1)])
	_겹치기(바닥들, _바닥_아랫)
	for b in 바닥들:
		# 윗면은 구간마다 다르고 아랫면은 전부 같다(공중에 뜨는 조각이 없게).
		_지형(지, _템플릿(b[2]), b[4], _사각(b[0], b[3], b[1], _바닥_아랫), true, b[2])

	# ── 천장 ──────────────────────────────────────────────────────────────
	## 바닥을 따라다닌다. 그래야 굴곡을 넣어도 바닥과 천장이 한 화면에 들어온다.
	## 구덩이 위(바닥이 없는 구간)는 구간표가 못 덮으므로 목록에 직접 끼워 넣는다.
	var 천장들 := []
	for i in 구간표.size():
		var c: Array = 구간표[i]
		if c[0] == 구덩이_x1:
			천장들.append([구덩이_x0, 구덩이_x1, 흰색, _천장y(구덩이_x1 + 1.0), "SS_WALL_CEIL_PIT"])
		천장들.append([c[0], c[1], c[2], _천장y(c[0] + 1.0), "SS_WALL_CEIL_%02d" % (i + 1)])
	_겹치기(천장들, 천장_윗)
	for t in 천장들:
		_지형(지, _벽템플릿(t[2]), t[4], _사각(t[0], 천장_윗, t[1], t[3]), true, t[2])

	# 끝벽 — 통로를 닫는다. 양 끝 구간과 같은 색(검정)이라야 스쳐도 안 죽는다.
	_지형(지, T_벽_검, "SS_WALL_END_L",
		_사각(좌끝, 천장_윗, 300.0, _바닥_아랫), true, 검정)
	_지형(지, _벽템플릿(흰색), "SS_WALL_END_R",
		_사각(8500.0, 천장_윗, 우끝, _바닥_아랫), true, 흰색)

	# 관문 5 출구 선반 — 유령 D 에서 오름 단차 120 으로 올라선다(사다리의 셋째 칸).
	# ★왼끝을 D 오른끝(8,160)에 **붙인다.** 전에는 8,200 에서 시작해 바닥에 32px
	#   짜리 주머니가 생겼고, 거기 떨어지면 양옆이 벽이라 못 나왔다(레벨검사 소프트락).
	_지형(지, _벽템플릿(흰색), "SS_WALL_EXIT_5",
		_사각(8160.0, _바닥y(8000.0) - 단 * 3.0, 8500.0, _바닥_아랫), true, 흰색)


## ★★[2026-09-05] 이웃한 조각 사이의 **32px 슬롯**을 없앤다.
##
## ▣ 무엇이 문제였나
##   SS2D 는 `collision_size`(24) 만큼 콜리전을 **안쪽으로 깎는다.** 그래서 x 를 딱
##   맞춰 두면 조각 경계마다 폭 ~32 짜리 틈이 생기고, 조각들이 전부 `바닥_아랫`(1,480)
##   까지 내려가 있으니 그 틈은 **깊이 500 짜리 세로 슬롯**이 된다.
##   바닥이 평지일 때는 선반이 하나로 합쳐져 안 보였는데, 굴곡을 넣자마자
##   레벨검사가 계단마다 "낙차 밑이 없음" 으로 19 곳을 잡아냈다.
##   플레이어 폭이 44 라 빠지지는 않지만, 턱에 붙어 걸을 때 걸리적거린다.
##
## ▣ 어떻게 없애나 — **짧은 쪽을 긴 쪽 밑으로 밀어 넣는다**
##   두 조각은 한쪽 면(`공통면`: 바닥은 아랫면, 천장은 윗면)을 공유한다.
##   그 면에서 덜 뻗은 쪽이 **짧은 쪽**이고, 그쪽을 48 만큼 늘리면 겹친 부분이
##   긴 쪽 안에 통째로 묻혀 **화면에는 아무 변화가 없다.**
##   (반대로 긴 쪽을 늘리면 낮은 바닥 위로 턱이 삐져나온다)
##   구덩이처럼 원래 떨어져 있는 경계는 건드리지 않는다 — 늘리면 구덩이가 메워진다.
func _겹치기(목록: Array, 공통면: float) -> void:
	var 원래 := []
	for m in 목록:
		원래.append([m[0], m[1]])
	for i in range(목록.size() - 1):
		if not is_equal_approx(원래[i][1], 원래[i + 1][0]):
			continue                                  # 구덩이 — 붙어 있지 않다
		var 내길이: float = absf(목록[i][3] - 공통면)
		var 옆길이: float = absf(목록[i + 1][3] - 공통면)
		if 내길이 <= 옆길이:
			목록[i][1] = 원래[i][1] + 겹침
		else:
			목록[i + 1][0] = 원래[i + 1][0] - 겹침
	# 양 끝은 끝벽 속으로 밀어 넣는다. 끝벽은 천장부터 바닥까지 꽉 찬 조각이라
	# 무엇을 넣어도 가려진다.
	목록[0][0] = 원래[0][0] - 겹침
	목록[목록.size() - 1][1] = 원래[원래.size() - 1][1] + 겹침


## ★유령 발판 — 무색으로 태어나 **통과**된다. 칠해야 밟히는 발판이 된다.
##   관문 4 는 흰 물이 스치므로 **흰색으로** 칠해야 남고,
##   관문 5 는 물이 안 닿으므로 검정으로 칠하면 된다.
func _유령들(지: Node2D) -> void:
	for g in 유령발판:
		var 윗면 := _발판_윗면(g)
		var n := _지형(지, T_시_검, g[6],
			_사각(g[0], 윗면, g[0] + g[1], 윗면 + g[2]), true, 무색, true)
		if n != null:
			n.set("필요횟수_수동", g[5])


## 발판 윗면 = 기준 바닥에서 `올림칸 × 단` 위.
func _발판_윗면(g: Array) -> float:
	return _바닥y(g[3]) - float(g[4]) * 단


# ============================================================================
# 장치 — 물줄기 · 배관 · 가시
# ============================================================================
func _물줄기들(장: Node2D) -> Dictionary:
	var 씬 := load(S_유체) as PackedScene
	var 만든것 := {}
	for f in 물줄기:
		var 윗면 := _천장y(f[1])
		var 아랫면 := _물_아랫면(f)
		# ★★ `instantiate()` 기본값(GEN_EDIT_STATE_DISABLED)은 **인스턴스 상태를 안 들고 온다.**
		#   그러면 pack() 이 저장 여부를 **스크립트 기본값**과 비교해서 정한다.
		#   `유체.gd` 의 기본색이 **흰색**이라, 흰 물을 넣으면 "기본값과 같다"고
		#   보고 씬에 안 적는다 → 로드할 때 `유체.tscn` 에 저장된 **회색**으로 되돌아간다.
		#   (실제로 F4·F6·F7·F8 네 줄기가 전부 회색으로 구워졌다)
		#   GEN_EDIT_STATE_INSTANCE 를 주면 에디터가 꽂을 때와 같이 **씬의 값**과 비교한다.
		var 물: Node2D = 씬.instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
		물.name = f[0]
		물.position = Vector2(f[1], 윗면)
		물.set("색", f[2])
		물.set("크기", Vector2(64.0, maxf(아랫면 - 윗면, 64.0)))
		물.set("켜짐", true)
		장.add_child(물)
		만든것[f[0]] = 물
	return 만든것


## 물줄기가 어디서 멈추는가. 셋 다 **생성된 바닥 높이에서 파생**된다.
func _물_아랫면(f: Array) -> float:
	match String(f[3]):
		"발판":
			for g in 유령발판:
				if f[1] > g[0] and f[1] < g[0] + g[1]:
					return _발판_윗면(g)
			return _바닥y(f[1])
		"통로":
			# 물기둥 아래로 걸어 지나갈 틈을 남긴다. 이게 관문 5 의 해법이다.
			return _바닥y(f[1]) - 물_아래_통로
		_:
			return _바닥y(f[1])


## 물이 **어디서 오는지** 화면에 보이게 한다(제작계획 §9 체크리스트).
## 물줄기마다 천장에 세로 배관 토막을 하나씩 꽂는다.
##
## ★[2026-09-07] 옛 `배관.tscn` → **SS2D 배관 템플릿**으로 갈아탔다 (성진님 지시).
##
## ▣ 원점이 다르다 — 여기가 유일한 함정이다
##   옛 배관 : `position` 이 **한가운데**. 세로 220 이면 위아래로 110 씩 뻗었다.
##   SS2D    : 점 배열이 (0,0)~(896,0) 이라 `position` 이 **한쪽 끝**이고 앞으로만 뻗는다.
##   → 같은 자리에 놓으려면 y 를 **길이의 절반만큼 위로** 올려야 한다. 안 그러면
##     배관이 통째로 110px 내려와 물줄기 중간에서 시작하는 그림이 된다.
##
## ▣ 길이·방향을 어떻게 주나
##   길이  = `scale.x = 길이 / 896`   (점 사이 거리가 896 이라서)
##   세로  = `rotation = PI/2`        (+x 축을 아래로 돌린다)
##   굵기는 재질(`배관_회색v1_경로.tres`)의 `texture_scale` 이 정한다 — 노드에서 못 바꾼다.
##
## ⚠ `연결_유체` 는 없어졌다. SS2D 배관은 **흐르는 물 색을 따라가지 않는다**(고정 회색).
##   2-1 의 관문 5 는 "관 색이 답" 이 아니라 **물줄기 아래 통로**가 답이고
##   (`_물_아랫면()` 의 "통로"), 물줄기 자체가 색을 그대로 보여 준다 —
##   그래서 관 색은 거들기였을 뿐 해법의 유일한 단서가 아니었다.
func _배관들(관: Node2D, _물들: Dictionary) -> void:
	var 씬 := load(S_배관) as PackedScene
	const 배관_길이 := 220.0
	const 템플릿_점간격 := 896.0      # TEMPLATE_PIPE_OPEN_GRAY 의 점 배열 (0,0)~(896,0)
	for f in 물줄기:
		var 배관: Node2D = 씬.instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
		배관.name = "SS_PIPE_%s" % f[0]
		# 옛 배관의 한가운데(_천장y - 80)와 같은 자리를 덮도록 **윗끝**을 잡는다.
		배관.position = Vector2(f[1], _천장y(f[1]) - 80.0 - 배관_길이 * 0.5)
		배관.rotation = PI * 0.5
		배관.scale = Vector2(배관_길이 / 템플릿_점간격, 1.0)
		관.add_child(배관)


## 관문 3 · 흰 구간의 가시 3칸(96px). 점프 거리 160 안이라 반드시 넘을 수 있다.
## ⚠ 가시는 색 규칙 밖이다 — 무슨 색이든 죽인다.
func _가시들(위: Node2D) -> void:
	var 씬 := load(S_가시) as PackedScene
	var 가시: Node2D = 씬.instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
	가시.name = "가시_관문3"
	가시.position = Vector2(가시_x, _바닥y(가시_x))
	가시.set("칸수", 3)
	가시.set("방향", 0)              # 위
	위.add_child(가시)


# ============================================================================
# 구간표 조회
# ============================================================================
## 그 x 자리의 바닥 윗면. 구덩이 위면 착지 바닥을 준다.
func _바닥y(x: float) -> float:
	for i in 구간표.size():
		if x >= 구간표[i][0] and x < 구간표[i][1]:
			return _높이[i]
	if x >= 구덩이_x0 and x < 구덩이_x1:
		return _바닥y(구덩이_x1 + 1.0)
	return 기준높이


## 그 x 자리의 천장 아랫면.
func _천장y(x: float) -> float:
	for i in 구간표.size():
		if x >= 구간표[i][0] and x < 구간표[i][1]:
			return _높이[i] - (챔버_높이 if 구간표[i][3] else 통로_높이)
	if x >= 구덩이_x0 and x < 구덩이_x1:
		return _천장y(구덩이_x1 + 1.0)
	return 기준높이 - 통로_높이


# ============================================================================
# 지형 만들기 — Template 을 인스턴스해서 점 배열과 콜리전만 갈아 끼운다
# ============================================================================
## `build_스테이지_1_2층방.gd` 의 `_지형()` 과 같은 방식이다. 다른 것은 하나뿐 —
## **`시작상태` 를 받는다.** 하수도는 구간마다 태어나는 색이 달라야 하기 때문이다.
##
## 재질 · texture_scale · 코너 · collision_size 는 Template 이 갖고 있다. 손대지 않는다.
func _지형(층: Node2D, 템플릿: String, 이름: String, 월드점들: PackedVector2Array,
		칠가능: bool, 시작: int, 유령: bool = false) -> Node2D:
	var 씬 := load(템플릿) as PackedScene
	if 씬 == null:
		push_error("2-1: Template 을 못 읽었다 — %s" % 템플릿)
		return null
	var 지형: Node2D = _모양노드(씬.instantiate())
	지형.name = 이름

	var 최소 := 월드점들[0]
	var 최대 := 월드점들[0]
	for p in 월드점들:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	var 중심 := (최소 + 최대) * 0.5
	지형.position = 중심

	지형.set("칠하기_허용", 칠가능)
	지형.set("무색일때_통과", 유령)
	지형.set("시작상태", 시작)
	## 칠할 수 있는 지형은 **자리별 판정**도 같이 켠다. 안 켜면 노드 하나가 통째로
	## 한 색이라, 눈앞에 흰 얼룩이 크게 찍혀 있어도 판정은 "무색 = 안전" 이라고 답한다.
	지형.set("위치별_판정", 칠가능)

	var 점배열 := SS2D_Point_Array.new()
	var 로컬 := PackedVector2Array()
	for p in 월드점들:
		로컬.append(p - 중심)
	점배열.add_points(로컬)
	점배열.close_shape()               # ★닫혀야 FILL 메시가 생긴다
	지형.set_point_array(점배열)

	var 폴리 := 지형.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	if 폴리 != null:
		var 생성기 := SS2D_CollisionGen.new()
		생성기.collision_size = 지형.collision_size
		생성기.collision_offset = 지형.collision_offset
		var 구운것 := 생성기.generate_filled(점배열.get_tessellated_points())
		if 구운것.size() < 3:
			push_warning("2-1(%s): 콜리전 오프셋 실패 → 원본 점을 그대로 쓴다" % 이름)
			구운것 = 점배열.get_tessellated_points()
		폴리.polygon = 구운것

	층.add_child(지형)
	return 지형


## Template 루트가 SS2D 가 아닌 경우 껍데기를 벗겨 안쪽 SS2D 를 꺼낸다.
func _모양노드(인스턴스: Node2D) -> Node2D:
	if 인스턴스.has_method("get_point_array"):
		return 인스턴스
	for 자식 in 인스턴스.get_children():
		if 자식 is Node2D and 자식.has_method("get_point_array"):
			var 모양: Node2D = 자식
			인스턴스.remove_child(모양)
			모양.owner = null
			인스턴스.queue_free()
			return 모양
	push_error("2-1: Template 안에서 SS2D 지형 노드를 못 찾았다")
	return 인스턴스


## 흰 구간은 **흰색 Template** 을 쓴다. 검정판에 `시작상태 = 흰색` 만 주면
## 에디터 화면에서는 검게 보여(칠하는 셰이더가 실행 중에만 돈다) 배치하다 반드시 헷갈린다.
## 회색은 짝이 되는 Template 이 없어 검정판 + `시작상태 = 회색` 으로 둔다.
func _템플릿(색: int) -> String:
	return T_시_흰 if 색 == 흰색 else T_시_검


func _벽템플릿(색: int) -> String:
	return T_벽_흰 if 색 == 흰색 else T_벽_검


## 축 정렬 사각형 (왼, 윗면, 오른, 아랫면) — 시계 방향.
func _사각(x0: float, y0: float, x1: float, y1: float) -> PackedVector2Array:
	return PackedVector2Array([
		Vector2(x0, y0), Vector2(x1, y0), Vector2(x1, y1), Vector2(x0, y1),
	])
