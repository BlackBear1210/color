	# ══════════════════════════════════════════════════════════════════════
	# 격자(통과플랫폼 · 일방통행) — 바닥 768 → G0 688 → G1 608 → G2 512 → G3 416 → 선반 416(240 틈)
	#   ★간격은 **색 판정 사각형** 기준이다(실제 몸 모양이 아니다): 플레이어 중심 기준 x −18~+26 · 키 97 · 여유 3
	#     → 판정 폭은 x−21~x+29. 이 사각형이 반대색 격자·바닥에 걸리면 죽는다(주행검사로 확인 2026-10-03).
	#   · G0(추가)는 **흰 G2 밑을 피해** 왼쪽(1488~1584)에 둔다 — G2 밑에서 뛰면 검정 몸이 흰 격자를 밑에서 뚫고 올라가 죽는다.
	#   · 흰 G2(1712~1808)는 검정 G1(~1664)·G3(~1632)와 48·80 띄운다: 도면대로 16px 이면 G1 오른끝에 서 있기만 해도
	#     판정 사각형 윗부분(서 있는 발 −100)이 흰 격자(두께 20)에 걸린다. 선반 옆면(1872)과는 64 —
	#     선반 왼끝에서 떨어지는 검정 몸(왼쪽 −21)이 흰 G2 를 스치지 않는다.
	# ══════════════════════════════════════════════════════════════════════
	_격자(장, "G0_검정격자_추가", 1536, 688, 96, 격자_검)    # ★도면에 없던 한 장 — 바닥→G1 160 이 점프 한계와 같아서
	_격자(장, "G1_검정격자", 1592, 608, 144, 격자_검)        # 1520~1664
	_격자(장, "G2_흰격자", 1760, 512, 96, 격자_흰)           # 1712~1808
	_격자(장, "G3_검정격자", 1576, 416, 112, 격자_검)        # 1520~1632 · 선반까지 240 틈

	# ══════════════════════════════════════════════════════════════════════
	# 흰 웅덩이 — 홈과 같은 사다리꼴(윗변 3488~3840 · 바닥 1456 · 수심 32(2-9 기준) · 양쪽 경사 32)
	# ══════════════════════════════════════════════════════════════════════
	var 웅 := (load(공.S_웅덩이) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	웅.name = "웅덩이_흰_통로밑"
	웅.set_script(load(G_웅덩이))
	웅.position = Vector2(3664, 1456)
	웅.set("크기", Vector2(352, 32))
	웅.set("색", 공.물_흰)
	웅.set("낙하_받아줌", true)
	웅.set("받아주는_최소수심", 32.0)
	웅.set("오른쪽_안쪽폭", 32.0)
	웅.set("왼쪽_안쪽폭", 32.0)      # 2026-10-03 새 손잡이 — 왼쪽도 경사
	장.add_child(웅)

	# ══════════════════════════════════════════════════════════════════════
	# 가시 구덩이 위 공중 발판 — 검 · 흰 · 검 · 흰 (도면 칸 그대로 · 윗면 1424 · 두께 48)
	# ══════════════════════════════════════════════════════════════════════
	_공중발판(지, "P1_검정발판", 4608, 1424, 4752, 검)
	_공중발판(지, "P2_흰발판", 4848, 1424, 4976, 흰)
	_공중발판(지, "P3_검정발판", 5056, 1424, 5184, 검)
	_공중발판(지, "P4_흰발판", 5280, 1424, 5392, 흰)

	# ── 위험물 (가시 한 칸 = 32) ──
	b.가시(위, "가시_윗길홈", 2864, 448, 7)        # 224 홈 · 1칸 깊이
	b.가시(위, "가시_구덩이", 4976, 1872, 34)      # 1,088 구덩이 바닥

	# ── 체크포인트 (도면 2 곳 + 시작) ──
	b.체크포인트(체, "CP_시작", Vector2(864, 768))
	b.체크포인트(체, "CP1_윗길턱", Vector2(3040, 416))
	b.체크포인트(체, "CP2_큰방", Vector2(3920, 1424))

	# ── 통로 · 플레이어 · 끝 ──
	b.입구(루트, Vector2(768, 768))
	b.출구(루트, Vector2(6208, 1456), 다음씬)
	b.끝점(루트, Vector2(6224, 1456))
	b.플레이어(루트, Vector2(560, 768))
	var 효과 := (load(S_화면효과) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
	효과.name = "하수도화면효과"
	루트.add_child(효과)
	return 루트


# ============================================================================
# 이 스테이지 전용 헬퍼 — 공통 빌더 위에 2-9 기준 외관을 얹는다
# ============================================================================
## 기본지형 + 2-9 명도 조율. 지금 하수도 씬들의 땅 조각은 전부 이 두 값을 켜 두었다.
func _땅(이름: String, 점들: PackedVector2Array, 색: int, 역할: String = "플랫폼") -> Node2D:
	var n: Node2D = b.지형(지형부모, 이름, 점들, 색, 역할)
	if n != null:
		n.set("시안_명도조율", true)
		n.set("앞지형_깊이", true)
	return n


## 떨어지는 물. ★스크립트를 먼저 바꾼다 — set_script 는 그 전에 넣은 값을 지운다.
func _물(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int, 켜짐: bool = true) -> Node2D:
	var f := (load(공.S_유체) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	f.name = 이름
	f.set_script(load(G_물))
	f.position = Vector2(x, 윗끝)
	f.set("종류", 0)
	f.set("색", 색)
	f.set("크기", Vector2(폭, 높이))
	f.set("켜짐", 켜짐)
	부모.add_child(f)
	return f


## 천장 속에서 내려오는 짧은 급수관 + 물. 관은 지형 뒤(z −1)라 출구 플랜지만 보인다.
func _물_관(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int) -> Node2D:
	var f := _물(부모, 이름, x, 윗끝, 폭, 높이, 색)
	_관(부모, "관_" + 이름, [[x, 윗끝 - 128], [x, 윗끝]], null, f)
	return f


## 주철 배관. 시작/끝 장치를 주면 그 포트에 스스로 붙는다(하수도_주철배관.gd).
func _관(부모: Node, 이름: String, 점들: Array, 시작: Node, 끝: Node) -> Node2D:
	var p := Node2D.new()
	p.name = 이름
	p.z_index = -1
	p.set_script(load(G_배관))
	var 경로 := PackedVector2Array()
	for v in 점들:
		경로.append(Vector2(float(v[0]), float(v[1])))
	p.set("점들", 경로)
	부모.add_child(p)
	if 시작 != null:
		p.set("시작_장치", p.get_path_to(시작))
	if 끝 != null:
		p.set("끝_장치", p.get_path_to(끝))
	return p


## 격자(통과플랫폼). 고정색 = 흑/백 · 칠할 수 없다 · 일방통행.
func _격자(부모: Node, 이름: String, x: float, 윗면: float, 폭: float, 색: int) -> Node2D:
	var g: Node2D = b.통과플랫폼(부모, 이름, x, 윗면, 폭, 1)
	g.set("고정색", 색)
	return g


## 기본지형 공중발판(2026-09-30 표준 · 교체_하수도_주철배관_공중발판.py 와 같은 7 점 모따기 사각형).
##   원점 = 왼위. 구덩이 위 발판이라 일방통행이 필요 없다(밑에서 뛰어오를 일이 없다) → 프리팹 충돌 그대로.
func _공중발판(부모: Node, 이름: String, x0: float, 윗면: float, x1: float, 색: int) -> Node2D:
	var n := (load(T_발판_흰 if 색 == 흰 else T_발판_검) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	n.name = 이름
	n.position = Vector2(x0, 윗면)
	var w := x1 - x0
	var 로컬 := PackedVector2Array([Vector2(4, 0), Vector2(w - 4, 0), Vector2(w, 4), Vector2(w, 48), Vector2(0, 48), Vector2(0, 5)])
	var 점배열 := SS2D_Point_Array.new()
	점배열.add_points(로컬)
	점배열.close_shape()
	n.set_point_array(점배열)
	# 저장된 충돌도 점과 같게(프리팹 기본은 192×64). 실행 중에도 SS2D 가 다시 만들지만 저장값을 맞춰 둔다.
	var 폴리 := n.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	if 폴리 != null:
		폴리.polygon = 로컬
		b._덮어쓸_노드들.append(폴리)
	n.set_meta("terrain_style", "공중")
	n.set_meta("role", "플랫폼")
	부모.add_child(n)
	return n
