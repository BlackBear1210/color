const 공 := preload("res://tools/하수도_빌더_공통.gd")
const 내씬 := "res://scenes/world_2_클로드/stage_2-1.tscn"
const 다음씬 := "res://scenes/world_2_클로드/stage_2-2.tscn"

const 검 := 공.검정
const 흰 := 공.흰색

const 프레임 := Rect2(0, 0, 9664, 2560)

var b: RefCounted


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 2-1 · 물이 흐르는 곳 v2 (하강 수로 · 3 방) ===")
	b = 공.new()
	var 루트 := _짓기()
	var ok: bool = b.검산(프레임, _빈공간들())
	b.색비율_보고()
	if not ok or b.오류 > 0:
		push_error("2-1: 검산 실패 %d — 저장하지 않는다" % b.오류)
		quit(1)
		return
	if not b.저장(루트, 내씬):
		quit(1)
		return
	print("=== 끝 ===\n")
	quit(0)


## 일부러 비운 자리. 검산이 "여기는 지형이 없어도 된다" 로 본다.
func _빈공간들() -> Array:
	return [
		Rect2(224, 192, 3840 - 224, 1024 - 192),     # 방 A (갤러리 통로 포함)
		Rect2(224, 720, 768 - 224, 1120 - 720),      # 입구 통로 (연결통로가 스스로 짓는다)
		Rect2(3840, 192, 384, 1536 - 192),           # 하강 샤프트 + 착지 웅덩이 구덩이
		Rect2(3840, 384, 6144 - 3840, 1408 - 384),   # 방 B
		Rect2(4816, 1408, 496, 1920 - 1408),         # 구덩이 1 (검정 물)
		Rect2(5504, 1408, 128, 1728 - 1408),         # 슬롯 B (색 전환)
		Rect2(6144, 1024, 9664 - 6144, 1792 - 1024), # 방 C (램프 위 포함)
		Rect2(7104, 1792, 192, 1856 - 1792),         # 가시 구덩이
		Rect2(7552, 1792, 128, 2112 - 1792),         # 슬롯 C1
		Rect2(8064, 1792, 128, 2112 - 1792),         # 슬롯 C2
		Rect2(8448, 1792, 448, 2176 - 1792),         # 구덩이 3 (검정 웅덩이)
		Rect2(8992, 1488, 9536 - 8992, 1888 - 1488), # 출구 통로
	]


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("stage_2-1", "2-1 · 물이 흐르는 곳",
		프레임, Vector2(560, 1024), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	# ── 외곽 ───────────────────────────────────────────────────────────────
	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 방 A — 관찰 · 첫 갈림길 (x 224~3840 · 바닥 1024)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "A_왼벽", 공.사각(0, 0, 224, 2560), 검, "플랫폼")
	# 천장은 갤러리 위에서 흰색으로 바뀐다. 경계(2464)는 L4 와 슬래브 사이 틈의 한가운데.
	# 검정 몸이 L4(512) 에서 뛰어도 머리는 256 까지라 천장(192)에 못 닿는다.
	b.지형(지, "A_천장_검", 공.사각(224, 0, 2464, 192), 검, "채움")
	b.지형(지, "A_천장_흰", 공.사각(2464, 0, 4224, 192), 흰, "채움")
	# 바닥 + L1 턱 + 하부 복도 끝벽을 **한 폴리곤**으로. 입구 통로 자리(224~768 × 720~1120)는 비운다.
	# L1 턱(1616~1872 · 윗면 896)은 갈림길 사다리의 첫 칸이자 하부 복도로 가는 길의 작은 언덕.
	b.지형(지, "A_바닥", 공.다각([
		[768, 1024], [1616, 1024], [1616, 896], [1872, 896], [1872, 1024],
		[3136, 1024], [3136, 704], [3520, 704], [3520, 2560], [224, 2560], [224, 1120], [768, 1120],
	]), 검, "플랫폼")
	# 갈림길 사다리 — 검정 공중 발판 3 장 (같은 색이라 아래를 지나는 검정 몸에 위험하지 않다)
	#   L1(896) → L2(768) → L3(640) → L4(512)  각 128 오름 · 옆 틈 80~144
	b.지형(지, "A_L2", 공.사각(1952, 768, 2176, 880), 검)
	b.지형(지, "A_L3", 공.사각(1680, 640, 1872, 752), 검)
	b.지형(지, "A_L4_착지대", 공.사각(2016, 512, 2352, 640), 검)
	# 흰 갤러리 슬래브 — L4 에서 224 틈(공중 전환)을 건너 올라선다. 오른끝 3840 에서 샤프트로 떨어진다.
	# 밑면 704 = 하부 복도 천장. 검정 몸(96) + 점프(160) = 256 < 320 이라 흰 밑면에 못 닿는다.
	b.지형(지, "A_갤러리_슬래브", 공.사각(2576, 512, 3840, 704), 흰)
	# 슬래브 밑 · 샤프트 왼벽 — 떨어지는 흰 몸이 스칠 수 있으므로 흰색.
	b.지형(지, "A_샤프트_왼벽", 공.사각(3520, 704, 3840, 1536), 흰)
	b.지형(지, "A_샤프트_왼벽_밑채움", 공.사각(3520, 1536, 3840, 2560), 검, "채움")

	# ══════════════════════════════════════════════════════════════════════
	# 방 B — 물이 되돌린다 · 마른 발판 고르기 (x 3840~6144 · 바닥 1408)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "B_천장_흰", 공.사각(4224, 0, 5568, 384), 흰, "채움")
	b.지형(지, "B_천장_검", 공.사각(5568, 0, 6144, 384), 검, "채움")
	# 착지 웅덩이 구덩이 바닥(흰) — 896 낙하를 흰 물이 받아 준다
	b.지형(지, "B_웅덩이_바닥", 공.사각(3840, 1536, 4224, 2560), 흰)
	b.지형(지, "B1_바닥", 공.사각(4224, 1408, 4816, 2560), 흰)
	# 구덩이 1 — 바닥에 검정 물. 흰 몸에게는 죽는 구덩이(보이는 위험). 바닥 자체는 안 밟는다.
	b.지형(지, "B_구덩이1_바닥", 공.사각(4816, 1920, 5312, 2560), 검, "채움")
	# G1 = 함정. 벽 배관에서 떨어지는 검정 물 밑에 있다 → 흰 페인트가 바로 지워지는 걸 보여 준다.
	# G2 = 마른 발판. 물 밖 · 바닥 높이 · 이걸 칠해 건넌다(2 발).
	b.유령(지, "B_G1_함정발판", 공.사각(4848, 1600, 5040, 1744), 흰)
	b.유령(지, "B_G2_마른발판", 공.사각(5008, 1408, 5200, 1552), 흰)
	b.지형(지, "B1_착지대", 공.사각(5312, 1408, 5504, 2560), 흰)
	b.지형(지, "B_슬롯_바닥", 공.사각(5504, 1728, 5632, 2560), 검, "채움")
	# B2 검정 바닥 + S1 턱(F1 선반으로 오르는 첫 칸)
	b.지형(지, "B2_바닥", 공.다각([
		[5632, 1408], [5856, 1408], [5856, 1280], [6048, 1280], [6048, 1408],
		[6144, 1408], [6144, 2560], [5632, 2560],
	]), 검)
	# F1 선반 — S1(1280) → S2 유령(1152 · 검정 2 발) → 선반(1024). 끝에 체크포인트 ⓐ.
	# 내려올 때는 선반 오른끝(6016)과 S2(6112) 사이 96 틈으로 **그냥 떨어진다**(왔던 길과 다른 길).
	# S1 을 슬롯 B 에서 224 떨어뜨린 이유: 슬롯을 뛰어넘은 몸이 320 포물선 끝(≈5,750)에서 턱 위에 내려앉았다.
	# 되돌아오며 S2 를 E 로 회수하면 탄약이 돌아온다 ⓓ.
	b.유령(지, "B_S2_유령칸", 공.사각(6112, 1152, 6240, 1264), 검)
	b.지형(지, "B_F1_선반", 공.사각(5792, 1024, 6016, 1136), 검)

	# ══════════════════════════════════════════════════════════════════════
	# 방 C — 짧은 수로 · 배운 두 규칙으로 건넌다 (x 6144~9664 · 바닥 1792)
	# ══════════════════════════════════════════════════════════════════════
	# 천장 덩어리 + 출구 위 채움 (한 폴리곤)
	b.지형(지, "C_천장", 공.다각([
		[6144, 0], [9664, 0], [9664, 1488], [8992, 1488], [8992, 1024], [6144, 1024],
	]), 검, "채움")
	# 램프(30°) + 착지 바닥 — 한 폴리곤
	b.지형(지, "C_램프_착지", 공.다각([
		[6144, 1408], [6816, 1792], [7104, 1792], [7104, 2560], [6144, 2560],
	]), 검)
	b.지형(지, "C_가시구덩이_바닥", 공.사각(7104, 1856, 7296, 2560), 검, "채움")
	b.지형(지, "C1_바닥", 공.사각(7296, 1792, 7552, 2560), 검)
	b.지형(지, "C_슬롯1_바닥", 공.사각(7552, 2112, 7680, 2560), 검, "채움")
	b.지형(지, "C2_바닥", 공.사각(7680, 1792, 8064, 2560), 흰)
	b.지형(지, "C_슬롯2_바닥", 공.사각(8064, 2112, 8192, 2560), 검, "채움")
	# C3 — 구덩이 3 의 왼벽은 계단(96 × 128) 이라 물에 빠져도 되돌아 올라온다.
	# 오른벽은 수직이라 **G3 를 칠하지 않으면 못 건넌다.** 출구 앞 바닥까지 한 폴리곤.
	# 슬롯 C2 뒤 착지 바닥은 256 — 128 이면 320 포물선이 구덩이 계단까지 날아간다(주행검사에서 실제로 났다).
	b.지형(지, "C3_바닥", 공.다각([
		[8192, 1792], [8448, 1792], [8448, 1920], [8544, 1920], [8544, 2048], [8640, 2048],
		[8640, 2176], [8896, 2176], [8896, 1792], [8992, 1792], [8992, 1888], [9664, 1888],
		[9664, 2560], [8192, 2560],
	]), 검)
	# G3 — 검정 물줄기 아래 유령 발판. 검정 페인트는 검정 물이 안 지운다(같은 색 물 규칙).
	# 왼끝 8672 = 구덩이 왼턱(8448)에서 **꽉 찬 점프(320)의 착지점** 근처. 더 가까우면 넘어가 버린다.
	# 오른끝은 건너편 바닥(8896)에 **딱 붙인다** — 32px 틈을 남겼더니 몸(44)이 끼어 걸어서 못 넘었다.
	b.유령(지, "C_G3_검정물_발판", 공.사각(8672, 1792, 8896, 1904), 검)
	b.지형(지, "C_출구_뒤채움", 공.사각(9536, 1488, 9664, 1888), 검, "채움")

	# ══════════════════════════════════════════════════════════════════════
	# 장치
	# ══════════════════════════════════════════════════════════════════════
	# ── 방 A 물 ──
	# W1 회색 · W2 검정 : "회색은 누구에게나 안전 · 같은 색은 통과" 를 걸어가며 확인
	b.배관(장, "관_W1", 공.다각([[224, 96], [1152, 96], [1152, 192]]))
	b.유체(장, "W1_회색물", 1152, 192, 64, 832, 공.물_회)
	b.배관(장, "관_W2", 공.다각([[1152, 128], [1536, 128], [1536, 192]]))
	b.유체(장, "W2_검정물", 1536, 192, 64, 832, 공.물_검)
	# W3 갤러리 검정 물 — 흰 갤러리를 막는다(처음엔 켜짐). 레버가 W3b(복도)로 돌린다.
	b.배관(장, "관_W3", 공.다각([[2464, 96], [2784, 96], [2784, 192]]))
	var w3: Node2D = b.유체(장, "W3_갤러리_물", 2784, 192, 64, 320, 공.물_검, true)
	b.배관(장, "관_W3b", 공.다각([[3136, 640], [2752, 640], [2752, 704]]))
	var w3b: Node2D = b.유체(장, "W3b_복도_물", 2752, 704, 64, 320, 공.물_검, false)
	# 직선 레버 = 갈래 A(갤러리) ↔ B(복도). 복도 끝(3136)에서 74px 안. 결과(갤러리 물 멈춤)가 같은 화면에 보인다.
	b.레버(장, "레버_수문", Vector2(3040, 1024), 1, w3, w3b)

	# ── 방 B 물 ──
	b.웅덩이(장, "B_착지_웅덩이", 4032, 1536, 384, 128, 공.물_흰)
	b.배관(장, "관_W4", 공.다각([[4704, 1520], [4912, 1520]]))
	b.유체(장, "W4_구덩이_검정물", 4912, 1520, 64, 272, 공.물_검)
	b.웅덩이(장, "B_구덩이_검정웅덩이", 5064, 1920, 496, 128, 공.물_검)

	# ── 방 C 물 ──
	b.배관(장, "관_W5", 공.다각([[6144, 960], [7936, 960], [7936, 1024]]))
	b.유체(장, "W5_흰물", 7936, 1024, 64, 768, 공.물_흰)
	b.배관(장, "관_W6", 공.다각([[8192, 928], [8736, 928], [8736, 1024]]))
	b.유체(장, "W6_검정물", 8736, 1024, 64, 896, 공.물_검)
	b.웅덩이(장, "C_구덩이_검정웅덩이", 8768, 2176, 256, 256, 공.물_검)

	# ── 위험물 ──
	b.가시(위, "가시_슬롯B", 5568, 1728, 4)
	b.가시(위, "가시_구덩이C", 7200, 1856, 6)      # 첫 가시 — 192 폭 · 낙사 없는 자리 · 그냥 뛰어넘는다
