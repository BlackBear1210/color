const 가시_x := 4760.0

var _높이 := PackedFloat32Array()   ## 구간별 바닥 윗면 y. `_실행()` 이 채운다
var _바닥_아랫 := 0.0               ## 바닥 블록의 공통 아랫면 (가장 낮은 바닥 + 260)


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 2-1 · 물이 흐르는 곳 (하수도 · SS2D) ===")

	# ── 바닥 높이를 먼저 뽑는다. 여기서 나온 값이 천장·발판·물길까지 전부 정한다 ──
	_높이 = 기복.굴곡(구간표.size(), 씨앗, {
		"기준": 기준높이, "단": 단,
		"위로": 1, "아래로": 1,      # 기준에서 ±1칸 = 980 · 1100 · 1220 세 높이
		"평지": 평지구간,
		"직진_최대": 2,              # 같은 높이 3연속을 금지한다 = 일자 맵 금지
		"머물_확률": 0.22,
	})
	var 문제 := 기복.검산(_높이, 단)
	if not 문제.is_empty():
		for m in 문제:
			push_error("기복 검산: %s" % m)
		quit(1)
		return

	var 가장낮은 := _높이[0]
	for h in _높이:
		가장낮은 = maxf(가장낮은, h)
	_바닥_아랫 = 가장낮은 + 260.0

	print("   씨앗 %d · 구간 %d · 리듬 %s" % [씨앗, 구간표.size(), 기복.리듬글(_높이, 단)])
	print("   바닥 높이 %s" % str(_높이))
	print("   가로 %.0f · 물줄기 %d · 유령 발판 %d" % [우끝 - 좌끝, 물줄기.size(), 유령발판.size()])

	var 루트 := _짓기()
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패: %s" % error_string(e))
		quit(1)
		return
	e = ResourceSaver.save(팩, 내씬)
	print("   %-24s %s" % [내씬.get_file(), error_string(e)])
	print("=== 끝 ===\n")
	quit(0 if e == OK else 1)


