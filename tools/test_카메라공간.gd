extends SceneTree
## ============================================================================
## [2026-08-17 도형 · 신규] 카메라 공간(굴뚝) 자동 검사
## ----------------------------------------------------------------------------
## 실행:
##   Godot --headless --path . -s res://tools/test_카메라공간.gd
##
## ▣ 무엇을 증명하나 — 도형님 요구사항 4 개를 그대로 코드로 옮겼다
##   ① "화면이 툭 끊기며 전환되는 것은 원하지 않음"
##        → 굴뚝에 들어간 **직후** 혼합값이 0 도 1 도 아닌 중간이어야 한다.
##          한 프레임에 1 이 되면 그게 컷(포탈)이다.
##   ② "카메라 이동 제한이 굴뚝의 좌우 벽에 딱 맞춰 좁혀져야 함"
##        → 굴뚝 안에서 플레이어를 좌우로 흔들어도 카메라 x 가 **1px 도** 안 움직인다.
##   ③ "굴뚝 입구에 들어서는 순간 부드럽게 줌인"
##        → 줌이 기준 줌 × 줌_배수 로 수렴한다.
##   ④ "굴뚝 출구를 빠져나오는 순간 다시 줌 아웃"
##        → 공간을 벗어나면 혼합이 0 으로 되돌아오고 줌도 기준값으로 복귀한다.
##
## ▣ ⚠ 헤드리스 주의 (기존 테스트들과 같은 함정)
##   `Engine.max_fps = 60` 고정 — 안 그러면 "몇 프레임 기다리기" 가 실제 시간과 어긋나
##   0.65 초짜리 트윈이 두 프레임에 끝나 버린다.
##
## ▣ ⚠ 월드/플레이어의 물리를 끄고 검사한다
##   플레이어를 굴뚝 안으로 **순간이동**시키는데, 월드가 살아 있으면
##   `낙하_감시` 가 그 이동을 800px 낙하로 읽고 즉사·리스폰시킨다.
##   그러면 플레이어가 공간 밖으로 나가 검사가 무의미해진다.
##   (2026-08-08 지뢰밭 §5-8 "테스트가 실패하면 코드부터 의심하지 말 것" 과 같은 함정)
##   → 카메라만 살려 두고 나머지 물리는 끈다. 카메라는 자기 `_physics_process` 로 돈다.
## ============================================================================

const 씬 := "res://scenes/스마트월드/스마트월드_4.tscn"

var _통과 := 0
var _실패 := 0
var _n := 0
## ★검사를 한 번만 돌리기 위한 자물쇠.
## `_검사()` 안에 await 가 있어서 _tick 이 곧바로 반환되는데, 그 사이에도
## process_frame 은 계속 오므로 자물쇠가 없으면 **검사가 프레임마다 새로 시작된다**
## (처음에 그렇게 짰다가 "통과 180 / 실패 174" 라는 뒤죽박죽 결과를 봤다).
var _시작함 := false
var _루트: Node = null
var _p: Node2D = null
var _캠: ProtoCamera = null
var _공간: 카메라공간 = null


func _init() -> void:
	Engine.max_fps = 60
	process_frame.connect(_tick)


func _확인(조건: bool, 설명: String) -> void:
	if 조건:
		_통과 += 1
		print("  ✔ %s" % 설명)
	else:
		_실패 += 1
		print("  ✖ %s" % 설명)


func _tick() -> void:
	_n += 1
	if _n == 1:
		if not ResourceLoader.exists(씬):
			push_error("씬이 없다: %s" % 씬)
			quit(2)
			return
		# ★헤드리스에서는 루트 창이 아주 작다(실측 64px). 카메라의 리밋 클램프는
		#   "화면 반폭 = 뷰포트/줌" 을 쓰기 때문에, 창이 작으면 좁은 굴뚝 리밋이
		#   화면보다 **넓어져** 중앙 고정 로직이 아예 안 타고 검사가 무의미해진다.
		#   → 게임과 같은 1920×1080 으로 맞춘다(project.godot 의 값).
		root.size = Vector2i(1920, 1080)
		_루트 = (load(씬) as PackedScene).instantiate()
		root.add_child(_루트)
		current_scene = _루트
		return
	if _n < 8 or _시작함:
		return
	_시작함 = true

	print("")
	print("── 준비 ───────────────────────────────────────")
	_p = _루트.get_node_or_null("Player") as Node2D
	_캠 = _루트.get_node_or_null("카메라") as ProtoCamera
	for n in _루트.get_tree().get_nodes_in_group("카메라공간"):
		_공간 = n as 카메라공간
		break
	_확인(_p != null, "Player 를 찾았다")
	_확인(_캠 != null, "ProtoCamera(카메라) 를 찾았다")
	_확인(_공간 != null, "카메라공간 노드를 찾았다%s"
		% ("" if _공간 == null else " (%s)" % _공간.name))
	if _p == null or _캠 == null or _공간 == null:
		_끝내기()
		return

	# 물리 정지 — §머리말 참고
	_루트.set_physics_process(false)
	_p.set_physics_process(false)
	_p.set("velocity", Vector2.ZERO)

	await _검사()
	_끝내기()


# ============================================================================
func _검사() -> void:
	var 기준줌: float = _캠.기준_줌()
	var 중심 := _공간.global_position
	print("     굴뚝 중심 (%.0f, %.0f) · 안쪽 %.0f×%.0f · 기준 줌 %.3f"
		% [중심.x, 중심.y, _공간.크기.x, _공간.크기.y, 기준줌])

	# ── 0) 공간 밖 ──────────────────────────────────────────────────────────
	print("")
	print("── 0) 굴뚝 밖 ─────────────────────────────────")
	await _옮기고_기다리기(Vector2(중심.x - 2400.0, 중심.y), 12)
	_확인(is_zero_approx(_캠.공간_혼합()),
		"굴뚝 밖에서는 공간 혼합이 0 이다 (%.3f)" % _캠.공간_혼합())

	# ── 1) ★심리스 ── 들어간 직후에는 중간값이어야 한다 (컷이면 곧바로 1)
	print("")
	print("── 1) 심리스 (들어간 직후) ────────────────────")
	# 굴뚝 아래쪽 = 실제로 플레이어가 들어오는 곳
	var 입구 := Vector2(중심.x, 중심.y + _공간.크기.y * 0.40)
	await _옮기고_기다리기(입구, 8)          # 0.13 초 — 들어갈때(0.65초)의 1/5
	var 중간 := _캠.공간_혼합()
	_확인(중간 > 0.0 and 중간 < 0.9,
		"들어간 직후 혼합이 중간값이다 = 컷이 아니다 (%.3f)" % 중간)

	# ── 2) 수렴 ── 충분히 기다리면 1 이 된다
	print("")
	print("── 2) 수렴 ────────────────────────────────────")
	await _옮기고_기다리기(입구, 60)         # 1.0 초
	_확인(_캠.공간_혼합() > 0.98,
		"굴뚝 안에서 혼합이 1 로 수렴한다 (%.3f)" % _캠.공간_혼합())
	var 목표줌 := 기준줌 * _공간.줌_배수
	_확인(absf(_캠.zoom.x - 목표줌) < 0.01,
		"줌이 기준×배수로 수렴한다 (%.3f → %.3f, 목표 %.3f)"
		% [기준줌, _캠.zoom.x, 목표줌])

	# ── 3) ★★리밋 클램프 ── 좌우로 흔들어도 카메라 x 가 안 움직인다
	print("")
	print("── 3) 벽 이탈 방지 (좌우로 흔들기) ────────────")
	var 기준x := _캠.global_position.x
	var 최대이동 := 0.0
	# 굴뚝 안쪽 폭의 ±40% — 실제로 좌우 선반을 오갈 때의 이동 범위
	for dx: float in [-0.4, 0.4, -0.35, 0.3, 0.0]:
		await _옮기고_기다리기(입구 + Vector2(_공간.크기.x * dx, 0.0), 6)
		최대이동 = maxf(최대이동, absf(_캠.global_position.x - 기준x))
	_확인(최대이동 < 1.0,
		"좌우로 움직여도 카메라 x 가 고정된다 (최대 %.4f px)" % 최대이동)
	_확인(absf(기준x - 중심.x) < 2.0,
		"카메라 x 가 굴뚝 중심에 못박혔다 (%.1f vs 중심 %.1f)" % [기준x, 중심.x])

	# 화면이 벽 바깥을 비추지 않는가 = 리밋 폭이 화면 폭보다 좁은가
	# (좁으면 `_clamp_to_limits` 가 중앙 고정으로 들어간다 — 그게 ② 요구사항의 정체다)
	var 화면폭: float = root.get_viewport().get_visible_rect().size.x / _캠.zoom.x
	_확인(_공간.리밋().size.x < 화면폭,
		"리밋 폭(%.0f)이 화면 폭(%.0f)보다 좁다 → 중앙 고정" % [_공간.리밋().size.x, 화면폭])

	# ── 4) 수직 추적 ── 올라가면 화면이 따라 올라간다
	print("")
	print("── 4) 수직 추적 (등반) ────────────────────────")
	var 아래y := _캠.global_position.y
	await _옮기고_기다리기(Vector2(중심.x, 중심.y - _공간.크기.y * 0.35), 45)
	var 위y := _캠.global_position.y
	_확인(위y < 아래y - 300.0,
		"올라가면 카메라도 올라간다 (%.0f → %.0f)" % [아래y, 위y])
	# 오를수록 시선이 위를 향한다 (출구를 미리 보여주는 장치)
	_확인(_공간.진행도() > 0.5,
		"등반 진행도가 올라갔다 (%.2f)" % _공간.진행도())

	# ── 5) ★가역성 ── 나오면 되돌아온다
	print("")
	print("── 5) 가역성 (굴뚝 밖으로) ────────────────────")
	await _옮기고_기다리기(Vector2(중심.x - 2400.0, 중심.y), 90)
	_확인(_캠.공간_혼합() < 0.02,
		"굴뚝을 벗어나면 혼합이 0 으로 되돌아온다 (%.3f)" % _캠.공간_혼합())
	_확인(absf(_캠.zoom.x - 기준줌) < 0.01,
		"줌이 기준값으로 복귀한다 (%.3f, 기준 %.3f)" % [_캠.zoom.x, 기준줌])

	# ── 6) 연출 줌 배수 ── 전환 연출과 공간 줌이 서로를 지우지 않는가
	print("")
	print("── 6) 연출 줌배수와의 공존 ────────────────────")
	_캠.연출_줌배수 = 1.20
	await _기다리기(4)
	_확인(absf(_캠.zoom.x - 기준줌 * 1.20) < 0.01,
		"연출 배수가 곱해진다 (%.3f, 기대 %.3f)" % [_캠.zoom.x, 기준줌 * 1.20])
	_캠.연출_줌배수 = 1.0


## 플레이어를 그 자리로 옮기고 물리 프레임을 기다린다.
## ★Area2D 판정은 물리 서버가 하므로 **물리 프레임**을 기다려야 신호가 온다.
func _옮기고_기다리기(위치: Vector2, 프레임: int) -> void:
	_p.global_position = 위치
	await _기다리기(프레임)


func _기다리기(프레임: int) -> void:
	for i in 프레임:
		await physics_frame


func _끝내기() -> void:
	print("")
	print("[test_카메라공간] 통과 %d / 실패 %d" % [_통과, _실패])
	quit(_실패)
