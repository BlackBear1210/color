func _땅(이름: String, 점들: PackedVector2Array, 색: int, 역할: String = "플랫폼") -> Node2D:
	var n: Node2D = b.지형(지형부모, 이름, 점들, 색, 역할)
	if n != null:
		n.set("시안_명도조율", true)
		n.set("앞지형_깊이", true)
	return n


## 떨어지는 물. ★스크립트를 먼저 바꾼다 — set_script 는 그 전에 넣은 값을 지운다.
func _물(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int, 켜짐: bool = true) -> Node2D:
	var f := (load(공.S_유체) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	f.name = 이름
	f.set_script(load(G_물))
	f.position = Vector2(x, 윗끝)
	f.set("종류", 0)
	f.set("색", 색)
	f.set("크기", Vector2(폭, 높이))
	f.set("켜짐", 켜짐)
	부모.add_child(f)
	return f


## 호퍼로 들어가는 물 — 끝을 호퍼 윗면보다 이만큼 아래로(tools/align_hopper_inlets.py 와 같은 규칙: 윗면 + 12).
const 유입_여유 := 12.0


## 호퍼로 들어가는 물 표시. ★켜지 않으면 프레임이 튄다(2026-10-03 2-3 실측 · p99 31ms):
##   물 자신의 바닥 찾기(유체_흰물v2 · 0.1 초마다)는 호퍼 윗면을 바닥으로 보고, 호퍼 입구 연출(호퍼_입구수면_시안)은
##   물줄기를 수면까지 늘린다 → 둘이 `보이는_높이` 를 번갈아 덮어써 물 그림이 재질을 계속 다시 만든다(한 번 ~1.3ms × 8 줄기).
##   `호퍼_유입` 이면 바닥 찾기와 끝 물보라를 건너뛴다 — 다른 하수도 씬은 align_hopper_inlets.py 가 켜 두었다.
func _유입(f: Node2D) -> Node2D:
	f.set("호퍼_유입", true)
	return f


## 천장(지형) 속에서 내려오는 짧은 급수관 + 물.
func _물_관(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int) -> Node2D:
	var f := _물(부모, 이름, x, 윗끝, 폭, 높이, 색)
	_관(부모, "관_" + 이름, [[x, 윗끝 - 128], [x, 윗끝]], null, f)
	return f


func _관(부모: Node, 이름: String, 점들: Array, 시작: Node, 끝: Node) -> Node2D:
	var p := Node2D.new()
	p.name = 이름
	p.z_index = -1
	p.set_script(load(G_배관))
	var 경로 := PackedVector2Array()
	for v in 점들:
		경로.append(Vector2(float(v[0]), float(v[1])))
	p.set("점들", 경로)
	부모.add_child(p)
	if 시작 != null:
		p.set("시작_장치", p.get_path_to(시작))
	if 끝 != null:
		p.set("끝_장치", p.get_path_to(끝))
	return p


func _격자(부모: Node, 이름: String, x: float, 윗면: float, 폭: float, 색: int) -> Node2D:
	var g: Node2D = b.통과플랫폼(부모, 이름, x, 윗면, 폭, 1)
	g.set("고정색", 색)
	return g


## 원형 밸브. `갈래B` 를 주면 둘 중 하나(또는 세 상태 순환 — 부른 쪽이 켠다).
func _밸브(부모: Node, 이름: String, 위치: Vector2, 대상: Node, 갈래B: Node = null) -> Node2D:
	var l := (load(공.S_레버) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	l.name = 이름
	l.position = 위치
	l.set("종류", 0)
	l.set("시작_켜짐", true)
	부모.add_child(l)
	l.set("대상_유체", l.get_path_to(대상))
	if 갈래B != null:
		l.set("갈래_B", l.get_path_to(갈래B))
	return l


## 주철 호퍼(색 규칙 밖 · 밟을 수 있다). 원점 = 아랫변 가운데 = 밟는면 + 높이 = 출구 물 윗끝.
##   ★스크립트(주철 어댑터)를 먼저 바꾼다 — set_script 가 그 전에 넣은 값을 지운다(_물 과 같다).
##   출구 물 너비는 주철 호퍼의 `출구폭_노즐에_맞춤`(기본 켬 · 폭 × 0.2)이 정한다(도형님 2026-09-27 결정).
##   밟는 면은 일방통행 — 공통 빌더 `호퍼()` 와 같은 수법(호퍼.gd `_다시_만들기()` 가 `윗면` 을 재사용한다).
func _호퍼(부모: Node, 이름: String, x: float, 밟는면: float, 폭: float, 높이: float, 출구유체: Node) -> Node2D:
	var h := (load(공.S_호퍼) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	h.name = 이름
	h.set_script(load(G_호퍼))
	h.position = Vector2(x, 밟는면 + 높이)
	h.set("폭", 폭)
	h.set("높이", 높이)
	h.set("자동_출구_연결", false)
	h.set("주철_명도", 0.88)
	h.z_index = 3
	var c := CollisionShape2D.new()
	c.name = "윗면"
	var r := RectangleShape2D.new()
	r.size = Vector2(폭, 12.0)
	c.shape = r
	c.position = Vector2(0, -높이 + 6.0)
	c.one_way_collision = true
	c.one_way_collision_margin = 4.0
	h.add_child(c)
