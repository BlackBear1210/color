const 공 := preload("res://tools/하수도_빌더_공통.gd")
const 내씬 := "res://scenes/world_2_클로드/stage_2-3.tscn"
const 다음씬 := "res://scenes/world_2_클로드/stage_2-4.tscn"
const 배경씬 := "res://scenes/배경/하수도_다층배경_v02.tscn"

const 검 := 공.검정
const 흰 := 공.흰색

const 프레임 := Rect2(0, 0, 12000, 3200)
const G := 1856.0   # 갤러리·상층 바닥
const L := 2560.0   # 하부 복도 바닥
const E := 2880.0   # 출구층 바닥

## 호퍼(구멍 256 · 호퍼 폭 128 · 밟는면 = G + 64). 공급 물줄기는 구멍 안 1872~1936 — 갤러리에서 뛰어 건널 때 몸이 안 닿는다.
## 입구 감지 영역 = 밟는면 −84 ~ +6 이라 아랫끝 1936 이 들어간다(호퍼.gd `입구_감지범위_월드`).
const 호퍼면 := G + 64.0
const 출구y := 호퍼면 + 56.0        # 호퍼 원점(아랫변) = 출구 물 윗끝
const 출구폭 := 320.0               # 구멍(256)보다 넓어 구멍 가장자리로 떨어져도 바닥 물띠(0.75W=240)에 닿는다

var b: RefCounted


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 2-3 · 관을 따라서 v2 (호퍼실 4 · 막다른 길 3 · 빙 도는 길 1) ===")
	b = 공.new()
	# 줄눈을 갤러리 바닥선(1856)에 맞춘 절대 UV 재질(2-2 와 같은 기준 1792.1). 선반은 ledge_v03.
	b.재질_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_black.tres")
	b.재질_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_white.tres")
	b.재질_선반_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_black.tres")
	b.재질_선반_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_white.tres")
	var 루트 := _짓기()
	var ok: bool = b.검산(프레임, _빈공간들())
	b.색비율_보고()
	if not ok or b.오류 > 0:
		push_error("2-3: 검산 실패 %d — 저장하지 않는다" % b.오류)
		quit(1)
		return
	if not b.저장(루트, 내씬):
		quit(1)
		return
	print("=== 끝 ===\n")
	quit(0)


func _빈공간들() -> Array:
	return [
		Rect2(0, 896, 2688, G - 896),               # A 방 공기(선반·호퍼 포함)
		Rect2(160, G, 544, 96),                     # 입구 통로 자리(연결통로가 스스로 짓는다)
		Rect2(1472, G, 128, 256),                   # A 슬롯 1 (가시)
		Rect2(2560, G, 128, 256),                   # A 슬롯 2 (가시 · 흰→검 전환)
		Rect2(2688, 1408, 5632 - 2688, G - 1408),   # B 갤러리 공기
		Rect2(2944, G, 192, L - G),                 # B 굴뚝(P1 복귀 격자)
		Rect2(3136, 2304, 128, 256),                # 굴뚝 오른벽 밑 통로
		Rect2(3264, G, 256, 144),                   # h1
		Rect2(4288, G, 256, 144),                   # h2
		Rect2(5120, G, 256, 144),                   # h3
		Rect2(3264, 2000, 512, 560),                # P1 주머니
		Rect2(3904, 2000, 8960 - 3904, 560),        # 하부 복도(B~C) · C 상층 슬래브 밑
		Rect2(5760, 1408, 12000 - 5760, G - 1408),  # C·D 위층 공기(선반·톱·호퍼 H5 포함)
		Rect2(5760, G, 640, 144),                   # 오르는 선반 자리(B_오른벽~상층 슬래브 사이)
		Rect2(7808, G, 128, 144),                   # g3 틈(상층 슬래브 구멍)
		Rect2(7936, G, 320, 144),                   # H5 구멍(호퍼 320)
		Rect2(8704, G, 256, 144),                   # 상층 오른끝 낙하 자리
		Rect2(8960, G, 12000 - 8960, L - G),        # D 방 위쪽 공기(호퍼 H6·H7)
		Rect2(9600, L, 12000 - 9600, E - L),        # D 방 아래쪽 공기
		Rect2(6400, L, 128, 416),                   # F1-C 구덩이
		Rect2(6400, 2720, 1280, 256),               # F1-C 터널
		Rect2(7552, L, 128, 160),                   # F1-C 굴뚝
		Rect2(9920, E, 128, 192),                  # D 슬롯 1
		Rect2(10400, E, 128, 192),                  # D 유령 1 밑 구멍
		Rect2(10688, E, 128, 192),                  # D 슬롯 2
		Rect2(11136, E, 128, 192),                  # D 유령 2 밑 구멍
		Rect2(11456, 2576, 544, 400),               # 출구 통로
	]


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("stage_2-3", "2-3 · 관을 따라서",
		프레임, Vector2(520, G), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	# 배경(지형보다 뒤). 공용 v02 는 배수구 3·아치 3 이 4,350×3,500 까지 퍼져 있어 12,000×3,200 에 그대로 맞는다.
	var 배경 := (load(배경씬) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	배경.name = "하수도배경"
	루트.add_child(배경)
	루트.move_child(배경, 1)

	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 채움 — 천장. C·D 위층 천장(x ≥ 5632)은 **흰색**: 머리 공간 448 이라 절대 못 닿는 면이고,
	# 보이는 면 색 비율(검정 65 ± 5)을 맞추려면 닿지 않는 면에 흰색을 둬야 한다(가이드라인 §7-1).
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "천장띠", 공.사각(0, 0, 12000, 896), 검, "채움")
	b.지형(지, "BCD_천장_채움_흰", 공.사각(2688, 896, 12000, 1408), 흰, "채움")
	# D 방 위쪽에 매달린 흰 기둥 둘(장식 · 아랫끝 2400 = 바닥 2880 에서 480 위라 못 닿는다). 색 비율 보정용.
	b.지형(지, "D_기둥_흰1", 공.사각(9856, 1408, 9984, 2400), 흰, "채움")
	b.지형(지, "D_기둥_흰2", 공.사각(11712, 1408, 11840, 2400), 흰, "채움")

	# ══════════════════════════════════════════════════════════════════════
	# A 방 「물은 위에서 온다」
	# ══════════════════════════════════════════════════════════════════════
	# 검정 바닥. 입구 통로 자리(160~704 × 1856~1952)는 파 둔다(2-1 방식).
	b.지형(지, "A_바닥_검", 공.다각([
		[0, G], [160, G], [160, G + 96], [704, G + 96], [704, G], [1472, G], [1472, 3200], [0, 3200],
	]), 검)
	b.지형(지, "A_슬롯1_바닥", 공.사각(1472, G + 256, 1600, 3200), 검, "채움")
	var a_흰: Node2D = b.지형(지, "A_바닥_흰", 공.사각(1600, G, 2560, 3200), 흰)
	b.내부무늬(a_흰, 1900, 2200, G + 40, G + 170)          # 흰 바닥 안 검정 벽돌(시작 화면 오른쪽)
	b.지형(지, "A_슬롯2_바닥", 공.사각(2560, G + 256, 2688, 3200), 검, "채움")
	# 선반 계단(검정 · 일방통행): 바닥 → a1 → a2 → H1(1472). H1 에서 왼쪽 위로 a4 → a5 → 유령 G_A → F1 선반.
	b.공중선반(지, "A_a1", 960, 1728, 1216, 검)
	b.공중선반(지, "A_a2", 1216, 1600, 1472, 검)
	b.공중선반(지, "A_a4", 1216, 1344, 1472, 검)
	b.공중선반(지, "A_a5", 960, 1216, 1216, 검)
	b.공중선반(지, "A_F1선반", 384, 1088, 704, 검)
	# ⓓ 유령: 검정 1 발로 밟힌다. 막다른 곳에서 되돌아오며 E 로 회수하면 탄약이 돌아온다.
	b.유령(지, "A_G_A", 공.사각(704, 1088, 960, 1184), 검, 1)
	# H1 — 공급(흰) 은 호퍼 오른끝(1680)에 떨어진다. 왼쪽(≤1620)에 선 몸은 물에 안 닿고, 여기서 흰색으로 바꾼 뒤
	# 흰 물을 지나 오른끝에서 흰 바닥(1600~)으로 내려선다. 출구 물(흰)은 바로 밑 흰 바닥으로.
	var a_out: Node2D = b.유체(장, "A_H1_출구물", 1600, 1528, 64, G - 1528, 공.물_흰, false)
	b.호퍼(장, "H1", 1600, 1472, 256, 56, a_out, 64)
	b.배관(장, "관_A", 공.다각([[544, 1088], [544, 960], [1680, 960], [1680, 1000]]))
	b.유체(장, "A_공급_흰물", 1680, 1000, 64, 440, 공.물_흰)

	# ══════════════════════════════════════════════════════════════════════
	# B 방 「위에서 읽고 아래에서 고른다」
	# ══════════════════════════════════════════════════════════════════════
	# 굴뚝 양벽(왼벽은 바닥까지 — 격자를 오르며 몸을 붙이는 벽 · 오른벽은 2304 까지만 = 밑으로 주머니와 통한다)
	b.지형(지, "B_굴뚝_왼", 공.사각(2688, G, 2944, 3200), 검)
	b.지형(지, "B_굴뚝_오른", 공.사각(3136, G, 3264, 2304), 검)
	var b_슬래브: Node2D = b.지형(지, "B_슬래브_3", 공.사각(3520, G, 4288, G + 144), 검)
	b.내부무늬(b_슬래브, 3700, 4000, G + 30, G + 115)      # 갤러리 슬래브 안 흰 벽돌(h1·h2 사이)
	b.지형(지, "B_슬래브_4", 공.사각(4544, G, 5120, G + 144), 검)
	b.지형(지, "B_슬래브_5", 공.사각(5376, G, 5632, G + 144), 검)
	b.지형(지, "B_오른벽", 공.사각(5632, 1408, 5760, G + 144), 검)
	b.지형(지, "B_P1_바닥", 공.사각(2944, L, 3776, 3200), 검)
	b.지형(지, "B_W1", 공.사각(3776, G + 144, 3904, 3200), 검)
	# 하부 복도 바닥(B~C 한 폴리곤): F1-C 구덩이(6400~6528) 와 터널(6400~7680 × 2720~2976), 굴뚝(7552~7680) 을 판다.
	b.지형(지, "C_복도_바닥", 공.다각([
		[3904, L], [6400, L], [6400, 2976], [7680, 2976], [7680, L], [8960, L], [8960, 3200], [3904, 3200],
	]), 검)
	b.지형(지, "C_터널_천장", 공.사각(6528, L, 7552, 2720), 검)
	# 굴뚝 격자 5 장(192 폭 · 일방통행) — 왼벽에 몸을 붙이고 똑바로 뛰어오른다. 맨 위 장(1936)은 갤러리 바닥 80 아래:
	# 덮개를 두면 그 밑 장에 선 머리가 덮개에 닿아 레벨검사가 "설 수 없는 자리" 로 본다(일방통행을 모른다).
	# 갤러리에서 걷다 빠져도 80 만 내려가 걸어 나온다(구덩이 아님).
	for i in 5:
		var y: float = [2432.0, 2304.0, 2176.0, 2048.0, 1936.0][i]
		b.통과플랫폼(장, "B_굴뚝_g%d" % (i + 1), 3040.0, y, 192.0, 1)
	# 호퍼 3 + 공급 물줄기 + 출구 물(호퍼가 켠다 · 색을 물려준다)
