# 카메라 — 공간이 바뀌면 화면도 바뀐다 (기존 `카메라공간` 재사용)
# ============================================================================
## ▣ 새 트리거를 만들지 않은 이유
##   `scripts/proto/카메라_공간.gd` 가 이미 정확히 이 일을 한다 —
##   리밋 조이기 + 줌 배수 + 시선 오프셋을 **Tween 으로** 흘려보낸다(컷이 없다).
##   도형님 지시 §9 "카메라가 순간적으로 튀지 않아야 한다" 가 그 안에 이미 들어 있다.
##
## ▣ 화면 폭 계산 (뷰포트 1920 ÷ (기준줌 1.35 × 줌_배수))
##     복도    1.15 → 1237px      좁은 통로 1.85 → 769px
##     계단    1.00 → 1422px      1층 홀    0.80 → 1778px
##   좁은 통로 → 1층 홀 이 **2.3 배**다. 이 대비가 "좁았다가 트인다" 를 만든다.
##
## ⚠ 공간끼리 x 로 겹치면 Area2D 진입/이탈이 엇갈려 화면이 떤다 → 전부 떼어 놨다.
func _카메라공간들(오: Node2D) -> void:
	# 2층 복도 — 살짝 조여서 복도가 화면을 채우게. 아직 답답하지는 않다.
	# 화면 세로 1080/(1.35×1.15)=696 ≥ 복도 실내 600 → 천장·바닥이 한 화면에 다 들어온다.
	_카메라공간(오, "카메라_2층복도", Vector2(-950, -300), Vector2(1480, 620),
		1.15, Vector2(0, -40), 0.8, 1.0)

	# 좁은 통로 — 가장 조인다. 리밋(720×200)이 화면(769×432)보다 좁아
	# `ProtoCamera._clamp_to_limits` 가 카메라를 거의 못 박는다 = 화면이 안 흐른다.
	_카메라공간(오, "카메라_좁은통로", Vector2(160, -100), Vector2(720, 200),
		1.85, Vector2(0, -10), 0.55, 1.10)

	# 계단 — 기준 줌으로 돌아오되 **시선을 오른쪽 아래로** 민다.
	# 내려가는 방향의 다음 공간이 화면에 먼저 들어온다(도형님 지시 §7).
	_카메라공간(오, "카메라_계단", Vector2(1150, 385), Vector2(1230, 800),
		1.00, Vector2(190, 110), 0.90, 1.20)

	# 1층 홀 — 확 펼친다. 나올 때(1.0)보다 **들어갈 때를 길게(1.25)** 둬서
	# 계단을 내려오는 동안 화면이 천천히 열리게 했다. 이게 이 스테이지의 "짜잔" 이다.
	_카메라공간(오, "카메라_1층홀", Vector2(2470, 370), Vector2(1380, 800),
		0.80, Vector2(0, -50), 1.25, 1.00)


func _카메라공간(층: Node2D, 이름: String, 자리: Vector2, 크기: Vector2,
		줌배수: float, 시선: Vector2, 들어갈때: float, 나올때: float) -> void:
	var c: Node2D = 카메라공간_S.new()
	c.name = 이름
	c.position = 자리
	c.set("크기", 크기)
	c.set("리밋_여유", Vector2(0, 200))
	c.set("줌_배수", 줌배수)
	c.set("시선_오프셋", 시선)
	c.set("수직모드", false)          # 전부 가로로 긴 공간이다. 굴뚝이 아니다.
	c.set("오를수록_위로", 0.0)
	c.set("들어갈때", 들어갈때)
	c.set("나올때", 나올때)
	c.set("틈새빛_사용", false)       # 굴뚝 전용 연출이라 실내 복도에는 안 맞는다
	층.add_child(c)


