func _지형_짓기(지: Node2D) -> void:
	# ── ① 2층 바닥 (복도 + 좁은 통로가 같은 높이로 이어진다) ────────────────
	# 바닥에 낮은 턱 하나(−90). 폭 200 이라 README §7 의 "한 칸 90px 이상" 을 넘는다.
	# 단차 90 은 게이트 128 의 70% — 걸어가다 자연스럽게 뛰어오르는 정도다.
	_지형(지, T_나무, "바닥_2층_SS_WOOD_01", _계단덩어리([
		[-1700.0, -1180.0, 이층],
		[-1180.0, -980.0, 이층 - 90.0],      # 문지방 턱
		[-980.0, 계단_시작x, 이층],
	], 300.0), false)

	# ── ② 2층 복도 천장 ──
	# 시각 600 → 실효 552. 몸 96 + 점프 167 = 263 이라 머리가 한참 안 닿는다.
	# 도입부는 편해야 한다(도형님 지시 §18 난이도 곡선의 [도입]).
	# ★600 은 원화 벽지 py 150(서까래 줄)이 딱 천장선에 오도록 고른 값이다.
	_지형(지, T_벽돌, "천장_2층복도_SS_BRICK_01", _사각(-1780, -900, -200, -600), false)

	# ── ③ 좁은 통로 (긴장) ───────────────────────────────────────────────
	# 시각 200 → **실효 152**. 몸 96 이라 머리 위 56px 뿐이다.
	# 점프(167)를 하면 반드시 천장에 박힌다 = "여긴 뛸 수 없다" 가 몸으로 읽힌다.
	# 물리 최소 96.1 보다 56px 여유라 **끼이지는 않는다**(도형님 지시 §8 마지막 줄).
	_지형(지, T_벽돌, "천장_좁은통로_SS_BRICK_01", _사각(-200, -500, 계단_시작x, -200), false)

	# ── ④ 계단 (BRICK STAIRS Template) ──────────────────────────────────
	# 7 단 × (폭 180 × 높이 110). 내려갈 때만이 아니라 **되돌아 올라올 수 있어야**
	# 소프트락이 안 난다 → 110 ≤ 게이트 128 ✔
	_지형(지, T_나무계단, "SS_WOOD_STAIRS_01", _계단선반(_계단단(), 200.0), false)

	# 계단실 천장 — **위쪽 4 단만 덮는다.**
	# 5 단째부터 천장이 사라지면서 1층의 높은 천장(800)이 시야에 들어온다.
	# 도형님 지시 §7 "계단을 내려가면서 아래층에 더 큰 공간이 있구나" 를 지형으로 만든 것.
	var 계단천장단: Array = []
	for i in 4:
		var s: Array = _계단단()[i]
		계단천장단.append([s[0], s[1], s[2] - 420.0])
	_지형(지, T_벽돌, "천장_계단실_SS_BRICK_01", _계단천장(계단천장단, -900.0), false)

	# ── ⑤ 1층 홀 (해소 · 넓다) ──────────────────────────────────────────
	_지형(지, T_나무, "바닥_1층_SS_WOOD_01", _사각(1780, 일층, 3160, 일층 + 300.0), false)
	# 천장 아랫면 −30 → 바닥 770 과 **800px**. 좁은 통로(152)의 5.3 배다.
	# ★−30 은 거실 원화의 천장선(py 64)이 딱 여기 오도록 역산한 값이다.
	_지형(지, T_벽돌, "천장_1층_SS_BRICK_01", _사각(1240, -330, 3160, -30), false)

	# ── ⑥ 바깥 벽 ────────────────────────────────────────────────────────
	# 왼쪽은 입구 통로(y −170~0), 오른쪽은 출구 통로(y 410~580) 자리를 비운다.
	# 통으로 세우면 통로가 벽에 막혀 다음 씬으로 못 간다.
	_지형(지, T_벽돌, "벽_왼위_SS_BRICK_01", _사각(-1940, -900, -1700, -170), false)
	_지형(지, T_벽돌, "벽_왼아래_SS_BRICK_01", _사각(-1940, 이층, -1700, 300), false)
	_지형(지, T_벽돌, "벽_오른위_SS_BRICK_01", _사각(3160, -330, 3400, 410), false)
	_지형(지, T_벽돌, "벽_오른아래_SS_BRICK_01", _사각(3160, 580, 3400, 1070), false)

	# ── ⑦ 2층 복도의 가구 (학습 · 높이차) ───────────────────────────────
	# 복도 천장이 600 이라 공중 발판을 놓을 자리는 있지만, **복도라는 공간에는**
	# 바닥에 붙은 가구가 정직하다. 원화에도 문 옆에 궤짝이 그려져 있다.
	_지형(지, T_나무, "SS_WOOD_CHEST_01", _계단덩어리([
		[-640.0, -340.0, 이층 - 110.0],       # 복도 궤짝. 단차 110 ✔ · 폭 300
	], 이층 - 110.0 + 발판두께), true)

	# ── ⑧ 1층 홀의 오르는 길 (활용) ─────────────────────────────────────
	# 바닥 770 → 660 → 550. 단차 110(게이트 128 의 86%). 폭은 전부 300 —
	# 코너 조각이 90px 씩이라 그보다 좁으면 모서리가 검게 파인 것처럼 보인다(README §11).
	_지형(지, T_나무, "SS_WOOD_UNDERSTAIR_01", _사각(1800, 660, 2100, 660 + 발판두께), true)
	_지형(지, T_나무, "SS_WOOD_TABLE_01", _사각(2200, 550, 2500, 550 + 발판두께), true)

	# ── ⑨ ★유령 발판 = 이 스테이지의 게이트 ─────────────────────────────
	# 무색이면 반투명·통과라 밟을 수 없다. **칠해야 실체가 생긴다.**
	#   바닥 770 → 출구 선반 580 = 190px.  점프 167 로는 **절대 못 넘는다.**
	#   바닥 770 → 유령 660 = 110 ✔ / 유령 660 → 출구 선반 580 = 80 ✔
	#   탁자(550, 오른끝 2500) → 출구 선반(2900) 은 수평 400px > 건널 한계 204 ✔
	# 그리고 유령 자리는 아래 ColorZone(흰색) 한가운데다 →
	#   **검정으로 칠하면 밟는 순간 몸(흰색 강제)과 색이 달라 죽는다.**
	_지형(지, T_나무, "SS_WOOD_GHOST_01", _사각(2600, 660, 2860, 660 + 발판두께), true, true)
	_지형(지, T_나무, "SS_WOOD_SHELF_EXIT_01", _사각(2900, 580, 3160, 580 + 발판두께), true)


## 계단 7 단. [왼x, 오른x, 윗면y]
func _계단단() -> Array:
	var 단: Array = []
	for i in 7:
		단.append([
			계단_시작x + 계단폭 * i,
			계단_시작x + 계단폭 * (i + 1),
			이층 + 계단높이 * (i + 1),
		])
	return 단


