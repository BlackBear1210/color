func _복도계단() -> Node2D:
	var 시작 := Vector2(-1560, 이층)

	var 루트: Node2D = 월드_S.new()
	루트.name = "집_복도계단"
	루트.set("스테이지_이름", "집 · 2층 복도와 계단")
	루트.set("카메라_리밋", 리밋)
	루트.set("카메라_줌", 기준줌)
	루트.set("시작_위치", 시작)
	루트.set("낙사_y", 1600.0)
	# 계단 전체 낙차가 770px 이다. 기본 520 이면 계단을 뛰어내리는 것만으로 죽는다.
	루트.set("치명_낙하거리", 900.0)

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)
	루트.add_child(코어)

	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	어둠.color = (챕터_S.팔레트(1) as Dictionary)["어둠"]
	루트.add_child(어둠)

	var 지 := Node2D.new()
	지.name = "지형"
	루트.add_child(지)

	var 오 := Node2D.new()
	오.name = "오브젝트"
	루트.add_child(오)

	# ── 장식 레이어 둘 ──
	# ⚠ 한 겹(z 12)으로 뒀더니 **계단 난간이 플레이어 얼굴을 가로질렀다.**
	#   난간은 "저 안쪽 난간" 이라 몸 뒤로 가야 하고, 계단 코·문틀은 지형 위에 얹혀야 한다.
	#   배경 −60 < 난간 −3 < 플레이어 0 < 지형 1 < 계단코 3.
	var 장식뒤 := Node2D.new()
	장식뒤.name = "장식_뒤"
	장식뒤.z_index = -3
	장식뒤.z_as_relative = false
	루트.add_child(장식뒤)

	var 장식앞 := Node2D.new()
	장식앞.name = "장식_앞"
	장식앞.z_index = 3
	장식앞.z_as_relative = false
	루트.add_child(장식앞)

	_배경들(루트)
	_지형_짓기(지)
	_경계와_반딧불이(오)
	_빛(오)
	_카메라공간들(오)
	_난간과_소품(장식뒤, 장식앞)

	_통로(오, "입구통로", Vector2(-1620, 이층), false, "")
	_통로(오, "출구통로", Vector2(3100, 580.0), true, 거실씬)

	var p := (load(PLAYER) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 시작
	for k in 튜닝:
		p.set(k, 튜닝[k])
	루트.add_child(p)
	return 루트


