func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== 집 · 2층 복도 → 계단 → 1층 홀 빌더 (v2 · 원화 배경) ===")
	var 루트 := _복도계단()
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패: %s" % error_string(e))
		quit(1)
		return
	e = ResourceSaver.save(팩, 내씬)
	print("   %-24s %s" % [내씬.get_file(), error_string(e)])
	print("=== 끝 ===\n")
	quit(0 if e == OK else 1)


