# ★경계 — 김동현 작업자의 ColorZone + 반딧불이
# ============================================================================
## ▣ 왜 ColorZone 인가 (도형님 지시: "경계의 중심은 김동현 작업자가 만든 것으로")
##   `색경계.gd` 는 덕 타이핑이라 구현체가 셋(ColorZone · 빛기둥 · 식물B)이다.
##   그중 **작업자가 에디터에서 모양을 직접 잡으라고 만든 것은 ColorZone 하나뿐**이고,
##   겹침 방지·자석 스냅·빨간 경고까지 그 안에 들어 있다. 여기서는 그것만 쓴다.
##
## ▣ 겹침 금지 (색경계.gd §겹침)
##   경계끼리 **면이 겹치면 안 된다.** 두 구역을 x 로 멀찍이 떼어 놨고,
##   같은 자리의 빛기둥은 전부 `모드 = 연출` 이라 색경계 그룹에 아예 안 들어간다.
func _경계와_반딧불이(오: Node2D) -> void:
	# ── ① 복도의 학습용 구역 (위험 없음) ────────────────────────────────
	# 이 안의 지형은 바닥 벽돌뿐이고 벽돌은 `칠하기_허용 = false` = 영원히 무색 = 안전.
	# 즉 **죽지 않으면서** "빛 안에서는 내 색이 흰색으로 바뀐다" 만 배운다.
	# 도형님 지시 §18 난이도 곡선의 [학습] 칸이 이것이다.
	_색구역(오, "경계_복도등", _사각(-1240.0, -300.0, -940.0, 20.0), true)
	# ★반딧불이를 **구역 안쪽 둘레**를 따라 흩는다.
	#   가운데 뭉쳐 놓으면 빛이 동그란 웅덩이가 되어 "여기부터 저기까지" 가 안 읽힌다.
	_반딧불이(오, "반딧불_복도", [
		Vector2(-1205, -255), Vector2(-980, -235), Vector2(-1190, -35),
		Vector2(-975, -55), Vector2(-1090, -145),
	], 170.0)

	# ── ② 1층 홀의 게이트 구역 (진짜 판정) ──────────────────────────────
	# 유령 발판(x 2600~2860) 을 정확히 덮는다. 오른쪽 변이 출구 선반 왼면(2900)과
	# 맞닿지 않도록 2890 에서 끊었다 — 변 접촉은 허용이지만 여유를 두는 편이 안전하다.
	_색구역(오, "경계_반딧불이", _사각(2560.0, 380.0, 2890.0, 900.0), true)
	_반딧불이(오, "반딧불_홀", [
		Vector2(2595, 430), Vector2(2858, 470), Vector2(2585, 700),
		Vector2(2865, 830), Vector2(2728, 565), Vector2(2685, 872),
	], 195.0)


## ColorZone 하나. `흰색인가 = false` 면 검정 구역.
##
## ⚠⚠ **`color_zone.tscn` 을 인스턴스하면 안 된다.**
##   처음에 그렇게 했다가 두 구역이 98304px²(=384×256, Template 기본 폴리곤 넓이) 겹친다는
##   오류를 맞았다. 원인: `PackedScene.pack()` 은 **owner 가 패킹 루트인 노드의 값만** 저장한다.
##   인스턴스 내부의 `CollisionPolygon2D` 는 owner 가 우리 루트가 아니라서, 거기에 꽂은
##   폴리곤이 통째로 버려지고 Template 기본 사각형(원점 384×256)만 남는다.
##   → 두 구역이 **둘 다 원점의 같은 사각형**이 되어 정확히 겹쳤다.
##   CLAUDE.md §6 이 "인스턴스 내부 노드에 owner 를 다시 박지 말라"고 하므로
##   owner 를 고치는 대신, **다른 빌더들과 같은 방식**(스크립트를 새 노드에 붙이기)을 쓴다.
##   클래스도 스크립트도 김동현 작업자의 ColorZone 그대로다 — 만드는 경로만 다르다.
func _색구역(층: Node2D, 이름: String, 월드폴리곤: PackedVector2Array, 흰색인가: bool) -> void:
	var z := Area2D.new()
	z.name = 이름
	z.set_script(load(색구역스크립트))
	# ⚠ ColorZone 자신은 원점에 둔다. `경계_폴리곤들()` 이
	#   `global_transform * cp.transform` 으로 월드화하므로, 원점이면 아래 좌표가 곧 월드 좌표다.
	z.position = Vector2.ZERO
	z.collision_layer = 0            # color_zone.tscn 과 같은 값
	z.set("zone_color", 1 if 흰색인가 else 0)     # ColorZone.ZoneColor { BLACK=0, WHITE=1 }
	# ⚠ `show_tint` 는 **에디터용 가이드**다. 켜 두면 인게임에도 흰 사각형 + 외곽선이
	#   그대로 나와 "디버그 상자" 로 보인다(실제로 첫 스크린샷에서 그렇게 나왔다).
	#   경계는 반딧불이 빛과 몸 색 분할로 읽게 하고, 상자는 끈다.
	z.set("show_tint", false)

	var cp := CollisionPolygon2D.new()
	cp.name = "CollisionPolygon2D"   # ★이 이름이어야 `_기본_폴리곤()` 이 찾는다
	cp.polygon = 월드폴리곤
	z.add_child(cp)
	층.add_child(z)


## 반딧불이 무리. `발광체(종류 = 구슬)` 는 깜빡임·크기 흔들림이 이미 들어 있다.
## ⚠ 이 노드 자체에는 색 판정이 **없다.** 판정은 위 ColorZone 이 한다.
##   반딧불이는 **그 구역이 어디까지인지 눈에 보이게 하는 역할**만 맡는다
##   (도형님 지시 §13 "빛나는 영역에서 색 반응이 나타나도록").
func _반딧불이(층: Node2D, 이름: String, 자리들: Array, 반경: float) -> void:
	var 묶음 := Node2D.new()
	묶음.name = 이름
	for i in 자리들.size():
		var f: Node2D = 발광체_S.new()
		f.name = "구슬_%02d" % (i + 1)
		f.position = 자리들[i]
		f.set("종류", 발광체_S.종류_.구슬)
		# 흑백 게임이라 채도는 거의 0. 아주 옅은 온기만 남긴다.
		f.set("빛색", Color(1.0, 0.97, 0.90))
		f.set("반경", 반경)
		f.set("밝기", 1.25)
		f.set("깜빡임", 0.30)
		f.set("크기_흔들림", 0.34)          # 크기까지 흔들려야 "살아 있는 빛"이 된다
		f.set("흔들림_속도", 0.45 + 0.11 * i)   # 서로 다른 주기 = 무리가 동기화되지 않는다
		f.set("부유", 16.0)
		묶음.add_child(f)
	층.add_child(묶음)


