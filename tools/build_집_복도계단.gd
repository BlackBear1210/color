# 빛 — 전부 `모드 = 연출` (판정 없음) · ★원화의 진짜 광원 자리에서 쏜다
# ============================================================================
## ⚠ 집 4방은 창빛을 `모드 = 경계` 로 썼다. 여기서는 경계를 ColorZone 이 맡으므로
##   빛기둥을 경계로 두면 **두 경계가 같은 자리에서 면으로 겹쳐 금지 규칙을 어긴다.**
##   → 전부 연출로 낮춘다. 화면에 보이는 것은 똑같고, 판정만 ColorZone 이 한다.
##
## ★[v2] 좌표를 거실 원화에서 **직접 재서** 넣었다.
##     원화 창       py(610~845, 364~706) → 월드 x 1789~2001 · y 231~538
##     원화 샹들리에 py(856, 225)         → 월드 (2010, 106)
##   그래서 화면에서 "그림 속 창"과 "게임의 빛줄기"가 같은 자리에서 시작한다.
func _빛(오: Node2D) -> void:
	_연출빛(오, "복도벽등", Vector2(-900, -640), 90.0, 620.0, 110.0, 380.0, 0.42)
	_연출빛(오, "계단창빛", Vector2(1895, 300), 125.0, 720.0, 190.0, 540.0, 0.50)
	_연출빛(오, "홀천장등", Vector2(2010, 140), 90.0, 640.0, 110.0, 640.0, 0.46)

	# ── 실제 광원 ── 빛기둥은 "빛줄기 그림" 이고, 주변을 밝히는 것은 `발광체` 다.
	#   둘을 같이 써야 "저기 등이 있고 그 아래가 밝다" 가 성립한다(빛줄기만 있으면
	#   허공에 뜬 반투명 삼각형처럼 보인다 — 실제로 v1 첫 스크린샷이 그랬다).
	#   깜빡임을 아주 낮게 둬서 반딧불이(0.30)와 성격을 구분한다 — 등은 가만히 있다.
	_등불(오, "등_복도_A", Vector2(-1450, -300), 360.0, 0.62, 0.08)
	_등불(오, "등_복도_B", Vector2(-500, -300), 360.0, 0.62, 0.08)
	_등불(오, "등_계단참", Vector2(880, 200), 400.0, 0.55, 0.10)
	_등불(오, "등_홀샹들리에", Vector2(2010, 150), 560.0, 0.72, 0.05)


func _연출빛(층: Node2D, 이름: String, 자리: Vector2, 각도: float, 길이: float,
		시작폭: float, 끝폭: float, 세기: float) -> void:
	var l: Node2D = 빛기둥_S.new()
	l.name = 이름
	l.position = 자리
	l.set("모드", 빛기둥_S.모드_.연출)
	l.set("각도", 각도)                    # 0°=오른쪽, 90°=아래 (시계 방향)
	l.set("길이", 길이)
	l.set("시작폭", 시작폭)
	l.set("끝폭", 끝폭)
	l.set("세기", 세기)
	l.set("구멍_그리기", false)            # 창·전등이라 천장에 구멍을 뚫으면 안 된다
	l.set("먼지", 20)
	층.add_child(l)


## 벽등·천장등의 **빛 웅덩이**. `발광체(구슬)` 를 광원으로만 쓴다.
func _등불(층: Node2D, 이름: String, 자리: Vector2, 반경: float,
		밝기: float, 깜빡임: float) -> void:
	var l: Node2D = 발광체_S.new()
	l.name = 이름
	l.position = 자리
	l.set("종류", 발광체_S.종류_.구슬)
	l.set("빛색", Color(1.0, 0.96, 0.88))
	l.set("반경", 반경)
	l.set("밝기", 밝기)
	l.set("깜빡임", 깜빡임)
	l.set("크기_흔들림", 0.06)      # 등은 거의 안 흔들린다
	l.set("흔들림_속도", 0.25)
	l.set("부유", 0.0)              # 등은 떠다니지 않는다
	l.set("알갱이_보이기", false)    # ★등은 **빛만**. 흰 알갱이를 그리면 반딧불이와 구분이 안 된다
	층.add_child(l)


