## ▣ 왜 이렇게 나눴나
##   복도·계단 원화가 없으니, 있는 원화를 **원래 배율 그대로** 이어 붙였다.
##   늘여 붙이면 문·가구가 옆으로 퍼져 바로 티가 난다 — 그래서 한 번도 안 늘렸다.
##
##   방 원화 5 장(660 폭)이 x −1700 … 1600 을 덮고,
##   거실 원화 1 장(1921.5 폭)이 x 1240 … 3161.5 을 덮는다.
##   x 1240~1600 에서 360px 겹치는데, 거실 쪽을 **한 단 앞(z −59)** 에 둬서
##   계단 한가운데에서 벽지가 방 → 거실로 바뀐다. 층이 바뀌었다는 신호다.
func _배경들(루트: Node2D) -> void:
	# ── 2층: room.png 왼쪽 크롭 **한 장**. 이어 붙이지도 반전하지도 않는다 ──
	var 판: Node2D = 실내배경_S.new()
	판.name = "배경_2층_복도"
	판.set("영역", Rect2(방_패널_왼, 방_패널_위, 방_패널.x, 방_패널.y))
	판.set("아래_방", 실내배경_S.방_.이층방)
	판.set("위_방", 실내배경_S.방_.이층방)
	판.set("그림_아래", load(원화_방))
	판.set("그림_원본영역", 방_크롭)
	판.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)   # 영역이 크롭 비율과 같아 왜곡 0
	판.set("그림_밝기", 원화_밝기)
	판.set("좌우반전", false)                      # ★반전 금지
	_방섞임_끄기(판)
	판.z_index = -60
	판.z_as_relative = false
	루트.add_child(판)

	# ── 1층: livingroom.png 한 장 ──
	# 원화의 바닥·천장선이 이 스테이지의 1층 바닥(770)·천장(−30)과 맞도록 역산한 자리다.
	var 아래: Node2D = 실내배경_S.new()
	아래.name = "배경_1층_거실원화"
	아래.set("영역", Rect2(거실_패널_왼, 거실_패널_위, 거실_패널.x, 거실_패널.y))
	아래.set("아래_방", 실내배경_S.방_.거실)
	아래.set("위_방", 실내배경_S.방_.거실)
	아래.set("그림_아래", load(원화_거실))
	아래.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)      # 영역 = 원화 × 0.9 라 왜곡 0
	아래.set("그림_밝기", 원화_밝기)
	_방섞임_끄기(아래)
	아래.z_index = -59                                  # ★방 원화보다 한 단 앞
	아래.z_as_relative = false
	루트.add_child(아래)

	# ── 1층 앞바닥 ── 원화의 **앞쪽 바닥 띠**만 떠서 플레이어 앞(z +40)에 한 겹 더.
	#   ① 2.5D 깊이감 ② 바닥 지형(두께 300)의 벽돌 민낯이 원화 마룻바닥을 덮는 것을 가린다.
	var 앞: Node2D = 실내배경_S.new()
	앞.name = "앞바닥_1층"
	# ⚠ 띠의 시작 py 는 원화 **바닥선(963)보다 조금 아래**여야 한다.
	#   905 로 뒀더니 띠가 바닥선보다 58px 위에서 시작해 **플레이어를 통째로 가렸다**
	#   (스크린샷에서 머리만 보였다). 975 = 바닥선 + 12px — 발밑만 살짝 덮는다.
	앞.set("영역", Rect2(거실_패널_왼, 거실_패널_위 + 975.0 * 거실_배율,
		거실_패널.x, (1200.0 - 975.0) * 거실_배율))
	앞.set("그림_아래", load(원화_거실))
	앞.set("그림_원본영역", Rect2(0.0, 975.0, 2135.0, 1200.0 - 975.0))
	앞.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	앞.set("그림_밝기", 원화_밝기)
	앞.set("앞에_그리기", true)
	앞.z_index = 40
	앞.z_as_relative = false
	루트.add_child(앞)


