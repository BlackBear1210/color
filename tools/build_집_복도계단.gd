# 장식 — 콜리전이 **없는** 레이어 (도형님 지시 §19 마지막 줄)
# ============================================================================
## 난간·걸레받이·계단 코 선. 전부 Line2D 라 물리에 전혀 안 걸린다.
##   `뒤`(z −3) : 계단 난간 — **플레이어 뒤**. 안 그러면 손잡이가 얼굴을 가로지른다.
##   `앞`(z  3) : 계단 코·문틀·걸레받이 — 지형 위에 얹혀야 보이는 것들.
func _난간과_소품(뒤: Node2D, 앞: Node2D) -> void:
	var 단 := _계단단()

	# ── 계단 난간 ── 각 단 윗면에서 일정 높이 위를 잇는 사선 두 줄 + 동자기둥.
	# 높이 190 = 플레이어 그림 높이(130)보다 확실히 위. 몸을 가리지 않고 공간만 만든다.
	var 손잡이 := PackedVector2Array()
	손잡이.append(Vector2(계단_시작x, 이층 - 190))
	for s in 단:
		손잡이.append(Vector2(float(s[1]), float(s[2]) - 190.0))
	_선(뒤, "난간_손잡이", 손잡이, 10.0, Color(0.34, 0.33, 0.31, 0.95))

	var 아래살 := PackedVector2Array()
	아래살.append(Vector2(계단_시작x, 이층 - 96))
	for s in 단:
		아래살.append(Vector2(float(s[1]), float(s[2]) - 96.0))
	_선(뒤, "난간_아래살", 아래살, 5.0, Color(0.28, 0.27, 0.26, 0.85))

	for i in 단.size():
		var s: Array = 단[i]
		var x := float(s[1])
		var y := float(s[2])
		_선(뒤, "난간_동자_%02d" % i,
			PackedVector2Array([Vector2(x, y), Vector2(x, y - 190.0)]),
			6.0, Color(0.30, 0.29, 0.28, 0.9))

	# ── 계단 코(nosing) ── 단마다 윗면 앞쪽에 밝은 선 한 줄.
	# 계단이 몇 단인지 눈으로 세어지게 만드는 장치다. 어두운 화면에서 이게 없으면
	# 벽돌 덩어리가 그냥 비스듬한 경사로 읽힌다.
	for i in 단.size():
		var s: Array = 단[i]
		_선(앞, "계단코_%02d" % i, PackedVector2Array([
			Vector2(float(s[0]), float(s[2]) - 3.0),
			Vector2(float(s[1]), float(s[2]) - 3.0),
		]), 4.0, Color(0.58, 0.57, 0.55, 0.60))

	# ── 좁은 통로 문틀 ── 통로 입구·출구에 세로 선 한 쌍. "여기서부터 좁아진다".
	for x in [-200.0, 계단_시작x]:
		_선(앞, "문틀_%d" % int(x), PackedVector2Array([
			Vector2(x, 이층), Vector2(x, -200.0),
		]), 7.0, Color(0.38, 0.37, 0.35, 0.9))

	# ── 걸레받이 ── 바닥선을 한 줄 그어 넓은 바닥이 허전하지 않게.
	_선(앞, "걸레받이_1층", PackedVector2Array([
		Vector2(1780, 일층 - 4), Vector2(3160, 일층 - 4),
	]), 5.0, Color(0.26, 0.25, 0.24, 0.8))
	_선(앞, "걸레받이_2층_a", PackedVector2Array([
		Vector2(-1700, 이층 - 4), Vector2(-1180, 이층 - 4),
	]), 5.0, Color(0.26, 0.25, 0.24, 0.8))
	_선(앞, "걸레받이_2층_b", PackedVector2Array([
		Vector2(-980, 이층 - 4), Vector2(-200, 이층 - 4),
	]), 5.0, Color(0.26, 0.25, 0.24, 0.8))


func _선(층: Node2D, 이름: String, 점들: PackedVector2Array, 굵기: float, 색: Color) -> void:
	var l := Line2D.new()
	l.name = 이름
	l.points = 점들
	l.width = 굵기
	l.default_color = 색
	l.joint_mode = Line2D.LINE_JOINT_ROUND
	l.begin_cap_mode = Line2D.LINE_CAP_ROUND
	l.end_cap_mode = Line2D.LINE_CAP_ROUND
	층.add_child(l)


# ============================================================================
# 공용 — build_집_배경스테이지.gd 와 같은 규약
# ============================================================================
## Template 씬을 인스턴스하고 **점만 갈아 끼운다.** 재질·엣지·코너·taper 는 안 건드린다
## (README_지형찍기 §12: 작업자는 "모양"만 만든다).
##
## ⚠ 스마트지형을 **활성 트리에 넣으면 안 된다**(_ready 가 재질을 깊은 복사한다).
##   여기서는 오프라인 조립만 하고 마지막에 pack 한다.
##
## ⚠⚠ 예전에 `set("_meshes", [])` 로 Template 의 구운 메시를 지우려 했지만 **소용없다.**
##   `_meshes` 는 타입 있는 배열이라 타입 없는 `[]` 는 조용히 무시되고, 타입을 맞춰
##   비워도 빈 배열은 프로퍼티 기본값이라 `pack()` 이 저장하지 않는다.
##   → 진짜 해결은 런타임 쪽: `scripts/스마트월드/지형.gd _ready()` 가
##     `super()` 앞에서 `_meshes.clear()` 한다. 그래야 반드시 새 점으로 다시 굽는다.
func _지형(층: Node2D, 템플릿: String, 이름: String, 월드점들: PackedVector2Array,
		칠가능: bool, 유령: bool = false) -> void:
	var 씬 := load(템플릿) as PackedScene
	var 지형: Node2D = 씬.instantiate()
	지형.name = 이름

	var 최소 := 월드점들[0]
	var 최대 := 월드점들[0]
	for p in 월드점들:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	var 중심 := (최소 + 최대) * 0.5
	지형.position = 중심

	지형.set("칠하기_허용", 칠가능)
	지형.set("무색일때_통과", 유령)

	var 점배열 := SS2D_Point_Array.new()
	var 로컬 := PackedVector2Array()
	for p in 월드점들:
		로컬.append(p - 중심)
	점배열.add_points(로컬)
	점배열.close_shape()               # ★닫혀야 fill 메시가 생긴다
	지형.set_point_array(점배열)

	var 폴리 := 지형.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	if 폴리 != null:
		var 생성기 := SS2D_CollisionGen.new()
		생성기.collision_size = 지형.collision_size
		생성기.collision_offset = 지형.collision_offset
		폴리.polygon = 생성기.generate_filled(점배열.get_tessellated_points())

	층.add_child(지형)


## 축 정렬 사각형(시계방향). README §20 — 비스듬한 변이 있는 폐곡선은 금지.
func _사각(x0: float, y0: float, x1: float, y1: float) -> PackedVector2Array:
	return PackedVector2Array([
		Vector2(x0, y0), Vector2(x1, y0), Vector2(x1, y1), Vector2(x0, y1),
	])


## 계단식 **윗면**을 가진 덩어리. `단` = [[왼x, 오른x, 윗면y], ...] 를 왼→오른 순서로.
## 바닥y 까지 통째로 채운다. 감김은 시계방향(SS2D 볼록분해가 방향에 민감하다).
func _계단덩어리(단: Array, 바닥y: float) -> PackedVector2Array:
	var 점 := PackedVector2Array()
	for s in 단:
		점.append(Vector2(float(s[0]), float(s[2])))
		점.append(Vector2(float(s[1]), float(s[2])))
	점.append(Vector2(float(단[단.size() - 1][1]), 바닥y))
	점.append(Vector2(float(단[0][0]), 바닥y))
	return 점


## 계단식 **아랫면**을 가진 천장. `단` = [[왼x, 오른x, 아랫면y], ...], 윗면y 까지 채운다.
## ⚠ `_계단덩어리` 를 그냥 뒤집으면 감김이 반시계가 되어 `Convex decomposing failed!`
##   가 뜨면서 **조용히 못 밟는 지형**이 된다(2026-08-06 에 벽 지형에서 실제로 겪었다).
##   그래서 윗변을 왼→오, 아랫면을 오→왼 순서로 따로 쌓는다.
func _계단천장(단: Array, 윗면y: float) -> PackedVector2Array:
	var 점 := PackedVector2Array()
	점.append(Vector2(float(단[0][0]), 윗면y))
	점.append(Vector2(float(단[단.size() - 1][1]), 윗면y))
	for i in range(단.size() - 1, -1, -1):
		var s: Array = 단[i]
		점.append(Vector2(float(s[1]), float(s[2])))
		점.append(Vector2(float(s[0]), float(s[2])))
	return 점


func _통로(층: Node2D, 이름: String, 자리: Vector2, 출구인가: bool, 다음: String) -> void:
	var t: Node2D = 통로_S.new()
	t.name = 이름
	t.position = 자리
	t.set("역할", 통로_S.역할_.출구 if 출구인가 else 통로_S.역할_.입구)
	t.set("높이", 170.0)
	t.set("깊이", 420.0)
	t.set("속빛", Color(0.30, 0.31, 0.34))
	if 출구인가:
		t.set("다음_씬", 다음)
		t.set("다음_진입점", "입구통로")
	층.add_child(t)


## ★★[2026-09-01] `실내배경.gd` 의 **코드 그림**이 원화를 덮는 것을 막는다.
##
## ▣ 원리 (STAGE 1 에서 이미 한 번 크게 데인 곳이다)
##   `실내배경.gd` 는 원래 위·아래로 이어진 두 방을 카메라 높이로 크로스페이드하는 노드다.
##     `if 섞임 > 0.002: _방_그리기(위_방, 섞임, 그림_위)`  ← `그림_위` 가 null 이면 **코드 벽지**
##   기본값이 `전환_시작y 0 · 전환_끝y −900` 이라, 방이 그보다 높으면 섞임이 1.0 이 되어
##   코드로 그린 줄무늬 벽지가 **원화를 100% 덮는다.**
##   → 두 값을 같게 두면 `섞임_계산()` 이 0 을 돌려줘 **원화만** 그린다.
##   ⚠ 배경을 새로 놓을 때마다 반드시 꺼야 한다.
func _방섞임_끄기(배경: Node2D) -> void:
	배경.set("전환_시작y", 0.0)
	배경.set("전환_끝y", 0.0)


## 계단식 **얇은 판**. `단` = [[왼x, 오른x, 윗면y], ...] · 아랫면은 윗면 + 두께.
## ★`_계단덩어리` 와 다른 점: 덩어리는 바닥까지 통째로 채워 **배경을 다 가린다.**
##   이건 계단 모양 그대로 두께만 얹어서, 계단 아래로 원화가 그대로 보인다.
##   (STAGE 1 `build_스테이지_1_2층방.gd::_계단선반()` 과 같은 함수다)
## ⚠ 두께는 단 높이(110)보다 커야 이웃한 단이 서로 붙는다. 작으면 계단이 조각난다.
func _계단선반(단: Array, 두께: float) -> PackedVector2Array:
	var 점 := PackedVector2Array()
	for s in 단:                                   # 윗면 (왼 → 오른)
		점.append(Vector2(float(s[0]), float(s[2])))
		점.append(Vector2(float(s[1]), float(s[2])))
	for i in range(단.size() - 1, -1, -1):          # 아랫면 (오른 → 왼)
		var s: Array = 단[i]
		점.append(Vector2(float(s[1]), float(s[2]) + 두께))
		점.append(Vector2(float(s[0]), float(s[2]) + 두께))
	return 점
