# 색 · 페인트
# ============================================================================
func _색바꾸기(목표: int) -> bool:
	if int(_p.get("player_color")) == 목표:
		return true
	await _색누르기(목표)
	for i in 10:
		await physics_frame
		if not _살아있나():
			return false
	if int(_p.get("player_color")) != 목표:
		_실패 = "색이 안 바뀌었다 (경계에 걸쳐 있나?)"
		return false
	return true


## toggle_color 를 두 프레임 눌러 준다. 한 프레임만 누르면 is_action_just_pressed 를 놓친다.
func _색누르기(_목표: int) -> void:
	Input.action_press("toggle_color")
	await physics_frame
	await physics_frame
	Input.action_release("toggle_color")


## 총을 쏜 것과 같은 상태를 만든다. 총알 궤적은 흉내내지 않는다 —
## `총.gd` 이 하는 일(발사_소모 → 명중_처리)을 그대로 부른다.
func _칠하기(이름: String, 색: int) -> bool:
	var 대상 := _찾기(_씬, 이름)
	if 대상 == null:
		_실패 = "%s 를 못 찾았다" % 이름
		return false
	var 횟수 := int(대상.call("필요횟수")) if 대상.has_method("필요횟수") \
		else int(대상.get("필요횟수"))
	# ★총알 색은 **플레이어 색**이다(`총.gd`). 검정인 채로 흰 페인트를 쏠 수 없다.
	#   이걸 안 보면 공략이 "칠할 수 없는 색을 칠했다" 로 조용히 통과해 버린다.
	var 지금색 := int(_p.get("player_color"))
	if 지금색 != 색:
		_실패 = "%s 를 %s 으로 칠하려는데 플레이어는 %s 이다" % [
			이름, ("흰색" if 색 == 흰색 else "검정"),
			("흰색" if 지금색 == 흰색 else "검정")]
		return false
	var 좌표: Vector2 = (대상 as Node2D).global_position
	for i in maxi(횟수, 1):
		if _코어 and not bool(_코어.call("쏠_수_있나")):
			_실패 = "탄약이 없다 (%s 를 칠하는 중)" % 이름
			return false
		if _코어:
			_코어.call("발사_소모")
			var r: String = _코어.call("명중_처리", 대상, 색, 좌표)
			if _수다:
				print("      · %s %d발째 → %s" % [이름, i + 1, r])
		else:
			대상.call("명중", 색, 좌표)
	if _수다:
		var 진행 = 대상.get("_진행")
		print("      · %s 필요=%d 검정발=%s 흰발=%s 긴변=%s 전체가능=%s" % [이름, 횟수,
			str(진행.횟수(0)) if 진행 else "?", str(진행.횟수(1)) if 진행 else "?",
			str(대상.get("_긴변")),
			str(대상.call("전체_색칠_가능")) if 대상.has_method("전체_색칠_가능") else "?"])
	if _수다 and 대상.has_method("현재색"):
		print("      · %s 칠한 뒤 현재색=%d" % [이름, int(대상.call("현재색"))])
	return true


## 뛰지 않고 걸어서 간다. 가장자리에서 그냥 **떨어져 내려갈 때** 쓴다 —
## 자동 점프를 켜 두면 위 발판 밑면에 머리를 박고 제자리에 떨어진다(2-2 발판 7).
func _걸어(목표x: float, 착지y: float) -> bool:
	if not await _가기(목표x, 900, false):
		return false
	if absf(_p.global_position.y - 착지y) > 30.0:
		_실패 = "y %.0f 에 내려야 하는데 %.0f" % [착지y, _p.global_position.y]
		return false
	return true


## 레버 앞까지 걸어가 E 를 누른다. `월드.gd` 의 E 중재와 같은 경로를 쓰되,
## **`닿아있나()` 가 참일 때만** 조작한다 — 멀리서 조작하면 검사가 거짓말이 된다.
func _레버(이름: String) -> bool:
	var n := _찾기(_씬, 이름)
	if n == null:
		_실패 = "%s 없음" % 이름
		return false
	var 위치: Vector2 = (n as Node2D).global_position
	if not await _가기(위치.x, 900):
		return false
	for i in 6:
		await physics_frame
		if not _살아있나():
			return false
	if not bool(n.call("닿아있나")):
		_실패 = "%s 에 손이 안 닿는다 (플레이어 x=%.0f · 레버 x=%.0f)" % [
			이름, _p.global_position.x, 위치.x]
		return false
	n.call("조작")
	for i in 10:
		await physics_frame
		if not _살아있나():
			return false
	return true


## 양동이·박스를 목표 x 까지 민다. 몸으로 밀어야 하므로 자동 점프는 끈다.
func _밀기(이름: String, 목표x: float) -> bool:
	var n := _찾기(_씬, 이름)
	if n == null:
		_실패 = "%s 없음" % 이름
		return false
	var 물체 := n as Node2D
	var 방향 := "move_right" if 목표x > 물체.global_position.x else "move_left"
	# 먼저 물체의 반대쪽으로 가서 붙는다
	var 뒤 := 물체.global_position.x + (-90.0 if 방향 == "move_right" else 90.0)
	if not await _가기(뒤, 900):
		return false
	Input.action_press(방향)
	var 이전 := 물체.global_position.x
	var 정체 := 0
	for i in 1800:
		await physics_frame
		if not _살아있나():
			Input.action_release(방향)
			return false
		var x := 물체.global_position.x
		if _수다 and i % 30 == 0:
			print("      · %s x=%.0f · 플레이어 x=%.0f vx=%.0f 벽=%s 충돌수=%d" % [
				이름, x, _p.global_position.x, _p.velocity.x, str(_p.is_on_wall()),
				_p.get_slide_collision_count()])
		if absf(x - 목표x) < 26.0:
			Input.action_release(방향)
			return true
		# [2026-09-21] 양동이가 물을 받아 굳는 자리는 물띠 폭에 따라 10~20 px 흔들린다 → 목표 60 안에서 담겼으면 성공.
		if "물참" in n and bool(n.get("물참")) and absf(x - 목표x) < 60.0:
			Input.action_release(방향)
			return true
		if absf(x - 이전) < 0.3:
			정체 += 1
			if 정체 > 240:
				_실패 = "%s 가 x=%.0f 에서 안 밀린다 (목표 %.0f)" % [이름, x, 목표x]
				break
		else:
			정체 = 0
			이전 = x
	Input.action_release(방향)
	if _실패.is_empty():
		_실패 = "%s 를 목표까지 못 밀었다" % 이름
	return false


## [2026-09-22] 분사기가 칠하는 발판의 색이 바뀔 때까지 서서 본다(2-11 다리) — 사람이 "색을 읽고 건너는" 것과 같다. 최대 20 초.
func _색기다림(이름: String, 색: int) -> bool:
	var n := _찾기(_씬, 이름)
	if n == null or not n.has_method("현재색"):
		_실패 = "%s 없음(현재색 없음)" % 이름
		return false
	for i in 1200:
		await physics_frame
		if not _살아있나():
			return false
		if int(n.call("현재색")) == 색:
			return true
	_실패 = "%s 가 %s 이 안 된다(지금 %d)" % [이름, ("흰색" if 색 == 흰색 else "검정"), int(n.call("현재색"))]
	return false


## ★[2026-10-03] 걸어서 가장자리를 벗어나(자동 점프 없음) 발이 뜨면 색을 바꾸고, 목표x 에서 방향키를 놓아 그대로 떨어진다.
func _떨어져색(목표x: float, 착지y: float, 색: int) -> bool:
	var 방향 := "move_right" if 목표x > _p.global_position.x else "move_left"
	var 부호 := 1.0 if 방향 == "move_right" else -1.0
	Input.action_press(방향)
	var 바꿈 := false
	var 놓음 := false
	var 떴다 := false
	var 시작y := _p.global_position.y
	for i in 600:
		await physics_frame
		if not _살아있나():
			_입력_해제()
			return false
		# 경사로·턱에서 잠깐 뜨는 것은 떨어진 것이 아니다 — 출발 높이보다 8 넘게 내려가야 "떨어졌다".
		if not _p.is_on_floor() and _p.global_position.y > 시작y + 8.0:
			떴다 = true
		if 떴다 and not 바꿈:
			await _색누르기(색)
			바꿈 = true
		if not 놓음 and (_p.global_position.x - 목표x) * 부호 >= 0.0:
			Input.action_release(방향)
			놓음 = true
		if 떴다 and _p.is_on_floor():
			Input.action_release(방향)
			if absf(_p.global_position.y - 착지y) > 30.0:
				_실패 = "y %.0f 에 내려야 하는데 %.0f" % [착지y, _p.global_position.y]
				return false
			return true
	_입력_해제()
	_실패 = "x=%.0f 에서 떨어지지 못했다" % 목표x
	return false


## ★[2026-10-03] 번갈이 물(2-2) — 그 물이 꺼졌다가 **다시 켜지는 순간**까지 기다린다.
##   이미 켜져 있으면 한 번 꺼지는 것을 본 뒤에 돌려준다 → 돌아온 순간부터 켜진 시간(3 초)을 통째로 쓴다.
func _켜짐기다림(이름: String) -> bool:
	var n := _찾기(_씬, 이름)
	if n == null or not ("켜짐" in n):
		_실패 = "%s 없음(켜짐 없음)" % 이름
		return false
	var 꺼진걸봄 := not bool(n.get("켜짐"))
	for i in 900:
		await physics_frame
		if not _살아있나():
			return false
		var 켜짐 := bool(n.get("켜짐"))
		if not 켜짐:
			꺼진걸봄 = true
		elif 꺼진걸봄:
			return true
	_실패 = "%s 가 15 초 안에 다시 켜지지 않는다" % 이름
	return false


## ★[2026-10-03] 도약대(2-2 방방) — 도약대 가운데로 걸어가(턱 23px 는 벽으로 읽혀 뛰어 올라탄다) 튕긴 뒤,
##   올라가는 속도가 400 아래로 줄면 착지x 쪽으로 꺾는다. 일찍 꺾으면 선반 옆면·밑면에 머리를 박는다.
func _튕겨(이름: String, 착지x: float, 착지y: float) -> bool:
	var d := _찾기(_씬, 이름) as Node2D
	if d == null:
		_실패 = "%s 없음" % 이름
		return false
	var 도약속도 := float(d.get("도약속도"))
	var 방향 := "move_right" if d.global_position.x > _p.global_position.x else "move_left"
	Input.action_press(방향)
	var 누름 := false
	var 튐 := false
	var 꺾음 := false
	var 도착 := false
	for i in 900:
		await physics_frame
		if not _살아있나():
			_입력_해제()
			return false
		if _수다 and i < 90 and i % 3 == 0:
			print("        튕겨 t%d (%.0f,%.0f) vy=%.0f floor=%s wall=%s 튐=%s 꺾음=%s 속도=%.0f" % [i, _p.global_position.x,
				_p.global_position.y, _p.velocity.y, str(_p.is_on_floor()), str(_p.is_on_wall()), str(튐), str(꺾음), 도약속도])
		if not 튐:
			var 위 := absf(_p.global_position.x - d.global_position.x) < float(d.get("폭")) * 0.5
			if not 누름 and _p.is_on_floor() and _p.is_on_wall():
				Input.action_press("jump")
				누름 = true
			elif 누름 and not 위 and not _p.is_on_floor() and _p.velocity.y >= 0.0:
				# 턱을 오르는 점프는 정점에서 뗀다 — 단 도약대 위에서는 떼지 않는다(떼면 튕김이 잘린다)
				Input.action_release("jump")
				누름 = false
			if absf(_p.global_position.x - d.global_position.x) < 12.0:
				Input.action_release(방향)
			# ★도약대 위로 떨어지는 동안 점프를 누르고 있는다 — 튄 뒤 올라가는 중에 점프가 떼어져 있으면
			#   플레이어의 점프 컷(×0.4)이 튕김을 418 → 150 으로 잘라 버린다(2-2 첫 주행 실측). 사람도 누르고 있다.
			if not 누름 and not _p.is_on_floor() and _p.velocity.y > 0.0 \
					and absf(_p.global_position.x - d.global_position.x) < float(d.get("폭")) * 0.5:
				Input.action_press("jump")
				누름 = true
			if _p.velocity.y <= 도약속도 * 0.8:
				튐 = true
				Input.action_release(방향)
				if not 누름:
					Input.action_press("jump")
					누름 = true
				방향 = "move_right" if 착지x > _p.global_position.x else "move_left"
			continue
		# 정점을 지나면 점프를 뗀다(JUMP_CUT 방지와 같은 규칙)
		if 누름 and _p.velocity.y >= 0.0:
			Input.action_release("jump")
			누름 = false
		if not 꺾음 and _p.velocity.y > -400.0:
			Input.action_press(방향)
			꺾음 = true
		if 꺾음 and not 도착 and (_p.global_position.x - 착지x) * (1.0 if 방향 == "move_right" else -1.0) >= 0.0:
			Input.action_release(방향)
			도착 = true
		if 꺾음 and _p.is_on_floor():
			Input.action_release(방향)
			if absf(_p.global_position.y - 착지y) > 30.0:
				_실패 = "도약대 착지를 놓쳤다 — y %.0f 에 내려야 하는데 %.0f" % [착지y, _p.global_position.y]
				return false
			return true
	_입력_해제()
	_실패 = "%s 로 튕겨 (%.0f,%.0f) 에 못 내렸다" % [이름, 착지x, 착지y]
	return false


## [2026-09-22] 탐색용 — 플레이어를 그 자리에 놓고 발이 땅에 닿을 때까지 기다린다.
##   ⚠ 정답 공략에는 쓰지 않는다(실제로 못 가는 길을 간 것처럼 읽힌다). 남의 씬을 살펴보거나 "설계된 시작 위치" 가 Player 노드와 다를 때만.
func _순간이동(x: float, y: float) -> bool:
	_p.global_position = Vector2(x, y - 2.0)
	_p.velocity = Vector2.ZERO
	_마지막위치 = _p.global_position          # 위치가 튄 것을 사망으로 읽지 않게
	for i in 60:
		await physics_frame
		if not _살아있나():
			return false
		if _p.is_on_floor():
			return true
	_실패 = "순간이동 뒤 발이 땅에 안 닿는다 (%.0f,%.0f)" % [_p.global_position.x, _p.global_position.y]
	return false


## [2026-09-22] 움직이는 발판(승강기) 기다리기 — 노드의 x 또는 y 가 값 ±24 안에 올 때까지 가만히 선다(최대 900 프레임 = 15 초).
##   타고 있는 동안에도 쓴다: 발판이 목적지에 닿을 때까지 아무 키도 안 누른다(AnimatableBody 가 몸을 실어 나른다).
func _기다림(이름: String, 축: String, 값: float) -> bool:
	var n := _찾기(_씬, 이름) as Node2D
	if n == null:
		_실패 = "%s 없음" % 이름
		return false
	for i in 900:
		await physics_frame
		if not _살아있나():
			return false
		var v := n.global_position.x if 축 == "x" else n.global_position.y
		if absf(v - 값) < 24.0:
			return true
	_실패 = "%s 의 %s 가 %.0f 에 안 온다 (지금 %.0f)" % [이름, 축, 값, (n.global_position.x if 축 == "x" else n.global_position.y)]
	return false


## [2026-09-21] 물을 실은 양동이 옆에 서서 E — 월드.gd 가 하듯 `닿아있나` → `비우기()`. 배출구 밖이면 양동이가 false 를 준다.
func _비우기(이름: String) -> bool:
	var n := _찾기(_씬, 이름)
	if n == null:
		_실패 = "%s 없음" % 이름
		return false
	var 물체 := n as Node2D
	if not await _가기(물체.global_position.x - 70.0, 900):
		return false
	for i in 6:
		await physics_frame
	if not bool(n.call("닿아있나", _p)):
		_실패 = "%s 에 손이 안 닿는다 (플레이어 x=%.0f · 양동이 x=%.0f)" % [이름, _p.global_position.x, 물체.global_position.x]
		return false
	if not bool(n.call("비우기")):
		_실패 = "%s 를 못 비웠다 (물참=%s · 배출구 안=%s)" % [이름, str(n.get("물참")),
			str(n.call("배출구_안인가")) if n.has_method("배출구_안인가") else "?"]
		return false
	for i in 12:
		await physics_frame
	return _살아있나()


## 노드가 지금 실제로 어떤 상태인지 찍는다 (유령이 단단해졌는가 등).
func _확인(이름: String) -> bool:
	var n := _찾기(_씬, 이름)
	if n == null:
		_실패 = "%s 없음" % 이름
		return false
	# ★[2026-09-17] 호퍼는 물리 프레임에서 입구 물을 섞는다. 칠한 직후 같은 프레임에 읽으면 **칠하기 전 색**이 찍힌다
	#   (2-4 에서 저장고를 검정으로 칠했는데 출구가 흰색(1)으로 나와 한참 헤맸다). 몇 프레임 기다린 뒤 읽는다.
	for i in 12:
		await physics_frame
	var 색 := int(n.call("현재색")) if n.has_method("현재색") else -9
	var 레이어 := -1
	var 폴리 := n.get_node_or_null("StaticBody2D") as CollisionObject2D
	if 폴리:
		레이어 = 폴리.collision_layer
	var 덧 := ""
	if "물참" in n:
		덧 = " 물참=%s 물색=%s" % [str(n.get("물참")), str(n.get("물색"))]
	if "켜짐" in n:
		덧 += " 켜짐=%s" % str(n.get("켜짐"))
	print("      · %s 현재색=%d 레이어=%d 밟을수있나=%s%s · 위치=(%.0f,%.0f)" % [이름, 색, 레이어,
		str(n.call("밟을_수_있나")) if n.has_method("밟을_수_있나") else "?", 덧,
		(n as Node2D).global_position.x, (n as Node2D).global_position.y])
	return true


func _쉬기(프레임: int) -> bool:
	for i in 프레임:
		await physics_frame
		if not _살아있나():
			return false
	return true


