## ★[2026-10-03] 걸어서 가장자리를 벗어나(자동 점프 없음) 발이 뜨면 색을 바꾸고, 목표x 에서 방향키를 놓아 그대로 떨어진다.
func _떨어져색(목표x: float, 착지y: float, 색: int) -> bool:
	var 방향 := "move_right" if 목표x > _p.global_position.x else "move_left"
	var 부호 := 1.0 if 방향 == "move_right" else -1.0
	Input.action_press(방향)
	var 바꿈 := false
	var 놓음 := false
	var 떴다 := false
