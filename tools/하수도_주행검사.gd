		# 방 5: 레버 → 붕괴 발판 1·2 → (3 은 128 폭이라 한 번에 못 내린다 · 검사기는 2 에서 너머 바닥(15360~)으로 곧장) → 열린 수문 → 계단 → 출구
		["레버", "구역5_폭포차단_레버"],
		["확인", "구역5_폭포1"],
		["가", 14300.0],
		["뛰기", 14314.0, 14700.0, 7168.0],        # 붕괴 발판 1(14592~14784)
		["뛰기", 14762.0, 15000.0, 7168.0],        # 붕괴 발판 2(14912~15104)
		["뛰기", 15082.0, 15400.0, 7168.0],        # 너머 바닥(15360~)
		["가", 15700.0],                           # 열린 수문(15680)
		["걸어", 16050.0, 7264.0],
		["걸어", 16240.0, 7584.0],
		["걸어", 16430.0, 7904.0],
