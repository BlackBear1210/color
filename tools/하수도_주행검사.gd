}

var _씬: Node2D
var _p: CharacterBody2D
var _월드: Node
var _코어: Node
var _사망: int = 0
var _마지막위치: Vector2
var _실패: String = ""
var _수다 := false


func _initialize() -> void:
	Engine.max_fps = 0
	_실행()


func _실행() -> void:
	_수다 = Array(OS.get_cmdline_user_args()).has("--수다")
	var 인자: Array = Array(OS.get_cmdline_user_args()).filter(
		func(a): return not String(a).begins_with("--"))
	var 대상: Array = 기본대상.duplicate() if 인자.is_empty() else 인자
	print("\n════════ 하수도 공략 주행 검사 ════════")
	print("※ 공략표(tools/하수도_주행검사.gd §공략)를 실제 물리로 태운다. 색·물·탄약 전부 산다.\n")
	var 모두통과 := true
	for 경로 in 대상:
		if not await _한판(String(경로)):
			모두통과 = false
	print("")
	quit(0 if 모두통과 else 1)


func _한판(경로: String) -> bool:
	var ps := load(경로) as PackedScene
	if ps == null:
		print("  %s — 로드 실패" % 경로.get_file())
		return false
	_씬 = ps.instantiate() as Node2D
	root.add_child(_씬)
	await physics_frame
	await physics_frame
	await physics_frame

	_p = _씬.get_node_or_null("Player") as CharacterBody2D
	_월드 = _씬
	_코어 = _씬.get_node_or_null("페인트코어")
	_사망 = 0
	_실패 = ""
	_마지막위치 = _p.global_position

	var 이름: String = String(_씬.name)
	# ★[2026-09-14] 공략은 한 씬에 여러 벌일 수 있다 — "stage_2-1" 과 "stage_2-1 헛걸음" 처럼
	#   씬 이름 뒤에 한 칸 띄고 이름표를 붙인다(프롬프트 §5: 정답 경로 + F1 헛걸음 복귀 경로 두 벌).
	#   첫 벌은 여기서, 나머지는 씬을 새로 띄워 차례로 돈다.
	var 열쇠들: Array = []
	for k in 공략.keys():
		if String(k) == 이름 or String(k).begins_with(이름 + " "):
			열쇠들.append(String(k))
	열쇠들.sort()
	var 열쇠: String = String(이름) if 열쇠들.has(String(이름)) else (String(열쇠들[0]) if not 열쇠들.is_empty() else String(이름))
	var 단계들: Array = 공략.get(열쇠, [])
	print("── %s%s ─────────────────────────────" % [이름, "" if 열쇠 == 이름 else "  [" + 열쇠.trim_prefix(이름 + " ") + "]"])
	if 단계들.is_empty():
		print("   공략이 없다 — 건너뛴다")
		_정리()
		return true

	for i in 단계들.size():
		var 단계: Array = 단계들[i]
		var 이전 := _p.global_position
		var ok := await _단계_실행(단계)
		var 지금 := _p.global_position
		var 표시 := "%2d. %-28s (%.0f,%.0f) → (%.0f,%.0f)" % [
			i + 1, _단계_이름(단계), 이전.x, 이전.y, 지금.x, 지금.y]
		if ok and _실패.is_empty():
			print("   ✔ " + 표시)
		else:
			print("   ✖ " + 표시 + "   ← " + (_실패 if _실패 != "" else "시간초과"))
			print("   ── 여기서 막혔다. 남은 단계는 돌리지 않는다.")
			_정리()
			return false

	var 끝 := _씬.get_node_or_null("끝도달_검사점") as Node2D
	var 결과 := true
	if 끝 == null:
		print("   ⚠ 끝도달_검사점 이 없다 — 끝 지점 판정을 못 한다")
	else:
		var d := _p.global_position.distance_to(끝.global_position)
		if d <= 220.0:
			print("   ★ 끝도달_검사점(%.0f,%.0f) 까지 %.0fpx — 도달" % [
				끝.global_position.x, 끝.global_position.y, d])
		else:
			print("   ✖ 끝도달_검사점 까지 %.0fpx 남았다 — 끝까지 못 갔다" % d)
			결과 = false
	print("   사망 %d 회 · 남은 탄약 %s" % [
		_사망, str(_코어.get("남은_탄약")) if _코어 else "-"])
	_정리()
	# 나머지 벌(헛걸음·탑 등)을 같은 씬으로 이어서 돈다
	for k in 열쇠들:
		if k == 열쇠:
			continue
		if not await _한판_이름표(경로, k):
			결과 = false
	return 결과


## 같은 씬을 다시 띄워 이름표가 붙은 공략 한 벌을 돈다 (`_한판` 과 같되 열쇠를 지정한다).
func _한판_이름표(경로: String, 열쇠: String) -> bool:
	var ps := load(경로) as PackedScene
	_씬 = ps.instantiate() as Node2D
	root.add_child(_씬)
	await physics_frame
	await physics_frame
	await physics_frame
	_p = _씬.get_node_or_null("Player") as CharacterBody2D
	_월드 = _씬
	_코어 = _씬.get_node_or_null("페인트코어")
	_사망 = 0
	_실패 = ""
	_마지막위치 = _p.global_position
	var 단계들: Array = 공략.get(열쇠, [])
	print("── %s  [%s] ─────────────────────────────" % [경로.get_file().get_basename(), 열쇠.trim_prefix(경로.get_file().get_basename() + " ")])
	for i in 단계들.size():
		var 단계: Array = 단계들[i]
		var 이전 := _p.global_position
		var ok := await _단계_실행(단계)
		var 지금 := _p.global_position
		var 표시 := "%2d. %-28s (%.0f,%.0f) → (%.0f,%.0f)" % [
			i + 1, _단계_이름(단계), 이전.x, 이전.y, 지금.x, 지금.y]
		if ok and _실패.is_empty():
			print("   ✔ " + 표시)
		else:
			print("   ✖ " + 표시 + "   ← " + (_실패 if _실패 != "" else "시간초과"))
			print("   ── 여기서 막혔다. 남은 단계는 돌리지 않는다.")
			_정리()
			return false
	var 끝 := _씬.get_node_or_null("끝도달_검사점") as Node2D
	var 결과 := true
	if 끝 != null:
		var d := _p.global_position.distance_to(끝.global_position)
		if d <= 220.0:
			print("   ★ 끝도달_검사점 까지 %.0fpx — 도달" % d)
		else:
			print("   ✖ 끝도달_검사점 까지 %.0fpx 남았다" % d)
			결과 = false
	print("   사망 %d 회 · 남은 탄약 %s" % [_사망, str(_코어.get("남은_탄약")) if _코어 else "-"])
	_정리()
	return 결과


func _정리() -> void:
	_입력_해제()
	_씬.queue_free()
	_씬 = null


func _단계_이름(단계: Array) -> String:
	match String(단계[0]):
		"가":     return "가 x=%.0f" % float(단계[1])
		"뛰기":   return "뛰기 %.0f→(%.0f,%.0f)" % [float(단계[1]), float(단계[2]), float(단계[3])]
		"뛰기색": return "뛰기색 %.0f→(%.0f,%.0f) %s" % [float(단계[1]), float(단계[2]),
			float(단계[3]), ("흰색" if int(단계[4]) == 흰색 else "검정")]
		"뛰기정": return "뛰기정 %.0f→(%.0f,%.0f)" % [float(단계[1]), float(단계[2]), float(단계[3])]
		"뛰기정색": return "뛰기정색 %.0f→(%.0f,%.0f) %s" % [float(단계[1]), float(단계[2]),
			float(단계[3]), ("흰색" if int(단계[4]) == 흰색 else "검정")]
		"색":     return "색 → %s" % ("흰색" if int(단계[1]) == 흰색 else "검정")
		"칠":     return "칠 %s" % String(단계[1])
		"쉬":     return "쉬 %d" % int(단계[1])
		"확인":   return "확인 %s" % String(단계[1])
		"걸어":   return "걸어 %.0f→y%.0f" % [float(단계[1]), float(단계[2])]
		"레버":   return "레버 %s" % String(단계[1])
		"밀기":   return "밀기 %s → %.0f" % [String(단계[1]), float(단계[2])]
		"비우기": return "비우기 %s" % String(단계[1])
		"기다림": return "기다림 %s.%s≈%.0f" % [String(단계[1]), String(단계[2]), float(단계[3])]
		"순간이동": return "순간이동 → (%.0f,%.0f)" % [float(단계[1]), float(단계[2])]
		"색기다림": return "색기다림 %s = %s" % [String(단계[1]), ("흰색" if int(단계[2]) == 흰색 else "검정")]
		"뛰기두색": return "뛰기두색 %.0f→(%.0f,%.0f) %s→%s@%.0f" % [float(단계[1]), float(단계[2]), float(단계[3]),
			("흰" if int(단계[4]) == 흰색 else "검"), ("흰" if int(단계[6]) == 흰색 else "검"), float(단계[5])]
		"뛰기정경계색": return "뛰기정경계색 %.0f→(%.0f,%.0f) %s@%.0f" % [float(단계[1]), float(단계[2]), float(단계[3]),
			("흰" if int(단계[5]) == 흰색 else "검"), float(단계[4])]
		"켜짐기다림": return "켜짐기다림 %s" % String(단계[1])
		"떨어져색": return "떨어져색 %.0f→y%.0f %s" % [float(단계[1]), float(단계[2]), ("흰색" if int(단계[3]) == 흰색 else "검정")]
		"튕겨": return "튕겨 %s→(%.0f,%.0f)" % [String(단계[1]), float(단계[2]), float(단계[3])]
	return String(단계[0])


func _단계_실행(단계: Array) -> bool:
	match String(단계[0]):
		"가":     return await _가기(float(단계[1]))
		"뛰기":   return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), -1)
		"뛰기색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), int(단계[4]),
			단계.size() > 5 and String(단계[5]) == "즉시")
		"뛰기정": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), -1, false, true)
		"뛰기정색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), int(단계[4]),
			단계.size() > 5 and String(단계[5]) == "즉시", true)
		"색":     return await _색바꾸기(int(단계[1]))
		"칠":     return _칠하기(String(단계[1]), int(단계[2]))
		"쉬":     return await _쉬기(int(단계[1]))
		"확인":   return await _확인(String(단계[1]))
		"걸어":   return await _걸어(float(단계[1]), float(단계[2]))
		"레버":   return await _레버(String(단계[1]))
		"밀기":   return await _밀기(String(단계[1]), float(단계[2]))
		"비우기": return await _비우기(String(단계[1]))
		"기다림": return await _기다림(String(단계[1]), String(단계[2]), float(단계[3]))
		"순간이동": return await _순간이동(float(단계[1]), float(단계[2]))
		"색기다림": return await _색기다림(String(단계[1]), int(단계[2]))
		"뛰기두색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), int(단계[4]), true, false,
			int(단계[6]), float(단계[5]), int(단계[7]) if 단계.size() > 7 else -1)
		# ★[2026-10-03] 경계x 를 지나면 한 번만 바꾼다(짧은 점프) — 색 전환은 토글이라 "뛰기두색" 의 첫 색이 이미 몸 색이면
		#   거꾸로 바뀐다. 2-3 호퍼 리듬(앞 물을 벗어난 뒤 다음 물 전에 바꾼다)용.
		"뛰기정경계색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), -1, false, true,
			int(단계[5]), float(단계[4]), int(단계[6]) if 단계.size() > 6 else -1)
		"켜짐기다림": return await _켜짐기다림(String(단계[1]))
		"떨어져색": return await _떨어져색(float(단계[1]), float(단계[2]), int(단계[3]))
		"튕겨": return await _튕겨(String(단계[1]), float(단계[2]), float(단계[3]))
	_실패 = "모르는 단계"
	return false


# ============================================================================
# 이동
# ============================================================================
## 목표 x 까지 걸어간다. 벽에 막히거나 앞에 바닥이 없으면 점프한다.
## 자동점프 = false 면 **절대 안 뛴다.** 발판 가장자리로 걸어갈 때 쓴다 —
## 가장자리에서는 "앞에 바닥이 없다" 가 언제나 참이라, 켜 두면 도약 지점에
## 닿는 순간 제멋대로 뛰어 다음 점프를 통째로 날린다.
func _가기(목표x: float, 최대프레임: int = 900, 자동점프: bool = true) -> bool:
	var 방향 := "move_right" if 목표x > _p.global_position.x else "move_left"
	Input.action_press(방향)
	var 누름 := false
	var 정체 := 0
	var 이전x := _p.global_position.x
	for i in 최대프레임:
		await physics_frame
		if not _살아있나():
			Input.action_release(방향)
			if 누름: Input.action_release("jump")
			return false
		if 자동점프 and not 누름 and _p.is_on_floor() and (_p.is_on_wall() or not _앞에_바닥(방향)):
			if _수다:
				print("      · 자동 점프 x=%.0f (벽=%s 앞바닥없음=%s)" % [
					_p.global_position.x, str(_p.is_on_wall()), str(not _앞에_바닥(방향))])
			Input.action_press("jump")
			누름 = true
		elif 누름 and not _p.is_on_floor() and _p.velocity.y >= 0.0:
			Input.action_release("jump")
			누름 = false
		var x := _p.global_position.x
		if absf(x - 목표x) < 도착_여유:
			# ★상승 중이면 정점까지 기다렸다 뗀다. 여기서 그냥 떼면
			#   JUMP_CUT_MULTIPLIER(0.4)가 점프를 160→40px 로 잘라 버려
			#   방금 시작한 자동 점프가 구덩이 한복판에 떨어진다(2-3 관문 4에서 실제로 겪음).
			while 누름 and not _p.is_on_floor() and _p.velocity.y < 0.0:
				await physics_frame
				if not _살아있나():
					Input.action_release(방향)
					Input.action_release("jump")
					return false
			Input.action_release(방향)
			if 누름: Input.action_release("jump")
			# ★땅에 닿을 때까지 기다린다. 공중에서 끝내면 다음 단계가 공중에서 시작해
			#   "칠한 유령 발판이 아직 안 굳었는데 뛰어 통과해 버리는" 일이 생긴다
			#   (지형.gd 이 collision_layer 를 set_deferred 로 바꾸기 때문).
			var 착지대기 := 0
			while not _p.is_on_floor() and 착지대기 < 240:
				await physics_frame
				착지대기 += 1
				if not _살아있나():
					return false
			return true
		if absf(x - 이전x) < 0.5:
			정체 += 1
			if 정체 > 150:
				_실패 = "x=%.0f 에서 막혔다" % x
				break
		else:
			정체 = 0
			이전x = x
	Input.action_release(방향)
	if 누름: Input.action_release("jump")
	if _실패.is_empty():
		_실패 = "x=%.0f 까지 못 갔다" % 목표x
	return false


## 도약x 까지 걸어간 뒤 착지x 쪽으로 점프한다.
## 공중색 >= 0 이면 정점을 지난 뒤 색을 바꾼다 (착지 바닥 색이 다를 때).
## 즉시 = 뜨자마자 색을 바꾼다(정점을 기다리지 않는다). 도약 직후 지나는 물 기둥이 반대색일 때 쓴다.
## 멈춤 = 착지x 를 지나는 순간 방향키를 놓는다(★[2026-10-02] 2-1 격자 기둥 · 352 폭 안에서 꽉 찬 320 은 넘친다).
## 둘째색 >= 0 = ★[2026-10-03] 첫 색을 바꾼 뒤 경계x 를 (가는 방향으로) 지나면 한 번 더 바꾼다(뛰기두색).
func _뛰기(도약x: float, 착지x: float, 착지y: float, 공중색: int, 즉시: bool = false, 멈춤: bool = false,
		둘째색: int = -1, 경계x: float = 0.0, 짧게: int = -1) -> bool:
	if not await _가기(도약x, 600, false):
		return false
	# 발이 완전히 땅에 붙을 때까지 기다린다 — 공중에서 점프를 눌러 봐야 씹힌다
	var 대기 := 0
	while (not _p.is_on_floor() or 대기 < 6) and 대기 < 180:
		await physics_frame
		대기 += 1
		if not _살아있나():
			return false
	var 방향 := "move_right" if 착지x > _p.global_position.x else "move_left"
	Input.action_press(방향)
	Input.action_press("jump")
	var 색바꿈 := 공중색 < 0
	var 둘째바꿈 := 둘째색 < 0
	var 부호 := 1.0 if 방향 == "move_right" else -1.0
	var 떴다 := false
	var 뜬프레임 := 0
	for i in 240:
		await physics_frame
		if not _살아있나():
			Input.action_release(방향)
			Input.action_release("jump")
			return false
		if not _p.is_on_floor():
			떴다 = true
		# 짧은 점프 — 착지x 를 지나면 방향키를 놓아 그 자리에 떨어진다(공중 감속은 플레이어 물리 그대로).
		if 멈춤 and 떴다 and Input.is_action_pressed(방향) \
				and (_p.global_position.x - 착지x) * (1.0 if 방향 == "move_right" else -1.0) >= 0.0:
			Input.action_release(방향)
		if _수다 and i < 14:
			print("        t%3d (%.0f,%.0f) vy=%.0f floor=%s jump=%s 색=%s" % [
				i, _p.global_position.x, _p.global_position.y, _p.velocity.y,
				str(_p.is_on_floor()), str(Input.is_action_pressed("jump")), str(_p.get("player_color"))])
		if 떴다:
			뜬프레임 += 1
		# 짧은 점프 — 뜬 뒤 N 프레임에 점프를 떼어 JUMP_CUT(×0.4)으로 일부러 낮게 뛴다
		if 짧게 >= 0 and 떴다 and 뜬프레임 >= 짧게 and Input.is_action_pressed("jump"):
			Input.action_release("jump")
		# 정점을 지난 뒤에 점프를 뗀다 (JUMP_CUT 방지)
		if 떴다 and _p.velocity.y >= 0.0 and Input.is_action_pressed("jump"):
			Input.action_release("jump")
		if not 색바꿈 and 떴다 and (즉시 or _p.velocity.y >= 0.0):
			await _색누르기(공중색)
			색바꿈 = true
		elif 색바꿈 and not 둘째바꿈 and 떴다 and (_p.global_position.x - 경계x) * 부호 >= 0.0:
			await _색누르기(둘째색)
			둘째바꿈 = true
		if 떴다 and _p.is_on_floor():
			# 착지한 순간이 판정 시점이다. 예전에는 목표 x 에서 40px 넘게 벗어나면
			# 계속 걸었는데, 그러면 착지 뒤 200 프레임을 그 방향으로 더 달려
			# (1,300px!) 엉뚱한 자리에서 다음 단계가 시작됐다.
			Input.action_release(방향)
			Input.action_release("jump")
			# ★높이까지 봐야 한다. x 만 보면 **발판을 놓치고 아래 바닥에 떨어진 것**을
			#   성공으로 읽는다(갱도에서 7칸을 통째로 헛디디고도 전부 ✔ 로 나왔다).
			if absf(_p.global_position.y - 착지y) > 30.0:
				_실패 = "발판을 놓쳤다 — y %.0f 에 내려야 하는데 %.0f" % [
					착지y, _p.global_position.y]
				return false
			return true
	Input.action_release(방향)
	Input.action_release("jump")
	if _실패.is_empty():
		_실패 = "착지 x=%.0f 에 못 내렸다" % 착지x
	return false


func _앞에_바닥(방향: String) -> bool:
	var 부호 := 1.0 if 방향 == "move_right" else -1.0
	var 공간 := _p.get_world_2d().direct_space_state
	# ★레이를 **발 위 20px 에서** 시작한다. 발바닥(원점)에서 쏘면 이미 바닥 면
	#   안이거나 아래라, Godot 레이는 도형 안에서 시작하면 아무것도 안 맞는다
	#   (hit_from_inside = false) → "앞에 바닥이 없다" 가 되어 평지에서도 계속 뛴다.
	var 발 := _p.global_position + Vector2(40.0 * 부호, -20.0)
	var q := PhysicsRayQueryParameters2D.create(발, 발 + Vector2(0.0, 80.0))
	q.exclude = [_p.get_rid()]
	q.collision_mask = _p.collision_mask
	if not 공간.intersect_ray(q).is_empty():
		return true
	# ★[2026-09-14] 레이는 **일방통행(one_way_collision) 발판을 못 본다.** 2-2 의 격자·탑 선반이
	#   전부 일방통행이라, 그 위를 걷는 동안 "앞에 바닥 없음" 으로 읽혀 제멋대로 뛰었다.
	#   몸을 40px 앞에 두고 아래로 80px 밀어 보는 test_move 는 실제 이동과 같은 판정이라 일방통행도 본다.
	var 앞 := Transform2D(0.0, _p.global_position + Vector2(40.0 * 부호, -8.0))
	return _p.test_move(앞, Vector2(0.0, 80.0))


