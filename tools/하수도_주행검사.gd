# 이동
# ============================================================================
## 목표 x 까지 걸어간다. 벽에 막히거나 앞에 바닥이 없으면 점프한다.
## 자동점프 = false 면 **절대 안 뛴다.** 발판 가장자리로 걸어갈 때 쓴다 —
## 가장자리에서는 "앞에 바닥이 없다" 가 언제나 참이라, 켜 두면 도약 지점에
## 닿는 순간 제멋대로 뛰어 다음 점프를 통째로 날린다.
## ★[2026-10-10 · 2-8] 걸어가다가 **같은 바닥의 몬스터를 피한다** — 사람처럼 마주 오면 넘고, 앞서가면 멈춰 기다린다.
##   2-8 흰 몬스터 바닥은 두 마리의 순찰 구간이 겹쳐 "기다림" 한 번으로는 둘 다 피할 수 없다.
func _피해가(목표x: float, 최대프레임: int = 2400) -> bool:
	# 어느 행동(뛰기 · 걷기 · 서기)이 앞으로 1.3 초 동안 같은 바닥의 몹과 안 겹치는지 미리 굴려 보고 고른다.
	#   몹은 왼끝·오른끝에서 되돌아가는 등속 왕복(순찰몬스터.gd) · 몸 판정 −21~+29 · 몹 판정 폭 64 · 키 94(×0.9).
	#   점프: 정점 160 · 공중 가로 속도 ≈ 320 · 떠 있는 시간 ≈ 1 초(실측 — 점프 거리 320). 걷기 ≈ 390.
	#   ★몹 둘(2-8 흰 몬스터)의 구간이 겹쳐 "하나 넘으면 다른 하나 위에 내려앉는" 일이 실제로 났다 → 둘 다 본다.
	var 방향 := "move_right" if 목표x > _p.global_position.x else "move_left"
	var 부호 := 1.0 if 방향 == "move_right" else -1.0
	var 누름 := false
	var 이전행동 := ""
	for i in 최대프레임:
		await physics_frame
		if not _살아있나():
			Input.action_release(방향)
			if 누름: Input.action_release("jump")
			return false
		var x := _p.global_position.x
		if 누름:
			if not _p.is_on_floor() and _p.velocity.y >= 0.0:
				Input.action_release("jump")
				누름 = false
			continue
		if not _p.is_on_floor():
			continue
		if absf(x - 목표x) < 도착_여유:
			Input.action_release(방향)
			return true
		var 몹들: Array = []
		for m in root.get_tree().get_nodes_in_group("몬스터"):
			var 몹 := m as Node2D
			# 높이 차 160 까지 본다 — 계단 아래 단(64 낮음)에서 몹 바닥으로 뛰어오르는 순간 부딪혔다(2-8 흰 계단).
			if 몹 != null and "_방향" in 몹 and absf(몹.global_position.y - _p.global_position.y) < 160.0:
				몹들.append(몹)
		var 행동 := "걷기"
		if not 몹들.is_empty():
			if _피해_안전(x, 부호, "걷기", 몹들):
				행동 = "걷기"
			elif _피해_안전(x, 부호, "뛰기", 몹들):
				행동 = "뛰기"
			elif _피해_안전(x, 부호, "서기", 몹들):
				행동 = "서기"
			else:
				행동 = "뛰기"
		# 계단 턱(벽)을 만나면 뛴다 — `_가기` 의 자동 점프와 같다(몹이 없을 때만 · 몹이 있으면 위 판단을 따른다).
		#   벽 앞에선 걸어도 안 나가므로 "걷기" 안전 판단이 틀린다 → 뛰어도 안전할 때만 뛰고, 아니면 선다.
		if 행동 == "걷기" and _p.is_on_wall():
			행동 = "뛰기" if 몹들.is_empty() or _피해_안전(x, 부호, "뛰기", 몹들) else "서기"
		if 행동 == "뛰기":
			print("      · %s x=%.0f" % [행동, x])
		이전행동 = 행동
		if 행동 == "서기":
			Input.action_release(방향)
		else:
			Input.action_press(방향)
		if 행동 == "뛰기":
			Input.action_press("jump")
			누름 = true
	Input.action_release(방향)
	if 누름: Input.action_release("jump")
	_실패 = "x=%.0f 까지 못 갔다(피해가)" % 목표x
	return false


## 지금 이 행동을 하면 앞으로 1.3 초 동안 몹과 안 겹치나. "걷기" 는 0.35 초만 걸어 보고(그 뒤는 다음 판단이 맡는다)
##   그 뒤 0.4 초 서 있는 것까지 안전해야 한다 — 몹에게 바짝 붙어 버려 뛰지도 서지도 못하는 자리를 피한다.
func _피해_안전(x0: float, 부호: float, 행동: String, 몹들: Array) -> bool:
	var 끝t := 1.3 if 행동 == "뛰기" else (0.75 if 행동 == "걷기" else 0.6)
	var t := 0.0
	while t <= 끝t:
		var px := x0
		var 발 := 0.0
		match 행동:
			"뛰기":
				px = x0 + 부호 * 320.0 * minf(t, 1.0)
				발 = maxf(641.0 * t - 642.0 * t * t, 0.0)
			"걷기":
				px = x0 + 부호 * 390.0 * minf(t, 0.35)
		for 몹 in 몹들:
			var mx := _몹_예측(몹, t)
			if absf(px + 4.0 - mx) < 64.0 and 발 < 100.0:
				return false
		t += 0.05
	return true


## 순찰몬스터의 t 초 뒤 x(왼끝·오른끝 사이 등속 왕복).
func _몹_예측(몹: Node2D, t: float) -> float:
	var 왼 := float(몹.get("왼끝"))
	var 오 := float(몹.get("오른끝"))
	var 속 := float(몹.get("속도"))
	var x := 몹.position.x
	var d := float(몹.get("_방향"))
	var 남은 := 속 * t
	var 안전 := 0
	while 남은 > 0.0 and 안전 < 8:
		안전 += 1
		var 끝 := 오 if d > 0.0 else 왼
		var 거리 := absf(끝 - x)
		if 남은 <= 거리:
			x += d * 남은
			남은 = 0.0
		else:
			x = 끝
			남은 -= 거리
			d = -d
	# position 은 부모(위험물 · 원점) 기준 = 전역과 같다고 본다(빌더가 위험물 그릇을 원점에 둔다)
	return x


func _가기(목표x: float, 최대프레임: int = 900, 자동점프: bool = true) -> bool:
	var 방향 := "move_right" if 목표x > _p.global_position.x else "move_left"
	Input.action_press(방향)
	var 누름 := false
	var 정체 := 0
	var 이전x := _p.global_position.x
	for i in 최대프레임:
		await physics_frame
		if not _살아있나():
			Input.action_release(방향)
			if 누름: Input.action_release("jump")
			return false
		if 자동점프 and not 누름 and _p.is_on_floor() and (_p.is_on_wall() or not _앞에_바닥(방향)):
			if _수다:
				print("      · 자동 점프 x=%.0f (벽=%s 앞바닥없음=%s)" % [
					_p.global_position.x, str(_p.is_on_wall()), str(not _앞에_바닥(방향))])
			Input.action_press("jump")
			누름 = true
		elif 누름 and not _p.is_on_floor() and _p.velocity.y >= 0.0:
			Input.action_release("jump")
			누름 = false
		var x := _p.global_position.x
		if absf(x - 목표x) < 도착_여유:
			# ★상승 중이면 정점까지 기다렸다 뗀다. 여기서 그냥 떼면
			#   JUMP_CUT_MULTIPLIER(0.4)가 점프를 160→40px 로 잘라 버려
			#   방금 시작한 자동 점프가 구덩이 한복판에 떨어진다(2-3 관문 4에서 실제로 겪음).
			while 누름 and not _p.is_on_floor() and _p.velocity.y < 0.0:
				await physics_frame
				if not _살아있나():
					Input.action_release(방향)
					Input.action_release("jump")
					return false
			Input.action_release(방향)
			if 누름: Input.action_release("jump")
			# ★땅에 닿을 때까지 기다린다. 공중에서 끝내면 다음 단계가 공중에서 시작해
			#   "칠한 유령 발판이 아직 안 굳었는데 뛰어 통과해 버리는" 일이 생긴다
			#   (지형.gd 이 collision_layer 를 set_deferred 로 바꾸기 때문).
			var 착지대기 := 0
			while not _p.is_on_floor() and 착지대기 < 240:
				await physics_frame
				착지대기 += 1
				if not _살아있나():
					return false
			return true
		if absf(x - 이전x) < 0.5:
			정체 += 1
			if 정체 > 150:
				_실패 = "x=%.0f 에서 막혔다" % x
				break
		else:
			정체 = 0
			이전x = x
	Input.action_release(방향)
	if 누름: Input.action_release("jump")
	if _실패.is_empty():
		_실패 = "x=%.0f 까지 못 갔다" % 목표x
	return false


## 도약x 까지 걸어간 뒤 착지x 쪽으로 점프한다.
## 공중색 >= 0 이면 정점을 지난 뒤 색을 바꾼다 (착지 바닥 색이 다를 때).
## 즉시 = 뜨자마자 색을 바꾼다(정점을 기다리지 않는다). 도약 직후 지나는 물 기둥이 반대색일 때 쓴다.
## 멈춤 = 착지x 를 지나는 순간 방향키를 놓는다(★[2026-10-02] 2-1 격자 기둥 · 352 폭 안에서 꽉 찬 320 은 넘친다).
## 둘째색 >= 0 = ★[2026-10-03] 첫 색을 바꾼 뒤 경계x 를 (가는 방향으로) 지나면 한 번 더 바꾼다(뛰기두색).
func _뛰기(도약x: float, 착지x: float, 착지y: float, 공중색: int, 즉시: bool = false, 멈춤: bool = false,
		둘째색: int = -1, 경계x: float = 0.0, 짧게: int = -1) -> bool:
	if not await _가기(도약x, 600, false):
		return false
	# 발이 완전히 땅에 붙을 때까지 기다린다 — 공중에서 점프를 눌러 봐야 씹힌다
	var 대기 := 0
	while (not _p.is_on_floor() or 대기 < 6) and 대기 < 180:
		await physics_frame
		대기 += 1
		if not _살아있나():
			return false
	var 방향 := "move_right" if 착지x > _p.global_position.x else "move_left"
	Input.action_press(방향)
	Input.action_press("jump")
	var 색바꿈 := 공중색 < 0
	var 둘째바꿈 := 둘째색 < 0
	var 부호 := 1.0 if 방향 == "move_right" else -1.0
	var 떴다 := false
	var 뜬프레임 := 0
	for i in 240:
		await physics_frame
		if not _살아있나():
			Input.action_release(방향)
			Input.action_release("jump")
			return false
		if not _p.is_on_floor():
			떴다 = true
		# 짧은 점프 — 착지x 를 지나면 방향키를 놓아 그 자리에 떨어진다(공중 감속은 플레이어 물리 그대로).
		if 멈춤 and 떴다 and Input.is_action_pressed(방향) \
				and (_p.global_position.x - 착지x) * (1.0 if 방향 == "move_right" else -1.0) >= 0.0:
			Input.action_release(방향)
		if _수다 and i < 14:
			print("        t%3d (%.0f,%.0f) vy=%.0f floor=%s jump=%s 색=%s" % [
				i, _p.global_position.x, _p.global_position.y, _p.velocity.y,
				str(_p.is_on_floor()), str(Input.is_action_pressed("jump")), str(_p.get("player_color"))])
		if 떴다:
			뜬프레임 += 1
		# 짧은 점프 — 뜬 뒤 N 프레임에 점프를 떼어 JUMP_CUT(×0.4)으로 일부러 낮게 뛴다
		if 짧게 >= 0 and 떴다 and 뜬프레임 >= 짧게 and Input.is_action_pressed("jump"):
			Input.action_release("jump")
		# 정점을 지난 뒤에 점프를 뗀다 (JUMP_CUT 방지)
		if 떴다 and _p.velocity.y >= 0.0 and Input.is_action_pressed("jump"):
			Input.action_release("jump")
		if not 색바꿈 and 떴다 and (즉시 or _p.velocity.y >= 0.0):
			await _색누르기(공중색)
			색바꿈 = true
		elif 색바꿈 and not 둘째바꿈 and 떴다 and (_p.global_position.x - 경계x) * 부호 >= 0.0:
			await _색누르기(둘째색)
			둘째바꿈 = true
		if 떴다 and _p.is_on_floor():
			# 착지한 순간이 판정 시점이다. 예전에는 목표 x 에서 40px 넘게 벗어나면
			# 계속 걸었는데, 그러면 착지 뒤 200 프레임을 그 방향으로 더 달려
			# (1,300px!) 엉뚱한 자리에서 다음 단계가 시작됐다.
			Input.action_release(방향)
			Input.action_release("jump")
			# ★높이까지 봐야 한다. x 만 보면 **발판을 놓치고 아래 바닥에 떨어진 것**을
			#   성공으로 읽는다(갱도에서 7칸을 통째로 헛디디고도 전부 ✔ 로 나왔다).
			if absf(_p.global_position.y - 착지y) > 30.0:
				_실패 = "발판을 놓쳤다 — y %.0f 에 내려야 하는데 %.0f" % [
					착지y, _p.global_position.y]
				return false
			return true
	Input.action_release(방향)
	Input.action_release("jump")
	if _실패.is_empty():
		_실패 = "착지 x=%.0f 에 못 내렸다" % 착지x
	return false


func _앞에_바닥(방향: String) -> bool:
	var 부호 := 1.0 if 방향 == "move_right" else -1.0
	var 공간 := _p.get_world_2d().direct_space_state
	# ★레이를 **발 위 20px 에서** 시작한다. 발바닥(원점)에서 쏘면 이미 바닥 면
	#   안이거나 아래라, Godot 레이는 도형 안에서 시작하면 아무것도 안 맞는다
	#   (hit_from_inside = false) → "앞에 바닥이 없다" 가 되어 평지에서도 계속 뛴다.
	var 발 := _p.global_position + Vector2(40.0 * 부호, -20.0)
	var q := PhysicsRayQueryParameters2D.create(발, 발 + Vector2(0.0, 80.0))
	q.exclude = [_p.get_rid()]
	q.collision_mask = _p.collision_mask
	if not 공간.intersect_ray(q).is_empty():
		return true
	# ★[2026-09-14] 레이는 **일방통행(one_way_collision) 발판을 못 본다.** 2-2 의 격자·탑 선반이
	#   전부 일방통행이라, 그 위를 걷는 동안 "앞에 바닥 없음" 으로 읽혀 제멋대로 뛰었다.
	#   몸을 40px 앞에 두고 아래로 80px 밀어 보는 test_move 는 실제 이동과 같은 판정이라 일방통행도 본다.
	var 앞 := Transform2D(0.0, _p.global_position + Vector2(40.0 * 부호, -8.0))
	return _p.test_move(앞, Vector2(0.0, 80.0))


