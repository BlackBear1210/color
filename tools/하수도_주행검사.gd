func _initialize() -> void:
	Engine.max_fps = 0
	_실행()


func _실행() -> void:
	_수다 = Array(OS.get_cmdline_user_args()).has("--수다")
	var 인자: Array = Array(OS.get_cmdline_user_args()).filter(
		func(a): return not String(a).begins_with("--"))
	var 대상: Array = 기본대상.duplicate() if 인자.is_empty() else 인자
	print("\n════════ 하수도 공략 주행 검사 ════════")
	print("※ 공략표(tools/하수도_주행검사.gd §공략)를 실제 물리로 태운다. 색·물·탄약 전부 산다.\n")
	var 모두통과 := true
	for 경로 in 대상:
		if not await _한판(String(경로)):
			모두통과 = false
	print("")
	quit(0 if 모두통과 else 1)


func _한판(경로: String) -> bool:
	var ps := load(경로) as PackedScene
	if ps == null:
		print("  %s — 로드 실패" % 경로.get_file())
		return false
	_씬 = ps.instantiate() as Node2D
	root.add_child(_씬)
	await physics_frame
	await physics_frame
	await physics_frame

	_p = _씬.get_node_or_null("Player") as CharacterBody2D
	_월드 = _씬
	_코어 = _씬.get_node_or_null("페인트코어")
	_사망 = 0
	_실패 = ""
	_마지막위치 = _p.global_position

	var 이름: String = String(_씬.name)
	# ★[2026-09-14] 공략은 한 씬에 여러 벌일 수 있다 — "stage_2-1" 과 "stage_2-1 헛걸음" 처럼
	#   씬 이름 뒤에 한 칸 띄고 이름표를 붙인다(프롬프트 §5: 정답 경로 + F1 헛걸음 복귀 경로 두 벌).
	#   첫 벌은 여기서, 나머지는 씬을 새로 띄워 차례로 돈다.
	var 열쇠들: Array = []
	for k in 공략.keys():
		if String(k) == 이름 or String(k).begins_with(이름 + " "):
			열쇠들.append(String(k))
	열쇠들.sort()
	var 열쇠: String = String(이름) if 열쇠들.has(String(이름)) else (String(열쇠들[0]) if not 열쇠들.is_empty() else String(이름))
	var 단계들: Array = 공략.get(열쇠, [])
	print("── %s%s ─────────────────────────────" % [이름, "" if 열쇠 == 이름 else "  [" + 열쇠.trim_prefix(이름 + " ") + "]"])
	if 단계들.is_empty():
		print("   공략이 없다 — 건너뛴다")
		_정리()
		return true

	for i in 단계들.size():
		var 단계: Array = 단계들[i]
		var 이전 := _p.global_position
		var ok := await _단계_실행(단계)
		var 지금 := _p.global_position
		var 표시 := "%2d. %-28s (%.0f,%.0f) → (%.0f,%.0f)" % [
			i + 1, _단계_이름(단계), 이전.x, 이전.y, 지금.x, 지금.y]
		if ok and _실패.is_empty():
			print("   ✔ " + 표시)
		else:
			print("   ✖ " + 표시 + "   ← " + (_실패 if _실패 != "" else "시간초과"))
			print("   ── 여기서 막혔다. 남은 단계는 돌리지 않는다.")
			_정리()
			return false

	var 끝 := _씬.get_node_or_null("끝도달_검사점") as Node2D
	var 결과 := true
	if 끝 == null:
		print("   ⚠ 끝도달_검사점 이 없다 — 끝 지점 판정을 못 한다")
	else:
		var d := _p.global_position.distance_to(끝.global_position)
		if d <= 220.0:
			print("   ★ 끝도달_검사점(%.0f,%.0f) 까지 %.0fpx — 도달" % [
				끝.global_position.x, 끝.global_position.y, d])
		else:
			print("   ✖ 끝도달_검사점 까지 %.0fpx 남았다 — 끝까지 못 갔다" % d)
			결과 = false
	print("   사망 %d 회 · 남은 탄약 %s" % [
		_사망, str(_코어.get("남은_탄약")) if _코어 else "-"])
	_정리()
	# 나머지 벌(헛걸음·탑 등)을 같은 씬으로 이어서 돈다
	for k in 열쇠들:
		if k == 열쇠:
			continue
		if not await _한판_이름표(경로, k):
			결과 = false
	return 결과


## 같은 씬을 다시 띄워 이름표가 붙은 공략 한 벌을 돈다 (`_한판` 과 같되 열쇠를 지정한다).
func _한판_이름표(경로: String, 열쇠: String) -> bool:
	var ps := load(경로) as PackedScene
	_씬 = ps.instantiate() as Node2D
	root.add_child(_씬)
	await physics_frame
	await physics_frame
	await physics_frame
	_p = _씬.get_node_or_null("Player") as CharacterBody2D
	_월드 = _씬
	_코어 = _씬.get_node_or_null("페인트코어")
	_사망 = 0
	_실패 = ""
	_마지막위치 = _p.global_position
	var 단계들: Array = 공략.get(열쇠, [])
	print("── %s  [%s] ─────────────────────────────" % [경로.get_file().get_basename(), 열쇠.trim_prefix(경로.get_file().get_basename() + " ")])
	for i in 단계들.size():
		var 단계: Array = 단계들[i]
		var 이전 := _p.global_position
		var ok := await _단계_실행(단계)
		var 지금 := _p.global_position
		var 표시 := "%2d. %-28s (%.0f,%.0f) → (%.0f,%.0f)" % [
			i + 1, _단계_이름(단계), 이전.x, 이전.y, 지금.x, 지금.y]
		if ok and _실패.is_empty():
			print("   ✔ " + 표시)
		else:
			print("   ✖ " + 표시 + "   ← " + (_실패 if _실패 != "" else "시간초과"))
			print("   ── 여기서 막혔다. 남은 단계는 돌리지 않는다.")
			_정리()
			return false
	var 끝 := _씬.get_node_or_null("끝도달_검사점") as Node2D
	var 결과 := true
	if 끝 != null:
		var d := _p.global_position.distance_to(끝.global_position)
		if d <= 220.0:
			print("   ★ 끝도달_검사점 까지 %.0fpx — 도달" % d)
		else:
			print("   ✖ 끝도달_검사점 까지 %.0fpx 남았다" % d)
			결과 = false
	print("   사망 %d 회 · 남은 탄약 %s" % [_사망, str(_코어.get("남은_탄약")) if _코어 else "-"])
	_정리()
	return 결과


func _정리() -> void:
	_입력_해제()
	_씬.queue_free()
	_씬 = null


func _단계_이름(단계: Array) -> String:
	match String(단계[0]):
		"가":     return "가 x=%.0f" % float(단계[1])
		"뛰기":   return "뛰기 %.0f→(%.0f,%.0f)" % [float(단계[1]), float(단계[2]), float(단계[3])]
		"뛰기색": return "뛰기색 %.0f→(%.0f,%.0f) %s" % [float(단계[1]), float(단계[2]),
			float(단계[3]), ("흰색" if int(단계[4]) == 흰색 else "검정")]
		"뛰기정": return "뛰기정 %.0f→(%.0f,%.0f)" % [float(단계[1]), float(단계[2]), float(단계[3])]
		"뛰기정색": return "뛰기정색 %.0f→(%.0f,%.0f) %s" % [float(단계[1]), float(단계[2]),
			float(단계[3]), ("흰색" if int(단계[4]) == 흰색 else "검정")]
		"색":     return "색 → %s" % ("흰색" if int(단계[1]) == 흰색 else "검정")
		"칠":     return "칠 %s" % String(단계[1])
		"쉬":     return "쉬 %d" % int(단계[1])
		"확인":   return "확인 %s" % String(단계[1])
		"걸어":   return "걸어 %.0f→y%.0f" % [float(단계[1]), float(단계[2])]
		"레버":   return "레버 %s" % String(단계[1])
		"밀기":   return "밀기 %s → %.0f" % [String(단계[1]), float(단계[2])]
		"비우기": return "비우기 %s" % String(단계[1])
		"회수":   return "회수(E) ×%d" % int(단계[1])
		"기다림": return "기다림 %s.%s≈%.0f" % [String(단계[1]), String(단계[2]), float(단계[3])]
		"순간이동": return "순간이동 → (%.0f,%.0f)" % [float(단계[1]), float(단계[2])]
		"색기다림": return "색기다림 %s = %s" % [String(단계[1]), ("흰색" if int(단계[2]) == 흰색 else "검정")]
		"뛰기두색": return "뛰기두색 %.0f→(%.0f,%.0f) %s→%s@%.0f" % [float(단계[1]), float(단계[2]), float(단계[3]),
			("흰" if int(단계[4]) == 흰색 else "검"), ("흰" if int(단계[6]) == 흰색 else "검"), float(단계[5])]
		"뛰기정경계색": return "뛰기정경계색 %.0f→(%.0f,%.0f) %s@%.0f" % [float(단계[1]), float(단계[2]), float(단계[3]),
			("흰" if int(단계[5]) == 흰색 else "검"), float(단계[4])]
		"뛰기정두색": return "뛰기정두색 %.0f→(%.0f,%.0f) %s→%s@%.0f" % [float(단계[1]), float(단계[2]), float(단계[3]),
			("흰" if int(단계[4]) == 흰색 else "검"), ("흰" if int(단계[6]) == 흰색 else "검"), float(단계[5])]
		"켜짐기다림": return "켜짐기다림 %s" % String(단계[1])
		"떨어져색": return "떨어져색 %.0f→y%.0f %s" % [float(단계[1]), float(단계[2]), ("흰색" if int(단계[3]) == 흰색 else "검정")]
		"튕겨": return "튕겨 %s→(%.0f,%.0f)" % [String(단계[1]), float(단계[2]), float(단계[3])]
		"피해가": return "피해가 x=%.0f (몬스터 넘기)" % float(단계[1])
		"다시칠": return "다시칠 %s" % String(단계[1])
	return String(단계[0])


func _단계_실행(단계: Array) -> bool:
	match String(단계[0]):
		"가":     return await _가기(float(단계[1]))
		"뛰기":   return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), -1)
		"뛰기색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), int(단계[4]),
			단계.size() > 5 and String(단계[5]) == "즉시")
		"뛰기정": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), -1, false, true)
		"뛰기정색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), int(단계[4]),
			단계.size() > 5 and String(단계[5]) == "즉시", true)
		"색":     return await _색바꾸기(int(단계[1]))
		"칠":     return _칠하기(String(단계[1]), int(단계[2]))
		"쉬":     return await _쉬기(int(단계[1]))
		"확인":   return await _확인(String(단계[1]))
		"걸어":   return await _걸어(float(단계[1]), float(단계[2]))
		"레버":   return await _레버(String(단계[1]))
		"밀기":   return await _밀기(String(단계[1]), float(단계[2]), 단계.size() > 3 and String(단계[3]) == "제자리")
		"비우기": return await _비우기(String(단계[1]))
		"회수":   return await _회수(int(단계[1]))
		"기다림": return await _기다림(String(단계[1]), String(단계[2]), float(단계[3]))
		"순간이동": return await _순간이동(float(단계[1]), float(단계[2]))
		"색기다림": return await _색기다림(String(단계[1]), int(단계[2]))
		"뛰기두색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), int(단계[4]), true, false,
			int(단계[6]), float(단계[5]), int(단계[7]) if 단계.size() > 7 else -1)
		# ★[2026-10-03] 경계x 를 지나면 한 번만 바꾼다(짧은 점프) — 색 전환은 토글이라 "뛰기두색" 의 첫 색이 이미 몸 색이면
		#   거꾸로 바뀐다. 2-3 호퍼 리듬(앞 물을 벗어난 뒤 다음 물 전에 바꾼다)용.
		"뛰기정경계색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), -1, false, true,
			int(단계[5]), float(단계[4]), int(단계[6]) if 단계.size() > 6 else -1)
		# ★[2026-10-09] "뛰기두색" + 착지x 에서 방향키를 놓는다(짧은 점프). 2-6 수갱 — 반대색 물기둥을 공중에서 지나
		#   바로 옆 좁은 마른 자리(물기둥 사이 78px)에 내려앉는다. 꽉 찬 점프면 다음 물기둥까지 넘친다.
		"뛰기정두색": return await _뛰기(float(단계[1]), float(단계[2]), float(단계[3]), int(단계[4]), true, true,
			int(단계[6]), float(단계[5]), int(단계[7]) if 단계.size() > 7 else -1)
		"켜짐기다림": return await _켜짐기다림(String(단계[1]))
		"피해가": return await _피해가(float(단계[1]))
		"다시칠": return await _다시칠(String(단계[1]), int(단계[2]))
		"떨어져색": return await _떨어져색(float(단계[1]), float(단계[2]), int(단계[3]))
		"튕겨": return await _튕겨(String(단계[1]), float(단계[2]), float(단계[3]),
			float(단계[4]) if 단계.size() > 4 else -1.0)
	_실패 = "모르는 단계"
	return false


