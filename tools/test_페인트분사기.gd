extends SceneTree
## ============================================================================
## [2026-09-07 신규] 페인트 분사기 검사
## ----------------------------------------------------------------------------
## 실행: godot --headless --path . -s res://tools/test_페인트분사기.gd
##
## ▣ 여기서 못 박는 것
##   1. 인스펙터 값 세 개가 실제로 먹는다 — **탄속 · 발사간격 · 한번에_발사수**.
##      (+ 발사색 · 퍼짐각 · 색_번갈아 · 작동)
##   2. 여러 발은 **기준 방향을 가운데 두고** 부채꼴로 벌어진다.
##      한쪽으로만 벌어지면 발사수를 늘릴 때마다 조준이 스스로 틀어진다.
##   3. ★**장치 페인트는 플레이어 탄약을 건드리지 않는다.**
##      쏠 때도, 부분 칠이 흐려질 때도 잔량이 1 도 안 변해야 한다.
##      → 안 지키면 분사기 앞에 가만히 서 있는 것만으로 탄약이 무한이 된다.
##   4. ★**장치 페인트는 E 로 회수할 수 없다.** 내 물감이 아니기 때문이다.
##   5. ★**죽거나 리셋하면 장치가 칠한 것도 원래 색으로 돌아간다.**
##      안 그러면 여러 번 죽는 사이에 분사기가 맵 전체를 제 색으로 덮어 버린다.
##   6. 플레이어가 낸 발의 **환급은 예전 그대로다**(회귀 방지).
##      같은 지형에 플레이어 발과 장치 발이 섞여도 플레이어 몫만 정확히 돌아온다.
## ============================================================================

const 분사기_씬 := "res://scenes/집/스마트월드_장애물/페인트분사기.tscn"
const 지형_템플릿 := "res://scenes/집/스마트 매쉬 assets/CEMENT_시멘트/TEMPLATE_CEMENT_SOLID.tscn"

var 통과 := 0
var 실패 := 0


func _init() -> void:
	call_deferred("_실행")


func _확인(조건: bool, 글: String) -> void:
	if 조건:
		통과 += 1
		print("  ✔ %s" % 글)
	else:
		실패 += 1
		print("  ✖ %s" % 글)


func _같나(a: float, b: float, 허용: float = 0.5) -> bool:
	return absf(a - b) <= 허용


func _실행() -> void:
	print("\n=== 페인트 분사기 ===")
	_발사_기본()
	_여러발_부채꼴()
	_색_지정과_번갈아()
	_작동_끄기()
	_탄약_불변()
	_회수_불가()
	await _실제지형_환급없음()
	await _리셋_되돌림()

	print("\n════════════════════════════════════════")
	print("  통과 %d · 실패 %d" % [통과, 실패])
	print("════════════════════════════════════════\n")
	quit(1 if 실패 > 0 else 0)


# ── 준비물 ──────────────────────────────────────────────────────────────────
func _코어_놓기(최대: int = 10) -> 페인트코어:
	var c := 페인트코어.new()
	c.최대_탄약 = 최대
	c.add_to_group("페인트코어")      # 지형·분사기가 그룹으로 찾는다
	root.add_child(c)
	return c


func _분사기_놓기() -> Node2D:
	var 팩 := load(분사기_씬) as PackedScene
	var n := 팩.instantiate() as Node2D
	root.add_child(n)
	return n


## root 아래 떠 있는 투사체만 모은다.
func _총알들() -> Array:
	var 결과: Array = []
	for n in root.get_children():
		if n is 페인트총알:
			결과.append(n)
	return 결과


func _총알_치우기() -> void:
	for b in _총알들():
		root.remove_child(b)
		b.free()


func _정리(노드들: Array) -> void:
	_총알_치우기()
	for n in 노드들:
		if is_instance_valid(n):
			root.remove_child(n)
			n.free()


# ── 1. 탄속 · 발사간격 ──────────────────────────────────────────────────────
func _발사_기본() -> void:
	print("\n── 탄속 · 발사간격이 실제로 먹는다")
	var 코어 := _코어_놓기()
	var s := _분사기_놓기()
	s.각도 = 0.0                     # 오른쪽
	s.탄속 = 500.0
	s.발사간격 = 1.0
	s.한번에_발사수 = 1
	s.탄낙차 = 0.0                   # 직선 — 초속도만 보려고 중력을 끈다

	s._physics_process(0.5)
	_확인(_총알들().is_empty(), "발사간격의 절반에서는 아직 안 쏜다")

	s._physics_process(0.5)
	var 발 := _총알들()
	_확인(발.size() == 1, "발사간격이 지나면 1발 나간다 (실제 %d)" % 발.size())
	if 발.size() == 1:
		var v: Vector2 = 발[0]._속도
		_확인(_같나(v.length(), 500.0, 1.0), "총구 속력 = 탄속 500 (실제 %.1f)" % v.length())
		_확인(_같나(rad_to_deg(v.angle()), 0.0, 0.5), "방향 = 각도 0°")
		_확인(bool(발[0].장치발), "장치가 쏜 발로 표시된다")
		_확인(_같나(발[0].중력배수, 0.0), "탄낙차 0 이 투사체에 전달된다")

	_총알_치우기()
	s._physics_process(1.0)
	_확인(_총알들().size() == 1, "다음 간격에 또 1발 (연사가 이어진다)")
	_정리([s, 코어])


# ── 2. 한번에_발사수 · 퍼짐각 ───────────────────────────────────────────────
func _여러발_부채꼴() -> void:
	print("\n── 한번에_발사수 · 퍼짐각")
	var 코어 := _코어_놓기()
	var s := _분사기_놓기()
	s.각도 = 90.0                    # 아래
	s.발사간격 = 1.0
	s.한번에_발사수 = 3
	s.퍼짐각 = 60.0
	s.탄낙차 = 0.0
	s._physics_process(1.0)

	var 발 := _총알들()
	_확인(발.size() == 3, "한번에_발사수 3 → 3발이 동시에 나간다 (실제 %d)" % 발.size())
	if 발.size() == 3:
		var 각들: Array[float] = []
		for b in 발:
			각들.append(rad_to_deg((b._속도 as Vector2).angle()))
		각들.sort()
		_확인(_같나(각들[0], 60.0, 0.5) and _같나(각들[1], 90.0, 0.5) and _같나(각들[2], 120.0, 0.5),
			"기준 90° 를 가운데 두고 60/90/120 으로 벌어진다 (실제 %s)" % str(각들))
	_정리([s, 코어])


# ── 3. 발사색 · 색_번갈아 ───────────────────────────────────────────────────
func _색_지정과_번갈아() -> void:
	print("\n── 쏘는 색을 정할 수 있다")
	var 코어 := _코어_놓기()
	var s := _분사기_놓기()
	s.발사간격 = 1.0
	s.발사색 = ColorDefs.WHITE
	s._ready()                        # 발사색을 바꾼 뒤 현재색을 다시 잡는다
	s._physics_process(1.0)
	var 발 := _총알들()
	_확인(발.size() == 1 and int(발[0].색) == ColorDefs.WHITE, "발사색 흰색 → 흰 페인트가 나간다")
	_총알_치우기()

	s.색_번갈아 = true
	s.색_전환주기 = 2.0
	s._physics_process(2.0)           # 누적 시간이 전환주기를 넘어간다
	_확인(s.지금색() == ColorDefs.BLACK, "색_번갈아: 주기가 지나면 반대색으로 뒤집힌다")
	var 발2 := _총알들()
	_확인(not 발2.is_empty() and int(발2[0].색) == ColorDefs.BLACK, "뒤집힌 색으로 쏜다")
	_정리([s, 코어])


# ── 4. 작동 스위치 ──────────────────────────────────────────────────────────
func _작동_끄기() -> void:
	print("\n── 작동을 끄면 아무것도 안 나간다 (레버·버튼용)")
	var 코어 := _코어_놓기()
	var s := _분사기_놓기()
	s.발사간격 = 0.5
	s.끄기()
	s._physics_process(2.0)
	_확인(_총알들().is_empty(), "꺼진 동안에는 한 발도 안 쏜다")
	s.켜기()
	s._physics_process(2.0)
	_확인(_총알들().size() == 1, "다시 켜면 쏜다")
	_정리([s, 코어])


# ── 5. ★탄약을 건드리지 않는다 ─────────────────────────────────────────────
func _탄약_불변() -> void:
	print("\n── ★장치 페인트는 플레이어 탄약이 아니다")
	var 코어 := _코어_놓기(10)
	var 대상 := _가짜대상.new()
	root.add_child(대상)

	var r := 코어.장치_명중_처리(대상, ColorDefs.BLACK, Vector2.ZERO)
	_확인(r == "painted", "장치 페인트도 지형을 칠한다 (결과 %s)" % r)
	_확인(코어.남은_탄약 == 10, "칠했는데 잔량이 그대로 10 (실제 %d)" % 코어.남은_탄약)
	_확인(코어.비행중() == 0, "비행중 카운터를 오염시키지 않는다")

	코어.장치_명중_처리(null, ColorDefs.BLACK, Vector2.ZERO)
	_확인(코어.남은_탄약 == 10, "빗나가도 환급이 없다 (잔량 %d)" % 코어.남은_탄약)
	_정리([대상, 코어])


# ── 6. ★E 로 회수할 수 없다 ────────────────────────────────────────────────
func _회수_불가() -> void:
	print("\n── ★장치가 칠한 것은 E 로 회수할 수 없다")
	var 코어 := _코어_놓기(10)
	var 대상 := _가짜대상.new()
	root.add_child(대상)
	코어.장치_명중_처리(대상, ColorDefs.WHITE, Vector2.ZERO)
	_확인(코어.회수_대기수() == 0, "회수줄에 안 들어간다")
	_확인(코어.수동_회수() == false, "E 를 눌러도 회수할 게 없다")
	_확인(코어.남은_탄약 == 10, "E 로 탄약이 생기지 않는다 (실제 %d)" % 코어.남은_탄약)
	_정리([대상, 코어])


# ── 7. ★실제 지형: 부분 칠이 흐려져도 환급이 없다 ──────────────────────────
func _실제지형_환급없음() -> void:
	print("\n── ★실제 지형: 장치 몫은 환급되지 않고, 플레이어 몫만 돌아온다")
	var 코어 := _코어_놓기(10)
	var 루트 := await _지형_놓기()
	var 지형 := _지형_찾기(루트) if 루트 != null else null
	if 지형 == null:
		_확인(false, "지형 템플릿을 못 불러왔다")
		_정리([루트, 코어])
		return
	지형.칠하기_허용 = true
	지형.필요횟수_수동 = 4                       # 한 발로는 안 끝나게 = 부분 칠

	var r1: String = 지형.장치_명중(ColorDefs.BLACK, 지형.global_position)
	var r2: String = 지형.장치_명중(ColorDefs.BLACK, 지형.global_position)
	_확인(r1 == "progress" and r2 == "progress", "장치 2발 = 부분 칠 (%s/%s)" % [r1, r2])
	_확인(코어.남은_탄약 == 10, "쏘는 순간 잔량 불변 (실제 %d)" % 코어.남은_탄약)

	# 플레이어도 같은 지형에 같은 색으로 1발 낸다 (섞이는 경우)
	코어.발사_소모()
	코어.명중_처리(지형, ColorDefs.BLACK, 지형.global_position)
	_확인(코어.남은_탄약 == 9, "플레이어 발은 정상적으로 1발 빠진다 (실제 %d)" % 코어.남은_탄약)

	# 유지 4초 + 감쇠 1초를 넘겨 만료시킨다
	지형._process(6.0)
	_확인(코어.남은_탄약 == 10,
		"만료 뒤 **플레이어 1발만** 돌아온다 — 장치 2발은 안 돌아온다 (실제 %d)" % 코어.남은_탄약)
	_정리([루트, 코어])


# ── 8. ★리셋하면 장치가 칠한 것도 되돌아간다 ──────────────────────────────
func _리셋_되돌림() -> void:
	print("\n── ★죽거나 리셋하면 장치가 칠한 색도 원래대로")
	var 코어 := _코어_놓기(10)
	var 루트 := await _지형_놓기()
	var 지형 := _지형_찾기(루트) if 루트 != null else null
	if 지형 == null:
		_확인(false, "지형 템플릿을 못 불러왔다")
		_정리([루트, 코어])
		return
	지형.칠하기_허용 = true
	지형.전체_색칠_최대긴변 = 0.0                # 0 = 크기 한도 없음
	지형.필요횟수_수동 = 1                       # 한 발에 전체 색칠

	var r: String = 코어.장치_명중_처리(지형, ColorDefs.WHITE, 지형.global_position)
	_확인(r == "painted", "장치 1발로 전체 색칠 (결과 %s)" % r)
	_확인(지형.현재색() == ColorDefs.WHITE, "지형이 흰색이 되었다")

	코어.리셋()
	_확인(지형.현재색() != ColorDefs.WHITE, "리셋하면 흰색이 사라진다 (실제 %d)" % 지형.현재색())
	_확인(코어.남은_탄약 == 10, "리셋으로 없는 탄약이 생기지 않는다 (실제 %d)" % 코어.남은_탄약)
	_정리([루트, 코어])


## SS2D 템플릿을 root 에 놓는다. 반환값은 **인스턴스 루트** — 치울 때 이걸 지운다.
func _지형_놓기() -> Node:
	var 팩 := load(지형_템플릿) as PackedScene
	if 팩 == null:
		return null
	var 루트 := 팩.instantiate()
	root.add_child(루트)                 # ★_ready 가 돌아야 셰이더·면적이 잡힌다
	await process_frame
	return 루트


func _지형_찾기(n: Node) -> Node:
	if n is 스마트지형:
		return n
	for c in n.get_children():
		var found := _지형_찾기(c)
		if found != null:
			return found
	return null


## 규칙만 떼어 보려는 최소 대상 (test_페인트v4.gd 의 가짜대상과 같은 계약).
class _가짜대상 extends Node:
	var 색: int = -1

	func 명중(c: int, _p: Vector2) -> String:
		if 색 == c:
			return "wasted"
		색 = c
		return "painted"

	func 되돌리기() -> bool:
		색 = -1
		return true

	func 강제_초기화() -> void:
		색 = -1

	func 현재색() -> int:
		return 색
