## 바닥 덩이 — 사이의 빈 곳이 구덩이·갱도가 된다.
func _바닥_만들기() -> void:
	# 각 구간은 [시작x, 끝x].
	#   1180~1620 = 구덩이 (★깊다 — 떨어지면 낙하 거리 초과로 죽는다)
	#   1950~2210 = 수직 갱도 (선반으로 계단식 하강 = 안전한 길이 있다)
	var 구간 := [
		[-560.0, 1180.0],          # 입구 통로 앞까지 왼쪽으로 늘렸다
		[1620.0, 1950.0],
		[2210.0, 2560.0],
		[2520.0, 끝x + 260.0],
	]
	var i := 0
	for s in 구간:
		i += 1
		var 지형 := 공통.지형_노드("바닥_%d" % i, Vector2.ZERO,
			공통.굽은바닥_점들(s[0], s[1], _지면y, 1520.0),
			_재질_기본, false, false)
		_지형층.add_child(지형)


## 지면 높이 곡선. 프롭을 지면에 정확히 붙일 때도 같은 식을 쓴다.
func _지면y(x: float) -> float:
	# ★[2026-08-06] 출구 앞은 완전히 평평하게. 통로 입구가 기울어져 있으면
	#   "여기로 들어가라"는 신호가 약해지고, 통로가 만든 수평 바닥과도 이가 안 맞는다.
	if x >= 평지시작:
		return 지면 - 10.0
	# 입구 통로 쪽(왼쪽 끝)도 마찬가지로 평평하게
	if x <= -240.0:
		return 지면 + 8.0

	var 굴곡 := 46.0
	var 오프셋 := 0.0
	if x > 1620.0 and x < 2560.0:
		굴곡 = 30.0
		오프셋 = -30.0
	elif x >= 2560.0:
		굴곡 = 52.0
		오프셋 = -10.0
	var t := x / 260.0
	var y := 지면 + 오프셋 + sin(t) * 굴곡 + sin(t * 2.37 + 1.1) * 굴곡 * 0.45 \
		+ sin(t * 0.61 - 0.4) * 굴곡 * 0.8
	# 평지·통로 구간과 부드럽게 이어 붙인다 (툭 끊기면 눈에 띈다)
	if x > 평지시작 - 300.0:
		var k := (x - (평지시작 - 300.0)) / 300.0
		y = lerpf(y, 지면 - 10.0, smoothstep(0.0, 1.0, k))
	if x < -60.0:
		var k2 := (-60.0 - x) / 180.0
		y = lerpf(y, 지면 + 8.0, smoothstep(0.0, 1.0, clampf(k2, 0.0, 1.0)))
	return y


## ★천장 매스 — 위에서 내려오는 암반 덩어리.
## [2026-08-06 신규] 레인월드/리틀나이트메어의 지형이 묵직한 건 방이 늘
## "덩어리에서 파낸 공간"이라서다. 천장이 없으면 아무리 바닥을 잘 만들어도
## 발판이 허공에 뜬 막대기로 읽힌다. 다만 **전 구간을 덮으면 답답하므로**
## 구간마다 높이를 달리해 열린 곳과 좁은 곳의 리듬을 만든다.
func _천장_만들기() -> void:
	var 자료 := [
		# [x0, x1, 아랫면y, 위y, 굴곡, 위상]
		[-620.0, 260.0, 300.0, -420.0, 26.0, 0.0],      # 입구 쪽 — 낮게 눌러 굴에서 나오는 느낌
