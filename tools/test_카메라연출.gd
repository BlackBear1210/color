extends SceneTree
## ============================================================================
## [2026-08-07 도형] 구역 카메라(바인식 전환) 자동 검사
## ----------------------------------------------------------------------------
## 실행:
##   Godot --headless --path . -s res://tools/test_카메라연출.gd
##
## ▣ 무엇을 검사하나 — 핵심은 딱 하나다
##   **"카메라가 플레이어와 같이 가는가"**
##   도형님 요청: "카메라가 움직임과 플레이어의 움직임이 같이 가야해."
##
##   이걸 코드로 증명하는 방법:
##     1. 플레이어를 x 축으로 조금씩 옮기며 카메라 줌을 기록한다
##     2. 앞으로 갈 때 줌이 **단조롭게** 변한다        → 화면이 걷는 만큼만 열린다
##     3. 되돌아오면 **왔던 값이 그대로 재현**된다      → 위치의 함수다(시간의 함수가 아님)
##     4. 같은 위치에 **여러 프레임 머물러도 값이 안 변한다** → 멈추면 화면도 멈춘다
##
##   3·4 번이 시간 트윈과 위치 보간을 가르는 결정적 차이다.
##   시간 트윈이면 같은 자리에 서 있어도 값이 계속 흘러가고, 되돌아가도 안 돌아온다.
##   (Vane 2019 이 "카메라가 플레이를 방해한다" 는 혹평을 받은 지점)
##
## ▣ ⚠ 헤드리스 주의
##   `Engine.max_fps = 60` 고정 — 안 그러면 "몇 프레임 기다리기" 가 실제 시간과 어긋난다.
## ============================================================================

const 씬 := "res://scenes/world_1/stage_1-1, 1-2.tscn"

var _통과 := 0
var _실패 := 0
var _n := 0
var _루트: Node = null
var _p: Node2D = null
var _연출: 카메라연출 = null


func _init() -> void:
	Engine.max_fps = 60
	process_frame.connect(_tick)


func _확인(조건: bool, 설명: String) -> void:
	if 조건:
		_통과 += 1
		print("  ✔ %s" % 설명)
	else:
		_실패 += 1
		print("  ✖ %s" % 설명)


func _tick() -> void:
	_n += 1
	if _n == 1:
		if not ResourceLoader.exists(씬):
			push_error("씬이 없다: %s" % 씬)
			quit(2)
			return
		_루트 = (load(씬) as PackedScene).instantiate()
		root.add_child(_루트)
		current_scene = _루트
		return
	if _n < 6:
		return

	print("")
	print("── 준비 ───────────────────────────────────────")
	_p = _루트.get_node_or_null("Player") as Node2D
	_연출 = _루트.get_node_or_null("카메라연출") as 카메라연출
	_확인(_p != null, "Player 를 찾았다")
	_확인(_연출 != null, "카메라연출 노드를 찾았다")
	if _p == null or _연출 == null:
		_끝내기()
		return
	_확인(_연출.구역수() >= 2, "카메라 구역이 %d 개 있다" % _연출.구역수())

	_검사()
	_끝내기()


# ============================================================================
func _검사() -> void:
	# 1-1 / 1-2 경계는 12,576px 근처. 그 앞뒤를 훑는다.
	const 경계 := 12576.0
	var 표본_x: Array[float] = []
	var x := 경계 - 1600.0
	while x <= 경계 + 1600.0:
		표본_x.append(x)
		x += 200.0

	print("")
	print("── 1) 앞으로 걸을 때 ──────────────────────────")
	var 앞_줌: Array[float] = []
	var 앞_진행: Array[float] = []
	for sx in 표본_x:
		앞_줌.append(_위치_적용(sx))
		# ⚠ 진행도는 **그 표본을 적용한 직후**에 읽어야 한다.
		#   루프가 끝난 뒤 한꺼번에 읽으면 마지막 표본의 값만 나온다(처음에 그렇게 짰다가
		#   "전환이 0.00 만 찍히네?" 하고 5 분 낭비함).
		앞_진행.append(_연출.진행도())
	for i in 표본_x.size():
		if i % 2 == 0:
			print("     x %8.0f  →  줌 %.4f  (전환 %.2f)"
				% [표본_x[i], 앞_줌[i], 앞_진행[i]])

	# 줌이 실제로 바뀌었는가 (구역이 다른데 화면이 그대로면 연출이 안 도는 것)
	var 최소: float = 앞_줌.min()
	var 최대: float = 앞_줌.max()
	_확인(최대 - 최소 > 0.02,
		"경계를 지나며 줌이 실제로 바뀐다 (%.3f → %.3f)" % [앞_줌[0], 앞_줌[-1]])

	# ── 2) ★단조성 ── 앞으로만 가면 줌도 한 방향으로만 가야 한다.
	#   '전환 숨'(가운데서 살짝 물러났다 돌아옴) 때문에 완전 단조는 아니므로,
	#   숨을 뺀 기준선(양 끝값의 보간)에서 크게 벗어나지 않는지를 본다.
	var 역행 := 0
	for i in range(1, 앞_줌.size()):
		# 숨 폭(7%)보다 큰 역행만 문제로 센다
		if 앞_줌[i] - 앞_줌[i - 1] > 0.05:
			역행 += 1
	print("")
	print("── 2) 단조성 ─────────────────────────────────")
	_확인(역행 == 0, "앞으로 걸을 때 줌이 크게 튀지 않는다 (역행 %d 회)" % 역행)

	# ── 3) ★가역성 ── 되돌아가면 왔던 값이 그대로 나와야 한다.
	#   이게 "시간이 아니라 위치의 함수"라는 증거다.
	print("")
	print("── 3) 가역성 (되돌아가기) ─────────────────────")
	var 뒤_줌: Array[float] = []
	for i in range(표본_x.size() - 1, -1, -1):
		뒤_줌.append(_위치_적용(표본_x[i]))
	뒤_줌.reverse()
	var 최대오차 := 0.0
	for i in 앞_줌.size():
		최대오차 = maxf(최대오차, absf(앞_줌[i] - 뒤_줌[i]))
	_확인(최대오차 < 0.0005,
		"되돌아가면 같은 x 에서 같은 줌이 나온다 (최대 오차 %.6f)" % 최대오차)

	# ── 4) ★정지성 ── 같은 자리에 머무르면 화면도 멈춰야 한다.
	print("")
	print("── 4) 정지성 (제자리에 서 있기) ───────────────")
	var 고정 := 경계 - 300.0        # 전환 밴드 한가운데
	var 첫값 := _위치_적용(고정)
	var 흔들림 := 0.0
	for i in 30:                    # 0.5 초 동안 가만히 서 있는다
		흔들림 = maxf(흔들림, absf(_위치_적용(고정) - 첫값))
	_확인(흔들림 < 0.0001,
		"제자리에 서 있으면 줌이 안 움직인다 (30프레임 흔들림 %.6f)" % 흔들림)
	_확인(_연출.진행도() > 0.0 and _연출.진행도() < 1.0,
		"전환 밴드 안에 있다 (진행도 %.2f)" % _연출.진행도())

	# ── 5) 밴드 밖에서는 전환이 0 ──
	print("")
	print("── 5) 밴드 밖 ─────────────────────────────────")
	_위치_적용(2000.0)
	_확인(is_zero_approx(_연출.진행도()),
		"구역 한가운데(x 2000)에서는 전환 진행도가 0 이다 (%.3f)" % _연출.진행도())

	# ── 6) 카메라 리밋도 같이 섞이는가 ──
	print("")
	print("── 6) 리밋 보간 ───────────────────────────────")
	_위치_적용(경계 - 1600.0)
	var 리밋_왼 := _연출.적용_범위()
	_위치_적용(경계 + 1600.0)
	var 리밋_오 := _연출.적용_범위()
	_확인(not 리밋_왼.is_equal_approx(리밋_오),
		"구역이 바뀌면 카메라 리밋도 바뀐다 (%.0f~%.0f → %.0f~%.0f)"
		% [리밋_왼.position.x, 리밋_왼.end.x, 리밋_오.position.x, 리밋_오.end.x])


## 플레이어를 그 x 로 옮기고 연출을 한 번 돌린 뒤 줌을 읽는다.
## (물리 프레임을 기다리지 않고 직접 호출 — 위치의 함수인지 보는 게 목적이라
##  프레임 진행이 결과에 섞이면 안 된다)
func _위치_적용(x: float) -> float:
	_p.global_position.x = x
	_연출._갱신()
	return _연출.적용_줌()


func _끝내기() -> void:
	print("")
	print("[test_카메라연출] 통과 %d / 실패 %d" % [_통과, _실패])
	quit(_실패)
