# 지형 — 바닥 (★전부 일자)
# ============================================================================
func _바닥_만들기() -> void:
	# [이름, x0, x1, 윗면y]
	# 폴리곤은 전부 바닥끝y 까지 닫는다 = 두 층 사이가 통짜 암반이 되어
	# 갱도의 옆면이 자동으로 "파낸 벽" 이 된다. (따로 벽을 세울 필요가 없다)
	var 자료 := [
		["바닥_상1", -680.0, 갱도_좌, 상층y],
		["바닥_하1", 갱도_좌 - 140.0, 굴뚝_우 + 120.0, 하층y],
		["바닥_상2", 굴뚝_우 + 120.0, 구멍_좌, 상층y],
		["바닥_상3", 구멍_우, 끝x + 420.0, 상층y],
	]
	for d in 자료:
		var 지형 := 공통.지형_노드(d[0], Vector2.ZERO,
			공통.평바닥_점들(d[1], d[2], d[3], 바닥끝y),
			_재질_암반, false, false)
		_지형층.add_child(지형)


# ============================================================================
# 지형 — 천장 매스 (레인월드 문법 ①②: 파낸 공간 / 넓고 좁은 리듬)
# ============================================================================
func _천장_만들기() -> void:
	# [이름, x0, x1, 아랫면y, 위y, 굴곡, 위상]
	#   방 높이 = 상층y(900) − 아랫면y.  넓은 홀 650 ↔ 좁은 굴 200 이 번갈아 나온다.
	var 자료 := [
		["천장_홀", -740.0, 1400.0, 250.0, -620.0, 30.0, 0.0],        # 방 높이 650
