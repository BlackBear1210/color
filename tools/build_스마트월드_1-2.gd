var _재질_덩어리 := ""
var _rng := RandomNumberGenerator.new()


func _init() -> void:
	Engine.max_fps = 60
	_rng.seed = 20260806
	# ★도형님이 그린 타일로 재질을 조립한다 (한 번도 안 쓰였던 *2 변형 타일)
	_재질_암반 = 공통.재질_준비("거친암반")
	_재질_덩어리 = 공통.재질_준비("덩어리")
	if _재질_암반.is_empty() or _재질_덩어리.is_empty():
		push_error("build_스마트월드_1-2: 재질 준비 실패")
		quit(1)
		return
	_짓기()
	quit(0)


func _짓기() -> void:
	DirAccess.make_dir_recursive_absolute(
		ProjectSettings.globalize_path("res://scenes/스마트월드/"))

	_루트 = 월드_S.new()
	_루트.name = "스마트월드_1-2"
	_루트.스테이지_이름 = "1-2 · 폐수로"
	_루트.시작_위치 = Vector2(160, 상층y - 40.0)
	_루트.낙사_y = 3200.0                # 최후의 안전장치 (실제 낙사는 낙하 거리로 잡는다)
	_루트.치명_낙하거리 = 520.0
	_루트.낙하_경고표시 = true
	_루트.안전지점_자동저장 = true
	_루트.카메라_리밋 = Rect2(-800, -1000, 끝x + 1800, 4200)
	_루트.카메라_줌 = 0.82

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	# ★1-1(12발)보다 넉넉하다. 유령 발판 다리와 무너지는 바위 보강에 물감이 더 든다.
	#   (레벨디자인_가이드 §2 물감 이코노미 — 필요량 + 여유 4발)
	코어.최대_탄약 = 16
	코어.add_to_group("페인트코어", true)
	_루트.add_child(코어)

	# ── 배경 ── 물가 → 판자촌.
	# ★1-1 의 끝 바이옴(물가) = 1-2 의 시작 바이옴(물가). 통로를 지나면 하늘이 이어진다.
	StageBackdrop.구성(_루트, _루트, Rect2(-700, -700, 끝x + 1500, 2600),
		"물가", "판자촌", 20260806)

	_대기층()
	_안개_전부()

	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	# 1-1(0.90)보다 살짝 어둡다 — 지하 수로라 빛이 덜 든다. 광원이 그만큼 잘 읽힌다.
	어둠.color = Color(0.86, 0.87, 0.90)
	_루트.add_child(어둠)

	_지형층 = Node2D.new()
	_지형층.name = "지형"
	_루트.add_child(_지형층)

	_오브젝트층 = Node2D.new()
	_오브젝트층.name = "오브젝트"
	_루트.add_child(_오브젝트층)

	_바닥_만들기()
	_천장_만들기()
	_굴뚝_벽()
	_선반_만들기()
	_공중발판_만들기()

	_구역1_홀()
	_구역2_좁은굴()
	_구역3_갱도()
	_구역4_수로()
	_구역5_굴뚝()
	_구역6_배관실()
	_구역7_다리()
	_통로_만들기()

	var 플레이어 := (load(PLAYER) as PackedScene).instantiate()
	플레이어.name = "Player"
	# 1-1 과 **완전히 같은 점프 세팅**. 스테이지마다 조작감이 달라지면 안 된다.
	플레이어.set("점프_높이_칸", 10.0)
	플레이어.set("점프_거리_칸", 20.0)
	플레이어.set("상승_배수", 4.563)
	플레이어.set("낙하_가속_증가율", 3.284)
	플레이어.position = Vector2(160, 상층y - 40.0)
	_루트.add_child(플레이어)

	공통.주인_지정(_루트, _루트)

	var 팩 := PackedScene.new()
	var err := 팩.pack(_루트)
	if err != OK:
		push_error("pack 실패: %s" % error_string(err))
		return
	err = ResourceSaver.save(팩, 씬경로)
	print("[build_스마트월드_1-2] %s → %s" % [error_string(err), 씬경로])


