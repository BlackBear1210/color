	# 다만 지하라 조금 더 어둡고 푸르게 잡아 "물속 공기" 느낌을 준다.
	대기.color = Color(0.52, 0.56, 0.63, 0.46)
	대기.position = Vector2(-2000, -1800)
	대기.size = Vector2(끝x + 4000, 5600)
	대기.z_index = -7
	대기.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_루트.add_child(대기)


func _안개_전부() -> void:
	_안개층("안개_원경", 0.30, -26, Vector2(0, -160), 10, 480.0, 9.0,
		Color(0.78, 0.82, 0.88, 0.10), 11)
	_안개층("안개_중경", 0.65, -6, Vector2(0, 420), 14, 360.0, 15.0,
		Color(0.74, 0.78, 0.85, 0.13), 22)
