# ============================================================================
# 지형 — 선반 (레인월드 문법 ③: 좌우로 엇갈린 수직 이동)
# ============================================================================
## ★수직 이동 규칙: 올라가는 단차는 **110px** 로 통일한다.
##
## 왜 125 가 아니라 110 인가 — `tools/레벨검사.gd` 가 실측으로 잡아낸 값이다.
##   점프 높이 160px 에 조작 오차 여유 20% 를 빼면 판정선이 128px 이다.
##   그런데 선반은 두께가 서로 다르고 윗면이 살짝 기울어 있어서
##   **명목 간격 125px 이 실측 131px** 로 나왔다 → 판정선을 넘어 "못 올라감" 이 됐다.
##   명목 간격은 판정선보다 15px 이상 여유를 두는 게 안전하다.
const 선반간격 := 110.0

func _선반_만들기() -> void:
	var 자료: Array = []

	# ── ③ 갱도: 상층(900) → 하층(1800). 낙차 900px = 그냥 뛰어내리면 즉사(520 초과).
	#    선반 7 장을 125px 간격으로 좌우 엇갈려 둔다 → 밟고 가면 안전.
	var y := 상층y + 25.0
	var 왼쪽 := true
	while y < 하층y - 60.0:
		var x: float = (갱도_좌 + 60.0) if 왼쪽 else (갱도_우 - 60.0)
		자료.append(["갱도선반", Vector2(x, y), 150.0, 36.0, 1.0 if 왼쪽 else -1.0])
		y += 선반간격
		왼쪽 = not 왼쪽

	# ── ⑤ 굴뚝: 하층(1800) → 상층(900). 같은 규칙, 방향만 반대.
	y = 하층y - 120.0
	왼쪽 = true
	while y > 상층y - 20.0:
		var x2: float = (굴뚝_좌 + 40.0) if 왼쪽 else (굴뚝_우 - 40.0)
		자료.append(["굴뚝선반", Vector2(x2, y), 140.0, 34.0, 1.0 if 왼쪽 else -1.0])
		y -= 선반간격
		왼쪽 = not 왼쪽

	var i := 0
	for d in 자료:
		i += 1
		var 지형 := 공통.지형_노드("%s_%d" % [d[0], i], d[1],
			공통.선반_점들(d[2], d[3], d[4]),
			_재질_덩어리, false, false)
		_지형층.add_child(지형)


