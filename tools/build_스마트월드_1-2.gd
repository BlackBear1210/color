func _유체(이름: String, 위치: Vector2, 종류: int, 색: int, 크기: Vector2) -> 유체:
	var n: 유체 = 유체_S.new()
	n.name = 이름
	n.position = 위치
	n.종류 = 종류
	n.색 = 색
	n.크기 = 크기
	_오브젝트층.add_child(n)
	return n


func _배관(이름: String, 위치: Vector2, 모양: int, 세로: bool, 길이: float,
		유체노드: Node) -> void:
	var n := 배관_S.new()
	n.name = 이름
	n.position = 위치
	n.모양 = 모양
	n.세로 = 세로
	n.길이 = 길이
	_오브젝트층.add_child(n)
	if 유체노드:
		n.연결_유체 = n.get_path_to(유체노드)


