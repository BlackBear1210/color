func _공중발판_만들기() -> void:
	var 자료 := [
		# [위치, rx, ry, 필요횟수]  — ⑦ 구멍(7700~8360)을 건너는 다리
		[Vector2(7900, 870), 90.0, 38.0, 1],
		[Vector2(8140, 820), 90.0, 38.0, 1],
		# ① 홀의 위쪽으로 올라가는 징검다리 (선택 경로 — 색칠 연습용)
		# ★[2026-08-06 · 레벨검사기로 잡음] 처음엔 640 / 520 이었는데
		#   바닥이 y=900 이라 첫 칸까지 단차가 288px = 점프(160px)로 못 닿았다.
		#   "일자 바닥" 스테이지는 바닥 높이가 한 값(상층y)으로 고정이라
		#   1-1 처럼 지형 곡선을 눈대중하면 이런 실수가 난다. 단차를 125px 로 다시 잡았다.
		[Vector2(760, 815), 95.0, 40.0, 1],    # 실측 윗면 786 · 바닥(900)에서 114
		[Vector2(1010, 705), 95.0, 40.0, 1],   # 실측 윗면 667 · 단차 119
		# ④ 수로 위 — 물줄기를 피해 건너는 길
		[Vector2(4180, 1560), 100.0, 42.0, 2],
		[Vector2(4430, 1470), 95.0, 40.0, 1],
		# ⑥ 배관실 상단 — 레버로 가는 길
		[Vector2(6420, 620), 105.0, 44.0, 2],
		[Vector2(6680, 500), 95.0, 40.0, 1],
	]
	var i := 0
	for d in 자료:
		i += 1
		var 지형 := 공통.지형_노드("발판_%d" % i, d[0],
			공통.덩어리_점들(d[1], d[2], _rng),
			_재질_덩어리, true, true, d[3])
		_지형층.add_child(지형)


