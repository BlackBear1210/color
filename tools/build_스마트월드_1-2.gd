	송풍.position = Vector2(7520, 상층y - 170.0)
	송풍.사거리 = 620.0
	송풍.바람폭 = 220.0
	송풍.세기 = 1150.0
	_오브젝트층.add_child(송풍)

	# 연기 — 바람에 밀려 구멍 위를 가로지른다 (구멍의 깊이를 가려 긴장을 만든다)
	_유체("연기_1", Vector2(7860, 상층y + 60.0), 1, ColorDefs.BLACK, Vector2(140, 340))

	# 구멍 건너편에 색 레이저 하나 더 — 건너자마자 색을 바꿔야 한다
	_레이저("레이저_3", Vector2(8560, 상층y - 250.0), 90.0, 250.0, 44.0,
		ColorDefs.BLACK, 2.6, 0.9)

	# 구멍 가장자리 조명 — "여기가 끊겼다"를 반드시 보이게. 안 보이는 함정은 불합리하다.
	_발광(Vector2(구멍_좌 - 40.0, 상층y - 130.0), 0, Color(1.0, 0.84, 0.70), 300.0, 1.2, 0.3, 0.0)
	_발광(Vector2(구멍_우 + 40.0, 상층y - 130.0), 0, Color(1.0, 0.84, 0.70), 300.0, 1.2, 0.3, 0.0)


# ============================================================================
# ⑧ 연결 통로
# ============================================================================
func _통로_만들기() -> void:
	# 입구 — 1-1 에서 걸어 들어오면 여기서 나온다. 이름이 "입구통로" 여야
	# 1-1 의 출구가 지정한 `다음_진입점` 과 맞는다.
	var 입구 := 통로_S.new()
	입구.name = "입구통로"
	입구.역할 = 연결통로.역할_.입구
	입구.position = Vector2(시작x, 상층y)
	입구.높이 = 170.0
	입구.깊이 = 460.0
	# 통로를 감싼 암반을 천장 매스까지 끌어올려 '파낸 굴'로 보이게 한다
	입구.암반_위 = 450.0
	입구.속빛 = 이전하늘
	_오브젝트층.add_child(입구)

	# 출구 — 다음 스테이지(1-3)는 아직 없다. 만들어지면 `다음_씬` 한 줄만 채우면 된다.
	# 지금은 **1-1 로 되돌아가게** 해 뒀다. 통로 왕복이 실제로 되는지 바로 확인할 수 있고,
	# 스테이지가 순환하니 테스트 중 막다른 길에 갇히지 않는다.
	var 출구 := 통로_S.new()
	출구.name = "출구통로"
	출구.역할 = 연결통로.역할_.출구
	출구.position = Vector2(끝x, 상층y)
	출구.높이 = 170.0
	출구.깊이 = 460.0
	출구.암반_위 = 450.0
	출구.다음_씬 = 이전씬
	출구.다음_진입점 = "입구통로"
	출구.속빛 = 다음하늘
	_오브젝트층.add_child(출구)

	_발광(Vector2(끝x - 160.0, 상층y - 190.0), 0,
		Color(0.90, 0.90, 0.86), 320.0, 1.0, 0.18, 0.0)
	_발광(Vector2(시작x + 200.0, 상층y - 190.0), 0,
		Color(0.86, 0.92, 1.0), 300.0, 0.9, 0.18, 0.0)


