func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	for a in OS.get_cmdline_user_args():
		if a == "--검증":
			_검증만 = true

	var 씬 := load(씬경로) as PackedScene
