func _배경(루트: Node2D) -> void:
	# # STEP15:
	# # 문제: 2F 복도가 8800px 로 길어져서, 880px 짜리 room.png 를 그 폭에 늘려 깔면
	# #       원본 픽셀이 10 배 이상 확대되어 뭉갠다.
	# # 목적: 창문(원화가 그려 둔 유일한 강한 자연광)은 살리고, 긴 복도는 안 흐리게 한다.
	# # 해결: 창문이 있는 **오른쪽 판만** 홀 앞에 자연 크기(2552×3480)로 두고,
	# #       왼쪽 긴 복도와 계단실은 벡터로 그리는 코드 벽지(방_.복도)로 덮는다.
	var 원화 := load(원화_방) as Texture2D

	# ① 홀 앞 창문 판 — room.png 오른쪽 절반(원화 px 880~1760)을 자연 크기로.
	var 창 := _배경판(루트, "배경_2층_복도_오른쪽")
	창.set("영역", Rect2(복도원화_왼, -2100.0, 복도원화_크기.x, 복도원화_크기.y))
	창.set("아래_방", 4)
	창.set("위_방", 4)
	창.set("전환_시작y", 0.0)
	창.set("전환_끝y", 0.0)
	창.set("그림_아래", 원화)
	창.set("그림_맞춤", 1)
	창.set("그림_원본영역", Rect2(880.0, 0.0, 880.0, 1200.0))
	창.set("그림_밝기", 원화_밝기)
	창.set("깊이", -60)
	창.z_index = -60
	창.z_as_relative = false

	# ② 긴 왼쪽 복도 — 코드 벽지. 넓혀도 안 흐려진다.
	var 왼 := _배경판(루트, "배경_2층_복도")
	_코드벽지(왼, 왼복도_영역, -61)

	# ③ 계단실 — 코드 벽지.
	var 계단 := _배경판(루트, "배경_계단실")
	_코드벽지(계단, 계단실_영역, -62)

	# ④ 1층 거실 원화 — 배율 1.6 으로 키운 1층 공간에 맞춘다.
	#    (바닥선 py 963 이 1층 바닥 윗면에 오도록 역산한 `거실_위` 를 그대로 쓴다)
	var 거실 := _배경판(루트, "배경_1층_거실원화")
	거실.set("영역", Rect2(거실_왼, 거실_위, 거실_크기.x, 거실_크기.y))
	거실.set("아래_방", 0)
	거실.set("위_방", 0)
	거실.set("전환_시작y", 0.0)
	거실.set("전환_끝y", 0.0)
	거실.set("그림_아래", load(원화_거실))
	거실.set("그림_맞춤", 1)
	거실.set("그림_원본영역", Rect2())
	거실.set("그림_밝기", 원화_밝기)
	거실.set("깊이", -60)
	거실.z_index = -60
	거실.z_as_relative = false

	# ⑤ 1층 앞바닥 띠 — 원화 py 975 아래만 플레이어 **앞**에 한 겹 더.
	var 앞 := _배경판(루트, "앞바닥_1층")
	앞.set("영역", Rect2(거실_왼, 거실_위 + 975.0 * 거실_배율,
		거실_크기.x, (1200.0 - 975.0) * 거실_배율))
	앞.set("그림_아래", load(원화_거실))
	앞.set("그림_맞춤", 1)
	앞.set("그림_원본영역", Rect2(0.0, 975.0, 2135.0, 225.0))
	앞.set("그림_밝기", 원화_밝기)
	앞.set("깊이", -20)
	앞.z_index = -20
	앞.z_as_relative = false
	print("   ~ 배경 5장 (창문원화 · 왼복도벽지 · 계단실벽지 · 거실원화 · 앞바닥)")


## 배경판 하나를 찾거나 만든다. (두 번 돌려도 늘지 않는다 = 멱등)
func _배경판(루트: Node2D, 이름: String) -> Node2D:
	var n := 루트.get_node_or_null(이름) as Node2D
	if n == null:
		n = 실내배경_S.new()
		n.name = 이름
		루트.add_child(n)
	return n


## # STEP15:
## # 문제: 코드 벽지는 0.15~0.40 대역으로 그려지는데 CanvasModulate 0.62 가 곱해지면
## #       거의 검정이 된다(STEP 12 실측).
## # 해결: 원화용 1.05 가 아니라 2.0 을 준다. 그리고 `깊이`(실내배경.gd 가 런타임에
## #       z_index 를 덮어쓴다)를 원화(−60)보다 뒤로 밀어 거실 원화를 안 가리게 한다.
func _코드벽지(판: Node2D, 영역: Rect2, 깊이: int) -> void:
	판.set("영역", 영역)
	판.set("아래_방", 실내배경_S.방_.복도)
	판.set("위_방", 실내배경_S.방_.복도)
	판.set("그림_아래", null)          # null 이면 코드 벽지를 그린다
	판.set("그림_원본영역", Rect2())
	판.set("그림_밝기", 2.0)
	판.set("전환_시작y", 0.0)          # ⚠ 이 두 값을 안 끄면 위·아래 방이 섞인다
	판.set("전환_끝y", 0.0)
	판.set("깊이", 깊이)
	판.z_index = 깊이
	판.z_as_relative = false


func _오브젝트_이동(루트: Node2D) -> void:
	var 오 := 루트.get_node("오브젝트") as Node2D
	# 입구통로 — 대복도 왼쪽 끝.
	var 입구 := 오.get_node_or_null("입구통로") as Node2D
	if 입구 != null:
		입구.position = Vector2(-5200.0, 0.0)
	# 출구통로 — 1층 오른쪽 끝.
	var 출구 := 오.get_node_or_null("출구통로") as Node2D
	if 출구 != null:
		출구.position = Vector2(13800.0, 일층)
	# # STEP15:
	# # 문제: `경계_반딧불이`(흰색 강제 구역)가 STEP 12 이후 월드 x 7960~8290 —
	# #       옛 맵 밖에 떠 있었고, 짝인 반딧불 무리와도 떨어져 있었다.
	# # 목적: 색을 강제하는 구역이 **아무 데도 아닌 곳**에 있는 상태를 끝낸다.
	# # 해결: 1층 유령(EXIT_GHOST)을 감싸도록 옮긴다. 그러면 "출구 앞 유령은 반드시
	# #       흰색으로 칠해야 한다"는 원래 설계 의도가 다시 성립한다.
	# #       (폴리곤은 로컬 좌표라 노드 자리만 옮기면 구역 전체가 따라온다)
	var 경계 := 오.get_node_or_null("경계_반딧불이") as Node2D
	if 경계 != null:
		# 폴리곤 로컬 (2560,380)~(2890,900) → 월드 12480~12810 · 2400~2920 = EXIT_GHOST 딱 그 자리.
		경계.position = Vector2(9920.0, 2020.0)
	# 1층 반딧불 무리 — 거실 안으로. (자식 오프셋 x 2585~2865 · y 430~872)
	var 홀 := 오.get_node_or_null("반딧불_홀") as Node2D
	if 홀 != null:
		홀.position = Vector2(8100.0, 1600.0)
	# 복도 반딧불 — 대복도 가운데로.
	var 복 := 오.get_node_or_null("반딧불_복도") as Node2D
	if 복 != null:
		복.position = Vector2(-1300.0, -400.0)
	# ⚠ 광원 자리는 `tools/조명_배치.gd` 의 배치표가 유일한 출처다.
	#   여기서는 옛 좌표에 남아 있는 것만 새 공간 안으로 끌어다 놓고,
	#   실제 값·자리는 STEP 15 조명 패스에서 그 표로 다시 잡는다.
	for 쌍 in [["복도벽등", Vector2(-1200.0, -640.0)],
			["계단창빛", Vector2(8000.0, -1700.0)],
			["홀천장등", Vector2(11400.0, 1500.0)],
			["등_복도_A", Vector2(-3500.0, -430.0)],
			["등_복도_B", Vector2(700.0, -430.0)],
			["등_계단참", Vector2(8000.0, -200.0)],
			["등_홀샹들리에", Vector2(11400.0, 1900.0)]]:
		var n := 오.get_node_or_null(String(쌍[0])) as Node2D
		if n != null:
			n.position = 쌍[1]
	print("   ~ 입구(−5200,0) · 출구(13800,%.0f) · 흰색강제구역 → 출구 유령" % 일층)


## # STEP15:
## # 문제: 구역 카메라의 `줌_배수` 는 기준 줌 1.35 에 맞춰 잡혀 있었다. 기준을 0.85 로
## #       내리면서 그대로 두면 계단이 0.85×0.85 = 0.72 까지 빠져 플레이어가 너무 작아진다.
## # 목적: 어느 구역에서도 실효 줌이 0.78~0.92 안에 있게(= 레퍼런스 0.849 근처) 만든다.
## # 해결: 배수를 0.92~1.08 로 다시 잡는다. 구역별 "조이고 푸는" 연출은 살아 있되 폭이 작다.
func _카메라공간(루트: Node2D) -> void:
	var 오 := 루트.get_node("오브젝트") as Node2D
	var 표 := [
		# 이름, 자리, 크기, 줌배수 (실효줌 = 0.85 × 배수)
		["카메라_2층복도", Vector2(-800.0, -700.0), Vector2(9200.0, 2600.0), 1.00],
		["카메라_좁은통로", Vector2(5050.0, -1000.0), Vector2(2900.0, 2000.0), 1.08],
		["카메라_계단", Vector2(8100.0, 900.0), Vector2(3900.0, 3200.0), 0.94],
		["카메라_1층홀", Vector2(10200.0, 2100.0), Vector2(8000.0, 2200.0), 0.92],
	]
	for r in 표:
		var c := 오.get_node_or_null(String(r[0])) as Node2D
		if c == null:
			continue
		c.position = r[1]
		c.set("크기", r[2])
		c.set("줌_배수", float(r[3]))
		var 모양 := c.get_node_or_null("판정") as CollisionShape2D
		if 모양 != null and 모양.shape is RectangleShape2D:
			(모양.shape as RectangleShape2D).size = r[2]
	print("   ~ 카메라 공간 4 (실효 줌 0.80~0.92)")


