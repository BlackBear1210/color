const 색구역스크립트 := "res://scenes/경계/color_zone.gd"
const PLAYER := "res://scenes/player/Player.tscn"
const 내씬 := "res://scenes/집/스테이지_1_2층방.tscn"
const 다음씬 := ""    ## STAGE 2 는 아직 없다. 빈 문자열이면 통로는 그림만 그린다.

const 튜닝 := {"move_speed": 390.0, "타일_크기": 16.0, "점프_높이_칸": 10.0, "점프_거리_칸": 15.0}

# ══════════════════════════════════════════════════════════════════════════
# ★배율 — 이 상수 하나가 방·배경·지형을 전부 결정한다
# ══════════════════════════════════════════════════════════════════════════
## 1.00 → 방 높이 923 (플레이어 키의 9.6 배) · 총 폭 2635
## 1.15 → 방 높이 1062 (11.1 배) · 총 폭 2955   ← 현재
## 1.35 → 방 높이 1246 (13.0 배) · 총 폭 3382
const 배율 := 1.15

# ── 원화 (room.png 2135 × 1200) 실측 좌표 ─────────────────────────────────
const 원화_방 := "res://assets/background/room.png"
const 원화_원본 := Vector2(2135.0, 1200.0)
const 원화_바닥py := 950.0     ## 방바닥선
const 원화_천장py := 26.7      ## 천장선
## ★구역 경계 — 옷장 오른쪽 끝(779)과 침대 왼쪽 끝(806) 사이. 가구를 자르지 않는다.
const 원화_경계px := 800.0
const 띠_시작py := 962.0        ## 앞바닥으로 뜰 띠
const 띠_끝py := 1075.0
const 원화_밝기 := 1.05
const 벽_시차 := 0.98

# ── 방의 뼈대 (전부 배율에서 나온다) ──────────────────────────────────────
const 바닥y := 0.0
const 벽두께 := 500.0         ## ★통로 깊이(420)를 통째로 품을 만큼 두껍게
const 구조두께 := 300.0
const 천장y := (원화_천장py - 원화_바닥py) * 배율             ## ≈ −1061.8

## 구역 1-1 : 원화 0 … 800
const Z1_왼 := 0.0
const Z1_오른 := 원화_경계px * 배율                           ## ≈ 920
## 가운데 벽 — 두 구역을 끊는다. 여기가 "1-2 를 미리 보여주지 않는" 장치다.
const 가운데벽_왼 := Z1_오른
const 가운데벽_오른 := Z1_오른 + 벽두께                       ## ≈ 1420
## 구역 1-2 : 원화 800 … 2135
const Z2_왼 := 가운데벽_오른
const Z2_오른 := 가운데벽_오른 + (원화_원본.x - 원화_경계px) * 배율   ## ≈ 2955

const 왼끝 := Z1_왼
const 오른끝 := Z2_오른

# ── 게임플레이 절대 치수 (배율과 무관하다 — 플레이어가 안 바뀌므로) ───────
# ── 게임플레이 절대 치수 (배율과 무관하다 — 플레이어가 안 바뀌므로) ───────
const 상승 := 110.0            ## 한 칸. 오를 수 있는 단차 128 보다 안전하게 아래
const 간격 := 150.0            ## 뛰어 건널 틈. 건널 수 있는 간격 204 보다 안전하게 아래
const 계단폭 := 300.0          ## ★코너 쿼드가 사방 90 씩 먹는다. 이게 하한이다.
## 가구를 바닥에 얼마나 박아 넣나. 300(바닥 두께)까지 박으면 나무가 벽돌 바닥을
## 통째로 덮어 "바닥이 나무판" 으로 보인다. 150 이면 가구 다리만 바닥에 잠긴다.
const 가구밑 := 150.0

# ══════════════════════════════════════════════════════════════════════════
# ★★ 레이아웃 원칙 — 공중 발판을 쓰지 않는다 (2026-08-30 실측으로 확정)
# ══════════════════════════════════════════════════════════════════════════
## 처음에는 v3 처럼 좌우로 지그재그하는 공중 발판을 놓으려 했다. 안 된다.
##
##   같은 세로줄에서 두 칸(220) 위에 두께 160 발판을 놓으면
##     위 발판 아랫면 = 윗면 + 160,  콜리전이 24 씩 부푸니 실효 아랫면 = 윗면 + 136
##     아래 발판 윗면(윗면 + 220) 과의 틈 = **220 − 136 − 24 = 60**
##   지나다니려면 **키 96 + 콜리전 48 = 144** 가 필요하다. 60 은 어림도 없다.
##   → 아래 발판이 **밟을 수 없는 면**이 된다(레벨검사가 실제로 9 개를 잡아냈다).
##
##   Z1 은 폭 920 이라 발판 자리가 좌·우 두 줄뿐이고, 두 줄로 지그재그하면
##   같은 줄이 반드시 두 칸 간격으로 겹친다. **좁은 방에서는 지그재그가 성립하지 않는다.**
##
##   더 근본적으로, 바닥(y 0)에서 발판 아래로 지나가려면 발판 윗면이
##   −(144 + 24 + 160) = **−328** 보다 높아야 한다. 그런데 거기까지 오르려면
##   110 짜리 계단이 세 칸 필요하고, 그 세 칸이 또 겹친다.
##
## → **전부 바닥에 뿌리내린 계단 덩어리로 짓는다.**
##   · 겹칠 일이 없다 = 밟을 수 없는 면이 안 생긴다
##   · 어디서 떨어져도 바닥이고, 계단 옆면(110)은 다시 오를 수 있다 = 소프트락 0
##   · 원화의 가구(서랍장 → 책장 → 옷장 / 침대 → 궤짝)가 원래 바닥에 놓인 것들이라
##     그림과도 맞는다
##
## ⚠ 유령 발판(칠해야 생기는 발판)은 이 방에 못 넣는다 — 위 계산 그대로,
##   층고 1062 안에서는 유령 발판을 놓을 만한 높이가 안 나온다.
##   난이도 1~3 튜토리얼이므로 **STAGE 2 로 미룬다.**

# ── 문간 ───────────────────────────────────────────────────────────────────
const 문간높이 := 170.0        ## 실효 = 170 − 48 = 122 > 몸 96 ✔
const 통로깊이 := 420.0
const 통로두께 := 24.0
## ★구역을 잇는 문간과 스테이지 출구는 둘 다 **두 칸 높이(−220)** 에 있다.
##   계단 두 칸으로 오르면 곧 문이다 = "올라가면 나갈 수 있다" 가 한눈에 읽힌다.
const Y_문턱 := -상승 * 2.0                                   ## −220

# ══════════════════════════════════════════════════════════════════════════
# 구역 1-1 — 서랍장 → 책장 (원화 0…800)
# ══════════════════════════════════════════════════════════════════════════
##   ┌──────────────── 가운데 벽
##   │                 ┌──[블록B −220]──→ 문간
##   │      [블록A −110]  ↑ 틈 120
##   │ START            
##   └─────────────────────────────
## 틈 120 을 못 건너도 바닥에 떨어질 뿐이고, 블록A 옆면(110)으로 다시 오른다.
const Z1_A_왼 := 200.0
const Z1_A_오른 := 200.0 + 계단폭                             ## 500
const Z1_B_왼 := 620.0                                        ## 틈 120
const Z1_B_오른 := Z1_오른                                    ## 920 · 가운데 벽에 붙는다

# ══════════════════════════════════════════════════════════════════════════
# 구역 1-2 — 침대 → 궤짝 → 출구 (원화 800…2135)
# ══════════════════════════════════════════════════════════════════════════
##   가운데 벽 ┐
##   문간 ─→ [침대 −220][−110]   틈 150   [궤짝 −110][−220] ─→ 출구
##   ──────────────────────────바닥──────────────────────────
## 원화 침대(806…1356) 자리에 침대 계단이, 원화 의자·탁자(1708…2135) 자리에 궤짝이 온다.
const Z2_침대_왼 := Z2_왼                                     ## 1420 · 벽에 붙는다
const Z2_침대_가운데 := Z2_왼 + 계단폭                        ## 1720
const Z2_침대_오른 := Z2_왼 + 계단폭 * 2.0                    ## 2020
const Z2_궤짝_왼 := Z2_침대_오른 + 간격                       ## 2170 · 틈 150
const Z2_궤짝_가운데 := Z2_궤짝_왼 + 계단폭                   ## 2470
const Z2_궤짝_오른 := Z2_오른                                 ## 2955 · 오른 벽에 붙는다

# ── 창문 — 원화의 **진짜 창 자리**(px 1591…1911 · py 310…769) ─────────────
##   ⚠ 창(z −30)은 지형(z 0)보다 뒤다. 궤짝이 창 아래를 조금 가리는데
##     그건 "창 앞에 가구가 있다" 로 읽히므로 그대로 둔다.
const 창 := Rect2(
	가운데벽_오른 + (1591.0 - 원화_경계px) * 배율,
	(310.0 - 원화_바닥py) * 배율,
	(1911.0 - 1591.0) * 배율,
	(769.0 - 310.0) * 배율)

const 리밋 := Rect2(왼끝 - 벽두께 - 100.0, 천장y - 구조두께 - 100.0,
	(오른끝 - 왼끝) + 벽두께 * 2.0 + 200.0,
	-천장y + 구조두께 + 600.0)


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 1 · 2층 방 (v4 · 원화 두 구역) ===")
	print("   배율 %.3f · 층고 %.0f (플레이어 키의 %.1f 배)" % [배율, -천장y, -천장y / 96.0])
	print("   1-1  %.0f … %.0f (폭 %.0f)" % [Z1_왼, Z1_오른, Z1_오른 - Z1_왼])
	print("   가운데벽 %.0f … %.0f" % [가운데벽_왼, 가운데벽_오른])
	print("   1-2  %.0f … %.0f (폭 %.0f)" % [Z2_왼, Z2_오른, Z2_오른 - Z2_왼])
	var 루트 := _짓기()
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패: %s" % error_string(e))
		quit(1)
		return
	e = ResourceSaver.save(팩, 내씬)
	print("   %-28s %s" % [내씬.get_file(), error_string(e)])
	print("=== 끝 ===\n")
	quit(0 if e == OK else 1)


