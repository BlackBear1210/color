## ▣ 레이어
##   z −45  배경_먼    안개층(실내먼지)      Parallax2D scroll 0.35   대기 · 깊이
##   z −40  배경_방벽  실내배경(원화)        Parallax2D scroll 0.98   ★한 장 · 반전 없음
##   z −30  창문 바깥빛                       (고정)
##   z −28  창틀 · 창살                       (고정)
##   z  −8  문간 뒤 어둠                       (고정 · 개구부와 같은 크기)
##   z   0  지형
##   z +12  전경_어둠  안개층                 scroll 1.10
##   z +40  앞바닥     실내배경(원화 아래띠)  시차 없음 — 플레이어와 같은 깊이
func _배경_짓기(루트: Node2D) -> void:
	# ── 먼 대기 ── 등록 위치가 없으니 시차를 세게 줘도 된다.
	var 먼 := Parallax2D.new()
	먼.name = "배경_먼"
	먼.z_index = -45
	먼.z_as_relative = false
	먼.scroll_scale = Vector2(0.35, 1.0)
	루트.add_child(먼)
	var 안개: Node2D = 안개층_S.new()
	안개.name = "실내먼지"
	안개.position = Vector2(2500.0, -1100.0)
	안개.set("영역", Vector2(7600.0, 2800.0))
	안개.set("덩어리수", 14)
	안개.set("덩어리_반경", 520.0)
	안개.set("흐름속도", 6.0)                      # 실내라 아주 느리게
	안개.set("안개색", Color(0.72, 0.74, 0.78, 0.050))
	먼.add_child(안개)

	# ── 방의 벽 = ★원화(room.png) **한 장** ────────────────────────────────
	#
	# ★★[2026-08-30 도형님 지시] "절대 배경을 이어 붙이거나 똑같은 배경을
	#   좌우 반전 시켜 이어 붙이지마. 배경을 훨씬 더 크게 늘려서 맵의 크기를 늘려."
	#
	#   v2 는 배율 0.845 짜리를 4 장 붙이고 한 장 걸러 뒤집었다. 그 규칙이 폐기됐다.
	#   → **배율 2.90 짜리 한 장.** 원화 폭 6192 가 방 폭 5800 을 통째로 덮는다.
	#     이음매가 0 개이므로 반전으로 감출 것도 없다.
	#
	# ▣ 세로 정렬
	#   원화_배율 이 원화 py 950(방바닥선) 을 바닥y(0) 에, py 26.7(천장선) 을
	#   천장y(−2678) 에 정확히 앉힌다. 위아래로 남는 부분은 천장/바닥 지형이 덮는다.
	var 벽층 := Parallax2D.new()
	벽층.name = "배경_방벽"
	벽층.z_index = -40
	벽층.z_as_relative = false
	벽층.scroll_scale = Vector2(벽_시차, 1.0)
	루트.add_child(벽층)
	var 원화: Texture2D = load(원화_방)
	var 벽지: Node2D = 실내배경_S.new()
	벽지.name = "벽지_원화"
	벽지.set("영역", Rect2(원화_왼끝, 원화_윗끝, 원화_폭, 원화_높이))
	# ⚠ 그림_아래 가 꽂히면 _방_그리기() 는 코드 그림을 쉰다. 그래도 방 종류는
	#   남겨 둔다 — 원화를 빼면 곧바로 예전 절차적 벽지로 되돌아온다.
	벽지.set("아래_방", 실내배경_S.방_.이층방)
	벽지.set("위_방", 실내배경_S.방_.이층방)
	벽지.set("그림_아래", 원화)
	벽지.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	벽지.set("그림_밝기", 원화_밝기)
	벽층.add_child(벽지)

	# ── ★앞바닥 — 2.5D 한 겹 (원화 아래쪽 띠만 떠서 플레이어 앞에 깐다) ────
	#   플레이어가 그 띠 뒤로 들어가면서 방에 깊이가 생긴다.
	#   ⚠ 시차를 주지 않는다. 바닥은 플레이어와 같은 깊이라 같이 움직여야 한다.
	var 앞바닥층 := Node2D.new()
	앞바닥층.name = "앞바닥"
	루트.add_child(앞바닥층)
	var 앞: Node2D = 실내배경_S.new()
	앞.name = "앞바닥_원화"
	앞.set("영역", Rect2(원화_왼끝, 원화_윗끝 + 띠_시작py * 원화_배율,
		원화_폭, (띠_끝py - 띠_시작py) * 원화_배율))
	앞.set("그림_아래", 원화)
	앞.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	앞.set("그림_원본영역", Rect2(0.0, 띠_시작py, 원화_원본.x, 띠_끝py - 띠_시작py))
	앞.set("그림_밝기", 원화_밝기)
	앞.set("앞에_그리기", true)
	앞바닥층.add_child(앞)

	# ── ★문간 뒤의 어둠 (통로 뒤편을 보여주지 않는다) ──────────────────────
	#   연결통로 의 터널은 입구 쪽이 반투명이다(깊이를 만드는 장치라 없애면 안 된다).
	#   그 반투명 너머로 보이는 것이 "다음 스테이지" 가 아니라 **어둠**이어야 한다.
	#   ⚠ 화면을 덮는 검정 사각형이 아니다 — 크기가 개구부와 같고(500×170),
	#     배경 레이어(z −8)에 있으며, 시차를 주지 않는다.
	_문간_어둠(루트, "문간어둠_입구",
		Rect2(왼끝 - 벽두께, Y_입구문간위, 벽두께, 문간높이))
	_문간_어둠(루트, "문간어둠_출구",
		Rect2(오른끝, Y_출구문간위, 벽두께, 문간높이))

	# ★창문 = 벽의 개구부. 문간과 같은 문법, 밝기만 반대다.
	#   ★v3: 높은 벽(층고 2678)에 900×900 짜리 큰 창을 냈다. 이 방의 랜드마크다.
	_창문_개구부(루트, "창문_방", 창)

	# ── 전경 어둠 ── 출구 쪽으로 갈수록 어두워진다.
	#   광원을 빼는 것만으로는 부족해서, 아주 옅은 검은 대기를 **앞에** 한 겹 흘린다.
	#   ⚠ 균일한 검정 판이 아니라 **덩어리진 안개**라 "어둠이 깔려 있다" 로 읽힌다.
	var 전경 := Parallax2D.new()
	전경.name = "전경_어둠"
	전경.z_index = 12
	전경.z_as_relative = false
	전경.scroll_scale = Vector2(1.10, 1.0)
	루트.add_child(전경)
	var 어둠안개: Node2D = 안개층_S.new()
	어둠안개.name = "출구쪽_어둠"
	어둠안개.position = Vector2(4700.0, -500.0)     # 방 오른쪽 1/3 에만
	어둠안개.set("영역", Vector2(2400.0, 1600.0))
	어둠안개.set("덩어리수", 8)
	어둠안개.set("덩어리_반경", 360.0)
	어둠안개.set("흐름속도", -4.0)
	어둠안개.set("안개색", Color(0.02, 0.02, 0.03, 0.16))
	전경.add_child(어둠안개)


## ★창문 = **벽에 난 개구부** (문간과 완전히 같은 구조 · 밝기만 반대)
##
## ▣ 왜 프리팹(`창문_배경.tscn`)을 안 쓰나
##   그 프리팹은 창틀·커튼과 함께 **빛줄기를 그리는데, 줄기 끝에 둥근 캡**을 붙인다.
##   화면에서 그게 "빛을 쏘는 회색 구슬 3~4 개" 로 보인다 — 지시 §7 문제 C 가 지적한
##   바로 그 모양이다. `빛_기본세기 = 0` 으로 낮춰도 캡은 그대로 남았다(실측 확인).
##   → 이 스테이지에서는 쓰지 않는다. **다른 스테이지의 커튼 퍼즐에는 그대로 쓸 수 있다.**
##
## ▣ 대신 문간과 **같은 문법**으로 만든다
##   ```
##   문간 = 벽의 구멍 + 배경 레이어의 **어두운** 판 + (통로가 그리는 어둠)
##   창문 = 벽의 구멍 + 배경 레이어의 **밝은** 판 + (빛기둥이 그리는 빛)
##   ```
##   구조가 같으니 플레이어는 "저건 벽에 뚫린 것" 이라고 같은 방식으로 읽는다.
##   빛의 출발점이 물체가 아니라 **개구부**가 된다 = 지시 §8 의 구조 그대로다.
func _창문_개구부(루트: Node2D, 이름: String, 창: Rect2) -> void:
	# ① 바깥에서 들어오는 빛 (유리 너머). 이 방에서 **가장 밝은 면**이다.
	var 빛면 := ColorRect.new()
	빛면.name = 이름 + "_바깥빛"
	빛면.color = Color(0.68, 0.69, 0.72)
	빛면.position = 창.position
	빛면.size = 창.size
	빛면.z_index = -30                    # 벽지(−40) 앞 · 지형(0) 뒤
	빛면.z_as_relative = false
	빛면.mouse_filter = Control.MOUSE_FILTER_IGNORE
	루트.add_child(빛면)

	# ② 창틀 + 십자 창살. 실루엣이 있어야 "유리창" 으로 읽힌다.
	#    흑백 게임이라 밝은 면 위의 **검은 선 몇 줄**만으로 창이 성립한다.
	var 틀 := 22.0
	var 살 := 14.0
	var 조각: Array = [
		["윗틀", Rect2(창.position.x, 창.position.y, 창.size.x, 틀)],
		["아랫틀", Rect2(창.position.x, 창.end.y - 틀, 창.size.x, 틀)],
		["왼틀", Rect2(창.position.x, 창.position.y, 틀, 창.size.y)],
		["오른틀", Rect2(창.end.x - 틀, 창.position.y, 틀, 창.size.y)],
		["세로살", Rect2(창.position.x + 창.size.x * 0.5 - 살 * 0.5, 창.position.y,
			살, 창.size.y)],
		["가로살", Rect2(창.position.x, 창.position.y + 창.size.y * 0.5 - 살 * 0.5,
			창.size.x, 살)],
	]
	for c in 조각:
		var r := ColorRect.new()
		r.name = "%s_%s" % [이름, c[0]]
		r.color = Color(0.045, 0.045, 0.055)
		r.position = (c[1] as Rect2).position
		r.size = (c[1] as Rect2).size
		r.z_index = -28                   # 바깥빛(−30) 바로 앞
		r.z_as_relative = false
		r.mouse_filter = Control.MOUSE_FILTER_IGNORE
		루트.add_child(r)


## 개구부 뒤에 붙이는 어두운 판. **개구부와 똑같은 크기**다.
func _문간_어둠(루트: Node2D, 이름: String, 영역: Rect2) -> void:
	var r := ColorRect.new()
	r.name = 이름
	r.color = Color(0.012, 0.012, 0.016)   # 지형 아트(black_fill 0.055)보다 더 어둡다
	r.position = 영역.position
	r.size = 영역.size
	r.z_index = -8                          # 배경(−40)보다 앞 · 지형(0)보다 뒤
	r.z_as_relative = false
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	루트.add_child(r)


