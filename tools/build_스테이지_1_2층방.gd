# 구간 1-2 — 창가 하강 (1-1 출구 → 창 윗틀 → 커튼 → 창턱 → 탁자 → 바닥 → 1-3)
# ============================================================================
## ▣ ★★이 구간의 제1 원칙 (도형님 STEP 1-2 §D)
##   "원화의 가구를 지형으로 통째로 덮지 않는다. 플레이어가 밟는 **윗면에만** 얇게 얹는다."
##   → 여기 있는 지형은 **전부 두께 160 짜리 판**이다. 창문·커튼·의자·기둥은
##     지형이 하나도 없고 원화 그대로 보인다.
##   · 창 유리(4182…5487 · −1688…−603) — 지형 0. 통째로 배경이다.
##   · 세로 기둥 두 개 · 커튼봉 · 커튼 천 — 지형 0. 코벨만 기둥에서 뻗어 나온다.
##   · 의자(등받이 폭 128 · 좌판 −17) — 너무 좁고 바닥과 같은 높이라 **안 쓴다.**
##     지형을 억지로 얹으면 원화의 의자 형태를 덮게 된다.
##
## ▣ 재질 (도형님 §I)
##   WOOD  창 윗틀 · 커튼 주름 · 창턱 · 탁자  — 목재 창틀과 가구, 플레이어가 밟는 나무
##   BRICK 기둥 코벨                          — 원화의 세로 기둥에서 뻗어 나온 건축 구조
func _구간_1_2(지: Node2D) -> void:
	# ── ①기둥 코벨 — 1-1 출구와 창 윗틀 사이 657 을 잇는 유일한 인공 구조물 ──
	# 원화의 세로 기둥(4028…4147) 오른쪽 면에서 뻗어 나온다. 벽에 뿌리가 있으니 안 뜬다.
	_지형(지, T_벽돌, "SS_BRICK_POST_CORBEL_01",
		_사각(코벨_왼, Y_코벨, 코벨_오른, Y_코벨 + 발판두께), true)

	# ── ②창 윗틀 — 1-2 의 본격 진입. 원화 창틀 윗면 실측 그대로 ──
	# ★1-1 출구(−1742)와 2px 차이라 계단이 필요 없다(도형님 §B).
	_지형(지, T_나무, "SS_WOOD_WINDOW_TOP_01",
		_사각(창윗틀_왼, Y_창윗틀, 창윗틀_오른, Y_창윗틀 + 발판두께), true)

	# ── ③커튼 주름 3 단 — 창 윗틀에서 창턱까지 1203 을 내려가는 유일한 길 ──
	# ★원화 오른쪽 커튼(5235…5759)이 갈라져 늘어진 자리에 얹는다.
	#   커튼 사이 공간이 좁아 **낙하로 내려간다**(점프가 아니라 하강 리듬).
	#   낙차 360 · 330 · 360 — 전부 안전 낙하 390 아래다.
	# ⚠ 셋이 x 를 공유하므로 윗면 간격을 360 으로 잡았다(규칙 3 의 352 이상).
	for i in [주름1, 주름2, 주름3].size():
		var f: Array = [주름1, 주름2, 주름3][i]
		_지형(지, T_나무, "SS_WOOD_CURTAIN_FOLD_%02d" % (i + 1),
			_사각(float(f[0]), float(f[2]), float(f[1]), float(f[2]) + 발판두께), true)

	# ── ④창턱 — 원화 창턱 윗면(py 765) 실측 그대로 ──
	# 폭 798 의 넓은 안전 지대. 여기서 한숨 돌리고 탁자로 건넌다.
	_지형(지, T_나무, "SS_WOOD_WINDOW_SILL_01",
		_사각(창턱_왼, Y_창턱, 창턱_오른, Y_창턱 + 발판두께), true)

	# ── ⑤탁자 상판 — 상판만. 몸통·다리는 원화가 그린다(도형님 §H) ──
	# ★여기서 바닥까지 낙차 319 → 안전 낙하 390 아래라 그냥 내려선다.
	#   그리고 **바닥에 닿는 순간 `SS_WOOD_FLOOR_01` 이 도달 가능해진다** —
	#   1-1 에서 남아 있던 도달불가 1 건이 이 구간으로 자연히 풀린다.
	_지형(지, T_나무, "SS_WOOD_TABLE_TOP_01",
		_사각(탁자_왼, Y_탁자, 탁자_오른, Y_탁자 + 발판두께), true)


# ============================================================================
# 구간 1-3 — 가구 밑 통과 (넓은 바닥 → 낮은 천장 → 숨통 → 더 낮은 천장 → 바닥)
# ============================================================================
## ▣ ★★이 구간이 만드는 것은 **천장**이지 바닥이 아니다.
##   도형님 지시: "가구를 지형으로 다시 그리지 마라. 원화 위에 얇은 Collision 층만 얹어라."
##   → 여기 지형은 **가구 밑면을 대신하는 얇은 판 두 장**이 전부다.
##     책장·옷장의 몸통·다리·책은 지형이 하나도 없고 원화 그대로 보인다.
##   → 밟는 바닥은 이미 있는 `SS_WOOD_FLOOR_01` 을 그대로 쓴다. 새로 안 만든다.
##
## ▣ 공간 리듬 (도형님 §F)
##
##     넓은 바닥        낮은 천장 220      숨통 130    더 낮은 천장 151    넓은 바닥
##   ├──────────────┤ ├───────────────┤ ├────────┤ ├───────────────┤ ├──────────┤
##    2297 … 5891       옷장 밑            1436…1566   책장 밑            300 … 1015
##    위가 트여 있다     머리가 막힌다       한 번 열림   가장 낮다          다시 열린다
##
## ▣ 실효 높이 = 표기값 − 24(SS2D 콜리전이 아래로 부푼다). 플레이어 키 95.63.
##     옷장 밑 220 − 96 = 124 만큼만 오른다 ✔   책장 밑 151 − 96 = 55 ✔
##   ★둘 다 **점프 높이 167 보다 낮다** → 낮은 천장이 점프를 봉인한다.
func _구간_1_3(지: Node2D, 위험층: Node2D) -> void:
	# ── ①옷장 밑 — 첫 번째 낮은 천장. 여유 있게 만들어 "여기는 지나가는 곳" 을 가르친다 ──
	# 이름이 "천장" 으로 시작 = 레벨검사가 구조물로 본다(윗면은 바닥에서 360 위라 못 올라간다).
	_지형(지, T_나무, "천장_옷장밑_WOOD_01",
		_사각(옷장밑_왼, 옷장밑_아랫면 - 발판두께, 옷장밑_오른, 옷장밑_아랫면), false)

	# ── ②책장 밑 — 두 번째, **가장 낮은** 관문. 원화에서 실제로 뚫린 유일한 자리다 ──
	_지형(지, T_나무, "천장_책장밑_WOOD_01",
		_사각(책장밑_왼, 책장밑_아랫면 - 발판두께, 책장밑_오른, 책장밑_아랫면), false)

	# ── ③가시 — 옷장 밑 한가운데 ──
	# ★낮은 천장(220) 밑이라 **점프가 124 로 제한**된다(220 − 키 96).
	#   그 점프로 건널 수 있는 거리는 약 211px 라 3 칸(96) + 몸 폭 44 = 140 을 넉넉히 넘긴다 ✔
	#   앞 300 · 뒤 303 의 착지 자리가 있어 보고 넘는 장애물이다(도형님 §H — 많이 안 놓는다).
	#   받침은 이미 있는 `SS_WOOD_FLOOR_01` 이 한다 — 가시는 판정만(기존 시스템 그대로).
	_가시(위험층, "가시_1_3", Vector2(가시13_중심x, 바닥y), 가시13_칸수, 가시_높이)


# ============================================================================
# 구간 1-4 — 되돌아가기 · 바닥 파괴
# ============================================================================
## ▣ 이번 단계(STEP 1-4.2)에서 짓는 것은 **딱 두 개**다. 꾸미기는 하지 않는다.
##   ①매트리스 (OneWay)  ②파괴 가능한 마룻바닥
##   공중 발판은 하나도 더하지 않는다 — 1-2 가 이미 창가 공중을 쓰고 있다
##   (`SS_BRICK_POST_CORBEL_01` · `SS_WOOD_CURTAIN_FOLD_02/03` ·
##    `SS_WOOD_WINDOW_SILL_01` · `SS_WOOD_TABLE_TOP_01`).
func _구간_1_4(지: Node2D, 기믹층: Node2D, 오브젝트층: Node2D) -> void:
	# ── ①침대 매트리스 — 1-3 에서는 **밑으로 지나가고**, 1-4 에서는 **위에 선다** ──
	# 얇은 판(두께 160)이라 밑에 275 가 남고, OneWay 라 아래에서 위로도 뚫린다.
	# → 1-3 의 좌우 통행에 영향이 0 이다(회귀 없음).
	# ★칠하기_허용 = true — 1-1·1-2 의 밟는 발판과 같은 규칙(구조물이 아니다).
	# ⚠ OneWay 는 빌더에서 켜도 씬에 저장되지 않는다(인스턴스 내부 노드라 owner 가 없다).
	#   → `단방향지형.gd` 가 런타임에 켠다. 자세한 이유는 그 파일 머리말.
	_지형(지, T_나무, "SS_WOOD_MATTRESS_01",
		_사각(매트리스_왼, 매트리스_윗면, 매트리스_오른, 매트리스_윗면 + 매트리스_두께),
		true, false, 단방향지형_S, true)

	# ── ②부서지는 벽 — 1-4 의 최종 관문 ──
	# 오른쪽 벽에 뚫어 둔 문간(−170…0)을 **벽돌로 막아 놓은 것**이다.
	# 부수기 전에는 벽과 이어져 보이고(재질도 같은 BRICK), 3 발이면 뚫려 복도로 나간다.
	# ★BRICK 인 이유: 벽이다. "WOOD = 밟는 나무 가구 / BRICK = 벽·건축 구조" 규약 그대로.
	var 파괴 := 부서지는지형_S
	_지형(지, T_벽돌, "SS_BRICK_BREAK_WALL_01",
		_사각(파괴벽_왼, 파괴벽_윗면, 파괴벽_오른, 바닥y),
		true, false, 파괴, false)
	var 벽노드 := 지.get_node_or_null("SS_BRICK_BREAK_WALL_01")
	if 벽노드:
		벽노드.set("필요_명중", 파괴벽_명중)
		# ★색칠 완성과 파괴를 같은 3 발째로 맞춘다 (자동 계산은 300/96 → 4 를 준다)
		벽노드.set("필요횟수_수동", 파괴벽_명중)

	# ── ③[STEP 1-4.3] 도약대 — 침대 밑에서 튀어 올라 **매트리스 위로** ──
	# 이것 하나로 `레벨검사` 의 "매트리스 도달 불가" 가 풀린다. 발판은 한 장도 안 깐다.
	# ★매트리스가 OneWay 라 **밑에서 뚫고 올라간 뒤 위에서 받힌다** — 1-4.2 에서
	#   이미 실측으로 증명한 동작이다(Mattress Pass Up). 도약대는 그 힘을 주기만 한다.
	_도약대(기믹층, "도약대_침대밑", Vector2(도약대_x, 바닥y + 도약대_묻힘))

	# ── ④[STEP 1-4.3] 진행 신호 — 부서지는 벽 위 반딧불 ──
	# 캄캄한 막다른 구석에 뜬 유일한 빛 = "여기다".
	_신호등(오브젝트층, "신호_파괴벽", 신호등_자리)

	# ── ⑤[2026-09-01] STAGE 1 출구 — 부서지는 벽 **뒤**의 문간 ──
	# 벽이 멀쩡한 동안에는 그 뒤에 숨어 있어 절대 닿지 않는다(벽이 판정을 막는다).
	# 3 발에 뚫리면 그대로 걸어 들어가 STAGE 2(2층 복도)로 넘어간다.
	# ★왼쪽 `입구통로` 와 같은 함수·같은 문간 높이다. 새 전환 시스템을 만들지 않았다.
	_통로(오브젝트층, "출구통로", Vector2(파괴벽_왼, 바닥y), true, 다음씬)


## ▣ 도약대 — **완성품 씬을 그대로 인스턴스한다.** 스크립트를 새로 쓰지 않는다.
##   `도약대.gd` 는 Area2D 가 `p.velocity.y = 도약속도` 로 직접 쓴다.
##   `player.gd` 는 매 프레임 `velocity.x` 만 덮어쓰고 y 는 안 건드리므로 그대로 먹는다.
##   자식 `발판`(StaticBody2D · layer 1)이 실제로 밟히는 면이라 판정과 지형이 분리돼 있다.
func _도약대(층: Node2D, 이름: String, 자리: Vector2) -> void:
	var t: Node2D = (load(T_도약대) as PackedScene).instantiate()
	t.name = 이름
	t.position = 자리
	t.set("폭", 도약대_폭)
	t.set("높이", 도약대_높이)
	t.set("도약속도", 도약대_속도)
	# ★색_제한은 끈다. 켜면 흰색 플레이어만 튀는데, 이 스테이지의 지형은 전부
	#   안 칠한 검정이라 흰색으로 바꾸는 순간 발밑에서 죽는다(`색규칙.gd`).
	#   색 퍼즐은 STAGE 3 부터다.
	t.set("색_제한", false)
	층.add_child(t)


## ▣ 진행 신호 — 반딧불 한 마리. `발광체.gd`(구슬)를 그대로 쓴다.
##   값은 `build_집_배경스테이지.gd::_반딧불이()` 가 쓰던 것을 따랐다(같은 문법).
func _신호등(층: Node2D, 이름: String, 자리: Vector2) -> void:
	var f: Node2D = 발광체_S.new()
	f.name = 이름
	f.position = 자리
	f.set("종류", 발광체_S.종류_.구슬)
	f.set("빛색", Color(1.0, 0.97, 0.90))      # 흑백 게임이라 채도는 거의 0
	f.set("반경", 240.0)
	f.set("밝기", 1.30)
	f.set("깜빡임", 0.28)
	f.set("크기_흔들림", 0.30)
	f.set("흔들림_속도", 0.42)
	f.set("부유", 14.0)                        # 살짝 떠다닌다 = "살아 있는 빛"
	층.add_child(f)
