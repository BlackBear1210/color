# 배경 — 레이어 분리 (지시 §15 Visual Hierarchy · §16 · §17 Parallax)
# ============================================================================
## ▣ 왜 필요한가 (지시 문제 D "블록아웃처럼 보인다")
##   v1 에는 배경이 **아예 없었다.** 그래서 지형이 회색 void 에 떠 있는 그림이 됐다.
##   "2층 방" 이라는 공간이 성립하려면 지형 뒤에 **벽**이 있어야 한다.
##
## ▣ 레이어 (지시 §15 의 우선순위를 z 로 옮긴 것)
##   ```
##   z −45  배경_먼    안개층      scroll 0.35   대기 · 깊이
##   z −40  배경_방벽  실내배경    scroll 0.90   벽지 · 웨인스코팅 · 몰딩
##   z  −8  문간_어둠  ColorRect   (고정)        ★문 뒤는 어둠이다
##   z   0  지형 · 플레이어                      게임플레이
##   z +12  전경_어둠  안개층      scroll 1.10   출구 쪽이 점점 어두워진다
##   ```
##   Parallax2D 값은 `스마트월드_1~4` 에서 이미 쓰고 있는 것을 그대로 따랐다
##   (하늘 0.05 · 원경 0.2 · 중경 0.42 · 근경 0.68 · 전경 1.15). 새로 만들지 않았다.
##
## ⚠ **실내(벽)는 시차를 약하게 준다(0.90).** 벽은 플레이어 바로 뒤에 있는 물건이라
##   0.4 같은 값을 주면 5000px 를 걷는 동안 벽이 3000px 나 밀려서 "벽이 미끄러진다".
##   대기(안개)는 등록 위치가 없으므로 0.35 로 세게 줘도 안전하다.
func _배경_짓기(루트: Node2D) -> void:
	# ── 먼 대기 ── 등록 위치가 없으니 시차를 세게 줘도 된다.
	var 먼 := Parallax2D.new()
	먼.name = "배경_먼"
	먼.z_index = -45
	먼.z_as_relative = false
	먼.scroll_scale = Vector2(0.35, 1.0)
	루트.add_child(먼)
	var 안개: Node2D = 안개층_S.new()
	안개.name = "실내먼지"
	안개.position = Vector2(2200.0, -380.0)
	안개.set("영역", Vector2(7000.0, 1100.0))
	안개.set("덩어리수", 9)
	안개.set("덩어리_반경", 380.0)
	안개.set("흐름속도", 6.0)                      # 실내라 아주 느리게
	안개.set("안개색", Color(0.72, 0.74, 0.78, 0.055))
	먼.add_child(안개)

	# ── 방의 벽 = ★원화(room.png) ─────────────────────────────────────────
	#
	# ★★[2026-08-29 도형님 지시] "스테이지_1 배경을 집_2층방 에 쓰인 배경으로 바꿔"
	#   v2 까지는 `실내배경._이층방()` 이 벽지·웨인스코팅·몰딩을 **코드로** 그렸다.
	#   집_2층방 은 그게 아니라 디자이너 원화 `assets/background/room.png` 를
	#   `그림_아래` 에 꽂아 쓴다(`build_집_배경스테이지.gd` §_2층방). 그쪽으로 맞춘다.
	#
	# ▣ ⚠ v2 주석의 "원화를 타일링하지 않는다" 규칙을 여기서 **알고 깬다.**
	#   원화 한 장이 1803.6px 인데 방이 5190px 라 4 장이 필요하다.
	#   그냥 이어 붙이면 침대·책장이 4 번 반복돼 눈에 띈다.
	#   → **한 장 건너 좌우반전**(`실내배경.좌우반전`)해서 거울상을 섞는다.
	#     같은 그림이라도 거울상이 끼면 반복이 훨씬 덜 읽힌다. 이음매도 벽 무늬가
	#     좌우 대칭으로 만나 자연스럽게 붙는다.
	#
	# ▣ 세로 정렬
	#   `원화_배율` 이 원화 py 950(방바닥선) 을 `바닥y`(0) 에, py 26.7(천장선) 을
	#   `천장y`(−780) 에 정확히 앉힌다. 위아래로 남는 부분은 천장/바닥 지형이 덮는다.
	var 벽층 := Parallax2D.new()
	벽층.name = "배경_방벽"
	벽층.z_index = -40
	벽층.z_as_relative = false
	벽층.scroll_scale = Vector2(0.90, 1.0)         # 벽은 가까운 물건이라 시차를 약하게
	루트.add_child(벽층)
	var 원화: Texture2D = load(원화_방)
	for i in 원화_장수:
		var 벽지: Node2D = 실내배경_S.new()
		벽지.name = "벽지_원화_%02d" % (i + 1)
		벽지.set("영역", Rect2(원화_왼끝 + 원화_폭 * float(i), 원화_윗끝,
			원화_폭, 원화_높이))
		# ⚠ `그림_아래` 가 꽂히면 `_방_그리기()` 는 코드 그림을 쉰다. 그래도 방 종류는
		#   남겨 둔다 — 원화를 빼면 곧바로 예전 절차적 벽지로 되돌아온다.
		벽지.set("아래_방", 실내배경_S.방_.이층방)
		벽지.set("위_방", 실내배경_S.방_.이층방)
		벽지.set("그림_아래", 원화)
		벽지.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
		벽지.set("그림_밝기", 원화_밝기)
		벽지.set("좌우반전", (i % 2) == 1)          # ★한 장 건너 거울상
		벽층.add_child(벽지)

	# ── ★앞바닥 — 집_2층방 과 같은 2.5D 한 겹 ────────────────────────────
	#   원화 아래쪽 띠(py 962~1200 = 방바닥 앞쪽)만 떠서 **플레이어 앞**에 깐다.
	#   플레이어가 그 띠 뒤로 들어가면서 방에 깊이가 생긴다.
	#   ⚠ 시차를 주지 않는다. 바닥은 플레이어와 같은 깊이라 같이 움직여야 한다.
	#     (`앞에_그리기 = true` 가 노드 z 를 +40 으로 올린다 — 지형 0 · 전경어둠 12 보다 앞)
	var 앞바닥층 := Node2D.new()
	앞바닥층.name = "앞바닥"
	루트.add_child(앞바닥층)
	for i in 원화_장수:
		var 앞: Node2D = 실내배경_S.new()
		앞.name = "앞바닥_%02d" % (i + 1)
		앞.set("영역", Rect2(원화_왼끝 + 원화_폭 * float(i),
			원화_윗끝 + 띠_시작py * 원화_배율,
			원화_폭, (띠_끝py - 띠_시작py) * 원화_배율))
		앞.set("그림_아래", 원화)
		앞.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
		앞.set("그림_원본영역", Rect2(0.0, 띠_시작py, 원화_원본.x, 띠_끝py - 띠_시작py))
		앞.set("그림_밝기", 원화_밝기)
		앞.set("좌우반전", (i % 2) == 1)            # 벽과 같은 순서로 뒤집어야 이음매가 맞는다
		앞.set("앞에_그리기", true)
		앞바닥층.add_child(앞)

	# ── ★문간 뒤의 어둠 (지시 §3 "통로 뒤편을 보여주지 않는다") ────────────
	#
	#   `연결통로` 의 터널은 입구 쪽이 **반투명**이다(안으로 갈수록 진해지는 그라데이션 —
	#   그게 깊이를 만드는 장치라 없애면 안 된다). 문제는 그 반투명 너머로
	#   **뒤에 있는 것**이 비친다는 것이었다.
	#   → 개구부 **바로 뒤**(배경 레이어)에 어두운 판을 정확히 개구부 크기로 둔다.
	#     이제 반투명 사이로 보이는 것은 "다음 스테이지" 가 아니라 **어둠**이다.
	#
	#   ⚠ 이것은 "큰 검정 사각형으로 덮기" 가 아니다(지시 §23 금지 사항).
	#     · 크기가 개구부와 같다 (500 × 170) — 화면을 덮지 않는다
	#     · **배경 레이어(z −8)** 에 있다 — 지형·플레이어보다 뒤다
	#     · 시차를 안 준다 — 문간에 정확히 붙어 있어야 하기 때문
	#     지시 §3 의 선택지 중 **4번 Background Layer separation** 에 해당한다.
	_문간_어둠(루트, "문간어둠_입구",
		Rect2(왼끝 - 벽두께, Y_입구문간위, 벽두께, 문간높이))
	_문간_어둠(루트, "문간어둠_출구",
		Rect2(오른끝, Y_출구문간위, 벽두께, 문간높이))

	# ★창문 = 벽의 개구부. 문간과 같은 문법, 밝기만 반대다.
	#   x 1825~2255 · y −730~−310 — 창턱(−90) 위, 서까래(−500, x 1120~1700) 와 안 겹친다.
	_창문_개구부(루트, "창문_방", Rect2(1825.0, -730.0, 430.0, 420.0))

	# ── 전경 어둠 ── 출구 쪽으로 갈수록 어두워진다 (지시 §10 SECTION 06).
	#   광원을 빼는 것만으로는 부족해서, 아주 옅은 검은 대기를 **앞에** 한 겹 흘린다.
	#   ⚠ 균일한 검정 판이 아니라 **덩어리진 안개**라 "어둠이 깔려 있다" 로 읽힌다.
	var 전경 := Parallax2D.new()
	전경.name = "전경_어둠"
	전경.z_index = 12
	전경.z_as_relative = false
	전경.scroll_scale = Vector2(1.10, 1.0)
	루트.add_child(전경)
	var 어둠안개: Node2D = 안개층_S.new()
	어둠안개.name = "출구쪽_어둠"
	어둠안개.position = Vector2(4100.0, -300.0)     # 방 오른쪽 1/3 에만
	어둠안개.set("영역", Vector2(2400.0, 1000.0))
	어둠안개.set("덩어리수", 7)
	어둠안개.set("덩어리_반경", 340.0)
	어둠안개.set("흐름속도", -4.0)
	어둠안개.set("안개색", Color(0.02, 0.02, 0.03, 0.16))
	전경.add_child(어둠안개)


## ★창문 = **벽에 난 개구부** (문간과 완전히 같은 구조 · 밝기만 반대)
##
## ▣ 왜 프리팹(`창문_배경.tscn`)을 안 쓰나
##   그 프리팹은 창틀·커튼과 함께 **빛줄기를 그리는데, 줄기 끝에 둥근 캡**을 붙인다.
##   화면에서 그게 "빛을 쏘는 회색 구슬 3~4 개" 로 보인다 — 지시 §7 문제 C 가 지적한
##   바로 그 모양이다. `빛_기본세기 = 0` 으로 낮춰도 캡은 그대로 남았다(실측 확인).
##   → 이 스테이지에서는 쓰지 않는다. **다른 스테이지의 커튼 퍼즐에는 그대로 쓸 수 있다.**
##
## ▣ 대신 문간과 **같은 문법**으로 만든다
##   ```
##   문간 = 벽의 구멍 + 배경 레이어의 **어두운** 판 + (통로가 그리는 어둠)
##   창문 = 벽의 구멍 + 배경 레이어의 **밝은** 판 + (빛기둥이 그리는 빛)
##   ```
##   구조가 같으니 플레이어는 "저건 벽에 뚫린 것" 이라고 같은 방식으로 읽는다.
##   빛의 출발점이 물체가 아니라 **개구부**가 된다 = 지시 §8 의 구조 그대로다.
func _창문_개구부(루트: Node2D, 이름: String, 창: Rect2) -> void:
	# ① 바깥에서 들어오는 빛 (유리 너머). 이 방에서 **가장 밝은 면**이다.
	var 빛면 := ColorRect.new()
	빛면.name = 이름 + "_바깥빛"
	빛면.color = Color(0.68, 0.69, 0.72)
	빛면.position = 창.position
	빛면.size = 창.size
	빛면.z_index = -30                    # 벽지(−40) 앞 · 지형(0) 뒤
	빛면.z_as_relative = false
	빛면.mouse_filter = Control.MOUSE_FILTER_IGNORE
	루트.add_child(빛면)

	# ② 창틀 + 십자 창살. 실루엣이 있어야 "유리창" 으로 읽힌다.
	#    흑백 게임이라 밝은 면 위의 **검은 선 몇 줄**만으로 창이 성립한다.
	var 틀 := 22.0
	var 살 := 14.0
	var 조각: Array = [
		["윗틀", Rect2(창.position.x, 창.position.y, 창.size.x, 틀)],
		["아랫틀", Rect2(창.position.x, 창.end.y - 틀, 창.size.x, 틀)],
		["왼틀", Rect2(창.position.x, 창.position.y, 틀, 창.size.y)],
		["오른틀", Rect2(창.end.x - 틀, 창.position.y, 틀, 창.size.y)],
		["세로살", Rect2(창.position.x + 창.size.x * 0.5 - 살 * 0.5, 창.position.y,
			살, 창.size.y)],
		["가로살", Rect2(창.position.x, 창.position.y + 창.size.y * 0.5 - 살 * 0.5,
			창.size.x, 살)],
	]
	for c in 조각:
		var r := ColorRect.new()
		r.name = "%s_%s" % [이름, c[0]]
		r.color = Color(0.045, 0.045, 0.055)
		r.position = (c[1] as Rect2).position
		r.size = (c[1] as Rect2).size
		r.z_index = -28                   # 바깥빛(−30) 바로 앞
		r.z_as_relative = false
		r.mouse_filter = Control.MOUSE_FILTER_IGNORE
		루트.add_child(r)


## 개구부 뒤에 붙이는 어두운 판. **개구부와 똑같은 크기**다.
func _문간_어둠(루트: Node2D, 이름: String, 영역: Rect2) -> void:
	var r := ColorRect.new()
	r.name = 이름
	r.color = Color(0.012, 0.012, 0.016)   # 지형 아트(black_fill 0.055)보다 더 어둡다
	r.position = 영역.position
	r.size = 영역.size
	r.z_index = -8                          # 배경(−40)보다 앞 · 지형(0)보다 뒤
	r.z_as_relative = false
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	루트.add_child(r)


# ============================================================================
# 지형
# ============================================================================
func _지형_짓기(지: Node2D) -> void:

	# ── 뼈대 ────────────────────────────────────────────────────────────────
	# ★바닥은 **하나의 끊김 없는 평지**다. 어디서 떨어져도 여기 닿고 걸어서 되돌아온다.
	#
	# ★★[2026-08-29 실측으로 걸러낸 설계 실수] 처음에는 창가에 깊이 110 짜리
	#   "책 읽는 자리" 오목을 팠다. 오목 자체는 게이트 128 이하라 드나들 수 있다.
	#   그런데 그 오목의 오른쪽 끝이 상자(윗면 −110) 바로 옆이라,
	#   **오목 바닥(y 110) → 상자 위(y −110) 가 110 이 아니라 220** 이 됐다.
	#   → 상자를 못 올라가고 그 뒤 전체(유령 발판·책장·문)가 통째로 막혔다.
	#      `레벨검사` 가 "도달 10 / 도달불가 10" 으로 잡았다.
	#   교훈: **높이차는 지형 하나가 아니라 "이웃한 두 표면" 사이에서 재야 한다.**
	#   오목이 주던 안쪽 코너는 가구 덩어리가 바닥과 만나는 자리에서 이미 충분히 나온다.
	#
	# ★유령 오른쪽에 **바닥을 한 단 올린 턱**(−115)을 둔다 = 되돌아 올라오는 길.
	#   유령(윗면 −230)은 바닥에 박힌 덩어리라 바닥(0)에서 곧장 못 오른다(230 > 128).
	#   그래서 선반에서 떨어지면 유령 오른쪽에 갇혔다(`레벨검사` 가 실제로 잡았다).
	#   ⚠ 처음에는 이 턱을 **별도 나무 블록**으로 놨는데, 폭 120 × 높이 265 라
	#     테두리 두 줄(38px×2)이 채움을 거의 다 먹어 **가는 기둥**처럼 보였다
	#     (README §11 "폭 300 미만이면 모서리가 검게 파인 것처럼 보인다").
	#   → 바닥 외곽선 자체를 한 단 올린다. 계단 한 칸처럼 읽히고, 재질도 바닥과 같다.
	_지형(지, T_벽돌, "바닥_STAGE1_BRICK_01", _계단덩어리([
		[왼끝, X_턱, 바닥y],
		[X_턱, X_턱끝, Y_턱],          # ★되돌아오는 턱 (−115)
		[X_턱끝, 오른끝, 바닥y],
	], 바닥y + 구조두께), true)

	# 천장 — 이름이 "천장" 으로 시작해야 레벨검사가 구조물로 보고 도달불가에서 뺀다.
	# ★문 앞(x 4530~)에서 한 단 내려앉으므로 **두 조각으로 나눠 놓는다.**
	#   한 장으로 깔고 그 위에 낮은 천장을 덧대면 두 지형이 겹쳐 텍스처가 중첩된다
	#   (지시 문제 B 와 같은 사고). 경계를 맞대는 쪽이 구조적으로 옳다.
	_지형(지, T_벽돌, "천장_STAGE1_BRICK_01",
		_사각(왼끝, 천장y - 구조두께, X_문앞천장, 천장y), false)

