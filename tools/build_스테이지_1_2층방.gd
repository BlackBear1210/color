	c.position = 자리
	c.set("크기", 크기)
	c.set("줌_배수", 줌)
	# ★★[2026-08-29 v2] `틈새빛_사용`(기본 true · 6 줄기)을 **끈다.**
	#   이게 화면에 "둥근 캡이 달린 빛줄기 3~4 개" 를 그린다 — 지시 §7 이 지적한
	#   "빛을 쏘는 구슬" 의 정체가 바로 이것이었다(빛기둥·발광체·창문 프리팹을
	#   차례로 빼 봐도 안 사라져서 마지막에 찾았다).
	#   이 스테이지의 빛은 창문 개구부 하나로 충분하므로 카메라 공간은 줌만 담당한다.
	c.set("틈새빛_사용", false)
