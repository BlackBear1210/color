func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 1 · 2층 방 (v3 · 원화 한 장) ===")
	print("   방 %.0f … %.0f (폭 %.0f) · 층고 %.0f" % [왼끝, 오른끝, 오른끝 - 왼끝, -천장y])
	print("   원화 배율 %.4f · 폭 %.0f · 장수 1 · 좌우반전 없음" % [원화_배율, 원화_폭])
	var 루트 := _짓기()
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패: %s" % error_string(e))
		quit(1)
		return
	e = ResourceSaver.save(팩, 내씬)
	print("   %-28s %s" % [내씬.get_file(), error_string(e)])
	print("=== 끝 ===\n")
	quit(0 if e == OK else 1)


