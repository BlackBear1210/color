func _짓기() -> Node2D:
	# 시작 위치 = 왼쪽 벽 구멍 안. 통로에서 걸어 나오는 그림이 된다.
	# ★벽이 원화 안(0…300)으로 들어왔으므로 시작 위치도 그 안이다.
	#   카메라 리밋 왼쪽이 0 이라, 예전처럼 x −250 에서 시작하면 화면 밖에 선다.
	var 시작 := Vector2(왼벽_안 - 150.0, 진입_문턱)

	var 루트: Node2D = 월드_S.new()
	루트.name = "스테이지_1_2층방"
	루트.set("스테이지_이름", "1 · 2층 방")
	루트.set("카메라_리밋", 리밋)
	## ★줌 1.00 → 보이는 영역 1920×1080 = 방의 가로 31 % · 세로 40 %.
	##   v4 의 1.55 는 방이 2955×1062 일 때의 값이라 v5 방(6192×2678)에서는
	##   화면이 방보다 훨씬 작아진다. **배율을 바꾼 결과로 따라 바뀐 값이지
	##   카메라 시스템을 손댄 것이 아니다** (proto_camera.gd 는 무수정).
	루트.set("카메라_줌", 1.00)
	루트.set("시작_위치", 시작)
	## 방바닥(0…300) 아래로 떨어지면 잡는 최후의 안전장치.
	루트.set("낙사_y", 900.0)
	## ★실측 즉사 낙하 거리. 1-1(−1943)에서 바닥(0)까지는 1943 이라 절대 못 내려간다 —
	##   이것이 1-1 과 1-3 을 가르는 실제 경계다(§11 "1-1 / 1-3 경계").
	루트.set("치명_낙하거리", 520.0)

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)
	루트.add_child(코어)

	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	어둠.color = (챕터_S.팔레트(1) as Dictionary)["어둠"]
	루트.add_child(어둠)

	var 지 := Node2D.new()
	지.name = "지형"
	루트.add_child(지)

	var 오 := Node2D.new()
	오.name = "오브젝트"
	루트.add_child(오)

	# ★기믹(움직이는 것)과 위험물(닿으면 죽는 것)은 지형과 **다른 층**에 둔다.
	#   지형 = 가만히 있는 것 · 기믹 = 움직이는 것 · 위험물 = hazard 그룹.
	#   에디터에서 한 층을 접으면 그 종류가 통째로 사라져 작업하기 쉽다.
	var 기 := Node2D.new()
	기.name = "기믹"
	루트.add_child(기)
	var 위 := Node2D.new()
	위.name = "위험물"
	루트.add_child(위)

	_배경_짓기(루트)
	_방_뼈대(지)
	if _구간들.has("1_1"):
		_구간_1_1(지)
		_기믹_1_1(기, 위)
	if _구간들.has("1_2"):
		_구간_1_2(지)
	if _구간들.has("1_3"):
		_구간_1_3(지, 위)
	if _구간들.has("1_4"):
		_구간_1_4(지, 기, 오)
	_통로(오, "입구통로", Vector2(왼벽_안, 진입_문턱), false, "")

	var p := (load(PLAYER) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 시작
	for k in 튜닝:
		p.set(k, 튜닝[k])
	루트.add_child(p)
	return 루트


