		Vector2(X_궤짝, Y_궤짝),           # 머리맡 궤짝 (단차 90)
		Vector2(X_궤짝끝, Y_궤짝),
		Vector2(X_궤짝끝, Y_홈),           # ★얕은 홈 (깊이 100 · 폭 150)
		Vector2(X_책상, Y_홈),
		Vector2(X_책상, Y_궤짝),           # 책상 (같은 높이 −180)
		Vector2(X_책상끝, Y_궤짝),
		Vector2(X_책상끝, 가구밑),
