## ▣ 레이어 — ★[2026-08-30] 앞바닥 층을 없애 **딱 세 겹**만 남겼다
##   z −60  배경  실내배경 ×1 — room.png **한 장 통째로** (Parallax2D scroll 0.98)
##   z −45  실내먼지 (안개층 · 알파 0.05 짜리 분위기용. 방 구조를 그리지 않는다)
##   z  −8  문간 뒤 어둠 (개구부 크기만큼의 검은 판)
##   z   0  지형 (SmartShape2D)
##   그 위  Player
## ★원화 위에 벽지·몰딩·액자·가구를 코드로 다시 그리는 층은 **하나도 없다**
##   (`_방섞임_끄기()` 가 `_이층방()` 코드 그림을 차단한다 — 아래 함수 주석 참고).
func _배경_짓기(루트: Node2D) -> void:
	var 먼 := Parallax2D.new()
	먼.name = "배경_먼"
	먼.z_index = -45
	먼.z_as_relative = false
	먼.scroll_scale = Vector2(0.35, 1.0)
	루트.add_child(먼)
	var 안개: Node2D = 안개층_S.new()
	안개.name = "실내먼지"
	안개.position = Vector2((왼끝 + 오른끝) * 0.5, 천장y * 0.5)
	안개.set("영역", Vector2(오른끝 - 왼끝 + 1200.0, -천장y + 600.0))
	# 방이 v4 의 5.5 배 넓어졌으므로 덩어리 수와 반경도 같이 키운다.
	# (안 키우면 6192 폭에 10 덩어리라 먼지가 있는 듯 없는 듯해진다)
	안개.set("덩어리수", 22)
	안개.set("덩어리_반경", 520.0)
	안개.set("흐름속도", 6.0)
	안개.set("안개색", Color(0.72, 0.74, 0.78, 0.050))
	먼.add_child(안개)

	var 벽층 := Parallax2D.new()
	벽층.name = "배경_방벽"
	벽층.z_index = -40
	벽층.z_as_relative = false
	벽층.scroll_scale = Vector2(벽_시차, 1.0)
	루트.add_child(벽층)

	var 원화: Texture2D = load(원화_방)
	# ★★여기가 v5 의 핵심 한 줄 — `그림_원본영역` 을 **원화 전체**로 준다.
	#   v4 는 이 자리에서 원화를 0…800 / 800…2135 두 조각으로 잘라 두 번 깔았다.
	#   v5 는 한 장을 통째로 `영역`(6191.5 × 3480)에 늘인다.
	var b: Node2D = 실내배경_S.new()
	b.name = "벽지_2층방_전체"
	b.set("영역", Rect2(왼끝, (0.0 - 원화_바닥py) * 배율,
		오른끝 - 왼끝, 원화_원본.y * 배율))
	b.set("아래_방", 실내배경_S.방_.이층방)
	b.set("위_방", 실내배경_S.방_.이층방)
	_방섞임_끄기(b)
	b.set("그림_아래", 원화)
	b.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	b.set("그림_원본영역", Rect2(0.0, 0.0, 원화_원본.x, 원화_원본.y))
	b.set("그림_밝기", 원화_밝기)
	벽층.add_child(b)

	# ── ★★[2026-08-30] 앞바닥(2.5D 띠)을 **완전히 없앴다** (도형님 STEP 1-1.6 §2) ──
	#
	# ▣ 무엇이었나
	#   원화의 맨 앞 바닥 띠(py 962…1075)만 `그림_원본영역` 으로 **잘라서** 한 겹 더 깔고,
	#   `앞에_그리기`(z +40)로 플레이어 앞에 세워 깊이를 만들던 v2 시절 수법이다.
	#
	# ▣ 왜 없애나
	#   ① 도형님 §1 — "Crop 금지 / Region 잘라쓰기 금지". 이 띠가 바로 원화 크롭이었다.
	#   ② 실제로는 z **−60**(배경 뒤)에 그려지고 있었다. `앞에_그리기` 값이 씬에 저장되지
	#      않아 `_ready()` 의 `z_index = 40 if 앞에_그리기 else -60` 이 −60 을 골랐다.
	#      → 배경 뒤에 배경 일부를 한 번 더 그리는 **순수한 낭비**였다.
	#   ③ 이 방은 배경 한 장이 py 1200 까지 다 있고 카메라 리밋 아래끝이 y 725(py 1200)라,
	#      원화의 앞바닥 부분이 **이미 그대로 보인다.** 따로 띠를 얹을 이유가 없다.
	#
	# ⚠ `실내배경.gd` 의 `앞에_그리기` 기능 자체는 **지우지 않았다.**
	#   집_거실 · 집_부엌 · 집_굴뚝 · 집_복도계단 · 집_2층방 이 아직 쓰고 있다(회귀 방지).
	#   이 스테이지에서만 안 만든다.

	# ── 입구 구멍 뒤의 어둠 (개구부와 똑같은 크기) ──
	_문간_어둠(루트, "문간어둠_입구",
		Rect2(왼끝, 진입_문턱 - 문간높이, 벽두께, 문간높이))


# ============================================================================
# 방 뼈대 — 바닥 · 천장 · 좌우 외벽 (Room Boundary)
# ============================================================================
## ★바닥은 끊김 없는 하나의 평지다. 1-3 · 1-4 가 여기 위에서 벌어진다.
## ⚠ 이번 STEP 에서는 1-1 만 지으므로 **바닥으로 내려가는 길이 아직 없다.**
##   레벨검사가 `SS_WOOD_FLOOR_01` 을 [도달불가]로 보고하는 것은 정상이며,
##   1-3 을 지으면 사라진다.
func _방_뼈대(지: Node2D) -> void:
	# ★전부 원화 사각형(0…6191.5) **안**에 들어간다 — 카메라 리밋이 원화와 같기 때문이다.
	#
	# ★★[2026-08-30 도형님 STEP 1-1.6 §3] 방 바닥은 **반드시 WOOD**다.
	#   원화의 2층 방 바닥은 나무 마루다. 여기에 벽돌을 깔면 재질 언어가 어긋난다
	#   ("WOOD = 밟는 나무 바닥·가구 / BRICK = 벽·기둥·건축 구조").
	#   윗면 y 0 = 원화 py 950 = **원화에서 벽과 바닥이 만나는 선**(실측 936…965 사이).
	#   두께 300 은 원화 py 950…1053 만 덮는다 → 그 아래 py 1053…1200(앞쪽 마루·비네트)은
	#   **원화 그대로 보인다.** 앞바닥 띠가 필요 없어진 이유가 이것이다.
	#
	# ⚠ `칠하기_허용 = false` 로 둔다(재질과 무관한 별개 결정).
	#   true 로 하면 안 칠한 바닥은 검정이라 **흰색 플레이어가 바닥에 닿는 순간 죽는다.**
	#   색 퍼즐은 STAGE 3 부터라(가이드라인 §3.7) 지금 켜면 Shift 를 못 쓴다.
	#   인스펙터 "색칠 > 칠하기 허용" 체크박스로 언제든 켤 수 있다.
	# ★[2026-09-01] 바닥은 다시 **끊김 없는 한 장**이다. 파괴 지형이 벽으로 옮겨갔다.
	_지형(지, T_나무, "SS_WOOD_FLOOR_01",
		_사각(왼끝, 바닥y, 오른끝, 바닥y + 구조두께), false)
	# 이름이 "천장" 으로 시작해야 레벨검사가 구조물로 보고 도달불가에서 뺀다.
	_지형(지, T_벽돌, "천장_STAGE1_BRICK_01",
		_사각(왼끝, 천장y - 구조두께, 오른끝, 천장y), false)

	# ── 왼쪽 외벽 (0…300) — 진입 구멍(문턱 −2050 · 높이 170)만 뚫려 있다 ──
	_지형(지, T_벽돌, "벽_왼위_BRICK_01",
		_사각(왼끝, 천장y, 왼벽_안, 진입_문턱 - 문간높이), false)
	# ★아랫벽의 **윗면(−2050)이 곧 문턱 바닥**이다. 플레이어는 여기 서서 시작한다.
	_지형(지, T_벽돌, "벽_왼아래_BRICK_01",
		_사각(왼끝, 진입_문턱, 왼벽_안, 바닥y + 구조두께), false)

	# ★★진입 구멍의 **바깥 끝을 막는다.**
	#   벽이 원화 안(0…300)으로 들어오면서 구멍이 벽을 완전히 관통하게 됐다.
	#   그대로 두면 문턱에서 왼쪽으로 걸어갈 때 x 0 을 넘어 **방 밖 허공으로 떨어진다.**
	#   → 바깥쪽 100 을 벽돌로 막는다. 게임상으로는 "플레이어가 기어 나온 쥐구멍의 안쪽 끝",
	#     연출상으로는 통로의 검은 속이 여기서 끝나 **구멍처럼 읽힌다**(도형님 "통로를 더 자연스럽게").
	_지형(지, T_벽돌, "벽_왼구멍마개_BRICK_01",
		_사각(왼끝, 진입_문턱 - 문간높이, 왼끝 + 100.0, 진입_문턱), false)

	# ── 오른쪽 외벽 (5891.5…6191.5) ──
	# ★[2026-09-01] 1-4 를 지으면 바닥 바로 위 **문간 높이(170)만큼을 비워 둔다.**
	#   그 자리는 `SS_BRICK_BREAK_WALL_01`(부서지는 지형)이 막고, 3 발에 뚫리면
	#   그 뒤의 `출구통로` 가 드러나 STAGE 2 로 이어진다.
	#   왼쪽 진입 구멍(문턱 −2050 · 높이 170)과 **완전히 같은 문법**이다 — 대칭이다.
	var 오른벽_아래 := 파괴벽_윗면 if _구간들.has("1_4") else (바닥y + 구조두께)
	_지형(지, T_벽돌, "벽_오른_BRICK_01",
		_사각(오른벽_안, 천장y, 오른끝, 오른벽_아래), false)


# ============================================================================
# 구간 1-1 — Zigzag Entry
# ============================================================================
## ★모든 지형은 `칠하기_허용 = false`(구조물)다.
##   [2026-08-30 색 규칙] "안 칠한 것은 무색이 아니라 검정" 이라, 칠할 수 있는 지형을
##   두면 흰색 플레이어가 안 칠한 자리에서 즉사한다. STAGE 1 은 색 퍼즐을 하지 않으므로
##   전부 **색 규칙 밖**으로 둔다. (칠할 수 있는 지형은 1-4 의 파괴 가능 바닥 하나뿐이 된다)
func _구간_1_1(지: Node2D) -> void:
	# ── ①왼쪽: 벽에서 뻗어 나온 벽돌 코벨 계단 (BRICK = 구조) ───────────────
	# ★[2026-08-30] 낱개로 떠 있던 선반 4 장을 **한 덩어리**로 합쳤다.
	#   왼쪽 끝이 왼벽(0…300)의 안쪽 면에 물려 있어 더는 공중에 뜨지 않는다.
	# ⚠ 이름을 "벽선반_" 으로 시작하면 레벨검사가 `구조물_접두 ["벽"]` 으로 보고
	#   도달 검사에서 **빼 버린다.** 밟으라고 만든 발판이므로 SS_ 로 시작해야 한다.
	# ★칠하기_허용 = **true**. 밟는 발판은 전부 색 규칙에 참여한다.
	_지형(지, T_벽돌, "SS_BRICK_STAIR_WALL_01",
		_계단선반(왼계단A, 발판두께), true)
	# ★Gap 1(180) 건너편. 벽에서 떨어져 있지만 **바로 왼쪽 계단의 연장선**으로 읽힌다.
	_지형(지, T_벽돌, "SS_BRICK_LEDGE_MID_01",
		_계단선반(왼계단B, 발판두께), true)

	# ── ★옷장 (WOOD) — 1-1 의 목적지이자 **원화와 정확히 일치하는 지형** ───
	# 원화 옷장(x 540…792 · 윗면 py 425)을 배율로 환산한 그대로 쓴다.
	# 바닥까지 뿌리내린 덩어리라 이것이 곧 **1-1 의 바닥이자 1-3 의 천장** =
	# §11 이 요구한 1-1/1-3 경계다. 1-3 을 지을 때 아래쪽에 다리·서랍을 파낸다.
	#
	# ⚠ 책장은 이번에 지형으로 만들지 않는다. 원화 책장 윗면(−1183)은 옷장 윗면(−1522)
	#   보다 **339 아래**라, 왼→오른쪽으로 가면서 밟으려면 상승 339 를 올라야 한다.
	#   점프 높이는 167 이고 두 가구 사이 x 간격은 116 뿐이라 계단을 놓을 자리가 없다.
	#   → 책장은 **1-3(아래층)이 타고 내려오는 길**로 남긴다. 지금은 배경으로만 보인다.
	#   (이 높이 충돌은 배율 2.90 에서 원화 가구를 그대로 밟으려 할 때 생기는 구조적 문제다.
	#    자세한 수치와 선택지는 docs 가이드라인 참고 — 도형님 결정 필요)
	# ★★[2026-08-30 STEP 1-1.6 §9] 옷장을 **바닥까지 뿌리내린 덩어리 → 윗면 슬래브**로 바꿨다.
	#   예전에는 −1522 에서 바닥까지 통짜 나무였고, 그러면 **원화의 옷장을 통째로 덮는다.**
	#   도형님 §9: "Terrain 은 Background 를 덮기 위한 그래픽이 아니다.
	#              Gameplay Collision 이 필요한 위치에만 최소한으로 배치한다."
	#   → 1-1 이 실제로 쓰는 것은 **옷장 윗면 하나**뿐이다. 두께 200 짜리 판만 남기고
	#     몸통은 원화가 그리게 둔다(원화 옷장은 py 425…945 로 그 아래에 그대로 있다).
	#     terrain 이 덮는 원화 구간은 py 425…494 = **옷장의 갓(코니스)** 정도다.
	#   ⚠ 그래서 옷장 밑은 이제 뚫려 있다. 1-1 에서는 낙차 1522(즉사 520 초과)라 아무도
	#     못 내려가고, 1-3 은 원래 "가구 밑을 기어간다" 는 설계라 이쪽이 오히려 맞다.
	_지형(지, T_나무, "SS_WOOD_WARDROBE_01",
		_사각(옷장_왼, Y_옷장, 옷장_오른, Y_옷장 + 200.0), true)

	# ── ③오른쪽: 가시 받침 + 출구 단 (BRICK = 건축 구조 · 가시 기반) ────────
	# ★[2026-08-31] 옷장에 붙어 있던 한 덩어리를 **틈 3 개로 끊었다.**
	#   옷장 −(서랍)→ 받침 −150→ 출구. 받침·출구는 벽에 안 붙지만, 사이에
	#   **서랍이라는 실제 가구**가 끼어 "옷장에서 뻗어 나온 선반들" 로 읽힌다.
	# ★BRICK 인 이유: 가시가 박히는 **건축 구조물**이고 벽에서 이어지는 코벨이다.
	#   플레이어가 밟는 나무 가구(옷장·서랍)와 재질로 구분된다(도형님 §10).
	_지형(지, T_벽돌, "SS_BRICK_SPIKE_BASE_01",
		_사각(받침_왼, Y_가시받침, 받침_오른, Y_가시받침 + 발판두께), true)
	_지형(지, T_벽돌, "SS_BRICK_LEDGE_EXIT_01",
		_사각(출구_왼, Y_출구, 출구_오른, Y_출구 + 발판두께), true)
	# 이름이 "천장" 으로 시작 = 레벨검사가 구조물로 본다(들보 윗면은 밟는 곳이 아니다).
	# ★들보는 **구조물**이라 칠하기_허용 = false. 못 칠하는 것을 죽이면 흰색으로는
	#   방을 지나갈 수가 없다(`색규칙.gd` 가 그은 선).
	_지형(지, T_벽돌, "천장들보_경계_1_1_1_2_BRICK_01",
		_사각(들보_왼, 천장y, 들보_오른, 들보_아랫면), false)


# ============================================================================
# 지형 만들기 — Template 을 인스턴스해서 **점 배열과 콜리전만** 갈아 끼운다
# ============================================================================
## 재질 · texture_scale · 코너 · collision_size 는 Template 이 갖고 있다. 손대지 않는다.
##
## ▣ ★`칠가능` = 인스펙터의 **"칠하기 허용" 체크박스**와 같은 값이다 (도형님 요청)
##   `지형.gd` 에 이미 `@export var 칠하기_허용: bool` 이 있어서, 씬을 에디터에서 열고
##   지형 노드를 고르면 **인스펙터 > 색칠 > 칠하기 허용** 체크박스가 그대로 뜬다.
##   빌더는 그 초기값만 정하고, 그 뒤에는 작업자가 체크박스로 바꾸면 된다.
##   ⚠ 단, `build_*.gd` 를 다시 돌리면 초기값으로 되돌아간다(AGENTS.md §4).
##
##   · true  → 총알이 맞고 물감이 묻는다 · **탄약이 준다** · 색 판정에 참여한다
##   · false → `명중()` 이 "blocked" 를 돌려주고 코어가 탄약을 **환급**한다.
##             벽·천장 같은 구조물용. 색 규칙 밖이라 절대 안 죽인다(`색규칙.gd`).
## ▣ [2026-08-31 STEP 1-4.2] 뒤에 두 개가 붙었다 — 둘 다 **기본값이면 예전과 완전히 같다**
##   `스크립트` : Template 의 `지형.gd` 대신 그 **자식 클래스**를 꽂는다(부서지는지형).
##               ⚠ `set_script()` 은 인스턴스 직후, 점 배열을 넣기 **전에** 해야 한다.
##               (프로브로 확인: shape_material · collision_size 는 그대로 살아남는다.
##                자식 클래스라 exported 이름이 같아서 새 스크립트가 그대로 읽는다)
##   `단방향`   : SS2D 가 구운 CollisionPolygon2D 에 `one_way_collision` 을 켠다.
##               아래에서 위로는 통과, 위에서는 착지. 선례 = `식물_a.gd:121`.
func _지형(층: Node2D, 템플릿: String, 이름: String, 월드점들: PackedVector2Array,
		칠가능: bool, 유령: bool = false,
		스크립트: Script = null, 단방향: bool = false) -> void:
	var 씬 := load(템플릿) as PackedScene
	var 지형: Node2D = _모양노드(씬.instantiate())   # ★껍데기가 있으면 벗긴다(벽돌 테스)
	if 스크립트 != null:
		_스크립트_갈아끼우기(지형, 스크립트)
	지형.name = 이름

	var 최소 := 월드점들[0]
	var 최대 := 월드점들[0]
	for p in 월드점들:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	var 중심 := (최소 + 최대) * 0.5
	지형.position = 중심

	지형.set("칠하기_허용", 칠가능)
	지형.set("무색일때_통과", 유령)
	# ★[2026-08-30] 칠할 수 있는 지형은 **자리별 판정**도 같이 켠다.
	#   안 켜면 지형 노드 하나가 통째로 한 색이라, 눈앞에 흰 얼룩이 크게 찍혀 있어도
	#   `필요횟수` 를 못 채웠으면 판정은 "무색 = 안전" 이라고 답한다.
	#   화면과 판정이 다른 말을 하는 것 — 색이 곧 규칙인 게임에서 가장 나쁜 거짓말이다.
	#   구조물(칠가능 false)은 애초에 색 규칙 밖이라 켤 이유가 없다.
	지형.set("위치별_판정", 칠가능)

	var 점배열 := SS2D_Point_Array.new()
	var 로컬 := PackedVector2Array()
	for p in 월드점들:
		로컬.append(p - 중심)
	점배열.add_points(로컬)
	점배열.close_shape()               # ★닫혀야 FILL 메시가 생긴다
	지형.set_point_array(점배열)

	var 폴리 := 지형.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	if 폴리 != null:
		var 생성기 := SS2D_CollisionGen.new()
		생성기.collision_size = 지형.collision_size
		생성기.collision_offset = 지형.collision_offset
		var 구운것 := 생성기.generate_filled(점배열.get_tessellated_points())
		if 구운것.size() < 3:
			push_warning("STAGE1(%s): 콜리전 오프셋 실패 → 원본 점을 그대로 쓴다" % 이름)
			구운것 = 점배열.get_tessellated_points()
		폴리.polygon = 구운것
		폴리.one_way_collision = 단방향

	층.add_child(지형)


## ★★[2026-08-31 STEP 1-4.2] `set_script()` 뒤에 SS2D 설정을 **되돌려 놓는다.**
##
## ▣ 왜 필요한가 — 실제로 터진 것을 고친 것이다
##   `set_script()` 은 스크립트 인스턴스를 새로 만든다. 자식 클래스라 exported 이름이
##   같아도 **값은 안 따라온다** — `shape_material` 이 템플릿의 .tres 대신
##   **속이 텅 빈 새 SS2D_Material_Shape** 으로 바뀐다.
##   그러면 `_build_meshes()` 가 그릴 텍스처를 못 찾아 **메시가 0 장** 나오고
##   지형이 화면에서 통째로 사라진다(`진단_지형메시.gd` 의 "메시" 열이 0).
##   `collision_polygon_node_path` 도 같이 날아가 `get_collision_polygon_node()` 가
##   null 을 돌려준다 → **부서지는지형이 콜리전을 못 끈다.**
##   ⚠ 이건 메모리에 적힌 "메시 1 = 삼각분할 실패" 와는 **다른 원인**이다. 0 은 재질이 빈 것.
func _스크립트_갈아끼우기(지형: Node2D, 스크립트: Script) -> void:
	var 보관 := {}
	for k in ["shape_material", "collision_size", "collision_offset",
			"collision_update_mode", "collision_polygon_node_path"]:
		보관[k] = 지형.get(k)
	# ★재질을 먼저 떼어 놓는다. 안 그러면 재질의 `changed` 시그널이 옛 연결로 남아 있어
	#   되돌릴 때 "already connected" 오류가 난다(동작에는 지장 없지만 로그가 더러워진다).
	지형.set("shape_material", null)
	지형.set_script(스크립트)
	for k in 보관:
		지형.set(k, 보관[k])


## Template 루트가 SS2D 가 아닌 경우(벽돌 테스) 껍데기를 벗겨 안쪽 SS2D 를 꺼낸다.
func _모양노드(인스턴스: Node2D) -> Node2D:
	if 인스턴스.has_method("get_point_array"):
		return 인스턴스
	for 자식 in 인스턴스.get_children():
		if 자식 is Node2D and 자식.has_method("get_point_array"):
			var 모양: Node2D = 자식
			인스턴스.remove_child(모양)
			모양.owner = null      # ★껍데기 씬의 owner 를 떼야 add_child 가 경고하지 않는다
			인스턴스.queue_free()
			return 모양
	push_error("STAGE1: Template 안에서 SS2D 지형 노드를 못 찾았다")
	return 인스턴스


## 축 정렬 사각형 (왼, 윗면, 오른, 아랫면) — 시계 방향.
func _사각(x0: float, y0: float, x1: float, y1: float) -> PackedVector2Array:
	return PackedVector2Array([
		Vector2(x0, y0), Vector2(x1, y0), Vector2(x1, y1), Vector2(x0, y1),
	])


## 계단/단차 덩어리. 단 = [[x0, x1, 윗면y], ...] 을 왼쪽부터.
##
## ★★[2026-08-29 함정] **높이가 같은 단이 연달아 오면 점이 중복된다.**
##   경계 x 에서 똑같은 점이 두 번 들어가고, 그 0 길이 변 때문에
##   `Geometry2D.offset_polygon()` 이 빈 배열을 돌려준다
##   ("Convex decomposing failed!" → **밟을 수 없는 지형**). 그림은 멀쩡하게 나온다.
##   → 같은 높이면 하나로 합쳐서 점을 두 개만 찍는다.
func _계단덩어리(단: Array, 바닥: float) -> PackedVector2Array:
	var 합침: Array = []
	for s in 단:
		if not 합침.is_empty() and is_equal_approx(float(합침[-1][2]), float(s[2])) \
				and is_equal_approx(float(합침[-1][1]), float(s[0])):
			합침[-1][1] = s[1]
			continue
		합침.append([s[0], s[1], s[2]])

	var 점 := PackedVector2Array()
	for s in 합침:
		점.append(Vector2(float(s[0]), float(s[2])))
		점.append(Vector2(float(s[1]), float(s[2])))
	점.append(Vector2(float(합침[합침.size() - 1][1]), 바닥))
	점.append(Vector2(float(합침[0][0]), 바닥))
	return 점


## 개구부 뒤에 붙이는 어두운 판. **개구부와 똑같은 크기**다.
func _문간_어둠(루트: Node2D, 이름: String, 영역: Rect2) -> void:
	var r := ColorRect.new()
	r.name = 이름
	r.color = Color(0.012, 0.012, 0.016)   # 지형 아트(black_fill 0.055)보다 더 어둡다
	r.position = 영역.position
	r.size = 영역.size
	r.z_index = -8                          # 배경(−40)보다 앞 · 지형(0)보다 뒤
	r.z_as_relative = false
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	루트.add_child(r)


## 연결통로 하나.
##
## ★★[2026-08-29 v2] `연결통로.gd` 는 기본값으로 `암반_위 340 · 암반_아래 420 · 두께 90`
##   짜리 **단색 검정 사각형(468 × 1110)** 을 지형 위에 직접 그린다. 우리 방처럼 진짜
##   벽돌 벽이 이미 있는 곳에서는 그 판이 벽돌을 덮어 텍스처가 겹쳐 보인다.
##   → 주변 구조는 벽 SS2D 가 맡고, 통로는 **구멍 안쪽만** 그린다(암반 0 · 두께 24).
##   ⚠ 통로는 벽 안쪽 면에 놓는다. 깊이 420 < 벽두께 500 이므로 벽 밖으로 안 뚫고 나간다.
func _통로(층: Node2D, 이름: String, 자리: Vector2, 출구인가: bool, 다음: String) -> void:
	var t: Node2D = 통로_S.new()
	t.name = 이름
	t.position = 자리
	t.set("역할", 통로_S.역할_.출구 if 출구인가 else 통로_S.역할_.입구)
	t.set("높이", 문간높이)
	t.set("깊이", 통로깊이)
	t.set("두께", 통로두께)
	t.set("암반_위", 0.0)
	t.set("암반_아래", 0.0)
	t.set("어둠", 1.0)
	# 거의 검정. 0 으로 두면 `속빛광원` 이 완전히 꺼져 입구 윤곽까지 안 보인다.
	t.set("속빛", Color(0.035, 0.035, 0.042))
	if 출구인가:
		t.set("다음_씬", 다음)
		t.set("다음_진입점", "입구통로")
	층.add_child(t)


## ★★[2026-08-30 버그 수정] 실내배경의 **세로 방 섞임**을 끈다 — 이게 "배경이 안 나온다" 의 진짜 원인이었다
##
## ▣ 무슨 일이 있었나
##   `실내배경.gd` 는 원래 **위·아래로 이어진 두 방**(거실 ⇄ 굴뚝)을 카메라 높이에 따라
##   크로스페이드하라고 만든 노드다. 그래서 `_draw()` 가 이렇게 생겼다:
##
##       _방_그리기(아래_방, 1.0, 그림_아래)          # 원화를 깐다
##       if 섞임 > 0.002:
##           _방_그리기(위_방, 섞임, 그림_위)          # 그 위에 "위 방" 을 알파로 덮는다
##
##   그런데 `그림_위` 를 안 꽂으면 `_방_그리기` 는 **코드 그림**(`_이층방()`)으로 넘어간다.
##   그리고 섞임은 `전환_시작y(기본 0) → 전환_끝y(기본 −900)` 사이에서 0→1 로 간다.
##   우리 방은 y −2755 … 725 라 **화면 대부분에서 섞임 = 1.0** 이다.
##   → 즉 **코드로 그린 벽지(세로 줄무늬 · 액자 · 허리 몰딩)가 원화를 100% 덮고 있었다.**
##     밝기를 3.0 까지 올려도 원화가 한 조각도 안 보였던 이유가 이것이다.
##
##   ⚠ v3·v4 도 같은 상태였다. 그때는 방이 낮아(층고 1062) 섞임이 0.5 안팎이라
##     "원화가 회색으로 뜬다" 로 보였고, 밝기를 1.45→1.05 로 낮추는 식으로 덮어 왔다.
##     증상만 만졌지 원인은 여기였다.
##
## ▣ 어떻게 끄나
##   `섞임_계산()` 이 `is_equal_approx(전환_시작y, 전환_끝y)` 이면 0.0 을 돌려준다.
##   → 두 값을 같게 두면 섞임이 영원히 0 = **아래_방(원화)만 그린다.**
##   이 스테이지는 방이 하나라 세로 섞임이 애초에 필요 없다.
func _방섞임_끄기(배경: Node2D) -> void:
	배경.set("전환_시작y", 0.0)
	배경.set("전환_끝y", 0.0)


## 계단 모양 **선반 띠** — 두께가 일정한 계단. `_계단덩어리` 와 달리 바닥까지 안 내려간다.
##
## ▣ 왜 필요한가 (도형님 지시 "떠 있는 것처럼 보이는 Brick 은 벽과 연결")
##   낱개 사각형 발판을 여러 장 늘어놓으면 방 한가운데 벽돌 조각이 떠 있는 그림이 된다.
##   한 덩어리 계단으로 만들고 **왼쪽 끝을 벽(또는 가구) 면에 물리면** 뿌리가 생긴다.
##
## 단 = [[x0, x1, 윗면y], ...] 을 왼쪽부터. 반환은 시계 방향 폴리곤.
##   윗면: 왼→오른쪽으로 계단을 따라간다
##   아랫면: 오른→왼쪽으로 같은 계단을 `두께` 만큼 내려서 되짚는다
##
## ⚠ 자기관통 조건: **|단 사이 높이차| < 두께** 여야 아랫면이 윗면을 안 넘는다.
##   여기서는 상승 110 < 두께 160 이라 안전하다(규칙 7 · 삼각분할 실패 방지).
func _계단선반(단: Array, 두께: float) -> PackedVector2Array:
	var 점 := PackedVector2Array()
	# 윗면 (왼 → 오른쪽)
	for s in 단:
		점.append(Vector2(float(s[0]), float(s[2])))
		점.append(Vector2(float(s[1]), float(s[2])))
	# 아랫면 (오른 → 왼쪽)
	for i in range(단.size() - 1, -1, -1):
		var s: Array = 단[i]
		점.append(Vector2(float(s[1]), float(s[2]) + 두께))
		점.append(Vector2(float(s[0]), float(s[2]) + 두께))
	return 점


# ============================================================================
# 구간 1-1 기믹 — 서랍(움직이는 발판) + 가시(hazard)
# ============================================================================
func _기믹_1_1(기믹층: Node2D, 위험층: Node2D) -> void:
	# ── 서랍 — 옷장에서 옆으로 빠져나오는 나무 발판 ─────────────────────────
	_서랍(기믹층, "서랍_옷장", 서랍_닫힘_왼, Y_옷장, 서랍_폭, 서랍_두께, 서랍_열림거리)

	# ── 가시 — 받침 위에 박힌 hazard ────────────────────────────────────────
	_가시(위험층, "가시_1_1", Vector2(가시_중심x, Y_가시받침), 가시_칸수, 가시_높이)


## 움직이는 서랍 하나.
##
## ▣ 구조 (도형님 §3 "AnimatableBody2D 기반 물리적 이동")
##     서랍 (AnimatableBody2D · 움직이는_서랍.gd · layer 1 / mask 0)
##     ├── 판정 (CollisionShape2D)   ← 실제로 밟히는 것
##     └── 그림 (스마트지형 SS2D WOOD) ← 보이는 것
##
## ▣ ★왜 SS2D 를 그림 전용으로 쓰나
##   §11 "Visual 과 Collision 이 분리되는 경우에도 기존 SmartShape2D 구조를 우선한다."
##   그런데 SS2D 는 제 밑에 **StaticBody2D** 를 만든다 — 그건 움직여도 플레이어를
##   태우지 못한다(`sync_to_physics` 는 AnimatableBody2D 것이다).
##   → SS2D 의 StaticBody2D 를 **지운다.** `지형.gd` 는 콜리전 노드가 없으면
##     `_충돌레이어_갱신()` · `bake_collision()` 이 그냥 빠져나가므로 안전하다
##     (`get_collision_polygon_node()` 가 null 을 돌려준다 — addons/rmsmartshape/shapes/shape.gd:184).
##   → 밟히는 것은 AnimatableBody2D 의 CollisionShape2D 하나뿐. 중복 콜리전이 없다.
##
## ▣ ⚠ 그림 SS2D 는 `칠하기_허용 = false` 다.
##   콜리전 폴리곤이 없어서 `위치_반대색인가()` 가 "닿은 자리" 를 못 재기 때문이다.
##   억지로 켜면 화면과 판정이 어긋난다 — 그건 이 프로젝트에서 가장 나쁜 버그다.
func _서랍(층: Node2D, 이름: String, 닫힘_왼: float, 윗면y: float,
		폭: float, 두께: float, 열림거리: float) -> void:
	var d: AnimatableBody2D = 서랍_S.new()
	d.name = 이름
	# 원점은 서랍 **가운데**. 씬에 저장되는 이 자리가 곧 "닫힘" 위치다.
	d.position = Vector2(닫힘_왼 + 폭 * 0.5, 윗면y + 두께 * 0.5)
	d.collision_layer = 1
	d.collision_mask = 0
	d.set("열림_거리", 열림거리)
	d.set("닫힘_유지", 1.0)
	d.set("여는_시간", 0.5)
	d.set("열림_유지", 1.2)
	d.set("닫는_시간", 0.5)
	# ★"열림 유지" 의 첫 순간에서 시작한다 — 스폰 직후와 `레벨검사` 의 첫 물리 프레임에
	#   길이 이어져 보여야 하기 때문이다(검사기는 프레임 한 장만 본다).
	d.set("시작_위상", 1.5)
	# ★★[2026-09-01 도형님] "뒤로 가서 겹쳐졌을 때 안 보였으면 좋겠어."
	#   닫힘 위치(1997…2297)는 옷장 슬래브(1566…2297 · y −1522…−1322) **안**에 완전히 들어간다.
	#   두께도 160 < 200 이라 사각형째로 삼켜진다 → z 를 옷장보다 뒤로 보내면
	#   닫혔을 때 옷장이 서랍을 **완전히 가린다.** 서랍이 옷장 뒤에서 미끄러져 나오는
	#   실제 가구의 그림이 된다.
	#   ⚠ 알파 페이드가 아니라 **z 정렬**로 푼 이유: 페이드는 매 프레임 계산이 필요하고
	#     반쯤 나온 서랍이 반투명해져 "유령 발판"처럼 보인다. 가림은 공짜고 물리적으로 맞다.
	#   ⚠ 지형은 전부 z 0 이고 배경은 z −60/−45 다. −1 은 그 사이라 배경을 안 가린다.
	#     열린 자리(2297…2597)에는 가릴 지형이 없어 그대로 다 보인다.
	d.z_index = -1

	var cs := CollisionShape2D.new()
	cs.name = "판정"
	var r := RectangleShape2D.new()
	r.size = Vector2(폭, 두께)
	cs.shape = r
	d.add_child(cs)

	# 그림 — SS2D 나무. 로컬 좌표(원점이 가운데)로 사각형을 찍는다.
	var 그림: Node2D = _모양노드((load(T_나무) as PackedScene).instantiate())
	그림.name = "그림"
	그림.set("칠하기_허용", false)
	var 점배열 := SS2D_Point_Array.new()
	점배열.add_points(PackedVector2Array([
		Vector2(-폭 * 0.5, -두께 * 0.5), Vector2(폭 * 0.5, -두께 * 0.5),
		Vector2(폭 * 0.5, 두께 * 0.5), Vector2(-폭 * 0.5, 두께 * 0.5),
	]))
	점배열.close_shape()
	그림.set_point_array(점배열)
	# ⚠ 여기서 StaticBody2D 를 지워도 소용없다 — 이 SS2D 는 **인스턴스된 씬**이라
	#   `pack()` 뒤 다시 로드하면 자식이 되살아난다(실제로 그렇게 됐다:
	#   레벨검사가 "StaticBody2D x 2304~2592" 라는 선반을 잡아냈다).
	#   → **런타임에 지운다.** `움직이는_서랍.gd::_ready()` 가 처리한다.
	d.add_child(그림)
	층.add_child(d)


## 가시 하나. **판정만** 한다 — 밟는 면은 `SS_BRICK_SPIKE_BASE_01` 이 따로 담당한다.
##
## ▣ 도형님 §6·§7 대로 지형 콜리전과 데미지 판정을 끝까지 분리한다.
##   가시 자체가 밟히면 그건 함정이 아니라 발판이다.
## ▣ `가시.gd` 가 `_ready()` 에서 `add_to_group("hazard")` · `layer 0 / mask 1` 을 잡고
##   CollisionPolygon2D 를 칸수만큼 만든다. 여기서는 **자리와 칸수만** 정한다.
##   죽이는 것은 `월드.gd::_사망_판정()` 의 hazard 루프다(2026-08-30 에 추가한 4 줄).
## ▣ 원점 = 가시가 박힌 **면의 중앙**. 방향 0(위)이면 높이의 절반씩 위아래로 뻗는다
##   → 받침 윗면에 원점을 두면 절반은 받침에 박히고 절반만 튀어나온다.
func _가시(층: Node2D, 이름: String, 자리: Vector2, 칸수: int, 높이: float) -> void:
	var s: Area2D = (load(T_가시) as PackedScene).instantiate()
	s.name = 이름
	s.position = 자리
	s.set("방향", 0)        # 위를 향한다
	s.set("칸수", 칸수)
	s.set("가시높이", 높이)
	층.add_child(s)


