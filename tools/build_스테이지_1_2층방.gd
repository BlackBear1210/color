func _카메라공간들(오: Node2D) -> void:
	# 창가에서 살짝 조인다 — "여기서 뭔가 일어난다" 는 신호.
	_카메라공간(오, "카메라_창가", Vector2(2040.0, -180.0), Vector2(420.0, 900.0), 1.18)
	# 문 앞에서 더 조여 다음 씬(좁은 복도)과 화면 폭을 이어 준다.
	_카메라공간(오, "카메라_문앞", Vector2(4620.0, -410.0), Vector2(520.0, 800.0), 1.28)


