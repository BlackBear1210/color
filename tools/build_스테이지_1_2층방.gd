# 본체
# ============================================================================
func _짓기() -> Node2D:
	var 시작 := Vector2(150.0, 바닥y)

	var 루트: Node2D = 월드_S.new()
	루트.name = "스테이지_1_2층방"
	루트.set("스테이지_이름", "1 · 2층 방")
	루트.set("카메라_리밋", 리밋)
	## ★v4 는 방이 v3 의 1/2.5 라 줌을 다시 올린다. 1.05 로 두면 방보다 화면이 커진다.
	루트.set("카메라_줌", 1.55)
	루트.set("시작_위치", 시작)
	루트.set("낙사_y", 700.0)
	## 가장 큰 낙차는 진입렛지(−660) → 침대(−178) = 482. 여유를 두고 700.
	루트.set("치명_낙하거리", 700.0)

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)
	루트.add_child(코어)

	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	어둠.color = (챕터_S.팔레트(1) as Dictionary)["어둠"]
	루트.add_child(어둠)

	var 지 := Node2D.new()
	지.name = "지형"
	루트.add_child(지)

	var 오 := Node2D.new()
	오.name = "오브젝트"
	루트.add_child(오)

	_배경_짓기(루트)
	_지형_짓기(지)
	_창문과_경계(오)
	_카메라공간들(오)
	_통로(오, "입구통로", Vector2(왼끝, 바닥y), false, "")
	_통로(오, "출구통로", Vector2(오른끝, Y_문턱), true, 다음씬)

	var p := (load(PLAYER) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 시작
	for k in 튜닝:
		p.set(k, 튜닝[k])
	루트.add_child(p)
	return 루트


# ============================================================================
# 배경 — ★원화 한 장을 두 조각으로 잘라 각각 제 배율로 깐다
# ============================================================================
## ▣ 레이어
##   z −45  배경_먼    안개층                Parallax2D scroll 0.35
##   z −40  배경_방벽  실내배경 ×2 (구역별)  Parallax2D scroll 0.98
##   z −30  창문 바깥빛 / z −28 창틀·창살 / z −8 문간 뒤 어둠
##   z   0  지형
##   z +12  전경_어둠 / z +40 앞바닥
##
## ▣ ★이어 붙이는 것이 아니다
##   두 조각은 **원화의 서로 다른 부분**(0…800 / 800…2135)이고,
##   사이에는 두께 500 벽이 서 있다. 같은 그림이 두 번 나오지 않고, 반전도 없다.
func _배경_짓기(루트: Node2D) -> void:
	var 먼 := Parallax2D.new()
	먼.name = "배경_먼"
	먼.z_index = -45
	먼.z_as_relative = false
	먼.scroll_scale = Vector2(0.35, 1.0)
	루트.add_child(먼)
	var 안개: Node2D = 안개층_S.new()
	안개.name = "실내먼지"
	안개.position = Vector2((왼끝 + 오른끝) * 0.5, 천장y * 0.5)
	안개.set("영역", Vector2(오른끝 - 왼끝 + 1200.0, -천장y + 600.0))
	안개.set("덩어리수", 10)
	안개.set("덩어리_반경", 300.0)
	안개.set("흐름속도", 6.0)
	안개.set("안개색", Color(0.72, 0.74, 0.78, 0.050))
	먼.add_child(안개)

	var 벽층 := Parallax2D.new()
	벽층.name = "배경_방벽"
	벽층.z_index = -40
	벽층.z_as_relative = false
	벽층.scroll_scale = Vector2(벽_시차, 1.0)
	루트.add_child(벽층)

	var 원화: Texture2D = load(원화_방)
	# ★구역마다 한 장씩. `그림_원본영역` 이 원화의 그 부분만 떠 온다.
	_구역배경(벽층, "벽지_1_1_책장", 원화, Z1_왼, Z1_오른, 0.0, 원화_경계px)
	_구역배경(벽층, "벽지_1_2_침대창", 원화, Z2_왼, Z2_오른, 원화_경계px, 원화_원본.x)

	# ── ★앞바닥 — 2.5D 한 겹. 구역마다 따로 (벽 뒤로 이어지면 안 된다) ────
	var 앞바닥층 := Node2D.new()
	앞바닥층.name = "앞바닥"
	루트.add_child(앞바닥층)
	_앞바닥띠(앞바닥층, "앞바닥_1_1", 원화, Z1_왼, Z1_오른, 0.0, 원화_경계px)
	_앞바닥띠(앞바닥층, "앞바닥_1_2", 원화, Z2_왼, Z2_오른, 원화_경계px, 원화_원본.x)

	# ── 문간 뒤의 어둠 (스테이지 입구·출구만. 가운데 문간은 실제로 지나간다) ──
	_문간_어둠(루트, "문간어둠_입구",
		Rect2(왼끝 - 벽두께, 바닥y - 문간높이, 벽두께, 문간높이))
	_문간_어둠(루트, "문간어둠_출구",
		Rect2(오른끝, Y_문턱 - 문간높이, 벽두께, 문간높이))

	_창문_개구부(루트, "창문_방", 창)

	var 전경 := Parallax2D.new()
	전경.name = "전경_어둠"
	전경.z_index = 12
	전경.z_as_relative = false
	전경.scroll_scale = Vector2(1.10, 1.0)
	루트.add_child(전경)
	var 어둠안개: Node2D = 안개층_S.new()
	어둠안개.name = "출구쪽_어둠"
	어둠안개.position = Vector2(Z2_오른 - 300.0, -350.0)
	어둠안개.set("영역", Vector2(900.0, 900.0))
	어둠안개.set("덩어리수", 6)
	어둠안개.set("덩어리_반경", 220.0)
	어둠안개.set("흐름속도", -4.0)
	어둠안개.set("안개색", Color(0.02, 0.02, 0.03, 0.16))
	전경.add_child(어둠안개)


## 구역 배경 한 장. `원화px0 … 원화px1` 만 떠서 `월드x0 … 월드x1` 에 깐다.
## 세로는 원화 전체(0…1200)를 쓰고, py 950 이 바닥y 에 오도록 앉힌다.
func _구역배경(층: Node2D, 이름: String, 원화: Texture2D,
		월드x0: float, 월드x1: float, 원화px0: float, 원화px1: float) -> void:
	var b: Node2D = 실내배경_S.new()
	b.name = 이름
	b.set("영역", Rect2(월드x0, (0.0 - 원화_바닥py) * 배율,
		월드x1 - 월드x0, 원화_원본.y * 배율))
	b.set("아래_방", 실내배경_S.방_.이층방)
	b.set("위_방", 실내배경_S.방_.이층방)
	b.set("그림_아래", 원화)
	b.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	b.set("그림_원본영역", Rect2(원화px0, 0.0, 원화px1 - 원화px0, 원화_원본.y))
	b.set("그림_밝기", 원화_밝기)
	층.add_child(b)


## 앞바닥 띠 한 장 (원화 아래쪽 바닥 앞부분만 떠서 플레이어 앞에 깐다).
func _앞바닥띠(층: Node2D, 이름: String, 원화: Texture2D,
		월드x0: float, 월드x1: float, 원화px0: float, 원화px1: float) -> void:
	var a: Node2D = 실내배경_S.new()
	a.name = 이름
	a.set("영역", Rect2(월드x0, (띠_시작py - 원화_바닥py) * 배율,
		월드x1 - 월드x0, (띠_끝py - 띠_시작py) * 배율))
	a.set("그림_아래", 원화)
	a.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	a.set("그림_원본영역", Rect2(원화px0, 띠_시작py, 원화px1 - 원화px0, 띠_끝py - 띠_시작py))
	a.set("그림_밝기", 원화_밝기)
	a.set("앞에_그리기", true)
	층.add_child(a)


# ============================================================================
# 지형
# ============================================================================
func _지형_짓기(지: Node2D) -> void:
	# ── 뼈대 ────────────────────────────────────────────────────────────────
	# ★바닥은 끊김 없는 하나의 평지다. 어디서 떨어져도 여기 닿고, 계단 옆면(110)으로
	#   다시 오른다. 이 스테이지가 "죽지 않는다" 를 지키는 방식이다.
	_지형(지, T_벽돌, "바닥_STAGE1_BRICK_01",
		_사각(왼끝, 바닥y, 오른끝, 바닥y + 구조두께), true)
	# 천장 — 이름이 "천장" 으로 시작해야 레벨검사가 구조물로 보고 도달불가에서 뺀다.
	_지형(지, T_벽돌, "천장_STAGE1_BRICK_01",
		_사각(왼끝, 천장y - 구조두께, 오른끝, 천장y), false)

	# ── 스테이지 입구 (왼쪽 벽 · 바닥 높이에 개구부) ────────────────────────
	_지형(지, T_벽돌, "벽_왼위_BRICK_01",
		_사각(왼끝 - 벽두께, 천장y, 왼끝, 바닥y - 문간높이), false)
	_지형(지, T_벽돌, "벽_왼아래_BRICK_01",
		_사각(왼끝 - 벽두께, 바닥y, 왼끝, 바닥y + 구조두께), false)

	# ── ★가운데 벽 = 1-1 과 1-2 를 끊는 것 ─────────────────────────────────
	#   기획서 §10 "1-2 의 전체 공간이 1-1 에서 미리 전부 보여서는 안 된다" 를
	#   두께 500 벽 하나로 만든다. 개구부는 문턱(−220) 바로 위 170 뿐이라
	#   1-1 에서는 1-2 의 바닥 근처만 아주 조금 보인다.
	#   ★아래쪽 벽의 **윗면(−220)이 곧 통로 바닥**이다 →
	#     블록B(−220) → 벽 위(−220) → 침대(−220) 가 한 줄로 이어진다.
	_지형(지, T_벽돌, "벽_가운데위_BRICK_01",
		_사각(가운데벽_왼, 천장y, 가운데벽_오른, Y_문턱 - 문간높이), false)
	_지형(지, T_벽돌, "벽_가운데아래_BRICK_01",
		_사각(가운데벽_왼, Y_문턱, 가운데벽_오른, 바닥y + 구조두께), false)

	# ── 스테이지 출구 (오른쪽 벽 · 문턱 높이에 개구부) ─────────────────────
	_지형(지, T_벽돌, "벽_오른위_BRICK_01",
		_사각(오른끝, 천장y, 오른끝 + 벽두께, Y_문턱 - 문간높이), false)
	_지형(지, T_벽돌, "벽_오른아래_BRICK_01",
		_사각(오른끝, Y_문턱, 오른끝 + 벽두께, 바닥y + 구조두께), false)

	# ══════════════════════════════════════════════════════════════════════
	# 구역 1-1 — 서랍장 → 책장 (원화의 낮은 가구 → 높은 가구 순서 그대로)
	# ══════════════════════════════════════════════════════════════════════
	# ★두 덩어리 사이의 틈 120 이 이 게임의 **첫 점프**다.
	#   못 건너도 바닥에 떨어질 뿐이고, 블록A 옆면(110)으로 걸어 올라와 다시 한다.
	_지형(지, T_나무, "SS_WOOD_DRAWER_01",
		_계단덩어리([[Z1_A_왼, Z1_A_오른, -상승]], 바닥y + 가구밑), true)
	_지형(지, T_나무, "SS_WOOD_SHELF_01",
		_계단덩어리([[Z1_B_왼, Z1_B_오른, Y_문턱]], 바닥y + 가구밑), true)

	# ══════════════════════════════════════════════════════════════════════
	# 구역 1-2 — 침대 → 궤짝 → 출구
	# ══════════════════════════════════════════════════════════════════════
	# 문간에서 나오면 곧바로 침대 위(−220)다. 거기서 한 칸 내려서고 바닥으로 내려온다.
	# ★내려가는 계단으로 시작하는 이유: 문을 나서자마자 **방 전체가 아래로 펼쳐져** 보인다.
	_지형(지, T_나무, "SS_WOOD_BED_01", _계단덩어리([
		[Z2_침대_왼, Z2_침대_가운데, Y_문턱],
		[Z2_침대_가운데, Z2_침대_오른, -상승],
	], 바닥y + 가구밑), true)

	# 틈 150 을 건너 궤짝으로. 두 번째 점프이자 마지막 관문이다.
	# 궤짝 두 번째 단(−220)이 오른쪽 벽 문간과 같은 높이 = EXIT.
	_지형(지, T_나무, "SS_WOOD_CRATE_01", _계단덩어리([
		[Z2_궤짝_왼, Z2_궤짝_가운데, -상승],
		[Z2_궤짝_가운데, Z2_궤짝_오른, Y_문턱],
	], 바닥y + 가구밑), true)


func _창문과_경계(오: Node2D) -> void:
	var 창중심 := 창.position + 창.size * 0.5
	# 창에서 비스듬히 내려오는 한 줄기. 끝이 바닥 근처에 닿는 길이로 잡는다.
	_연출빛(오, "창빛_기둥", Vector2(창중심.x, 창.position.y + 창.size.y * 0.6),
		100.0, -창.position.y + 300.0, 창.size.x * 0.55, 창.size.x * 1.3, 0.78)
	# 창틀 안쪽의 실제 광원. 알갱이_보이기 = false 라 구슬로 안 보인다.
	_등불(오, "빛_창문안쪽", 창중심, 창.size.x * 2.4, 0.85, 0.04)
	# 바닥에 닿는 빛 웅덩이. 반경을 키우면 바닥(두께 300) 아래로 새어 마루 밑이 밝아진다.
	_등불(오, "빛_바닥웅덩이", Vector2(창중심.x - 240.0, -100.0), 300.0, 0.30, 0.03)
	# ★출구 쪽에는 광원을 두지 않는다 — 어두워지는 것으로 끝을 알린다.


# ============================================================================
# 카메라 — ★구역이 곧 카메라 방이다
# ============================================================================
func _카메라공간들(오: Node2D) -> void:
	# 1-1 : 좁고 높다 → 세로로 긴 화면. 등반 구간 전체를 담당한다.
	_카메라공간(오, "카메라_1_1_등반",
		Vector2((Z1_왼 + Z1_오른) * 0.5, 천장y * 0.5),
		Vector2(Z1_오른 - Z1_왼, -천장y), 1.15)
	# 1-2 : 넓다 → 화면을 연다. 방이 바뀌었다는 것이 줌으로 읽힌다.
	_카메라공간(오, "카메라_1_2_침대창",
		Vector2((Z2_왼 + Z2_오른) * 0.5, 천장y * 0.5),
		Vector2(Z2_오른 - Z2_왼, -천장y), 0.95)
	# 출구 앞에서 조여 다음 씬(좁은 복도)과 화면 폭을 이어 준다.
	_카메라공간(오, "카메라_문앞",
		Vector2(Z2_궤짝_오른 - 200.0, Y_문턱 - 150.0),
		Vector2(500.0, 700.0), 1.35)
func _창문_개구부(루트: Node2D, 이름: String, 창: Rect2) -> void:
	# ① 바깥에서 들어오는 빛 (유리 너머). 이 방에서 **가장 밝은 면**이다.
	var 빛면 := ColorRect.new()
	빛면.name = 이름 + "_바깥빛"
	빛면.color = Color(0.68, 0.69, 0.72)
	빛면.position = 창.position
	빛면.size = 창.size
	빛면.z_index = -30                    # 벽지(−40) 앞 · 지형(0) 뒤
	빛면.z_as_relative = false
	빛면.mouse_filter = Control.MOUSE_FILTER_IGNORE
	루트.add_child(빛면)

	# ② 창틀 + 십자 창살. 실루엣이 있어야 "유리창" 으로 읽힌다.
	#    흑백 게임이라 밝은 면 위의 **검은 선 몇 줄**만으로 창이 성립한다.
	var 틀 := 22.0
	var 살 := 14.0
	var 조각: Array = [
		["윗틀", Rect2(창.position.x, 창.position.y, 창.size.x, 틀)],
		["아랫틀", Rect2(창.position.x, 창.end.y - 틀, 창.size.x, 틀)],
		["왼틀", Rect2(창.position.x, 창.position.y, 틀, 창.size.y)],
		["오른틀", Rect2(창.end.x - 틀, 창.position.y, 틀, 창.size.y)],
		["세로살", Rect2(창.position.x + 창.size.x * 0.5 - 살 * 0.5, 창.position.y,
			살, 창.size.y)],
		["가로살", Rect2(창.position.x, 창.position.y + 창.size.y * 0.5 - 살 * 0.5,
			창.size.x, 살)],
	]
	for c in 조각:
		var r := ColorRect.new()
		r.name = "%s_%s" % [이름, c[0]]
		r.color = Color(0.045, 0.045, 0.055)
		r.position = (c[1] as Rect2).position
		r.size = (c[1] as Rect2).size
		r.z_index = -28                   # 바깥빛(−30) 바로 앞
		r.z_as_relative = false
		r.mouse_filter = Control.MOUSE_FILTER_IGNORE
		루트.add_child(r)


## 개구부 뒤에 붙이는 어두운 판. **개구부와 똑같은 크기**다.
func _문간_어둠(루트: Node2D, 이름: String, 영역: Rect2) -> void:
	var r := ColorRect.new()
	r.name = 이름
	r.color = Color(0.012, 0.012, 0.016)   # 지형 아트(black_fill 0.055)보다 더 어둡다
	r.position = 영역.position
	r.size = 영역.size
	r.z_index = -8                          # 배경(−40)보다 앞 · 지형(0)보다 뒤
	r.z_as_relative = false
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	루트.add_child(r)


