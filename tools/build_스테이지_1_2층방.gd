# ============================================================================
## Template 을 인스턴스해서 **점 배열과 콜리전 폴리곤만** 갈아 끼운다.
## 재질 · texture_scale · 코너 · collision_size 는 Template 이 갖고 있다.
##
## ★★[2026-08-29] 확정 12 종의 **루트 구조가 두 가지**다. 여기서 그걸 흡수한다.
##   ① 루트가 곧 SS2D 지형이다 — TEMPLATE_* 10 종 · `벽돌 계단` 2 종
##   ② 루트는 빈 Node2D 이고 **자식 `SS2D_Shape_Closed`** 가 지형이다 — `벽돌 테스` 2 종
##   ②를 그대로 `층` 에 붙이면 지형이 한 겹 더 깊어져서
##     · `레벨검사._주인이름()` 은 부모를 거슬러 올라가니 통과하지만
##     · `진단_*` · 스크린샷 · 나중 빌더가 전부 두 경우를 따로 다뤄야 한다.
##   → **껍데기를 벗기고 SS2D 노드만 꺼내 쓴다.** 그러면 저장된 씬의 지형 구조가
##     기존(지형/이름/StaticBody2D/CollisionPolygon2D)과 완전히 같아진다.
##   ⚠ 껍데기를 벗기면 인스턴스 링크가 끊긴다. 어차피 점·콜리전을 통째로 갈아 끼우므로
##     링크가 있어도 남는 것은 재질뿐이고, 그 재질은 ext_resource 로 그대로 따라온다.
func _모양노드(인스턴스: Node2D) -> Node2D:
	if 인스턴스.has_method("get_point_array"):
		return 인스턴스
	for 자식 in 인스턴스.get_children():
		if 자식 is Node2D and 자식.has_method("get_point_array"):
			var 모양: Node2D = 자식
			인스턴스.remove_child(모양)
			모양.owner = null      # ★껍데기 씬의 owner 를 떼야 add_child 가 경고하지 않는다
			인스턴스.queue_free()
			return 모양
	push_error("STAGE1: Template 안에서 SS2D 지형 노드를 못 찾았다")
	return 인스턴스


# ============================================================================
## Template 을 인스턴스해서 **점 배열과 콜리전 폴리곤만** 갈아 끼운다.
## 재질 · texture_scale · 코너 · collision_size 는 Template 이 갖고 있다.
func _지형(층: Node2D, 템플릿: String, 이름: String, 월드점들: PackedVector2Array,
		칠가능: bool, 유령: bool = false) -> void:
	var 씬 := load(템플릿) as PackedScene
	var 지형: Node2D = _모양노드(씬.instantiate())   # ★껍데기가 있으면 벗긴다(벽돌 테스)
	지형.name = 이름

	var 최소 := 월드점들[0]
	var 최대 := 월드점들[0]
	for p in 월드점들:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	var 중심 := (최소 + 최대) * 0.5
	지형.position = 중심

	지형.set("칠하기_허용", 칠가능)
	지형.set("무색일때_통과", 유령)

	var 점배열 := SS2D_Point_Array.new()
	var 로컬 := PackedVector2Array()
	for p in 월드점들:
		로컬.append(p - 중심)
	점배열.add_points(로컬)
	점배열.close_shape()               # ★닫혀야 FILL 메시가 생긴다
	지형.set_point_array(점배열)

	var 폴리 := 지형.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	if 폴리 != null:
		var 생성기 := SS2D_CollisionGen.new()
		생성기.collision_size = 지형.collision_size
		생성기.collision_offset = 지형.collision_offset
		var 구운것 := 생성기.generate_filled(점배열.get_tessellated_points())
		if 구운것.size() < 3:
			push_warning("STAGE1(%s): 콜리전 오프셋 실패 → 원본 점을 그대로 쓴다" % 이름)
			구운것 = 점배열.get_tessellated_points()
		폴리.polygon = 구운것

	층.add_child(지형)


## 축 정렬 사각형 (왼, 윗면, 오른, 아랫면) — 시계 방향.
func _사각(x0: float, y0: float, x1: float, y1: float) -> PackedVector2Array:
	return PackedVector2Array([
		Vector2(x0, y0), Vector2(x1, y0), Vector2(x1, y1), Vector2(x0, y1),
	])


## 계단/단차 덩어리. 단 = [[x0, x1, 윗면y], ...] 을 왼쪽부터.
##
## ★★[2026-08-29 함정] **높이가 같은 단이 연달아 오면 점이 중복된다.**
##   경계 x 에서 똑같은 점이 두 번 들어가고, 그 0 길이 변 때문에
##   `Geometry2D.offset_polygon()` 이 빈 배열을 돌려준다
##   ("Convex decomposing failed!" → **밟을 수 없는 지형**). 그림은 멀쩡하게 나온다.
##   → 같은 높이면 하나로 합쳐서 점을 두 개만 찍는다.
func _계단덩어리(단: Array, 바닥: float) -> PackedVector2Array:
	var 합침: Array = []
	for s in 단:
		if not 합침.is_empty() and is_equal_approx(float(합침[-1][2]), float(s[2])) \
				and is_equal_approx(float(합침[-1][1]), float(s[0])):
			합침[-1][1] = s[1]
			continue
		합침.append([s[0], s[1], s[2]])

	var 점 := PackedVector2Array()
	for s in 합침:
		점.append(Vector2(float(s[0]), float(s[2])))
		점.append(Vector2(float(s[1]), float(s[2])))
	점.append(Vector2(float(합침[합침.size() - 1][1]), 바닥))
	점.append(Vector2(float(합침[0][0]), 바닥))
	return 점


## ColorZone 하나.
## ⚠⚠ **`color_zone.tscn` 을 인스턴스하면 안 된다.** `PackedScene.pack()` 은
##   owner 가 패킹 루트인 노드의 값만 저장하므로, 인스턴스 내부 `CollisionPolygon2D` 에
##   꽂은 폴리곤이 통째로 버려지고 Template 기본 사각형만 남는다.
##   → 다른 빌더들과 같은 방식(새 노드에 스크립트 붙이기)을 쓴다. 클래스는 그대로 ColorZone 이다.
func _색구역(층: Node2D, 이름: String, 월드폴리곤: PackedVector2Array, 흰색인가: bool) -> void:
	var z := Area2D.new()
	z.name = 이름
	z.set_script(load(색구역스크립트))
	z.position = Vector2.ZERO        # 원점이어야 아래 좌표가 곧 월드 좌표다
	z.collision_layer = 0
	z.set("zone_color", 1 if 흰색인가 else 0)   # ColorZone.ZoneColor { BLACK=0, WHITE=1 }
	z.set("show_tint", false)         # 켜면 인게임에 흰 사각형이 나와 디버그 상자로 보인다
	var cp := CollisionPolygon2D.new()
	cp.name = "CollisionPolygon2D"    # ★이 이름이어야 ColorZone 이 찾는다
	cp.polygon = 월드폴리곤
	z.add_child(cp)
	층.add_child(z)


func _반딧불이(층: Node2D, 이름: String, 자리들: Array, 반경: float) -> void:
	var 묶음 := Node2D.new()
	묶음.name = 이름
	for i in 자리들.size():
		var f: Node2D = 발광체_S.new()
		f.name = "구슬_%02d" % (i + 1)
		f.position = 자리들[i]
		f.set("종류", 발광체_S.종류_.구슬)
		f.set("빛색", Color(1.0, 0.97, 0.90))   # 흑백 게임이라 채도는 거의 0
		f.set("반경", 반경)
		f.set("밝기", 1.25)
		f.set("깜빡임", 0.30)
		f.set("크기_흔들림", 0.34)
		f.set("흔들림_속도", 0.45 + 0.11 * i)   # 서로 다른 주기 = 무리가 동기화되지 않는다
		f.set("부유", 16.0)
		묶음.add_child(f)
	층.add_child(묶음)


func _연출빛(층: Node2D, 이름: String, 자리: Vector2, 각도: float, 길이: float,
		시작폭: float, 끝폭: float, 세기: float) -> void:
	var l: Node2D = 빛기둥_S.new()
	l.name = 이름
	l.position = 자리
	l.set("모드", 빛기둥_S.모드_.연출)     # 판정은 ColorZone 이 한다
	l.set("각도", 각도)                    # 0°=오른쪽, 90°=아래 (시계 방향)
	l.set("길이", 길이)
	l.set("시작폭", 시작폭)
	l.set("끝폭", 끝폭)
	l.set("세기", 세기)
	# ★`구멍_그리기`(기본 true)는 빛이 나오는 자리에 **둥근 구멍 그림**을 그린다.
	#   우리는 창문 개구부를 직접 그렸으므로 그 위에 또 그리면 "빛 쏘는 구슬" 로 보인다.
	l.set("구멍_그리기", false)
	층.add_child(l)


func _등불(층: Node2D, 이름: String, 자리: Vector2, 반경: float,
		밝기: float, 깜빡임: float) -> void:
	var l: Node2D = 발광체_S.new()
	l.name = 이름
	l.position = 자리
	l.set("종류", 발광체_S.종류_.구슬)
	l.set("빛색", Color(1.0, 0.96, 0.88))
	l.set("반경", 반경)
	l.set("밝기", 밝기)
	l.set("깜빡임", 깜빡임)
	l.set("크기_흔들림", 0.06)          # 등은 거의 안 흔들린다
	l.set("흔들림_속도", 0.25)
	l.set("부유", 0.0)
	l.set("알갱이_보이기", false)        # ★등은 빛만. 알갱이를 그리면 반딧불이와 구분이 안 된다
	층.add_child(l)


func _카메라공간(층: Node2D, 이름: String, 자리: Vector2, 크기: Vector2, 줌: float) -> void:
	var c: Node2D = 카메라공간_S.new()
	c.name = 이름
	c.position = 자리
	c.set("크기", 크기)
	c.set("줌_배수", 줌)
	# ★★[2026-08-29 v2] `틈새빛_사용`(기본 true · 6 줄기)을 **끈다.**
	#   이게 화면에 "둥근 캡이 달린 빛줄기 3~4 개" 를 그린다 — 지시 §7 이 지적한
	#   "빛을 쏘는 구슬" 의 정체가 바로 이것이었다(빛기둥·발광체·창문 프리팹을
	#   차례로 빼 봐도 안 사라져서 마지막에 찾았다).
	#   이 스테이지의 빛은 창문 개구부 하나로 충분하므로 카메라 공간은 줌만 담당한다.
	c.set("틈새빛_사용", false)
	층.add_child(c)


## 연결통로 하나.
##
## ★★[2026-08-29 v2] **여기가 "통로 뒤가 보인다 / 지형이 겹친다" 의 핵심 수정이다.**
##
##   `연결통로.gd` 는 기본값으로 `암반_위 340 · 암반_아래 420 · 두께 90` 짜리
##   **단색 검정 사각형(468 × 1110)** 을 지형 위에 직접 그린다.
##   원래는 "굴을 판 것" 으로 보이게 하려고 넣은 장치인데, 주변에 진짜 벽이 없을 때만
##   그렇게 읽힌다. 우리 방처럼 벽돌 벽·나무 문턱이 이미 있는 곳에서는
##   그 검정 판이 **나무와 벽돌을 덮어 텍스처가 겹쳐 보인다**(지시 문제 B).
##
##   → v2 는 **주변 구조를 벽 SS2D 가 맡고, 통로는 구멍 안쪽만 그린다.**
##     · `암반_위 = 0` · `암반_아래 = 0`  → 지형을 덮는 검정 판이 사라진다
##     · `두께 = 24`                      → 통로 자신의 바닥/천장 슬래브도 최소로
##     · `속빛` 을 **거의 검정**으로       → 저 끝에서 새어나오던 빛무리가 사라진다
##       (그 빛무리가 "통로 너머에 다른 공간이 있다" 로 읽히던 원인이다 · 지시 문제 A)
##     · `어둠 = 1.0`                     → 안쪽 끝이 완전한 검정
##
##   ⚠ 통로는 **벽 안쪽 면**에 놓는다. 깊이 420 < 벽두께 500 이므로
##     터널 전체가 벽 속에 들어가고, 벽 밖으로 뚫고 나가지 않는다.
func _통로(층: Node2D, 이름: String, 자리: Vector2, 출구인가: bool, 다음: String) -> void:
	var t: Node2D = 통로_S.new()
	t.name = 이름
	t.position = 자리
	t.set("역할", 통로_S.역할_.출구 if 출구인가 else 통로_S.역할_.입구)
	t.set("높이", 문간높이)
	t.set("깊이", 통로깊이)
	t.set("두께", 통로두께)
	t.set("암반_위", 0.0)
	t.set("암반_아래", 0.0)
	t.set("어둠", 1.0)
	# 거의 검정. 0 으로 두면 `속빛광원` 이 완전히 꺼져 입구 윤곽까지 안 보인다.
	t.set("속빛", Color(0.035, 0.035, 0.042))
	if 출구인가:
		t.set("다음_씬", 다음)
		t.set("다음_진입점", "입구통로")
	층.add_child(t)

