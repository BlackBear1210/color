	# ★방에 들어서면 화면을 한 번 넓게 연다 — 높은 천장을 보여주는 자리다.
	_카메라공간(오, "카메라_방입구", Vector2(300.0, -700.0), Vector2(1400.0, 2000.0), 0.92)
