## 이번 빌드에서 지을 구간. `--구간 1_1` 로 좁힐 수 있다.
## ★구간을 따로 지을 수 있어야 "1-1 만 세우고 레벨검사" 가 가능하다.
##   (서브씬으로 쪼개면 PackedScene.pack() 이 SS2D 점 배열을 버린다 — 가이드라인 §STEP 8)
var _구간들: Array[String] = ["1_1"]


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	# `-- --구간 1_1` 파싱. 안 주면 위 기본값(현재 1-1 하나)을 그대로 쓴다.
	var args := OS.get_cmdline_user_args()
	for i in args.size():
		if args[i] == "--구간" and i + 1 < args.size():
			_구간들 = [args[i + 1]]

	print("\n=== STAGE 1 · 2층 방 (v5 · 원화 한 장 · 쥐 축척) ===")
	print("   배율 %.2f · 방 %.0f × %.0f · 층고 %.0f (플레이어 키의 %.1f 배)"
		% [배율, 오른끝 - 왼끝, -천장y, -천장y, -천장y / 95.63])
	print("   구간: %s" % ", ".join(_구간들))
	var 루트 := _짓기()
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패: %s" % error_string(e))
		quit(1)
		return
	e = ResourceSaver.save(팩, 내씬)
	print("   %-28s %s" % [내씬.get_file(), error_string(e)])
	print("=== 끝 ===\n")
	quit(0 if e == OK else 1)


