func _짓기() -> Node2D:
	var 시작 := Vector2(-100.0, 바닥y)

	var 루트: Node2D = 월드_S.new()
	루트.name = "스테이지_1_2층방"
	루트.set("스테이지_이름", "1 · 2층 방")
	루트.set("카메라_리밋", 리밋)
	루트.set("카메라_줌", 1.35)          # 집 4방과 같은 값 (화면 1422×800)
	루트.set("시작_위치", 시작)
	루트.set("낙사_y", 1200.0)
	# 가장 높은 선반(−550)에서 바닥(0)까지 550px 이다. 기본 520 이면 마지막 구간에서
	# 한 번 떨어지는 것만으로 죽는다 — 이 스테이지의 약속("죽지 않는다")을 깬다.
	루트.set("치명_낙하거리", 900.0)

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)
	루트.add_child(코어)

	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	어둠.color = (챕터_S.팔레트(1) as Dictionary)["어둠"]
	루트.add_child(어둠)

	var 지 := Node2D.new()
	지.name = "지형"
	루트.add_child(지)

	var 오 := Node2D.new()
	오.name = "오브젝트"
	루트.add_child(오)

	_배경_짓기(루트)
	_지형_짓기(지)
	_창문과_경계(오)
	_카메라공간들(오)
	# ★통로는 벽 **안쪽 면**에 붙인다. 거기서 벽 속으로 파고들어 개구부를 채운다.
	_통로(오, "입구통로", Vector2(왼끝, 바닥y), false, "")
	_통로(오, "출구통로", Vector2(오른끝, Y_문턱), true, 다음씬)

	var p := (load(PLAYER) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 시작
	for k in 튜닝:
		p.set(k, 튜닝[k])
	루트.add_child(p)
	return 루트


