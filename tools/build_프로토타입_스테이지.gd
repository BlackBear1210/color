extends SceneTree
## ============================================================================
## [2026-08-29 신규] PROTOTYPE STAGE — 최신 타일셋 x SmartShape2D 검증용 지형
## ----------------------------------------------------------------------------
## 실행:  godot --headless --path . -s res://tools/build_프로토타입_스테이지.gd
## 검사:  godot --headless --path . -s res://tools/레벨검사.gd -- res://scenes/smartshape_test/PROTOTYPE_STAGE.tscn
##        godot --headless --path . -s res://tools/진단_콜리전대_그림.gd -- res://scenes/smartshape_test/PROTOTYPE_STAGE.tscn
##
## ▣ 왜 만드나
##   "현재 GitHub 최신 타일셋이 실제 SmartShape2D 에서 정상 작동하는지"를
##   **직선 하나가 아니라 실제 플랫포머 지형으로** 검증하기 위한 씬이다.
##   최종 스테이지가 아니다 — 통과하면 그 다음에 world_1 본편 지형을 짓는다.
##
##   ⚠ 실제 stage 씬(scenes/스마트월드/ · scenes/집/)은 **한 줄도 안 건드린다.**
##      이 빌더는 scenes/smartshape_test/ 에만 쓴다.
##
## ▣ 재질 — 2026-08-29 실측으로 "그림 = 콜리전" 이 확인된 것만 쓴다
##     BRICK  지형_벽돌v2_black_detail_얇은_사방.tres   (TEMPLATE_BRICK_*)   0.0px ✔
##     WOOD   지형_나무v2_black_detail_얇은_사방.tres   (TEMPLATE_WOOD_*)    0.0px ✔
##   ★GRASS 는 제외한다. grass_v4 는 아직 구형(방향별 엣지 + taper) 구성이라
##     그림이 콜리전 밖으로 **+44.8px** 나간다(= taper 128x256 x 0.35 의 폭).
##     밟는 면에 쓰면 "보이는 윗면보다 44.8px 아래를 밟는" 지형이 된다.
##     사방 재질로 전환된 뒤에 별도 STEP 에서 넣는다.
##
## ▣ 치수 근거 — 전부 `tools/측정_플레이어_능력.gd` 실측 (집 챕터 세팅 · 점프_거리_칸 15)
##     몸 44 x 95.63   ·   이동 390   ·   중력 2288 / 점프속도 -855.7
##     최대 점프 높이 167.24   ·   체공 0.63s
##     오를 단차 한계 160.28   ·   건널 간격 한계 256.81   ·   최소 통로높이 96.09
##   레벨검사기가 강제하는 게이트는 여기서 여유를 뺀 값이다 — **세로 128 · 가로 204.**
##   → 이 씬의 설계값은 전부 그 아래다:  상승 <= 110  ·  간격 <= 180  ·  단차 <= 110
##
##   ⚠⚠ SS2D 콜리전은 `collision_size(24)` 만큼 바깥으로 부푼다.
##      위·아래 지형이 마주 보면 **눈에 보이는 간격에서 48px 이 깎인다.**
##      천장 간격은 전부 "실효 = 시각 - 48" 로 계산했다.
##
## ▣ 이 씬이 검증하는 12 가지 (지시 §5 의 순서 그대로 배치했다)
##     START -> 평평한 바닥 -> 낮은 단차 -> 계단 -> 점프 -> 높은 플랫폼
##     -> 좁은 플랫폼 -> 내부 코너 -> 외부 코너 -> 다른 Material -> SAFE ZONE -> GOAL
##
## ⚠ AGENTS.md §4 — build_*.gd 는 평소에 돌리지 않는다. 돌리면 에디터 편집분이 날아간다.
## ============================================================================

const 키트 := "res://scenes/집/스마트 매쉬 assets/"
const T_벽돌 := 키트 + "BRICK_벽돌/TEMPLATE_BRICK_SOLID.tscn"
const T_벽돌계단 := 키트 + "BRICK_벽돌/TEMPLATE_BRICK_STAIRS.tscn"
const T_나무 := 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID.tscn"

const 월드_S := preload("res://scripts/스마트월드/월드.gd")
const 코어_S := preload("res://scripts/스마트월드/페인트_코어.gd")
const 챕터_S := preload("res://scripts/스마트월드/챕터.gd")
const 공통 := preload("res://tools/지형공통.gd")

const PLAYER := "res://scenes/player/Player.tscn"
const 목표문씬 := "res://scenes/장애물/목표문.tscn"
const 내씬 := "res://scenes/smartshape_test/PROTOTYPE_STAGE.tscn"

## 점프 튜닝 — 집 챕터와 같은 값. 이게 달라지면 아래 치수가 전부 무의미해진다.
const 튜닝 := {"move_speed": 390.0, "타일_크기": 16.0, "점프_높이_칸": 10.0, "점프_거리_칸": 15.0}

# ── 높이 기준선 ────────────────────────────────────────────────────────────
const 지상 := 0.0            ## START 바닥 윗면
const 단차 := 110.0          ## 한 칸 = 게이트 128 의 86%
const 계단폭 := 180.0        ## README 7절 권장. 코너 조각 90px 의 두 배
const 발판두께 := 200.0      ## README 6절 "최소 140 · 권장 180" 이상
const 바닥두께 := 300.0

# ── 구간 x 경계 (진행은 -x -> +x) ──────────────────────────────────────────
const X_시작 := -1400.0
const X_단차 := -600.0       ## A 평바닥 끝 / B 낮은 단차 시작
const X_계단 := -300.0       ## B 끝 / C 계단 시작
const X_착지 := 420.0        ## C 계단 4 단 끝 / 꼭대기 착지 발판 시작
const X_착지끝 := 700.0
const X_높은발판 := 860.0    ## 점프 간격 160
const X_높은발판끝 := 1380.0
const X_좁은발판 := 1530.0   ## 점프 간격 150
const X_좁은발판끝 := 1890.0 ## ★여기가 WOOD -> BRICK 수평 맞댐 경계
const X_구덩이끝 := 2700.0
const X_문끝 := 3480.0       ## ★여기가 BRICK -> WOOD 맞댐 경계
const X_하강끝 := 4200.0     ## ★여기가 WOOD -> BRICK 맞댐 경계
const X_끝 := 5200.0

const Y_계단바닥 := -530.0   ## 계단 4 단을 다 오른 높이 (-200 -> -530)
const Y_공중 := -620.0       ## 높은 발판 / 좁은 발판 윗면 (착지에서 90 상승)
const Y_구덩이 := -510.0     ## ㄷ자 구덩이 바닥 (공중에서 110 아래)
const Y_안전 := -70.0        ## SAFE ZONE 바닥 윗면

const 리밋 := Rect2(-1700, -1700, 7200, 2400)


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== PROTOTYPE STAGE 빌더 (BRICK v2 + WOOD v2 · 사방 얇은 테두리) ===")
	var 루트 := _짓기()
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패: %s" % error_string(e))
		quit(1)
		return
	e = ResourceSaver.save(팩, 내씬)
	print("   %-28s %s" % [내씬.get_file(), error_string(e)])
	print("=== 끝 ===\n")
	quit(0 if e == OK else 1)


# ============================================================================
# 본체
# ============================================================================
func _짓기() -> Node2D:
	var 시작 := Vector2(-1250.0, 지상)

	var 루트: Node2D = 월드_S.new()
	루트.name = "PROTOTYPE_STAGE"
	루트.set("스테이지_이름", "프로토타입 · 지형 검증")
	루트.set("카메라_리밋", 리밋)
	루트.set("카메라_줌", 1.35)          # 집 4방과 같은 값 (화면 1422x800)
	루트.set("시작_위치", 시작)
	루트.set("낙사_y", 1400.0)
	# 계단 + 공중 발판까지 총 낙차가 620px 이다. 기본 520 이면 한 번 떨어지는 것만으로
	# 죽어서 "지형이 잘못됐는지 낙하가 잘못됐는지" 를 못 가린다. 검증 씬이라 넉넉히 준다.
	루트.set("치명_낙하거리", 900.0)

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)
	루트.add_child(코어)

	var 어둠 := CanvasModulate.new()
	어둠.name = "어둠"
	어둠.color = (챕터_S.팔레트(1) as Dictionary)["어둠"]
	루트.add_child(어둠)

	var 지 := Node2D.new()
	지.name = "지형"
	루트.add_child(지)

	var 오 := Node2D.new()
	오.name = "오브젝트"
	루트.add_child(오)

	_지형_짓기(지)
	_목표(오)

	var p := (load(PLAYER) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 시작
	for k in 튜닝:
		p.set(k, 튜닝[k])
	루트.add_child(p)
	return 루트


# ============================================================================
# 지형
# ============================================================================
func _지형_짓기(지: Node2D) -> void:

	# ── A + B · START 평바닥 + 낮은 단차 (BRICK) ────────────────────────────
	# 한 덩어리로 만든다. 두 개로 나누면 맞닿는 면에 테두리가 두 겹 겹쳐 검은 선이 된다.
	# 단차 90 은 게이트 128 의 70% — 걸어가다 자연스럽게 뛰어오르는 정도다.
	_지형(지, T_벽돌, "바닥_START_BRICK_01", _계단덩어리([
		[X_시작, X_단차, 지상],                 # A 평평한 바닥 (폭 800)
		[X_단차, X_계단, 지상 - 90.0],          # B 낮은 단차 90 (폭 300)
	], 바닥두께 + 200.0), true)

	# ── C · 계단 4 단 + 꼭대기 착지 발판 (BRICK STAIRS) ─────────────────────
	# 폭 180 x 높이 110. 폭은 코너 조각(90px)의 두 배라 코너끼리 안 겹친다.
	# 높이 110 <= 게이트 128 이므로 **되돌아 올라올 수 있다** = 소프트락이 안 난다.
	# ★꼭대기에 수평 착지 발판(폭 280)이 반드시 있어야 한다. 없으면 폭 0 짜리
	#   수직 스파이크라 밟을 면이 없다 (README 7절).
	var 계단단: Array = []
	for i in 4:
		계단단.append([
			X_계단 + 계단폭 * i,
			X_계단 + 계단폭 * (i + 1),
			지상 - 90.0 - 단차 * (i + 1),      # -200 -> -310 -> -420 -> -530
		])
	계단단.append([X_착지, X_착지끝, Y_계단바닥])   # 꼭대기 착지 발판
	_지형(지, T_벽돌계단, "계단_BRICK_STAIRS_01", _계단덩어리(계단단, 400.0), true)

	# ── E · 높은 플랫폼 (WOOD · 공중 발판) ──────────────────────────────────
	# 점프: 수평 간격 160 (게이트 204) · 상승 90 (게이트 128). 둘 다 여유가 크다.
	# 두께 200 >= 권장 180 — 이보다 얇으면 위아래 엣지 띠(38px x 2)가 겹쳐
	# 안쪽 FILL 이 사라지고 검은 막대처럼 보인다 (README 11절).
	_지형(지, T_나무, "발판_높은_WOOD_01",
		_사각(X_높은발판, Y_공중, X_높은발판끝, Y_공중 + 발판두께), true)

	# ── G · 좁은 플랫폼 (WOOD) ──────────────────────────────────────────────
	# 점프: 수평 간격 150 · 상승 0.
	# ⚠ 폭 360 이 이 재질계의 **실질 하한**이다. 코너 쿼드가 사방 90px 씩 먹으므로
	#   300 미만이면 모서리끼리 겹쳐 가운데가 검게 파인 것처럼 보인다 (CORNER-TOPOLOGY-01).
	#   "좁다" 를 폭으로 더 밀어붙이면 지형 결함과 구분이 안 된다.
	_지형(지, T_나무, "발판_좁은_WOOD_01",
		_사각(X_좁은발판, Y_공중, X_좁은발판끝, Y_공중 + 발판두께), true)

	# ── H · ㄷ자 구덩이 (BRICK) ★내부 코너 2 개 ────────────────────────────
	# ★재질 경계 ①: 왼쪽 끝 x=1890 이 위의 WOOD 좁은 발판 오른쪽 끝과 **같은 높이로
	#   정확히 맞닿는다.** 여기서 검은 선 / 틈 / UV 깨짐이 생기는지 보는 것이 목적이다.
	# 깊이 110 (= 한 단차) 이라 들어갔다 **되돌아 나올 수 있다.**
	# 구덩이 폭 450 — 코너 조각 90 두 개를 빼도 270 이 남는다.
	_지형(지, T_벽돌, "구덩이_내부코너_BRICK_01", PackedVector2Array([
		Vector2(X_좁은발판끝, Y_공중),          # 윗면 왼쪽
		Vector2(2070.0, Y_공중),
		Vector2(2070.0, Y_구덩이),              # ★내부(오목) 코너
		Vector2(2520.0, Y_구덩이),
		Vector2(2520.0, Y_공중),                # ★내부(오목) 코너
		Vector2(X_구덩이끝, Y_공중),
		Vector2(X_구덩이끝, Y_공중 + 바닥두께),
		Vector2(X_좁은발판끝, Y_공중 + 바닥두께),
	]), true)

	# ── I · 낮은 문 아래 통과 구간 바닥 (BRICK) ────────────────────────────
	_지형(지, T_벽돌, "바닥_문_BRICK_01",
		_사각(X_구덩이끝, Y_공중, X_문끝, Y_공중 + 바닥두께), true)

	# ── I' · ㄱ자 천장 (BRICK) ★외부 코너 + 내부 코너 ──────────────────────
	# 아랫면이 한 단 내려앉는 천장 매스. 그 꺾이는 자리가 코너 검증 지점이다.
	#   왼쪽 구간  아랫면 -1010  ->  바닥 -620 과 시각 390 · 실효 342  (편하다)
	#   오른쪽 구간 아랫면  -840  ->              시각 220 · 실효 172  (몸 96 + 머리 76)
	# 실효 172 는 물리 최소 96.1 보다 76 여유라 **끼이지 않는다.** 다만 점프하면
	# 천장에 닿으므로 "여기선 뛸 수 없다" 가 몸으로 읽힌다.
	# ★이름이 "천장" 으로 시작해야 레벨검사가 구조물로 보고 도달불가 목록에서 뺀다.
	_지형(지, T_벽돌, "천장_ㄱ자_BRICK_01", PackedVector2Array([
		Vector2(X_구덩이끝, -1300.0),
		Vector2(X_문끝, -1300.0),
		Vector2(X_문끝, -840.0),
		Vector2(3120.0, -840.0),                # ★코너 (아랫면이 꺾인다)
		Vector2(3120.0, -1010.0),               # ★코너
		Vector2(X_구덩이끝, -1010.0),
	]), false)

	# ── J · 하강 계단 4 단 (WOOD) ──────────────────────────────────────────
	# ★재질 경계 ②: 왼쪽 끝 x=3480 이 위의 BRICK 바닥과 같은 높이로 맞닿는다.
	# 내려가는 계단이지만 한 단이 110 이라 **되돌아 올라올 수 있다.**
	var 하강단: Array = []
	for i in 4:
		하강단.append([
			X_문끝 + 계단폭 * i,
			X_문끝 + 계단폭 * (i + 1),
			Y_공중 + 단차 * (i + 1),            # -510 -> -400 -> -290 -> -180
		])
	_지형(지, T_나무, "계단_하강_WOOD_01", _계단덩어리(하강단, Y_공중 + 바닥두께 + 400.0), true)

	# ── K · SAFE ZONE 평바닥 (BRICK) ───────────────────────────────────────
	# ★재질 경계 ③: 왼쪽 끝 x=4200 이 위의 WOOD 계단 마지막 단과 맞닿는다.
	# 마지막 단(-180) 에서 -70 으로 110 내려온다 = 올라갈 수도 있다.
	# 폭 1000 의 평지 — 지시 11절 FLOW 에서 CLIMAX 뒤의 해소 구간이다.
	_지형(지, T_벽돌, "바닥_SAFE_BRICK_01",
		_사각(X_하강끝, Y_안전, X_끝, Y_안전 + 바닥두께), true)

	# ── 좌우 바깥 벽 ── 걸어서 맵 밖으로 나가지 못하게 막는다.
	# 이름이 "벽" 으로 시작해야 레벨검사가 구조물로 본다.
	_지형(지, T_벽돌, "벽_왼_BRICK_01", _사각(X_시작 - 240.0, -900.0, X_시작, 300.0), false)
	_지형(지, T_벽돌, "벽_오른_BRICK_01", _사각(X_끝, -700.0, X_끝 + 240.0, 300.0), false)


# ============================================================================
# 목표
# ============================================================================
func _목표(오: Node2D) -> void:
	var 문 := (load(목표문씬) as PackedScene).instantiate()
	문.name = "GOAL"
	(문 as Node2D).position = Vector2(4900.0, Y_안전 - 60.0)
	오.add_child(문)


# ============================================================================
# 지형 조립 — Template 을 인스턴스해서 점만 갈아 끼운다
# ============================================================================
## ⚠ Template 을 그대로 쓰는 것이 이 시스템의 핵심이다.
##   재질 · texture_scale · 코너 · collision_size 는 Template 이 갖고 있고,
##   빌더는 **점 배열과 콜리전 폴리곤만** 다시 만든다.
##
## ★[2026-08-26 버그 대응] Template 에 구워져 저장된 `_meshes` 가 인스턴스에 따라온다.
##   `지형.gd::_ready()` 가 `_meshes.clear()` 후 `force_update()` 를 부르므로 런타임에는
##   새 점으로 다시 굽는다. 여기서 따로 비울 필요는 없지만, 그 수정이 살아 있는지는
##   `tools/진단_지형메시.gd` 로 매번 확인할 것 (점 크기 == 메시 크기 여야 한다).
func _지형(층: Node2D, 템플릿: String, 이름: String, 월드점들: PackedVector2Array,
		칠가능: bool, 유령: bool = false) -> void:
	var 씬 := load(템플릿) as PackedScene
	var 지형: Node2D = 씬.instantiate()
	지형.name = 이름

	# 점을 노드 로컬로 옮긴다 — 원점이 도형 중심이어야 회전·스케일 사고가 없다.
	var 최소 := 월드점들[0]
	var 최대 := 월드점들[0]
	for p in 월드점들:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	var 중심 := (최소 + 최대) * 0.5
	지형.position = 중심

	지형.set("칠하기_허용", 칠가능)
	지형.set("무색일때_통과", 유령)

	var 점배열 := SS2D_Point_Array.new()
	var 로컬 := PackedVector2Array()
	for p in 월드점들:
		로컬.append(p - 중심)
	점배열.add_points(로컬)
	점배열.close_shape()               # ★닫혀야 FILL 메시가 생긴다
	지형.set_point_array(점배열)

	# 콜리전 폴리곤을 새 점으로 다시 굽는다.
	# ⚠ `collision_offset` 은 Template 값을 그대로 따른다. 2026-08-29 에 9 종 전부
	#   0.0 으로 정리했으므로 여기서 나오는 폴리곤 = 점 좌표 그대로 = 그림과 일치한다.
	var 폴리 := 지형.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	if 폴리 != null:
		var 생성기 := SS2D_CollisionGen.new()
		생성기.collision_size = 지형.collision_size
		생성기.collision_offset = 지형.collision_offset
		var 구운것 := 생성기.generate_filled(점배열.get_tessellated_points())
		if 구운것.size() < 3:
			push_warning("프로토타입(%s): 콜리전 오프셋 실패 → 원본 점을 그대로 쓴다" % 이름)
			구운것 = 점배열.get_tessellated_points()
		폴리.polygon = 구운것

	층.add_child(지형)


# ── 점 만들기 헬퍼 ──────────────────────────────────────────────────────────

## 축 정렬 사각형. (왼, 윗면, 오른, 아랫면) — 시계 방향.
func _사각(x0: float, y0: float, x1: float, y1: float) -> PackedVector2Array:
	return PackedVector2Array([
		Vector2(x0, y0), Vector2(x1, y0), Vector2(x1, y1), Vector2(x0, y1),
	])


## 계단/단차 덩어리. 단 = [[x0, x1, 윗면y], ...] 을 왼쪽부터 준다.
## 윗면을 훑고 아래로 닫아 하나의 폐곡선을 만든다.
##
## ★★[2026-08-29 함정] **높이가 같은 단이 연달아 오면 점이 중복된다.**
##   계단 꼭대기에 착지 발판을 붙이면(마지막 단과 발판이 같은 높이) 경계 x 에서
##   똑같은 점이 두 번 들어가고, 그 0 길이 변 때문에
##   `Geometry2D.offset_polygon()` 이 빈 배열을 돌려준다
##   ("Convex decomposing failed!" → **밟을 수 없는 지형**이 조용히 만들어진다).
##   눈으로는 절대 안 보인다 — 그림은 멀쩡하게 나온다.
##   → 같은 높이면 **하나의 단으로 합쳐서** 점을 두 개만 찍는다.
func _계단덩어리(단: Array, 바닥y: float) -> PackedVector2Array:
	# ① 높이가 같은 이웃 단을 하나로 합친다 (멱등 — 이미 합쳐져 있으면 그대로).
	var 합침: Array = []
	for s in 단:
		if not 합침.is_empty() and is_equal_approx(float(합침[-1][2]), float(s[2])) \
				and is_equal_approx(float(합침[-1][1]), float(s[0])):
			합침[-1][1] = s[1]          # 오른쪽 끝만 늘린다
			continue
		합침.append([s[0], s[1], s[2]])

	# ② 윗면을 왼쪽에서 오른쪽으로 훑고, 아래로 닫는다 (시계 방향).
	var 점 := PackedVector2Array()
	for s in 합침:
		점.append(Vector2(float(s[0]), float(s[2])))
		점.append(Vector2(float(s[1]), float(s[2])))
	점.append(Vector2(float(합침[합침.size() - 1][1]), 바닥y))
	점.append(Vector2(float(합침[0][0]), 바닥y))
	return 점
