## 바닥 윗면에 버튼 홈(128 × 32)이 파인 사각 슬래브 — 홈 중심 x 목록을 준다. 점은 시계 방향. `입구턱` = 160~704 를 96 판다(입구 통로 자리).
func _홈슬래브(지: Node, 이름: String, x0: float, x1: float, 윗면: float, 밑: float, 색: int, 홈중심들: Array, 입구턱: bool = false) -> Node2D:
	var 점 := []
	점.append([x0, 윗면])
	if 입구턱:
		점.append([160, 윗면])
		점.append([160, 윗면 + 96])
		점.append([704, 윗면 + 96])
		점.append([704, 윗면])
	for cx in 홈중심들:
		점.append([cx - 64.0, 윗면])
		점.append([cx - 64.0, 윗면 + 홈])
		점.append([cx + 64.0, 윗면 + 홈])
		점.append([cx + 64.0, 윗면])
	점.append([x1, 윗면])
	점.append([x1, 밑])
	점.append([x0, 밑])
	b.짧은변_허용.append(이름)          # 홈의 32 변은 일부러 짧다
	return b.지형(지, 이름, 공.다각(점), 색)


## 압력버튼 — 원점 = 홈 바닥(윗면 + 32) · 밟는면이 홈을 꼭 채워 윗면이 바닥과 같다.
func _버튼(장: Node, 이름: String, x: float, 바닥: float, 그룹: String, 유지: bool, 대상: Node = null,
		이동량: Vector2 = Vector2.ZERO, 동시: Node = null) -> Node2D:
	var n := AnimatableBody2D.new()
	n.set_script(버튼_S)
	n.name = 이름
	n.position = Vector2(x, 바닥 + 홈)
	n.set("폭", 128.0)
	n.set("높이", 홈)
	n.set("작동방식", 1 if 유지 else 0)
	n.set("누름_가능_그룹", PackedStringArray([그룹]))
	n.set("이동속도", 420.0)
	장.add_child(n)
	if 대상:
		var 경로: Array[NodePath] = [n.get_path_to(대상)]
		var 량: Array[Vector2] = [이동량]
		n.set("대상들", 경로)
		n.set("대상_이동량들", 량)
	if 동시:
		var 동: Array[NodePath] = [n.get_path_to(동시)]
		n.set("동시_버튼들", 동)
	return n


## 움직이는 덩어리(문 · 다리 · 끌어오는 땅) = Node2D 그릇 + 그 안의 지형. 버튼이 그릇을 옮긴다.
func _움직이는_지형(장: Node, 이름: String, 사각: Rect2, 색: int) -> Node2D:
	var 그릇 := Node2D.new()
	그릇.name = 이름
	그릇.position = 사각.position
	장.add_child(그릇)
	b.지형(그릇, 이름 + "_몸", 공.사각(0, 0, 사각.size.x, 사각.size.y), 색, "플랫폼")
	# 움직이는 조각은 검산·색 비율에서 뺀다 — 점이 그릇 기준(0,0)이고, 차고 안에서는 일부러 슬래브와 겹친다. 실제 통행은 주행검사가 본다.
	b.지형표.pop_back()
	return 그릇


func _박스(장: Node, 이름: String, x: float, 바닥: float) -> Node2D:
	var t := (load(S_박스) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = Vector2(x, 바닥)
	t.set("낙사_y", 바닥 + 140.0)
	장.add_child(t)
	return t


func _양동이(장: Node, 이름: String, x: float, 바닥: float, 색: int) -> Node2D:
	var t := (load(S_양동이) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = Vector2(x, 바닥)
	t.set("색", 색)
	t.set("채운뒤_밀수없음", false)          # 채운 뒤 버튼까지 밀어야 한다
	t.set("낙사_y", 바닥 + 140.0)
	장.add_child(t)
	return t


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("stage_2-7", "2-7 · 눌러 두어라",
		프레임, Vector2(520, L), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	var 배경 := (load(배경씬) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	배경.name = "하수도배경"
	루트.add_child(배경)
	루트.move_child(배경, 1)

	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 채움
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "천장띠", 공.사각(0, 0, 9216, 1120), 검, "채움")
	# 위층 천장(1216 · 머리 위 480 · 뛰어도 320 남는다)의 왼쪽 절반을 흰색으로 — 이 판은 마지막 흰 구간 빼고 전부 검정이라 색 비율(65 ± 5)을 이렇게 맞춘다.
	b.지형(지, "천장띠_밑_왼", 공.사각(0, 1120, 2496, 1216), 검, "채움")
	b.지형(지, "U_천장_흰", 공.사각(2496, 1120, 5904, 1216), 흰)
	b.지형(지, "천장띠_밑_오른", 공.사각(5904, 1120, 9216, 1216), 검, "채움")
	b.지형(지, "F_L1천장", 공.사각(0, 1216, 2368, 천장), 흰)                  # L1 머리 위 480 · 못 닿는다 — 흰 노출면(색 비율)
	b.지형(지, "U_왼벽", 공.사각(2368, 1216, 2496, 천장), 검)                 # 굴뚝 1 왼쪽 면 · 위층 왼끝

	# ══════════════════════════════════════════════════════════════════════
	# L1 「도입」 (0~2688 · 공기 1984~2560)
	# ══════════════════════════════════════════════════════════════════════
	_홈슬래브(지, "L1_바닥", 0, 2688, L, 3200, 검, [896.0, 1856.0], true)
	# 문_1(유지 버튼) · 문_2(순간 버튼 + 박스). 문은 복도를 꽉 채우는 128 벽 · 열리면 640 내려가 바닥 속으로.
	var 문1 := _움직이는_지형(장, "문_1", Rect2(1344, 천장, 128, 문높이), 검)
	var 문2 := _움직이는_지형(장, "문_2", Rect2(2240, 천장, 128, 문높이), 검)
	_버튼(장, "버튼_1_사람_유지", 896, L, "player", true, 문1, Vector2(0, 640))
	# 버튼_2 = 박스 전용 · 순간형: 사람이 밟아도 안 눌리고, 박스가 올라가 있는 동안만 문_2 가 열린다 → 박스_1(1650)을 밀어 올려 두고 뛰어넘어 지난다.
	#   (처음엔 "사람 · 순간" 으로 두었다가 박스가 버튼을 못 눌러 문이 안 열렸다 — 그룹은 누르는 물체를 정확히 적는다)
	_버튼(장, "버튼_2_박스_순간", 1856, L, "박스", false, 문2, Vector2(0, 640))
	_박스(장, "박스_1", 1650, L)
	# 굴뚝 1(2496~2688 · 오른벽 2688 에 붙어 오른다) → U
	var y := L - 128.0
	var n := 1
	while y >= U + 128.0:
		b.통과플랫폼(장, "S1_g%d" % n, 2592.0, y, 192.0, 1)
		y -= 128.0
		n += 1

	# ══════════════════════════════════════════════════════════════════════
	# 가운데 덩어리(2688~3392 · U 윗면부터 바닥까지) = 굴뚝 1 오른벽 · 굴뚝 2 왼벽 · U 왼쪽 바닥
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "가운데덩어리", 공.사각(2688, U, 3392, 3200), 검)

	# ══════════════════════════════════════════════════════════════════════
	# L2 「다리를 만든다」 (3392~5904 · 공기 1984~2560) · 위 슬래브 3584~4000 / 5200~5904 · 틈 4000~5200
	# ══════════════════════════════════════════════════════════════════════
	_홈슬래브(지, "L2_바닥", 3392, 5904, L, 3200, 검, [5200.0])
	b.지형(지, "U_틈앞", 공.사각(3584, U, 4000, U + 96), 검)
	b.지형(지, "U_틈앞_밑", 공.사각(3584, U + 96, 4000, 천장), 흰)            # L2 천장(못 닿는다) — 흰 노출면
	b.지형(지, "U_틈뒤", 공.사각(5200, U, 5904, U + 96), 검)
	b.지형(지, "U_틈뒤_밑", 공.사각(5200, U + 96, 5904, 천장), 흰)
	# 굴뚝 2(3392~3584 · 왼벽 3392 에 붙어 오른다) → U. 위층에서 걸어오다 이 구멍에 빠지면 맨 위 격자(1920)에 선다 — 뛰어 나온다.
	y = L - 128.0
	n = 1
	while y >= U + 128.0:
		b.통과플랫폼(장, "S2_g%d" % n, 3488.0, y, 192.0, 1)
		y -= 128.0
		n += 1
