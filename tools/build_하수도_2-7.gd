		Rect2(1792, L, 128, 홈),                    # 버튼_2 홈
		Rect2(2496, U, 192, 천장 - U),              # 굴뚝 1 구멍
		Rect2(2496, 1216, 9216 - 2496, U - 1216),   # U 공기(굴뚝 1 윗부분 · 문_4 · 출구 포함)
		Rect2(3392, 천장, 2512, L - 천장),          # L2 공기(3392~5904)
		Rect2(3392, U, 192, 천장 - U),              # 굴뚝 2 구멍
		Rect2(4000, U, 1200, 천장 - U),             # 중앙 틈(다리가 들어온다)
		Rect2(5136, L, 128, 홈),                    # 버튼_3 홈
		Rect2(5936, U, 128, 홈),                    # 버튼_4b 홈
		Rect2(6240, U, 128, 홈),                    # 버튼_4a 홈
		Rect2(7136, U, 128, 홈),                    # 버튼_5 홈
		Rect2(7392, U, 608, 256),                   # 끌어오는 땅이 메울 틈
		Rect2(8320, U, 128, 128),                   # 가시 슬롯(검→흰)
