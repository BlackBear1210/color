	#   도면 그대로 단단하면 검4(칸 33~35 · 42.5) → 흰2(17.5~25.5 · 39.5) 점프가 흰3(28.5~31.5 · 밑면 37) 밑을
	#   80px 틈으로 지나야 한다 — 몸 키 97 이라 머리가 박혀 떨어진다(작업기록 §4). 모양·자리는 도면 그대로 둔다.
	for 조각 in 자료["지형"]:
		var 이름: String = 이름표.get(조각["이름"], 조각["이름"])
		b.짧은변_허용.append(이름)
