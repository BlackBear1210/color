extends SceneTree
## ============================================================================
## [2026-09-07 신규] 차오르는 물 · 웅덩이 낙하 받기 검사
## ----------------------------------------------------------------------------
## 실행: godot --headless --path . -s res://tools/test_차오르는물.gd
##
## ▣ 여기서 고정하는 것 (전부 실제로 한 번씩 틀렸던 것들이다)
##   1. **웅덩이의 원점은 아랫변**이다. 바닥선에 그냥 얹을 수 있어야 한다.
##   2. 차오를 때 **바닥은 제자리에 있고 수면만 올라간다.**
##      유체는 원점이 물의 윗끝이라, 높이만 키우면 아래로 자란다(= 흘러내린다).
##      그래서 위치를 같이 올리는데, 그게 정말 맞는지 여기서 못 박는다.
##   3. **리스폰 때 처음 높이로 돌아간다.** 안 돌아가면 물이 가득 찬 방으로
##      되살아나 무한히 죽는다 — 고칠 수 없는 상태가 된다.
##   4. **얕은 물은 낙하를 못 받아준다.** 발목 물이 100m 낙하를 살려주면 거짓말이다.
##   5. **낙하감시의 `_받아줌` 은 굳으면 안 된다.**
##      `위험도()` 가 0 을 돌려주면 월드가 검사를 멈추고, 그러면 플래그가 true 로
##      굳어 **그 뒤로 아무 데서 떨어져도 안 죽는다.** 그래서 `원_위험도()` 를 따로 둔다.
## ============================================================================

const 색상 := preload("res://scripts/color_defs.gd")
const 웅덩이_씬 := "res://scenes/집/스마트월드_장애물/웅덩이.tscn"
const 유체_씬 := "res://scenes/집/스마트월드_장애물/유체.tscn"
const 낙하감시_S := preload("res://scripts/스마트월드/낙하_감시.gd")
const 월드_S := preload("res://scripts/스마트월드/월드.gd")
const 코어_S := preload("res://scripts/스마트월드/페인트_코어.gd")
const 플레이어_씬 := preload("res://scenes/player/Player.tscn")

var 통과 := 0
var 실패 := 0


func _init() -> void:
	call_deferred("_실행")


func _확인(조건: bool, 글: String) -> void:
	if 조건:
		통과 += 1
		print("  ✔ %s" % 글)
	else:
		실패 += 1
		print("  ✖ %s" % 글)


func _가깝나(a: float, b: float, 허용: float = 0.5) -> bool:
	return absf(a - b) <= 허용


func _실행() -> void:
	print("\n=== 차오르는 물 · 웅덩이 ===")
	_웅덩이_모양()
	_웅덩이_차오름()
	_웅덩이_낙하받기()
	_웅덩이_색규칙()
	_유체_차오름()
	_낙하감시_받아줌()
	await _실제로_떨어뜨려보기()

	print("\n════════════════════════════════════════")
	print("  통과 %d · 실패 %d" % [통과, 실패])
	print("════════════════════════════════════════\n")
	quit(1 if 실패 > 0 else 0)


func _웅덩이_만들기(높이: float = 96.0) -> Node2D:
	var 팩 := load(웅덩이_씬) as PackedScene
	var n := 팩.instantiate() as Node2D
	n.set("크기", Vector2(400.0, 높이))
	root.add_child(n)
	return n


# ── 1. 모양 ────────────────────────────────────────────────────────────────
func _웅덩이_모양() -> void:
	print("\n── 원점은 아랫변")
	var p := _웅덩이_만들기(120.0)
	var c := p.get_node_or_null("모양") as CollisionShape2D
	_확인(c != null, "충돌 모양이 만들어진다")
	if c:
		var r := c.shape as RectangleShape2D
		_확인(r != null and _가깝나(r.size.y, 120.0), "판정 높이 = 크기.y (120)")
		_확인(_가깝나(c.position.y, -60.0), "판정 중심이 위로 절반 = -60 (원점이 아랫변)")
	_확인(_가깝나(p.call("수면_월드y"), p.global_position.y - 120.0), "수면 y = 원점 − 수심")
	p.queue_free()


# ── 2. 차오름 ──────────────────────────────────────────────────────────────
func _웅덩이_차오름() -> void:
	print("\n── 바닥은 그대로, 수면만 올라간다")
	var p := _웅덩이_만들기(96.0)
	p.global_position = Vector2(0.0, 1000.0)          # 바닥선 y = 1000
	p.set("차오름_켜기", true)
	p.set("차오름_속도", 100.0)
	p.set("차오름_최종높이", 400.0)
	p.set("차오름_시작지연", 0.0)
	p.call("차오르기_시작")

	var 바닥_처음: float = p.global_position.y
	# 물리 프레임을 흉내낸다. 96 에서 시작해 100px/s 로 400 까지 = 3.04 초 → 넉넉히 4 초.
	for i in 240:
		p.call("_차오름_진행", 1.0 / 60.0)

	var 높이: float = p.get("크기").y
	_확인(_가깝나(높이, 400.0, 3.0), "최종높이 400 까지 찼다 (실제 %.1f)" % 높이)
	_확인(_가깝나(p.global_position.y, 바닥_처음), "바닥(원점)은 1px 도 안 움직였다")
	_확인(_가깝나(p.call("수면_월드y"), 1000.0 - 400.0, 3.0), "수면이 600 까지 올라왔다")

	print("\n── 리스폰: 처음 높이로 되돌아간다")
	p.set("차오름_자동시작", false)
	p.call("차오르기_초기화")
	_확인(_가깝나(p.get("크기").y, 96.0), "초기화하면 수심이 96 으로 돌아온다")
	_확인(_가깝나(p.global_position.y, 바닥_처음), "초기화해도 바닥은 그대로")
	p.queue_free()

	print("\n── 차오름을 안 켜면 아무 일도 안 일어난다")
	var q := _웅덩이_만들기(96.0)
	q.call("차오르기_시작")
	for i in 60:
		q.call("_차오름_진행", 1.0 / 60.0)
	_확인(_가깝나(q.get("크기").y, 96.0), "차오름_켜기 가 꺼져 있으면 높이가 안 변한다")
	q.queue_free()


# ── 3. 낙하 받기 ───────────────────────────────────────────────────────────
func _웅덩이_낙하받기() -> void:
	print("\n── 얕은 물은 못 받아준다")
	var p := _웅덩이_만들기(20.0)
	p.set("낙하_받아줌", true)
	p.set("받아주는_최소수심", 40.0)
	_확인(not bool(p.call("낙하를_받아주나")), "수심 20 < 최소 40 → 안 받아준다")
	p.set("크기", Vector2(400.0, 60.0))
	_확인(bool(p.call("낙하를_받아주나")), "수심 60 ≥ 최소 40 → 받아준다")

	p.set("켜짐", false)
	_확인(not bool(p.call("낙하를_받아주나")), "꺼진 웅덩이는 안 받아준다")
	p.set("켜짐", true)
	p.set("낙하_받아줌", false)
	_확인(not bool(p.call("낙하를_받아주나")), "낙하_받아줌 을 끄면 안 받아준다")
	p.queue_free()


# ── 4. 색 규칙 ─────────────────────────────────────────────────────────────
func _웅덩이_색규칙() -> void:
	print("\n── 웅덩이도 색 규칙 안이다")
	var p := _웅덩이_만들기(96.0)
	p.set("색", 색상.BLACK)
	_확인(bool(p.call("반대색인가", 색상.WHITE)), "검은 웅덩이 + 흰 플레이어 = 죽는다")
	_확인(not bool(p.call("반대색인가", 색상.BLACK)), "검은 웅덩이 + 검은 플레이어 = 안 죽는다")
	p.set("색", 색상.GRAY)
	_확인(not bool(p.call("반대색인가", 색상.WHITE)), "회색 웅덩이는 누구도 안 죽인다")
	_확인(not bool(p.call("반대색인가", 색상.BLACK)), "회색 웅덩이는 검정도 안 죽인다")
	p.set("색", 색상.WHITE)
	p.set("켜짐", false)
	_확인(not bool(p.call("반대색인가", 색상.BLACK)), "꺼진 웅덩이는 아무것도 아니다")
	p.queue_free()


# ── 5. 유체도 같은 손잡이를 가진다 ─────────────────────────────────────────
func _유체_차오름() -> void:
	print("\n── 유체: 원점이 윗끝이라 위치까지 같이 올려야 한다")
	var 팩 := load(유체_씬) as PackedScene
	var f := 팩.instantiate() as Node2D
	# ★인스턴스를 만든 **뒤에** 값을 넣는다 — 배치 도구·코드가 실제로 이렇게 쓴다.
	#   `차오르기_시작()` 이 기준을 다시 잡아주지 않으면 여기서 물이 순간이동한다.
	f.set("크기", Vector2(120.0, 100.0))
	root.add_child(f)
	f.position = Vector2(0.0, 900.0)                  # 물 윗끝 900 · 아랫끝 1000
	var 바닥_처음: float = f.position.y + f.get("크기").y

	f.set("차오름_켜기", true)
	f.set("차오름_속도", 100.0)
	f.set("차오름_최종높이", 400.0)
	f.call("차오르기_시작")
	# 100 에서 시작해 100px/s 로 400 까지 = 3 초 → 넉넉히 5 초.
	for i in 300:
		f.call("_차오름_진행", 1.0 / 60.0)

	var 바닥_나중: float = f.position.y + f.get("크기").y
	_확인(_가깝나(f.get("크기").y, 400.0, 3.0), "유체도 400 까지 찬다 (실제 %.1f)" % f.get("크기").y)
	_확인(_가깝나(바닥_나중, 바닥_처음, 1.0), "물의 아랫끝이 제자리다 (%.1f → %.1f)" % [바닥_처음, 바닥_나중])
	_확인(f.position.y < 900.0, "원점(수면)이 위로 올라갔다 — 흘러내린 게 아니다")
	_확인(not bool(f.call("낙하를_받아주나")), "유체의 낙하_받아줌 은 기본 꺼짐 (폭포는 안 받아준다)")
	f.queue_free()


# ── 6. 낙하감시 플래그가 굳지 않는가 ───────────────────────────────────────
func _낙하감시_받아줌() -> void:
	print("\n── 낙하감시: 받아줌 플래그가 굳으면 안 된다")
	var 감시 := 낙하감시_S.new()
	감시.경고_표시 = false                              # 헤드리스에서는 비네트를 만들지 않는다
	감시.치명_낙하거리 = 500.0
	root.add_child(감시)
	# 내부 상태를 직접 넣는다 — 실제 낙하를 흉내내려면 플레이어와 물리 프레임이 필요하다.
	감시.set("_낙하거리", 480.0)

	var 원 := float(감시.call("원_위험도"))
	_확인(원 > 0.0, "480/500 낙하 = 경고 구간 (원_위험도 %.2f)" % 원)

	감시.call("받아줌_알림", true)
	_확인(_가깝나(float(감시.call("위험도")), 0.0), "받아주는 물 위 → 위험도 0 (비네트 안 뜸)")
	_확인(_가깝나(float(감시.call("원_위험도")), 원, 0.001),
		"★원_위험도 는 그대로다 — 월드가 계속 검사할 수 있다")

	감시.call("받아줌_알림", false)
	_확인(float(감시.call("위험도")) > 0.0, "물을 벗어나면 경고가 돌아온다")

	감시.call("받아줌_알림", true)
	감시.call("초기화")
	_확인(not bool(감시.call("받아지는중")), "초기화(리스폰)하면 받아줌 플래그가 풀린다")
	감시.queue_free()


# ── 7. 통합: 진짜 플레이어를 진짜 물리로 떨어뜨린다 ────────────────────────
## ▣ 왜 단위 검사만으로는 부족한가
##   위 검사들은 부품이 각자 맞는 답을 하는지만 본다. 그런데 이 기능의 실제 위험은
##   **월드.gd 의 순서**에 있다 — 낙사는 착지 전에 거리만으로 즉사시키므로,
##   "물에 닿으면 살려준다" 로 짜면 **물에 닿기 전에 이미 죽는다.**
##   그래서 실제로 떨어뜨려서 살아남는지 봐야 한다.
##
## ▣ 두 경로를 다 태운다
##   ① 아직 공중 — 발밑으로 쏜 레이가 물을 먼저 잡아야 한다
##   ② 이미 물속 — 레이는 자기가 시작한 영역 안쪽을 못 잡으므로 겹침으로 잡아야 한다
func _실제로_떨어뜨려보기() -> void:
	print("\n── 통합: 진짜로 떨어뜨려 본다 (치명 낙하거리 500)")

	# (가) 물이 없으면 죽는다 — 이게 성립해야 (나) 가 의미를 가진다
	var 월드A := _테스트월드_만들기()
	await physics_frame
	var pA: Node2D = 월드A.get_node("Player")
	pA.global_position = Vector2.ZERO
	for i in 40:
		await physics_frame
	var yA: float = pA.global_position.y
	_확인(yA < 1500.0, "(전제) 물이 없으면 낙사해서 시작점으로 돌아온다 (y %.0f)" % yA)
	월드A.queue_free()
	await physics_frame

	# (나) 아래에 깊은 웅덩이가 있으면 안 죽는다
	var 월드B := _테스트월드_만들기()
	await physics_frame
	var 웅 := (load(웅덩이_씬) as PackedScene).instantiate() as Node2D
	웅.set("크기", Vector2(1200.0, 4000.0))    # 수면 y=2000 · 바닥 y=6000
	웅.set("색", 색상.GRAY)                     # 회색 = 색으로는 안 죽는다
	웅.set("낙하_받아줌", true)
	월드B.add_child(웅)
	웅.global_position = Vector2(0.0, 6000.0)  # 원점은 아랫변
	await physics_frame

	var pB: Node2D = 월드B.get_node("Player")
	pB.global_position = Vector2.ZERO
	# ① 아직 공중 — 26 프레임이면 약 1,100px 낙하(치명 500 을 이미 넘었다)
	for i in 26:
		await physics_frame
	var y1: float = pB.global_position.y
	_확인(y1 > 900.0, "★공중: 발밑에 물이 잡히면 500px 를 넘겨도 안 죽는다 (y %.0f)" % y1)

	# ② 이제 물속 — 겹침 경로로도 살아 있어야 한다
	for i in 14:
		await physics_frame
	var y2: float = pB.global_position.y
	_확인(y2 > 2000.0, "★물속: 수면(2000)을 지나서도 계속 살아 있다 (y %.0f)" % y2)
	월드B.queue_free()
	await physics_frame


## `test_사망판정.gd` 의 합성 스테이지와 같은 방식. 다만 여기서는
## **월드의 _physics_process 를 켠 채로** 둔다 — 리스폰까지 포함해서 봐야 하기 때문이다.
func _테스트월드_만들기() -> Node2D:
	var 월드 := Node2D.new()
	월드.set_script(월드_S)
	월드.name = "낙하테스트월드"
	월드.set("치명_낙하거리", 500.0)
	월드.set("낙사_y", 100000.0)
	월드.set("안전지점_자동저장", false)
	월드.set("낙하_경고표시", false)          # 헤드리스에서는 비네트를 만들지 않는다
	월드.set("시작_위치", Vector2.ZERO)

	var 코어 := Node.new()
	코어.set_script(코어_S)
	코어.name = "페인트코어"
	코어.add_to_group("페인트코어")
	월드.add_child(코어)

	var p := 플레이어_씬.instantiate()
	p.name = "Player"
	월드.add_child(p)

	root.add_child(월드)
	return 월드
