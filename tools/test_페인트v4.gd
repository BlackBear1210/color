extends SceneTree
## ============================================================================
## [2026-08-01 신규] 페인트 시스템 v4 규칙 자동 검증
## ----------------------------------------------------------------------------
## 실행: Godot --headless --path . -s res://tools/test_페인트v4.gd
##
## ▣ 무엇을 검사하나 (2026-08-01 확정 규칙)
##   1. 반대색을 덮으면 회색이 된다
##   2. 회색은 수동 회수가 안 된다
##   3. 회색은 총 2발을 잡아먹는다 (원래 색 1발 + 덮은 1발)
##   4. 회수는 FIFO(먼저 칠한 것부터)이고 회색은 그 줄에서 빠진다
##   5. 스테이지 이동(리셋)하면 회색까지 전부 회수된다
##   6. 빗나감 / 같은 색 덧칠 / 칠할 수 없는 대상 → 페인트는 즉시 환급
##   7. 부분 색칠은 시간이 지나면 스스로 흐려지고 발수를 돌려준다
##
## ▣ 왜 실제 씬이 아니라 가짜 대상으로 검사하나
##   규칙은 페인트_코어.gd 안에만 있다. 지형·식물은 "무슨 색인지"만 답하면 되므로,
##   최소한의 가짜 대상으로 규칙만 떼어 검사하는 게 빠르고 실패 원인도 명확하다.
##   (지형 렌더링까지 묶어 검사하면 셰이더 문제인지 규칙 문제인지 구분이 안 된다)
## ============================================================================

var 통과 := 0
var 실패 := 0


## 규칙 검사용 최소 대상 — 지형과 똑같은 상태 전이만 흉내낸다.
class 가짜대상 extends Node:
	var 필요: int = 1
	var 색: int = -1
	var _맞은: int = 0
	var _진행색: int = -1
	var 칠가능: bool = true

	func 명중(c: int, _p: Vector2) -> String:
		if not 칠가능:
			return "blocked"
		if 색 == ColorDefs.GRAY:
			return "blocked"
		if 색 >= 0:
			if c == 색:
				return "wasted"
			색 = ColorDefs.GRAY
			return "mixed_gray"
		if _맞은 > 0 and _진행색 != c:
			_맞은 = 0
		_진행색 = c
		_맞은 += 1
		if _맞은 >= 필요:
			색 = c
			return "painted"
		return "progress"

	func 되돌리기() -> bool:
		if 색 == ColorDefs.GRAY or not 칠가능:
			return false
		색 = -1
		_맞은 = 0
		return true

	func 현재색() -> int:
		return 색


func _init() -> void:
	_검사_회색화()
	_검사_회색_2발()
	_검사_FIFO()
	_검사_리셋()
	_검사_환급()
	_검사_부분누적()
	print("\n[test_페인트v4] 통과 %d / 실패 %d" % [통과, 실패])
	quit(1 if 실패 > 0 else 0)


func 확인(이름: String, 실제, 기대) -> void:
	if 실제 == 기대:
		통과 += 1
		print("  ✔ %s" % 이름)
	else:
		실패 += 1
		print("  ✘ %s — 기대 %s, 실제 %s" % [이름, str(기대), str(실제)])


func _코어(최대: int = 10) -> 페인트코어:
	var c := 페인트코어.new()
	c.최대_탄약 = 최대
	root.add_child(c)          # _ready() 가 돌아야 리셋()으로 잔량이 채워진다
	return c


func _쏘기(코어: 페인트코어, 대상: Node, 색: int) -> String:
	코어.발사_소모()
	return 코어.명중_처리(대상, 색, Vector2.ZERO)


# ── 규칙 1·2 ───────────────────────────────────────────────────────────────
func _검사_회색화() -> void:
	print("\n[규칙 1·2] 반대색 → 회색 / 회색은 수동 회수 불가")
	var 코어 := _코어()
	var t := 가짜대상.new()
	확인("검정으로 칠하면 painted", _쏘기(코어, t, ColorDefs.BLACK), "painted")
	확인("그 위에 흰색 → mixed_gray", _쏘기(코어, t, ColorDefs.WHITE), "mixed_gray")
	확인("상태가 회색", t.현재색(), ColorDefs.GRAY)
	확인("회색은 수동 회수 실패", 코어.수동_회수(), false)
	확인("회색에 또 쏘면 blocked", _쏘기(코어, t, ColorDefs.BLACK), "blocked")
	코어.queue_free()


# ── 규칙 3 ─────────────────────────────────────────────────────────────────
func _검사_회색_2발() -> void:
	print("\n[규칙 3] 회색 = 2발 소모")
	var 코어 := _코어(10)
	var t := 가짜대상.new()
	_쏘기(코어, t, ColorDefs.BLACK)
	확인("첫 칠 후 잔량 9", 코어.남은_탄약, 9)
	_쏘기(코어, t, ColorDefs.WHITE)
	확인("회색화 후 잔량 8", 코어.남은_탄약, 8)
	확인("잠긴 발수 2", 코어.잠긴_발수(), 2)
	확인("회수줄에서 빠졌다", 코어.회수_대기수(), 0)
	코어.queue_free()


# ── 규칙 4 ─────────────────────────────────────────────────────────────────
func _검사_FIFO() -> void:
	print("\n[규칙 4] FIFO 회수 · 회색은 건너뜀")
	# 기획 예시 그대로: 1검정 2흰색 3검정 4검정 5회색 6흰색 → 회수 순서 1,2,3,4,6
	var 코어 := _코어(20)
	var 대상 := []
	for i in 6:
		대상.append(가짜대상.new())
	_쏘기(코어, 대상[0], ColorDefs.BLACK)
	_쏘기(코어, 대상[1], ColorDefs.WHITE)
	_쏘기(코어, 대상[2], ColorDefs.BLACK)
	_쏘기(코어, 대상[3], ColorDefs.BLACK)
	# 5번은 회색 — 검정으로 칠한 뒤 흰색을 덮는다
	_쏘기(코어, 대상[4], ColorDefs.BLACK)
	_쏘기(코어, 대상[4], ColorDefs.WHITE)
	_쏘기(코어, 대상[5], ColorDefs.WHITE)

	확인("회수줄에 5개 (회색 제외)", 코어.회수_대기수(), 5)
	var 순서 := []
	while 코어.회수_대기수() > 0:
		var 다음 := 코어.다음_회수대상()
		순서.append(대상.find(다음))
		코어.수동_회수()
	확인("회수 순서 = 0,1,2,3,5", str(순서), str([0, 1, 2, 3, 5]))
	확인("회색은 여전히 회색", 대상[4].현재색(), ColorDefs.GRAY)
	코어.queue_free()


# ── 규칙 5 ─────────────────────────────────────────────────────────────────
func _검사_리셋() -> void:
	print("\n[규칙 5] 스테이지 이동 = 회색 포함 전량 회수")
	var 코어 := _코어(10)
	var 회색대상 := 가짜대상.new()
	var 보통대상 := 가짜대상.new()
	_쏘기(코어, 회색대상, ColorDefs.BLACK)
	_쏘기(코어, 회색대상, ColorDefs.WHITE)      # 회색
	_쏘기(코어, 보통대상, ColorDefs.BLACK)
	확인("리셋 전 잔량 7", 코어.남은_탄약, 7)
	코어.리셋()
	확인("리셋 후 잔량 최대", 코어.남은_탄약, 10)
	확인("리셋 후 회수줄 비었다", 코어.회수_대기수(), 0)
	확인("리셋 후 잠긴 발수 0", 코어.잠긴_발수(), 0)
	확인("보통 대상은 무색으로", 보통대상.현재색(), -1)
	# 회색 대상은 되돌리기()가 false 라 상태는 회색 그대로지만,
	# 실제 게임에서는 씬이 통째로 새로 로드되므로 문제가 되지 않는다.
	코어.queue_free()


# ── 규칙 6 ─────────────────────────────────────────────────────────────────
func _검사_환급() -> void:
	print("\n[규칙 6] 빗나감 / 같은 색 / 칠 불가 → 즉시 환급")
	var 코어 := _코어(10)
	코어.발사_소모()
	확인("빗나감 결과", 코어.명중_처리(null, ColorDefs.BLACK, Vector2.ZERO), "miss")
	확인("빗나가면 잔량 그대로", 코어.남은_탄약, 10)

	var t := 가짜대상.new()
	_쏘기(코어, t, ColorDefs.BLACK)
	확인("칠하면 9", 코어.남은_탄약, 9)
	확인("같은 색 덧칠 = wasted", _쏘기(코어, t, ColorDefs.BLACK), "wasted")
	확인("wasted 는 환급되어 9 유지", 코어.남은_탄약, 9)

	var 못칠함 := 가짜대상.new()
	못칠함.칠가능 = false
	확인("칠 불가 대상 = blocked", _쏘기(코어, 못칠함, ColorDefs.WHITE), "blocked")
	확인("blocked 도 환급되어 9 유지", 코어.남은_탄약, 9)
	코어.queue_free()


# ── 규칙 7 ─────────────────────────────────────────────────────────────────
func _검사_부분누적() -> void:
	print("\n[규칙 7] 부분 색칠 누적 · 자동 회수")
	var 코어 := _코어(10)
	var t := 가짜대상.new()
	t.필요 = 3
	확인("1발째 progress", _쏘기(코어, t, ColorDefs.BLACK), "progress")
	확인("2발째 progress", _쏘기(코어, t, ColorDefs.BLACK), "progress")
	확인("3발째 painted", _쏘기(코어, t, ColorDefs.BLACK), "painted")
	확인("잔량 7", 코어.남은_탄약, 7)
	확인("회수줄 1개", 코어.회수_대기수(), 1)
	코어.수동_회수()
	확인("회수하면 3발 전부 환급", 코어.남은_탄약, 10)

	# 완성 전에 흐려져 자동 회수되는 경우
	var t2 := 가짜대상.new()
	t2.필요 = 3
	_쏘기(코어, t2, ColorDefs.BLACK)
	_쏘기(코어, t2, ColorDefs.BLACK)
	확인("부분 2발 소모 → 8", 코어.남은_탄약, 8)
	코어.부분_자동회수(t2, 2)
	확인("자동 회수 후 10", 코어.남은_탄약, 10)
	코어.queue_free()
