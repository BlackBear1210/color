func _init() -> void:
	Engine.max_fps = 60
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(폴더))
	var 성공 := 0
	var 실패 := 0
	for 항목 in 목록:
		if _만들기(항목):
			성공 += 1
		else:
			실패 += 1
	print("[build_장애물씬] 생성 %d / 실패 %d  → %s" % [성공, 실패, 폴더])
	quit(실패)


func _만들기(항목: Dictionary) -> bool:
	var 스크립트경로: String = "res://scripts/스마트월드/" + String(항목["스크립트"])
	if not ResourceLoader.exists(스크립트경로):
		push_error("스크립트 없음: %s" % 스크립트경로)
		return false
	var 스크립트: Script = load(스크립트경로)

	# ── 루트 ──
	# ⚠ 반드시 `스크립트.new()` 로 만든다. ClassDB.instantiate + set_script 로 만들면
	#   스크립트의 _init() 이 안 돌아 내부 배열이 null 인 채로 저장되는 경우가 있다
	#   (SS2D_Shape 에서 실제로 겪은 함정 — 2026-08-01 기록).
	var 루트: Node = 스크립트.new()
	if 루트 == null:
		push_error("인스턴스 실패: %s" % 스크립트경로)
		return false
	루트.name = String(항목["이름"])

	# 기본값 주입 — 씬을 열자마자 "쓸 만한 상태"로 보이게 한다
	for 키 in (항목["기본값"] as Dictionary):
		루트.set(키, 항목["기본값"][키])

	# ── 아트 슬롯 ──
	# 비어 있는 Sprite2D 하나. 디자이너는 여기 Texture 만 꽂으면 된다.
	var 슬롯: Sprite2D = (load(슬롯_스크립트) as Script).new()
	슬롯.name = "그림"
	슬롯.기준_크기 = 항목["기준크기"]
	# 비어 있어도 노드는 살려 둔다(안 그러면 디자이너가 자리를 못 찾는다).
	# 텍스처가 없으면 아무것도 안 그려지므로 화면에는 영향이 없다.
	슬롯.centered = true
	루트.add_child(슬롯)
	슬롯.owner = 루트

	# ── 저장 ──
	var 팩 := PackedScene.new()
	var err := 팩.pack(루트)
	if err != OK:
		push_error("pack 실패(%s): %s" % [항목["이름"], error_string(err)])
		return false
	var 경로 := 폴더 + String(항목["이름"]) + ".tscn"
	err = ResourceSaver.save(팩, 경로)
	if err != OK:
		push_error("저장 실패(%s): %s" % [경로, error_string(err)])
		return false
	print("  ✔ %-14s %s" % [항목["이름"], 항목["설명"]])
	return true
