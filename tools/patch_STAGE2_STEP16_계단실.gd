## ★카메라 구역 — 자리·크기는 STEP 15 값 유지, **시선 오프셋만** 고친다.
##   [이름, 시선_오프셋]
const 시선표 := {
	# ★계단실 : 300px 아래를 본다 → 아래층 tread 가 화면에 들어온다(이 STEP 의 핵심).
	"카메라_계단": Vector2(0.0, 300.0),
	# 홀 : 계단실로 내려가기 직전이라 조금 아래를 본다.
	"카메라_좁은통로": Vector2(0.0, 120.0),
	# 대복도 : 걷는 구간이라 살짝 위(기본값 느낌)를 본다.
	"카메라_2층복도": Vector2(0.0, -40.0),
	# 1층 거실 : 원화를 보여 줘야 하므로 위쪽을 조금 더.
	"카메라_1층홀": Vector2(0.0, -80.0),
}

var _검증만 := false


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	for a in OS.get_cmdline_user_args():
		if a == "--검증":
			_검증만 = true

	var 씬 := load(씬경로) as PackedScene
	if 씬 == null:
		push_error("STEP16: 씬을 못 읽었다"); quit(1); return
	var 루트 := 씬.instantiate() as Node2D
	print("\n=== STAGE 2 STEP 16 계단실 %s===" % ("(검증 왕복만) " if _검증만 else ""))
	print("   기존 지형 %d 개 (건드리지 않는다)" % 루트.get_node("지형").get_child_count())

	if not _검증만:
		_장식(루트)
		_시선(루트)

	# # STEP16 (4차 수정):
	# # 문제: 처음엔 여기서 `공통.주인_지정(루트, 루트)` 를 불렀다. 그런데 이 도구는
	# #       STEP 15 패치와 달리 **이미 다 지어진 씬을 읽어서** 손보는 도구다.
	# #       이미 owner 가 있는 노드에 owner 를 **다시 박는 것**이 되고, 그것이 바로
	# #       CLAUDE.md §6 이 경고하는 사고다 — 실제로 멱등성 3 회 반복 중
	# #       `그림자_가림막.gd` 가 씬을 인스턴스했다 지울 때 **세그폴트**가 났다.
	# # 목적: 이 도구가 다른 도구를 깨뜨리지 않게 한다.
	# # 해결: 블랭킷 owner 재지정을 **없앤다.** `PackedScene.instantiate()` 는 원래
	# #       씬이 소유하던 노드에 owner 를 이미 제대로 넣어 준다.
	# #       이 도구가 owner 를 줘야 하는 것은 **새로 만든 장식 노드뿐**이고,
	# #       그건 `_장식()` 에서 하나하나 직접 준다(§거기 코드 참고).
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("STEP16: pack 실패 %s" % error_string(e)); quit(1); return
	var 저장 := 검증경로 if _검증만 else 씬경로
	e = ResourceSaver.save(팩, 저장)
	if e != OK:
		push_error("STEP16: 저장 실패 %s" % error_string(e)); quit(1); return
	print("   저장 → %s\n=== 끝 ===\n" % 저장)
	quit(0)


# ============================================================================
func _장식(루트: Node2D) -> void:
	# 멱등 — 통째로 지우고 다시 만든다.
	var 옛 := 루트.get_node_or_null(담을_이름)
	if 옛 != null:
		루트.remove_child(옛)
		옛.queue_free()
		print("   − 기존 %s 제거" % 담을_이름)

	var 층 := Node2D.new()
	층.name = 담을_이름
	층.z_index = 깊이
	층.z_as_relative = false
	루트.add_child(층)
	층.owner = 루트

	var 수 := 0
	for r in 장식표:
		_장식하나(층, 루트, String(r[0]),
			float(r[1]), float(r[2]), float(r[3]), float(r[4]), String(r[5]))
		수 += 1
	print("   + %s 에 장식 %d 개 (전부 콜리전 없음 · z %d)" % [담을_이름, 수, 깊이])


## SS2D 장식 하나. **충돌을 완전히 끈다** — 밟을 수도, 부딪힐 수도 없다.
func _장식하나(층: Node2D, 루트: Node2D, 이름: String,
		x0: float, y0: float, x1: float, y1: float, 재질: String) -> void:
	var 템플릿 := T_벽돌 if 재질 == "B" else T_나무
	var 씬 := load(템플릿) as PackedScene
	var 노드: Node2D = _모양노드(씬.instantiate())
	노드.name = 이름

	var 점들 := PackedVector2Array([
		Vector2(x0, y0), Vector2(x1, y0), Vector2(x1, y1), Vector2(x0, y1)])
	var 최소 := 점들[0]
	var 최대 := 점들[0]
	for p in 점들:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	노드.position = (최소 + 최대) * 0.5

	# 칠하기·색 판정에서 완전히 뺀다 — 장식은 gameplay 가 아니다.
	노드.set("칠하기_허용", false)
	노드.set("위치별_판정", false)

	var 점배열 := SS2D_Point_Array.new()
	var 로컬 := PackedVector2Array()
	for p in 점들:
		로컬.append(p - 노드.position)
	점배열.add_points(로컬)
	점배열.close_shape()
	노드.set_point_array(점배열)

	층.add_child(노드)
	노드.owner = 루트

	# ★충돌 끄기 — 이게 "장식" 의 정의다.
	#
	# # STEP16 (2차 수정):
	# # 문제: 처음에는 StaticBody2D 의 layer/mask 를 0 으로 두고 CollisionPolygon2D 를
	# #       disabled 로 껐다. 그런데 **런타임에 되살아났다** — 실측으로 통행 시험이
	# #       26/26 → 17/26 으로 떨어졌고, 플레이어가 난간·소핏에 걸려 멈췄다.
	# #       원인은 두 군데다:
	# #         · `지형.gd::_충돌레이어_갱신()` 이 _ready 에서 layer 를 **1 로 다시 쓴다**
	# #         · SS2D 가 collision_update_mode 에 따라 폴리곤을 **다시 굽는다**
	# # 목적: 장식이 gameplay 에 절대 개입하지 못하게 한다(지시서 §15 · 겹침 0 유지).
	# # 해결: 값을 끄는 대신 **StaticBody2D 를 통째로 없앤다.**
	# #       그러면 `get_collision_polygon_node()` 가 null 을 돌려주고,
	# #       `_충돌레이어_갱신()` · `_전용_충돌경로_보정()` 둘 다 첫 줄에서 return 한다.
	# #       충돌체가 아예 존재하지 않으므로 되살아날 것도 없다.
	# # STEP16 (3차 수정 — 이게 실제로 먹은 방법):
	# # 문제: 2차 수정(StaticBody2D 를 통째로 제거)도 **안 먹었다**. 통행 17/26 그대로.
	# #       장식 노드가 템플릿 씬의 **인스턴스**(`instance=ExtResource(...)`)이기 때문이다.
	# #       인스턴스에서 자식을 지우는 것은 .tscn 에 저장되지 않는다 — 로드할 때
	# #       원본 PackedScene 이 다시 펼쳐지면서 StaticBody2D 가 **되살아난다.**
	# #       (반면 자식의 **속성 오버라이드**는 저장된다 — 이 차이가 핵심이다)
	# # 목적: 로드 후에도 확실히 안 부딪히게 한다.
	# #       인스턴스 **자식**의 오버라이드도 저장이 안 됐다 — 자식에는 owner 가 없고,
	# #       owner 를 박으면 CLAUDE.md §6 의 "노드가 두 벌" 사고가 난다.
	# # 해결: `지형.gd` 에 `장식_전용` 스위치를 넣고 **노드 자신의 속성**으로 켠다.
	# #       노드 자신은 owner 가 있으니 .tscn 에 확실히 저장되고,
	# #       로드 뒤 `_충돌레이어_갱신()` 이 그 값을 보고 콜리전을 꺼 준다.
	노드.set("장식_전용", true)     # ★이 한 줄이 "장식" 을 보장한다 (지형.gd §장식_전용)


func _모양노드(인스턴스: Node2D) -> Node2D:
	if 인스턴스.has_method("get_point_array"):
		return 인스턴스
	for 자식 in 인스턴스.get_children():
		if 자식 is Node2D and 자식.has_method("get_point_array"):
			인스턴스.remove_child(자식)
			인스턴스.queue_free()
			return 자식
	return 인스턴스


# ============================================================================
func _시선(루트: Node2D) -> void:
	var 오 := 루트.get_node("오브젝트") as Node2D
	for 이름: String in 시선표:
		var c := 오.get_node_or_null(이름) as Node2D
		if c == null:
			print("   ⚠ 없음: %s" % 이름)
			continue
