extends RefCounted
## ============================================================================
## [2026-09-05 신규] 지형 기복 생성기 — "일자 맵" 을 막는 공용 부품
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 2026-09-05)
##   "현재 맵의 경로는 너무 직선적. 살짝의 위아래 움직임이 있으면 좋겠다.
##    아래 아래 위, 위 아래 위, 위 위 위 등등 상관없어. 일자 맵만은 피해.
##    이런 식으로 랜덤하게 맵을 생성할 수 있는 알고리즘을 만들어. 다른 스테이지에도 넣게."
##
##   → 스테이지 빌더는 **구간을 x 범위와 색으로만** 적고, 높이는 여기서 받는다.
##     2-1 · 2-2 · 2-3 은 물론 앞으로 나올 스테이지도 같은 함수를 쓴다.
##
## ▣ ★★ 랜덤인데 왜 매번 같은 맵이 나오나 — 일부러 그렇게 만들었다
##   `씨앗` 하나로 결정된다. **같은 씨앗이면 언제나 한 픽셀도 다르지 않다.**
##   빌드할 때마다 맵이 바뀌면
##     · `레벨검사.gd` 가 통과해도 다음 빌드에서 깨질 수 있고
##     · 관문 좌표를 적어 둔 설계도가 매번 거짓말이 되고
##     · 버그가 재현이 안 된다.
##   AGENTS.md §5 "도구는 멱등이어야 한다" 가 바로 이것이다.
##   맵을 바꾸고 싶으면 **씨앗 숫자만** 바꿔 여러 개를 뽑아 보고 마음에 드는 것을 박는다.
##
## ▣ 지켜 주는 안전 규칙 (이걸 지키려고 손으로 안 하고 함수로 만든 것이다)
##   1. 한 턱은 **±120** 뿐이다. `지형규칙.gd` 의 안전 오름단차가 **128** 이라,
##      120 이면 점프 없이 걸어서 오르내린다. 즉 **어느 방향으로도 되돌아갈 수 있다.**
##      더 크게 잡으면 죽고 체크포인트로 돌아온 뒤 지형을 거슬러 못 올라가는
##      일방통행이 생긴다 — 레벨검사가 소프트락으로 잡는 그 상황이다.
##   2. 높이는 **띠 안**에 갇힌다(기준에서 위로 n 칸 · 아래로 m 칸).
##      안 그러면 계단이 한 방향으로만 쌓여 스테이지가 통째로 기울어진다.
##   3. **같은 높이가 `직진_최대` 번 연속되면 강제로 꺾는다.** 이게 "일자 맵 금지" 다.
##   4. `평지` 로 지정한 구간은 앞 구간과 **같은 높이**다.
##      체크포인트 평지, 구덩이 착지처럼 높이가 어긋나면 안 되는 자리에 쓴다.
##
## ▣ 쓰는 법
##   const 기복 := preload("res://tools/지형기복.gd")
##   var 높이 := 기복.굴곡(구간표.size(), 20260905, {
##       "기준": 1100.0, "단": 120.0, "위로": 1, "아래로": 1,
##       "평지": [5, 8, 11], "직진_최대": 2,
##   })
##   print(기복.리듬글(높이, 120.0))     # "· ↑ ↓ ↓ ↑ · ↑ ↓ · ↑ ↓ ·"
## ============================================================================
class_name 지형기복


## 구간마다 바닥 윗면 y 를 정해 돌려준다. y 는 **작을수록 높은 곳**이다(Godot 좌표).
##
##   구간수     : 몇 조각인가
##   씨앗       : 같은 값이면 같은 결과. 빌더에 상수로 박아 둔다
##   설정       :
##     "기준"       float  첫 구간의 높이 (기본 1100)
##     "단"         float  한 턱의 높이차 (기본 120 — 안전 오름단차 128 아래)
##     "위로"       int    기준에서 위로 몇 칸까지 (기본 1)
##     "아래로"     int    기준에서 아래로 몇 칸까지 (기본 1)
##     "평지"       Array  앞 구간과 같은 높이로 둘 구간 번호들
##     "직진_최대"  int    같은 높이가 이만큼 연속되면 강제로 꺾는다 (기본 2)
##     "머물_확률"  float  높이를 안 바꿀 확률 (기본 0.25 — 낮아야 굴곡이 산다)
static func 굴곡(구간수: int, 씨앗: int, 설정: Dictionary = {}) -> PackedFloat32Array:
	var 기준: float = 설정.get("기준", 1100.0)
	var 단: float = 설정.get("단", 120.0)
	var 위로: int = int(설정.get("위로", 1))
	var 아래로: int = int(설정.get("아래로", 1))
	var 평지: Array = 설정.get("평지", [])
	var 직진_최대: int = int(설정.get("직진_최대", 2))
	var 머물_확률: float = float(설정.get("머물_확률", 0.25))

	var rng := RandomNumberGenerator.new()
	rng.seed = 씨앗

	var 결과 := PackedFloat32Array()
	## 칸 = 기준에서 몇 칸 떨어졌나. 음수가 위(y 가 작다), 양수가 아래.
	var 칸 := 0
	var 머문횟수 := 0

	for i in 구간수:
		if i == 0:
			결과.append(기준)
			continue
		if 평지.has(i):
			# 앞 구간과 같은 높이. 칸도 그대로 두되, 평지는 "머문" 것으로 세지 않는다 —
			# 세면 평지 두 개가 붙었을 때 그 다음 구간이 무조건 꺾여 리듬이 뻣뻣해진다.
			결과.append(결과[i - 1])
			continue

		var 후보: Array[int] = []
		if 칸 - 1 >= -위로:
			후보.append(-1)          # 올라간다
		if 칸 + 1 <= 아래로:
			후보.append(1)           # 내려간다
		# ★규칙 3 — 너무 오래 같은 높이면 "머문다" 를 후보에서 뺀다. 이것이 일자 맵 금지다.
		if 머문횟수 < 직진_최대:
			후보.append(0)

		var 고른: int = _고르기(rng, 후보, 머물_확률)
		칸 += 고른
		머문횟수 = 머문횟수 + 1 if 고른 == 0 else 0
		결과.append(기준 + float(칸) * 단)

	return 결과


## 후보 중 하나를 고른다. 0(머무르기)에만 따로 확률을 주고, 나머지는 고르게 나눈다.
static func _고르기(rng: RandomNumberGenerator, 후보: Array[int], 머물_확률: float) -> int:
	if 후보.is_empty():
		return 0
	var 움직임: Array[int] = []
	for c in 후보:
		if c != 0:
			움직임.append(c)
	if 움직임.is_empty():
		return 0
	if 후보.has(0) and rng.randf() < 머물_확률:
		return 0
	return 움직임[rng.randi_range(0, 움직임.size() - 1)]


## 로그용 한 줄. 빌드할 때 찍어 두면 어떤 리듬이 나왔는지 눈으로 확인된다.
##   · = 그대로 · ↑ = 올라감 · ↓ = 내려감
static func 리듬글(높이들: PackedFloat32Array, 단: float) -> String:
	if 높이들.is_empty():
		return ""
	var s := "·"
	for i in range(1, 높이들.size()):
		var d := 높이들[i] - 높이들[i - 1]
		if absf(d) < 단 * 0.5:
			s += " ·"
		elif d < 0.0:
			s += " ↑"
		else:
			s += " ↓"
	return s


## 만든 높이가 규칙을 지켰는지 스스로 검사한다. 빌더에서 한 번 부르면
## 설정을 잘못 줘서 못 오르는 턱이 생기는 사고를 빌드 단계에서 잡는다.
##   돌려주는 값 = 문제 설명들. 비어 있으면 통과.
static func 검산(높이들: PackedFloat32Array, 단: float, 안전_오름단차: float = 128.0) -> Array[String]:
	var 문제: Array[String] = []
	for i in range(1, 높이들.size()):
		var d: float = absf(높이들[i] - 높이들[i - 1])
		if d > 안전_오름단차:
			문제.append("구간 %d→%d 턱이 %.0f — 안전 오름단차 %.0f 를 넘어 되돌아갈 수 없다"
				% [i - 1, i, d, 안전_오름단차])
		elif d > 0.0 and absf(d - 단) > 0.5:
			문제.append("구간 %d→%d 턱이 %.0f — 단(%.0f)의 배수가 아니다" % [i - 1, i, d, 단])
	return 문제
