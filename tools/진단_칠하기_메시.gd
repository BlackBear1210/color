extends SceneTree
## ============================================================================
## [2026-09-25 신규] 칠하기 진단 — "발판 안쪽이 다 안 칠해진다" 의 원인을 가른다
## ----------------------------------------------------------------------------
## 실행:
##   Godot --headless --path . -s res://tools/진단_칠하기_메시.gd -- <씬경로> [<씬경로> ...]
##   (인자가 없으면 집 챕터 두 스테이지를 잰다)
##
## ▣ 왜 만들었나 (도형님 스크린샷 · 2026-09-25)
##   발판이 **검은 테두리 + 밝은 안쪽** 으로 보이고 "안쪽이 다 안 칠해진다" 는 제보.
##   이 증상은 원인이 **세 가지**인데 화면만 봐서는 전혀 구분이 안 된다.
##   셋 다 예전에 실제로 한 번씩 터졌던 것이고, 고치는 곳이 전부 다르다.
##
##     ① 메시에 페인트 셰이더가 안 붙었다
##        SS2D 는 채우기 메시와 테두리 메시가 **따로**다. 한쪽에만 셰이더가 붙으면
##        칠했는데 다른 쪽이 원래 색으로 남는다. (2026-08-27 `_메시별_셰이더_보정()`
##        을 만든 이유이고, 그 전에는 코너 쿼드 4 개가 검정으로 남았다)
##        → 이 도구의 `셰이더X` 열이 0 이 아니면 이것이다.
##
##     ② 얼룩 반지름이 발판보다 작다 (전체칠 승격 전까지)
##        `_목표반지름_갱신()` 의 상한은 `플레이어_기준키(96) × 부분_칠_범위_배율(2.2)
##        × 0.5 = 105.6 px` 다. 발판 긴변이 211 px 를 넘으면 **마지막 한 발로
##        전체 승격되기 전까지는 구조적으로 가운데만 칠해진다.**
##        → `부분덮음%` 열이 작고 `필요횟수` 가 크면 이것이다. 버그가 아니라 설계값이다.
##
##     ③ 전체칠 자체가 불가능하다
##        `전체_색칠_최대긴변 = 576`. 넘으면 아무리 쏴도 안 굳는다.
##        → `전체칠` 열이 ✖ 이면 이것이다.
##
## ▣ 이 도구는 아무것도 고치지 않는다. 씬을 띄워서 재기만 한다.
##   ⚠ 헤드리스는 **그리지 않는다.** 재질이 붙었는지는 알 수 있지만 "눈에 어떻게 보이나"
##     는 사람이 게임을 켜서 봐야 한다.
## ============================================================================

## 인자가 없을 때 재는 대상.
const 기본대상 := [
	"res://scenes/집/스테이지_1_2층방.tscn",
	"res://scenes/집/스테이지_2_복도계단.tscn",
]

## 페인트 셰이더 경로 — 메시에 붙은 재질이 **이것인지**로 판별한다.
## 경로로 비교하는 이유: `preload` 로 물면 헤드리스에서 전역 클래스 등록 순서에
## 걸릴 수 있다(지형.gd 30 번 줄의 같은 주의사항).
const 셰이더경로 := "res://shaders/지형_페인트.gdshader"

## 지형.gd 의 상수와 **같은 값**이어야 한다. 두 곳이 어긋나면 이 진단이 거짓말을 한다.
const 플레이어_기준키 := 96.0

var _대상: Array = []


func _init() -> void:
	call_deferred("_go")


func _go() -> void:
	for a: String in OS.get_cmdline_user_args():
		if not a.begins_with("--"):
			_대상.append(a)
	if _대상.is_empty():
		_대상 = 기본대상.duplicate()

	var 문제 := 0
	for 경로: String in _대상:
		문제 += await _한판(경로)
	print("")
	print("════════ 손봐야 할 지형 합계: %d 개 ════════" % 문제)
	quit(0 if 문제 == 0 else 1)


## 씬 하나를 재고, **손봐야 할 지형 개수**를 돌려준다.
func _한판(경로: String) -> int:
	var ps := load(경로) as PackedScene
	if ps == null:
		print("✗ 씬을 못 읽었다: %s" % 경로)
		return 1

	var 뿌리 := ps.instantiate()
	root.add_child(뿌리)
	current_scene = 뿌리
	# SS2D 가 메시를 굽고, 지형.gd 의 `_메시별_셰이더_보정()` 이 `_process` 에서
	# 한 번 더 훑는 데까지 몇 프레임 걸린다. 예산 진단과 같은 90 프레임을 준다.
	for _i in 90:
		await process_frame

	print("")
	print("════════════════════════════════════════════════════════════════════")
	print("  %s" % 경로)
	print("════════════════════════════════════════════════════════════════════")
	print("%-24s %8s %6s %5s %6s %8s %7s %s" % [
		"지형", "긴변", "필요발", "전체칠", "셰이더X", "부분덮음%", "칠방식", "메시(텍스처)"])

	var 지형들: Array = []
	_모으기(뿌리, 지형들)

	var 문제 := 0
	var 셰이더없는_메시_합 := 0
	var 전체칠불가 := 0
	var 부분만보이는 := 0

	for t in 지형들:
		# ── 크기 ────────────────────────────────────────────────────────────
		# `_세계긴변` 은 지형.gd 가 `_로컬반경_계산()` 에서 채운다(월드 배율 반영).
		var 긴변: float = float(t.get("_세계긴변"))
		var 로컬반경: float = float(t.get("_로컬반경"))
		var 필요: int = int(t.call("필요횟수"))
		var 전체칠: bool = bool(t.call("전체_색칠_가능"))
		var 방식: int = int(t.get("칠하기_방식"))

		# ── 부분 칠이 실제로 덮는 비율 ──────────────────────────────────────
		#   지형.gd `_목표반지름_갱신()` 과 **같은 식**이다. 여기서 다른 식을 쓰면
		#   진단이 코드가 아니라 내 기억을 재게 된다.
		var 배율: float = float(t.get("부분_칠_범위_배율"))
		var 부분최대반지름: float = minf(로컬반경, 플레이어_기준키 * 배율 * 0.5)
		# 얼룩 지름 ÷ 긴변 = "한 번에 최대 이만큼 덮는다". 100 을 넘으면 100 으로 자른다.
		var 덮음: float = 100.0
		if 긴변 > 0.0:
			덮음 = minf(부분최대반지름 * 2.0 / 긴변 * 100.0, 100.0)

		# ── 메시별 셰이더 ───────────────────────────────────────────────────
		var 메시들: Array = t.get("_meshes")
		var 없는: int = 0
		var 텍스처들: Array[String] = []
		if 메시들 != null:
			for m in 메시들:
				if m == null or m.texture == null:
					continue
				var 이름: String = String(m.texture.resource_path).get_file()
				var 붙음 := false
				var sm := m.material as ShaderMaterial
				if sm != null and sm.shader != null:
					붙음 = (sm.shader.resource_path == 셰이더경로)
				if not 붙음:
					없는 += 1
					이름 = "✖" + 이름
				텍스처들.append(이름)

		# ── 판정 ────────────────────────────────────────────────────────────
		# `안칠해짐`(2)은 애초에 색 규칙 밖이다 — 껍데기·장식이 여기 들어온다.
		# 그것까지 세면 모든 스테이지가 실패로 나와서 아무도 이 표를 안 본다
		# (예산 진단이 외곽·채움을 빼는 것과 같은 이유).
		if 방식 == 2:
			continue

		var 나쁨 := false
		if 없는 > 0:
			셰이더없는_메시_합 += 없는
			나쁨 = true
		if not 전체칠:
			전체칠불가 += 1
			나쁨 = true
		# 전체칠은 되지만 마지막 한 발 전까지 절반도 못 덮는 발판 = 화면에서
		# "안쪽이 안 칠해진다" 로 보이는 구간. 3 발 이상 필요할 때만 센다
		# (2 발짜리는 첫 발에 이미 거의 덮인다).
		elif 덮음 < 50.0 and 필요 >= 3:
			부분만보이는 += 1
			나쁨 = true

		if 나쁨:
			문제 += 1
			print("%-24s %8.0f %6d %5s %6d %8.0f %7s %s" % [
				String(t.name).substr(0, 24), 긴변, 필요,
				("OK" if 전체칠 else "✖"), 없는, 덮음,
				["전체칠", "부분칠만", "안칠해짐"][방식],
				", ".join(텍스처들)])

	print("────────────────────────────────────────────────────────────────────")
	print("지형 %d 개 중 손봐야 할 것 %d 개" % [지형들.size(), 문제])
	print("  ① 셰이더 안 붙은 메시 : %d 개  → 붙었는데 안 칠해지면 이것" % 셰이더없는_메시_합)
	print("  ② 부분칠이 절반도 못 덮음 : %d 개  → 마지막 발 전까지 가운데만 칠해진다" % 부분만보이는)
	print("  ③ 전체칠 불가(긴변>576) : %d 개  → 아무리 쏴도 안 굳는다" % 전체칠불가)

	뿌리.queue_free()
	await process_frame
	return 문제


## `스마트지형` 그룹은 런타임(`_ready`)에 들어가므로, 그룹이 아니라 **스크립트**로 찾는다.
## 그래야 `_ready` 가 아직 안 끝난 노드도 빠지지 않는다.
func _모으기(n: Node, 통: Array) -> void:
	if n.has_method("필요횟수") and n.has_method("전체_색칠_가능"):
		통.append(n)
	for c in n.get_children():
		_모으기(c, 통)
