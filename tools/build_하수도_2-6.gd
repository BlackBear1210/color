const 공 := preload("res://tools/하수도_빌더_공통.gd")
const 내씬 := "res://scenes/world_2_클로드/stage_2-6.tscn"
const 다음씬 := "res://scenes/world_2_클로드/stage_2-7.tscn"
const 배경씬 := "res://scenes/배경/하수도_다층배경_v02.tscn"
const S_양동이 := "res://scenes/집/스마트월드_장애물/양동이.tscn"

const 검 := 공.검정
const 흰 := 공.흰색

const 프레임 := Rect2(0, 0, 9216, 3200)
const F := 2560.0      # 아래층(운반로) 바닥
const U := 1792.0      # 위층(복귀로) 바닥
const 천장 := 1984.0   # 아래층 천장(= U 슬래브 밑) · 머리 위 480

var b: RefCounted


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 2-6 · 무거운 것 v2 (양동이 3 · 구덩이 1 · 배출구 1 · 막다른 길 1) ===")
	b = 공.new()
	b.재질_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_black.tres")
	b.재질_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_white.tres")
	b.재질_선반_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_black.tres")
	b.재질_선반_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_white.tres")
	var 루트 := _짓기()
	var ok: bool = b.검산(프레임, _빈공간들())
	b.색비율_보고()
	if not ok or b.오류 > 0:
		push_error("2-6: 검산 실패 %d — 저장하지 않는다" % b.오류)
		quit(1)
		return
	if not b.저장(루트, 내씬):
		quit(1)
		return
	print("=== 끝 ===\n")
	quit(0)


func _빈공간들() -> Array:
	return [
		Rect2(0, 천장, 7600, F - 천장),             # 아래층 공기(A·B·C · 문턱·구덩이·양동이 포함)
		Rect2(160, F, 544, 96),                     # 입구 통로 자리
		Rect2(2496, F, 128, 192),                   # 가시 슬롯 1(검→흰)
		Rect2(3392, F, 352, 96),                    # B 구덩이
		Rect2(4608, F, 128, 192),                   # 가시 슬롯 2(흰→검)
		Rect2(7408, U, 192, 천장 - U),              # 굴뚝 구멍(U 슬래브를 뚫는다)
		Rect2(4992, 1216, 9216 - 4992, U - 1216),   # 위층 공기(호퍼 · 출구 통로 포함)
		Rect2(5104, U, 192, 천장 - U),              # 위층 왼쪽 되돌아 떨어지는 구멍
		Rect2(7776, U, 128, 128),                   # 위층 가시 슬롯 3(검→흰)
		Rect2(8400, U, 128, 128),                   # 위층 가시 슬롯 4(흰→검)
	]


## 층 바닥 슬래브를 위/아래 두 겹으로(윗겹 = 걷는 색 · 아랫겹 = 못 닿는 천장 색). 색 비율용(2-4 와 같음).
func _두겹슬래브(지: Node, 이름: String, x0: float, x1: float, 윗면: float, 위색: int, 아래색: int) -> Node2D:
	var 위: Node2D = b.지형(지, 이름, 공.사각(x0, 윗면, x1, 윗면 + 96.0), 위색)
	b.지형(지, 이름 + "_밑", 공.사각(x0, 윗면 + 96.0, x1, 윗면 + 192.0), 아래색, "채움")
	return 위


## 양동이(원점 = 발 · 몸통 92×94 · 물감지 76×76 는 발 위 26~102). `굳음` = 채우면 그 자리에서 고정.
## `낙사_y` 를 바닥 + 140 으로 둔다 — 가시 슬롯(바닥 + 192)에 빠지면 제자리로 되살아난다(슬롯에 걸터앉아 갇히는 것 방지 ·
## 구덩이(바닥 + 96)에 떨어진 것은 그대로 남는다).
func _양동이(부모: Node, 이름: String, x: float, 바닥: float, 색: int, 굳음: bool,
		배출유체: Node = null, 배출지점: Node = null) -> Node2D:
	var t := (load(S_양동이) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = Vector2(x, 바닥)
	t.set("색", 색)
	t.set("채운뒤_밀수없음", 굳음)
	t.set("낙사_y", 바닥 + 140.0)
	부모.add_child(t)
	if 배출유체:
		t.set("배출_유체", t.get_path_to(배출유체))
	if 배출지점:
		t.set("배출_지점", t.get_path_to(배출지점))
	return t


## 양동이용 물줄기 — 천장에서 바닥 위 40 까지(양동이 물감지 26~102 에 닿는다). 폭 64 = 밑단 물띠 ≈ ±25 라
## 양동이(±46) 옆에 붙어 미는 몸(가장자리 46 이상)이 안 닿는다. ⚠ 몸 색과 같은 물만 둔다 — 반대색이면 복도가 막힌다.
func _물줄기(장: Node, 이름: String, x: float, 바닥: float, 색: int) -> Node2D:
	b.배관(장, "관_" + 이름, 공.다각([[x, 천장 - 200.0], [x, 천장 + 16.0]]))
	return b.유체(장, 이름, x, 천장 + 16.0, 64.0, 바닥 - 40.0 - (천장 + 16.0), 색)


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("stage_2-6", "2-6 · 무거운 것",
		프레임, Vector2(520, F), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	var 배경 := (load(배경씬) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	배경.name = "하수도배경"
	루트.add_child(배경)
	루트.move_child(배경, 1)

	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 채움 — 천장 · 아래층 천장(못 닿는 면은 흰색 = 색 비율)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "천장띠", 공.사각(0, 0, 9216, 1216), 검, "채움")
	b.지형(지, "F_하부천장", 공.사각(0, 1216, 4864, 천장), 흰, "채움")          # 머리 위 480 · 못 닿는다
	b.지형(지, "U_왼벽", 공.사각(4864, 1216, 4992, 천장), 검)                  # 위층 왼끝 — 검정 몸이 닿는 벽

	# ══════════════════════════════════════════════════════════════════════
	# A 검정 「받으면 굳는다」  (공기 1984~2560 · 0~2496)  문턱 오른끝(2304)에서 내려선 뒤 슬롯까지 192 — 낙하 관성으로 슬롯에 빠지지 않게
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "A_바닥", 공.다각([
		[0, F], [160, F], [160, F + 96], [704, F + 96], [704, F], [2496, F], [2496, 3200], [0, 3200],
	]), 검)
	# 문턱: 바닥에서 224 위 — 뛰어서는 못 오르고(160) 굳은 양동이(94) 위에서만 오른다(130). 위를 걸어 넘고 오른끝에서 내려선다.
	b.지형(지, "A_문턱", 공.사각(1696, F - 224, 2304, F), 검)
	# 물줄기는 문턱 왼벽(1696) 바로 앞 1680 — 양동이는 물감지(±38)가 물띠(±8)에 닿는 **1620~1632** 에서 굳어 오른끝이 벽에서 18~32 px.
	#   그래서 왼쪽에서 뛰어 벽에 부딪히면 그 틈(< 몸 44)에 안 빠지고 양동이 위로 떨어진다 — 92 폭 상자 위에 정확히 내리는 대신 벽이 잡아 준다.
	var w1: Node2D = _물줄기(장, "W1_검정물", 1680, F, 공.물_검)
	# 양동이 B1: 950 에서 물줄기(1680)까지 ≈680 민다. 담기며 굳는다 → 그 위(94)에서 문턱(224)으로 130 을 오른다.
	_양동이(장, "양동이_1", 950, F, 공.물_검, true)
	b.지형(지, "슬롯1_바닥", 공.사각(2496, F + 192, 2624, 3200), 검, "채움")
	b.가시(위, "가시_슬롯1", 2560, F + 192, 4)

	# ══════════════════════════════════════════════════════════════════════
	# B 흰색 「구덩이를 메운다」  (2624~4608)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "B_바닥", 공.다각([
		[2624, F], [3392, F], [3392, F + 96], [3744, F + 96], [3744, F], [4608, F], [4608, 3200], [2624, 3200],
	]), 흰)
	# 구덩이(352 · 96 깊이) 바닥은 **가시** — 뛰어서는 못 넘고(안전 300) 들어가면 죽는다(96 이면 뛰어 나올 수 있어 다리가 필요 없어진다).
	# 물은 구덩이 **왼벽 관에서** 나온다(F+8~F+80): 바닥 위를 지나는 양동이(물감지 F−102~F−26)에는 안 닿고, 떨어진 양동이(F−6~F+70)만 채운다.
	#   → 굳는 자리 = 떨어지는 자리(왼벽 + 46 = 3438). 윗면(F−4)이 바닥과 같아 걸어서 올라타고 남은 260 을 뛴다.
	#   ⚠ 처음엔 천장에서 내리는 물줄기였다 — 양동이가 구덩이 가장자리(3381)에서 먼저 물을 받아 걸쳐진 채 굳었다(실측).
	b.가시(위, "가시_구덩이", 3568, F + 96, 11)
	# ⚠ 관은 두지 않는다 — 배관 SS2D 에 콜리전이 있어 떨어진 양동이가 관 위에 걸터앉았다(실측 y 2611). 물만 벽에서 솟는다.
	var w2: Node2D = b.유체(장, "W2_흰물", 3438, F + 8, 64, 72, 공.물_흰)
	_양동이(장, "양동이_2", 2900, F, 공.물_흰, true)
	b.지형(지, "슬롯2_바닥", 공.사각(4608, F + 192, 4736, 3200), 검, "채움")
	b.가시(위, "가시_슬롯2", 4672, F + 192, 4)

	# ══════════════════════════════════════════════════════════════════════
	# C 검정 「실어 나른다」  (4736~7600)  +  굴뚝(7408~7600 · 오른벽 7600 에 붙어 오른다)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "C_바닥", 공.사각(4736, F, 7600, 3200), 검)
	b.지형(지, "C_오른덩어리", 공.사각(7600, 2048, 9216, 3200), 검, "채움")      # 아래층 오른끝 벽(굴뚝 오른벽의 아랫부분)
	# 회전톱: 위층 구멍(5200)에서 떨어진 자리보다 오른쪽 · 양동이 앞. 검정 구간이라 색 판단과 타이밍이 겹치지 않는다.
	b.회전톱(위, "회전톱_C", Vector2(5600, F - 250), 40.0, 380.0, 3.0, true)   # ±190 → 바닥 위 60~440 을 오르내린다
	# 굴뚝 꼭대기 호퍼 H3 + 고정 흰 공급 + 양동이 배출 물(검정 · 처음엔 꺼짐) → 출구 물(320 · 처음 흰 → 회색)
	var cx := 7504.0
	var 면 := U + 64.0
	var 출구: Node2D = b.유체(장, "H3_출구물", cx, 면 + 56.0, 320.0, F - (면 + 56.0), 공.물_회, false)
	b.호퍼(장, "H3", cx, 면, 192.0, 56.0, 출구, 320.0)
	b.유체(장, "H3_고정공급", cx - 72.0, U + 16.0, 48.0, 64.0, 공.물_흰)
	var 배출: Node2D = b.유체(장, "H3_배출공급", cx + 72.0, U + 16.0, 48.0, 64.0, 공.물_검, false)
	var 지점 := Marker2D.new()
	지점.name = "배출구"
	지점.position = Vector2(6900, F - 48)
