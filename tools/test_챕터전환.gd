extends SceneTree
## ============================================================================
## [2026-08-08 신규] 챕터 흐름 · 전환 연출 · 조준선 · 덩굴 검증 (헤드리스)
## ----------------------------------------------------------------------------
## 실행: Godot --headless --path . -s res://tools/test_챕터전환.gd
##
## 검사하는 것
##   [1] 챕터표    — 스테이지 순서·씬 존재·챕터 경계
##   [2] 통로 연결 — 실제 씬의 출구 통로가 표의 다음 스테이지를 가리키는가
##   [3] 전환 연출 — 챕터 전환일 때만 흰색/길게
##   [4] 조준선    — ★시뮬레이션 궤적이 **실탄이 날아간 길과 같은가**
##   [5] 덩굴      — 벨레 물리가 늘어지고, 플레이어가 밀고, 멀면 쉬는가
##   [6] 장식      — 표면 감지가 여러 층을 다 찾는가
## ============================================================================

const 총_S := preload("res://scripts/스마트월드/총.gd")
const 총알_S := preload("res://scripts/스마트월드/총알.gd")
const 코어_S := preload("res://scripts/스마트월드/페인트_코어.gd")
const 덩굴_S := preload("res://scripts/스마트월드/덩굴.gd")
const 배치_S := preload("res://scripts/스마트월드/장식배치.gd")
const 공통 := preload("res://tools/지형공통.gd")
const 플레이어_씬 := preload("res://scenes/player/Player.tscn")

var 실패 := 0
var 총 := 0


func 확인(이름: String, 조건: bool, 덧말: String = "") -> void:
	총 += 1
	print(("  PASS  " if 조건 else "  FAIL  ") + 이름 + ("" if 덧말.is_empty() else "   " + 덧말))
	if not 조건:
		실패 += 1


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== 챕터 흐름 · 전환 · 조준선 · 덩굴 ===")
	_챕터표_검사()
	await _통로연결_검사()
	_연출값_검사()
	await _조준선_검사()
	await _덩굴_검사()
	await _장식_검사()

	print("---")
	print("결과: %d / %d 통과%s" % [총 - 실패, 총, "" if 실패 == 0 else "  ← %d개 실패" % 실패])
	quit(1 if 실패 > 0 else 0)


# ── [1] 챕터표 ──────────────────────────────────────────────────────────────
func _챕터표_검사() -> void:
	print("\n[1] 챕터표")
	확인("스테이지가 2개 이상 있다", 챕터.스테이지_수() >= 2, "%d개" % 챕터.스테이지_수())

	var 번호들: Array[int] = []
	var 씬없음 := 0
	for s in 챕터.스테이지표:
		var n := int(s["번호"])
		번호들.append(n)
		if not ResourceLoader.exists(챕터.씬경로(n)):
			씬없음 += 1
			print("      없음: %s" % 챕터.씬경로(n))
	확인("★모든 스테이지 씬이 실제로 있다", 씬없음 == 0, "빠진 씬 %d개" % 씬없음)

	var 중복 := false
	for i in 번호들.size():
		for j in range(i + 1, 번호들.size()):
			if 번호들[i] == 번호들[j]:
				중복 = true
	확인("스테이지 번호가 겹치지 않는다", not 중복)

	# 사슬이 끊기지 않는가
	var 끊김 := 0
	for i in range(번호들.size() - 1):
		if 챕터.다음_번호(번호들[i]) != 번호들[i + 1]:
			끊김 += 1
	확인("다음_번호()가 표 순서와 같다", 끊김 == 0)
	확인("마지막 스테이지의 다음은 없다(-1)",
		챕터.다음_번호(번호들[번호들.size() - 1]) == -1)

	# 챕터 경계가 정확히 한 번 이상 있어야 "챕터 전환"을 시험할 수 있다
	var 경계 := 0
	for i in range(번호들.size() - 1):
		if 챕터.챕터_바뀌나(번호들[i], 번호들[i + 1]):
			경계 += 1
	확인("★챕터가 바뀌는 지점이 있다", 경계 >= 1, "%d곳" % 경계)

	# 경로 ↔ 번호 왕복
	확인("경로에서 번호를 되찾는다", 챕터.경로에서_번호(챕터.씬경로(3)) == 3)
	확인("스마트월드 씬이 아니면 -1", 챕터.경로에서_번호("res://scenes/lobby/lobby.tscn") == -1)

	# 팔레트가 챕터마다 실제로 다른가 (같으면 "배경이 바뀐다"가 거짓말이 된다)
	var 팔1 := 챕터.팔레트(1)
	var 팔2 := 챕터.팔레트(2)
	확인("★챕터 1과 2의 하늘색이 다르다", 팔1["하늘_위"] != 팔2["하늘_위"])
	확인("★챕터 1과 2의 BGM 기음이 다르다", 팔1["기음"] != 팔2["기음"],
		"%.1fHz vs %.1fHz" % [팔1["기음"], 팔2["기음"]])


# ── [2] 실제 씬의 통로가 표를 따르는가 ──────────────────────────────────────
func _통로연결_검사() -> void:
	print("\n[2] 통로 연결 (실제 씬)")
	for s in 챕터.스테이지표:
		var 번호 := int(s["번호"])
		var 경로 := 챕터.씬경로(번호)
		if not ResourceLoader.exists(경로):
			continue
		var 씬: Node = (load(경로) as PackedScene).instantiate()
		root.add_child(씬)
		await process_frame

		var 입구: Node = null
		var 출구: Node = null
		for t in _통로들(씬):
			if int(t.get("역할")) == 연결통로.역할_.입구:
				입구 = t
			else:
				출구 = t

		확인("스마트월드_%d 에 입구 통로가 있다" % 번호, 입구 != null)
		확인("스마트월드_%d 에 출구 통로가 있다" % 번호, 출구 != null)
		if 출구:
			var 기대 := 챕터.다음_번호(번호)
			if 기대 < 0:
				기대 = int(챕터.스테이지표[0]["번호"])    # 마지막은 처음으로 순환
			var 실제 := 챕터.경로에서_번호(String(출구.get("다음_씬")))
			확인("스마트월드_%d 출구 → %d 번" % [번호, 기대], 실제 == 기대,
				"실제 %d 번" % 실제)
		씬.free()
		await process_frame


func _통로들(n: Node) -> Array:
	var out: Array = []
	for c in n.get_children():
		if c is 연결통로:
			out.append(c)
		out.append_array(_통로들(c))
	return out


# ── [3] 전환 연출 값 ────────────────────────────────────────────────────────
func _연출값_검사() -> void:
	print("\n[3] 전환 연출 — 챕터 전환은 스테이지 전환보다 '무거워야' 한다")
	확인("챕터 암전이 더 길다", 장면전환.챕터_암전시간 > 장면전환.암전시간)
	확인("★챕터 정적(무음)이 훨씬 길다",
		장면전환.챕터_암흑유지 >= 장면전환.암흑유지 * 2.0,
		"%.2fs vs %.2fs" % [장면전환.챕터_암흑유지, 장면전환.암흑유지])
	확인("챕터 점등이 더 길다", 장면전환.챕터_점등시간 > 장면전환.점등시간)
	# 점등이 암전보다 길어야 "눈이 적응한다"로 읽힌다 (2026-08-06 에 정한 원칙)
	확인("점등 > 암전 (눈이 적응하는 감각)", 장면전환.점등시간 > 장면전환.암전시간)
	확인("챕터도 점등 > 암전", 장면전환.챕터_점등시간 > 장면전환.챕터_암전시간)
	확인("★챕터 페이드는 흰색이다", 장면전환.챕터_페이드색.r > 0.8)
	# ★[2026-08-17 수정] 예전 기준은 "들어갈 때 <1" 이었다. **틀린 기준이었다.**
	#   Godot 4 의 zoom 은 클수록 확대(줌 인)다(Godot 3 과 반대).
	#   그래서 이 테스트는 "통로에 들어갈 때 줌 인" 이라는 기획 의도와 정반대인 코드를
	#   계속 통과시켜 왔다. 테스트가 코드와 같은 오해를 공유하면 아무것도 못 잡는다.
	확인("들어갈 때는 줌 인 = 확대(>1)", 장면전환.들어갈때_줌 > 1.0,
		"%.2f" % 장면전환.들어갈때_줌)
	확인("나올 때는 조인 상태에서 시작(>1) → 풀리며 전경이 펼쳐진다",
		장면전환.나올때_줌 > 1.0, "%.2f" % 장면전환.나올때_줌)
	# 들어갈 때보다 나올 때가 더 크다 = 다음 스테이지의 "짜잔" 이 더 커야 한다
	확인("나올 때가 들어갈 때보다 크다", 장면전환.나올때_줌 > 장면전환.들어갈때_줌)


# ── [4] 조준선이 실탄과 같은 길을 그리는가 ★핵심 ────────────────────────────
func _조준선_검사() -> void:
	print("\n[4] 조준 궤적 vs 실탄")
	var 월드 := Node2D.new()
	월드.name = "사격장"
	root.add_child(월드)

	var 코어 := Node.new()
	코어.set_script(코어_S)
	코어.add_to_group("페인트코어")
	월드.add_child(코어)

	var p := 플레이어_씬.instantiate()
	p.global_position = Vector2(0, 0)
	월드.add_child(p)

	var 총: 페인트총 = 총_S.new()
	월드.add_child(총)
	총.연결(p, 코어)
	await physics_frame

	# 궤적 계산 — 마우스를 못 움직이므로 발사 속도를 직접 넣어 같은 식으로 굴린다
	var 시작: Vector2 = 총.call("_발사_원점")
	var 속도 := Vector2(1, -1).normalized() * 총.탄속

	# ① 손으로 굴린 이론값 (총알.gd 의 적분과 완전히 같은 순서)
	var 이론 := PackedVector2Array()
	var 위치 := 시작
	var v := 속도
	for _i in 60:
		v.y += 총알_S.중력 * (1.0 / 60.0)
		위치 += v * (1.0 / 60.0)
		이론.append(위치)

	# ② 실제 총알을 쏴서 궤적을 기록
	var 총알 := Area2D.new()
	총알.set_script(총알_S)
	월드.add_child(총알)
	총알.call("시작", 시작, 속도, 총.탄속, ColorDefs.BLACK, 코어)
	var 실측 := PackedVector2Array()
	for _i in 60:
		await physics_frame
		if not is_instance_valid(총알):
			break
		실측.append(총알.global_position)

	확인("총알이 60 프레임 살아 있다", 실측.size() >= 55, "%d 프레임" % 실측.size())
	var 최대오차 := 0.0
	for i in mini(실측.size(), 이론.size()):
		최대오차 = maxf(최대오차, 실측[i].distance_to(이론[i]))
	확인("★조준선 공식과 실탄 경로가 일치한다", 최대오차 < 1.0,
		"최대 오차 %.3f px" % 최대오차)

	# 조준선이 쓰는 상수가 총알과 같은 값인지 (한쪽만 바꾸면 조준선이 거짓말을 한다)
	확인("궤적 중력 = 총알 중력", 총.궤적_중력 == 총알_S.중력)
	확인("궤적 충돌 레이어 = 총알 충돌 레이어",
		총.궤적_단단한레이어 == 총알_S.단단한_레이어)
	확인("궤적 최대 수명 = 총알 수명", 총.궤적_최대수명 == 총알_S.최대_수명)

	월드.free()
	await process_frame


# ── [5] 벨레 덩굴 ───────────────────────────────────────────────────────────
func _덩굴_검사() -> void:
	print("\n[5] 벨레 덩굴")
	var 월드 := Node2D.new()
	root.add_child(월드)
	var p := 플레이어_씬.instantiate()
	p.add_to_group("player")
	p.global_position = Vector2(5000, 0)        # 처음에는 아주 멀리
	월드.add_child(p)
	# ★플레이어의 물리를 끈다. 안 끄면 중력으로 계속 떨어져서 몇 초 뒤에는
	#   덩굴에서 수만 px 떨어진다 → 덩굴이 "멀다"고 판단해 얼어붙고,
	#   감쇠 검사가 "진폭이 안 줄었다"는 엉뚱한 실패를 낸다(실제로 그렇게 속았다).
	p.set_physics_process(false)

	var v: 벨레덩굴 = 덩굴_S.new()
	v.position = Vector2(0, 0)
	v.마디수 = 12
	v.마디길이 = 24.0
	v.산들바람 = 0.0                              # 흔들림을 꺼야 결과가 결정적이다
	v.활성_거리 = 1200.0
	월드.add_child(v)
	await physics_frame

	확인("고정점이 원점에 붙어 있다", v.마디_위치(0) == Vector2.ZERO)
	var 처음끝 := v.끝_위치()
	확인("처음에는 아래로 곧게 늘어져 있다",
		absf(처음끝.x) < 0.01 and 처음끝.y > 200.0, "끝 %s" % 처음끝)

	# ── 멀면 쉰다 ──
	for _i in 5:
		await physics_frame
	확인("★플레이어가 멀면 물리를 쉰다", v.쉬는중())

	# ── 가까이 오면 깨어나고, 지나가면 밀린다 ──
	# ★실제 플레이 상황을 그대로 재현한다: 플레이어가 덩굴을 **가로질러 걸어간다.**
	#   (한 자리에 세워두고 검사하면 밀림이 미미해 무엇을 보는지 알 수 없다.
	#    레인월드식 반응의 핵심은 "지나가며 휩쓸고 간다" 이므로 그걸 재현해야 맞다)
	p.global_position = Vector2(-180.0, 150.0)
	await physics_frame
	확인("가까우면 다시 돈다", not v.쉬는중())
	var 최대밀림 := 0.0
	for i in 40:
		p.global_position = Vector2(-180.0 + float(i) * 9.0, 150.0)   # 오른쪽으로 걸어간다
		await physics_frame
		최대밀림 = maxf(최대밀림, absf(v.끝_위치().x))
	확인("★플레이어가 지나가며 덩굴을 휩쓸었다", 최대밀림 > 20.0,
		"끝이 최대 %.0fpx 밀림" % 최대밀림)

	# ── 길이 제약이 유지되는가 (벨레가 발산하지 않는지) ──
	var 최대마디 := 0.0
	for i in range(1, 12):
		최대마디 = maxf(최대마디, v.마디_위치(i - 1).distance_to(v.마디_위치(i)))
	확인("★마디가 늘어나 발산하지 않는다", 최대마디 < v.마디길이 * 1.6,
		"최대 마디 %.1fpx (기준 %.0f)" % [최대마디, v.마디길이])

	# ── 플레이어가 떠나면 흔들림이 잦아든다 ──
	# ⚠ "몇 초 뒤에 x 가 0 근처" 로 검사하면 안 된다. 길이 288px 짜리 진자의 주기는
	#   2π√(L/g) ≈ 3.6 초라, 1~2 초 뒤에는 **반대쪽으로 크게 가 있는 게 정상**이다.
	#   (처음엔 그렇게 검사했다가 멀쩡한 물리를 실패로 잡았다)
	#   → 진짜 봐야 할 것은 **진폭이 줄어드는가**(감쇠가 도는가)다.
	p.global_position = Vector2(600, 0)       # 상호작용 반경(52) 밖 · 활성 거리(1200) 안
	# ⚠ 정확히 활성_거리에 두면 안 된다 — 부동소수점에 따라 "쉬는중"이 되어 덩굴이 얼어붙는다
	var 앞진폭 := 0.0
	for _i in 120:
		await physics_frame
		앞진폭 = maxf(앞진폭, absf(v.끝_위치().x))
	var 뒷진폭 := 0.0
	for _i in 120:
		await physics_frame
		뒷진폭 = maxf(뒷진폭, absf(v.끝_위치().x))
	확인("★손을 떼면 흔들림이 잦아든다(감쇠)", 뒷진폭 < 앞진폭,
		"진폭 %.0f → %.0f px" % [앞진폭, 뒷진폭])

	월드.free()
	await process_frame


# ── [6] 장식 표면 감지 ──────────────────────────────────────────────────────
func _장식_검사() -> void:
	print("\n[6] 장식 표면 감지")
	var 월드 := Node2D.new()
	root.add_child(월드)
	var 재질 := 공통.재질_준비("기본")

	# 위/아래 두 층을 겹쳐 놓는다 — "천장 위" 와 "진짜 바닥"
	var 아래 := 공통.지형_노드("바닥", Vector2(0, 400),
		PackedVector2Array([Vector2(-400, 0), Vector2(400, 0),
			Vector2(400, 200), Vector2(-400, 200)]), 재질, false, false, 1, 8.0)
	월드.add_child(아래)
	var 위 := 공통.지형_노드("천장", Vector2(0, -200),
		PackedVector2Array([Vector2(-400, 0), Vector2(400, 0),
			Vector2(400, 120), Vector2(-400, 120)]), 재질, false, false, 1, 8.0)
	월드.add_child(위)
	await physics_frame
	await physics_frame

	var 공간 := 월드.get_viewport().world_2d.direct_space_state
	var 면들 := 배치_S.표면들_찾기(공간, 0.0, -900.0, 1200.0)
	확인("★한 x 에서 층을 전부 찾는다 (천장 위 + 바닥)", 면들.size() >= 2,
		"%d 층" % 면들.size())
	if 면들.size() >= 2:
		확인("맨 아래가 진짜 바닥이다",
			absf(면들[면들.size() - 1]["위치"].y - 400.0) < 20.0,
			"y %.0f" % 면들[면들.size() - 1]["위치"].y)

	var 천장 := 배치_S.천장_찾기(공간, 0.0, 400.0)
	확인("★바닥에서 위를 보면 천장 아랫면이 잡힌다", not 천장.is_empty())
	if not 천장.is_empty():
		확인("천장 법선이 아래를 향한다", 천장["법선"].y > 0.5,
			"법선 %s" % 천장["법선"])

	월드.free()
	await process_frame
