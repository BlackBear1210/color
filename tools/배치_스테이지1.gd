extends SceneTree
## ============================================================================
## [2026-08-07 도형] stage_1-1, 1-2 자동 배치기
##   · 신우님이 찍어 둔 **라벨 자리에 장애물 씬을 꽂고**
##   · 1-1 ↔ 1-2 **구역 카메라(바인식 전환)** 를 심는다
## ----------------------------------------------------------------------------
## 실행:
##   Godot --headless --path . -s res://tools/배치_스테이지1.gd
##   → scenes/world_1/stage_1-1, 1-2.tscn 을 **제자리에서 갱신**한다
##
## ▣ 왜 스크립트로 하나 (손으로 안 하고)
##   1. 라벨이 12 개인데 앞으로 더 늘어난다. 손으로 옮기면 그때마다 다시 해야 한다.
##   2. 씬이 940KB 라 에디터로 열어 편집하면 diff 가 통째로 뒤집혀 머지가 지옥이 된다.
##   3. **여러 번 돌려도 결과가 같아야 한다**(멱등). 이미 배치된 장애물은 지우고 다시 넣는다.
##
## ▣ 라벨 → 장애물 대응표
##   신우님이 `Label.text` 에 한글로 적어 둔 이름을 그대로 읽는다.
##   새 장애물을 쓰고 싶으면 씬에 라벨을 하나 더 찍고 아래 표에 한 줄 추가하면 된다.
##
## ▣ 라벨은 지우지 않는다
##   `visible = false` 로 숨기기만 한다. 디자이너가 "여기 뭘 두려 했는지" 를
##   나중에도 볼 수 있어야 하고, 지워버리면 이 스크립트를 다시 돌릴 수 없다.
##
## ▣ 구역 카메라 (도형님 요청: "stage_1-1에서 1-2로 넘어갈 때 카메라 넣어주셈")
##   타일맵을 실제로 훑어 1-1 / 1-2 의 경계를 찾고, 구역 2 개를 만든다.
##   전환은 시간이 아니라 **플레이어 x** 로 굴러간다 → `카메라_연출.gd` 주석 참고.
## ============================================================================

const 씬경로 := "res://scenes/world_1/stage_1-1, 1-2.tscn"
const 장애물폴더 := "res://scenes/스마트월드_장애물/"
const 연출_스크립트 := preload("res://scripts/proto/카메라_연출.gd")

## 배치된 장애물을 담을 부모 노드 이름. 다시 돌릴 때 통째로 지우고 새로 만든다.
const 컨테이너 := "장애물"
## 카메라 연출 노드 이름
const 연출노드 := "카메라연출"

## 라벨 텍스트 → [장애물 씬 파일, 라벨 기준점에서의 보정(px)]
##   보정: 라벨은 글자 왼쪽 위 모서리 좌표다. 장애물은 **발밑 중앙**이 원점이라
##   그대로 놓으면 공중에 뜨거나 왼쪽으로 치우친다. 그래서 아래로/오른쪽으로 민다.
const 대응표 := {
	"식물 A": ["식물A.tscn", Vector2(40, 96)],
	"식물A": ["식물A.tscn", Vector2(40, 96)],
	"식물 B": ["식물B.tscn", Vector2(60, 120)],
	"식물B": ["식물B.tscn", Vector2(60, 120)],
	"도약대": ["도약대.tscn", Vector2(40, 96)],
	"무너지는바위": ["무너지는바위.tscn", Vector2(40, 60)],
	"색레이저": ["색레이저.tscn", Vector2(20, 20)],
	"물저장고": ["물저장고.tscn", Vector2(60, 60)],
	"호퍼": ["호퍼.tscn", Vector2(40, 60)],
	"송풍기": ["송풍기.tscn", Vector2(40, 60)],
	"통과플랫폼": ["통과플랫폼.tscn", Vector2(60, 40)],
	"배관": ["배관.tscn", Vector2(40, 40)],
	"제어레버": ["제어레버.tscn", Vector2(20, 60)],
	"발광체": ["발광체.tscn", Vector2(20, 20)],
	"유체": ["유체.tscn", Vector2(20, 20)],
}

var _루트: Node = null
var _심음 := 0
var _못찾음: Array[String] = []


func _init() -> void:
	Engine.max_fps = 60
	if not ResourceLoader.exists(씬경로):
		push_error("씬이 없다: %s" % 씬경로)
		quit(2)
		return
	_루트 = (load(씬경로) as PackedScene).instantiate()

	_장애물_배치()
	_카메라구역_설치()
	_저장()
	quit(0)


# ============================================================================
# 1. 라벨 자리에 장애물 심기
# ============================================================================
func _장애물_배치() -> void:
	# ── 멱등성 ── 이전에 심어 둔 것은 통째로 지우고 다시 만든다.
	#   안 그러면 스크립트를 두 번 돌릴 때마다 장애물이 두 배로 늘어난다.
	var 옛것 := _루트.get_node_or_null(NodePath(컨테이너))
	if 옛것:
		_루트.remove_child(옛것)
		옛것.queue_free()

	var 통 := Node2D.new()
	통.name = 컨테이너
	_루트.add_child(통)
	통.owner = _루트

	for 라벨 in _라벨_모으기(_루트):
		var 글자 := 라벨.text.strip_edges()
		if not 대응표.has(글자):
			if not _못찾음.has(글자):
				_못찾음.append(글자)
			continue
		var 정보: Array = 대응표[글자]
		var 경로: String = 장애물폴더 + String(정보[0])
		if not ResourceLoader.exists(경로):
			push_warning("장애물 씬 없음: %s" % 경로)
			continue

		var 노드: Node2D = (load(경로) as PackedScene).instantiate()
		# 라벨은 Control 이라 position 이 곧 좌상단. 거기에 보정을 더해 발밑 중앙으로.
		노드.position = 라벨.position + (정보[1] as Vector2)
		# 이름에 원래 라벨 이름을 남긴다 — 나중에 "이건 어느 라벨이었지?" 를 알 수 있게
		노드.name = "%s_%s" % [String(정보[0]).get_basename(), 라벨.name]
		통.add_child(노드)
		# ★인스턴스 **루트에만** owner 를 준다. 안쪽 자식(그림 슬롯 등)에 주면
		#   PackedScene 이 그것들을 원본과 별개로 한 벌 더 저장해 노드가 두 벌이 되고,
		#   씬 교체 때 해제된 짝을 참조해 엔진이 세그폴트로 죽는다.
		#   (2026-08-02 Gun2 사고 / 2026-08-07 통로 전환 크래시 — 같은 원인)
		노드.owner = _루트
		_심음 += 1

		# ── 라벨은 지우지 않고 숨긴다 ──
		# 디자이너의 의도 기록이라 남겨야 하고, 지우면 이 스크립트를 다시 못 돌린다.
		라벨.visible = false
		라벨.modulate = Color(1, 1, 1, 0.35)

	print("[배치] 장애물 %d 개 심음" % _심음)
	if not _못찾음.is_empty():
		print("  ⚠ 대응표에 없는 라벨(무시함): %s" % ", ".join(_못찾음))
		print("    → tools/배치_스테이지1.gd 의 `대응표` 에 한 줄 추가하면 자동으로 배치된다")


func _라벨_모으기(노드: Node) -> Array[Label]:
	var 결과: Array[Label] = []
	for c in 노드.get_children():
		if c is Label:
			결과.append(c)
		결과.append_array(_라벨_모으기(c))
	return 결과


# ============================================================================
# 2. 구역 카메라 (바인식 전환)
# ============================================================================
## 타일맵을 실제로 훑어 지형이 놓인 범위를 재고, 1-1 / 1-2 두 구역으로 나눈다.
##
## 왜 좌표를 손으로 안 적나: 신우님이 맵을 더 늘리면 그때마다 숫자를 고쳐야 한다.
## 타일에서 재면 **맵이 바뀌어도 이 스크립트만 다시 돌리면 맞는다.**
func _카메라구역_설치() -> void:
	var 옛것 := _루트.get_node_or_null(NodePath(연출노드))
	if 옛것:
		_루트.remove_child(옛것)
		옛것.queue_free()

	var 맵 := _타일맵_찾기(_루트)
	if 맵 == null:
		push_warning("TileMapLayer 를 못 찾아 카메라 구역을 건너뛴다")
		return

	var 쓰인칸 := 맵.get_used_rect()
	var 칸 := 맵.tile_set.tile_size if 맵.tile_set else Vector2i(16, 16)
	var 좌: float = float(쓰인칸.position.x * 칸.x)
	var 우: float = float(쓰인칸.end.x * 칸.x)
	var 위: float = float(쓰인칸.position.y * 칸.y)
	var 아래: float = float(쓰인칸.end.y * 칸.y)

	# ── 1-1 / 1-2 경계 ──
	# 원래 stage_1-1.tscn 은 786칸(=12,576px)까지였다. 신우님이 그 오른쪽에 1-2 를 붙였다.
	# 그래서 경계는 12,576px 근처다. 다만 맵이 더 늘어날 수 있으므로
	# **"원래 1-1 폭" 을 상수로 두되, 실제 맵이 그보다 짧으면 절반으로 나눈다.**
	const 원래_1_1_끝 := 12576.0
	var 경계: float = 원래_1_1_끝
	if 우 <= 원래_1_1_끝 + 1000.0:
		경계 = (좌 + 우) * 0.5

	var 여백 := 96.0
	var 세로위 := 위 - 여백
	var 세로아래 := 아래 + 여백

	var 연출: 카메라연출 = 연출_스크립트.new()
	연출.name = 연출노드
	_루트.add_child(연출)
	연출.owner = _루트

	# ── 구역 1-1 ── 좁고 아기자기한 앞부분. 조금 당겨서(줌 큼) 아늑하게.
	var z1 := 연출.구역_추가(
		Rect2(좌 - 여백, 세로위, (경계 - 좌) + 여백 * 2.0, 세로아래 - 세로위),
		0.72,                       # 스테이지 기본(0.70)보다 아주 살짝 당김
		Vector2(0, -20),            # 시선을 조금 위로 — 머리 위 공간 확보
		1400.0,                     # 전환폭: 이 거리를 걷는 동안 화면이 바뀐다
		"구역_1-1")
	z1.전환_숨 = 0.07               # 전환 한가운데서 7% 물러난다

	# ── 구역 1-2 ── 뒷부분은 더 크고 높다. 줌아웃해서 스케일을 보여준다.
	var z2 := 연출.구역_추가(
		Rect2(경계 - 여백, 세로위, (우 - 경계) + 여백 * 2.0, 세로아래 - 세로위),
		0.62,                       # 더 넓게 — "큰 공간에 들어왔다"
		Vector2(0, -40),            # 위를 더 보여준다
		1400.0,
		"구역_1-2")
	z2.전환_숨 = 0.07

	# ★★[2026-08-07 함정] 구역 노드에 owner 를 안 주면 **씬 파일에 저장되지 않는다.**
	#   `구역_추가()` 는 add_child 만 하므로, 여기서 owner 를 박아야 한다.
	#   안 그러면 저장된 씬에는 `카메라연출` 껍데기만 남고 구역이 0 개가 되어
	#   카메라가 아무 일도 안 한다("카메라 연출 연결됨 — 구역 0 개" 로 실제로 겪음).
	for z in 연출.get_children():
		z.owner = _루트

	print("[배치] 카메라 구역 %d 개 — 1-1 x %.0f~%.0f / 1-2 x %.0f~%.0f (세로 %.0f~%.0f)"
		% [연출.get_child_count(), 좌, 경계, 경계, 우, 세로위, 세로아래])


func _타일맵_찾기(노드: Node) -> TileMapLayer:
	for c in 노드.get_children():
		if c is TileMapLayer:
			return c
		var r := _타일맵_찾기(c)
		if r:
			return r
	return null


# ============================================================================
# 3. 저장
# ============================================================================
func _저장() -> void:
	var 팩 := PackedScene.new()
	var err := 팩.pack(_루트)
	if err != OK:
		push_error("pack 실패: %s" % error_string(err))
		return
	err = ResourceSaver.save(팩, 씬경로)
	print("[배치] %s → %s" % [error_string(err), 씬경로])
