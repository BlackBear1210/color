extends SceneTree
## ============================================================================
## [2026-08-07 도형] 스마트월드 1 ↔ 2 통로 연결기
## ----------------------------------------------------------------------------
## 실행:
##   Godot --headless --path . -s res://tools/스마트월드_연결.gd
##   → scenes/스마트월드/스마트월드_1.tscn   (원본: 스마트월드_테스트.tscn)
##     scenes/스마트월드/스마트월드_2.tscn   (원본: 스마트월드_1-2.tscn)
##
## ▣ 왜 "생성"이 아니라 "연결"인가 (중요)
##   도형님 지시: **"기존의 스마트월드 테스트를 스마트월드1 이라고 하면
##   어제 작업한걸 스마트월드2로 해주고 서로 이어지는 느낌으로 만들어줘."**
##
##   `스마트월드_테스트.tscn` 은 신우님이 에디터에서 직접 손본 씬이다
##   (바닥_1~3 의 `칠하기_허용` 을 false→true 로 바꿔 놨다).
##   `build_스마트월드_1-1.gd` 로 다시 뽑으면 **그 손작업이 통째로 날아간다.**
##   그래서 이 스크립트는 **원본을 읽어 통로만 얹고 다른 이름으로 저장**한다.
##   → 신우님 편집 100% 보존. 원본 파일도 그대로 남는다.
##
## ▣ 지면 높이를 어떻게 아나 — 좌표를 손으로 안 적는다
##   씬을 진짜로 띄우고 **아래로 레이캐스트를 쏴서** 지면 y 를 잰다.
##   지형이 SS2D 곡선이라 수식으로 계산할 수 없고, 손으로 적으면
##   지형을 조금만 다듬어도 통로가 공중에 뜨거나 땅에 파묻힌다.
##
## ▣ 연결 방향
##   스마트월드_1 [출구통로] ──걸어서──▶ [입구통로] 스마트월드_2
##   스마트월드_2 [출구통로] ──걸어서──▶ [입구통로] 스마트월드_1   (지금은 순환)
##   3 편이 생기면 스마트월드_2 의 `다음_씬` 한 줄만 바꾸면 된다.
##
## ▣ 화면 연출 (도형님 요청)
##   "통로 씬을 거치면 다음 스테이지가 시작될때 플레이어가 화면이 점점 밝아지며
##    다음 스테이지가 보이는게 좋을거같아. 난 이게임에 포탈로 이동하는게 싫어."
##   → `장면전환.gd` 가 담당한다. 암전 0.85초 → 씬 교체 → **점등 1.35초**.
##     점등이 암전보다 긴 이유: 나올 때가 느려야 "눈이 적응한다" 로 읽힌다.
##   → 출구 통로의 `속빛` 을 **다음 지역 하늘색**으로 맞춰서, 통로 저 끝에서
##     그 색 빛이 새어나온다. 지나기 전에 이미 다음 지역이 보인다(바인식 배경 연결).
## ============================================================================

const 원본_1 := "res://scenes/스마트월드/스마트월드_테스트.tscn"
const 원본_2 := "res://scenes/스마트월드/스마트월드_1-2.tscn"
const 결과_1 := "res://scenes/스마트월드/스마트월드_1.tscn"
const 결과_2 := "res://scenes/스마트월드/스마트월드_2.tscn"

const 통로_S := preload("res://scripts/스마트월드/연결통로.gd")

## 각 지역 하늘색 (stage_backdrop.gd 의 바이옴 팔레트와 같은 값)
const 하늘_자연 := Color(0.36, 0.36, 0.34)
const 하늘_물가 := Color(0.31, 0.32, 0.34)
const 하늘_판자촌 := Color(0.27, 0.27, 0.28)

var _n := 0
var _단계 := 0
var _루트: Node = null
var _성공 := 0


func _init() -> void:
	Engine.max_fps = 60
	process_frame.connect(_tick)


func _tick() -> void:
	_n += 1
	match _단계:
		0:
			if _n == 1:
				if not _열기(원본_1):
					quit(2); return
			elif _n == 5:
				# ── 스마트월드 1 ── 자연→물가. 오른쪽 출구가 2 편으로 이어진다.
				_루트.name = "스마트월드_1"
				_루트.set("스테이지_이름", "스마트월드 1 · 숲에서 물가로")
				_월드값_보정(1900.0)
				_통로_달기("입구통로", 연결통로.역할_.입구, -150.0, 하늘_자연, "", "")
				_통로_달기("출구통로", 연결통로.역할_.출구, 4380.0, 하늘_물가,
					결과_2, "입구통로")
				_저장(결과_1)
				_다음단계()
		1:
			if _n == 1:
				if not _열기(원본_2):
					quit(2); return
			elif _n == 5:
				# ── 스마트월드 2 ── 물가→판자촌. 출구는 지금 1 편으로 되돌아간다.
				_루트.name = "스마트월드_2"
				_루트.set("스테이지_이름", "스마트월드 2 · 폐수로")
				_월드값_보정(3200.0)
				# 2 편은 우리가 만든 씬이라 통로가 이미 있다 → 목적지만 고쳐 끼운다.
				_통로_달기("입구통로", 연결통로.역할_.입구, 0.0, 하늘_물가, "", "")
				_통로_달기("출구통로", 연결통로.역할_.출구, 9200.0, 하늘_판자촌,
					결과_1, "입구통로")
				_저장(결과_2)
				_다음단계()
		2:
			print("[스마트월드_연결] 완료 — %d / 2" % _성공)
			quit(0 if _성공 == 2 else 1)


func _다음단계() -> void:
	if _루트:
		_루트.queue_free()
		_루트 = null
	_단계 += 1
	_n = 0


func _열기(경로: String) -> bool:
	if not ResourceLoader.exists(경로):
		push_error("원본 씬이 없다: %s" % 경로)
		return false
	_루트 = (load(경로) as PackedScene).instantiate()
	root.add_child(_루트)
	return true


# ============================================================================
# 월드 설정값 — 낙하 사망 규칙을 두 스테이지에 똑같이 건다
# ============================================================================
## ★[2026-08-07] `스마트월드_테스트.tscn` 은 낙하 사망이 생기기 전에 만들어진 씬이라
##   `치명_낙하거리` 같은 새 export 가 씬 파일에 저장돼 있지 않다.
##   (씬에 없으면 스크립트 기본값이 쓰이는데, 그 값이 스테이지에 맞으리란 보장이 없다)
##   → 여기서 명시적으로 박아 둔다. 두 스테이지의 조작·사망 규칙이 같아야 한다.
func _월드값_보정(낙사y: float) -> void:
	_루트.set("낙사_y", 낙사y)
	_루트.set("치명_낙하거리", 520.0)      # 점프 높이 160px × 3.25
	_루트.set("낙하_경고표시", true)
	_루트.set("안전지점_자동저장", true)
	_루트.set("안전지점_유예", 0.45)

	# ★카메라 리밋을 통로 안쪽까지 넓힌다.
	#   통로는 지형 밖으로 460px 파고들고, 플레이어는 그 안쪽 62% 지점에서 스폰된다.
	#   리밋을 안 넓히면 카메라가 지형 경계에 붙어 **통로에서 나오는 장면이 안 보인다**
	#   (플레이어만 화면 밖에서 걸어 들어오는 이상한 그림이 된다).
	var 리밋: Rect2 = _루트.get("카메라_리밋")
	if 리밋.size.length() > 1.0:
		var 여유 := 700.0
		_루트.set("카메라_리밋", Rect2(
			리밋.position - Vector2(여유, 100.0),
			리밋.size + Vector2(여유 * 2.0, 200.0)))


# ============================================================================
# 통로 달기
# ============================================================================
## x 위치에 통로를 놓는다. 지면 높이는 **레이캐스트로 실측**한다.
##   역할  : 입구(왼쪽에서 뻗어옴) / 출구(오른쪽으로 파고듦)
##   속빛  : 통로 저 끝에서 새어나오는 빛 = 이어지는 지역의 하늘색
func _통로_달기(이름: String, 역할: int, x: float, 속빛: Color,
		다음씬: String, 진입점: String) -> void:
	# 이미 같은 이름의 통로가 있으면 지우고 새로 단다 (여러 번 돌려도 결과가 같게)
	var 옛것 := _찾기(_루트, 이름)
	if 옛것:
		옛것.get_parent().remove_child(옛것)
		옛것.queue_free()

	var 지면y := _지면_재기(x)
	if is_inf(지면y):
		push_warning("%s: x=%.0f 에서 지면을 못 찾음 — 건너뜀" % [이름, x])
		return

	var 통로: 연결통로 = 통로_S.new()
	통로.name = 이름
	통로.역할 = 역할
	통로.position = Vector2(x, 지면y)
	통로.높이 = 170.0
	통로.깊이 = 460.0
	통로.속빛 = 속빛
	# 통로를 감싼 암반을 위아래로 크게 그려 "지형에서 파낸 굴" 로 보이게 한다.
	# (그림만 커진다 — 콜리전은 두께 90px 그대로)
	통로.암반_위 = 340.0
	통로.암반_아래 = 420.0
	if 역할 == 연결통로.역할_.출구:
		통로.다음_씬 = 다음씬
		통로.다음_진입점 = 진입점

	# 오브젝트 층이 있으면 거기에, 없으면 루트 바로 밑에
	var 부모: Node = _루트.get_node_or_null("오브젝트")
	if 부모 == null:
		부모 = _루트
	부모.add_child(통로)
	통로.owner = _루트
	# 통로가 런타임에 만드는 바닥/천장/뒷벽은 씬에 저장하지 않는다
	# (`_ready()` 에서 매번 새로 만든다 — 씬 파일이 쓸데없이 커지지 않는다)

	print("  · %s  x=%.0f  지면y=%.0f  %s"
		% [이름, x, 지면y, ("→ " + 다음씬.get_file()) if not 다음씬.is_empty() else ""])


## x 위치의 지면 y 를 레이캐스트로 잰다. 못 찾으면 INF.
## 위에서 아래로 한 발 쏴서 처음 맞는 지형의 y 를 쓴다.
func _지면_재기(x: float) -> float:
	var 공간 := _루트.get_viewport().world_2d.direct_space_state
	# 천장 매스에 맞지 않도록 충분히 위(-2000)에서 시작하되,
	# 천장이 있는 스테이지도 있으므로 **여러 층을 훑어 가장 아래 지면**을 고른다.
	var y := -2000.0
	var 마지막 := INF
	var 안전 := 0
	while y < 4000.0 and 안전 < 40:
		안전 += 1
		var q := PhysicsRayQueryParameters2D.create(
			Vector2(x, y), Vector2(x, 4000.0), 1)
		var r := 공간.intersect_ray(q)
		if r.is_empty():
			break
		var hit: float = r["position"].y
		마지막 = hit
		# 맞은 물체 아래로 빠져나가 다음 층을 본다
		y = hit + 4.0
		var 속안전 := 0
		while 속안전 < 600 and _속인가(공간, x, y):
			y += 8.0
			속안전 += 1
		y += 2.0
	return 마지막


func _속인가(공간: PhysicsDirectSpaceState2D, x: float, y: float) -> bool:
	var q := PhysicsPointQueryParameters2D.new()
	q.position = Vector2(x, y)
	q.collide_with_areas = false
	q.collide_with_bodies = true
	q.collision_mask = 1
	return not 공간.intersect_point(q, 1).is_empty()


func _찾기(노드: Node, 이름: String) -> Node:
	for c in 노드.get_children():
		if c.name == 이름:
			return c
		var r := _찾기(c, 이름)
		if r:
			return r
	return null


# ============================================================================
func _저장(경로: String) -> void:
	# ★owner 는 손대지 않는다 — 아래 _주인_지정 주석 참고
	var 팩 := PackedScene.new()
	var err := 팩.pack(_루트)
	if err != OK:
		push_error("pack 실패: %s" % error_string(err))
		return
	err = ResourceSaver.save(팩, 경로)
	if err == OK:
		_성공 += 1
	print("[스마트월드_연결] %s → %s" % [error_string(err), 경로])


## ★★[2026-08-07 · 씬을 죽이던 버그. 반드시 읽을 것]
##
## 예전에는 저장 전에 `_주인_지정(루트, 루트)` 로 **트리 전체에 owner 를 박았다.**
## 코드로 처음부터 만드는 씬(build_*.gd)에서는 그게 맞다 — 그래야 저장된다.
##
## 그런데 **이미 있는 씬을 읽어서 손보는 도구**(이 파일 같은)에서는 완전히 틀렸다:
##   · PackedScene 에서 불러온 노드는 **이미 owner 가 올바르게 박혀 있다.** 건드릴 필요 없다.
##   · 스마트월드 오브젝트(호퍼·유체·통과플랫폼·송풍기…)는 `_ready()` 에서
##     판정·모양 노드를 **런타임에** 만든다. 얘들은 owner 가 없어야 정상이다.
##     여기에 owner 를 박으면 **씬 파일에 한 벌 더 저장**되고, 다음에 불러올 때
##     `_ready()` 가 또 만들어 **노드가 두 벌**이 된다.
##   · 그 상태로 씬을 교체하면 이미 해제된 짝을 참조해
##     **엔진이 signal 11(세그폴트)로 죽었다.** (통로를 지날 때 실제로 죽었다)
##
## → 규칙: **우리가 새로 만든 노드에만** owner 를 준다. 나머지는 손대지 않는다.
##   (2026-08-02 의 Gun2/Placeholder2 사고와 같은 계열 — 같은 실수를 다시 했다)
func _주인_지정(_노드: Node, _루트인자: Node) -> void:
	pass    # 의도적으로 아무것도 하지 않는다 (위 주석 참고)
