func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


## 도면 칸 → 월드 (위여백 6 칸)
func kx(g: float) -> float: return g * 32.0 + 16.0
func ky(g: float) -> float: return (g + 위여백) * 32.0 + 32.0


func _실행() -> void:
	print("\n=== STAGE 2-8 · 두 갈래 탑 v3 (uvtt 도면 188×114 · 한 칸 32px) ===")
	var f := FileAccess.open(도면, FileAccess.READ)
	if f == null:
		push_error("2-8: 도면 json 이 없다 — 먼저 `python tools/도면_2-8_지형추출.py` 를 돌릴 것")
		quit(1)
		return
	자료 = JSON.parse_string(f.get_as_text()) as Dictionary
	f.close()
	if 자료.is_empty():
		push_error("2-8: 도면 json 파싱 실패")
		quit(1)
		return

	b = 공.new()
	b.재질_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_black.tres")
	b.재질_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_white.tres")
	b.재질_선반_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_black.tres")
	b.재질_선반_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_white.tres")

	var 프레임 := _프레임()
	var 루트 := _짓기(프레임)
	var ok: bool = b.검산(프레임, _빈공간들())
	b.색비율_보고()
	if not ok or b.오류 > 0:
		push_error("2-8: 검산 실패 %d — 저장하지 않는다" % b.오류)
		quit(1)
		return
	_새_디자인_켜기(루트)
	if not b.저장(루트, 내씬):
		quit(1)
		return
	print("=== 끝 ===\n")
	quit(0)


func _프레임() -> Rect2:
	var a: Array = 자료["프레임"]
	return Rect2(float(a[0]), float(a[1]), float(a[2]), float(a[3]))


func _빈공간들() -> Array:
	var r: Array = []
	for v in 자료["빈공간"]:
		r.append(Rect2(float(v[0]), float(v[1]), float(v[2]), float(v[3])))
	return r


func _점들(a: Array) -> PackedVector2Array:
	var p := PackedVector2Array()
	for v in a:
		p.append(Vector2(float(v[0]), float(v[1])))
	return p


## [x0, y0, x1, y1] (월드) → Rect2
func _사각(a: Array) -> Rect2:
	return Rect2(float(a[0]), float(a[1]), float(a[2]) - float(a[0]), float(a[3]) - float(a[1]))


## ★[2026-10-09] Codex 새 디자인 — 하수도 지형·격자의 `챕터1_원근` 을 씬 전체에서 켠다(2-6·2-7 과 같다).
func _새_디자인_켜기(n: Node) -> void:
	if "챕터1_원근" in n:
		n.set("챕터1_원근", true)
	for c in n.get_children():
		_새_디자인_켜기(c)


## 지형 + 2-9 기준 명도 조율(2-3~2-7 `_땅` 과 같다).
func _땅(부모: Node, 이름: String, 점들: PackedVector2Array, 색: int, 역할: String = "플랫폼", 일방: bool = false) -> Node2D:
	var n: Node2D = b.지형(부모, 이름, 점들, 색, 역할, false, 0, 일방)
	if n != null:
		n.set("시안_명도조율", true)
		n.set("앞지형_깊이", true)
	return n


## 떨어지는 물(유체_흰물v2 + 힉스필드 삼색 프레임). ★스크립트를 먼저 바꾼다 — set_script 는 그 전에 넣은 값을 지운다.
func _물(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int, 켜짐: bool = true) -> Node2D:
	var f := (load(공.S_유체) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	f.name = 이름
	f.set_script(load(G_물))
	f.position = Vector2(x, 윗끝)
	f.set("종류", 0)
	f.set("색", 색)
	f.set("크기", Vector2(폭, 높이))
	f.set("켜짐", 켜짐)
	f.set("힉스필드_삼색프레임", true)
	부모.add_child(f)
	return f


## 정면 배관 출수구(Codex 10-09 새 디자인) — 물 윗끝에 원형 배관(폭 < 160) 또는 물받이(≥ 160)를 그린다.
func _출수구(부모: Node, 물: Node2D) -> Node2D:
	var o := Node2D.new()
	o.name = "출수_" + String(물.name)
	o.set_script(load(G_출수구))
	부모.add_child(o)
	o.set("대상_유체", o.get_path_to(물))
	return o


## 물기둥 하나 = 물 + 출수구. 도면 칸으로 받는다(x0~x1 · 윗끝~아래끝).
func _물기둥(부모: Node, 이름: String, x0: float, x1: float, 윗끝: float, 아래끝: float, 색: int, 켜짐: bool = true) -> Node2D:
	var w := _물(부모, 이름, kx((x0 + x1) * 0.5), ky(윗끝), (x1 - x0) * 32.0, ky(아래끝) - ky(윗끝), 색, 켜짐)
	_출수구(부모, w)
	return w


## 바닥 홈에 고인 웅덩이(2-2 `흰색물_웅덩이_1` 과 같은 짜임 · 웅덩이_하수도29). 원점 = 아랫변 가운데.
##   낙하_받아줌 — 색이 맞으면 높은 데서 떨어져도 안 죽는다(월드.gd `_낙하를_받아주나`).
func _웅덩이(부모: Node, 이름: String, x0: float, x1: float, 바닥: float, 색: int) -> Node2D:
	var w := (load(공.S_웅덩이) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	w.name = 이름
	w.set_script(load(G_웅덩이))
	w.position = Vector2(kx((x0 + x1) * 0.5), ky(바닥))
	w.set("크기", Vector2((x1 - x0) * 32.0, 32.0))
	w.set("색", 색)
	w.set("낙하_받아줌", true)
	w.set("받아주는_최소수심", 32.0)
	w.set("오른쪽_안쪽폭", 16.0)
	w.set("왼쪽_안쪽폭", 16.0)
	부모.add_child(w)
	return w


## 격자발판 — 일방통행 공중 발판 · 색 고정 · 물을 통과시킨다(2-4~2-7 `_격자` 와 같다).
func _격자(장: Node, 이름: String, r: Rect2, 색: int) -> Node2D:
	var g: Node2D = b.통과플랫폼(장, 이름, r.get_center().x, r.position.y, r.size.x, 1)
	g.set("고정색", 0 if 색 == 검 else 1)
	return g


## 움직이는 지형 — Node2D 그릇 + 그 안의 지형(그릇 기준 좌표). 버튼·열쇠가 그릇을 옮긴다(2-5~2-7 과 같은 짜임).
func _움직이는_땅(부모: Node, 이름: String, 자리: Vector2, 크기: Vector2, 색: int = 검) -> Node2D:
	var 그릇 := Node2D.new()
	그릇.name = 이름
	그릇.position = 자리
	그릇.z_index = -1
	부모.add_child(그릇)
	b.짧은변_허용.append(이름 + "_몸")
	_땅(그릇, 이름 + "_몸", 공.사각(0, 0, 크기.x, 크기.y), 색)
	b.지형표.pop_back()
	return 그릇


## 도약대(무색). 원점 = 바닥 가운데 · 밟는 면 = 바닥 − 23. 상승 ≈ 속도² / 2570(2-7 실측 · 점프 키를 누른 채).
func _도약대(부모: Node, 이름: String, x: float, 바닥: float, 폭: float, 속도: float) -> Node2D:
	var d := (load(S_도약대) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	d.name = 이름
	d.position = Vector2(x, 바닥)
	d.set("폭", 폭)
	d.set("도약속도", 속도)
	d.set("재질", 2)                      # 하수도 주철 판·코일·받침(Codex 10-10 새 디자인 — 2-2·2-7 과 같다)
	부모.add_child(d)
	return d


## 몬스터 — 도면 선(칸 x0~x1 · 바닥 y). 사격이면 사격몬스터.
func _몬스터(부모: Node, 이름: String, x0: float, x1: float, 바닥: float, 색: int, 시작x: float, 사격: bool = false, 위상: float = 0.0) -> Node2D:
	var 몹 := Area2D.new()
	몹.set_script(사격몬스터_S if 사격 else 몬스터_S)
	몹.name = 이름
	몹.position = Vector2(kx(시작x), ky(바닥))
	몹.set("색", 색)
	몹.set("왼끝", kx(x0) + 24.0)            # 판정 반폭(32)만큼 안쪽 — 도면 선 끝에서 몸이 바닥 밖으로 나가지 않게
	몹.set("오른끝", kx(x1) - 24.0)
	몹.set("속도", 140.0)
	if 사격:
		몹.set("위상", 위상)
	부모.add_child(몹)
	return 몹


## 외곽 — 왼벽·오른벽·천장만. ★바닥은 깔지 않는다: 도면 아래는 낙사(2-6·2-7 과 같다).
func _외곽_바닥없이(부모: Node, 프레임: Rect2, 두께: float = 1024.0) -> void:
	var L := 프레임.position.x
	var T := 프레임.position.y
	var R := 프레임.end.x
	var B := 프레임.end.y
	b.지형(부모, "외곽_왼벽", 공.사각(L - 두께, T, L, B + 두께), 검, "외곽")
	b.지형(부모, "외곽_오른벽", 공.사각(R, T, R + 두께, B + 두께), 검, "외곽")
	b.지형(부모, "외곽_천장", 공.사각(L - 두께, T - 두께, R + 두께, T), 검, "외곽")


func _짓기(프레임: Rect2) -> Node2D:
	var 입구 := Vector2(kx(59.5), ky(101))
	var 시작 := 입구 - Vector2(208.0, 0.0)          # 입구 통로 안(2-4~2-7 과 같은 거리)
	var 루트: Node2D = b.루트("stage_2-8", "2-8 · 두 갈래 탑", 프레임, 시작, 프레임.end.y + 160.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	var 배경 := (load(S_배경) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	배경.name = "하수도배경"
	루트.add_child(배경)
	루트.move_child(배경, 1)

	_외곽_바닥없이(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 지형 — 도면에서 뽑은 그대로 (0.5 칸 턱이 많아 전부 짧은변 허용)
	# ══════════════════════════════════════════════════════════════════════
	for 조각 in 자료["지형"]:
		var 이름: String = 이름표.get(조각["이름"], 조각["이름"])
		b.짧은변_허용.append(이름)
		_땅(지, 이름, _점들(조각["점"]), 검)
	for 조각 in 자료["흰지형"]:
		var 이름w: String = 이름표.get(조각["이름"], 조각["이름"])
		b.짧은변_허용.append(이름w)
		_땅(지, 이름w, _점들(조각["점"]), 흰)
	for 조각 in 자료["채움"]:
		var 이름c: String = "가장자리_" + String(조각["이름"])
		b.짧은변_허용.append(이름c)
		_땅(지, 이름c, _점들(조각["점"]), 검, "채움")

	# ── 격자발판 13 장(일방통행 · 색 고정 · 물을 통과시킨다) ──
	for g in 자료["격자"]:
		_격자(장, String(g["이름"]), _사각(g["사각"]), 검 if String(g["색"]) == "검" else 흰)

	# ── 투명 발판·지형 3 — 칠해야 밟힌다(한 발이면 전체칠). 왼쪽 갈래(흰) 1 · 오른쪽 갈래(검) 2 ──
	for t in 자료["투명"]:
		var tr: Rect2 = _사각(t["사각"])
		var 이름t := String(t["이름"])
		b.짧은변_허용.append(이름t)
		b.유령(지, 이름t, 공.사각(tr.position.x, tr.position.y, tr.end.x, tr.end.y), 검 if String(t["색"]) == "검" else 흰, 1)

	# ── 밟으면 부서지는 발판 6(흰) — 흰 몸으로 건넌다. 밑은 사격 몬스터 발판(흰) — 떨어지면 몬스터 곁(살아서 갇히지 않는다:
	#    몬스터 발판 왼끝(39.5)에서 흰 점프대 발판(30)까지 9.5 칸 = 점프 거리 안 · 다시 점프대로 오른다).
	var 붕괴 := load(붕괴스크립트)
	var i := 1
	for r in 자료["부서지는"]:
