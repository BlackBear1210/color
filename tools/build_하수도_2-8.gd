# ── 계단 (정지 지형) ────────────────────────────────────────────────────────
## ★★끼지 않는 계단의 조건은 딱 하나 — **단조롭게 오를 것.**
##   위로만 올라가는 계단에는 처마(overhang)가 없고, 처마가 없으면 낄 자리도 없다.
##   전에 낀 사다리는 좌우로 번갈아 놓아 **위 칸이 아래 칸의 처마가 됐다.**
##
## 한 칸 **112px 오르고 140px 나아간다**.
##   · ★오름 112 는 `레벨검사.gd` 가 쓰는 안전선(점프 높이 160 × 0.85 = **136**)보다 낮다.
##     140 으로 잡았다가 검사기가 "못 오른다" 고 잡았다 — 사람이 겨우 되는 높이는
##     레벨 디자인에서 쓰면 안 된다. 실수 한 번에 못 올라가는 계단이 된다.
##   · 디딤면 140 > 플레이어 폭 44 → 발 디딜 자리가 넉넉하다
##   · 위층 계단 밑을 지날 때 머리 위가 최소 **112px** 남는다(키 96 이 들어간다)
const 계단_단 := 112.0
const 계단_깊이 := 140.0
const 계단_칸 := 5            ## 한 층(560) = 112 × 5
const 계단_참 := 140.0        ## 층참(landing) 폭. 스위치백이 되려면 이만큼 남겨야 한다
const 선반_두께 := 60.0

# ── 승강기 (상하 움직이는 발판) ─────────────────────────────────────────────
const 승강기_폭 := 360.0      ## 샤프트 560 − 360 = 양옆 100px. 플레이어(44)가 그냥 통과한다
const 승강기_두께 := 40.0
const 승강기_왕복 := 12.0     ## 한 바퀴. 1,120px 을 6초에 오른다 = 187px/s
## 네 대를 엇갈리게 돌린다. 전부 같은 위상이면 갈래점마다 같은 박자가 되어 지루하다.
const 승강기_지연 := [0.0, 3.0, 6.0, 9.0]

# ── 통로 발판 (좌우 · 상하) ─────────────────────────────────────────────────
## [구간번호, 층(1·2·3), 방향(0=좌우 1=상하), 이동거리, 왕복시간, 시작지연, 이름]
## ⚠ 상하 발판은 **꼭대기에서도 천장까지 96px 이상** 남아야 한다.
##   안 그러면 발판이 플레이어를 천장에 밀어 넣는다 — 사다리와 똑같은 사고가 난다.
const 통로발판 := [
	[2, 1, 1, 260.0, 4.0, 0.0, "L1_승강_A"],
	[3, 2, 0, 300.0, 3.4, 0.0, "L2_좌우_B"],
	[6, 2, 1, 260.0, 4.6, 2.0, "L2_승강_C"],
	[7, 3, 0, 300.0, 3.0, 1.5, "L3_좌우_D"],
]
const 통로발판_폭 := 180.0
const 통로발판_두께 := 28.0
## 상하 발판 꼭대기의 **발판 윗면**이 그 층 바닥에서 얼마나 위인가.
## 헤드룸 440 − 300 = 140 이 머리 위에 남는다 (플레이어 키 96 + 여유 44).
const 상하_최고 := 300.0
const 상하_최저 := 40.0

## 이웃한 지형 조각을 서로 밀어 넣는 길이. SS2D 콜리전 깎임(24)의 두 배 넘게 준다.
const 겹침 := 48.0

var _높이 := PackedFloat32Array()   ## 구간별 L1 바닥 윗면 y
var _x0 := PackedFloat32Array()     ## 구간 왼끝
var _x1 := PackedFloat32Array()     ## 구간 오른끝
var _바닥_아랫 := 0.0
var _천장_윗 := 0.0
var _맵_오른 := 0.0


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== STAGE 2-8 · 갈래 (하수도 · 3층 다경로 · 골격) ===")

	# ── x 를 누적으로 깐다 ────────────────────────────────────────────────
	var x := 맵_왼
	for i in 구간표.size():
		_x0.append(x)
		x += float(구간표[i][0])
		_x1.append(x)
		if i < 틈표.size():
			x += float(틈표[i][0])
	_맵_오른 = x

	# ── 바닥 높이 ─────────────────────────────────────────────────────────
	_높이 = 기복.굴곡(구간표.size(), 씨앗, {
		"기준": 기준높이, "단": 단,
		"위로": 1, "아래로": 1,
		"평지": [],
		"직진_최대": 2,               # 같은 높이 3연속 금지 = 일자 맵 금지
		"머물_확률": 0.20,
	})
	var 문제 := 기복.검산(_높이, 단)
	if not 문제.is_empty():
		for m in 문제:
			push_error("기복 검산: %s" % m)
		quit(1)
		return

	var 가장낮은 := _높이[0]
	var 가장높은 := _높이[0]
	for h in _높이:
		가장낮은 = maxf(가장낮은, h)      # y 가 클수록 아래
		가장높은 = minf(가장높은, h)
	_바닥_아랫 = 가장낮은 + 260.0
	_천장_윗 = 가장높은 - 층간격 * 2.0 - 헤드룸 - 슬래브 * 2.0

	print("   씨앗 %d · 구간 %d · 리듬 %s" % [씨앗, 구간표.size(), 기복.리듬글(_높이, 단)])
	print("   L1 바닥 %s" % str(_높이))
	print("   가로 %.0f (x %.0f ~ %.0f) · 층 간격 %.0f · 헤드룸 %.0f"
		% [_맵_오른 - 맵_왼, 맵_왼, _맵_오른, 층간격, 헤드룸])
	var 계단수 := 0
	var 승강기수 := 0
	for t in 틈표:
		if String(t[2]) == "계단": 계단수 += 1
		elif String(t[2]) == "승강기": 승강기수 += 1
	print("   갈래점 %d = 계단 %d + 승강기 %d" % [계단수 + 승강기수, 계단수, 승강기수])
	print("   계단: 한 칸 %.0f 오르고 %.0f 나아간다 · 위층 계단 밑 머리 공간 최소 %.0f (키 96)"
		% [계단_단, 계단_깊이, 계단_단])
	print("   승강기: 폭 %.0f · 양옆 여백 %.0f (플레이어 폭 44 보다 넓어 끼지 않고 떨어진다)"
		% [승강기_폭, (560.0 - 승강기_폭) * 0.5])

	var 루트 := _짓기()
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패: %s" % error_string(e))
		quit(1)
		return
	e = ResourceSaver.save(팩, 내씬)
	print("   %-24s %s" % [내씬.get_file(), error_string(e)])
	print("=== 끝 ===\n")
	quit(0 if e == OK else 1)


# ============================================================================
# 층 좌표 — 전부 그 구간의 L1 바닥 윗면(h)에서 파생된다
# ============================================================================
func _L1_바닥(i: int) -> float: return _높이[i]
func _L2_바닥(i: int) -> float: return _높이[i] - 층간격
func _L3_바닥(i: int) -> float: return _높이[i] - 층간격 * 2.0
func _천장_아랫(i: int) -> float: return _L3_바닥(i) - 헤드룸

## 층 번호(1·2·3) → 그 층의 바닥 윗면.
func _층_바닥(i: int, 층: int) -> float:
	match 층:
		3: return _L3_바닥(i)
		2: return _L2_바닥(i)
		_: return _L1_바닥(i)


## 구간 i 의 지형이 x 로 어디까지 뻗나. 틈 한가운데까지 늘린다(L1 바닥·맨 위 천장 전용).
func _이어진_왼(i: int) -> float:
	return 맵_왼 if i == 0 else (_x1[i - 1] + _x0[i]) * 0.5
func _이어진_오른(i: int) -> float:
	return _맵_오른 if i == 구간표.size() - 1 else (_x1[i] + _x0[i + 1]) * 0.5


func _짓기() -> Node2D:
	var 시작 := Vector2(맵_왼 + 170.0, _높이[0])

	var 루트: Node2D = 월드_S.new()
	루트.name = "stage_2-8"
	루트.set("스테이지_이름", "2-8 · 갈래")
	루트.set("카메라_리밋", Rect2(맵_왼 - 여백, _천장_윗 - 300.0,
		(_맵_오른 + 여백) - (맵_왼 - 여백), (_바닥_아랫 + 700.0) - (_천장_윗 - 300.0)))
	## 3층을 한 화면에 담아야 갈래점에서 갈 길이 보인다.
	루트.set("카메라_줌", 1.35)
	루트.set("시작_위치", 시작)
	루트.set("낙사_y", _바닥_아랫 + 520.0)
	루트.set("치명_낙하거리", 520.0)

	var 코어 := 코어_S.new()
	코어.name = "페인트코어"
	코어.set("최대_탄약", 12)
	코어.add_to_group("페인트코어", true)
	루트.add_child(코어)

	var 지 := Node2D.new(); 지.name = "지형"; 루트.add_child(지)
	var 장 := Node2D.new(); 장.name = "장치"; 루트.add_child(장)
	var 위 := Node2D.new(); 위.name = "위험물"; 루트.add_child(위)

	_L1_바닥들(지)
	_슬래브들(지)
	_L3_천장(지)
	_끝벽(지)
	_계단들(지)
	_물길(장)
	_승강기들(장)
	_통로발판들(장)

	var 끝 := 구간표.size() - 1
	var 끝점 := Marker2D.new()
	끝점.name = "끝도달_검사점"
	끝점.position = Vector2(_x1[끝] - 160.0, _L3_바닥(끝) - 40.0)
	루트.add_child(끝점)

	var p := (load(S_플레이어) as PackedScene).instantiate()
	p.name = "Player"
	(p as Node2D).position = 시작
	루트.add_child(p)
	return 루트


# ============================================================================
# L1 바닥 — 맵의 밑바닥. 유일하게 **끊기지 않는** 층이다
# ============================================================================
func _L1_바닥들(지: Node2D) -> void:
	var 목록 := []
	for i in 구간표.size():
		목록.append([_이어진_왼(i), _이어진_오른(i), 구간표[i][3], _L1_바닥(i),
			"SS_L1_FLOOR_%d_%s" % [i + 1, 구간표[i][4]]])
	_겹치기(목록, _바닥_아랫)
	for b in 목록:
		_지형(지, _템플릿(b[2]), b[4], _사각(b[0], b[3], b[1], _바닥_아랫), true, b[2])


# ============================================================================
# 슬래브 — 층을 나누는 두 장짜리 판
# ============================================================================
## 위층 바닥(60) + 아래층 천장(60). 색이 달라도 되도록 **반드시 두 노드**로 만든다.
## 구간마다 뚝뚝 끊겨 있으므로(사이가 전부 틈) 겹치기가 필요 없다.
func _슬래브들(지: Node2D) -> void:
	for i in 구간표.size():
		var c: Array = 구간표[i]
		var 이름: String = c[4]
		var x0 := _x0[i]
		var x1 := _x1[i]

		var l2 := _L2_바닥(i)
		_지형(지, _템플릿(c[2]), "SS_L2_FLOOR_%d_%s" % [i + 1, 이름],
			_사각(x0, l2, x1, l2 + 슬래브), true, c[2])
		_지형(지, _벽템플릿(c[3]), "SS_L1_CEIL_%d_%s" % [i + 1, 이름],
			_사각(x0, l2 + 슬래브, x1, l2 + 슬래브 * 2.0), true, c[3])

		var l3 := _L3_바닥(i)
		_지형(지, _템플릿(c[1]), "SS_L3_FLOOR_%d_%s" % [i + 1, 이름],
			_사각(x0, l3, x1, l3 + 슬래브), true, c[1])
		_지형(지, _벽템플릿(c[2]), "SS_L2_CEIL_%d_%s" % [i + 1, 이름],
			_사각(x0, l3 + 슬래브, x1, l3 + 슬래브 * 2.0), true, c[2])


func _L3_천장(지: Node2D) -> void:
	var 목록 := []
	for i in 구간표.size():
		목록.append([_이어진_왼(i), _이어진_오른(i), 구간표[i][1], _천장_아랫(i),
			"SS_TOP_CEIL_%d_%s" % [i + 1, 구간표[i][4]]])
	_겹치기(목록, _천장_윗)
	for t in 목록:
		_지형(지, _벽템플릿(t[2]), t[4], _사각(t[0], _천장_윗, t[1], t[3]), true, t[2])


func _끝벽(지: Node2D) -> void:
	var 왼색: int = 구간표[0][3]
	var 오른색: int = 구간표[구간표.size() - 1][1]
	_지형(지, _벽템플릿(왼색), "SS_WALL_END_L",
		_사각(맵_왼 - 여백, _천장_윗, 맵_왼, _바닥_아랫), true, 왼색)
	_지형(지, _벽템플릿(오른색), "SS_WALL_END_R",
		_사각(_맵_오른, _천장_윗, _맵_오른 + 여백, _바닥_아랫), true, 오른색)


# ============================================================================
# L1 물길 — 맵 바닥에 깔린 물. **이 맵의 안전망이다**
# ============================================================================
func _물길(장: Node2D) -> void:
	var 씬 := load(S_유체) as PackedScene
	for i in 구간표.size():
		var x0 := _이어진_왼(i)
		var x1 := _이어진_오른(i)
		# ★유체는 원점이 물의 **윗끝**이고 아래로 자란다.
		var 물: Node2D = 씬.instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
		물.name = "물_%d_%s" % [i + 1, 구간표[i][4]]
		물.position = Vector2((x0 + x1) * 0.5, _L1_바닥(i) - 수심)
		물.set("색", 물_흰 if int(구간표[i][3]) == 흰색 else 물_검)
		물.set("크기", Vector2(x1 - x0, 수심))
		물.set("켜짐", true)
		## ★★이 두 줄이 이 맵의 안전망 전체다. `유체.gd` 의 기본값은 **꺼짐**이라
		##   안 켜면 L3 에서 떨어진 1,120px 이 그대로 즉사가 된다.
		물.set("낙하_받아줌", true)
		물.set("받아주는_최소수심", 40.0)
		장.add_child(물)


# ============================================================================
# 갈래점 승강기 — 상하 움직이는 발판. L1 ↔ L3 을 한 번에
# ============================================================================
## ★사다리(정지 지형)를 여기에 놓았다가 플레이어가 꼈다(파일 머리 주석 참고).
##   승강기는 **낄 기하가 없다** — 샤프트 안에 고정된 것이 하나도 없고,
##   양옆 100px 여백은 플레이어 폭 44 보다 넓어서 끼는 대신 그냥 떨어진다.
##
## 꼭대기에서 발판 윗면이 L3 바닥 윗면과 나란하고, 바닥에서 L1 바닥 윗면과 나란하다.
## 가는 길에 L2 바닥 높이를 지나므로 **어느 층에서든 타고 내린다.**
func _승강기들(장: Node2D) -> void:
	var 씬 := load(S_발판) as PackedScene
	var 번호 := 0
	for g in 틈표.size():
		var 이름: String = 틈표[g][1]
		if String(틈표[g][2]) != "승강기":
			continue                       # 계단 샤프트와 색 전환 틈에는 승강기가 없다
		var sx0 := _x1[g]                  # 샤프트 = 앞 구간의 오른끝 ~ 다음 구간의 왼끝
		var sx1 := _x0[g + 1]
		var h := _L1_바닥(g)               # 올라오는 쪽(왼쪽 구간)의 바닥을 기준으로 잡는다

		var m: Node2D = 씬.instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
		m.name = "승강기_%s" % 이름
		m.set("크기", Vector2(승강기_폭, 승강기_두께))
		m.set("이동방향", 1)                                # 상하
		m.set("이동거리", 층간격 * 2.0)                      # 1,120 = L1 ↔ L3
		m.set("왕복시간", 승강기_왕복)
		m.set("시작지연", 승강기_지연[번호 % 승강기_지연.size()])
		m.set("원점이_가운데", false)                        # 놓은 자리가 곧 꼭대기
		m.set("필요횟수", 1)
		# 꼭대기: 발판 윗면 = L3 바닥 윗면. 원점은 발판 한가운데다.
		m.position = Vector2((sx0 + sx1) * 0.5, (h - 층간격 * 2.0) + 승강기_두께 * 0.5)
		장.add_child(m)
		번호 += 1


# ============================================================================
# 갈래점 계단 — 스위치백 (정지 지형 · 절대 안 낀다)
# ============================================================================
## ```
##            ┌── 2층 계단: 왼쪽으로 오른다 ──┐
##   L3 ●─────┤                              │
##            └──────────────┐   ┌─ 층참 ─┐  │
##                           └───┤  L2   ├──┘   ← 오른쪽 구간의 L2 바닥으로 이어진다
##            ┌── 1층 계단: 오른쪽으로 오른다 ┘
##   L1 ●─────┘
## ```
## ▣ 왜 안 끼나
##   두 계단이 **각자 한 방향으로만** 오른다. 한 칸의 윗면 위에는 언제나
##   위층 계단의 밑면까지 **최소 140px**(플레이어 키 96 + 여유 44)이 열려 있다.
##   전에 낀 사다리는 좌우로 번갈아 놓아서 그 값이 88px 이었다 — 키보다 작았다.
##
## ▣ 조각을 **아래까지 통째로** 내린다
##   각 칸을 얇은 판이 아니라 "윗면부터 바닥까지 꽉 찬 덩어리"로 만든다.
##   그래야 칸과 칸 사이에 틈(=낄 자리)이 원리적으로 생기지 않는다.
func _계단들(지: Node2D) -> void:
	for g in 틈표.size():
		if String(틈표[g][2]) != "계단":
			continue
		var 이름: String = 틈표[g][1]
		var sx0 := _x1[g]
		var sx1 := _x0[g + 1]
		var h := _L1_바닥(g)                    # 올라오는 쪽(왼쪽 구간) 기준
		var l1색: int = 구간표[g][3]
		var l2색: int = 구간표[g][2]

		# ── 1층 계단: L1 → L2, 오른쪽으로 오른다 ──
		# 칸 k 의 윗면은 h − 140k. 조각은 오른끝까지 뻗고 바닥까지 내려간다(덩어리).
		## ★첫 칸을 `계단_깊이` 만큼 **오른쪽으로 밀어서** 시작한다.
		##   안 밀면 1층의 꼭대기 칸(= 층참)이 sx1−700 에서 끝나 버리고,
		##   그 자리를 2층 계단 덩어리가 통째로 덮는다 → **층참이 사라져서 못 올라간다.**
		##   (2026-09-08 레벨검사가 "1F_4 → 1F_5 사이 160px" 로 잡아낸 실제 사고)
		for k in range(1, 계단_칸 + 1):
			var 윗면 := h - 계단_단 * float(k)
			_지형(지, _템플릿(l1색), "SS_STAIR_%s_1F_%d" % [이름, k],
				_사각(sx0 + 계단_깊이 * float(k), 윗면, sx1, _바닥_아랫), true, l1색)

		# ── 2층 계단: L2 → L3, 왼쪽으로 오른다 ──
		# 밑면은 L2 바닥 높이에 **딱 붙인다**. 띄우면 그 틈이 곧 끼는 자리가 된다.
		var l2 := h - 층간격
		for j in range(1, 계단_칸 + 1):
			var 윗면2 := l2 - 계단_단 * float(j)
			_지형(지, _템플릿(l2색), "SS_STAIR_%s_2F_%d" % [이름, j],
				_사각(sx0, 윗면2, sx1 - 계단_참 - 계단_깊이 * float(j - 1), l2), true, l2색)

		# ── 중간 선반 — L3 에서 층참으로 떨어질 때 받아 준다 ──
		# ⚠ 없으면 L3(h−1120) → 층참(h−560) 이 **560px** 라 치명 낙하(520)를 넘는다.
		#   선반을 절반 높이에 두면 280 + 280 으로 쪼개져 둘 다 안전해진다.
		#   위아래로 각각 280 씩 열려 있어 머리가 낄 일도 없다.
		var 선반y := h - 층간격 - 계단_단 * 2.0   # L3 → 선반 → 층참 으로 낙하를 쪼갠다
		_지형(지, _템플릿(l2색), "SS_STAIR_%s_선반" % 이름,
			_사각(sx1 - 계단_참, 선반y, sx1, 선반y + 선반_두께), true, l2색)


# ============================================================================
# 통로 발판 — 좌우 · 상하
# ============================================================================
## ⚠ 상하 발판은 꼭대기에서도 천장까지 **헤드룸 − 상하_최고 = 140px** 이 남는다.
##   플레이어 키 96 + 여유 44. 이 여유가 없으면 발판이 사람을 천장에 밀어 넣는다.
func _통로발판들(장: Node2D) -> void:
	var 씬 := load(S_발판) as PackedScene
	for t in 통로발판:
		var i: int = int(t[0]) - 1
		var 층: int = int(t[1])
		var 세로: bool = int(t[2]) == 1
		var 바닥 := _층_바닥(i, 층)
		var 가운데 := (_x0[i] + _x1[i]) * 0.5

		var m: Node2D = 씬.instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
		m.name = "발판_%s" % String(t[6])
		m.set("크기", Vector2(통로발판_폭, 통로발판_두께))
		m.set("이동방향", 1 if 세로 else 0)
		m.set("이동거리", float(t[3]))
		m.set("왕복시간", float(t[4]))
		m.set("시작지연", float(t[5]))
		m.set("원점이_가운데", not 세로)      # 좌우는 가운데 기준, 상하는 꼭대기 기준
		m.set("필요횟수", 2)
		if 세로:
			# 꼭대기(= 놓는 자리)에서 아래로 `이동거리` 만큼 내려간다.
			m.position = Vector2(가운데, 바닥 - 상하_최고 + 통로발판_두께 * 0.5)
		else:
			m.position = Vector2(가운데, 바닥 - 상하_최저 - 통로발판_두께 * 0.5 - 140.0)
		장.add_child(m)


