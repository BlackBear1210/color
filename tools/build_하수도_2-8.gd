## 위/아래 두 겹 슬래브(윗겹 = 걷는 색 · 아랫겹 = 못 닿는 천장 색 = 색 비율용)
func _두겹(지: Node, 이름: String, x0: float, x1: float, 윗면: float, 위색: int, 아래색: int) -> Node2D:
	var 위: Node2D = b.지형(지, 이름, 공.사각(x0, 윗면, x1, 윗면 + 96.0), 위색)
	b.지형(지, 이름 + "_밑", 공.사각(x0, 윗면 + 96.0, x1, 윗면 + 192.0), 아래색, "채움")
	return 위


## 구덩이 바닥(96 아래) — 웅덩이·가시가 앉는 자리. 슬래브 아랫겹 자리(윗면 + 96 ~ + 192)를 채운다.
func _구덩이밑(지: Node, 이름: String, x0: float, x1: float, 윗면: float, 색: int) -> Node2D:
	return b.지형(지, 이름, 공.사각(x0, 윗면 + 96.0, x1, 윗면 + 192.0), 색)


## 버튼 홈이 있는 윗겹 슬래브
func _홈겹(지: Node, 이름: String, x0: float, x1: float, 윗면: float, 색: int, 홈중심: float) -> Node2D:
	b.짧은변_허용.append(이름)
	return b.지형(지, 이름, 공.다각([
		[x0, 윗면], [홈중심 - 64, 윗면], [홈중심 - 64, 윗면 + 홈], [홈중심 + 64, 윗면 + 홈], [홈중심 + 64, 윗면],
		[x1, 윗면], [x1, 윗면 + 96], [x0, 윗면 + 96],
	]), 색)


## 압력버튼(원점 = 홈 바닥 · 윗면 = 바닥) — 2-7 과 같다
func _버튼(장: Node, 이름: String, x: float, 바닥: float, 그룹: String, 유지: bool, 대상: Node = null,
		이동량: Vector2 = Vector2.ZERO) -> Node2D:
	var n := AnimatableBody2D.new()
	n.set_script(버튼_S)
	n.name = 이름
	n.position = Vector2(x, 바닥 + 홈)
	n.set("폭", 128.0)
	n.set("높이", 홈)
	n.set("작동방식", 1 if 유지 else 0)
	n.set("누름_가능_그룹", PackedStringArray([그룹]))
	n.set("이동속도", 420.0)
	장.add_child(n)
	if 대상:
		var 경로: Array[NodePath] = [n.get_path_to(대상)]
		var 량: Array[Vector2] = [이동량]
		n.set("대상들", 경로)
		n.set("대상_이동량들", 량)
	return n


## 문(버튼이 옮기는 지형 = Node2D 그릇 + 지형). 검산·색 비율에서 뺀다.
func _문(장: Node, 이름: String, 사각: Rect2, 색: int) -> Node2D:
	var 그릇 := Node2D.new()
	그릇.name = 이름
	그릇.position = 사각.position
	장.add_child(그릇)
	b.지형(그릇, 이름 + "_몸", 공.사각(0, 0, 사각.size.x, 사각.size.y), 색, "플랫폼")
	b.지형표.pop_back()
	return 그릇


func _박스(장: Node, 이름: String, x: float, 바닥: float) -> Node2D:
	var t := (load(S_박스) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = Vector2(x, 바닥)
	t.set("낙사_y", 바닥 + 140.0)
	장.add_child(t)
	return t


func _양동이(장: Node, 이름: String, x: float, 바닥: float, 색: int, 굳음: bool, 배출유체: Node = null, 배출지점: Node = null) -> Node2D:
	var t := (load(S_양동이) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = Vector2(x, 바닥)
	t.set("색", 색)
	t.set("채운뒤_밀수없음", 굳음)
	t.set("낙사_y", 바닥 + 140.0)
	장.add_child(t)
	if 배출유체:
		t.set("배출_유체", t.get_path_to(배출유체))
	if 배출지점:
		t.set("배출_지점", t.get_path_to(배출지점))
	return t


func _저장고(장: Node, 이름: String, x: float, 바닥: float, 필요횟수: int, 공급: Node) -> Node2D:
	var t := (load(S_저장고) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = Vector2(x, 바닥 - 48.0)
	t.set("크기", Vector2(192.0, 96.0))
	t.set("필요횟수", 필요횟수)
	t.set("자동_공급_연결", false)
	장.add_child(t)
	t.set("공급_유체", t.get_path_to(공급))
	return t


## 움직이는 발판(스마트월드 · 플레이어를 태운다 · 안 칠하면 검정). 원점 = 발판 가운데 · `시작` 에서 `+거리` 까지 사인 왕복.
func _발판(장: Node, 이름: String, 시작: Vector2, 거리: float, 세로: bool, 왕복: float, 폭: float = 180.0) -> Node2D:
	var t := (load(S_발판) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = 시작
	t.set("크기", Vector2(폭, 28.0))
	t.set("이동거리", 거리)
	t.set("이동방향", 1 if 세로 else 0)
	t.set("왕복시간", 왕복)
	t.set("원점이_가운데", false)
	장.add_child(t)
	return t


## 웅덩이 위 격자 줄 — 윗면 = 층 바닥(걸어 올라탄다) · 192 폭 · 128 간격
func _격자줄(장: Node, 앞이름: String, 중심들: Array, 윗면: float, 필요횟수: int = 2) -> void:
	var i := 1
	for cx in 중심들:
		b.통과플랫폼(장, "%s_g%d" % [앞이름, i], cx, 윗면, 192.0, 필요횟수)
		i += 1


## 천장 물줄기(폭 64 · 천장에서 바닥 위 40 까지)
func _물줄기(장: Node, 이름: String, x: float, 천장: float, 바닥: float, 색: int, 켜짐: bool = true) -> Node2D:
	b.배관(장, "관_" + 이름, 공.다각([[x, 천장 - 200.0], [x, 천장 + 16.0]]))
	return b.유체(장, 이름, x, 천장 + 16.0, 64.0, 바닥 - 40.0 - (천장 + 16.0), 색, 켜짐)


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("stage_2-8", "2-8 · 갈래", 프레임, Vector2(520, L2), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	var 배경 := (load(배경씬) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	배경.name = "하수도배경"
	루트.add_child(배경)
	루트.move_child(배경, 1)
	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 채움
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "천장띠", 공.사각(0, 0, 11520, 608), 검, "채움")
	# L3 천장(704 · 머리 위 480 · 뛰어도 320 남는다)을 흰색으로 — 바닥·벽이 거의 검정이라 색 비율(65 ± 5)을 여기서 맞춘다(2-7 과 같은 수법)
	b.지형(지, "천장띠_밑_왼", 공.사각(0, 608, 1600, 704), 검, "채움")
	b.지형(지, "L3_천장_흰", 공.사각(1600, 608, 9616, 704), 흰)
	b.지형(지, "천장띠_밑_오른", 공.사각(9616, 608, 11520, 704), 검, "채움")
	b.지형(지, "L3_왼덩어리", 공.사각(0, 704, 1600, 1472), 검, "채움")           # L2 왼쪽 천장 + 승강기 왼벽
	b.지형(지, "L3_오른덩어리", 공.사각(9616, 704, 11520, L3), 검, "채움")
	b.지형(지, "끝방_천장", 공.사각(9616, L3, 11520, 1472), 흰)                  # 끝 방 천장(머리 위 544 · 못 닿는다)
	b.지형(지, "L1_왼덩어리", 공.사각(0, 2304, 1600, 4000), 검, "채움")
	b.지형(지, "L1_오른덩어리", 공.사각(9408, 2304, 11520, 4000), 검, "채움")     # 굴뚝 오른벽

	# ══════════════════════════════════════════════════════════════════════
	# L3 (1280) 「물 위 격자 · 톱 · 흰 구간의 검정 커튼 · 가시 위 선반」
	# ══════════════════════════════════════════════════════════════════════
	_두겹(지, "L3_a", 1856, 2080, L3, 검, 흰)
	_구덩이밑(지, "L3_웅덩이밑", 2080, 3360, L3, 검)
