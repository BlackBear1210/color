	# ══════════════════════════════════════════════════════════════════════
	# 검정물_1 — 오른쪽 구조물 밑(77) → 시작 바닥 오른쪽(101). 가시 구덩이 건너편이라 길은 아니다(흰 몸으로 떨어지면 죽는다).
	_물기둥(장, "검정물_1", 109.0, 112.0, 77.0, 101.0, 공.물_검)
	# 흰물_1 — 큰 흰 ㄴ 밑(46) → 아래 허공(도면 80 · 바닥이 없어 낙사 높이까지). 흰 발판 44·50 옆을 지난다.
	_물기둥(장, "흰물_1", 24.0, 28.0, 46.0, 104.0, 공.물_흰)
	# 흰물_2 — 사격 몬스터 발판 밑(22) → 흰 기둥 밑 바닥(46.5). CP 와 흰물 웅덩이 사이.
	_물기둥(장, "흰물_2", 72.0, 74.5, 22.0, 46.5, 공.물_흰)
	# 검정물_2 — 저장소 바위 밑(25.5) → 벨브 바닥(41). 벨브_1 이 켜고 끈다. 그 뒤에 벨브_2 가 숨어 있다.
	var 검물2 := _물기둥(장, "검정물_2", 129.5, 132.0, 25.5, 41.0, 공.물_검)
	# 흰물_3 — 저장소 바위 밑(25.5) → 벨브 바닥(41). 벨브_2 가 켜고 끈다(도면 글은 흰물_2 — 머리 주석 참고).
	var 흰물3 := _물기둥(장, "흰물_3", 137.5, 143.0, 25.5, 41.0, 공.물_흰)
	# 검정물_3 — 천장 바위 밑(9) → 저장소 바위(22.5). 격자_물을 뚫고 떨어진다.
	_물기둥(장, "검정물_3", 116.5, 119.5, 9.0, 22.5, 공.물_검)
	# 흰물_4 — 천장 바위 밑(9) → 저장소 바위(22.5). 저장소 색이 곧 이 물 색이다(처음 흰색 · 칠하면 그 색).
	var 흰물4 := _물기둥(장, "흰물_4", 138.5, 142.5, 9.0, 22.5, 공.물_흰)
	# 웅덩이 — 도면 지형 윤곽의 1 칸 홈(추출 도구가 그대로 판다). 흰 기둥 양옆 아래.
	_웅덩이(장, "흰물_웅덩이", 78.0, 83.5, 47.5, 공.물_흰)
	_웅덩이(장, "검은물_웅덩이", 89.5, 100.0, 52.5, 공.물_검)

	# ══════════════════════════════════════════════════════════════════════
