	var 벨브1: Node2D = b.레버(장, "벨브_1", Vector2(kx(127), ky(41)), 0, 검물2)
	벨브1.set("시작_켜짐", true)
	# 벨브_2 — 검정물_2 뒤(칸 130.75). "검정물_2를 끄면 그 뒤에 숨겨진 벨브_2가 보이게 됨" → 제어레버 `숨김_유체`(신규).
	var 벨브2: Node2D = b.레버(장, "벨브_2", Vector2(kx(130.75), ky(41)), 0, 흰물3)
