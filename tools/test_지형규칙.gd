extends SceneTree
## ============================================================================
## [2026-08-07 신규] 스마트 지형 물리 제어 규칙 검증 (헤드리스)
## ----------------------------------------------------------------------------
## 실행: Godot --headless --path . -s res://tools/test_지형규칙.gd
##
## 규칙 1 (최소 수평 간격) / 2 (단차·경사) / 3 (평탄 구간) / 4 (자기교차) 를
## **씨앗 200 개**로 무작위 생성해 전부 검사한다.
## 무작위 생성기를 쓰는 이상 "한 번 돌려보니 되더라"는 증거가 못 된다.
## ============================================================================

const 규칙 := preload("res://scripts/스마트월드/지형규칙.gd")
const 플레이어_씬 := preload("res://scenes/player/Player.tscn")

var 실패 := 0
var 총 := 0


func 확인(이름: String, 조건: bool, 덧말: String = "") -> void:
	총 += 1
	print(("  PASS  " if 조건 else "  FAIL  ") + 이름 + ("" if 덧말.is_empty() else "   " + 덧말))
	if not 조건:
		실패 += 1


func _init() -> void:
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== 스마트 지형 물리 제어 규칙 검증 ===")
	await _실측_대조()
	_생성_검사()
	_정리_검사()
	_닫기_검사()
	_조회_검사()

	print("---")
	print("결과: %d / %d 통과%s" % [총 - 실패, 총, "" if 실패 == 0 else "  ← %d개 실패" % 실패])
	quit(1 if 실패 > 0 else 0)


# ── 0. 상수가 실제 캐릭터와 맞는가 ──────────────────────────────────────────
func _실측_대조() -> void:
	print("\n[0] 상수 vs 실측")
	var p := 플레이어_씬.instantiate()
	root.add_child(p)
	await process_frame
	var 잰것 := 규칙.플레이어에서_재기(p)
	print("      실측: 폭 %.1f · 키 %.1f · 점프높이 %.1f · 점프거리 %.1f"
		% [잰것["폭"], 잰것["키"], 잰것["점프높이"], 잰것["점프거리"]])
	확인("폭 상수가 실측과 일치", absf(잰것["폭"] - 규칙.플레이어_폭) < 1.0)
	확인("키 상수가 실측과 일치", absf(잰것["키"] - 규칙.플레이어_키) < 1.0)
	확인("점프 높이 상수가 실측과 일치", absf(잰것["점프높이"] - 규칙.점프_높이) < 2.0)
	확인("점프 거리 상수가 실측과 일치", absf(잰것["점프거리"] - 규칙.점프_거리) < 2.0)
	# 규칙 2 의 근거 — 최대 단차가 점프 높이의 30% 인가
	확인("최대 단차 = 점프 높이의 30%",
		absf(규칙.최대_단차 - 규칙.점프_높이 * 0.30) < 0.5)
	# 규칙 1+2 를 함께 지키면 경사각 규칙이 저절로 지켜지는가
	var 최악각 := rad_to_deg(atan2(규칙.최대_단차, 규칙.최소_수평간격))
	확인("최소간격+최대단차 조합의 최악 경사 < 45도",
		최악각 < 규칙.최대_바닥각, "%.1f도" % 최악각)
	p.free()


# ── 1~3. 생성기가 규칙을 지키는가 (씨앗 200개) ──────────────────────────────
func _생성_검사() -> void:
	print("\n[1] 지면_윗면() — 씨앗 200개 전수 검사")
	var 위반총 := 0
	var 꼬임총 := 0
	var 평탄없음 := 0
	var 최소점수 := 9999
	for 시드 in range(1, 201):
		# 진폭을 일부러 크게(400px) 줘서 "규칙이 정말 붙잡는지"를 본다.
		var 윗면 := 규칙.지면_윗면(0.0, 4000.0, 0.0, 400.0, 시드)
		최소점수 = mini(최소점수, 윗면.size())
		var 문제 := 규칙.위반_찾기(윗면)
		if not 문제.is_empty():
			위반총 += 문제.size()
			if 위반총 <= 3:
				print("      [시드 %d] %s" % [시드, 문제[0]])
		if 규칙.최장_평탄구간(윗면) < 규칙.평탄_최소점:
			평탄없음 += 1
		if 규칙.자기교차_있나(규칙.닫기(윗면, 900.0)):
			꼬임총 += 1

	확인("규칙 1·2 위반 0건", 위반총 == 0, "위반 %d건" % 위반총)
	확인("규칙 3 — 모든 지형에 평탄 구간이 있다", 평탄없음 == 0, "없는 지형 %d개" % 평탄없음)
	확인("규칙 4 — 자기교차 0건", 꼬임총 == 0, "꼬인 지형 %d개" % 꼬임총)
	확인("점이 지나치게 줄지 않는다", 최소점수 >= 40, "최소 %d점" % 최소점수)

	# 실제로 플레이어가 끝까지 걸어갈 수 있는가 — 한 걸음마다 오를 수 있는 높이인지
	var 윗면2 := 규칙.지면_윗면(0.0, 6000.0, 0.0, 500.0, 4242)
	var 못오름 := 0
	for i in range(1, 윗면2.size()):
		var 오름 := 윗면2[i - 1].y - 윗면2[i].y      # +면 위로 올라간다
		if 오름 > 규칙.안전_오름단차:
			못오름 += 1
	확인("★한 걸음도 '못 오르는 절벽'이 없다", 못오름 == 0, "절벽 %d곳" % 못오름)


# ── 정리() 가 나쁜 입력을 실제로 고치는가 ───────────────────────────────────
func _정리_검사() -> void:
	print("\n[2] 정리() — 일부러 망가뜨린 입력")

	# (a) 점이 8px 간격으로 뭉쳐 있다 → 규칙 1 위반
	var 뭉침 := PackedVector2Array()
	for i in 60:
		뭉침.append(Vector2(float(i) * 8.0, 0.0))
	var 고친1 := 규칙.정리(뭉침)
	# ★평탄도(규칙 3)는 끄고 본다 — 정리()는 없는 평지를 만들어낼 수 없다(함수 주석 참고).
	확인("뭉친 점(8px 간격) → 규칙 위반 0", 규칙.위반_찾기(고친1, false).is_empty())
	확인("뭉친 점을 실제로 솎아냈다", 고친1.size() < 뭉침.size(),
		"%d점 → %d점" % [뭉침.size(), 고친1.size()])

	# (b) 절벽 — 한 걸음에 600px 수직 상승 → 규칙 2 위반
	var 절벽 := PackedVector2Array([
		Vector2(0, 0), Vector2(100, 0), Vector2(200, -600), Vector2(300, -600),
		Vector2(400, 200), Vector2(500, 200),
	])
	var 고친2 := 규칙.정리(절벽)
	확인("절벽(600px) → 규칙 위반 0", 규칙.위반_찾기(고친2, false).is_empty())
	var 최대단차 := 0.0
	for i in range(1, 고친2.size()):
		최대단차 = maxf(최대단차, absf(고친2[i].y - 고친2[i - 1].y))
	확인("절벽이 규칙 2 한계 이하로 깎였다", 최대단차 <= 규칙.최대_단차 + 0.01,
		"최대 %.1fpx" % 최대단차)

	# (c) x 순서가 뒤죽박죽 → 규칙 4 의 전제(단조 증가)가 깨진 입력
	var 뒤죽 := PackedVector2Array([
		Vector2(400, 0), Vector2(0, 0), Vector2(800, -40),
		Vector2(200, 30), Vector2(600, -10),
	])
	var 고친3 := 규칙.정리(뒤죽)
	var 오름차순 := true
	for i in range(1, 고친3.size()):
		if 고친3[i].x <= 고친3[i - 1].x:
			오름차순 = false
	확인("뒤섞인 x 를 오름차순으로 정렬한다", 오름차순)
	확인("정렬 후에도 규칙 위반 0", 규칙.위반_찾기(고친3, false).is_empty())

	# (d) 오른쪽 끝은 절대 사라지면 안 된다 (지형 폭이 줄면 다음 지형과 틈이 생긴다)
	var 끝촘촘 := PackedVector2Array([
		Vector2(0, 0), Vector2(100, 0), Vector2(200, 0), Vector2(205, 0),
	])
	var 고친4 := 규칙.정리(끝촘촘)
	확인("★맨 오른쪽 x 는 보존된다",
		is_equal_approx(고친4[고친4.size() - 1].x, 205.0),
		"끝 x = %.1f" % 고친4[고친4.size() - 1].x)


# ── 닫기() ──────────────────────────────────────────────────────────────────
func _닫기_검사() -> void:
	print("\n[3] 닫기() — 닫힌 다각형")
	var 윗면 := 규칙.지면_윗면(0.0, 2000.0, 0.0, 300.0, 77)
	var 폴리 := 규칙.닫기(윗면, 800.0)
	확인("점 2개(바닥)가 붙는다", 폴리.size() == 윗면.size() + 2)
	확인("자기교차 없음", not 규칙.자기교차_있나(폴리))
	# 감김 방향 — 화면 좌표계(y 아래)에서 시계 방향이면 부호 있는 넓이가 양수
	var 넓이 := 0.0
	for i in 폴리.size():
		var a := 폴리[i]
		var b := 폴리[(i + 1) % 폴리.size()]
		넓이 += a.x * b.y - b.x * a.y
	확인("★감김 방향이 시계 방향 (지형공통.gd 의 다른 지형과 같다)", 넓이 > 0.0)

	# 바닥이 윗면보다 위에 있는 잘못된 입력도 뒤집히지 않아야 한다
	var 폴리2 := 규칙.닫기(윗면, -9999.0)
	확인("바닥y 를 잘못 줘도 다각형이 뒤집히지 않는다", not 규칙.자기교차_있나(폴리2))


# ── 높이()/기울기() ─────────────────────────────────────────────────────────
func _조회_검사() -> void:
	print("\n[4] 높이() / 기울기() — 장식 배치용 조회")
	var 윗면 := PackedVector2Array([
		Vector2(0, 0), Vector2(100, 0), Vector2(200, -50), Vector2(300, -50),
	])
	확인("꼭짓점 위 높이", is_equal_approx(규칙.높이(윗면, 100.0), 0.0))
	확인("중간 지점 보간", is_equal_approx(규칙.높이(윗면, 150.0), -25.0))
	확인("왼쪽 범위 밖 = 첫 점", is_equal_approx(규칙.높이(윗면, -500.0), 0.0))
	확인("오른쪽 범위 밖 = 끝 점", is_equal_approx(규칙.높이(윗면, 5000.0), -50.0))
	확인("평지 기울기 = 0", is_zero_approx(규칙.기울기(윗면, 50.0)))
	확인("오르막 기울기 < 0 (위로)", 규칙.기울기(윗면, 150.0) < 0.0)
