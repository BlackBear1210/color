extends SceneTree
## ============================================================================
## [2026-08-29 신규] SS2D 잉크 번짐 연출 검사
## ----------------------------------------------------------------------------
## 실행: godot --headless --path . -s res://tools/test_번짐연출.gd
##
## ▣ 왜 따로 만들었나
##   `test_사방재질_칠하기.gd` 는 **논리**만 본다 — 셰이더가 붙었나, 색이 바뀌었나.
##   그건 얼룩이 0 에서 자라든 즉시 찍히든 똑같이 통과한다.
##   타일맵(`tile_paint_map.gd`)에서 옮겨 온 것은 바로 그 **자라는 과정**이라,
##   "지금 몇 px 까지 번졌나" 를 프레임 단위로 재는 검사가 따로 있어야 한다.
##
## ▣ 무엇을 보나
##   1. 맞은 직후 얼룩은 **목표보다 작다** (즉시 찍히지 않는다)
##   2. 프레임이 지나면 커진다 → 결국 목표에 붙는다
##   3. 물감이 아래로 흘러내린다 (`_흘러내림` 이 0 에서 자란다)
##   4. 테두리 재질의 `r_scale` > 채움 재질 → **테두리부터 물든다**
##   5. 흰색 Template 은 태어날 때 **연출 없이** 이미 다 칠해져 있다
##      (스테이지를 열 때마다 흰 지형이 퍼지는 애니를 보여줄 이유가 없다)
##   6. 회수하면 그 자리에서 원래대로 (연출 없음)
## ============================================================================

const 키트 := "res://scenes/집/스마트 매쉬 assets/"
const 검정씬 := 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID.tscn"
const 흰색씬 := 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID_WHITE.tscn"
const 색상 := preload("res://scripts/color_defs.gd")

var _통과 := 0
var _실패 := 0
var _n := 0
var _지형: Node = null
var _씬루트: Node = null
var _맞은직후반지름 := 0.0
var _중간반지름 := 0.0


func _init() -> void:
	Engine.max_fps = 60
	process_frame.connect(_틱)


func _확인(조건: bool, 설명: String) -> void:
	if 조건:
		_통과 += 1
		print("  ✔ %s" % 설명)
	else:
		_실패 += 1
		print("  ✖ %s" % 설명)


func _반지름(i: int) -> float:
	var a: PackedFloat32Array = _지형.get("_반지름")
	return a[i] if i < a.size() else -1.0


func _목표(i: int) -> float:
	var a: PackedFloat32Array = _지형.get("_목표")
	return a[i] if i < a.size() else -1.0


func _흘러내림(i: int) -> float:
	var a: PackedFloat32Array = _지형.get("_흘러내림")
	return a[i] if i < a.size() else -1.0


func _세우기(경로: String) -> void:
	var 팩 := load(경로) as PackedScene
	_씬루트 = 팩.instantiate()
	root.add_child(_씬루트)
	# ⚠ `_지형.get_parent()` 를 지우면 안 된다 — 지형이 씬 루트면 그 부모는
	#   **SceneTree 의 root** 라, 그걸 free 하면 트리가 통째로 무너져 검사가 멈춘다.
	_지형 = _씬루트 if _씬루트.has_method("반대색인가") else _씬루트.get_child(0)


func _틱() -> void:
	_n += 1
	match _n:
		1:
			print("\n── 검정 Template 에 한 발 (자라는가)")
			_세우기(검정씬)
		2:
			_지형.명중(색상.WHITE, _지형.global_position)
			_맞은직후반지름 = _반지름(0)
			_확인(_맞은직후반지름 < _목표(0),
				"맞은 직후 %.0fpx — 목표 %.0fpx 보다 작다 (즉시 안 찍힌다)"
					% [_맞은직후반지름, _목표(0)])
			_확인(_목표(0) >= _지형.부분_반지름,
				"목표가 부분 반지름(%.0f) 이상이다 — 한 발도 눈에 보인다" % _지형.부분_반지름)
		8:
			_중간반지름 = _반지름(0)
			_확인(_중간반지름 > _맞은직후반지름,
				"6 프레임 뒤 %.0fpx 로 자랐다" % _중간반지름)
			_확인(_흘러내림(0) > 0.0,
				"물감이 아래로 %.0fpx 흘러내렸다" % _흘러내림(0))
		40:
			_확인(_반지름(0) > _중간반지름, "계속 자라 %.0fpx" % _반지름(0))
			_확인(absf(_반지름(0) - _목표(0)) < _목표(0) * 0.2,
				"목표 %.0fpx 에 거의 붙었다 (%.0fpx)" % [_목표(0), _반지름(0)])
			_확인(_흘러내림(0) >= _지형.흘러내림_길이 * 0.5
					and _흘러내림(0) <= _지형.흘러내림_길이 + 0.5,
				"흘러내림이 %.0fpx (상한 %.0f 를 안 넘는다)"
					% [_흘러내림(0), _지형.흘러내림_길이])
			_테두리_선행_검사()
			_씬루트.queue_free()
			_지형 = null
		42:
			print("\n── 흰색 Template (연출 없이 이미 칠해져 있어야)")
			_세우기(흰색씬)
		44:
			_확인(_지형.현재색() == 색상.WHITE, "태어날 때 흰색이다")
			_확인(_반지름(0) == _목표(0),
				"얼룩이 처음부터 목표 크기다 (%.0f = %.0f · 애니 없음)"
					% [_반지름(0), _목표(0)])
			_확인(_흘러내림(0) == 0.0, "흘러내림이 없다")
		46:
			print("\n── 흰색 지형을 검정으로 덮고 되돌리기")
			for i in 12:
				if _지형.명중(색상.BLACK, _지형.global_position) == "painted":
					break
			_확인(_지형.현재색() == 색상.BLACK, "검정으로 덮였다")
			# 덮어쓰기는 옛 얼룩을 지우지 않고 **뒤에 새 얼룩을 붙인다** → 마지막 것을 본다.
			var 끝: int = (_지형.get("_시드") as PackedVector2Array).size() - 1
			_확인(끝 >= 1, "옛 얼룩이 남아 있다 (그 위로 새 색이 번진다)")
			_확인(_반지름(끝) < _목표(끝),
				"덮을 때도 퍼지는 연출이 있다 (%.0f → %.0f)" % [_반지름(끝), _목표(끝)])
		48:
			_지형.되돌리기()
			_확인(_지형.현재색() == 색상.WHITE, "되돌리면 흰색으로 복귀")
			_확인(_반지름(0) == _목표(0), "복귀는 연출 없이 그 자리에서")
			_끝내기()


## 테두리 조각과 채움 조각이 **같은 반지름**을 쓰는가 = 한 덩어리로 칠해지는가.
##
## ★[2026-08-29] 예전에는 테두리에 1.35 를 넣어 가장자리부터 물들게 했다. 그런데
##   SS2D 는 테두리 메시와 채움 메시가 따로라, 테두리만 다 칠해지고 안쪽이 덜 칠해진
##   상태가 **띠 두께를 따라 직선으로 잘려** 보인다 — 모서리에는 검은 쐐기가 파고든다.
##   "물감이 번진다" 가 아니라 "테두리와 안쪽을 따로 칠했다" 로 읽혀서 기본을 1.0 으로 내렸다.
##   (`테두리_선행` 을 올리면 그 효과를 되살릴 수 있다 — 기본에서는 쓰지 않는다)
func _테두리_선행_검사() -> void:
	var 값들: Array[float] = []
	for m in _지형.get("_meshes"):
		var mat = m.get("material")
		if mat is ShaderMaterial:
			값들.append(float(mat.get_shader_parameter("r_scale")))
	값들.sort()
	_확인(_지형.테두리_선행 == 1.0, "테두리_선행 기본값이 1.0 이다")
	_확인(값들.size() >= 2 and is_equal_approx(값들[0], 값들[-1]),
		"테두리와 채움이 같은 반지름을 쓴다 (%.2f = %.2f · 한 덩어리)"
			% [값들[0] if 값들.size() > 0 else 0.0, 값들[-1] if 값들.size() > 0 else 0.0])


func _끝내기() -> void:
	print("\n════════════════════════════════════════")
	print("  통과 %d · 실패 %d" % [_통과, _실패])
	print("════════════════════════════════════════\n")
	quit(1 if _실패 > 0 else 0)
