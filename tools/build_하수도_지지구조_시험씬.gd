extends SceneTree
## ============================================================================
## [2026-09-14 신규] 하수도 지지구조 시험 씬 빌더 — 쇠사슬·삼각 지지대·체인 고정구 검증용
## ----------------------------------------------------------------------------
## 실행: Godot --headless --path . -s res://tools/build_하수도_지지구조_시험씬.gd
## 출력: scenes/테스트/하수도_지지구조/쇠사슬_지지대_시험.tscn  (F6 로 직접 켤 수 있다)
##
## ▣ 구성 (프롬프트 §12 · 왼쪽부터)
##   1  검정 고정 발판 + 왼쪽 벽 지지대              x 400
##   2  흰 고정 발판 + 오른쪽 벽 지지대               x 1000
##   3  넓은 검정 발판 + 같은 지지대 두 개             x 1700
##   4  짧은 체인 · 긴 체인 (고정 모드 · 고리 크기 같음)  x 2560 · 2760
##   5  상하 승강기 + 천장 고정구 2 + 체인 2 (추적 모드)   x 3300   ← C03·C04·G05
##   5' 체인 없는 같은 승강기 (G05 비교용)               x 3800
##   6  옮겨 놓은 부모 Node2D 밑의 같은 체인 조합         (2000, 400) ← C05
##   7  오류 조건: 끊긴 경로 · 길이 0 (텍스처 없음은 검사기가 실행 중에 만든다)  x 3900~3960, y 700  ← C06
##   플레이어는 바닥(1600) 왼쪽에서 시작. 실제 월드·페인트코어·Player 가 붙어 G01~G05 를 돌릴 수 있다.
##
## ⚠ 이 씬은 검사 전용이다. 실제 맵을 덮어쓰지 않는다. 기존 맵 빌더를 돌리지 않는다.
## ============================================================================

const 공 := preload("res://tools/하수도_빌더_공통.gd")
const 내씬 := "res://scenes/테스트/하수도_지지구조/쇠사슬_지지대_시험.tscn"

const S_쇠사슬 := "res://scenes/장식/하수도_지지구조/쇠사슬.tscn"
const S_지지대 := "res://scenes/장식/하수도_지지구조/삼각지지대.tscn"
const S_고정구 := "res://scenes/장식/하수도_지지구조/체인고정구.tscn"
const S_승강기 := "res://scenes/집/스마트월드_장애물/움직이는발판.tscn"
const S_검정발판 := "res://scenes/테스트/하수도_지형_v01/공중_두꺼운발판.tscn"
const S_흰발판 := "res://scenes/테스트/하수도_지형_v01/공중_두꺼운발판_흰색.tscn"

const 검 := 공.검정
const 흰 := 공.흰색
const 프레임 := Rect2(0, 0, 4096, 2304)
const 바닥 := 1600.0
const 천장 := 160.0

var b: RefCounted


func _init() -> void:
	call_deferred("_실행")


func _실행() -> void:
	print("\n=== 하수도 지지구조 시험 씬 ===")
	b = 공.new()
	var 루트 := _짓기()
	if not b.저장(루트, 내씬):
		quit(1)
		return
	print("=== 끝 ===\n")
	quit(0)


func _인스턴스(경로: String, 이름: String, 부모: Node, 위치: Vector2) -> Node2D:
	var n := (load(경로) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	n.name = 이름
	n.position = 위치
	부모.add_child(n)
	return n


## 체인 하나. 추적 모드로 두 고정구의 `연결점` 을 잡는다. 경로는 체인 노드 기준 상대 경로.
func _체인(부모: Node, 이름: String, 위치: Vector2, 시작: Node, 끝: Node) -> Node2D:
	var c := _인스턴스(S_쇠사슬, 이름, 부모, 위치)
	c.set("모드", 1)
	if 시작 != null:
		c.set("시작점_경로", c.get_path_to(시작.get_node("연결점")))
	if 끝 != null:
		c.set("끝점_경로", c.get_path_to(끝.get_node("연결점")))
	return c


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("쇠사슬_지지대_시험", "시험 · 쇠사슬 · 삼각 지지대",
		프레임, Vector2(300, 바닥), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 장식 := Node2D.new()
	장식.name = "장식"
	루트.add_child(장식)

	# ── 방 뼈대: 바닥 · 천장 · 양 벽 (검정) ──
	b.지형(지, "바닥", 공.사각(0, 바닥, 4096, 2304), 검)
	b.지형(지, "천장", 공.사각(0, 0, 4096, 천장), 검, "채움")
	b.지형(지, "왼벽", 공.사각(0, 천장, 160, 바닥), 검)
	b.지형(지, "오른벽", 공.사각(3936, 천장, 4096, 바닥), 검)

	# ══════════════════════════════════════════════════════════════════════
	# 1. 검정 고정 발판 + 왼쪽 벽 지지대 — 발판 왼끝이 벽 기둥에 닿는다
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "기둥1", 공.사각(240, 천장, 400, 바닥), 검)
	var p1 := _인스턴스(S_검정발판, "발판1_검정", 지, Vector2(400, 1200))     # 320×120 · 원점 왼쪽 위
	var br1 := _인스턴스(S_지지대, "지지대1_왼쪽", p1, Vector2(0, 120))      # 원점 = 발판 왼쪽 아래 모서리
	br1.set("방향", 0)

	# ══════════════════════════════════════════════════════════════════════
	# 2. 흰 고정 발판 + 오른쪽 벽 지지대 — 벽 기둥도 흰색(흰 몸이 닿는 벽)
	# ══════════════════════════════════════════════════════════════════════
	var p2 := _인스턴스(S_흰발판, "발판2_흰", 지, Vector2(1000, 1200))
	b.지형(지, "기둥2_흰", 공.사각(1320, 천장, 1480, 바닥), 흰)
	var br2 := _인스턴스(S_지지대, "지지대2_오른쪽", p2, Vector2(320, 120))  # 원점 = 발판 오른쪽 아래 모서리
	br2.set("방향", 1)

	# ══════════════════════════════════════════════════════════════════════
	# 3. 넓은 검정 발판(640) + 같은 크기 지지대 두 개 (하나를 늘이지 않는다)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "기둥3", 공.사각(1540, 천장, 1700, 바닥), 검)
	var p3: Node2D = b.지형(지, "발판3_넓은", 공.사각(1700, 1200, 2340, 1320), 검)   # 원점 = 바운딩 중심 (2020, 1260)
	var br3a := _인스턴스(S_지지대, "지지대3a", p3, Vector2(-320, 60))       # 왼쪽 아래 모서리
	br3a.set("방향", 0)
	var br3b := _인스턴스(S_지지대, "지지대3b", p3, Vector2(0, 60))          # 320 오른쪽 · 뒤 벽 고정으로 읽힌다
	br3b.set("방향", 0)

	# ══════════════════════════════════════════════════════════════════════
	# 4. 짧은 체인 · 긴 체인 — 고정 모드. 고리 크기가 같아야 한다 (C01)
	# ══════════════════════════════════════════════════════════════════════
	var a4s := _인스턴스(S_고정구, "고정구4_짧은", 장식, Vector2(2560, 천장))
	var a4l := _인스턴스(S_고정구, "고정구4_긴", 장식, Vector2(2760, 천장))
	var c4s := _인스턴스(S_쇠사슬, "체인4_짧은", 장식, Vector2(2560, 천장 + 20))
	c4s.set("모드", 0); c4s.set("고정_시작", Vector2(0, 0)); c4s.set("고정_끝", Vector2(0, 200))
	var c4l := _인스턴스(S_쇠사슬, "체인4_긴", 장식, Vector2(2760, 천장 + 20))
	c4l.set("모드", 0); c4l.set("고정_시작", Vector2(0, 0)); c4l.set("고정_끝", Vector2(0, 700))
	# 체인 끝에 발판 고정구(뒤집힘)를 달아 "허공에서 끝나지 않게" 보인다
	var a4s_b := _인스턴스(S_고정구, "고정구4_짧은_끝", 장식, Vector2(2560, 천장 + 20 + 200 + 20))
	a4s_b.set("방향", 1)
	var a4l_b := _인스턴스(S_고정구, "고정구4_긴_끝", 장식, Vector2(2760, 천장 + 20 + 700 + 20))
	a4l_b.set("방향", 1)

	# ══════════════════════════════════════════════════════════════════════
	# 5. 상하 승강기 + 천장 고정구 2 + 체인 2 (추적) — C03·C04·G05
	#    승강기 원점 = 발판 중심(크기 320×28). 1100 에서 400 아래로 왕복(사인파 6 초).
	# ══════════════════════════════════════════════════════════════════════
	var 승 := _인스턴스(S_승강기, "승강기5", 장, Vector2(3300, 1100))
	승.set("크기", Vector2(320, 28))
	승.set("이동방향", 1)
	승.set("이동거리", 400.0)
	승.set("왕복시간", 6.0)
	승.set("필요횟수", 2)
	# 발판 쪽 고정구는 승강기의 **자식** (같이 움직인다). 판이 발판 윗면에 앉는다.
	var e5l := _인스턴스(S_고정구, "연결구_L", 승, Vector2(-140, -14))
	e5l.set("방향", 1)
	var e5r := _인스턴스(S_고정구, "연결구_R", 승, Vector2(140, -14))
	e5r.set("방향", 1)
	# 천장 고정구는 승강기 **밖** (장식 아래)
	var a5l := _인스턴스(S_고정구, "천장고정구5_L", 장식, Vector2(3160, 천장))
	var a5r := _인스턴스(S_고정구, "천장고정구5_R", 장식, Vector2(3440, 천장))
	_체인(장식, "체인5_L", Vector2(3160, 천장), a5l, e5l)
	_체인(장식, "체인5_R", Vector2(3440, 천장), a5r, e5r)

	# 5'. 체인 없는 같은 승강기 — 체인이 움직임을 바꾸지 않는지 비교한다 (G05)
	var 승비교 := _인스턴스(S_승강기, "승강기5_비교", 장, Vector2(3800, 1100))
	승비교.set("크기", Vector2(200, 28))
	승비교.set("이동방향", 1)
	승비교.set("이동거리", 400.0)
	승비교.set("왕복시간", 6.0)
	승비교.set("필요횟수", 2)

	# ══════════════════════════════════════════════════════════════════════
	# 6. 옮겨 놓은 부모 밑의 같은 조합 — 좌표 변환 검사 (C05)
	#    부모가 (2000, 400) 에 있고 자식은 전부 로컬 좌표. 체인은 월드→로컬 변환을 거쳐 그려야 한다.
	# ══════════════════════════════════════════════════════════════════════
	var 묶음 := Node2D.new()
	묶음.name = "이동된_묶음6"
	묶음.position = Vector2(2000, 400)
	장식.add_child(묶음)
	var a6 := _인스턴스(S_고정구, "천장고정구6", 묶음, Vector2(0, 0))
	var e6 := _인스턴스(S_고정구, "발판고정구6", 묶음, Vector2(0, 320))
	e6.set("방향", 1)
	_체인(묶음, "체인6", Vector2(0, 0), a6, e6)

	# ══════════════════════════════════════════════════════════════════════
	# 7. 오류 조건 — 플레이 씬과 구분되는 검사 전용 자리 (C06)
	# ══════════════════════════════════════════════════════════════════════
	var 오류1 := _인스턴스(S_쇠사슬, "오류7_끊긴경로", 장식, Vector2(3900, 700))
	오류1.set("모드", 1)
	오류1.set("시작점_경로", NodePath("../없는노드/연결점"))
	오류1.set("끝점_경로", NodePath("../없는노드2/연결점"))
	var 오류2 := _인스턴스(S_쇠사슬, "오류7_길이0", 장식, Vector2(3960, 700))
	오류2.set("모드", 0); 오류2.set("고정_시작", Vector2(0, 0)); 오류2.set("고정_끝", Vector2(0, 0))
	# 텍스처 없음 조건은 씬에 못 담는다(_ready 가 기본 텍스처를 채운다) → 검사기가 실행 중에 null 을 넣어 본다.

	b.끝점(루트, Vector2(3800, 바닥))
	b.플레이어(루트, Vector2(300, 바닥))
	return 루트
