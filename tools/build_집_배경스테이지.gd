## 김동현(blackbear125) 작업자의 **ColorZone** 하나. `흰색인가 = false` 면 검정 구역.
##
## ⚠⚠ `color_zone.tscn` 을 **인스턴스하면 안 된다.** `PackedScene.pack()` 은 owner 가
##   패킹 루트인 노드의 값만 저장하므로, 인스턴스 내부 `CollisionPolygon2D` 에 꽂은
##   폴리곤이 통째로 버려지고 Template 기본 사각형(원점 384×256)만 남는다.
##   → 다른 빌더 노드들과 같은 방식(스크립트를 새 노드에 붙이기)을 쓴다.
func _색구역(층: Node2D, 이름: String, 월드폴리곤: PackedVector2Array, 흰색인가: bool) -> void:
	var z := Area2D.new()
	z.name = 이름
	z.set_script(load("res://scenes/경계/color_zone.gd"))
	z.position = Vector2.ZERO       # 원점에 두면 아래 좌표가 곧 월드 좌표다
	z.collision_layer = 0
	z.set("zone_color", 1 if 흰색인가 else 0)     # ZoneColor { BLACK=0, WHITE=1 }
	# ⚠ `show_tint` 는 에디터 가이드다. 켜 두면 인게임에 흰 상자 + 외곽선이 그대로 나온다.
	z.set("show_tint", false)
	var cp := CollisionPolygon2D.new()
	cp.name = "CollisionPolygon2D"   # ★이 이름이어야 `_기본_폴리곤()` 이 찾는다
	cp.polygon = 월드폴리곤
	z.add_child(cp)
	층.add_child(z)


## 반딧불이 무리 — **구역 안쪽 둘레**를 따라 흩는다(가운데 뭉치면 경계가 안 읽힌다).
## ⚠ 이 노드에는 색 판정이 **없다.** 판정은 ColorZone 이 하고, 반딧불이는
##   "그 구역이 어디까지인지" 를 눈에 보이게 하는 역할만 맡는다(도형님 지시 §13).
func _반딧불이(층: Node2D, 이름: String, 자리들: Array, 반경: float) -> void:
	var 묶음 := Node2D.new()
	묶음.name = 이름
	for i in 자리들.size():
		var f: Node2D = 발광체_S.new()
		f.name = "구슬_%02d" % (i + 1)
		f.position = 자리들[i]
		f.set("종류", 발광체_S.종류_.구슬)
		f.set("빛색", Color(1.0, 0.97, 0.90))    # 흑백 게임이라 채도는 거의 0
		f.set("반경", 반경)
		f.set("밝기", 1.25)
		f.set("깜빡임", 0.30)
		f.set("크기_흔들림", 0.34)               # 크기까지 흔들려야 "살아 있는 빛"이 된다
		f.set("흔들림_속도", 0.45 + 0.11 * i)    # 주기를 달리해 무리가 동기화되지 않게
		f.set("부유", 16.0)
		묶음.add_child(f)
	층.add_child(묶음)


