	return {"루트": 루트, "지형": 지형층, "오브젝트": 오브젝트층}


func _배경(루트: Node2D, 원화: String, 영역: Rect2, 방: int, 밝기: float) -> void:
	var 배경: Node2D = 실내배경_S.new()
	배경.name = "실내배경"
	배경.set("영역", 영역)
	배경.set("아래_방", 방)
	배경.set("위_방", 방)
	배경.set("그림_아래", load(원화))
	배경.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	배경.set("그림_밝기", 밝기)
	배경.z_index = -60
	배경.z_as_relative = false
	루트.add_child(배경)


## 원화의 **앞쪽 바닥 띠**만 떠서 플레이어 앞(z +40)에 한 겹 더 깐다.
## ① 2.5D 깊이감 ② 바닥 지형(높이 300px)의 벽돌 민낯이 원화 마룻바닥을 덮는 것을 가린다.
## 시작 py 를 바닥선보다 10~15px 아래로 두면 그 틈이 얇은 선으로 남아 "밟는 높이" 표시가 된다.
func _전경(루트: Node2D, 원화: String, 영역: Rect2, 배율: float,
		띠_시작py: float, 띠_끝py: float, 밝기: float) -> void:
	var 앞: Node2D = 실내배경_S.new()
	앞.name = "앞바닥"
	앞.set("영역", Rect2(영역.position.x, 영역.position.y + 띠_시작py * 배율,
		영역.size.x, (띠_끝py - 띠_시작py) * 배율))
	앞.set("그림_아래", load(원화))
	앞.set("그림_맞춤", 실내배경_S.맞춤_.늘이기)
	앞.set("그림_원본영역", Rect2(0.0, 띠_시작py, 영역.size.x / 배율, 띠_끝py - 띠_시작py))
	앞.set("그림_밝기", 밝기)
	앞.set("앞에_그리기", true)
	앞.z_index = 40
	앞.z_as_relative = false
	루트.add_child(앞)


# ============================================================================
# ★지형 — 작업자 키트 Template 인스턴스
# ============================================================================
## Template 씬을 그대로 인스턴스하고 **점만 갈아 끼운다**. 재질·타이핑·타이퍼·코너는
## Template 이 들고 있는 v2 세트를 그대로 쓴다(README §12: 작업자는 "모양"만 만든다).
##
## ⚠ 함정 1 — `_meshes` 를 비우지 않으면 **Template 의 구운 메시가 그대로 나온다.**
##   `SS2D_Shape.force_update()` 는 `if not _first_update or not _meshes:` 일 때만
##   메시를 다시 굽는다. 로드 직후는 `_first_update == true` 라서, 메시가 남아 있으면
##   점을 바꿔도 **모양이 안 바뀐다**(Template 크기 512×192 인 채로 렌더된다).
##   → 점을 바꿨으면 `_meshes` 를 비워서 "다시 구워라"고 알려야 한다.
##
## ⚠ 함정 2 — 스마트지형을 **활성 트리에 넣으면 안 된다.**
##   `_ready` 가 `shape_material` 을 깊은 복사해 셰이더를 붙이므로, 빌더가 트리에 넣으면
##   Template 과의 재질 공유가 깨진 채로 저장된다. 여기서는 오프라인 조립만 한다.
##
## `월드점들` 은 **월드 좌표** 시계방향 다각형. 노드 position 은 AABB 중심으로 잡고
## 점은 그 기준의 로컬로 넣는다(작업자가 에디터에서 옮기기 편한 형태).
func _지형(층: Node2D, 템플릿: String, 이름: String, 월드점들: PackedVector2Array,
		칠가능: bool, 유령: bool = false) -> void:
	var 씬 := load(템플릿) as PackedScene
	var 지형: Node2D = 씬.instantiate()
	지형.name = 이름

	# AABB 중심을 노드 위치로
	var 최소 := 월드점들[0]
	var 최대 := 월드점들[0]
	for p in 월드점들:
		최소 = 최소.min(p)
		최대 = 최대.max(p)
	var 중심 := (최소 + 최대) * 0.5
	지형.position = 중심

	지형.set("칠하기_허용", 칠가능)
	지형.set("무색일때_통과", 유령)

	# ── 점 갈아 끼우기 ──
	var 점배열 := SS2D_Point_Array.new()
	var 로컬 := PackedVector2Array()
	for p in 월드점들:
		로컬.append(p - 중심)
	점배열.add_points(로컬)
	# ★닫힌 도형이어야 fill 메시가 생긴다(`_build_fill_mesh` 는 is_shape_closed() 를 본다).
	점배열.close_shape()
	지형.set_point_array(점배열)
	# ⚠⚠⚠ [2026-08-26] 이 줄은 **아무 일도 하지 않는다.** 남겨 둔 이유는 아래를 읽으라고다.
	#   `_meshes` 는 `@export_storage var _meshes: Array[SS2D_Mesh]` — **타입 있는 배열**이라
	#   타입 없는 `[]` 를 `set()` 으로 넣으면 변환에 실패하고 조용히 무시된다.
	#   설령 타입을 맞춰 비워도 소용없다 — 빈 배열은 프로퍼티 **기본값**이라
	#   `PackedScene.pack()` 이 저장하지 않고, 로드 때 Template 의 구운 메시로 되돌아간다.
	#   그래서 집 4방의 바닥·천장·벽이 **전부 Template 크기(420×242)로 렌더되고 있었다.**
	#   콜리전과 레벨검사는 새 점을 쓰니 "보이는 것과 밟는 것이 다른" 상태였고,
	#   원화 전경이 앞을 가려서 여태 안 보였을 뿐이다.
	#   → 진짜 해결은 런타임 쪽에 넣었다: `scripts/스마트월드/지형.gd _ready()` 가
	#     `super()` 앞에서 `_meshes.clear()` 한다. 그러면 반드시 새 점으로 다시 굽는다.
	지형.set("_meshes", [])

	# ── 콜리전 다시 굽기 ──
	# 런타임 `_ready → force_update → bake_collision()` 이 어차피 다시 굽지만,
	# 저장된 씬을 에디터에서 열었을 때도 바로 맞아야 하므로 여기서도 한 번 굽는다.
	var 폴리 := 지형.get_node_or_null("StaticBody2D/CollisionPolygon2D") as CollisionPolygon2D
	if 폴리 != null:
		var 생성기 := SS2D_CollisionGen.new()
		생성기.collision_size = 지형.collision_size
		생성기.collision_offset = 지형.collision_offset
		폴리.polygon = 생성기.generate_filled(점배열.get_tessellated_points())

	층.add_child(지형)


## 축 정렬 사각형(시계방향). README §20 — 비스듬한 변이 있는 폐곡선은 금지, 직각만 쓴다.
func _사각(x0: float, y0: float, x1: float, y1: float) -> PackedVector2Array:
	return PackedVector2Array([
		Vector2(x0, y0), Vector2(x1, y0), Vector2(x1, y1), Vector2(x0, y1),
	])


## 계단식 윗면을 가진 덩어리. `단` = [[왼x, 오른x, 윗면y], ...] 를 왼→오른쪽 순서로.
## 바닥y 까지 통째로 내려 채운다(= 가구 실루엣). README §7 — 한 칸 폭 90px 이상.
func _계단덩어리(단: Array, 바닥y: float) -> PackedVector2Array:
	var 점 := PackedVector2Array()
	for i in 단.size():
		var s: Array = 단[i]
		점.append(Vector2(s[0], s[2]))     # 그 칸 왼쪽 위
		점.append(Vector2(s[1], s[2]))     # 그 칸 오른쪽 위
	점.append(Vector2(단[단.size() - 1][1], 바닥y))
	점.append(Vector2(단[0][0], 바닥y))
	return 점


