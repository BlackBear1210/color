func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


func _실행() -> void:
	var 인자 := OS.get_cmdline_user_args()
	var 고를것: String = 인자[0] if 인자.size() > 0 else ""
	print("\n=== 집 챕터 · 원화 배경 + 작업자 키트 Template 빌더 (v2) ===")
	var 할일 := [
		["2층방", 방씬, Callable(self, "_2층방")],
		["거실", 거실씬, Callable(self, "_거실")],
		["부엌", 부엌씬, Callable(self, "_부엌")],
		["굴뚝", 굴뚝씬, Callable(self, "_굴뚝")],
	]
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://scenes/집"))
	var 실패 := 0
	for 줄 in 할일:
		if 고를것 != "" and 고를것 != 줄[0]:
			continue
		if not _저장(줄[2].call(), 줄[1]):
			실패 += 1
	print("=== 끝 (실패 %d) ===\n" % 실패)
	quit(0 if 실패 == 0 else 1)


func _저장(루트: Node2D, 경로: String) -> bool:
	# ★인스턴스(Template·Player) 내부 노드에는 owner 를 다시 박지 않는다 (CLAUDE.md §6).
	공통.주인_지정(루트, 루트)
	var 팩 := PackedScene.new()
	var e := 팩.pack(루트)
	if e != OK:
		push_error("pack 실패 %s: %s" % [경로, error_string(e)])
		return false
	e = ResourceSaver.save(팩, 경로)
	print("   %-24s %s" % [경로.get_file(), error_string(e)])
	return e == OK


