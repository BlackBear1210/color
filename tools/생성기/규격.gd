extends RefCounted
## ============================================================================
## [2026-09-20 신규] 절차 생성 규격 — **모든 수치의 유일한 출처**
## ----------------------------------------------------------------------------
## ▣ 왜 파일을 따로 뺐나
##   생성기·검증기·조립기가 각자 "점프는 이쯤" 을 기억하면 언젠가 한 곳이 틀어진다.
##   그 순간 **생성기는 통과시키는데 실제로는 못 가는 맵**이 나온다(제일 잡기 어려운 버그).
##   → 세 모듈이 전부 이 파일 하나를 preload 해서 쓴다.
##
## ▣ 값의 출처 (추측 없음 · 전부 저장소 실측)
##   · 플레이어 몸 44 × 97 px      : `player.gd _몸_크기` (Player.tscn 콜리전 × 루트 scale)
##   · move_speed 390             : `player.gd`
##   · 점프 높이 160 / 거리 320    : 하수도 기준값(`tools/하수도_빌더_공통.gd`) — 도형님 지시로 집 1-1 도 이것을 쓴다
##   · 여유 0.80 / 0.85           : `tools/레벨검사.gd` 와 **같은 값** (다르면 검사끼리 싸운다)
##   · 치명 낙하 1500             : 하수도 기준값
##   · 격자 16 · 최소 변 90        : 가이드라인 §6 · `검산()`
##   · 전체칠 576 · 필요횟수 96/발 : `지형.gd 전체_색칠_최대긴변` · `필요횟수()`
##   · 탄속 1150 · 탄 중력 900     : `총.gd 탄속` · `총알.gd 중력`
## ============================================================================

# ── 플레이어 몸 ─────────────────────────────────────────────────────────────
const 몸_폭: float = 44.0
const 몸_높이: float = 97.0
const 이동속도: float = 390.0

# ── 점프 (하수도 기준) ──────────────────────────────────────────────────────
const 점프_높이: float = 160.0
const 점프_거리: float = 320.0
const 상승_배수: float = 1.0
const 낙하_배수: float = 2.4        ## player.gd FALL_GRAVITY_MULTIPLIER
const 치명_낙하: float = 1500.0

## 레벨검사와 같은 안전 여유. **이걸 빼면 "이론상 가능" 한 자리가 나오는데 사람 손으로는 못 한다.**
const 여유_세로: float = 0.80
const 여유_가로: float = 0.85

static func 올라갈_수_있는_높이() -> float:
	return 점프_높이 * 여유_세로          # 128 px — 검사기의 **판정선**

static func 건널_수_있는_거리() -> float:
	return 점프_거리 * 여유_가로          # 272 px — 검사기의 **판정선**

## ★★설계 여유 — 판정선에 **딱 맞춰 만들면 안 된다**.
##   2026-09-20 에 층 간격을 판정선과 똑같은 128 로 잡았더니, 생성기는 통과시켰는데
##   `레벨검사.gd` 는 "도달 불가" 라고 했다. 검사기는 씬을 띄워 8 px 간격 레이캐스트로
##   **실측한 표면 y** 를 쓰기 때문에, 설계값 128 이 실측 129 로 읽히는 순간 끊긴다.
##   → 생성기는 항상 이 두 값 안에서만 만든다. 판정선은 검사기에게 맡긴다.
const 설계_최대틈: float = 224.0      ## 판정선 272 에 48 여유
const 설계_최대상승: float = 112.0    ## 판정선 128 에 16 여유 (16 격자 배수)


## player.gd `_점프_재계산()` 을 그대로 옮긴 것. 궤적을 시뮬레이션할 때 쓴다.
## ⚠ 공식을 고치려면 player.gd 쪽을 먼저 보고 **같이** 고칠 것.
static func 중력() -> float:
	var k := 1.0 / sqrt(상승_배수) + 1.0 / sqrt(낙하_배수)
	return 2.0 * 점프_높이 * 이동속도 * 이동속도 * k * k / (점프_거리 * 점프_거리)

static func 점프_초속도() -> float:
	return -sqrt(2.0 * 중력() * 상승_배수 * 점프_높이)


# ── 지형 기하 (가이드라인 §6 · 검산과 같은 값) ──────────────────────────────
const 격자: float = 16.0
const 최소_변: float = 90.0

## 플레이어가 **안정적으로 설 수 있는** 최소 발판 폭.
## 몸 폭 44 에 좌우 여유를 준 값. 이보다 좁으면 착지 자체가 도박이 된다.
## ★[2026-09-21] 도형님 피드백 — "발판들이 작아서 안에 이미지가 깨졌어"
##   SS2D 는 발판 안쪽을 **타일 텍스처로 채운다.** 발판이 텍스처 한 장보다 작으면
##   그림이 잘려 지저분해지고, 테두리 마감(코너 조각)끼리 겹쳐 뭉개진다.
##   나무 재질(wood_v2) 기준으로 **가로 288 · 두께 112** 부터 그림이 제대로 읽힌다.
const 최소_착지폭: float = 192.0
## 발판이 너무 넓으면 "걷기만 하는 구간" 이 된다(가이드라인: 걷기 구간 ≤ 1,500px).
const 최대_발판폭: float = 576.0     ## = 전체칠 한계와 같은 값. 넘으면 칠이 안 굳는다
## 발판 두께. 64 는 텍스처가 세로로 뭉개진다(도형님 스크린샷) → 112.
## ⚠ 더 두껍게 하면 밑면이 머리(97)에 걸리므로 **일방통행**으로 두는 것이 전제다.
const 발판_두께: float = 112.0
## 발판 권장 가로 폭(최소~최대). 576 은 전체칠 한계라 그 위로는 못 간다.
const 권장_발판폭_최소: float = 288.0
const 권장_발판폭_최대: float = 576.0
const 바닥_두께: float = 192.0       ## 밟고 다니는 바닥(구조로 읽히는 두께)

## 플레이어 머리 위 여유. 발판 밑면과 아래 바닥 윗면 사이가 이보다 좁으면 **끼인다.**
const 최소_통로높이: float = 160.0   ## 몸 97 + 점프 여유

## ★보행 방해 금지 규칙 — 이 게임에서 제일 자주 나오는 "버그 같아 보이는 지형".
##   같은 높이로 이어지는 바닥에 20 px 짜리 단차가 있으면 플레이어는 그냥 **걸린다**
##   (player.gd 는 계단 오르기가 없다 — 어떤 단차든 점프해야 넘는다).
##   → 단차는 **0(완전히 평평)** 이거나 **의도적으로 보이는 크기** 둘 중 하나여야 한다.
const 금지_단차_하한: float = 1.0    ## 이 이상이면서
const 금지_단차_상한: float = 64.0   ## 이 미만인 단차는 만들지 않는다
## 틈도 마찬가지다. 48 px 짜리 틈은 "구멍" 으로 안 읽히고 발만 빠진다.
const 최소_틈: float = 96.0

# ── 색·탄약 (지형.gd · 페인트_코어.gd) ──────────────────────────────────────
const 전체칠_최대긴변: float = 576.0
const 발당_길이: float = 96.0        ## 필요횟수 = ceil(긴변 / 96), 최대 8
const 최대_필요횟수: int = 8
const 탄창: int = 12
const 최대_시드: int = 24            ## 한 지형이 동시에 가질 수 있는 얼룩 수(셰이더 MAX_SEEDS)
## 색 구간이 바뀌는 자리에는 **공중에서 색을 바꿀 틈**이 있어야 한다(가이드라인 §7).
const 색경계_최소틈: float = 80.0

static func 필요_발수(긴변: float) -> int:
	return clampi(int(ceil(긴변 / 발당_길이)), 1, 최대_필요횟수)

# ── 총알 (총.gd · 총알.gd) ──────────────────────────────────────────────────
const 탄속: float = 1150.0
const 탄_중력: float = 900.0
const 탄_수명: float = 3.0
const 물리_틱: float = 1.0 / 60.0

# ── 색 상수 (지형.gd enum 상태) ─────────────────────────────────────────────
const 무색: int = 0
const 검정: int = 1
const 흰색: int = 2

# ── 렌더링 예산 (docs/프롬프트_절차생성_1만px_맵_2026-09-20.md §4) ──────────
const 한계_겹친광원: int = 12        ## 엔진 하드 한계 15~16 에 여유 3


## 값을 격자에 맞춘다. 생성기가 만드는 **모든 좌표**가 이걸 통과해야 검산이 통과한다.
static func 격자맞춤(v: float) -> float:
	return roundf(v / 격자) * 격자


static func 격자맞춤_벡(v: Vector2) -> Vector2:
	return Vector2(격자맞춤(v.x), 격자맞춤(v.y))


## 사각형을 시계 방향 점 목록으로. (y 는 아래로 커진다 → 왼위 → 오른위 → 오른아래 → 왼아래)
static func 사각(x0: float, y0: float, x1: float, y1: float) -> PackedVector2Array:
	return PackedVector2Array([
		Vector2(격자맞춤(x0), 격자맞춤(y0)),
		Vector2(격자맞춤(x1), 격자맞춤(y0)),
		Vector2(격자맞춤(x1), 격자맞춤(y1)),
		Vector2(격자맞춤(x0), 격자맞춤(y1)),
	])


## 발판 A 의 가장자리에서 발판 B 위로 올라설 수 있나 — `레벨검사.gd` 와 **완전히 같은 잣대**.
##   a_끝  : 뛰는 자리(발판 가장자리 윗면)
##   b_왼/b_오른/b_윗면 : 목표 발판
##
## ★★[2026-09-20] 여기서 한 번 크게 틀렸다 — 반드시 읽을 것.
##   처음에는 "내려가는 점프는 더 멀리 간다" 며 낙차에 비례해 가로 한계를 최대 +197 늘렸다.
##   물리적으로는 맞는 말이지만 **`레벨검사.gd` 는 그렇게 안 본다** — 그쪽은 방향과 무관하게
##   `가로 > 점프거리 × 0.85` 면 무조건 끊는다(레벨검사.gd:314).
##   그 결과 생성기는 "도달률 100 %" 라고 했는데 저장소의 진짜 검사기는 "30 개 중 6 개 도달"
##   이라고 했다. **두 검사기가 다른 말을 하면 생성기는 쓸모가 없다.**
##   → 더 엄격한 쪽(저장소 도구)에 맞춘다. 보너스를 없앴다.
static func 갈_수_있나(a_끝: Vector2, b_왼: float, b_오른: float, b_윗면: float) -> bool:
	var 수평: float = 0.0
	if b_왼 > a_끝.x:
		수평 = b_왼 - a_끝.x
	elif b_오른 < a_끝.x:
		수평 = a_끝.x - b_오른
	if 수평 > 건널_수_있는_거리():
		return false
	var 올라감 := a_끝.y - b_윗면          # y 는 아래로 커지므로 양수 = 올라가는 것
	if 올라감 > 0.0:
		return 올라감 <= 올라갈_수_있는_높이()
	# 내려가는 경우 — 치명 거리를 넘으면 그건 "죽는 길" 이라 연결로 치지 않는다
	return -올라감 <= 치명_낙하
