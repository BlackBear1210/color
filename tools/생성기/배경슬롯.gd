extends RefCounted
## ============================================================================
## [2026-09-28 신규] 배경 슬롯 — **구역 정보 그대로** 배경을 조립한다 (작업지시 §7)
## ----------------------------------------------------------------------------
## ▣ 이 파일은 그림을 그리지 않는다. **어디에 무엇이 와야 하는지**만 계산한다.
##   그림은 아스트라가 그리고(`docs/프롬프트_아스트라_탐색방_층별배경_2026-09-28.md`),
##   실제 노드 배치는 `scripts/스마트월드/집_배경.gd` 가 이 표를 읽어서 한다.
##
## ▣ 지키는 규칙
##   · 완성된 방 그림을 상하로 복제하지 않는다. 반복하는 것은 **바탕과 중간 벽**뿐이고,
##     바닥 마감·천장 마감은 **실제 경계에 한 번만** 온다.
##   · 소품(책장·난간)은 구역의 **바닥 앵커**에 붙는다. 물리 발판과 맞물리는 것은
##     이동비율 1.0(월드 고정)이어야 한다 — 멀리 흐르는 그림에 콜리전을 붙이지 않는다.
##   · 층마다 이동비율이 달라서, 카메라가 끝까지 가도 그림 밖이 안 드러나는
##     **커버리지**를 층별로 따로 잰다. 1 차 추정 = V + |s|·D + 2M.
## ============================================================================

const 층_이동비율 := {
	"L1_먼바탕": 0.15,
	"L2_먼건축": 0.35,
	"L3_중경소품": 0.70,
	"L4_전경": 1.25,
}
## 첫 베이의 월드 폭 제안값(작업지시 §7). 8 칸 = 768 px.
const 베이_폭칸: int = 8
const 여유_M: float = 192.0
const 화면 := Vector2(1920.0, 1080.0)


## 방 사전(탐색방.gd 결과)을 받아 배경 슬롯 목록을 만든다.
static func 슬롯들(방: Dictionary) -> Array:
	var 칸크기: float = float(방["칸크기"])
	var 원점: Vector2 = 방["원점"]
	var L: int = int(방["L"])
	var R: int = int(방["R"])
	var T: int = int(방["T"])
	var B: int = int(방["B"])
	var 슬롯: Array = []

	# L1 먼 바탕 — 방 전체 + 여유. 양축 반복 가능한 어둠(초점 없음)
	슬롯.append(_슬롯(원점, 칸크기, "방전체", "L1_먼바탕", L - 2, R + 2, T - 2, B + 2,
		"어둠_A", "집_바탕_XY", false))

	# L2 먼 건축 — 구역마다 **한 층 pitch**의 벽 베이. 반복은 X 축만.
	for z in (방["구역들"] as Array):
		var x0: int = L + int(z["x0"])
		var x1: int = L + int(z["x1"])
		var 위: int = int(z["지지행"]) - 4          # 한 층계(4 칸) 위가 그 구역의 천장
		슬롯.append(_슬롯(원점, 칸크기, String(z["id"]), "L2_먼건축",
			x0, x1, maxi(T, 위), int(z["지지행"]),
			"벽베이_%s" % z["컨셉"], "집_층베이_v01", false))
	# 마감은 **실제 경계에 한 번만**
	슬롯.append(_슬롯(원점, 칸크기, "바닥", "L2_먼건축", L, R, B, B + 1,
		"바닥마감", "집_마감_한번", false))
	슬롯.append(_슬롯(원점, 칸크기, "천장", "L2_먼건축", L, R, T - 1, T,
		"천장마감", "집_마감_한번", false))

	# L3 중경 소품 — 구역 바닥 앵커에 붙는 가구. 지형과 같은 자리면 월드 고정.
	#   ⚠ 층 통로 천장이 192 px 뿐이라 소품 높이는 176 px 를 넘기면 안 된다.
	for z2 in (방["구역들"] as Array):
		if String(z2["종류"]) == "바닥":
			continue
		var a0: int = L + int(z2["x0"])
		슬롯.append(_슬롯(원점, 칸크기, String(z2["id"]), "L3_중경소품",
			a0, mini(L + int(z2["x1"]), a0 + 베이_폭칸),
			int(z2["지지행"]) - 2, int(z2["지지행"]),
			"소품_%s" % z2["컨셉"], "집_소품_v01", true))

	# L4 전경 — 벽 쪽 기둥. 시야를 다 막지 않게 좁게.
	슬롯.append(_슬롯(원점, 칸크기, "좌벽", "L4_전경", L - 1, L + 1, T, B,
		"기둥_A", "집_전경_v01", false))
	슬롯.append(_슬롯(원점, 칸크기, "우벽", "L4_전경", R - 1, R + 1, T, B,
		"기둥_A", "집_전경_v01", false))
	return 슬롯


static func _슬롯(원점: Vector2, 칸크기: float, 구역: String, 층: String,
		x0칸: int, x1칸: int, y0행: int, y1행: int,
		변형: String, 접합계열: String, 월드고정: bool) -> Dictionary:
	return {
		"구역": 구역, "층": 층, "이동비율": float(층_이동비율[층]),
		"월드고정": 월드고정,
		"사각": Rect2(원점.x + float(x0칸) * 칸크기, 원점.y + float(y0행) * 칸크기,
			float(x1칸 - x0칸) * 칸크기, float(y1행 - y0행) * 칸크기),
		"앵커": Vector2(원점.x + float(x0칸) * 칸크기, 원점.y + float(y0행) * 칸크기),
		"변형": 변형, "접합계열": 접합계열,
	}


## 층별로 **최소 이만큼**은 타일이 깔려야 카메라 끝에서도 그림 밖이 안 드러난다.
##   V = 화면(월드 크기) · D = 카메라 이동 범위 · M = 여유
##   ⚠ 이 값은 **타일을 몇 장 깔지** 계산용이지, 그림 한 장을 이 크기로 늘리라는 뜻이 아니다.
##   ⚠ 전경(1.25)이 제일 크다 — "전경이라 여유가 필요 없다" 는 정반대다.
static func 커버리지(방: Dictionary) -> Dictionary:
	var 칸크기: float = float(방["칸크기"])
	var 월드 := Vector2(float(int(방["폭칸"])) * 칸크기, float(int(방["높이칸"])) * 칸크기)
	var D := Vector2(maxf(0.0, 월드.x - 화면.x), maxf(0.0, 월드.y - 화면.y))
	var out := {"월드": 월드, "화면": 화면, "카메라이동": D, "여유": 여유_M, "층": {}}
	for 층 in 층_이동비율:
		var s: float = float(층_이동비율[층])
		(out["층"] as Dictionary)[층] = {
			"이동비율": s,
			"필요폭": 화면.x + absf(s) * D.x + 2.0 * 여유_M,
			"필요높이": 화면.y + absf(s) * D.y + 2.0 * 여유_M,
		}
	return out
