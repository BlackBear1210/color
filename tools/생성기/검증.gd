extends RefCounted
## ============================================================================
## [2026-09-20 신규] 생성 결과 검증 — **씬을 굽기 전에** 세 가지를 따로 본다
## ----------------------------------------------------------------------------
## ▣ 왜 셋을 나눴나
##   `레벨검사.gd` 는 "갈 수 있나" 만 본다. 그런데 이 게임에서 맵이 망가지는 방식은
##   세 가지이고 **원인이 서로 다르다.**
##     ① 도달성(Reachability) — 점프로 닿지 않는다 → 죽은 콘텐츠·소프트락
##     ② 보행성(Walkability)  — 닿기는 하는데 **걷다가 걸린다** (20 px 단차·48 px 틈·낮은 천장)
##     ③ 사격 시야(LoS)       — 유령 발판을 **쏠 수가 없다** → 진행 불가
##   셋을 한 함수에 섞으면 "왜 실패했는지" 가 안 나와서 생성기를 고칠 수가 없다.
##
## ▣ 왜 씬을 굽기 전에(해석적으로) 보나
##   씬을 구워 엔진으로 검사하면 한 판에 1 초가 든다. 씨앗을 100 개 돌리면 100 초다.
##   여기서 먼저 걸러내면 **살아남은 씨앗만** 굽는다. 대신 이것은 근사이므로,
##   구운 뒤에 반드시 `tools/레벨검사.gd` 로 **엔진 물리 실측**을 한 번 더 한다.
##   (이 파일은 판정의 1차 관문이지 최종 권위가 아니다)
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")


## 전부 검사한다. 돌려주는 것: {"통과": bool, "문제": [String], "경고": [String], "숫자": {...}}
static func 전부(플랫폼들: Array, 사격들: Array, 시작: Vector2, 끝: Vector2) -> Dictionary:
	var 결과 := {"통과": true, "문제": [], "경고": [], "숫자": {}}
	_도달성(플랫폼들, 시작, 끝, 결과)
	_보행성(플랫폼들, 결과)
	_사격시야(플랫폼들, 사격들, 결과)
	결과["통과"] = (결과["문제"] as Array).is_empty()
	return 결과


# ============================================================================
# ① 도달성 — 발판 윗면을 노드로 보고 점프 그래프를 만들어 BFS
# ============================================================================
static func _도달성(플랫폼들: Array, 시작: Vector2, 끝: Vector2, 결과: Dictionary) -> void:
	# 밟을 수 있는 면만 노드가 된다. 구조물(벽·기둥)은 밟으라고 만든 게 아니다.
	#   ★유령 발판도 노드로 넣는다 — "칠하면 생긴다" 가 이 게임의 정상 진행이기 때문이다.
	#     대신 그 유령을 **쏠 수 있는지**는 ③ 이 따로 본다. 둘 다 통과해야 길이다.
	var 면들: Array = []
	for p in 플랫폼들:
		if String(p["종류"]) == "구조":
			continue
		var r: Rect2 = p["사각"]
		면들.append({"x0": r.position.x, "x1": r.end.x, "y": r.position.y, "이름": p["이름"]})

	if 면들.is_empty():
		(결과["문제"] as Array).append("밟을 수 있는 면이 하나도 없다")
		return

	# 시작·끝이 어느 면 위인가
	var 시작면 := _면_찾기(면들, 시작)
	var 끝면 := _면_찾기(면들, 끝)
	if 시작면 < 0:
		(결과["문제"] as Array).append("시작 지점 %s 아래에 발판이 없다" % str(시작))
		return
	if 끝면 < 0:
		(결과["문제"] as Array).append("도착 지점 %s 아래에 발판이 없다" % str(끝))
		return

	# 인접 리스트 — 면 A 의 **양쪽 끝**에서 뛰어 B 에 올라설 수 있나.
	# (레벨검사도 같은 방식이다. 발판 한가운데서 뛰는 경우는 양끝보다 항상 불리하지 않다)
	var 이웃: Array = []
	for i in 면들.size():
		이웃.append([])
	for i in 면들.size():
		var a: Dictionary = 면들[i]
		for j in 면들.size():
			if i == j:
				continue
			var b: Dictionary = 면들[j]
			var 왼끝 := Vector2(a["x0"], a["y"])
			var 오른끝 := Vector2(a["x1"], a["y"])
			if 규격.갈_수_있나(오른끝, b["x0"], b["x1"], b["y"]) \
					or 규격.갈_수_있나(왼끝, b["x0"], b["x1"], b["y"]):
				(이웃[i] as Array).append(j)

	var 닿음 := _bfs(이웃, 시작면)
	if not 닿음.has(끝면):
		(결과["문제"] as Array).append("시작에서 도착까지 갈 수 없다 (점프로 안 닿는 구간이 있다)")

	var 못닿는: Array = []
	for i in 면들.size():
		if not 닿음.has(i):
			못닿는.append(String(면들[i]["이름"]))
	if not 못닿는.is_empty():
		(결과["문제"] as Array).append("도달 불가 발판 %d 개: %s"
			% [못닿는.size(), ", ".join(못닿는.slice(0, 6))])

	# 소프트락 — **올라선 뒤 아무 데도 못 가는** 면.
	# ⚠ 처음에는 "도착으로 못 돌아오는 면" 을 전부 경고했는데, 이 스테이지는 앞으로만 가는
	#   구조라 START 를 포함해 거의 모든 면이 걸렸다(경고 16 개). 그건 설계이지 사고가 아니다.
	#   진짜 사고는 **나가는 길이 하나도 없는 면**이다 — 거기 올라서면 리스폰 말고 방법이 없다.
	var 막다른: Array = []
	for i in 닿음:
		if i == 끝면:
			continue
		if (이웃[i] as Array).is_empty():
			막다른.append(String(면들[i]["이름"]))
	if not 막다른.is_empty():
		(결과["문제"] as Array).append("올라서면 못 나오는 발판 %d 개: %s"
			% [막다른.size(), ", ".join(막다른.slice(0, 6))])

	결과["숫자"]["발판수"] = 면들.size()
	결과["숫자"]["도달률"] = float(닿음.size()) / float(면들.size())


static func _면_찾기(면들: Array, 자리: Vector2) -> int:
	# 그 x 에서 **자리보다 아래에 있는 가장 가까운 면**을 고른다(= 그 자리에서 떨어지면 닿는 면).
	var 최고 := -1
	var 최소거리 := 1e20
	for i in 면들.size():
		var f: Dictionary = 면들[i]
		if 자리.x < f["x0"] - 8.0 or 자리.x > f["x1"] + 8.0:
			continue
		var d: float = float(f["y"]) - 자리.y
		if d >= -8.0 and d < 최소거리:
			최소거리 = d
			최고 = i
	return 최고


static func _bfs(이웃: Array, 시작: int) -> Dictionary:
	var 본것 := {시작: true}
	var 줄: Array = [시작]
	while not 줄.is_empty():
		var n: int = 줄.pop_front()
		for m in 이웃[n]:
			if not 본것.has(m):
				본것[m] = true
				줄.append(m)
	return 본것


# ============================================================================
# ② 보행성 — "갈 수 있다" 와 "걷는 데 방해가 없다" 는 다른 문제다
# ----------------------------------------------------------------------------
# 여기서 잡는 것 네 가지 (전부 실제로 플레이 감각을 망가뜨리는 것들)
#   ㉠ 너무 좁은 발판       : 몸 폭 44 인데 발판이 96 이면 착지가 도박이 된다
#   ㉡ 발이 걸리는 단차     : 이웃한 면의 높이차가 1~64 px — player.gd 는 계단 오르기가 없다
#   ㉢ 발이 빠지는 틈       : 같은 높이 면 사이 0~96 px 틈은 "구멍" 으로 안 읽힌다
#   ㉣ 머리가 박히는 천장   : 발판 윗면 위 160 px 안에 다른 발판 밑면이 있으면 낀다
# ============================================================================
static func _보행성(플랫폼들: Array, 결과: Dictionary) -> void:
	var 문제: Array = 결과["문제"]
	var 경고: Array = 결과["경고"]
	var 밟는: Array = []
	for p in 플랫폼들:
		if String(p["종류"]) != "구조":
			밟는.append(p)

	# ㉠ 착지 폭
	for p in 밟는:
		var r: Rect2 = p["사각"]
		if r.size.x < 규격.최소_착지폭:
			문제.append("%s: 발판 폭 %.0f < 최소 착지 폭 %.0f" % [p["이름"], r.size.x, 규격.최소_착지폭])
		if r.size.x > 규격.최대_발판폭:
			경고.append("%s: 발판 폭 %.0f > %.0f — 전체 색칠이 안 된다"
				% [p["이름"], r.size.x, 규격.최대_발판폭])

	for i in 밟는.size():
		var a: Rect2 = 밟는[i]["사각"]
		for j in range(i + 1, 밟는.size()):
			var b: Rect2 = 밟는[j]["사각"]
			# 겹침 — SS2D 지형이 서로 파고들면 그림도 콜리전도 깨진다
			if a.intersects(b):
				문제.append("%s 와 %s 가 겹친다" % [밟는[i]["이름"], 밟는[j]["이름"]])
				continue
			var 높이차: float = absf(a.position.y - b.position.y)
			var x겹침: bool = a.position.x < b.end.x and b.position.x < a.end.x
			var 가로틈: float = maxf(maxf(b.position.x - a.end.x, a.position.x - b.end.x), 0.0)

			# ㉡ 걸리는 단차 — 가로로 맞닿아 있거나 아주 가까운데 높이차가 어정쩡할 때
			if (x겹침 or 가로틈 < 규격.최소_틈) \
					and 높이차 > 규격.금지_단차_하한 and 높이차 < 규격.금지_단차_상한:
				문제.append("%s ↔ %s: 높이차 %.0f px 단차 — 걷다가 발이 걸린다 (0 또는 %.0f 이상이어야 한다)"
					% [밟는[i]["이름"], 밟는[j]["이름"], 높이차, 규격.금지_단차_상한])

			# ㉢ 발이 빠지는 틈 — 같은 높이인데 틈이 어중간할 때
			if 높이차 <= 규격.금지_단차_하한 and 가로틈 > 0.0 and 가로틈 < 규격.최소_틈:
				문제.append("%s ↔ %s: 틈 %.0f px — 구멍으로 안 읽히고 발만 빠진다 (0 또는 %.0f 이상)"
					% [밟는[i]["이름"], 밟는[j]["이름"], 가로틈, 규격.최소_틈])

	# ㉣ 머리 위 여유 — 모든 지형(구조물 포함)이 천장이 될 수 있다
	for p in 밟는:
		var r: Rect2 = p["사각"]
		for q in 플랫폼들:
			if q["이름"] == p["이름"]:
				continue
			var s: Rect2 = q["사각"]
			if s.end.x <= r.position.x or s.position.x >= r.end.x:
				continue                      # x 가 안 겹치면 천장이 아니다
			var 여유: float = r.position.y - s.end.y   # 내 윗면 − 저쪽 밑면
			if 여유 > 0.0 and 여유 < 규격.최소_통로높이:
				문제.append("%s 위 %.0f px 에 %s 밑면 — 머리(97)가 박힌다 (최소 %.0f)"
					% [p["이름"], 여유, q["이름"], 규격.최소_통로높이])


# ============================================================================
# ③ 사격 시야 — 총알은 **직선이 아니라 포물선**이다
# ----------------------------------------------------------------------------
# 탄속 1150 px/s · 중력 900 px/s² (총.gd·총알.gd 와 같은 값).
# 수평으로 쏘면 1,000 px 앞에서 약 340 px 아래로 떨어진다. "보이니까 맞는다" 가 아니다.
# → 조준각을 훑으며 총알을 그대로 시뮬레이션해서 **맞는 각이 하나라도 있는지** 본다.
# ============================================================================
static func _사격시야(플랫폼들: Array, 사격들: Array, 결과: Dictionary) -> void:
	for s in 사격들:
		var 목표: Rect2 = s["목표"]
		var 대상: String = s.get("대상", "")
		if not 맞출_수_있나(플랫폼들, s["자리"], 목표, 대상):
			(결과["문제"] as Array).append(
				"%s 를 %s 에서 쏠 수 없다 (포물선이 못 닿거나 지형에 막힌다)"
					% [대상, str(s["자리"].round())])
		# F 청크: "여기서는 **막혀야** 한다" 를 같이 확인한다. 안 막히면 퍼즐이 성립하지 않는다.
		if s.has("막혀야_하는_자리"):
			if 맞출_수_있나(플랫폼들, s["막혀야_하는_자리"], 목표, 대상):
				(결과["경고"] as Array).append(
					"%s 가 아래에서도 맞는다 — 시야 퍼즐이 성립하지 않는다(그냥 쏘면 된다)" % 대상)


## 자리에서 목표 사각을 맞출 수 있나. 맞으면 true.
static func 맞출_수_있나(플랫폼들: Array, 자리: Vector2, 목표: Rect2, 대상: String) -> bool:
	var 중심 := 목표.get_center()
	var 오른쪽 := 중심.x >= 자리.x
	# 조준각 −70° ~ +70° 를 5° 간격으로. 사람이 마우스로 잡을 수 있는 범위다.
	for 각 in range(-70, 71, 5):
		if _한_발(플랫폼들, 자리, float(각), 오른쪽, 목표, 대상):
			return true
	return false


## 총알 한 발을 그대로 굴린다. ★총알.gd 와 **순서가 같아야 한다** —
##   중력을 속도에 먼저 더하고 그 다음 위치를 옮긴다. 순서가 바뀌면 궤적이 어긋난다.
static func _한_발(플랫폼들: Array, 자리: Vector2, 각도: float, 오른쪽: bool,
		목표: Rect2, 대상: String) -> bool:
	var 속도 := Vector2.RIGHT.rotated(deg_to_rad(각도)) * 규격.탄속
	if not 오른쪽:
		속도.x = -속도.x
	var p := 자리
	# 1/120 로 쪼갠다 — 1/60 이면 한 스텝이 19 px 이라 얇은 지형을 뚫고 지나갈 수 있다.
	var dt := 규격.물리_틱 * 0.5
	var 걸음: int = int(규격.탄_수명 / dt)
	for _i in 걸음:
		속도.y += 규격.탄_중력 * dt
		p += 속도 * dt
		if 목표.has_point(p):
			return true
		for q in 플랫폼들:
			if String(q["이름"]) == 대상:
				continue
			if (q["사각"] as Rect2).has_point(p):
				return false       # 다른 지형에 먼저 막혔다
		# 화면 밖으로 너무 멀리 나가면 포기(수명 안에 못 맞는다)
		if absf(p.x - 자리.x) > 4000.0 or p.y - 자리.y > 4000.0:
			return false
	return false
