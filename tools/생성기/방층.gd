extends RefCounted
## ============================================================================
## [2026-09-27 신규] 방·복도 파기 — **배경 레이어를 쓸 수 있는 지형**을 만든다
## ----------------------------------------------------------------------------
## ▣ 왜 새 파기 모듈인가 (도형님 지시 2026-09-27)
##   "방 생성기 만들어서 집-1을 **방 모양**으로 다시 만들어."
##   "복도 지형은 **가로로 길쭉한 직사각형** 모양으로 큰 틀을 잡고 가는 게 좋아.
##    내려가는 복도계단 지형을 그대로 가져가면 **배경 이미지 레이어를 내려가면서
##    움직임을 줘야 하는데 이건 그걸 위반되는 행동**이야."
##
##   이 마지막 문장이 이 파일의 존재 이유다. `동굴층.gd`(층 4 겹)와 `계단층.gd`(내려감)는
##   **카메라가 세로로 크게 움직인다.** 그러면 시차 배경이 세로로 흘러야 하는데,
##   방 그림은 "방 한 칸"이라 세로로 흐르면 방이 위아래로 복제된다.
##   → **모든 방과 복도가 같은 바닥 높이를 쓴다.** 카메라 세로 이동이 한 방 높이 안에 갇힌다.
##
## ▣ 그럼 높낮이는 어디서 나오나
##   바닥이 아니라 **방 안의 선반**에서 나온다. 소파 → 탁자 → 책장 위로 올라갔다가
##   다시 내려온다. 이게 레인월드·Ori 의 방 구성이고, 배경 한 장으로 커버된다.
##
## ▣ 비율 — "작은 생명체가 큰 집을 돌아다닌다"
##   플레이어 96 px, 화면 1080 px → 플레이어는 화면 높이의 **8.9 %**.
##   (Ori 약 10 % · Hollow Knight 약 11 % · Rain World 약 7 % — 우리는 그 사이다)
##   그래서 "작아 보이게" 하려고 플레이어를 줄일 필요가 없다. **방을 키우면 된다.**
##     · 방 천장 높이 = 사람 키의 **14~20 배** (1,344~1,920 px)
##     · 방 가로 폭   = 사람 키의 **30~52 배** (2,880~4,992 px)
##     · 복도 천장     = 사람 키의 **8~10 배**  (768~960 px) — 방보다 낮아야 복도로 읽힌다
##   이 대비(방은 높고 복도는 낮다)가 두 공간을 구분하는 제일 강한 신호다.
##
## ▣ 돌려주는 것은 `동굴층.gd`·`계단층.gd` 와 **완전히 같은 모양**이다.
##   그래서 관문·윤곽·배치·조립 단계는 한 줄도 안 고쳐도 된다.
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")

const 암반: int = 1
const 빈칸: int = 0


static func 파기(설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var W: int = int(설정.폭칸)
	var H: int = int(설정.높이칸)
	var 외곽: int = maxi(int(설정.외곽두께), 1)
	var 칸 := PackedByteArray()
	칸.resize(W * H)
	칸.fill(암반)

	var 복도인가: bool = bool(설정.get("복도모드"))

	# ── 가로 범위 ───────────────────────────────────────────────────────────
	# 외곽 안쪽에서 2 칸 더 들어간다 — 벽에 딱 붙으면 벽면 폴리곤이 지저분해진다.
	var L: int = 외곽 + 2
	var R: int = W - 외곽 - 3
	if R - L < 30:
		return {}

	# ── ★바닥은 **한 줄**이다 ───────────────────────────────────────────────
	#   모든 방이 이 높이를 공유한다. 배경이 세로로 안 흘러도 되는 이유가 이것이다.
	var 바닥y: int = H - 외곽 - 2

	var 방들: Array = []
	var 배치물 := {"플랫폼": [], "위험물": [], "체크포인트": []}
	var 바닥줄 := PackedInt32Array()
	바닥줄.resize(W)
	바닥줄.fill(-1)

	if 복도인가:
		_복도_파기(칸, 바닥줄, 설정, rng, W, H, L, R, 바닥y, 방들, 배치물)
	else:
		_방들_파기(칸, 바닥줄, 설정, rng, W, H, L, R, 바닥y, 방들, 배치물)

	if 방들.is_empty():
		return {}

	var 시작방: Dictionary = 방들[0]
	var 출구방: Dictionary = 방들[방들.size() - 1]
	var 시작칸 := Vector2i(int(시작방["사각"].position.x) + 3, 바닥y - 1)
	var 출구칸 := Vector2i(int(출구방["사각"].end.x) - 3, 바닥y - 1)

	return {
		"칸": 칸, "폭칸": W, "높이칸": H, "칸크기": float(설정.칸크기),
		"원점": Vector2(설정.원점_x, 설정.원점_y),
		"방들": 방들,
		"통로들": [],                 # 세로 갱도가 없다 → `배치.gd _사다리()` 가 할 일이 없다
		"층들": [바닥y] as Array[int],  # 층은 하나 = 바닥 한 줄. 관문이 여기 선다
		"바닥줄": [바닥줄],
		"시작칸": 시작칸, "출구칸": 출구칸,
		"시작방": 시작방, "출구방": 출구방,
		"배치물": 배치물,
	}


# ============================================================================
# 방 — 큰 홀 여러 개를 문으로 잇는다
# ----------------------------------------------------------------------------
# ┌───────────────┐   ┌──────────────────┐   ┌─────────────┐
# │               │   │                  │   │             │   ← 천장 높이는 방마다 다르다
# │   ▬▬   ▬▬▬    │███│      ▬▬▬         │███│    ▬▬  ▬▬   │   ← 선반(가구) = 칠할 수 있는 발판
# │          ▬▬▬  │ ▯ │  ▬▬▬             │ ▯ │        ▬▬▬  │   ← ▯ = 문(다음 방으로)
# └───────────────┴───┴──────────────────┴───┴─────────────┘
#  ─────────────────── 바닥은 전부 같은 높이 ───────────────────
# ============================================================================
static func _방들_파기(칸: PackedByteArray, 바닥줄: PackedInt32Array, 설정: RefCounted,
		rng: RandomNumberGenerator, W: int, H: int, L: int, R: int, 바닥y: int,
		방들: Array, 배치물: Dictionary) -> void:
	var 벽두께: int = maxi(int(설정.get("방_벽두께")), 2)
	var 문높이: int = maxi(int(설정.get("문_높이칸")), 4)
	var 폭최소: int = maxi(int(설정.get("방_폭칸_최소")), 24)
	var 폭최대: int = maxi(int(설정.get("방_폭칸_최대")), 폭최소)
	var 높이최소: int = maxi(int(설정.방_최소높이), 8)
	var 높이최대: int = maxi(int(설정.방_최대높이), 높이최소)

	var x: int = L
	var 번호 := 0
	while x < R - 폭최소:
		var 폭: int = rng.randi_range(폭최소, 폭최대)
		폭 = mini(폭, R - x)
		if 폭 < 폭최소:
			break
		var 높이: int = rng.randi_range(높이최소, 높이최대)
		# 천장이 맵 위를 뚫지 않게 — 뚫으면 껍데기 폴리곤이 바깥으로 새어 나간다
		높이 = mini(높이, 바닥y - 외곽여유(설정))
		var 천장y: int = 바닥y - 높이

		# 방 속을 판다(바닥 줄은 남긴다 — 바닥은 밟는 면이다)
		for gy in range(천장y, 바닥y):
			for gx in range(x, x + 폭):
				칸[gy * W + gx] = 빈칸
		for gx in range(x, x + 폭):
			바닥줄[gx] = 바닥y

		var 방 := {
			"사각": Rect2i(x, 천장y, 폭, 높이),
			"이름": "방%02d" % 번호,
			"바닥y": 바닥y, "천장y": 천장y, "번호": 번호,
		}
		방들.append(방)

		# 방 안 선반(가구) — 여기서 높낮이가 나온다
		_선반_놓기(설정, rng, 방, 배치물, 번호)

		번호 += 1
		# 다음 방으로 가는 문 — 벽을 뚫는다. 바닥에서 `문높이` 칸만큼.
		var 문x: int = x + 폭
		if 문x + 벽두께 >= R:
			break
		for gy in range(바닥y - 문높이, 바닥y):
			for gx in range(문x, 문x + 벽두께):
				칸[gy * W + gx] = 빈칸
		for gx in range(문x, 문x + 벽두께):
			바닥줄[gx] = 바닥y
		x = 문x + 벽두께


## 천장 위에 남겨 둘 여유(칸). 껍데기가 맵 밖으로 새지 않게 한다.
static func 외곽여유(설정: RefCounted) -> int:
	return maxi(int(설정.외곽두께), 1) + 3


# ============================================================================
# 복도 — 가로로 길쭉한 직사각형 하나
# ----------------------------------------------------------------------------
# ★도형님 지시: "복도 지형은 가로로 길죽한 직사각형 모양으로 큰 틀을 잡고 가는 게 좋아."
#   바닥은 **완전히 평평**하다. 내려가지 않는다. 그래야 배경이 가로로만 흐른다.
#   재미는 관문(점프·색·칠하기)과 드문드문한 높은 선반에서 나온다.
# ============================================================================
static func _복도_파기(칸: PackedByteArray, 바닥줄: PackedInt32Array, 설정: RefCounted,
		rng: RandomNumberGenerator, W: int, H: int, L: int, R: int, 바닥y: int,
		방들: Array, 배치물: Dictionary) -> void:
	var 높이: int = rng.randi_range(maxi(int(설정.방_최소높이), 6), maxi(int(설정.방_최대높이), 8))
	높이 = mini(높이, 바닥y - 외곽여유(설정))
	var 천장y: int = 바닥y - 높이

	for gy in range(천장y, 바닥y):
		for gx in range(L, R):
			칸[gy * W + gx] = 빈칸
	for gx in range(L, R):
		바닥줄[gx] = 바닥y

	방들.append({
		"사각": Rect2i(L, 천장y, R - L, 높이),
		"이름": "복도00",
		"바닥y": 바닥y, "천장y": 천장y, "번호": 0,
	})

	# 복도에도 선반을 드문드문 — 다만 방보다 훨씬 적고 낮다(복도는 지나가는 곳이다)
	var 간격: int = maxi(int(설정.get("선반_간격칸")), 26)
	var gx2: int = L + 12
	var n := 0
	while gx2 < R - 16:
		if rng.randf() < 0.55:
			_선반_사슬(설정, rng, 배치물, gx2, 바닥y, 천장y, "복도선반%02d" % n, 2)
			n += 1
		gx2 += 간격 + rng.randi_range(-4, 6)


# ============================================================================
# 선반(가구) — 올라갔다 내려오는 높낮이를 만든다
# ----------------------------------------------------------------------------
# ▣ 왜 사슬로 놓나 (한 장씩 높이 쌓으면 안 되는 이유)
#   발판 두께 112 + 몸 높이 97 = **209 px**. 세로로 1 칸(96)씩 쌓으면 아래 발판에 섰을 때
#   머리가 윗 발판 밑면에 박힌다. → **가로로 벌리면서 1 칸씩 올린다.**
#     · 한 단 오름 = 1 칸(96) ≤ 올라갈 수 있는 높이 112  ✔
#     · 발판 사이 틈 = 2 칸(192) ≤ 건널 수 있는 거리 224 ✔
#     · 발판 폭 3~5 칸(288~480) — 최소 착지폭 192 이상, 전체칠 한계 576 이하 ✔
# ============================================================================
static func _선반_놓기(설정: RefCounted, rng: RandomNumberGenerator, 방: Dictionary,
		배치물: Dictionary, 방번호: int) -> void:
	var 사각: Rect2i = 방["사각"]
	var 개수: int = rng.randi_range(1, 3)
	var 자리들: Array[int] = []
	for i in 개수:
		# 방을 개수+1 등분해서 각 구간 안에 하나씩 — 몰려 있으면 방이 반쪽만 쓰인다
		var 구간폭: int = int(사각.size.x / float(개수 + 1))
		var cx: int = 사각.position.x + 구간폭 * (i + 1) - rng.randi_range(2, 6)
		자리들.append(cx)
	var n := 0
	for cx in 자리들:
		var 단수: int = rng.randi_range(2, 4)
		_선반_사슬(설정, rng, 배치물, cx, int(방["바닥y"]), int(방["천장y"]),
			"선반%02d_%02d" % [방번호, n], 단수)
		n += 1


static func _선반_사슬(설정: RefCounted, rng: RandomNumberGenerator, 배치물: Dictionary,
		시작x: int, 바닥y: int, 천장y: int, 이름: String, 단수: int) -> void:
	var 칸크기: float = float(설정.칸크기)
	var 원점 := Vector2(설정.원점_x, 설정.원점_y)
	var 방향: int = 1 if rng.randf() < 0.5 else -1
	var x: int = 시작x
	var y: int = 바닥y - 2                       # 첫 단은 바닥에서 2 칸 위(=192 px)
	for i in 단수:
		var 폭칸: int = rng.randi_range(3, 5)     # 288~480 px
		# 천장을 뚫지 않게 — 뚫으면 머리가 끼어 못 지나간다
		if y <= 천장y + 2:
			break
		var 좌상 := 원점 + Vector2(float(x) * 칸크기, float(y) * 칸크기)
		배치물["플랫폼"].append({
			"이름": "%s_%d" % [이름, i + 1],
			"사각": Rect2(좌상.x, 좌상.y, 칸크기 * float(폭칸), 규격.발판_두께),
			"종류": "발판", "색": 규격.검정 if rng.randf() < 0.6 else 규격.흰색,
			"칠방식": 0,                          # 폭 480 이하라 전체 색칠이 된다
			"일방통행": false,
			"의도형태": "직사각형",
		})
		# 다음 단 — 가로로 (폭 + 틈 2 칸) 만큼 벌리고 1 칸 올린다
		x += 방향 * (폭칸 + 2)
		y -= 1
