extends RefCounted
## ============================================================================
## [2026-09-20 신규] 스테이지 생성기 — Stage → Section → Chunk → Platform
## ----------------------------------------------------------------------------
## ▣ 완전 랜덤을 쓰지 않는 이유
##   `random position / random size` 로 뿌리면 10,000 px 짜리 맵에서 **난이도 곡선이 사라진다.**
##   처음 3 초에 시야 퍼즐이 나오고 마지막에 평지가 나온다. 그래서 층을 나눈다:
##     Stage   — 씨앗 하나 · 목표 길이 · 색 구간 계획
##     Section — 난이도 단계 하나(도입 → 이동 → 색 → 사격 → 시야 → 복합 → 마무리)
##     Chunk   — "색 반전 점프 궤적" 한 묶음 (청크.gd)
##     Platform— 실제 SS2D 조각
##   랜덤은 **각 단계 안에서만** 쓴다. 그래서 매번 다르지만 매번 말이 된다.
##
## ▣ 생성 즉시 검사 (이 파일의 핵심)
##   청크를 하나 붙일 때마다 그 자리에서 검증한다(겹침·단차·틈·천장·사격 시야).
##   실패하면 **그 청크만** 다시 뽑는다(최대 8 번). 그래도 안 되면 기본 이동으로 대체한다.
##   → 전부 만들고 나서 검사하면 실패 시 버릴 것이 너무 많다. 국소 재시도가 훨씬 싸다.
##
## ▣ 씨앗
##   모든 난수는 `RandomNumberGenerator` 하나에서 나온다. 같은 씨앗 = 같은 맵.
##   씨앗은 씬 루트 메타와 옆 `.json` 에 같이 남긴다(버그 재현·맵 공유용).
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")
const 청크_S := preload("res://tools/생성기/청크.gd")
const 검증_S := preload("res://tools/생성기/검증.gd")

## 한 청크를 몇 번까지 다시 뽑나. 8 이면 거의 항상 통과한다(실측: 평균 재시도 1 회 미만).
const 재시도_한계: int = 8


## ============================================================================
## 난이도 곡선 — 구간(Section) 표
## ----------------------------------------------------------------------------
## `강제` 는 그 구간에서 **반드시 한 번은 나오는** 청크다. 이것이 없으면 씨앗에 따라
## "색 퍼즐이 한 번도 안 나오는 1-1" 같은 게 나온다.
## `허용` 은 나머지를 채울 후보. 실제 선택은 설정의 `청크_가중치` 로 가중 추첨한다.
## ============================================================================
static func _구간표() -> Array:
	return [
		{"이름": "도입",   "몫": 0.10, "강제": ["A", "A", "J"],      "허용": ["A", "B", "C", "J"]},
		{"이름": "이동",   "몫": 0.15, "강제": ["B", "C"],           "허용": ["A", "B", "C", "G", "J"]},
		{"이름": "색",     "몫": 0.18, "강제": ["D", "D"],           "허용": ["A", "B", "C", "D", "J"]},
		{"이름": "사격",   "몫": 0.18, "강제": ["E", "E"],           "허용": ["A", "B", "E", "J"]},
		{"이름": "시야",   "몫": 0.15, "강제": ["F", "G"],           "허용": ["A", "F", "G", "C", "J"]},
		{"이름": "복합",   "몫": 0.17, "강제": ["I", "H"],           "허용": ["A", "E", "H", "I", "D", "J"]},
		{"이름": "마무리", "몫": 0.07, "강제": ["J", "A"],           "허용": ["A", "C", "J"]},
	]


## 스테이지 하나를 만든다.
##   돌려주는 것 = {플랫폼, 위험물, 사격, 공략, 청크들, 시작, 끝, 범위:Rect2, 씨앗, 통계}
static func 생성(설정: RefCounted, 씨앗: int) -> Dictionary:
	var rng := RandomNumberGenerator.new()
	rng.seed = 씨앗

	var 플랫폼: Array = []
	var 위험물: Array = []
	var 사격: Array = []
	var 공략: Array = []
	var 청크들: Array = []
	var 기록: Dictionary = {}          ## 재시도·대체 통계 (왜 그 청크가 안 나왔는지)

	# ── 시작 발판 ───────────────────────────────────────────────────────────
	# 시작 색은 **검정**이다. "안 칠한 지형은 검정" 이라는 규칙 때문에(색규칙.gd),
	# 흰색으로 시작하면 플레이어가 첫 바닥에서 바로 죽는다.
	var 시작색: int = 규격.검정
	var 시작판 := {
		"이름": "START_바닥",
		"사각": Rect2(0.0, float(설정.바닥_y), 512.0, 규격.바닥_두께),
		"종류": "바닥", "색": 시작색, "칠방식": 0, "일방통행": false,
	}
	플랫폼.append(시작판)
	var 시작위치 := Vector2(192.0, float(설정.바닥_y))

	var 상태 := {"x": 512.0, "y": float(설정.바닥_y), "색": 시작색, "층": 0}
	공략.append(["가", 320.0])

	# ── 구간을 돌면서 청크를 붙인다 ─────────────────────────────────────────
	var 색_구간길이 := 0.0          ## 지금 색으로 얼마나 왔나 (색 구간이 너무 길어지는 것 방지)
	var 색_목표: float = rng.randf_range(float(설정.색구간_최소), float(설정.색구간_최대))
	var 번호 := 0

	# ★구간 경계는 **절대 좌표로 미리 잡는다.**
	#   처음에는 구간마다 "지금 x + 목표×몫" 으로 잡았는데, 청크는 경계를 조금씩 넘기므로
	#   그 초과분이 다음 구간 경계에 더해져 **누적**됐다. 목표 10,000 을 줬는데 13,264 가
	#   나온 이유가 이것이다(2026-09-20 실측). 절대 좌표로 잡으면 초과는 한 청크 이내로 끝난다.
	var _시작x: float = float(상태["x"])
	var _누적몫 := 0.0
	for 구간 in _구간표():
		_누적몫 += float(구간["몫"])
		var 구간_끝: float = _시작x + float(설정.목표_길이) * _누적몫
		var 대기: Array = (구간["강제"] as Array).duplicate()
		# ★`대기` 가 남아 있으면 구간 경계를 넘겨서라도 끝까지 넣는다.
		#   앞 구간이 경계를 조금 넘기면 뒤 구간이 통째로 건너뛰어질 수 있고, 그러면
		#   그 구간의 **강제 청크(F·I 같은 것)가 영영 안 나온다.** 길이 ±10 % 보다 이게 중요하다.
		while float(상태["x"]) < 구간_끝 or not 대기.is_empty():
			번호 += 1
			var 종류: String = ""
			if not 대기.is_empty():
				종류 = 대기.pop_front()
			else:
				종류 = _고르기(구간["허용"], 설정.청크_가중치, rng)

			# 색 구간 관리 — 너무 짧게 자주 바뀌면 색이 장식이 되고,
			# 너무 길면 색 전환을 잊어버린다. 목표 길이를 넘기면 색 전환(D)을 강제한다.
			if 색_구간길이 > 색_목표 and 종류 != "D" and 종류 != "I":
				종류 = "D"
			elif 종류 == "D" and 색_구간길이 < float(설정.색구간_최소) * 0.5:
				종류 = "A"          # 방금 바꿨는데 또 바꾸려 하면 평범한 이동으로
			# ⚠ I(복합)는 이 제한에서 뺀다. 색 전환은 I 의 **일부**일 뿐이고 본체는
			#   "유령을 칠해 건넌다" 다. 여기 걸어 두면 I 가 한 번도 안 나온다(실제로 그랬다).

			var 이름 := "%s_C%02d_%s" % [구간["이름"], 번호, 종류]
			var 결과 := _청크_붙이기(종류, 이름, 상태, 설정, rng, 플랫폼, 기록)
			if 결과.is_empty():
				break                # 더 못 붙이면 이 구간을 끝낸다
			var c: Dictionary = 결과

			var 이전x: float = 상태["x"]
			for p in c["플랫폼"]:
				플랫폼.append(p)
			for h in c["위험물"]:
				위험물.append(h)
			for s in c["사격"]:
				사격.append(s)
			for st in c["공략"]:
				공략.append(st)
			청크들.append({
				"이름": c["이름"], "종류": c["종류"], "난이도": c["난이도"],
				"시작": Vector2(이전x, float(상태["y"])),
				"출구": Vector2(float(c["출구"]["x"]), float(c["출구"]["y"])),
				"메모": c.get("메모", ""),
			})

			var 새색: int = c["출구"]["색"]
			if 새색 != int(상태["색"]):
				색_구간길이 = 0.0
				색_목표 = rng.randf_range(설정.색구간_최소, 설정.색구간_최대)
			else:
				색_구간길이 += float(c["출구"]["x"]) - 이전x
			상태 = {"x": c["출구"]["x"], "y": c["출구"]["y"], "색": 새색, "층": c["출구"]["층"]}

	# ── 끝 발판 ─────────────────────────────────────────────────────────────
	var 끝판 := {
		"이름": "END_바닥",
		"사각": Rect2(규격.격자맞춤(float(상태["x"]) + 160.0), 규격.격자맞춤(float(상태["y"])),
			512.0, 규격.바닥_두께),
		"종류": "바닥", "색": 상태["색"], "칠방식": 0, "일방통행": false,
	}
	플랫폼.append(끝판)
	공략.append(["가", 끝판["사각"].position.x + 256.0])
	var 끝위치 := Vector2(끝판["사각"].position.x + 256.0, 끝판["사각"].position.y)

	# ── 외곽 셸 — 화면 밖 빈 공간 방지 (가이드라인 §3-1) ────────────────────
	var 범위 := _범위(플랫폼)
	플랫폼.append_array(_외곽(범위, 설정))

	return {
		"플랫폼": 플랫폼, "위험물": 위험물, "사격": 사격, "공략": 공략,
		"청크들": 청크들, "시작": 시작위치, "끝": 끝위치,
		"범위": _범위(플랫폼), "씨앗": 씨앗, "기록": 기록,
		"진행길이": 끝위치.x - 시작위치.x,
	}


## 청크 하나를 뽑아서 **그 자리에서 검사**한다. 실패하면 다시 뽑는다.
##   `기록` 에 재시도·대체 사유를 남긴다 — ★이게 없으면 "F 청크가 왜 한 번도 안 나오지" 를
##   영원히 모른다(실제로 처음 돌렸을 때 F 와 I 가 통째로 대체되고 있었다).
static func _청크_붙이기(종류: String, 이름: String, 상태: Dictionary, 설정: RefCounted,
		rng: RandomNumberGenerator, 기존: Array, 기록: Dictionary) -> Dictionary:
	var 사유 := ""
	for _시도 in 재시도_한계:
		var c := 청크_S.만들기(종류, 이름, 상태, 설정, rng)
		if c.is_empty():
			continue
		사유 = _청크_안되는_이유(c, 기존)
		if 사유 == "":
			return c
		기록["재시도"] = int(기록.get("재시도", 0)) + 1
		# 실패 — 같은 종류로 다시 뽑는다(난수가 달라지므로 다른 배치가 나온다)
	# 8 번 실패했으면 그 자리에 그 청크는 안 들어간다. 제일 단순한 이동으로 대체한다.
	# ★여기서 빈 값을 돌려주고 끝내면 스테이지가 중간에 끊긴다 — 반드시 대체를 넣는다.
	var 대체표: Dictionary = 기록.get("대체", {})
	대체표[종류] = String(대체표.get(종류, 사유))
	기록["대체"] = 대체표
	for _시도 in 재시도_한계:
		var c := 청크_S.만들기("A", 이름 + "_대체", 상태, 설정, rng)
		if not c.is_empty() and _청크_안되는_이유(c, 기존) == "":
			return c
	return {}


## 국소 검사 — 새 청크의 플랫폼이 기존 것과 싸우지 않는가. 괜찮으면 빈 문자열.
## ⚠ 전체 도달성은 여기서 안 본다(아직 뒤가 안 만들어졌다). 그건 마지막에 한 번에 본다.
static func _청크_안되는_이유(c: Dictionary, 기존: Array) -> String:
	var 합: Array = 기존.duplicate()
	합.append_array(c["플랫폼"])
	var r := {"통과": true, "문제": [], "경고": [], "숫자": {}}
	검증_S._보행성(합, r)
	if not (r["문제"] as Array).is_empty():
		return String((r["문제"] as Array)[0])
	# 이 청크가 요구하는 사격이 실제로 가능한가 (포물선 · 지형 막힘)
	for s in c["사격"]:
		if not 검증_S.맞출_수_있나(합, s["자리"], s["목표"], s.get("대상", "")):
			return "사격 불가: %s" % s.get("대상", "?")
	return ""


## 가중 추첨. 설정에 없는 종류는 가중치 1 로 본다.
static func _고르기(후보: Array, 가중치: Dictionary, rng: RandomNumberGenerator) -> String:
	var 합 := 0.0
	for k in 후보:
		합 += float(가중치.get(k, 1))
	var r := rng.randf() * 합
	for k in 후보:
		r -= float(가중치.get(k, 1))
		if r <= 0.0:
			return String(k)
	return String(후보[0])


static func _범위(플랫폼: Array) -> Rect2:
	if 플랫폼.is_empty():
		return Rect2()
	var r: Rect2 = 플랫폼[0]["사각"]
	for p in 플랫폼:
		r = r.merge(p["사각"])
	return r


## 외곽 셸 — 왼벽·오른벽·천장. 밟으라고 만든 게 아니라 **화면 밖 빈 공간을 막는** 것이다.
##   · `칠방식 = 2`(안칠해짐) → 색 규칙 밖. 칠할 수 없는 것으로 죽이면 안 된다(색규칙.gd).
##   · `종류 = "구조"` → 검증기의 도달성 노드에서 빠진다.
## ⚠ 천장은 **가장 높은 발판보다 최소 통로 높이 위**에 둔다. 안 그러면 머리가 박힌다.
static func _외곽(범위: Rect2, 설정: RefCounted) -> Array:
	var 여유 := 320.0
	var 천장y := 규격.격자맞춤(범위.position.y - 규격.최소_통로높이 - 128.0)
	var 바닥끝 := 규격.격자맞춤(범위.end.y + 여유)
	var 왼 := 규격.격자맞춤(범위.position.x - 여유)
	var 오른 := 규격.격자맞춤(범위.end.x + 여유)
	var 기본 := {"종류": "구조", "색": 규격.검정, "칠방식": 2, "일방통행": false}
	var out: Array = []
	# ★이름을 "천장…"·"벽…" 으로 시작하게 짓는다 — `레벨검사.gd` 의 `구조물_접두`
	#   (["천장","굴뚝벽","벽","받침"])가 **이름 앞글자로** 구조물을 가려내기 때문이다.
	#   "외곽_천장" 이라고 지었더니 밟는 지형으로 세어 "도달 불가 3 개" 가 떴다(2026-09-20).
	var 천장: Dictionary = 기본.duplicate()
	천장["이름"] = "천장_외곽"
	천장["사각"] = Rect2(왼, 천장y - 192.0, 오른 - 왼, 192.0)
	out.append(천장)
	var 왼벽: Dictionary = 기본.duplicate()
	왼벽["이름"] = "벽_외곽_왼"
	왼벽["사각"] = Rect2(왼 - 192.0, 천장y - 192.0, 192.0, 바닥끝 - 천장y + 192.0)
	out.append(왼벽)
	var 오른벽: Dictionary = 기본.duplicate()
	오른벽["이름"] = "벽_외곽_오른"
