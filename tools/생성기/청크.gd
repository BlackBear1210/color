extends RefCounted
## ============================================================================
## [2026-09-20 신규] 청크 사전 — **"플랫폼 하나" 가 아니라 "플레이 상황 하나"**
## ----------------------------------------------------------------------------
## ▣ 이 파일의 사고방식
##   흔한 절차 생성은 `random position / random size` 로 발판을 흩뿌린다.
##   그렇게 하면 이 게임에서는 **반드시 망가진다.** 색을 못 바꾸는 자리에서 색이 바뀌거나,
##   쏠 수 없는 각도에 유령 발판이 놓이거나, 발이 걸리는 20 px 단차가 생긴다.
##   → 여기서는 **"색 반전 점프 궤적"** 을 최소 단위로 본다.
##     청크 하나 = [출발 발판 → 점프 → (공중 조준·사격) → 착지 발판] 한 묶음.
##     즉 청크는 이미 **풀 수 있는 상태로 태어난다.** 검증기는 보증이지 설계자가 아니다.
##
## ▣ 청크가 돌려주는 것
##   {
##     "종류": "E", "이름": "S02_C05_AIR", "난이도": 1~5,
##     "플랫폼": [ {이름, 사각:Rect2, 종류:"바닥|발판|유령|구조", 색, 칠방식, 일방통행} ],
##     "위험물": [ {종류, 위치:Vector2} ],
##     "사격":   [ {자리:Vector2, 목표:Rect2, 대상:String} ],   ← 시야 검증기가 본다
##     "공략":   [ 주행검사 문법 그대로 ],
##     "출구":   {x, y, 색},
##   }
##
## ▣ 새 청크를 추가하는 법 (다른 작업자용)
##   1. `_청크_X()` 함수를 하나 만든다 (아래 것들을 복사)
##   2. `만들기()` 의 match 에 한 줄 추가
##   3. `설정.gd` 의 `청크_가중치` 에 그 글자를 넣는다
##   ★출구 좌표를 정확히 돌려주는 것만 지키면 나머지는 생성기가 알아서 잇는다.
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")


## 청크 하나를 만든다.
##   상태 = {"x": 진행 좌표(직전 발판 오른쪽 끝), "y": 그 발판 윗면, "색": 지금 구간 색, "층": int}
static func 만들기(종류: String, 이름: String, 상태: Dictionary, 설정: RefCounted,
		rng: RandomNumberGenerator) -> Dictionary:
	match 종류:
		"A": return _기본(이름, 상태, 설정, rng)
		"B": return _상승(이름, 상태, 설정, rng)
		"C": return _하강(이름, 상태, 설정, rng)
		"D": return _색반전(이름, 상태, 설정, rng)
		"E": return _공중사격(이름, 상태, 설정, rng)
		"F": return _시야(이름, 상태, 설정, rng)
		"G": return _수직(이름, 상태, 설정, rng)
		"H": return _위험(이름, 상태, 설정, rng)
		"I": return _복합(이름, 상태, 설정, rng)
		"J": return _휴식(이름, 상태, 설정, rng)
	return {}


# ============================================================================
# 도우미
# ============================================================================
## 발판 하나. 윗면이 착지면이고 두께는 아래로 내려간다.
## ⚠ 폭은 반드시 격자에 맞추고 `최소_착지폭`(128) 이상 `최대_발판폭`(576) 이하로 둔다.
##   576 을 넘으면 **전체 색칠이 안 되는 지형**이 된다(지형.gd `전체_색칠_최대긴변`).
static func _발판(이름: String, x0: float, 윗면: float, 폭: float, 색: int,
		종류: String = "발판", 일방통행: bool = true) -> Dictionary:
	폭 = clampf(규격.격자맞춤(폭), 규격.최소_착지폭, 규격.최대_발판폭)
	var 두께: float = 규격.발판_두께 if 종류 == "발판" else 규격.바닥_두께
	return {
		"이름": 이름,
		"사각": Rect2(규격.격자맞춤(x0), 규격.격자맞춤(윗면), 폭, 두께),
		"종류": 종류,
		"색": 색,
		# 0 = 전체칠 가능. 폭이 576 이하로 잘려 있으므로 전부 칠할 수 있다.
		"칠방식": 0,
		# 공중 발판은 일방통행 — 두 칸 위 발판 밑면에 머리(97)가 박히는 사고를 막는다
		# (하수도 2-2 주행검사에서 실제로 났던 것).
		"일방통행": 일방통행 and 종류 == "발판",
	}


## 칠해야 생기는 유령 발판. 안 칠하면 몸이 통과한다 = **아직 길이 아니다.**
static func _유령(이름: String, x0: float, 윗면: float, 폭: float, 색: int) -> Dictionary:
	var p := _발판(이름, x0, 윗면, 폭, 색, "발판", true)
	p["종류"] = "유령"
	return p


## 주행검사 문법의 색 번호(ColorDefs: 검정 0 · 흰색 1)로 바꾼다.
## ⚠ 지형 쪽 enum(무색 0 · 검정 1 · 흰색 2)과 **번호가 다르다.** 섞으면 공략이 통째로 어긋난다.
static func _공략색(지형색: int) -> int:
	return 0 if 지형색 == 규격.검정 else 1


## 점프 한 번을 공략으로 적는다. 착지 y 까지 적어야 "발판을 놓치고 바닥에 떨어져도 성공" 으로
## 잘못 읽히지 않는다(하수도_주행검사 §공략표 주석 그대로).
static func _뛰기(도약x: float, 착지: Rect2) -> Array:
	return ["뛰기", 도약x, 착지.position.x + 착지.size.x * 0.5, 착지.position.y]


static func _빈(종류: String, 이름: String, 상태: Dictionary, 난이도: int) -> Dictionary:
	return {
		"종류": 종류, "이름": 이름, "난이도": 난이도,
		"플랫폼": [], "위험물": [], "사격": [], "공략": [],
		"출구": {"x": 상태["x"], "y": 상태["y"], "색": 상태["색"], "층": 상태["층"]},
	}


## 틈을 하나 고른다.
##   · **96 미만은 절대 만들지 않는다** — 그건 구멍이 아니라 발이 빠지는 자리다.
##   · **240 을 절대 넘지 않는다** — 건널 수 있는 거리는 272(=320×0.85)이고,
##     내려가는 점프라고 더 주지 않는다(레벨검사가 방향을 안 본다 · 규격.gd 의 ★ 주석).
##     240 은 거기에 32 px 여유를 둔 값이다. 이 상한을 함수 안에 박아 두는 이유는
##     청크마다 따로 적으면 언젠가 한 곳이 288 같은 값을 쓰기 때문이다(실제로 그랬다).
static func _틈(rng: RandomNumberGenerator, 최소: float = 128.0, 최대: float = 240.0) -> float:
	var lo: float = clampf(최소, 규격.최소_틈, 규격.설계_최대틈)
	var hi: float = clampf(최대, lo, 규격.설계_최대틈)
	return 규격.격자맞춤(rng.randf_range(lo, hi))


# ============================================================================
# A · 기본 이동 — 같은 높이로 한 번 뛴다
# ============================================================================
static func _기본(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("A", 이름, 상태, 1)
	var y: float = 상태["y"]
	var 틈 := _틈(rng, 128.0, 232.0)
	var 폭 := 규격.격자맞춤(rng.randf_range(192.0, 384.0))
	var p := _발판(이름 + "_판", 상태["x"] + 틈, y, 폭, 상태["색"])
	c["플랫폼"].append(p)
	c["공략"].append(["가", 상태["x"] - 32.0])
	c["공략"].append(_뛰기(상태["x"], p["사각"]))
	c["출구"] = {"x": p["사각"].end.x, "y": y, "색": 상태["색"], "층": 상태["층"]}
	return c


# ============================================================================
# B · 상승 — 한 층 올라간다 (층 간격은 규격의 128 을 넘지 않는다)
# ============================================================================
static func _상승(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("B", 이름, 상태, 2)
	var 층: int = mini(int(상태["층"]) + 1, 설정.최대_층)
	var y: float = 설정.바닥_y - 층 * 설정.층_간격
	if 층 == int(상태["층"]):        # 이미 꼭대기면 기본 이동으로 대체한다
		return _기본(이름, 상태, 설정, rng)
	# 올라가는 점프는 수평 여유가 줄어든다 — 틈을 짧게 잡는다.
	var 틈 := _틈(rng, 112.0, 176.0)
	var 폭 := 규격.격자맞춤(rng.randf_range(160.0, 288.0))
	var p := _발판(이름 + "_단", 상태["x"] + 틈, y, 폭, 상태["색"])
	c["플랫폼"].append(p)
	c["공략"].append(["가", 상태["x"] - 32.0])
	c["공략"].append(_뛰기(상태["x"], p["사각"]))
	c["출구"] = {"x": p["사각"].end.x, "y": y, "색": 상태["색"], "층": 층}
	return c


# ============================================================================
# C · 하강 — 내려간다. 내려가는 점프는 멀리 가므로 틈을 넓게 써도 된다
# ============================================================================
static func _하강(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("C", 이름, 상태, 1)
	var 층: int = maxi(int(상태["층"]) - 1, 0)
	var y: float = 설정.바닥_y - 층 * 설정.층_간격
	if 층 == int(상태["층"]):
		return _기본(이름, 상태, 설정, rng)
	var 틈 := _틈(rng, 160.0, 288.0)
	var 폭 := 규격.격자맞춤(rng.randf_range(224.0, 448.0))
	var p := _발판(이름 + "_단", 상태["x"] + 틈, y, 폭, 상태["색"])
	c["플랫폼"].append(p)
	c["공략"].append(["가", 상태["x"] - 32.0])
	c["공략"].append(_뛰기(상태["x"], p["사각"]))
	c["출구"] = {"x": p["사각"].end.x, "y": y, "색": 상태["색"], "층": 층}
	return c


# ============================================================================
# D · 색 반전 — 여기서 구간 색이 바뀐다
# ----------------------------------------------------------------------------
# ▣ 규칙 두 가지를 반드시 지킨다
#   ① 색이 다른 두 지형 사이에는 **80 px 이상 틈**이 있어야 한다(가이드라인 §7).
#      붙여 놓으면 색을 바꿀 자리가 없어서 어느 쪽으로도 못 간다.
#   ② 건너편은 **공중에서 색을 바꿔** 착지한다 → 공략은 `뛰기색`.
# ============================================================================
static func _색반전(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("D", 이름, 상태, 2)
	var 새색: int = 규격.흰색 if int(상태["색"]) == 규격.검정 else 규격.검정
	var y: float = 상태["y"]
	# 색 경계 틈은 최소 80 이지만, 점프로 건너야 하므로 실제로는 틈 규칙(96) 쪽이 더 크다.
	var 틈 := _틈(rng, maxf(규격.색경계_최소틈, 규격.최소_틈) + 32.0, 232.0)
	var 폭 := 규격.격자맞춤(rng.randf_range(256.0, 448.0))
	var p := _발판(이름 + "_새색", 상태["x"] + 틈, y, 폭, 새색)
	c["플랫폼"].append(p)
	c["공략"].append(["가", 상태["x"] - 32.0])
	c["공략"].append(["뛰기색", 상태["x"], p["사각"].position.x + 폭 * 0.5,
		p["사각"].position.y, _공략색(새색)])
	c["출구"] = {"x": p["사각"].end.x, "y": y, "색": 새색, "층": 상태["층"]}
	c["메모"] = "색 구간 전환 — 공중에서 색을 바꿔야 착지할 수 있다"
	return c


# ============================================================================
# E · 공중 사격 — 쏴서 발판을 만들어야 건너갈 수 있다
# ----------------------------------------------------------------------------
# ▣ 배치 규칙
#   유령 발판은 **출발 발판에서 쏠 수 있는 자리**에 둔다. 총알은 직선이 아니라 포물선이라
#   (탄속 1150 · 중력 900) 너무 멀면 아래로 떨어진다 → 수평 거리를 240~384 로 제한한다.
#   그리고 유령이 **굳은 뒤에는 점프로 닿아야** 하므로 도달 가능 범위 안에 둔다.
# ============================================================================
static func _공중사격(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("E", 이름, 상태, 3)
	var y: float = 상태["y"]
	var 색: int = 상태["색"]
	var 틈 := _틈(rng, 144.0, 216.0)
	var 유령폭 := 규격.격자맞춤(rng.randf_range(160.0, 256.0))
	# 유령은 출발 발판과 같은 높이이거나 한 단 위. 한 단 위면 "쏘고 올라탄다" 가 된다.
	var 유령y: float = y if rng.randf() < 0.5 else y - 설정.층_간격
	var g := _유령(이름 + "_유령", 상태["x"] + 틈, 유령y, 유령폭, 색)
	c["플랫폼"].append(g)
	# 착지 발판 — 유령을 딛고 한 번 더 뛴다.
	var 틈2 := _틈(rng, 144.0, 224.0)
	var 폭 := 규격.격자맞춤(rng.randf_range(192.0, 352.0))
	var p := _발판(이름 + "_착지", g["사각"].end.x + 틈2, 유령y, 폭, 색)
	c["플랫폼"].append(p)

	# 시야 검증기가 볼 자료 — "이 자리에서 이 사각을 맞출 수 있나"
	c["사격"].append({
		"자리": Vector2(상태["x"] - 규격.몸_폭, y - 규격.몸_높이 * 0.5),
		"목표": g["사각"],
		"대상": g["이름"],
	})
	c["공략"].append(["가", 상태["x"] - 48.0])
	c["공략"].append(["칠", g["이름"], _공략색(색)])
	c["공략"].append(_뛰기(상태["x"], g["사각"]))
	c["공략"].append(_뛰기(g["사각"].end.x, p["사각"]))
	c["출구"] = {"x": p["사각"].end.x, "y": 유령y, "색": 색,
		"층": int(round((설정.바닥_y - 유령y) / 설정.층_간격))}
	c["메모"] = "유령 발판을 칠해야 길이 생긴다"
	return c


# ============================================================================
# F · 시야(Line of Sight) — **쏠 수 있는 자리를 먼저 찾아야 한다**
# ----------------------------------------------------------------------------
# ▣ 어떻게 "가려짐" 을 만드나
#   출발 자리와 유령 발판 사이에 **가림 기둥**(칠할 수 없는 구조물)을 세운다.
#   기둥이 총알 궤적을 막으므로 출발 자리에서는 못 맞힌다. 대신 기둥 위 **사격 발판**
#   으로 올라가면 궤적이 기둥을 넘어간다.
#   → 검증기가 두 가지를 다 확인한다: 출발에서는 막히고, 사격 자리에서는 뚫린다.
# ============================================================================
static func _시야(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("F", 이름, 상태, 4)
	var y: float = 상태["y"]
	var 색: int = 상태["색"]

	# ① 올라설 사격 발판 (출발 발판 바로 위 한 단)
	var 사격y: float = y - float(설정.층_간격)
	var 사격폭 := 규격.격자맞춤(rng.randf_range(160.0, 224.0))
	var 사격판 := _발판(이름 + "_사격자리", 상태["x"] + _틈(rng, 112.0, 160.0), 사격y, 사격폭, 색)
	c["플랫폼"].append(사격판)

	# ② 가림 기둥 — 아래(출발 바닥)에서 쏘면 막히고, 위(사격판)에서 쏘면 넘어가는 높이.
	#    ★이 높이를 잘못 잡으면 퍼즐이 통째로 죽는다. 처음에 기둥 꼭대기를 사격판보다
	#      224 px 더 높게 세웠더니 **위에서도 못 쏴서** F 청크가 8 번 재시도 끝에 전부
	#      기본 이동으로 대체됐다(2026-09-20 실측). 기둥 꼭대기는 사격판 바닥면보다
	#      **조금만** 높아야 한다 — 서 있는 눈높이(몸 97 의 절반)가 그 위로 나오도록.
	#    칠할 수 없는 구조물이라 색 규칙 밖이다(색규칙.gd: 칠할 수 없는 것은 죽이지 않는다).
	# ★기둥과 유령까지의 **총 거리**가 점프 한계(272)를 넘으면 안 된다.
	#   처음에 기둥을 96 띄우고 폭 96, 그 너머로 다시 128~176 을 띄웠더니 총 320~368 이 되어
	#   **유령이 도달 불가**로 잡혔고, 그 뒤 스테이지 전체가 BFS 에서 끊겼다(2026-09-20 실측).
	#   → 기둥은 가늘게(64), 바짝(32) 붙인다. 기둥은 구조물이라 "틈 96" 규칙 대상이 아니다.
	var 기둥x: float = 사격판["사각"].end.x + 32.0
	var 기둥_위: float = 규격.격자맞춤(사격y - 16.0)
	var 기둥_아래: float = 규격.격자맞춤(y + 규격.바닥_두께)
	var 기둥 := {
		"이름": 이름 + "_가림기둥",
		"사각": Rect2(규격.격자맞춤(기둥x), 기둥_위, 64.0, 기둥_아래 - 기둥_위),
		"종류": "구조", "색": 규격.검정, "칠방식": 2, "일방통행": false,
	}
	c["플랫폼"].append(기둥)

	# ③ 기둥 너머 유령 발판 — 사격판과 같은 높이에 둔다(궤적이 기둥 위를 살짝 넘어간다).
	#    사격판 오른끝 → 유령 왼끝 = 32 + 64 + 96 = 192 px ≤ 272(건널 수 있는 거리)
	var 유령폭 := 규격.격자맞춤(rng.randf_range(160.0, 240.0))
	var g := _유령(이름 + "_유령", 기둥x + 64.0 + 규격.최소_틈, 사격y, 유령폭, 색)
	c["플랫폼"].append(g)

	c["사격"].append({
		"자리": Vector2(사격판["사각"].end.x - 32.0, 사격y - 규격.몸_높이 * 0.5),
		"목표": g["사각"],
		"대상": g["이름"],
		"막혀야_하는_자리": Vector2(상태["x"] - 규격.몸_폭, y - 규격.몸_높이 * 0.5),
	})
	c["공략"].append(["가", 상태["x"] - 48.0])
	c["공략"].append(_뛰기(상태["x"], 사격판["사각"]))
	c["공략"].append(["칠", g["이름"], _공략색(색)])
	c["공략"].append(_뛰기(사격판["사각"].end.x, g["사각"]))
	c["출구"] = {"x": g["사각"].end.x, "y": 사격y, "색": 색,
		"층": int(round((설정.바닥_y - 사격y) / 설정.층_간격))}
	c["메모"] = "기둥이 시야를 막는다 — 위로 올라가야 쏠 수 있다"
	return c


# ============================================================================
# G · 수직 이동 — 지그재그 사다리
# ----------------------------------------------------------------------------
# ⚠ 발판을 좌우로 **엇갈리게** 놓는다. 일직선으로 쌓으면 두 칸 위 발판 밑면에
#   머리(97)가 박혀서 못 올라간다. 일방통행이 그것을 한 번 더 막아 준다.
# ============================================================================
static func _수직(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("G", 이름, 상태, 3)
	var 층: int = 상태["층"]
	var x: float = 상태["x"]
	var y: float = 상태["y"]
	var 단수: int = mini(3, 설정.최대_층 - 층)
	if 단수 <= 0:
		return _하강(이름, 상태, 설정, rng)
	c["공략"].append(["가", x - 32.0])
	var 앞판: Rect2 = Rect2()
	for i in 단수:
		층 += 1
		y = 설정.바닥_y - 층 * 설정.층_간격
		# 좌우 엇갈림: 홀수 단은 오른쪽으로 더, 짝수 단은 조금만 — 사다리처럼 보이게.
		var 밀기 := 규격.격자맞춤(rng.randf_range(112.0, 176.0)) if i % 2 == 0 else 규격.격자맞춤(rng.randf_range(160.0, 240.0))
		var 폭 := 규격.격자맞춤(rng.randf_range(160.0, 240.0))
		var p := _발판("%s_사다리%d" % [이름, i + 1], x + 밀기, y, 폭, 상태["색"])
		c["플랫폼"].append(p)
		c["공략"].append(_뛰기(x, p["사각"]))
		x = p["사각"].end.x
		앞판 = p["사각"]
	c["출구"] = {"x": x, "y": y, "색": 상태["색"], "층": 층}
	c["메모"] = "지그재그 사다리 %d 단" % 단수
	return c


# ============================================================================
# H · 위험 구간 — 가시 위를 건넌다
# ----------------------------------------------------------------------------
# ⚠ 가시는 `hazard` 그룹이라 **색과 무관하게 즉사**다(월드.gd `_사망_판정()` 0번).
#   그래서 "칠하면 안전" 이 통하지 않는다 → 반드시 **건너뛸 수 있는 폭**으로 둔다.
# ============================================================================
static func _위험(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	if 설정.위험물.is_empty():
		return _기본(이름, 상태, 설정, rng)
	var c := _빈("H", 이름, 상태, 3)
	var y: float = 상태["y"]
	var 종류: String = 설정.위험물.keys()[rng.randi() % 설정.위험물.size()]
	var 자료: Dictionary = 설정.위험물[종류]

	# 가시를 얹을 낮은 받침. 받침 윗면은 출발 발판과 같은 높이 → 걷다가 만나는 함정이 된다.
	var 틈 := _틈(rng, 128.0, 176.0)
	var 받침폭 := 규격.격자맞춤(rng.randf_range(192.0, 288.0))
	var 받침 := _발판(이름 + "_함정받침", 상태["x"] + 틈, y, 받침폭, 상태["색"])
	c["플랫폼"].append(받침)
	c["위험물"].append({
		"종류": 종류, "씬": 자료["씬"],
		"위치": Vector2(받침["사각"].position.x + 받침폭 * 0.5, y),
	})
	# 가시를 넘어 내려설 발판
	var 틈2 := _틈(rng, 144.0, 216.0)
	var 폭 := 규격.격자맞춤(rng.randf_range(224.0, 384.0))
	var p := _발판(이름 + "_넘어", 받침["사각"].end.x + 틈2, y, 폭, 상태["색"])
	c["플랫폼"].append(p)
	c["공략"].append(["가", 상태["x"] - 32.0])
	# ★받침을 밟지 않고 **한 번에** 건넌다. 받침 위 가시를 밟으면 즉사다.
	c["공략"].append(_뛰기(상태["x"], p["사각"]))
	c["출구"] = {"x": p["사각"].end.x, "y": y, "색": 상태["색"], "층": 상태["층"]}
	c["메모"] = "%s 를 한 번에 넘는다" % 종류
	return c


# ============================================================================
# I · 복합 — 색을 바꾸고, 그 색으로 유령을 칠해 건넌다
# ----------------------------------------------------------------------------
# 이 게임에서 제일 "이 게임다운" 상황이다: 색을 바꾸면 **내가 밟을 수 있는 것**과
# **내가 칠할 수 있는 것**이 동시에 바뀐다.
# ============================================================================
static func _복합(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("I", 이름, 상태, 5)
	var 색: int = 상태["색"]
	var 새색: int = 규격.흰색 if 색 == 규격.검정 else 규격.검정
	var y: float = 상태["y"]

	# ① 새 색 발판으로 공중 색전환 점프
	var 틈 := _틈(rng, 144.0, 216.0)
	var 폭1 := 규격.격자맞춤(rng.randf_range(192.0, 288.0))
	var p1 := _발판(이름 + "_전환", 상태["x"] + 틈, y, 폭1, 새색)
	c["플랫폼"].append(p1)
	# ② 새 색으로 유령을 칠해 건넌다
	var 유령폭 := 규격.격자맞춤(rng.randf_range(160.0, 240.0))
	var g := _유령(이름 + "_유령", p1["사각"].end.x + _틈(rng, 144.0, 208.0), y - float(설정.층_간격), 유령폭, 새색)
	c["플랫폼"].append(g)
	var 폭2 := 규격.격자맞춤(rng.randf_range(192.0, 320.0))
	var p2 := _발판(이름 + "_착지", g["사각"].end.x + _틈(rng, 144.0, 208.0), y - float(설정.층_간격), 폭2, 새색)
	c["플랫폼"].append(p2)

	c["사격"].append({
		"자리": Vector2(p1["사각"].end.x - 32.0, y - 규격.몸_높이 * 0.5),
		"목표": g["사각"], "대상": g["이름"],
	})
	c["공략"].append(["가", 상태["x"] - 48.0])
	c["공략"].append(["뛰기색", 상태["x"], p1["사각"].position.x + 폭1 * 0.5, p1["사각"].position.y, _공략색(새색)])
	c["공략"].append(["칠", g["이름"], _공략색(새색)])
	c["공략"].append(_뛰기(p1["사각"].end.x, g["사각"]))
	c["공략"].append(_뛰기(g["사각"].end.x, p2["사각"]))
	c["출구"] = {"x": p2["사각"].end.x, "y": y - 설정.층_간격, "색": 새색,
		"층": int(round((설정.바닥_y - (y - 설정.층_간격)) / 설정.층_간격))}
	c["메모"] = "색 전환 + 유령 칠하기"
	return c


# ============================================================================
# J · 휴식 — 어려운 청크 뒤에 숨 돌릴 자리
# ----------------------------------------------------------------------------
# 난이도 곡선에서 **가장 자주 빠뜨리는 것**이 이것이다. 퍼즐만 이어 붙이면
# 플레이어는 배우기 전에 지친다. 단 576 을 넘기지 않는다(전체칠 한계).
# ============================================================================
static func _휴식(이름: String, 상태: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var c := _빈("J", 이름, 상태, 0)
	var y: float = 상태["y"]
	var 틈 := _틈(rng, 96.0, 144.0)
	var 폭 := 규격.격자맞춤(rng.randf_range(384.0, 규격.최대_발판폭))
	var p := _발판(이름 + "_평지", 상태["x"] + 틈, y, 폭, 상태["색"], "바닥")
	c["플랫폼"].append(p)
	c["공략"].append(["가", 상태["x"] - 32.0])
	c["공략"].append(_뛰기(상태["x"], p["사각"]))
	c["공략"].append(["쉬", 0.4])
	c["출구"] = {"x": p["사각"].end.x, "y": y, "색": 상태["색"], "층": 상태["층"]}
	return c
