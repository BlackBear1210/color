extends RefCounted
## ============================================================================
## [2026-09-23 신규] 내려가는 계단 파기 — 「복도와 계단」 스테이지의 뼈대
## ----------------------------------------------------------------------------
## ▣ `동굴층.gd` 와 무엇이 다른가 (왜 새 파일인가)
##   `동굴층.gd` = **평평한 띠**가 여러 겹. 위아래로 오가는 동굴이다. 집 1-1(2층 방)이 쓴다.
##   여기(`계단층.gd`) = **한 줄기 길이 계속 내려간다.** 길이 뱀처럼 꺾이며 아래로 향한다.
##   같은 파일에 모드를 섞지 않은 이유: 띠 코드는 "바닥 y 는 층마다 고정" 을 전제로 쓰였고
##   (그 전제 덕에 통행이 보장된다), 여기는 정반대로 "바닥 y 는 x 마다 달라진다" 가 전제다.
##   한 함수에 두 전제를 넣으면 둘 다 망가진다. 뒷단(관문·윤곽·배치·조립)은 그대로 쓴다.
##
## ▣ 생김새 — 뱀처럼 꺾이며 내려가는 계단
##
##     ┌──복도──┐▄▖                                        ← 다리 0 (→)
##              ▝▚▄▖ 복도 ┌──복도──┐▄▖
##                   ▝▀▀▀▀▀        ▝▚▄▖
##          ▗▄▞▘ ┌──복도──┐ ▗▄▞▘              ← 다리 1 (←) · 끝에서 큰 계단으로 꺾는다
##     ┌──복도──┐▄▖                                        ← 다리 2 (→)
##
##   · **다리(leg)** = 한 방향으로 쭉 가는 구간. 방향이 번갈아 바뀐다.
##   · 다리 안은 [평평한 복도] → [작은 계단 2~5 단] → [복도] → … 의 되풀이다.
##   · 다리 끝에서는 **큰 계단**으로 다음 다리 높이까지 한 번에 내려간다.
##
## ▣ 반드시 지키는 것 — **한 단은 1 칸(96 px)**
##   내려가는 것은 공짜지만 **되돌아 올라오는 것**이 되어야 한다(체크포인트로 돌아가기,
##   관문을 다시 시도하기). 플레이어가 한 번에 오르는 한계가 128 px 이므로
##   한 단이 2 칸(192 px)이 되는 순간 그 위쪽은 통째로 못 돌아가는 땅이 된다.
##   디딤 폭도 2 칸(192 px) 이상 — 몸 폭 44 px 이 서고도 남아야 발이 걸리지 않는다.
##
## ▣ 세로 예산 — 이 맵에서 제일 먼저 터지는 것
##   총 내려갈 수 있는 칸 = (높이칸 − 외곽 − 천장여유). 여기에
##   (다리 수 × 다리내림) + (턴 수 × 턴내림) 이 들어가야 한다. 넘치면 다리끼리 겹쳐
##   위 다리 바닥과 아래 다리 천장이 뚫린다 → `_예산()` 이 미리 나눠서 배정한다.
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")

const 암반: int = 1
const 빈칸: int = 0


static func 파기(설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var W: int = int(설정.폭칸)
	var H: int = int(설정.높이칸)
	var 외곽: int = maxi(int(설정.외곽두께), 1)
	var 칸 := PackedByteArray()
	칸.resize(W * H)
	칸.fill(암반)

	# ── 가로 범위 ───────────────────────────────────────────────────────────
	# 외곽 두께 안쪽에서 2 칸 더 들어간다 — 벽에 딱 붙으면 벽면 폴리곤이 지저분해진다.
	var L: int = 외곽 + 2
	var R: int = W - 외곽 - 3
	if R - L < 40:
		return {}                      # 이 폭으로는 복도 하나도 못 놓는다

	# ── 세로 예산 ───────────────────────────────────────────────────────────
	var 예산 := _예산(설정, H, 외곽)
	if 예산.is_empty():
		return {}
	var 꼭대기: int = 예산["꼭대기"]
	var 다리수: int = 예산["다리수"]
	var 다리내림: int = 예산["다리내림"]
	var 턴내림: int = 예산["턴내림"]
	var 턴폭: int = 예산["턴폭"]
	var 디딤칸: int = 예산["디딤칸"]

	# ── 다리(leg)를 차례로 판다 ────────────────────────────────────────────
	var 방들: Array = []
	var 층들: Array[int] = []
	var 바닥줄: Array = []             # 다리마다 길이 W 인 배열. −1 = 이 x 에 이 다리가 없다
	for _i in 다리수:
		var 줄 := PackedInt32Array()
		줄.resize(W)
		줄.fill(-1)
		바닥줄.append(줄)

	var 바닥y: int = 꼭대기
	var 시작x: int = L
	var 방향: int = 1                  # +1 = 오른쪽으로, −1 = 왼쪽으로
	var 방번호 := 0
	# 복도 안에 만드는 것들(징검다리 구덩이). `관문.gd` 와 같은 방식으로 뒤에서 합쳐진다.
	var 배치물 := {"플랫폼": [], "위험물": [], "체크포인트": []}

	for k in 다리수:
		var 끝x: int = R if 방향 > 0 else L
		var 결과 := _다리_파기(칸, 바닥줄[k], 설정, rng, W, H,
			시작x, 끝x, 방향, 바닥y, 다리내림, 디딤칸, k, 방번호, 배치물)
		방들.append_array(결과["방들"])
		방번호 = int(결과["방번호"])
		바닥y = int(결과["바닥y"])
		# 대표 층선 = 이 다리의 한가운데 높이. `관문.gd` 가 `바닥줄` 을 못 읽을 때의 보험이다.
		층들.append(int(결과["가운데y"]))

		if k < 다리수 - 1:
			# ★★큰 계단은 **다음 다리 방향으로** 내려간다.
			#   처음에는 "지금 가던 방향 그대로 끝까지" 내려가게 했는데, 그러면 다음 다리가
			#   큰 계단 **바로 밑**을 되돌아 지나가면서 둘 사이 바위가 2~3 칸밖에 안 남아
			#   천장이 뚫렸다. 방향을 먼저 꺾으면 큰 계단 자체가 다음 다리의 첫 구간이 되어
			#   둘이 겹칠 일이 없다.
			방향 = -방향
			# 큰 계단은 다음 다리의 `바닥줄` 에 적는다 — 이 x 범위는 지금 다리도 쓰고 있어서
			# 같은 줄에 적으면 덮어쓰기가 난다.
			바닥y = _계단_파기(칸, 바닥줄[k + 1], 설정, rng, W, H,
				끝x, 방향, 바닥y, 턴내림, 디딤칸)
			시작x = 끝x + 방향 * 턴폭
		else:
			시작x = 끝x

	if 방들.is_empty():
		return {}

	# ── 시작·출구 ───────────────────────────────────────────────────────────
	# 시작은 **제일 위 다리의 첫 복도**. 이 맵은 내려가는 맵이라 위에서 시작한다.
	# (`동굴층.gd` 는 아래에서 시작한다 — 거긴 못 돌아 올라가는 구간이 생기기 때문이다.
	#  여기는 모든 단이 1 칸이라 언제든 되돌아 올라갈 수 있어서 위에서 시작해도 된다.)
	var 시작방: Dictionary = 방들[0]
	var 출구방: Dictionary = 방들[방들.size() - 1]
	var 시작칸 := Vector2i(시작방["사각"].position.x + 2, int(시작방["바닥y"]) - 1)
	var 출구칸 := Vector2i(출구방["사각"].get_center().x, int(출구방["바닥y"]) - 1)

	return {
		"칸": 칸, "폭칸": W, "높이칸": H, "칸크기": float(설정.칸크기),
		"원점": Vector2(설정.원점_x, 설정.원점_y),
		"방들": 방들,
		"통로들": [],                  # 세로 갱도가 없다 → `배치.gd _사다리()` 가 할 일이 없다
		"층들": 층들, "바닥줄": 바닥줄,
		"시작칸": 시작칸, "출구칸": 출구칸,
		"시작방": 시작방, "출구방": 출구방,
		"배치물": 배치물,              # 복도 안 징검다리 — `생성_동굴.gd` 가 배치 결과에 합친다
	}


# ============================================================================
# 세로 예산 — 다리·턴에 내려갈 칸을 나눠 준다
# ----------------------------------------------------------------------------
# 이 계산을 안 하고 "내려가고 싶은 만큼 내려가라" 로 두면 마지막 다리가 맵 바닥을 뚫거나
# 다리끼리 겹친다. 먼저 나누고 그 안에서만 내려가게 한다.
# ============================================================================
static func _예산(설정: RefCounted, H: int, 외곽: int) -> Dictionary:
	var 천장최대: int = int(설정.방_최대높이)
	var 꼭대기: int = 외곽 + 천장최대 + 2        # 제일 높은 바닥선이 올 수 있는 y
	var 바닥한계: int = H - 외곽 - 2             # 제일 낮은 바닥선
	var 총내림: int = 바닥한계 - 꼭대기
	if 총내림 < 12:
		return {}                                 # 이 높이로는 계단 맵이 안 된다

	var 다리수: int = maxi(int(설정.다리수), 1)
	var 디딤칸: int = maxi(int(설정.계단_디딤칸), 2)
	var 턴폭: int = maxi(int(설정.턴_폭칸), 디딤칸 * 3)
	# 큰 계단은 디딤 한 칸마다 1 단씩 내려간다 → 내려가는 칸 수 = 턴폭 ÷ 디딤칸
	var 턴내림: int = int(턴폭 / 디딤칸)
	var 턴수: int = 다리수 - 1

	var 남은: int = 총내림 - 턴내림 * 턴수
	# 다리가 내려갈 몫이 너무 적으면(= 턴이 예산을 다 먹으면) 턴을 줄인다.
	# 다리가 평평해지면 "복도만 긴 맵" 이 되어 계단 느낌이 사라진다.
	while 남은 < 다리수 * 4 and 턴내림 > 4:
		턴내림 -= 1
		남은 = 총내림 - 턴내림 * 턴수
	var 다리내림: int = maxi(int(남은 / 다리수), 3)
	return {
		"꼭대기": 꼭대기, "다리수": 다리수, "다리내림": 다리내림,
		"턴내림": 턴내림, "턴폭": 턴폭, "디딤칸": 디딤칸,
	}


# ============================================================================
# 다리 하나 — [평평한 복도] → [작은 계단] → [복도] → … 되풀이
# ============================================================================
static func _다리_파기(칸: PackedByteArray, 줄: PackedInt32Array, 설정: RefCounted,
		rng: RandomNumberGenerator, W: int, H: int,
		시작x: int, 끝x: int, 방향: int, 시작바닥y: int, 내릴칸: int, 디딤칸: int,
		다리i: int, 방번호: int, 배치물: Dictionary) -> Dictionary:
	var 방들: Array = []
	var 바닥y := 시작바닥y
	var x := 시작x
	var 남은내림 := 내릴칸
	var 가운데y := 시작바닥y
	var 반환점 := absi(끝x - 시작x) / 2

	var 안전 := 0
	while absi(끝x - x) > 1 and 안전 < 400:
		안전 += 1
		var 남은폭 := absi(끝x - x)
		# ★계단이 먹을 가로 칸을 **먼저 떼어 둔다.** 복도를 욕심껏 길게 뽑으면
		#   다리 끝에서 내려갈 자리가 없어 마지막에 절벽(여러 칸 낙차)이 생긴다.
		var 계단몫 := 남은내림 * 디딤칸
		var 복도 := rng.randi_range(int(설정.복도_최소폭), int(설정.복도_최대폭))
		복도 = mini(복도, maxi(남은폭 - 계단몫, 2))
		복도 = mini(복도, 남은폭)
		if 복도 < 2:
			복도 = mini(2, 남은폭)

		# ── ① 평평한 복도 ──────────────────────────────────────────────────
		var 천장 := rng.randi_range(int(설정.방_최소높이), int(설정.방_최대높이))
		var 왼x := x if 방향 > 0 else x - 복도 + 1
		for i in 복도:
			_기둥(칸, 줄, W, H, x + 방향 * i, 바닥y, 천장)
		방번호 += 1
		방들.append({
			"이름": "복도%02d" % 방번호,
			"사각": Rect2i(왼x, 바닥y - 천장, 복도, 천장),
			"벨트": 다리i, "종류": "복도", "바닥y": 바닥y,
		})
		# ★복도 한가운데를 뚫어 **징검다리**를 놓는다 — 이 맵의 진짜 난이도는 여기서 나온다
		if rng.randf() < float(설정.구덩이_확률):
			_징검다리_구덩이(칸, 설정, W, H, 왼x, 복도, 바닥y, 방번호, 배치물)
		x += 방향 * 복도
		if absi(끝x - 시작x) - absi(x - 시작x) <= 반환점:
			가운데y = 바닥y             # 대표 층선용 — 다리 한가운데쯤의 높이

		# ── ② 내려가는 작은 계단 ───────────────────────────────────────────
		남은폭 = absi(끝x - x)
		if 남은내림 <= 0 or 남은폭 < 디딤칸:
			continue
		var 단수 := rng.randi_range(int(설정.계단_단수_최소), int(설정.계단_단수_최대))
		단수 = mini(단수, 남은내림)
		단수 = mini(단수, int(남은폭 / 디딤칸))
		# 다리 끝이 가까우면 남은 내림을 여기서 다 쓴다(마지막에 절벽을 남기지 않는다)
		if 남은폭 <= (남은내림 + 1) * 디딤칸:
			단수 = mini(남은내림, int(남은폭 / 디딤칸))
		for s in 단수:
			바닥y += 1                 # ★한 단은 반드시 1 칸(96 px) — 2 칸이면 못 돌아 올라온다
			# 계단 구간의 천장은 복도보다 한 칸 높게 판다. 안 그러면 내려가는 동안
			# 천장이 같이 내려와 머리가 스치는 구간이 생긴다(키 97 px = 한 칸 남짓).
			for i in 디딤칸:
				_기둥(칸, 줄, W, H, x + 방향 * i, 바닥y, 천장 + 1)
			x += 방향 * 디딤칸
		남은내림 -= 단수
	return {"방들": 방들, "방번호": 방번호, "바닥y": 바닥y, "가운데y": 가운데y}


# ============================================================================
# 큰 계단(턴) — 다리와 다리 사이를 한 번에 내려간다
# ----------------------------------------------------------------------------
# 작은 계단과 규칙은 같다(한 단 1 칸 · 디딤 2 칸). 다른 점은 **쉬는 복도 없이** 쭉 내려간다는 것.
# 그래서 화면에서 "여기가 층이 바뀌는 곳" 으로 읽힌다.
# ============================================================================
static func _계단_파기(칸: PackedByteArray, 줄: PackedInt32Array, 설정: RefCounted,
		rng: RandomNumberGenerator, W: int, H: int,
		시작x: int, 방향: int, 시작바닥y: int, 단수: int, 디딤칸: int) -> int:
	var 바닥y := 시작바닥y
	var x := 시작x
	# 큰 계단은 위가 트여 있어야 "내려가는 계단" 으로 보인다 — 천장을 넉넉히 판다.
	var 천장 := int(설정.방_최대높이) + 1
	for s in 단수:
		바닥y += 1
		for i in 디딤칸:
			_기둥(칸, 줄, W, H, x + 방향 * i, 바닥y, 천장)
		x += 방향 * 디딤칸
	return 바닥y


# ============================================================================
# ★[2026-09-23 신규] 징검다리 구덩이 — 복도 한가운데를 뚫고 뛰어 건너게 한다
# ----------------------------------------------------------------------------
# ▣ 왜 필요한가
#   복도와 계단만으로는 **걸어 내려가기만 하면 끝나는 맵**이다. 관문(관문.gd)은 다리마다
#   4 개뿐이라 그 사이 1,000~2,000 px 복도가 전부 빈 걸음이 된다.
#
# ▣ 생김새 — 도형님이 말한 그 배치
#   "한 칸씩 뛰어서 발판을 배치하면 점프를 실수했을 때 떨어져 다시 올라가야 하니까
#    어려움을 주는 거지."
#
#       바닥 ▓▓▓▓▓█  ▄▄  ▄▄  ▄▄  █▓▓▓▓▓        ▄▄ = 발판 2 칸(192 px)
#                 ╲  ░░  ░░  ░░  ╱             ░░ = 빈 공간 2 칸(192 px)
#                  ╲▲ ▲ ▲ ▲ ▲ ▲╱               ▲  = 가시(구덩이 바닥)
#
#   · 발판 윗면이 복도 바닥과 **같은 높이**다 → 달려와서 그대로 뛴다(오르내림이 없다)
#   · 발판 사이 192 px 는 `배치.gd 체인_틈칸` 과 같은 값이다. 판정선 272 px 안이라
#     뛰면 반드시 건너지지만, **안 뛰면 반드시 빠진다.**
#
# ▣ 왜 구덩이 바닥에 가시를 까나 — 안 깔면 소프트락이다
#   구덩이 깊이가 3 칸(288 px)이라 한 번에 오르는 한계(128 px)를 넘는다. 빠지면 못 나온다.
#   → 가시로 죽이고 **구덩이 바로 앞 체크포인트**에서 다시 시작하게 한다.
#     (깊이를 1 칸으로 줄이면 기어 나올 수 있지만, 그건 구덩이가 아니라 턱이다)
# ============================================================================
static func _징검다리_구덩이(칸: PackedByteArray, 설정: RefCounted, W: int, H: int,
		왼x: int, 복도폭: int, 바닥y: int, 번호: int, 배치물: Dictionary) -> void:
	var 칸크기: float = float(설정.칸크기)
	var 보폭: int = int(설정.징검_보폭칸)
	var 발판칸: int = int(설정.징검_발판칸)
	var 깊이: int = int(설정.구덩이_깊이칸)

	# ★구덩이 폭 = 개수 × 보폭. 이 식이어야 **양 끝 틈이 한 칸씩**으로 딱 맞는다.
	#     ░▄▄░░▄▄░░▄▄░   ← 1 + (2+2) + (2+2) + 2 + 1 = 12 = 3 개 × 보폭 4
	#   처음에 `개수 × 보폭 + 발판칸` 으로 뒀더니 오른쪽 끝에 **3 칸(288 px) 틈**이 남았다.
	#   건널 수 있는 거리가 272 px 라, 마지막 발판에서 건너편 바닥으로 못 넘어간다.
	var 여유 := 6                       # 복도 양 끝 3 칸씩은 달려올 자리로 남긴다
	var 개수 := int(float(복도폭 - 여유) / float(보폭))
	개수 = clampi(개수, 2, int(설정.징검_최대개수))
	var 구덩이폭 := 개수 * 보폭
	if 구덩이폭 + 여유 > 복도폭:
		return                          # 이 복도는 너무 짧다 — 구덩이를 안 판다
	# 맵 바닥 테두리를 뚫으면 안 된다(바깥이 보인다). 마지막 다리에서 걸린다.
	if 바닥y + 깊이 + 1 >= H - int(설정.외곽두께):
		return

	var x0 := 왼x + int((복도폭 - 구덩이폭) / 2)

	# ── ① 구덩이를 판다 (바닥 줄 포함 깊이만큼) ────────────────────────────
	for i in 구덩이폭:
		for d in 깊이:
			_비우기(칸, W, H, x0 + i, 바닥y + d)
		# 구덩이 바닥은 바위로 남긴다 — 안 그러면 아래 다리 천장까지 뚫린다
		if 바닥y + 깊이 < H:
			칸[(바닥y + 깊이) * W + x0 + i] = 암반

	# ── ② 발판 — 윗면이 복도 바닥 표면과 같은 높이 ─────────────────────────
	var 원점 := Vector2(설정.원점_x, 설정.원점_y)
	for i in 개수:
		var cx := x0 + 1 + i * 보폭
		var 좌상 := 원점 + Vector2(float(cx), float(바닥y)) * 칸크기
		배치물["플랫폼"].append({
			"이름": "징검%02d_%d" % [번호, i + 1],
			"사각": Rect2(좌상.x, 좌상.y, 칸크기 * float(발판칸), 규격.발판_두께),
			"종류": "발판", "색": 규격.검정,
			"칠방식": 0,                 # 폭 192 px ≤ 576 이라 전체 색칠이 된다
			"일방통행": false,           # ★달려와서 옆에서 부딪치므로 **단단해야** 한다.
			                             #   일방통행이면 옆면을 통과해 그냥 빠져 버린다.
			"의도형태": "직사각형",
		})

	# ── ③ 구덩이 바닥 가시 ────────────────────────────────────────────────
	# ★★가시를 **한 칸에 하나씩 놓지 않는다.** `가시.gd` 에 `칸수`(1~20 · 가시 한 칸 32 px)가
	#   있어서 노드 하나가 최대 640 px 를 덮는다.
	#   칸마다 놓으면 구덩이 하나에 12~16 개가 생기는데, hazard 그룹은 **매 물리 프레임
	#   전부 순회**한다(`월드.gd _사망_판정()` 이 노드마다 `get_overlapping_bodies()` 를 부른다).
	#   실측: 칸마다 놓았더니 한 씬에 86 개가 되어 권고치 60 을 넘었다(진단_절차생성_예산).
	#   → 6 칸(576 px)씩 묶어 노드 수를 1/6 로 줄인다. **덮는 면적은 그대로다** —
	#     빠지면 반드시 죽어야 한다. 성능을 위해 구멍을 내면 못 나오는 소프트락이 된다.
	if not 설정.위험물.is_empty() and 설정.위험물.has("가시"):
		var 덮는칸 := 6                 # 6 × 96 px = 576 px → 가시 칸수 18 (한계 20 안)
		var i := 0
		while i < 구덩이폭:
			var 폭칸: int = mini(덮는칸, 구덩이폭 - i)
			배치물["위험물"].append({
				"종류": "가시", "씬": 설정.위험물["가시"]["씬"],
				"칸수": 폭칸 * 3,        # 지형 한 칸(96) = 가시 세 칸(32×3)
				"위치": 원점 + Vector2(float(x0 + i) + float(폭칸) * 0.5,
					float(바닥y + 깊이)) * 칸크기,
			})
			i += 폭칸

	# ── ④ 구덩이 앞 체크포인트 — 죽어서 배우되 억울하지 않게 ───────────────
	배치물["체크포인트"].append(
		원점 + Vector2(float(x0 - 2) + 0.5, float(바닥y)) * 칸크기)


# ============================================================================
# 도우미
# ============================================================================
## x 칸에 바닥 y 를 두고 그 위 `높이` 칸을 판다. 바닥줄에도 기록한다.
## ⚠ 바닥 칸(바닥y) 자체는 **파지 않는다** — 그게 밟고 서는 바위다.
static func _기둥(칸: PackedByteArray, 줄: PackedInt32Array, W: int, H: int,
		x: int, 바닥y: int, 높이: int) -> void:
	if x < 0 or x >= W:
		return
	for d in 높이:
		_비우기(칸, W, H, x, 바닥y - 1 - d)
	if 바닥y >= 0 and 바닥y < H:
		칸[바닥y * W + x] = 암반       # 디딤은 반드시 바위로 남긴다
	줄[x] = 바닥y


static func _비우기(칸: PackedByteArray, W: int, H: int, x: int, y: int) -> void:
	if x < 0 or x >= W or y < 0 or y >= H:
		return
	칸[y * W + x] = 빈칸
