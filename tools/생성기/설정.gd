extends RefCounted
## ============================================================================
## [2026-09-20 신규] 스테이지 설정(StageConfig) — **알고리즘은 공유, 데이터만 교체**
## ----------------------------------------------------------------------------
## ▣ 이 파일이 있는 이유
##   집 1-1 전용 생성기를 만들면 하수도에서 못 쓴다. 그런데 두 챕터의 차이는
##   **기하가 아니라 데이터**다 — 쓰는 Template, 재질, 층 간격, 청크 취향, 장애물 목록.
##   → 생성 알고리즘은 `생성기.gd` 하나, 챕터마다 다른 것은 전부 여기 표로 뺀다.
##
## ▣ 새 챕터를 추가하는 법 (다른 작업자용 · 3 분)
##   1. 아래 `하수도()` 를 복사해서 `도시()` 를 만든다
##   2. `지형_템플릿`·`유령_템플릿` 을 그 챕터 프리팹 경로로 바꾼다
##   3. `청크_가중치` 에서 그 챕터에 어울리는 청크의 숫자를 올린다
##   4. `tools/생성_스테이지.gd -- --설정=도시` 로 돌린다
##   ★기하 규칙(격자 16 · 변 90 · 점프 도달성)은 `규격.gd` 가 강제하므로 건드릴 필요가 없다.
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")

# ── 테마(그림) ──────────────────────────────────────────────────────────────
## 밟는 지형 Template — 검정/흰색 두 벌이 필요하다.
## ⚠ 흰 구간에 검정 Template 을 쓰고 `시작상태` 만 흰색으로 주면 **에디터에서 검게 보여**
##   다음 작업자가 반드시 헷갈린다(하수도 빌더가 같은 이유로 흰색 Template 을 따로 쓴다).
var 지형_템플릿_검: String = ""
var 지형_템플릿_흰: String = ""
## 칠해야 밟히는 유령 발판 Template(없으면 지형 Template 에 `무색일때_통과` 를 켜서 쓴다)
var 유령_템플릿: String = ""
## 구조물(벽·천장·바닥 채움) Template. 비우면 지형 Template 을 쓴다.
var 구조_템플릿: String = ""

# ── 이름표 ──────────────────────────────────────────────────────────────────
var 이름: String = ""
var 스테이지_이름: String = ""
var 출력_폴더: String = ""

# ── 공간 ────────────────────────────────────────────────────────────────────
## 목표 진행 길이(px). 10,000 은 **상한**이지 채워야 할 할당량이 아니다.
var 목표_길이: float = 10000.0
## 층 간격 — 이 값으로 올라가고 내려간다. 규격.올라갈_수_있는_높이()(128) 이하여야 한다.
var 층_간격: float = 128.0
## 진행 방향으로 몇 층까지 오르내릴 수 있나 (0 = 바닥층)
var 최대_층: int = 3
## 바닥층의 y (월드). 위로 갈수록 음수.
var 바닥_y: float = 0.0

# ── 청크 취향 (가중치 · 클수록 자주 나온다) ────────────────────────────────
## 종류: A 기본 · B 상승 · C 하강 · D 색반전 · E 공중사격 · F 시야 · G 수직 · H 위험 · I 복합 · J 휴식
var 청크_가중치: Dictionary = {}

# ── 장애물·기믹 (확장 지점) ────────────────────────────────────────────────
## 다른 작업자가 새 기믹을 넣는 자리. `청크.gd` 가 여기 있는 것만 꺼내 쓴다.
##   { "가시": {"씬": "res://...", "폭": 64.0, "높이": 48.0}, ... }
## ★StageGenerator 를 고치지 않고 **이 표에 줄만 추가**하면 새 장애물이 배치된다.
var 위험물: Dictionary = {}

# ── 색 구간 ────────────────────────────────────────────────────────────────
## 한 색 구간의 길이 범위(px). 너무 짧으면 색 전환만 하다 끝나고, 너무 길면 색이 장식이 된다.
var 색구간_최소: float = 1200.0
var 색구간_최대: float = 2600.0


## ============================================================================
## 집 챕터 (1-1 「2층 방」) — 이번 작업의 대상
## ----------------------------------------------------------------------------
## ▣ 왜 WOOD 만 쓰나 (도형님 지시 2026-09-20)
##   집 안이라는 테마라서다. 밟는 지형은 전부 나무. 벽돌·잔디·철판을 섞지 않는다.
##   구조물(벽·천장)까지 나무로 둬서 "나무로 짠 방" 으로 읽히게 한다
##   — 벽돌 벽이 필요하면 `구조_템플릿` 한 줄만 BRICK 으로 바꾸면 된다.
## ============================================================================
static func 집() -> RefCounted:
	var c = load("res://tools/생성기/설정.gd").new()
	c.이름 = "집"
	c.스테이지_이름 = "2층 방"
	c.출력_폴더 = "res://scenes/집/생성/"
	var 키트 := "res://scenes/집/스마트 매쉬 assets/"
	c.지형_템플릿_검 = 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID.tscn"
	c.지형_템플릿_흰 = 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID_WHITE.tscn"
	c.유령_템플릿 = 키트 + "GHOST_투명발판/TEMPLATE_GHOST_WOOD.tscn"
	c.구조_템플릿 = 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID.tscn"

	# 집은 방이라 하수도 갱도처럼 높이 뻗지 않는다. 3 층(= 384 px)이면 2층 방 느낌이 난다.
	# ⚠ 이 값은 **청크를 깔 계획 길이**다. 강제 청크와 끝 바닥이 뒤에 더 붙으므로
	#   실제 진행 길이는 여기에 20~25 % 가 더해진다(8,000 → 약 10,000~11,000 실측).
	c.목표_길이 = 8000.0
	c.층_간격 = 112.0        # = 규격.설계_최대상승. 판정선(128)에 딱 맞추면 실측에서 끊긴다
	c.최대_층 = 3
	c.바닥_y = 0.0

	# 집 1-1 은 **이 게임을 처음 배우는 판**이다(챕터 표에서 집이 첫 월드).
	#   → 기본 이동·상승·휴식을 많이, 시야 퍼즐(F)과 위험(H)은 적게.
	c.청크_가중치 = {
		"A": 22, "B": 14, "C": 12, "D": 14,
		"E": 12, "F": 6, "G": 8, "H": 4, "I": 4, "J": 10,
	}
	# 집에서 쓸 수 있는 위험물. 가시만 켜 둔다 — 회전톱·물은 하수도 물건이다.
	c.위험물 = {
		"가시": {"씬": "res://scenes/장애물/가시.tscn", "폭": 64.0, "높이": 48.0},
	}
	c.색구간_최소 = 1200.0
	c.색구간_최대 = 2600.0
	return c


## ============================================================================
## 하수도 챕터 — **다른 작업자가 바로 쓸 수 있게 미리 깔아 둔 설정**
## ----------------------------------------------------------------------------
## ✔ 2026-09-20 실측: 씨앗 2001·2002·2003 전부 통과. s2002 를 구워 `레벨검사` 에 태운 결과
##   **밟는 지형 28/28 도달 · 소프트락 0**.
## ⚠ 단 지형과 유령 발판까지다 — 하수도 고유의 **물·호퍼·배관·회전톱 배치는 아직 안 한다.**
##   그건 `청크.gd` 에 하수도 전용 청크를 추가해야 한다(사용법 문서 "새 청크 종류" 절).
## ============================================================================
static func 하수도() -> RefCounted:
	var c = load("res://tools/생성기/설정.gd").new()
	c.이름 = "하수도"
	c.스테이지_이름 = "하수도 생성"
	c.출력_폴더 = "res://scenes/world_2_클로드/생성/"
	c.지형_템플릿_검 = "res://scenes/지형/하수도/하수도_기본지형_검정.tscn"
	c.지형_템플릿_흰 = "res://scenes/지형/하수도/하수도_기본지형_흰색.tscn"
	# 하수도에는 전용 유령 Template 이 없다 → 기본 지형에 `무색일때_통과` 를 켜서 쓴다(빈 문자열).
	c.유령_템플릿 = ""
	c.구조_템플릿 = "res://scenes/지형/하수도/하수도_기본지형_검정.tscn"

	# 하수도는 갱도라 위아래로 더 크게 움직인다. 치명 낙하 1500 이라 층을 더 벌려도 된다.
	c.목표_길이 = 9600.0        # 실제 진행 길이는 약 12,000 (위 집 설정의 주석 참고)
	c.층_간격 = 112.0        # = 규격.설계_최대상승. 판정선(128)에 딱 맞추면 실측에서 끊긴다
	c.최대_층 = 5
	c.바닥_y = 0.0

	# 하수도는 이미 배운 사람이 오는 판이라 퍼즐 비중을 올린다.
	c.청크_가중치 = {
		"A": 14, "B": 12, "C": 12, "D": 16,
		"E": 14, "F": 12, "G": 12, "H": 10, "I": 10, "J": 8,
	}
	c.위험물 = {
		"가시": {"씬": "res://scenes/장애물/가시.tscn", "폭": 64.0, "높이": 48.0},
		"회전톱": {"씬": "res://scenes/장애물/회전톱.tscn", "폭": 96.0, "높이": 96.0},
	}
	c.색구간_최소 = 1400.0
	c.색구간_최대 = 3000.0
	return c


static func 이름으로(n: String) -> RefCounted:
	match n:
		"집": return 집()
		"하수도": return 하수도()
	return null


# ============================================================================
# ★[2026-09-21 신규] v2 「동굴 파기」 설정
# ----------------------------------------------------------------------------
# v1(청크 이어 붙이기)과 **완전히 다른 알고리즘**이 쓰는 값이다. 같은 파일에 둔 이유는
# 챕터 데이터(Template 경로·색 구간·위험물)를 v1·v2 가 그대로 공유하기 때문이다.
# ============================================================================

## 격자 한 칸(px). 96 = 16 격자 × 6. 플레이어 키 97 이라 통로는 3 칸(288) 판다.
var 칸크기: float = 96.0
var 폭칸: int = 120                ## 120 × 96 = 11,520 px
var 높이칸: int = 32               ## 32 × 96 = 3,072 px
var 원점_x: float = 0.0
var 원점_y: float = -2688.0        ## 바닥이 y≈384 에 오도록(집 1-1 은 바닥이 y 0 근처)

## 방을 몇 개 층(벨트)으로 나눌 것인가. 3 이면 위·중간·아래.
var 벨트수: int = 3
var 방_최소폭: int = 5             ## 480 px
var 방_최대폭: int = 14            ## 1,344 px
var 방_최소높이: int = 3           ## 288 px
var 방_최대높이: int = 8           ## 768 px

## 최소 신장 트리에 **여분 간선**을 몇 % 더할 것인가 = 고리(탐험)의 양.
## 0 이면 길이 한 줄기(v1 과 같은 실패), 0.6 을 넘으면 방 구분이 사라진다.
var 고리_비율: float = 0.35
var 통로_굵기: int = 3             ## 288 px. 플레이어 97 + 점프 여유
var 돌기_확률: float = 0.06        ## 바위 한 칸이 돌기가 될 확률
var 돌기_최대길이: int = 2         ## 최대 2 칸(192 px) — 3 칸이면 통로를 자주 막는다


## 집 1-1 용 동굴 설정. 테마(WOOD)·색 구간·위험물은 `집()` 것을 그대로 쓴다.
static func 집_동굴() -> RefCounted:
	var c = 집()
	c.스테이지_이름 = "2층 방"
	c.칸크기 = 96.0
	c.폭칸 = 120
	c.높이칸 = 34
	c.원점_x = 0.0
	c.원점_y = -2688.0
	c.벨트수 = 4
	# 집은 "방" 이라 가로로 넓고 낮은 방이 어울린다(갱도처럼 높지 않다).
	c.방_최소폭 = 4
	c.방_최대폭 = 18
	c.방_최소높이 = 3
	c.방_최대높이 = 9
	c.고리_비율 = 0.35
	c.통로_굵기 = 3
	c.돌기_확률 = 0.06
	c.돌기_최대길이 = 1        # ★2 칸(192px)은 오를 수 없다(한계 128) — 바닥이 끊긴다
	c.울퉁불퉁_횟수 = 2        # 3 이면 바닥에 2 칸 단차가 자주 생겨 길이 끊긴다

	# ★★[2026-09-21 도형님 피드백 반영] 맵을 2 배로, 공간을 넓게
	#   "점프하며 나아가는 곳들이 전부 좁게 배치되어 좁은 공간에서 움직이는 것처럼 보인다"
	#   → 칸 크기(96)는 **그대로 둔다.** 칸을 키우면 한 칸 턱이 128(오르기 한계)을 넘어
	#     플레이어가 못 올라가는 지형이 생긴다. 대신 **칸 수**를 늘려 맵을 키운다.
	c.폭칸 = 232            # 232 × 96 = 22,272 px (기존 11,520 의 약 2 배)
	c.높이칸 = 60           # 60 × 96 = 5,760 px
	c.외곽두께 = 6          # ★지붕·바닥 바위를 576 px 두껍게 — 넘어서 배경이 보이지 않게
	c.위험물_개수 = 20
	c.층간격칸 = 10         # 960 px. 층 사이가 넓어야 "좁다" 는 느낌이 사라진다
	c.층연결_개수 = 5       # 경사로 하나가 가로 20 칸(1,920px)을 먹는다 — 너무 많으면 벽이 다 뚫린다
	c.턱_확률 = 0.5
	c.방_최소폭 = 10        # 960 px
	c.방_최대폭 = 30        # 2,880 px — 넓은 방과 좁은 굴의 차이를 크게
	c.방_최소높이 = 5       # 480 px (기존 288 은 천장이 머리에 붙어 답답했다)
	c.방_최대높이 = 9       # 864 px
	c.선반_개수 = 0         # ★자유롭게 뜬 바위 선반은 없앴다 — 이유는 아래 주석
	c.관문_개수 = 4         # ★층마다 관문 4 개 — 점프·색반전·칠하기를 강제하는 자리
	return c

## ★[2026-09-21] 생김새 만들기 값 — 이 둘이 "지하철 노선도" 와 "동굴" 을 가른다
## 울퉁불퉁: 셀룰러 오토마타 반복 횟수. 0 이면 방이 네모 그대로, 4 이상이면 통로가 뭉개진다.
var 울퉁불퉁_횟수: int = 2
## 선반: 벽에서 튀어나온 바닥의 개수. 이게 플랫포밍의 뼈대가 된다.
var 선반_개수: int = 90
## 위험물(가시 등)을 몇 개 놓을 것인가. 매 물리 프레임 순회 대상이라 60 을 넘기지 않는다
## (docs/프롬프트_절차생성_1만px_맵_2026-09-20.md §4 의 예산).
var 위험물_개수: int = 14

## ★[2026-09-21] 층 기반 파기(`동굴층.gd`) 값
## 층 간격(칸). 5 칸 = 480 px. 층이 촘촘하면 답답하고, 멀면 계단이 길어진다.
var 층간격칸: int = 6
## 층 사이를 몇 군데서 잇나. 적으면 막다른 층이 생기고, 많으면 벽이 다 뚫린다.
var 층연결_개수: int = 5
## 구간과 구간 사이에 **넘어가는 턱**을 둘 확률
var 턱_확률: float = 0.45

## ★[2026-09-21] 외곽(지붕·바닥·좌우 벽) 바위 두께(칸).
## 도형님 피드백: "지붕이자 위에 큰 지형이 … 위에 배경이 넘어서" → 얇으면 지형 너머가 보인다.
## 6 칸 = 576 px. 카메라가 스테이지 끝에 붙어도 바위 너머가 안 보인다.
var 외곽두께: int = 6

## ★[2026-09-21] 관문(`관문.gd`) — 한 층에 몇 개를 세울 것인가.
## 이것이 **게임이 있느냐 없느냐**를 가른다. 0 이면 그냥 걸어 다니는 동굴이다.
## 4 이면 22,000 px 에 층당 4 개 = 약 5,500 px 마다 하나. 너무 잦으면 피로하다.
var 관문_개수: int = 4


# ============================================================================
# ★[2026-09-23 신규] 「복도와 계단」 설정 — `계단층.gd` 가 읽는 값
# ----------------------------------------------------------------------------
# 동굴 설정(집_동굴)과 같은 파일에 두지만 **파는 알고리즘이 다르다.**
#   집_동굴   → `동굴층.gd` : 평평한 띠가 여러 겹인 동굴
#   집_복도계단 → `계단층.gd` : 뱀처럼 꺾이며 내려가는 한 줄기 계단
# ============================================================================
## 다리(leg) 수 — 한 방향으로 쭉 가는 구간이 몇 개인가. 홀수면 오른쪽에서 끝난다.
## ⚠ 늘리면 세로 예산(높이칸)을 같이 늘려야 한다. 안 그러면 다리마다 내려갈 몫이 3 칸으로 깎인다.
var 다리수: int = 3
## 다리 끝에서 방향을 꺾으며 내려가는 **큰 계단**의 가로 폭(칸).
## 22 칸 ÷ 디딤 2 칸 = 11 단 = 1,056 px 를 한 번에 내려간다.
var 턴_폭칸: int = 22
## 한 단의 디딤 폭(칸). 2 칸 = 192 px. 몸 폭 44 px 이 서고도 남는다.
## ⚠ 1 칸(96 px)으로 줄이면 계단이 사다리가 되어 화면에서 계단으로 안 읽힌다.
var 계단_디딤칸: int = 2
## 복도 사이에 끼는 작은 계단의 단 수 범위. 2~5 단 = 192~480 px 를 내려간다.
var 계단_단수_최소: int = 2
var 계단_단수_최대: int = 5
## 평평한 복도 한 칸의 길이(칸). 10~22 칸 = 960~2,112 px.
## ⚠ 이것이 곧 **관문이 설 자리**다 — 관문은 평평한 곳만 고른다(관문.gd `_바닥_평평`).
##   최소폭이 관문 폭(최대 5 칸) + 6 보다 작으면 관문이 한 개도 안 선다.
var 복도_최소폭: int = 10
var 복도_최대폭: int = 22


static func 집_복도계단() -> RefCounted:
	var c = 집()
	c.이름 = "복도계단"
	c.스테이지_이름 = "2 · 복도와 계단"
	c.칸크기 = 96.0
	# ★맵 크기는 집 1-1(2층 방)과 **같은 급**으로 둔다(도형님 요청 2026-09-23).
	#   2층 방 = 232 × 60 칸 = 13,920 칸.  여기 = 160 × 90 칸 = 14,400 칸.
	#   같은 넓이지만 **세로로 긴** 비율이다 — 내려가는 계단은 높이를 먹기 때문이다.
	#   ⚠ 칸 크기 96 은 절대 건드리지 말 것. 한 칸 턱이 곧 넘을 수 있는 높이(한계 128)다.
	c.폭칸 = 160            # 15,360 px
	c.높이칸 = 90           # 8,640 px
	c.원점_x = 0.0
	c.원점_y = -4032.0      # 시작 바닥이 y ≈ −2,400 근처에 오도록(맵이 아래로 자란다)
	c.외곽두께 = 6          # 576 px. 얇으면 지형 너머로 배경이 보인다

	# 복도 — 천장이 높으면 "복도" 가 아니라 "방" 으로 보인다. 동굴보다 낮게 잡는다.
	c.방_최소높이 = 5       # 480 px
	c.방_최대높이 = 8       # 768 px
	#   ⚠ 8 을 넘기면 다리와 다리 사이 바위가 4 칸 밑으로 떨어져 천장이 뚫린다
	#     (실측: 다리 0 과 다리 1 의 최소 간격이 13 칸이다)

	c.다리수 = 3
	c.턴_폭칸 = 22
	c.계단_디딤칸 = 2
	c.계단_단수_최소 = 2
	c.계단_단수_최대 = 5
	c.복도_최소폭 = 12
	c.복도_최대폭 = 22

	# ★다리마다 6 번 시도. 징검다리 구덩이가 평평한 자리를 먹어서 4 번으로는 6 개밖에 안 섰다
	#   (관문은 평평한 바닥만 고른다 — 관문.gd `_바닥_평평`). 6 번이면 10~12 개가 선다.
	c.관문_개수 = 6
	# ★랜덤 가시는 8 개만 — 진짜 위험은 징검다리 구덩이와 관문이다.
	#   hazard 는 매 물리 프레임 전부 순회하므로 장식용 가시에 예산을 쓰면 안 된다.
	c.위험물_개수 = 8
	return c


## ★[2026-09-23] 징검다리 구덩이(`계단층.gd _징검다리_구덩이()`) 값
## 복도 하나가 통째로 빈 걸음이 되지 않게, 복도 한가운데를 뚫고 발판으로 건너게 한다.
var 구덩이_확률: float = 0.55
## 구덩이 깊이(칸). 3 칸 = 288 px.
## ⚠ 1 칸으로 줄이면 기어 나올 수 있어 구덩이가 아니라 턱이 된다.
##   2 칸 이상이면 못 나오므로 **바닥 가시가 반드시 같이 깔려야** 한다(안 그러면 소프트락).
var 구덩이_깊이칸: int = 3
## 징검 발판 폭(칸)과 보폭(칸). `배치.gd` 의 체인_발판칸 / 체인_보폭칸 과 같은 값이어야 한다.
## ⚠ 보폭 − 발판칸 = 틈. 5 칸 보폭(틈 288 px)은 판정선 272 px 를 넘어 **못 건넌다.**
var 징검_발판칸: int = 2
var 징검_보폭칸: int = 4
## 한 구덩이의 발판 수 상한. 많을수록 길어지고 한 번의 실수가 아깝다 — 4 개면 충분하다.
var 징검_최대개수: int = 4
