extends RefCounted
## ============================================================================
## [2026-09-20 신규] 스테이지 설정(StageConfig) — **알고리즘은 공유, 데이터만 교체**
## ----------------------------------------------------------------------------
## ▣ 이 파일이 있는 이유
##   집 1-1 전용 생성기를 만들면 하수도에서 못 쓴다. 그런데 두 챕터의 차이는
##   **기하가 아니라 데이터**다 — 쓰는 Template, 재질, 층 간격, 청크 취향, 장애물 목록.
##   → 생성 알고리즘은 `생성기.gd` 하나, 챕터마다 다른 것은 전부 여기 표로 뺀다.
##
## ▣ 새 챕터를 추가하는 법 (다른 작업자용 · 3 분)
##   1. 아래 `하수도()` 를 복사해서 `도시()` 를 만든다
##   2. `지형_템플릿`·`유령_템플릿` 을 그 챕터 프리팹 경로로 바꾼다
##   3. `청크_가중치` 에서 그 챕터에 어울리는 청크의 숫자를 올린다
##   4. `tools/생성_스테이지.gd -- --설정=도시` 로 돌린다
##   ★기하 규칙(격자 16 · 변 90 · 점프 도달성)은 `규격.gd` 가 강제하므로 건드릴 필요가 없다.
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")

# ── 테마(그림) ──────────────────────────────────────────────────────────────
## 밟는 지형 Template — 검정/흰색 두 벌이 필요하다.
## ⚠ 흰 구간에 검정 Template 을 쓰고 `시작상태` 만 흰색으로 주면 **에디터에서 검게 보여**
##   다음 작업자가 반드시 헷갈린다(하수도 빌더가 같은 이유로 흰색 Template 을 따로 쓴다).
var 지형_템플릿_검: String = ""
var 지형_템플릿_흰: String = ""
## 칠해야 밟히는 유령 발판 Template(없으면 지형 Template 에 `무색일때_통과` 를 켜서 쓴다)
var 유령_템플릿: String = ""
## 구조물(벽·천장·바닥 채움) Template. 비우면 지형 Template 을 쓴다.
var 구조_템플릿: String = ""

# ── 이름표 ──────────────────────────────────────────────────────────────────
var 이름: String = ""
var 스테이지_이름: String = ""
var 출력_폴더: String = ""

# ── 공간 ────────────────────────────────────────────────────────────────────
## 목표 진행 길이(px). 10,000 은 **상한**이지 채워야 할 할당량이 아니다.
var 목표_길이: float = 10000.0
## 층 간격 — 이 값으로 올라가고 내려간다. 규격.올라갈_수_있는_높이()(128) 이하여야 한다.
var 층_간격: float = 128.0
## 진행 방향으로 몇 층까지 오르내릴 수 있나 (0 = 바닥층)
var 최대_층: int = 3
## 바닥층의 y (월드). 위로 갈수록 음수.
var 바닥_y: float = 0.0

# ── 청크 취향 (가중치 · 클수록 자주 나온다) ────────────────────────────────
## 종류: A 기본 · B 상승 · C 하강 · D 색반전 · E 공중사격 · F 시야 · G 수직 · H 위험 · I 복합 · J 휴식
var 청크_가중치: Dictionary = {}

# ── 장애물·기믹 (확장 지점) ────────────────────────────────────────────────
## 다른 작업자가 새 기믹을 넣는 자리. `청크.gd` 가 여기 있는 것만 꺼내 쓴다.
##   { "가시": {"씬": "res://...", "폭": 64.0, "높이": 48.0}, ... }
## ★StageGenerator 를 고치지 않고 **이 표에 줄만 추가**하면 새 장애물이 배치된다.
var 위험물: Dictionary = {}

# ── 색 구간 ────────────────────────────────────────────────────────────────
## 한 색 구간의 길이 범위(px). 너무 짧으면 색 전환만 하다 끝나고, 너무 길면 색이 장식이 된다.
var 색구간_최소: float = 1200.0
var 색구간_최대: float = 2600.0


## ============================================================================
## 집 챕터 (1-1 「2층 방」) — 이번 작업의 대상
## ----------------------------------------------------------------------------
## ▣ 왜 WOOD 만 쓰나 (도형님 지시 2026-09-20)
##   집 안이라는 테마라서다. 밟는 지형은 전부 나무. 벽돌·잔디·철판을 섞지 않는다.
##   구조물(벽·천장)까지 나무로 둬서 "나무로 짠 방" 으로 읽히게 한다
##   — 벽돌 벽이 필요하면 `구조_템플릿` 한 줄만 BRICK 으로 바꾸면 된다.
## ============================================================================
static func 집() -> RefCounted:
	var c = load("res://tools/생성기/설정.gd").new()
	c.이름 = "집"
	c.스테이지_이름 = "2층 방"
	c.출력_폴더 = "res://scenes/집/생성/"
	var 키트 := "res://scenes/집/스마트 매쉬 assets/"
	c.지형_템플릿_검 = 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID.tscn"
	c.지형_템플릿_흰 = 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID_WHITE.tscn"
	c.유령_템플릿 = 키트 + "GHOST_투명발판/TEMPLATE_GHOST_WOOD.tscn"
	c.구조_템플릿 = 키트 + "WOOD_나무/TEMPLATE_WOOD_SOLID.tscn"

	# 집은 방이라 하수도 갱도처럼 높이 뻗지 않는다. 3 층(= 384 px)이면 2층 방 느낌이 난다.
	# ⚠ 이 값은 **청크를 깔 계획 길이**다. 강제 청크와 끝 바닥이 뒤에 더 붙으므로
	#   실제 진행 길이는 여기에 20~25 % 가 더해진다(8,000 → 약 10,000~11,000 실측).
	c.목표_길이 = 8000.0
	c.층_간격 = 112.0        # = 규격.설계_최대상승. 판정선(128)에 딱 맞추면 실측에서 끊긴다
	c.최대_층 = 3
	c.바닥_y = 0.0

	# 집 1-1 은 **이 게임을 처음 배우는 판**이다(챕터 표에서 집이 첫 월드).
	#   → 기본 이동·상승·휴식을 많이, 시야 퍼즐(F)과 위험(H)은 적게.
	c.청크_가중치 = {
		"A": 22, "B": 14, "C": 12, "D": 14,
		"E": 12, "F": 6, "G": 8, "H": 4, "I": 4, "J": 10,
	}
	# 집에서 쓸 수 있는 위험물. 가시만 켜 둔다 — 회전톱·물은 하수도 물건이다.
	c.위험물 = {
		"가시": {"씬": "res://scenes/장애물/가시.tscn", "폭": 64.0, "높이": 48.0},
	}
	c.색구간_최소 = 1200.0
	c.색구간_최대 = 2600.0
	return c


## ============================================================================
## 하수도 챕터 — **다른 작업자가 바로 쓸 수 있게 미리 깔아 둔 설정**
## ----------------------------------------------------------------------------
## ✔ 2026-09-20 실측: 씨앗 2001·2002·2003 전부 통과. s2002 를 구워 `레벨검사` 에 태운 결과
##   **밟는 지형 28/28 도달 · 소프트락 0**.
## ⚠ 단 지형과 유령 발판까지다 — 하수도 고유의 **물·호퍼·배관·회전톱 배치는 아직 안 한다.**
##   그건 `청크.gd` 에 하수도 전용 청크를 추가해야 한다(사용법 문서 "새 청크 종류" 절).
## ============================================================================
static func 하수도() -> RefCounted:
	var c = load("res://tools/생성기/설정.gd").new()
	c.이름 = "하수도"
	c.스테이지_이름 = "하수도 생성"
	c.출력_폴더 = "res://scenes/world_2_클로드/생성/"
	c.지형_템플릿_검 = "res://scenes/지형/하수도/하수도_기본지형_검정.tscn"
	c.지형_템플릿_흰 = "res://scenes/지형/하수도/하수도_기본지형_흰색.tscn"
	# 하수도에는 전용 유령 Template 이 없다 → 기본 지형에 `무색일때_통과` 를 켜서 쓴다(빈 문자열).
	c.유령_템플릿 = ""
	c.구조_템플릿 = "res://scenes/지형/하수도/하수도_기본지형_검정.tscn"

	# 하수도는 갱도라 위아래로 더 크게 움직인다. 치명 낙하 1500 이라 층을 더 벌려도 된다.
	c.목표_길이 = 9600.0        # 실제 진행 길이는 약 12,000 (위 집 설정의 주석 참고)
	c.층_간격 = 112.0        # = 규격.설계_최대상승. 판정선(128)에 딱 맞추면 실측에서 끊긴다
	c.최대_층 = 5
	c.바닥_y = 0.0

	# 하수도는 이미 배운 사람이 오는 판이라 퍼즐 비중을 올린다.
	c.청크_가중치 = {
		"A": 14, "B": 12, "C": 12, "D": 16,
		"E": 14, "F": 12, "G": 12, "H": 10, "I": 10, "J": 8,
	}
	c.위험물 = {
		"가시": {"씬": "res://scenes/장애물/가시.tscn", "폭": 64.0, "높이": 48.0},
		"회전톱": {"씬": "res://scenes/장애물/회전톱.tscn", "폭": 96.0, "높이": 96.0},
	}
	c.색구간_최소 = 1400.0
	c.색구간_최대 = 3000.0
	return c


static func 이름으로(n: String) -> RefCounted:
	match n:
		"집": return 집()
		"하수도": return 하수도()
	return null
