extends RefCounted
## ============================================================================
## [2026-09-21 신규] 관문 — **플레이어가 게임의 규칙을 쓰지 않으면 못 지나가는 자리**
## ----------------------------------------------------------------------------
## ▣ 왜 만들었나 (도형님 지적 2026-09-21)
##   "2D 플랫포머인데 점프를 안 하고, 핵심인 색을 반전시키거나 칠해서 넘어가야 하는
##    구간이 하나도 없네."
##   맞다. 그때까지 생성기는 **걸어 다닐 수 있는 공간**만 만들고 있었다. 걸을 수 있다는 것은
##   레벨이 망가지지 않았다는 뜻일 뿐, **게임이 있다는 뜻이 아니다.**
##
## ▣ 관문의 정의
##   띠(층)를 **가로질러** 놓여서 우회할 수 없고, 정해진 행동을 해야만 통과되는 구조.
##   우회가 가능하면 그건 장식이지 관문이 아니다. 그래서 관문은 **통로 폭 전체**를 덮는다.
##
## ▣ 세 가지 관문과 "무엇을 가르치나"
##   ┌ J 도약 ─ 2 칸(192px) 구덩이 + 바닥에 가시.
##   │          걸어가면 빠져 죽는다 → **점프를 배운다.** (건널 수 있는 거리 272 안)
##   ├ C 색바닥 ─ 통로를 막는 색 슬래브(흰색 또는 검정).
##   │          내 색과 다르면 닿는 순간 죽는다 → **Shift 로 색을 바꾸거나 총으로 칠하는 것을 배운다.**
##   │          `전체칠_가능` 이면 칠해서 넘어갈 수도 있다(두 가지 답이 있는 관문).
##   └ G 유령다리 ─ 4 칸(384px) 구덩이 + 그 위에 **안 칠하면 없는** 유령 발판.
##              점프로는 절대 못 건넌다(한계 272) → **쏴서 길을 만드는 것을 배운다.**
##
## ▣ 죽어서 배우게 하되, 억울하지 않게
##   관문 **바로 앞에 체크포인트**를 둔다. 죽어도 3 초 안에 다시 시도할 수 있어야
##   "아 여기는 색을 바꿔야 하는구나" 가 학습이 되지, 벌이 되지 않는다.
##
## ▣ 순서 — 이 모듈은 **파기 뒤, 윤곽 뽑기 전**에 돌아야 한다
##   구덩이를 파면 그게 동굴 모양의 일부이므로 껍데기 폴리곤에 반영돼야 한다.
##   윤곽을 먼저 뽑으면 구덩이가 없는 껍데기가 나와서 바닥이 공중에 뜬다.
## ============================================================================

const 규격 := preload("res://tools/생성기/규격.gd")
const 동굴_S := preload("res://tools/생성기/동굴.gd")

const 암반: int = 1
const 빈칸: int = 0


## 관문을 세운다. 격자를 **직접 고치고**(구덩이) 배치물 스펙을 돌려준다.
##   돌려주는 것 = {플랫폼, 위험물, 체크포인트, 사격, 관문들}
static func 세우기(동굴: Dictionary, 설정: RefCounted, rng: RandomNumberGenerator) -> Dictionary:
	var out := {"플랫폼": [], "위험물": [], "체크포인트": [], "사격": [], "관문들": []}
	var W: int = int(동굴["폭칸"])
	var 층들: Array = 동굴["층들"]
	var 번호 := 0

	for 층i in 층들.size():
		var 바닥y: int = 층들[층i]
		var 개수: int = int(설정.관문_개수)
		var 구간 := int(float(W - 24) / float(개수))
		for k in 개수:
			var 종류 := _종류_고르기(층i, k, rng, 설정)
			var 폭 := 2 if 종류 == "J" else (5 if 종류 == "C" else 4)
			# ★자리를 **여러 번 찾아본다.**
			#   처음에는 한 자리만 보고 안 되면 포기했는데, 천장이 울퉁불퉁하고 종유석이 있어서
			#   16 번 시도 중 2 개만 세워졌다(실측). 관문이 없으면 그냥 걸어 다니는 동굴이다.
			#   구간 안에서 30 번까지 자리를 옮겨 가며 찾는다.
			var x := -1
			for _시도 in 30:
				var 후보: int = 12 + 구간 * k + rng.randi_range(0, maxi(구간 - 16, 1))
				if _바닥_평평(동굴, 후보 - 3, 바닥y, 폭 + 6):
					x = 후보
					break
			if x < 0:
				continue
			번호 += 1
			match 종류:
				"J": _도약(동굴, out, x, 바닥y, 폭, 번호)
				"C": _색바닥(동굴, out, x, 바닥y, 폭, 번호, rng)
				"G": _유령다리(동굴, out, x, 바닥y, 폭, 번호)
			# ★관문 바로 앞(왼쪽 3 칸)에 체크포인트 — 죽어도 바로 다시 시도할 수 있게
			out["체크포인트"].append(
				동굴_S.칸_월드(동굴, x - 3, 바닥y - 1) + Vector2(48.0, 96.0))
			out["관문들"].append({"번호": 번호, "종류": 종류, "칸": Vector2i(x, 바닥y), "층": 층i})
	return out


## 층·순번에 따라 무엇을 가르칠지 고른다.
## ★아래 층(시작 쪽)일수록 쉬운 것부터 — 플레이어는 여기서 규칙을 처음 배운다.
##   맨 아래 띠: 도약 → 색바닥 → 도약 …   위층: 색바닥·유령다리 비중을 올린다.
static func _종류_고르기(층i: int, k: int, rng: RandomNumberGenerator, 설정: RefCounted) -> String:
	# ★무작위로 고르면 종류가 한쪽으로 쏠린다(실측: 16 개 중 유령다리가 1 개뿐이었다).
	#   유령다리는 "쏴서 길을 만든다" 를 가르치는 **유일한** 관문이라 빠지면 안 된다.
	#   → 순번으로 **돌려 가며** 배정해서 한 층에 세 종류가 다 나오게 한다.
	var 아래층 := 층i >= 2          # 층들은 위 → 아래 순서라 인덱스가 클수록 아래다
	if 아래층:
		# 시작 쪽(아래층)은 쉬운 것부터: 도약 → 색바닥 → 도약 → 유령다리
		return ["J", "C", "J", "G"][k % 4]
	# 위층은 이미 규칙을 배운 사람이 온다 → 색·사격 비중을 올린다
	return ["C", "G", "C", "J"][k % 4]


## 그 자리 바닥이 n 칸 내내 평평하고 머리 위가 3 칸 이상 비었나.
static func _바닥_평평(동굴: Dictionary, x: int, 바닥y: int, n: int) -> bool:
	for i in n:
		if 동굴_S.읽기(동굴, x + i, 바닥y) != 암반:
			return false
		for d in range(1, 4):
			if 동굴_S.읽기(동굴, x + i, 바닥y - d) != 빈칸:
				return false
	return true


## 격자를 직접 고친다(구덩이 파기). 파기 단계가 끝난 뒤라 보호 마스크는 이미 역할을 다했다.
static func _파기(동굴: Dictionary, x: int, y: int) -> void:
	var W: int = int(동굴["폭칸"])
	var 칸: PackedByteArray = 동굴["칸"]
	칸[y * W + x] = 빈칸


# ============================================================================
# J · 도약 관문 — 2 칸 구덩이 + 가시
# ----------------------------------------------------------------------------
# 2 칸 = 192 px. 건널 수 있는 거리가 272 px 이므로 **점프하면 반드시 건너진다.**
# 걸어서 들어가면 가시에 죽는다 → 점프를 배운다.
# ============================================================================
static func _도약(동굴: Dictionary, out: Dictionary, x: int, 바닥y: int, 폭: int, 번호: int) -> void:
	for i in 폭:
		_파기(동굴, x + i, 바닥y)
		_파기(동굴, x + i, 바닥y + 1)
	# 가시는 구덩이 바닥(바닥y+2 는 그대로 바위)에 놓는다
	for i in 폭:
		out["위험물"].append({
			"종류": "가시", "씬": "res://scenes/장애물/가시.tscn",
			"위치": 동굴_S.칸_월드(동굴, x + i, 바닥y + 1) + Vector2(48.0, 96.0),
		})


# ============================================================================
# C · 색 바닥 관문 — 내 색과 다르면 죽는 슬래브
# ----------------------------------------------------------------------------
# 통로를 가로막는 5 칸(480 px) 슬래브. 점프로 넘기에는 너무 길다(한계 272) →
# **반드시 밟고 지나가야 한다.** 밟으려면 내 색과 같아야 한다.
#   · 답 1: Shift 로 내 색을 슬래브 색으로 바꾼다
#   · 답 2: 총으로 슬래브를 내 색으로 칠한다 (긴변 480 ≤ 576 이라 전체 색칠이 된다)
# 두 가지 답이 다 되는 것이 중요하다 — 플레이어가 스스로 방법을 고르는 순간 규칙을 이해한다.
# ============================================================================
static func _색바닥(동굴: Dictionary, out: Dictionary, x: int, 바닥y: int, 폭: int,
		번호: int, rng: RandomNumberGenerator) -> void:
	var 칸크기: float = float(동굴["칸크기"])
	var 좌상 := 동굴_S.칸_월드(동굴, x, 바닥y)
	# 슬래브 윗면이 바닥보다 112 px 높다 = 한 번에 올라설 수 있는 높이(한계 128)
	var 자리 := Rect2(좌상.x, 좌상.y - 규격.발판_두께, float(폭) * 칸크기, 규격.발판_두께)
	# 흰색이 기본 — "안 칠한 지형은 검정" 이라 흰 슬래브가 제일 눈에 띈다.
	var 색: int = 규격.흰색 if rng.randf() < 0.7 else 규격.검정
	out["플랫폼"].append({
		"이름": "관문%02d_색바닥" % 번호,
		"사각": 자리, "종류": "발판", "색": 색,
		"칠방식": 0,                 # 전체칠 가능 = 칠해서 넘는 답도 열어 둔다
		"일방통행": false,           # ★일방통행이면 안 된다 — 옆에서 걸어 올라와야 한다
		"의도형태": "직사각형",
	})


# ============================================================================
# G · 유령 다리 관문 — 쏴서 길을 만들어야 건넌다
# ----------------------------------------------------------------------------
# 4 칸(384 px) 구덩이. 건널 수 있는 거리가 272 px 이라 **점프로는 절대 못 건넌다.**
# 구덩이 위에 유령 발판(안 칠하면 통과)이 있다 → 쏘면 굳어서 다리가 된다.
# 못 보고 뛰어들면 아래로 떨어진다 → "저 반투명한 건 뭐지" 를 스스로 알아낸다.
# ============================================================================
static func _유령다리(동굴: Dictionary, out: Dictionary, x: int, 바닥y: int, 폭: int, 번호: int) -> void:
	var 칸크기: float = float(동굴["칸크기"])
	for i in 폭:
		_파기(동굴, x + i, 바닥y)
		_파기(동굴, x + i, 바닥y + 1)
		_파기(동굴, x + i, 바닥y + 2)
	var 좌상 := 동굴_S.칸_월드(동굴, x, 바닥y)
	var 자리 := Rect2(좌상.x, 좌상.y, float(폭) * 칸크기, 규격.발판_두께)
	var 이름 := "관문%02d_유령다리" % 번호
	out["플랫폼"].append({
		"이름": 이름,
		"사각": 자리, "종류": "유령", "색": 규격.검정,
		"칠방식": 0, "일방통행": false, "의도형태": "직사각형",
	})
	# 검증기가 "이 자리에서 쏠 수 있나" 를 보도록 사격 정보를 남긴다.
	# 쏘는 자리 = 관문 왼쪽 두 칸(플레이어가 서서 다리를 바라보는 자리)
	out["사격"].append({
		"자리": 동굴_S.칸_월드(동굴, x - 2, 바닥y - 1) + Vector2(48.0, 96.0 - 규격.몸_높이 * 0.5),
		"목표": 자리, "대상": 이름,
	})
