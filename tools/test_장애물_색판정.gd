extends SceneTree
## ============================================================================
## [2026-08-30 신규] `scenes/집/스마트월드_장애물/` 의 씬들에 색 판정이 걸렸나
## ----------------------------------------------------------------------------
## 실행: godot --headless --path . -s res://tools/test_장애물_색판정.gd
##
## ▣ 규칙 (성진님 2026-08-30 지시)
##   "플레이어와 지형의 색이 다르면 죽어. 페인트로 칠한 부분의 색과 달라도 죽어."
##   안 칠한 것은 무색이 아니라 **검정**이다 — 화면에 검정으로 보이니까.
##
## ▣ 여기서 고정하는 두 가지
##   1. **칠할 수 있는 장애물**은 지형과 똑같이 판정된다 (안 칠했으면 검정)
##   2. **칠할 수 없는 장치**(레버·통로·창문·기계)는 색 규칙 밖이다 — 절대 죽이지 않는다
##      ★ 이건 실수가 아니라 결정이다. 칠할 방법이 없는 것까지 죽이면 흰색 플레이어는
##        방을 지나갈 수가 없다. 죽게 하려면 **칠할 수 있게 만드는 게 먼저**다.
## ============================================================================

const 폴더 := "res://scenes/집/스마트월드_장애물/"
const 색상 := preload("res://scripts/color_defs.gd")

## 칠할 수 있는 것 — 안 칠했으면 검정, 칠하면 그 색
const 칠할수있음 := ["통과플랫폼", "투명블럭", "무너지는바위", "물저장고"]
## 색 규칙 밖 — 무슨 색이든 안 죽인다
const 규칙밖 := ["호퍼", "송풍기", "제어레버", "연결통로", "도약대", "배관", "발광체",
	"창문_커튼", "창문_배경", "창문_구멍커튼", "창문_빛다리"]

var 통과 := 0
var 실패 := 0


func _init() -> void:
	call_deferred("_실행")


func _확인(조건: bool, 글: String) -> void:
	if 조건:
		통과 += 1
		print("  ✔ %s" % 글)
	else:
		실패 += 1
		print("  ✖ %s" % 글)


func _실행() -> void:
	print("\n=== 장애물 색 판정 ===")
	print("\n── 칠할 수 있는 것 (안 칠했으면 검정)")
	for 이름 in 칠할수있음:
		_칠할수있음_검사(이름)

	print("\n── 색 규칙 밖 (장치·기계·연출)")
	for 이름 in 규칙밖:
		_규칙밖_검사(이름)

	print("\n── 유체 (꺼져 있으면 그 자리에 아무것도 없다)")
	_유체_검사()

	print("\n════════════════════════════════════════")
	print("  통과 %d · 실패 %d" % [통과, 실패])
	print("════════════════════════════════════════\n")
	quit(1 if 실패 > 0 else 0)


func _대상(이름: String) -> Node:
	var 팩 := load(폴더 + 이름 + ".tscn") as PackedScene
	if 팩 == null:
		return null
	var 루트 := 팩.instantiate()
	root.add_child(루트)
	return _색가진것(루트)


func _색가진것(n: Node) -> Node:
	if n.has_method("반대색인가"):
		return n
	for c in n.get_children():
		var 찾음 := _색가진것(c)
		if 찾음 != null:
			return 찾음
	return null


func _칠할수있음_검사(이름: String) -> void:
	var 대상 := _대상(이름)
	if 대상 == null:
		_확인(false, "%s — 색을 가진 노드를 찾았다" % 이름)
		return
	var 안칠함_검정: bool = not 대상.반대색인가(색상.BLACK)
	var 안칠함_흰색: bool = 대상.반대색인가(색상.WHITE)
	_확인(안칠함_검정 and 안칠함_흰색,
		"%s · 안 칠한 상태 → 검정 안전 / 흰색 죽음" % 이름)

	if 대상.has_method("명중"):
		for i in 14:
			if 대상.명중(색상.WHITE, 대상.global_position) == "painted":
				break
		if 대상.현재색() == 색상.WHITE:
			_확인(대상.반대색인가(색상.BLACK) and not 대상.반대색인가(색상.WHITE),
				"%s · 흰색으로 칠한 뒤 → 검정 죽음 / 흰색 안전" % 이름)
		else:
			_확인(false, "%s · 흰색으로 칠해진다 (현재 %d)" % [이름, 대상.현재색()])
	대상.get_parent().queue_free() if 대상.get_parent() != root else 대상.queue_free()


func _규칙밖_검사(이름: String) -> void:
	var 대상 := _대상(이름)
	if 대상 == null:
		# 반대색인가 자체가 없으면 애초에 죽음 판정에 안 걸린다 = 규칙 밖. 정상이다.
		통과 += 1
		print("  ✔ %s · 색 계약이 없다 (죽음 판정 대상이 아니다)" % 이름)
		return
	_확인(not 대상.반대색인가(색상.BLACK) and not 대상.반대색인가(색상.WHITE),
		"%s · 두 색 모두 안전하다 (칠할 수 없는 것은 안 죽인다)" % 이름)


func _유체_검사() -> void:
	var 대상 := _대상("유체")
	if 대상 == null:
		_확인(false, "유체를 찾았다")
		return
	대상.set("켜짐", false)
	_확인(not 대상.반대색인가(색상.WHITE) and not 대상.반대색인가(색상.BLACK),
		"꺼진 유체 → 아무도 안 죽는다")
	대상.set("켜짐", true)
	대상.set("색", 색상.BLACK)
	_확인(대상.반대색인가(색상.WHITE) and not 대상.반대색인가(색상.BLACK),
		"켜진 검은 유체 → 흰색만 죽는다")
