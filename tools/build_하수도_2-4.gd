const 공 := preload("res://tools/하수도_빌더_공통.gd")
const 내씬 := "res://scenes/world_2_클로드/stage_2-4.tscn"
const 다음씬 := "res://scenes/world_2_클로드/stage_2-5.tscn"
# ── 2-9 기준 외관 — 2-1·2-2·2-3 v3 와 같은 자산(build_하수도_2-3.gd 와 같다) ──
#   ★처음엔 공통 빌더 b.유체/b.호퍼/b.배관 을 그대로 썼다 → 물이 옛 유체.gd(애니 실루엣 판정)로 남아
#     외관이 2-3 과 달랐고, 물 판정을 매 애니 프레임 다시 달아 스크립트가 12ms 씩 튀었다(2026-10-07 실측).
const S_배경 := "res://scenes/배경/하수도_벽돌배경_2_9_조정.tscn"
const S_화면효과 := "res://scenes/배경/하수도_화면효과_v2.tscn"
const G_물 := "res://scripts/스마트월드/유체_흰물v2.gd"
const G_배관 := "res://scripts/스마트월드/하수도_주철배관.gd"
const G_호퍼 := "res://scripts/스마트월드/호퍼_주철_기존배치.gd"
const G_웅덩이 := "res://scripts/스마트월드/웅덩이_하수도29.gd"
const 도면 := "res://tools/도면_2-4_지형.json"
const S_저장고 := "res://scenes/집/스마트월드_장애물/물저장고.tscn"
const 버튼_S := preload("res://scripts/스마트월드/압력버튼.gd")
const S_움직발판 := "res://scenes/집/스마트월드_장애물/움직이는발판.tscn"
const 붕괴스크립트 := "res://scripts/스마트월드/SS2D_붕괴발판.gd"

const 검 := 공.검정
const 흰 := 공.흰색

var b: RefCounted
var 자료: Dictionary = {}
var 지형부모: Node = null

## 도면 조각 이름 → 씬에 남길 한글 이름
const 이름표 := {
	"덩01_0": "시작복도_바위", "덩01_1a": "수갱_천장바위", "덩01_1b": "수갱_오른바위",
	"덩01_2a": "물탱크B_천장", "덩01_2b": "물탱크B_바위", "덩01_3a": "호퍼2_천장",
	"덩01_3b": "호퍼2_바위", "덩01_4a": "사다리방_바위", "덩01_4b": "수갱아래_바위",
	"덩01_5": "수갱바닥_바위", "덩01_6": "아래층_바위", "덩02": "물탱크C_받침",
	"덩03": "호퍼2_착지발판", "덩04": "도착방_바위", "덩05": "벨브_선반",
	"덩06": "디딤_선반", "덩07": "떠있는_선반", "덩08": "호퍼4_오른바위",
	"덩09": "호퍼4_왼바위", "덩10": "수갱_징검발판", "덩11": "낙사존_바위",
	"채움01": "하늘_채움",
}


func _init() -> void:
	Engine.max_fps = 60
	call_deferred("_실행")


## 도면 칸 → 월드
func kx(g: float) -> float: return g * 32.0 + 16.0
func ky(g: float) -> float: return g * 32.0 + 32.0


func _실행() -> void:
	print("\n=== STAGE 2-4 · 물탱크를 채워라 v3 (uvtt 도면 403×107 · 한 칸 32px) ===")
	var f := FileAccess.open(도면, FileAccess.READ)
	if f == null:
		push_error("2-4: 도면 json 이 없다 — 먼저 `python tools/도면_2-4_지형추출.py` 를 돌릴 것")
		quit(1)
		return
	자료 = JSON.parse_string(f.get_as_text()) as Dictionary
	f.close()
	if 자료.is_empty():
		push_error("2-4: 도면 json 파싱 실패")
		quit(1)
		return

	b = 공.new()
	b.재질_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_black.tres")
	b.재질_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/땅_2-3_white.tres")
	b.재질_선반_검 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_black.tres")
	b.재질_선반_흰 = load("res://assets/textures/smartshape/sewer_masonry_v02/선반_white.tres")

	var 프레임 := _프레임()
	var 루트 := _짓기(프레임)
	var ok: bool = b.검산(프레임, _빈공간들())
	b.색비율_보고()
	if not ok or b.오류 > 0:
		push_error("2-4: 검산 실패 %d — 저장하지 않는다" % b.오류)
		quit(1)
		return
	if not b.저장(루트, 내씬):
		quit(1)
		return
	print("=== 끝 ===\n")
	quit(0)


func _프레임() -> Rect2:
	var a: Array = 자료["프레임"]
	return Rect2(float(a[0]), float(a[1]), float(a[2]), float(a[3]))


## 도면 추출 도구가 준 "굴" 사각형 그대로. 지형이 아닌 칸은 전부 여기 들어 있다.
func _빈공간들() -> Array:
	var r: Array = []
	for v in 자료["빈공간"]:
		r.append(Rect2(float(v[0]), float(v[1]), float(v[2]), float(v[3])))
	return r


func _점들(a: Array) -> PackedVector2Array:
	var p := PackedVector2Array()
	for v in a:
		p.append(Vector2(float(v[0]), float(v[1])))
	return p


## 호퍼로 들어가는 물 — 반드시 호퍼 윗면 + 12 까지 늘리고 `호퍼_유입` 을 켠다.
## (2026-10-03 2-3 §4: 안 켜면 물의 바닥찾기와 호퍼 입구 연출이 `보이는_높이` 를 번갈아 덮어써 스크립트가 20ms 튄다)
func _유입(장: Node, 이름: String, x: float, 윗끝: float, 폭: float, 색: int, 호퍼윗면: float,
		켜짐: bool = true) -> Node2D:
	var w := _물(장, 이름, x, 윗끝, 폭, 호퍼윗면 + 12.0 - 윗끝, 색, 켜짐)
	w.set("호퍼_유입", true)
	return w


## 지형 + 2-9 기준 명도 조율(2-3 `_땅` 과 같다).
func _땅(부모: Node, 이름: String, 점들: PackedVector2Array, 색: int, 역할: String = "플랫폼") -> Node2D:
	var n: Node2D = b.지형(부모, 이름, 점들, 색, 역할)
	if n != null:
		n.set("시안_명도조율", true)
		n.set("앞지형_깊이", true)
	return n


## 떨어지는 물(유체_흰물v2). ★스크립트를 먼저 바꾼다 — set_script 는 그 전에 넣은 값을 지운다.
func _물(부모: Node, 이름: String, x: float, 윗끝: float, 폭: float, 높이: float, 색: int, 켜짐: bool = true) -> Node2D:
	var f := (load(공.S_유체) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	f.name = 이름
	f.set_script(load(G_물))
	f.position = Vector2(x, 윗끝)
	f.set("종류", 0)
	f.set("색", 색)
	f.set("크기", Vector2(폭, 높이))
	f.set("켜짐", 켜짐)
	부모.add_child(f)
	return f


## 주철 배관(그림만). 시작/끝 장치를 주면 관 끝이 그 장치에 붙는다(2-3 `_관` 과 같다).
func _관(부모: Node, 이름: String, 점들: Array, 시작: Node, 끝: Node) -> Node2D:
	var p := Node2D.new()
	p.name = 이름
	p.z_index = -1
	p.set_script(load(G_배관))
	var 경로 := PackedVector2Array()
	for v in 점들:
		경로.append(Vector2(float(v[0]), float(v[1])))
	p.set("점들", 경로)
	부모.add_child(p)
	if 시작 != null:
		p.set("시작_장치", p.get_path_to(시작))
	if 끝 != null:
		p.set("끝_장치", p.get_path_to(끝))
	return p


## 주철 호퍼(2-3 `_호퍼` 와 같다). 원점 = 아랫변 가운데 = 밟는면 + 높이. 출구 물 너비는 주철 호퍼가 정한다(폭 × 0.2).
func _호퍼(부모: Node, 이름: String, x: float, 밟는면: float, 폭: float, 높이: float, 출구유체: Node) -> Node2D:
	var h := (load(공.S_호퍼) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	h.name = 이름
	h.set_script(load(G_호퍼))
	h.position = Vector2(x, 밟는면 + 높이)
	h.set("폭", 폭)
	h.set("높이", 높이)
	h.set("자동_출구_연결", false)
	h.set("주철_명도", 0.88)
	h.z_index = 3
	var c := CollisionShape2D.new()
	c.name = "윗면"
	var r := RectangleShape2D.new()
	r.size = Vector2(폭, 12.0)
	c.shape = r
	c.position = Vector2(0, -높이 + 6.0)
	c.one_way_collision = true
	c.one_way_collision_margin = 4.0
	h.add_child(c)
	b._덮어쓸_노드들.append(c)
	부모.add_child(h)
	if 출구유체 != null:
		h.set("출구_유체", h.get_path_to(출구유체))
	return h


## 물탱크(물저장고) — 밟고 칠할 수 있는 상자. 다 칠하면 `공급` 유체가 그 색으로 켜진다.
func _탱크(장: Node, 이름: String, 가운데: Vector2, 크기: Vector2, 필요횟수: int, 공급: Node) -> Node2D:
	var t := (load(S_저장고) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = 가운데
	t.set("크기", 크기)
	t.set("필요횟수", 필요횟수)
	t.set("자동_공급_연결", false)
	장.add_child(t)
	t.set("공급_유체", t.get_path_to(공급))
	return t


## 격자발판 — 도면의 "격자발판(검정/흰색)". 일방통행 공중 발판이고 색은 고정이다.
func _격자(장: Node, 이름: String, 가운데x: float, 윗면: float, 폭: float, 색: int) -> Node2D:
	var g: Node2D = b.통과플랫폼(장, 이름, 가운데x, 윗면, 폭, 1)
	g.set("고정색", 0 if 색 == 검 else 1)
	return g


func _짓기(프레임: Rect2) -> Node2D:
	var 시작 := Vector2(560.0, ky(41))
	var 루트: Node2D = b.루트("stage_2-4", "2-4 · 물탱크를 채워라",
		프레임, 시작, 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	var 배경 := (load(S_배경) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	배경.name = "하수도배경"
	루트.add_child(배경)
	루트.move_child(배경, 1)

	지형부모 = 지
	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 지형 — 도면에서 뽑은 그대로 (0.5 칸 턱이 많아 전부 짧은변 허용)
	# ══════════════════════════════════════════════════════════════════════
	for 조각 in 자료["지형"]:
		var 이름: String = 이름표.get(조각["이름"], 조각["이름"])
		b.짧은변_허용.append(이름)
		_땅(지, 이름, _점들(조각["점"]), 검)
	for 조각 in 자료["채움"]:
		var 이름2: String = 이름표.get(조각["이름"], 조각["이름"])
		b.짧은변_허용.append(이름2)
