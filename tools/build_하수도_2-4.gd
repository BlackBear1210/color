## 층 바닥 슬래브를 위/아래 두 겹으로: 윗겹 = 걷는 층의 색, 아랫겹 = 그 밑 층의 색(천장 · 머리 공간 ≥ 480 이라 못 닿는다).
## 색 비율(검정 65 ± 5) 때문 — 흰 층의 슬래브 밑면이 전부 흰색으로 잡히면 흰색이 50 % 를 넘는다.
## ⚠ 굴뚝이 몸을 붙이고 오르는 쪽 구멍 면에는 쓰지 않는다(그 면은 굴뚝 벽과 같은 한 색이어야 한다).
func _두겹슬래브(지: Node, 이름: String, x0: float, x1: float, 윗면: float, 위색: int, 아래색: int) -> Node2D:
	var 위: Node2D = b.지형(지, 이름, 공.사각(x0, 윗면, x1, 윗면 + 96.0), 위색)
	b.지형(지, 이름 + "_밑", 공.사각(x0, 윗면 + 96.0, x1, 윗면 + 192.0), 아래색, "채움")
	return 위


## 저장고(밟을 수 있고 칠할 수 있는 상자 · 원점 = 가운데). 바닥 위에 세운다. `공급` 유체를 칠한 색으로 켠다.
func _저장고(부모: Node, 이름: String, x: float, 바닥: float, 필요횟수: int, 공급: Node) -> Node2D:
	var t := (load(S_저장고) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	t.name = 이름
	t.position = Vector2(x, 바닥 - 48.0)
	t.set("크기", Vector2(192.0, 96.0))
	t.set("필요횟수", 필요횟수)
	t.set("자동_공급_연결", false)
	부모.add_child(t)
	t.set("공급_유체", t.get_path_to(공급))
	return t


## 굴뚝 한 벌(검정 몸 전용): 격자 사다리(192 폭 · 128 씩 · 일방통행 · 안 칠하면 검정) + 꼭대기 호퍼(폭 192 · 밟는면 = 위층 바닥 + 64 ·
## 고정 흰 공급 + 저장고 공급(검정이 될 물)) + 출구 물(굴뚝 바닥까지 · 320 → 굴뚝 바닥 물띠 240 > 192 = 들어서면 닿는다).
## `벽쪽` = 오르며 몸을 붙이는 벽("R"/"L"). 그쪽 끝에 저장고 물(검정 = 내 색)을, 반대쪽 끝에 고정 흰 물을 둔다 —
## 벽에 붙어 호퍼로 올라선 몸이 흰 물에 닿으면 죽는다. 굴뚝 x0~x0+192. 아래층 바닥 `밑`, 위층 바닥 `위`.
func _굴뚝(장: Node, 이름: String, x0: float, 밑: float, 위: float, 벽쪽: String) -> Dictionary:
	var cx := x0 + 96.0
	var y := 밑 - 128.0
	var n := 1
	while y >= 위 + 128.0:
		b.통과플랫폼(장, "%s_g%d" % [이름, n], cx, y, 192.0, 1)
		y -= 128.0
		n += 1
	var 면 := 위 + 64.0
	var 출구: Node2D = b.유체(장, 이름 + "_출구물", cx, 면 + 56.0, 320.0, 밑 - (면 + 56.0), 공.물_회, false)
	b.호퍼(장, 이름, cx, 면, 192.0, 56.0, 출구, 320.0)
	var 저장x := cx + 72.0 if 벽쪽 == "R" else cx - 72.0
	var 고정x := cx - 72.0 if 벽쪽 == "R" else cx + 72.0
	b.유체(장, 이름 + "_고정공급", 고정x, 위 + 16.0, 48.0, 64.0, 공.물_흰)
	var 저장: Node2D = b.유체(장, 이름 + "_저장고공급", 저장x, 위 + 16.0, 48.0, 64.0, 공.물_검, false)
	return {"출구": 출구, "저장고공급": 저장, "cx": cx}


func _짓기() -> Node2D:
	var 루트: Node2D = b.루트("stage_2-4", "2-4 · 색이 흐른다",
		프레임, Vector2(520, T1), 프레임.end.y + 400.0)
	var 지 := 루트.get_node("지형")
	var 장 := 루트.get_node("장치")
	var 위 := 루트.get_node("위험물")
	var 체 := 루트.get_node("체크포인트")

	var 배경 := (load(배경씬) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE) as Node2D
	배경.name = "하수도배경"
	루트.add_child(배경)
	루트.move_child(배경, 1)

	b.외곽(지, 프레임)

	# ══════════════════════════════════════════════════════════════════════
	# 채움 — 천장·층 사이 덩어리
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "천장띠", 공.사각(0, 0, 9600, 640), 검, "채움")
	# 층 천장(머리 공간 ≥ 576 · 못 닿는 면)은 **흰색** — 바닥·벽이 거의 검정이라 이렇게 해야 색 비율 65 ± 5 에 든다(2-3 과 같은 수법).
	b.지형(지, "F_T1위", 공.사각(0, 640, 2432, 2240), 흰, "채움")
	b.지형(지, "F_T2위", 공.사각(2432, 640, 5184, 2240), 흰, "채움")
	# T3 왼끝 벽 = S3a 굴뚝이 몸을 붙이는 벽(검정 · T3·T4·주머니 전부 검정 층).
	b.지형(지, "T3_왼벽", 공.사각(5184, 640, 5312, 2240), 검)
	b.지형(지, "F_T3위", 공.사각(5312, 640, 6208, 896), 검, "채움")           # 주머니 천장
	# 주머니와 진짜 T4 사이 벽은 **흰색** — 밑동(1472)은 T3 머리 위 480 · 주머니 쪽은 158 앞에서 멈춘다(CP) · T4 쪽은 6400 까지 안 온다. 색 비율용.
	b.지형(지, "주머니_T4_사이벽", 공.사각(6208, 640, 6400, 1472), 흰)

	# ══════════════════════════════════════════════════════════════════════
	# T1 검정 「칠하면 흐른다」  (공기 3008~3584)
	# ══════════════════════════════════════════════════════════════════════
	b.지형(지, "T1_바닥", 공.다각([
		[0, T1], [160, T1], [160, T1 + 96], [704, T1 + 96], [704, T1], [1600, T1], [1600, T1 + 192],
		[1728, T1 + 192], [1728, T1], [3488, T1], [3488, 4096], [0, 4096],
	]), 검)
	b.가시(위, "가시_T1", 1664, T1 + 192, 4)
	# 저장고 T1 은 바닥 위 선반(256 위) — 걷는 길에서 비켜 있고 굴뚝 밑에서 보인다. 어디서든 쏜다.
	b.공중선반(지, "T1_저장고선반", 2560, T1 - 256, 2832, 검)
	# S1 굴뚝(3168~3360): 왼벽 짧게(밑 384 가 입구) · 오른벽 = T2 바닥(2816)에서 T1 바닥까지 **한 면**(오르는 몸이 붙는다)
	b.지형(지, "S1_좌벽", 공.사각(3040, 3008, 3168, 3200), 검)
	b.지형(지, "S1_우벽", 공.사각(3360, T2, 3488, T1), 검)
	var s1 := _굴뚝(장, "S1", 3168, T1, T2, "R")
	_저장고(장, "T1", 2696, T1 - 256, 1, s1["저장고공급"])
	b.배관(장, "관_T1", 공.다각([[2696, T1 - 256 - 112], [2696, 3060], [3336, 3060], [3336, T2 + 16]]))
	# 고정 공급 관은 T2 흰 구간의 막다른 선반(4560, 2432)에서 내려온다 — "관을 따라가면 뭐가 있겠지" 라는 미끼.
	b.배관(장, "관_S1고정", 공.다각([[4560, 2432], [4560, 2560], [3192, 2560], [3192, T2 + 16]]))

	# ══════════════════════════════════════════════════════════════════════
